{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":80,"content":[{"type":"heading","content":["Yàlla, suqalil sa njëmbat"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bu ñuy wax Tóor-tóor yi, dib taalifu cant, ñeel Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy yaw, Sàmmu Israayil, teewlu nu;","poem":1},{"lineBreak":true},{"text":"yaw mi jiite Yuusufa ni ag jur,","poem":1},{"lineBreak":true},{"text":"yaw mi toogandook malaakay serub yi,","poem":1},{"text":"feqal sag leer.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dawalal sa njàmbaar, ñeel Efrayim ak Beñamin ak Manase,","poem":1},{"lineBreak":true},{"text":"te wallusi nu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Éy Yàlla, suqali nu;","poem":1},{"lineBreak":true},{"text":"geesoo nu sa leeru kanam, nu raw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Éy Aji Sax ji, Yàlla Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"foo àppal sa mer,","poem":1},{"lineBreak":true},{"text":"mi ngay wuyoo sa ñaanu mbooloo mi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Leel nga nuw naqar,","poem":1},{"lineBreak":true},{"text":"nàndal nu mbàndum rongooñ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"def nga dëkkandoo di nu xëccoo,","poem":1},{"lineBreak":true},{"text":"noon di nu ree.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Éy Yàlla Boroom gàngoor yi, suqali nu;","poem":1},{"lineBreak":true},{"text":"geesoo nu sa leeru kanam, nu raw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yaa déjjate ag reseñ ci Misra,","poem":1},{"lineBreak":true},{"text":"dàq yéefar yi, indi, jëmbataat.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nga raadu suuf si,","poem":1},{"lineBreak":true},{"text":"reseñ gi sampu, law, dajal réew mi;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"keppaaram muur tund yi,","poem":1},{"lineBreak":true},{"text":"ay caram sàng garabi seedar yu mag yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mu tàllal ay bànqaasam ba géej,","poem":1},{"lineBreak":true},{"text":"lawal njebbit la ba ca dexu Efraat ga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lu tax nga bëtt ay ñagam,","poem":1},{"lineBreak":true},{"text":"ba ku fa jaare witt ca,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"mbaam àll di ko ruur,","poem":1},{"lineBreak":true},{"text":"ndundati àll di ca for?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Éy Yàlla Boroom gàngoor yi, geesul;","poem":1},{"lineBreak":true},{"text":"séentool asamaan, ba gis","poem":1},{"lineBreak":true},{"text":"te taxawusi reseñ gii.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Taxawusil njëmbat lii nga jëmbate sa ndijoor,","poem":1},{"lineBreak":true},{"text":"ngarab sii nga dooleelal sa bopp.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dees koo gor, taal;","poem":1},{"lineBreak":true},{"text":"yal na ñii sànkoo sa mbugal.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yal nanga yiir ki nga tànn,","poem":1},{"lineBreak":true},{"text":"kii nga dooleelal sa bopp,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ba dootunu la dëddu.","poem":1},{"lineBreak":true},{"text":"May nu nu dund, nu wormaal sa tur.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, Yàlla Boroom gàngoor yi, suqali nu,","poem":1},{"lineBreak":true},{"text":"geesoo nu sa leeru kanam, nu raw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":20}