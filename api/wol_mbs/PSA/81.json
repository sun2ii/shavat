{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":81,"content":[{"type":"heading","content":["Déggal Yàlla, jariñu"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ñeel Asaf, te ànd ak xalam gu ñuy wax gitiit","descriptive":true},{"noteId":21},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sarxolleleen ci Yàlla mi nuy dooleel;","poem":1},{"lineBreak":true},{"text":"xaaculeen ci Yàllay Yanqóoba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yékkatileen woy te jiin,","poem":1},{"lineBreak":true},{"text":"xalam neex, ànd ak moroom ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Walleen bufta bi ci Terutel weer wi,","poem":1},{"lineBreak":true},{"text":"ak weer wu birale bésu màggal.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Loolu wartéefu Israayil la,","poem":1},{"lineBreak":true},{"text":"di ndigalu Yàllay Yanqóoba,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"di ndénkaane bu mu dénk waa kër Yuusufa,","poem":1},{"lineBreak":true},{"text":"ba Yàllay dali ca kaw réewum Misra.","poem":1},{"lineBreak":true},{"text":"Baat bu ma xamul laa dégg, mu naan:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Yennil naa leen yen bi,","poem":1},{"lineBreak":true},{"text":"woyofal seeni loxo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ngeen jàq, woo ma, ma xettali leen,","poem":1},{"lineBreak":true},{"text":"wuyoo leen fa kiiraayal dënn ya,","poem":1},{"lineBreak":true},{"text":"te maa leen nattoo fa wal ma ca Meriba. Selaw.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yeen sama ñoñ, dégluleen, ma dénk leen.","poem":1},{"lineBreak":true},{"text":"Éy Israayil, su ngeen ma déglu woon!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Buleen fat tuuru jàmbur,","poem":1},{"lineBreak":true},{"text":"buleen sujjóotal tuuru doxandéem.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Man, Aji Sax ji, maay seen Yàlla","poem":1},{"text":"ji leen yékkatee réewum Misra.","poem":2},{"text":"Ŋaleen ŋafeet, ma reggal leen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Waaye sama ñoñ déggaluñu ma,","poem":1},{"lineBreak":true},{"text":"ñuy Israayil gii ma nangulul.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Moo tax ma bërgël leen ak seenug të,","poem":1},{"lineBreak":true},{"text":"ñuy wéye seeni pexe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Éy su ma sama ñoñ déggaloon,","poem":1},{"lineBreak":true},{"text":"éy su Israayil toppoon samay nammeel!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ci saa si laay toroxal seeni noon,","poem":1},{"lineBreak":true},{"text":"duma seeni bañ,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ba ku bañ Aji Sax ji di ko raamal,","poem":1},{"lineBreak":true},{"text":"te àppam du jeex ba fàww.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kon yeen, ma leel leen ngën-gi-pepp,","poem":1},{"lineBreak":true},{"text":"reggal leen lem ju doj xelli.»","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"81.1 gitiit: seetal ci 8.1.","reference":{"chapter":81,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}