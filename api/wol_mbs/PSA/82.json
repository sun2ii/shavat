{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":82,"content":[{"type":"heading","content":["Yàllaay àtte ndawi péncam"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant, ñeel Asaf.","descriptive":true},{"lineBreak":true},{"text":"Yàlla toog na, di jiite ndajem boppam,","poem":1},{"lineBreak":true},{"text":"di àtte ndawi péncam, naan:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Dungeen bàyyi àtteb njublaŋ,","poem":1},{"lineBreak":true},{"text":"ak di faral ku bon? Selaw.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sàmmleen àqu néew-ji-dooleek jirim,","poem":1},{"lineBreak":true},{"text":"tey àtte yoon ku ñàkk ak ku ndóol.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Walluleen néew-ji-dooleek walaakaana,","poem":1},{"lineBreak":true},{"text":"di leen xettali ci ku bon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Ndawi péncum Yàlla yii xamuñu, dégguñu;","poem":1},{"lineBreak":true},{"text":"xanaa di doxe lëndëmu ñaawtéef,","poem":1},{"lineBreak":true},{"text":"ba ponki dëgg yépp di jaayu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«Dama ne ay yàlla ngeen,","poem":1},{"lineBreak":true},{"text":"yeen ñépp di njabootu Aji Kawe ji.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waaye du leen tee dee ni doom aadama,","poem":1},{"lineBreak":true},{"text":"du leen tee daanu ni képp kuy njiit.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngalla Yàlla, taxawal, àtte àddina,","poem":1},{"lineBreak":true},{"text":"yaw yaa séddoo xeetoo xeet.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}