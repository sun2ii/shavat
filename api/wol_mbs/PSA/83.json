{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":83,"content":[{"type":"heading","content":["Yàlla, mbugalal noon yi"]},{"type":"verse","number":1,"content":[{"text":"Di woyu cant, ñeel Asaf.","descriptive":true},{"lineBreak":true},{"text":"Éy Yàlla, bul ne cell,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"rikk Yàlla, bul tanqamlu, ne patt.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xoolal sa noon yiy riir,","poem":1},{"lineBreak":true},{"text":"sa bañ yi fippu ba téen!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sa ñoñ lañuy rabatal,","poem":1},{"lineBreak":true},{"text":"di mànkool sa séddoo yii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ñu ne: «Ayca nu far seen xeet wi,","poem":1},{"lineBreak":true},{"text":"ba deesul fàttalikooti turu Israayil.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dañoo mànkoo kat,","poem":1},{"lineBreak":true},{"text":"te yaw lañu takktool:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"muy néegi Edom ak Ismayla,","poem":1},{"lineBreak":true},{"text":"néegi Mowab ak Agar,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"néegi Gebal, Amon ak Amaleg","poem":1},{"lineBreak":true},{"text":"ak waa Filisteek waa Tir,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"réewum Asiri it fekki leen,","poem":1},{"lineBreak":true},{"text":"di dooleel askanu Lóot wa. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Def leen na nga defoon waa Majan","poem":1},{"noteId":22},{"text":",","poem":1},{"lineBreak":true},{"text":"def ko Sisera ak Yabin ca dexu Kison","poem":1},{"noteId":23},{"text":",","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ña nga sànku ci Endor,","poem":1},{"lineBreak":true},{"text":"ba doonub tos fi kaw suuf.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Defal seeni njiit na Oreb ak Seeb,","poem":1},{"lineBreak":true},{"text":"def seen kilifa yépp ni Sebax ak Calmuna,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ña ne woon: «Nan séddoo parluy Yàlla yi.»","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Éy Yàlla, wëndeel leen ni callweer,","poem":1},{"lineBreak":true},{"text":"ñu mel ni boob bu ngelaw wal.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Éy Yàlla, ni daay di xoyome àll,","poem":1},{"lineBreak":true},{"text":"sawara wa jafal tund ya,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"yal nanga leen ni toppeek sa dooley ngelaw,","poem":1},{"lineBreak":true},{"text":"tiitale leen sa ngëlén.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aji Sax ji, sëlëm leen gàcce,","poem":1},{"lineBreak":true},{"text":"ba ñu daw wutsi la.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yal nañu rus, jàq ba fàww.","poem":1},{"lineBreak":true},{"text":"Yal nañu torox, sànku.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yal nañu xam ne yaw mi tudd Aji Sax ji doŋŋ","poem":1},{"lineBreak":true},{"text":"yaay Aji Kawe ji yilif àddina sépp.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"83.10 Seetal ci Njiit ya saar 6—8.","reference":{"chapter":83,"verse":10}},{"noteId":23,"caller":"+","text":"83.10 Seetal ci Njiit ya saar 4—5.","reference":{"chapter":83,"verse":10}}]},"thisChapterLink":"/api/wol_mbs/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}