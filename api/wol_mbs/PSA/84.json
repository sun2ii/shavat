{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":84,"content":[{"type":"heading","content":["Ku dal ak Yàlla bég"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, ànd ak xalam gu ñuy wax gitiit","descriptive":true},{"noteId":24},{"text":", ñeel askanu Kore wu góor.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"yaaka sopplub dëkkuwaay!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Damaa namm ëttub Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di ko gelu ba jeex tàkk,","poem":1},{"lineBreak":true},{"text":"jëmm jeek xol bi,","poem":1},{"lineBreak":true},{"text":"di xaacul Yàlla jiy dund.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"sama buur, sama Yàlla,","poem":1},{"lineBreak":true},{"text":"sawoor sax tag, nga fat ko,","poem":1},{"lineBreak":true},{"text":"mbelaar it sàkk tàggam,","poem":1},{"lineBreak":true},{"text":"denc ay cuujam fa sa sarxalukaay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndokkalee ku dëkke sa kër,","poem":1},{"lineBreak":true},{"text":"di la màggalati. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndokkalee ku lay doolewoo,","poem":1},{"lineBreak":true},{"text":"te namma topp yoon ya jëm sa kër.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Buy jàll xuru Jooyoo,","poem":1},{"lineBreak":true},{"text":"mu saf ko bëti ndox,","poem":1},{"lineBreak":true},{"text":"céebo sànge xur wa barke,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"muy gëna am doole,","poem":1},{"lineBreak":true},{"text":"ba teewi fa Yàlla ca Siyoŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Éy Yàlla Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"déglul, ma ñaan la!","poem":1},{"lineBreak":true},{"text":"Yàllay Yanqóoba, teewlu ma. Selaw.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Éy Yàlla, geesul Buur, sunu kiiraay,","poem":1},{"lineBreak":true},{"text":"ngalla niiral kii nga fal.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Benn fan ci sab ëtt de","poem":1},{"lineBreak":true},{"text":"moo dàq junniy fan feneen.","poem":1},{"lineBreak":true},{"text":"Sama taxawaayu bunt kër Yàlla","poem":1},{"lineBreak":true},{"text":"moo ma gënal tëraayu biir xaymab ku bon.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aji Sax ji Yàllaa mat jant, mat kiiraay;","poem":1},{"lineBreak":true},{"text":"yiw ak daraja, Aji Sax ji joxe;","poem":1},{"lineBreak":true},{"text":"te du ngëneel lu muy bañal ku mat.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji Boroom gàngoor yi,","poem":1},{"lineBreak":true},{"text":"ndokkalee ku la wóolu.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"84.1 gitiit: seetal ci 8.1.","reference":{"chapter":84,"verse":1}}]},"thisChapterLink":"/api/wol_mbs/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":13}