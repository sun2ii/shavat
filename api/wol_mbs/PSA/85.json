{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":85,"content":[{"type":"heading","content":["Aji Sax ji, suqaleeti nu"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dib taalifu cant, ñeel askanu Kore wu góor.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, yaa baaxe woon sa réew mi,","poem":1},{"lineBreak":true},{"text":"ba suqali sëti Yanqóoba yi,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"baal sa mbooloo seeni ñaawtéef,","poem":1},{"lineBreak":true},{"text":"jéggal leen bépp bàkkaar. Selaw.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bàyyi nga xadar ja,","poem":1},{"lineBreak":true},{"text":"muñ mer ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Éy Yàlla mi nuy musal, suqali nu,","poem":1},{"lineBreak":true},{"text":"te meddi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xanaa doo nu mere fàww,","poem":1},{"lineBreak":true},{"text":"ba ca sët yaak sëtaat ya?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xanaa dinga leqali sa mbooloo,","poem":1},{"lineBreak":true},{"text":"ba ñu man laa bànneexoo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, won nu sa ngor,","poem":1},{"lineBreak":true},{"text":"baaxe nu sag wall.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Woykat ba nee: «Naa déglu","poem":1},{"lineBreak":true},{"text":"lu Aji Sax ji Yàlla di wax.»","poem":1},{"lineBreak":true},{"text":"Jàmm lay wax wóllëreem ñiy ñoñam,","poem":1},{"lineBreak":true},{"text":"ba duñu dellu ci jëfi dof.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wallam aka jege ñi ko ragal,","poem":1},{"lineBreak":true},{"text":"te leeram dëgmal sunu réew mii!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ngor ak wormaa daje,","poem":1},{"lineBreak":true},{"text":"njub ak jàmm saafoonte,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kóllëre jebbee fa suuf,","poem":1},{"lineBreak":true},{"text":"njub séentoo asamaan,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aji Sax ji it maye ngëneel,","poem":1},{"lineBreak":true},{"text":"sunu suuf meññal,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"njub jiitu Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di ko xàllal yoonam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}