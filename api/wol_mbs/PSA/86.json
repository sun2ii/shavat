{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":86,"content":[{"type":"heading","content":["Ma ñaan, bésub njàqare"]},{"type":"verse","number":1,"content":[{"text":"Mu di ñaanu Daawuda.","descriptive":true},{"lineBreak":true},{"text":"Éy Aji Sax ji, teewlu ma, nangul ma,","poem":1},{"lineBreak":true},{"text":"damaa ñàkk, néew doole.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Maa gore, musal ma;","poem":1},{"lineBreak":true},{"text":"maay sa jaam bi la wóolu,","poem":1},{"lineBreak":true},{"text":"yaw, sama Yàlla, wallu ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Éy Boroom bi, baaxe ma;","poem":1},{"lineBreak":true},{"text":"yaw laay yendoo woo wall.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boroom bi, bànneexalal sab jaam,","poem":1},{"lineBreak":true},{"text":"yaw laa dékk sama xol.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Boroom bi, yaa baax, di baale,","poem":1},{"lineBreak":true},{"text":"di nàddil sa ngor képp ku lay dagaan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, teewlul, ma ñaan la;","poem":1},{"lineBreak":true},{"text":"déglul, ma tinu la.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bu ma la woowee bésub njàqare,","poem":1},{"lineBreak":true},{"text":"yaa may nangul.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Boroom bi, doo moroomu tuur yi,","poem":1},{"lineBreak":true},{"text":"te jëf melul ni sa jos.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Boroom bi, mboolem xeet yi nga sàkk","poem":1},{"lineBreak":true},{"text":"ñoo lay sujjóotalsi,","poem":1},{"lineBreak":true},{"text":"di màggal sa tur.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yaa màgg te yéemey jëf,","poem":1},{"lineBreak":true},{"text":"yaw doŋŋ yaa di Yàlla.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, won ma sa nammeel,","poem":1},{"lineBreak":true},{"text":"ma doxe sa dëgg.","poem":1},{"lineBreak":true},{"text":"Tënkal sama xol ci ragal la.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Boroom bi sama Yàlla,","poem":1},{"lineBreak":true},{"text":"naa la sante xol bu fees,","poem":1},{"lineBreak":true},{"text":"màggal la ba fàww.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ngor lu réy nga ma won,","poem":1},{"lineBreak":true},{"text":"sorele maak tëraayu bàmmeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Éy Yàlla, nit ñu bew a ma jógal,","poem":1},{"lineBreak":true},{"text":"def gàngoor gu néeg, di rëbb sama bakkan,","poem":1},{"lineBreak":true},{"text":"te seetuñu la ci.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Waaye yaw Boroom bi Yàlla, yaa ñeewante, yërëm,","poem":1},{"lineBreak":true},{"text":"yaa muñ mer, bare ngor ak worma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Geesu ma, baaxe ma.","poem":1},{"lineBreak":true},{"text":"Dooleelal sab jaam,","poem":1},{"lineBreak":true},{"text":"wallul ki sa jaam sukk jur!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ngalla def ma sa firndey mbaax,","poem":1},{"lineBreak":true},{"text":"ba bañ yi gis ci, rus,","poem":1},{"lineBreak":true},{"text":"ndax yaw Aji Sax ji ma dimbali, dëfal ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}