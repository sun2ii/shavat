{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":87,"content":[{"type":"heading","content":["Siyoŋ, yaay ndeyu xeet yi"]},{"type":"verse","number":1,"content":[{"text":"Ñeel askanu Kore wu góor, di woyu cant.","descriptive":true},{"lineBreak":true},{"text":"Dëkkub Aji Sax ji, kenu yaa nga ca tund yu sell ya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aji Sax jee sopp bunti Siyoŋ gii,","poem":1},{"lineBreak":true},{"text":"mu gënal ko fu askanu Yanqóoba dëkke.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaw, dëkkub Yàlla bi,","poem":1},{"lineBreak":true},{"text":"tuddees na say jaloore. Selaw.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yàlla nee: «Ma limaale Misraak Babilon, ñi ma xam di dégg.","poem":1},{"lineBreak":true},{"text":"Xoolal Filisti ak Tir, ak réewum Kuus.","poem":1},{"lineBreak":true},{"text":"Nit a ngii, juddoo fa.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Te teewul ñu cosaanale ko Siyoŋ,","poem":1},{"lineBreak":true},{"text":"ne kii ak kee fa bokk juddoo,","poem":1},{"lineBreak":true},{"text":"te Aji Kawe jee saxal Siyoŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax jeey lim xeet yi, limaale leen","poem":1},{"lineBreak":true},{"text":"ne: «Kii fi la juddoo.» Selaw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuy fecc ak kuy woy ànd naan:","poem":1},{"lineBreak":true},{"text":"«Sunu cosaanoo cosaan fii la!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}