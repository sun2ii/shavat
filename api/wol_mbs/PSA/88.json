{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":88,"content":[{"type":"heading","content":["Ma jàq, jooy"]},{"type":"verse","number":1,"content":[{"text":"Di woyu cant, ñeel askanu Kore wu góor, jëm ci njiital woykat yi, dëppook galan bu ñuy wax Maxalat Leyanot, dib taalifu yeete bu ñeel Eman mi bokk ci giirug Esra.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Éy Aji Sax ji, Yàlla ji may musal,","poem":1},{"lineBreak":true},{"text":"bëccëg ma yuuxu,","poem":1},{"lineBreak":true},{"text":"guddi ma yuuxu fi sa kanam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yal na sama ñaan àgg fa yaw;","poem":1},{"lineBreak":true},{"text":"teewlul, ma woote wall.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Damaa suur këll ay musiba,","poem":1},{"lineBreak":true},{"text":"ba soreetuma njaniiw,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ñu sóoraale maak ñi wàcci biir bàmmeel.","poem":1},{"lineBreak":true},{"text":"Ma mel ni jàmbaar ju kenn amatul yaakaar,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"bokk ci néew yi dara waratul,","poem":1},{"lineBreak":true},{"text":"mbaa ku ñu bóom, mu tëdd cim pax,","poem":1},{"lineBreak":true},{"text":"faaleetoo ko, xanaa dagg ko, wacc.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tàbbal nga ma kàmb gu xóot,","poem":1},{"lineBreak":true},{"text":"biir xóotey lëndëm.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yen nga ma sa xadar,","poem":1},{"lineBreak":true},{"text":"tance ma sa gannax yépp. Selaw.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dàqal nga may xame,","poem":1},{"lineBreak":true},{"text":"tax nga ñu seexlu ma;","poem":1},{"lineBreak":true},{"text":"ma tëju, génnatuma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Samay gët a ngi giim ndax naqar.","poem":1},{"lineBreak":true},{"text":"Éy Aji Sax ji, maa ngi lay woo bés bu ne,","poem":1},{"lineBreak":true},{"text":"dékk lay loxo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ku dee, lu muy doyeeti say kéemaan?","poem":1},{"lineBreak":true},{"text":"Ndax néew dina jóg di la màggal? Selaw.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dees na siiwal sa ngor biir bàmmeel,","poem":1},{"lineBreak":true},{"text":"mbaa sa kóllëre ci paxum sànkute?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ana kuy yég say kéemaan ci googu lëndëm?","poem":1},{"lineBreak":true},{"text":"Ku lay seedeel njub réew ma fàtte faloo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aji Sax ji, man, yaw laay woo wall,","poem":1},{"lineBreak":true},{"text":"xëy, kare la gii ñaan, ne la:","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Éy Aji Sax ji, loo may gàntale,","poem":1},{"lineBreak":true},{"text":"di ma fuuylu?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mitit bay laatikaaf, sama ngone ba tey;","poem":1},{"lineBreak":true},{"text":"sa mbugal yu raglu, ba bopp ubu ràpp!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sa mer mëdd ma,","poem":1},{"lineBreak":true},{"text":"sa mbugal yu raglu sànk ma,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"mëdd ma nim ndox bés bu ne,","poem":1},{"lineBreak":true},{"text":"gëndoo fi sama kaw.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dàqal nga ma soppeek xarit,","poem":1},{"lineBreak":true},{"text":"ma far xejjoo lëndëm.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":19}