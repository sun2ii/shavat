{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":9,"content":[{"type":"heading","content":["Aji Sax ji dëgg lay àtte"]},{"type":"verse","number":1,"content":[{"text":"Mu jëm ci njiital woykat yi, dëppook galan bu ñuy wax Deewug doom ju góor, ñeel Daawuda, dib taalifu cant.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ma sante Aji Sax ji sama xol bépp,","poem":1},{"lineBreak":true},{"text":"di siiwal mboolemi kéemaanam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaw Aji Kawe ji, dama lay bége,","poem":1},{"lineBreak":true},{"text":"bànneexoo la, kañ saw tur.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Noon yeey dellu gannaaw,","poem":1},{"lineBreak":true},{"text":"tërëf, sànku fi sa kanam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yaa ma àtte yoon, dëggal ma,","poem":1},{"lineBreak":true},{"text":"toog ci sab jal, di àtte njub.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rëbb nga xeet yi, sànk ñu bon ñi,","poem":1},{"lineBreak":true},{"text":"far seeni tur ba fàww.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noon ya raaf, gental ba fàww.","poem":1},{"lineBreak":true},{"text":"Yaa déjjati seeni dëkk, seenu askan fey.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aji Sax jee sax dàkk,","poem":1},{"lineBreak":true},{"text":"samp jalam ngir àtte.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moom mooy àtte àddina cig njub,","poem":1},{"lineBreak":true},{"text":"di dogalal xeet yi dëgg.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aji Sax jeey làq néew-ji-doole,","poem":1},{"lineBreak":true},{"text":"mooy làqe bésub njàqare.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaw, ku la xam, wóolu la.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji, yaw, ku la ñaan wallu, doo ko wacc.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Woyleen Aji Sax ji dëkke Siyoŋ,","poem":1},{"lineBreak":true},{"text":"siiwalleen ay jalooreem ci xeet yi!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mooy topp nit bakkanu moroomam, di ko ba xel,","poem":1},{"lineBreak":true},{"text":"te du fàtte yuuxi néew-ji-doole.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Éy Aji Sax ji, baaxe ma,","poem":1},{"lineBreak":true},{"text":"gisal naqar wi ma bañ yi teg.","poem":1},{"lineBreak":true},{"text":"Yaa may yékkatee fa bunti dee,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ba ma siiwali sa woy yépp,","poem":1},{"lineBreak":true},{"text":"fa buntu Siyoŋ, dëkk bu taaru ba,","poem":1},{"lineBreak":true},{"text":"di bànneexoo sa wall gii!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Xeet yee tàbbi pax ma ñu gasoon,","poem":1},{"lineBreak":true},{"text":"fakkastaloo fiir ga ñu làqoon.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aji Sax jaa ngi feeñoo, di àtte yoon;","poem":1},{"lineBreak":true},{"text":"ku bon tegug fiir, tàbbi ca. Na jib ndànk. Selaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ñu bon ñee dëddu, dem njaniiw,","poem":1},{"lineBreak":true},{"text":"ànd ak xeet yi fàtte Yàlla yépp.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yàlla du tanqamlu ab ndóol ba fàww,","poem":1},{"lineBreak":true},{"text":"yaakaaru néew-ji-doole du tas mukk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Aji Sax ji, jógal, bu la nit yab;","poem":1},{"lineBreak":true},{"text":"na xeet yi dikk fi sa kanam, nga àtte leen.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rikk Aji Sax ji, yónnee leen tiitaange,","poem":1},{"lineBreak":true},{"text":"xamal leen ne nit doŋŋ lañu. Selaw.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}