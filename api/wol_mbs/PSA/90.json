{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":90,"content":[{"type":"heading","content":["Doom aadama yàggul"]},{"type":"verse","number":1,"content":[{"text":"Di ñaanu Musaa, góorug Yàlla ga.","descriptive":true},{"lineBreak":true},{"text":"Boroom bi, yaa nu masa fat","poem":1},{"lineBreak":true},{"text":"maasoo maas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bala tund yee juddu,","poem":1},{"lineBreak":true},{"text":"bala ngay sos suuf ak àddina,","poem":1},{"lineBreak":true},{"text":"yaa mas di Yàlla, ba fàww.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaay delloo doom aadama ci pënd,","poem":1},{"lineBreak":true},{"text":"ne ko: «Yaw, doom aadama, dellul!»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Junniy at ci yaw","poem":1},{"lineBreak":true},{"text":"daa gaaw ni démb ak tey,","poem":1},{"lineBreak":true},{"text":"mbete waxtu yu néew ci wattub guddi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaay buub nit, nelawal ko.","poem":1},{"lineBreak":true},{"text":"Suba mu jebbi nim ñax,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"xëy, jebbi, naat;","poem":1},{"lineBreak":true},{"text":"ngoon mu lax, wowal.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Soo meree kay, nu sànku,","poem":1},{"lineBreak":true},{"text":"nga xadaru, nu jàq.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sunuy ñaawtéef a ngi janook yaw,","poem":1},{"lineBreak":true},{"text":"te sunu mbóot leer na la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sunu giiru dund nga di nu mere,","poem":1},{"lineBreak":true},{"text":"sunuy fan jeex ni noo guy naaw.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sunu àppu dund di juróom ñaar fukki at,","poem":1},{"lineBreak":true},{"text":"ku dëgër ba dëgër, juróom ñett fukk;","poem":1},{"lineBreak":true},{"text":"li ci ëpp di coonooku tiis,","poem":1},{"lineBreak":true},{"text":"ne fëyy, nu wéy.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ana ku xam sa dooley mer","poem":1},{"lineBreak":true},{"text":"ak sa xadar ju raglu?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yal nanga nu xiir ci lim sunuy fan,","poem":1},{"lineBreak":true},{"text":"ba nu mana dawal xel mu rafet.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aji Sax ji, délsil, loo deeti xaar?","poem":1},{"lineBreak":true},{"text":"Ngalla yërëmal sa jaam ñi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nu xëy, nga reggal nook sa ngor,","poem":1},{"lineBreak":true},{"text":"nuy sarxolle, bànneexoo ko sunu giiru dund.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bànneexal nu limu fan yi nga nu mbugal,","poem":1},{"lineBreak":true},{"text":"diirub ati tiis yi nu dund.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yal na sa jaloore leer sa jaam ñi,","poem":1},{"lineBreak":true},{"text":"sa daraja leer seeni doom.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Boroom bi sunu Yàlla, ngalla baaxe nu.","poem":1},{"lineBreak":true},{"text":"Sottalal nu sunu liggéeyu loxo,","poem":1},{"lineBreak":true},{"text":"rikk, sottalal nu sunu liggéeyu loxo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}