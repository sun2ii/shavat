{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":91,"content":[{"type":"heading","content":["Aji Sax jee mat kaaraange"]},{"type":"verse","number":1,"content":[{"text":"Ku dëkke kiiraayu Aji Kawe ji","poem":1},{"lineBreak":true},{"text":"yaa këroo keppaaru Aji Man ji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dama naa Aji Sax ji:","poem":1},{"lineBreak":true},{"text":"«Yaw laay làqoo, di la fegoo;","poem":1},{"lineBreak":true},{"text":"ngay sama Yàlla ji ma doyloo.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kii kay moo lay musal cig fiir","poem":1},{"lineBreak":true},{"text":"ak loraangey mbas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kiiraayam la lay sànge,","poem":1},{"lineBreak":true},{"text":"nga yiiru, làqu;","poem":1},{"lineBreak":true},{"text":"kóllëreem feg la, di la aar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Doo ragal njàqarey guddi","poem":1},{"lineBreak":true},{"text":"mbaa fittu bëccëg","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mbaa mbas mu yooteg lëndëm,","poem":1},{"lineBreak":true},{"text":"ak balaa buy faat njolloor.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Junni daanu fi sa wet,","poem":1},{"lineBreak":true},{"text":"fukki junni (10 000) daanu fi sa ndijoor,","poem":1},{"lineBreak":true},{"text":"du tax mu jege la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Say gët nga ciy teg,","poem":1},{"lineBreak":true},{"text":"di seetaan ku bon di jot yoolam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yaw mi màkkaanoo Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"Aji Kawe jii di sama rawtu,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"genn loraange du la dab,","poem":1},{"lineBreak":true},{"text":"balaa du jege sa xayma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ay malaakaam la lay booleel,","poem":1},{"lineBreak":true},{"text":"ñu di la sàmm foo jëm.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Seeni loxo lañu lay leewoo,","poem":1},{"lineBreak":true},{"text":"ba doo fakkastalu ciw doj.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dangay falaxe jaan ak gaynde,","poem":1},{"lineBreak":true},{"text":"di rajaxe ñàngóor ak sibi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yàlla da naa: «Kii de man la safoo,","poem":1},{"lineBreak":true},{"text":"ma di ko xettali.","poem":1},{"lineBreak":true},{"text":"Man la xam, te maa koy teg fu wóor.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mu woo ma, ma wuyu ko;","poem":1},{"lineBreak":true},{"text":"mook man ci biir njàqare,","poem":1},{"lineBreak":true},{"text":"ma xettali ko, darajaal ko,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"reggal koy fan,","poem":1},{"lineBreak":true},{"text":"baaxe ko samag wall.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}