{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":92,"content":[{"type":"heading","content":["Nu woy bésub Noflaay"]},{"type":"verse","number":1,"content":[{"text":"Di woyu cant ngir bésub Noflaay.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Céy ngëneel li ci sant Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"di la woy, yaw Aji Kawe ji,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"xëye tudd sa ngor,","poem":1},{"lineBreak":true},{"text":"gonloo xamle sa kóllëre,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"xalamu fukki buum ànd ak moroom ma,","poem":1},{"lineBreak":true},{"text":"xeetu kooraa jibandoo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaa ma bégale say jaloore,","poem":1},{"lineBreak":true},{"text":"may sarxolle ci say manoore.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aji Sax ji, yaa réyi jëf;","poem":1},{"lineBreak":true},{"text":"xóoti pexe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ku ñàkk xel réere ko,","poem":1},{"lineBreak":true},{"text":"ku dofe umple ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bu ku bon sëqlee nim ñax,","poem":1},{"lineBreak":true},{"text":"képp kuy def lu bon di yokkule,","poem":1},{"lineBreak":true},{"text":"dañoo nara sànku ba fàww rekk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Waaye yaw ma fa kaw,","poem":1},{"lineBreak":true},{"text":"yaay Aji Sax ji ba fàww.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aji Sax ji, sa noon yi kay, ndeke yoo;","poem":1},{"lineBreak":true},{"text":"ndeke yoo sa noon yi, sànku rekk;","poem":1},{"lineBreak":true},{"text":"defkati mbon ñépp, fëlxoo rekk.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"May nga ma dooley nagu àll,","poem":1},{"lineBreak":true},{"text":"ma diwoo diw gu bees.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Maa gis jéllu noon yi,","poem":1},{"lineBreak":true},{"text":"dégg yuuxi ñu bon ñi may tëru.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ku jub day naat nig tàndarma,","poem":1},{"lineBreak":true},{"text":"màgg ni garabu seedaru Libaŋ","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"gu ñu jëmbat ci biir kër Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"muy naate ci sunu biir ëttu Yàlla;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"bu màggatee sax di meññ,","poem":1},{"lineBreak":true},{"text":"tooy xepp, sëq lipp,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"di biral njubteg Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"sama cëslaay ji dencul njubadi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}