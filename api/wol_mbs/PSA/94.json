{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":94,"content":[{"type":"heading","content":["Yàllaay mbugal ku bon"]},{"type":"verse","number":1,"content":[{"text":"Éy Aji Sax ji Yàlla, boroom mbugal!","poem":1},{"lineBreak":true},{"text":"Boroom mbugal, feqal sag leer!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaw miy àtte àddina, jógal","poem":1},{"lineBreak":true},{"text":"yool ku bew.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax ji, fu ku bon kiy àkki?","poem":1},{"lineBreak":true},{"text":"Fu ku bon kiy kañu àkki?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ñu ngi làmmiñoo reewande,","poem":1},{"lineBreak":true},{"text":"képp kuy def lu bon di damu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aji Sax ji, say ñoñ lañuy dëggaate;","poem":1},{"lineBreak":true},{"text":"say séddoo lañuy néewal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jëtun akub doxandéem, ñu faat;","poem":1},{"lineBreak":true},{"text":"ab jirim, ñu bóom,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"te naa: «Ki Sax gisu ci,","poem":1},{"lineBreak":true},{"text":"Yàllay Yanqóoba jii yégu ko.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yeen bokk yu dofe yi, moytuleen.","poem":1},{"lineBreak":true},{"text":"Gàtt xel yi, kañ ngeen di muus?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ki jëmbati nopp, da dul dégg a?","poem":1},{"lineBreak":true},{"text":"Am ki xari gët, da dul gis?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kiy yar yéefar yi, da dul mbugalee?","poem":1},{"lineBreak":true},{"text":"Du mooy kiy xamal nit?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aji Sax ji xam na xalaatu nit,","poem":1},{"lineBreak":true},{"text":"xam ne cóolóolu neen la.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ki Sax, ndokkalee ki ngay yar,","poem":1},{"lineBreak":true},{"text":"tàggat ko ci saw yoon,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"dëfal ko ci bési safaan,","poem":1},{"lineBreak":true},{"text":"ba keroog ñuy gasal ku bon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Boroom bi kat du wacc ñoñam mukk,","poem":1},{"lineBreak":true},{"text":"du bàyyi ay séddoom.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Àtte dina dellu doxe yoon,","poem":1},{"lineBreak":true},{"text":"képp ku jub topp ca.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ana ku may taxawal ci ñu bon ñi?","poem":1},{"lineBreak":true},{"text":"Ku may jógal ci biir ñiy def lu bon?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Su ma Aji Sax ji walluwul woon,","poem":1},{"lineBreak":true},{"text":"tuuti ma fanaani réew ma ne selaw.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dama noon: «Tarxiis naa!»","poem":1},{"lineBreak":true},{"text":"Waaye yaa ma awoo sa ngor.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma bare xalaati xol,","poem":1},{"lineBreak":true},{"text":"nga dëfal ma, ma bég.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Loo séq ak njiit lu jubadi","poem":1},{"lineBreak":true},{"text":"luy yoonal njubadi?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ñii dañoo mànkoo, di tëru ku jub,","poem":1},{"lineBreak":true},{"text":"di teg àtteb dee ku deful dara.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Waaye Aji Sax jeey sama rawtu,","poem":1},{"lineBreak":true},{"text":"ci sama Yàlla laay ame cëslaay, làqu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Moo leen di këpp seen ñaawtéef,","poem":1},{"lineBreak":true},{"text":"sànke leen seenug mbon.","poem":1},{"lineBreak":true},{"text":"Sunu Yàlla Aji Sax jee leen di sànk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}