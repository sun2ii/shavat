{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":95,"content":[{"type":"heading","content":["Kaayleen, nu sant"]},{"type":"verse","number":1,"content":[{"text":"Kaayleen, nu sarxolleel Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"nu xaacul sunu wéeru-mucc.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nanu ko dikke cant,","poem":1},{"lineBreak":true},{"text":"woyal ko, mu riir.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aji Sax jeey Yàlla ju màgg ji,","poem":1},{"lineBreak":true},{"text":"buur bu mag bi tiim yàllay xeet yépp.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Moo moom xóotey suuf,","poem":1},{"lineBreak":true},{"text":"moom colli tund yi,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"moom géej, sàkk ko,","poem":1},{"lineBreak":true},{"text":"moom jéeri ji mu mooñ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nan sëgg, sujjóot,","poem":1},{"lineBreak":true},{"text":"sukkal Aji Sax ji nu sàkk.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mooy sunu Yàlla,","poem":1},{"lineBreak":true},{"text":"nuy xeet wi muy foral,","poem":1},{"lineBreak":true},{"text":"diy gàtt ciy loxoom.","poem":1},{"lineBreak":true},{"text":"Bésub tey yal nangeen dégg kàddoom","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ga mu noon: «Buleen të, na woon fa Meriba,","poem":1},{"lineBreak":true},{"text":"jantub keroog fa Maasa, ca màndiŋ ma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"fa ma seeni maam doon seetloo,","poem":1},{"lineBreak":true},{"text":"di ma diiŋat te gisoon samay jaloore","poem":1},{"noteId":26},{"text":".","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ñeent fukki at laa jéppi googu maas,","poem":1},{"lineBreak":true},{"text":"ma ne: “Seen xol a dëkke lajj,","poem":1},{"lineBreak":true},{"text":"ñu faaleedi samay santaane.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Moo ma taxa giñ ci sama biir mer,","poem":1},{"lineBreak":true},{"text":"ne duñu tàbbi fa samag noflaay.»","poem":1}]}],"footnotes":[{"noteId":26,"caller":"+","text":"95.9 Seetal ci Mucc ga 17.1-7.","reference":{"chapter":95,"verse":9}}]},"thisChapterLink":"/api/wol_mbs/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}