{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":96,"content":[{"type":"heading","content":["Buur Yàllaa ngi àttesi àddina"]},{"type":"verse","number":1,"content":[{"text":"Woyleen Aji Sax ji woy wu yees,","poem":1},{"lineBreak":true},{"text":"yeen àddina sépp woyleen Aji Sax ji.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Woyleen Aji Sax ji, màggal turam,","poem":1},{"lineBreak":true},{"text":"di siiwal xettaleem bésoo bés!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siiwalleen màggaayam ci biir xeet yi,","poem":1},{"lineBreak":true},{"text":"xamal waasoo waaso ay jalooreem.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aji Sax jee màgg, jara sant a sant","poem":1},{"lineBreak":true},{"text":"te gëna mata ragal lépp lu ñuy jaamu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mboolem yàlla yi xeet yiy jaamu, yàllantu la,","poem":1},{"lineBreak":true},{"text":"waaye Aji Sax jee sàkk asamaan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Màggaay ak daraja, fa moom,","poem":1},{"lineBreak":true},{"text":"dooleek taar, fa këram gu sell.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yeen làngi xeet yi, seedeelleen Aji Sax ji;","poem":1},{"lineBreak":true},{"text":"seedeelleen Aji Sax ji màggaayam ak dooleem.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Seedeelleen Aji Sax ji màggaayu turam,","poem":1},{"lineBreak":true},{"text":"yékkatil kob sarax, duggaale ëttam.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sujjóotalleen Aji Sax ji gànjaroo sellaay.","poem":1},{"lineBreak":true},{"text":"Ragalleen ko, bay lox, yeen waa àddina sépp.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Neleen xeet yi Aji Sax jeey buur!","poem":1},{"lineBreak":true},{"text":"Àddinaa ngi sampu ba dëgër moos, maneesu koo rëññeel.","poem":1},{"lineBreak":true},{"text":"Mooy àtte xeet yi njub.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asamaanoo, bégal! Suufoo, bànneexul!","poem":1},{"lineBreak":true},{"text":"Géejoo, riiral yaak mboolem li la fees,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"na mbooy mi jaayu, mook lu ci biiram,","poem":1},{"lineBreak":true},{"text":"ba mboolem garabi àll bi sarxolleendoo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"gatandoo ko Aji Sax jiy dikk,","poem":1},{"lineBreak":true},{"text":"àttesi àddina,","poem":1},{"lineBreak":true},{"text":"di àtte dun bi dëgg,","poem":1},{"lineBreak":true},{"text":"tey àtte xeet yépp ci dëggoom.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}