{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":97,"content":[{"type":"heading","content":["Aji Sax jeey nguuroo dëgg"]},{"type":"verse","number":1,"content":[{"text":"Aji Sax jeey Buur, na àddina bég;","poem":1},{"lineBreak":true},{"text":"dunoo dun bànneexu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ay xàmbaar yu lëndëm këruus a ko yéew,","poem":1},{"lineBreak":true},{"text":"àtteb dëgg ak njub lal ab jalam.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sawaraa dox, jiitu ko,","poem":1},{"lineBreak":true},{"text":"di xoyomi noonam wetoo wet,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ay melaxam leeral àddina,","poem":1},{"lineBreak":true},{"text":"waa àddina gis, di pat-pati;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"tund yi ne soyox seey fi kanam Aji Sax ji","poem":1},{"text":"boroom àddina sépp.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Asamaan a ngi biral àtteem,","poem":1},{"lineBreak":true},{"text":"xeetoo xeet di gis darajaam.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gàcce ñeel na kuy jaamu jëmmi tuur,","poem":1},{"lineBreak":true},{"text":"di puukarewoo ay yàllantu.","poem":1},{"lineBreak":true},{"text":"Yeen yàllay xeet yépp, sujjóotalleen kii,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siyoŋ dégg ca, bég,","poem":1},{"lineBreak":true},{"text":"waa Yuda it di bànneexoo àttey Aji Sax jii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aji Sax ji, Aji Kawe ji tiim suuf sépp;","poem":1},{"lineBreak":true},{"text":"yaaka màgga màgg, ba sut tuuroo tuur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yeen soppey Aji Sax ji, bañleen lu bon.","poem":1},{"lineBreak":true},{"text":"Aji Sax jeey sàmm ay wóllëreem,","poem":1},{"lineBreak":true},{"text":"di leen musal ci ku bon.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jub, leerlu;","poem":1},{"lineBreak":true},{"text":"jubal, bég.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yeen aji jub ñi, bànneexooleen Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"sante ko turam wu sell wi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}