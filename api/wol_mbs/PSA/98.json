{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":98,"content":[{"type":"heading","content":["Woyleen Aji Sax jiy àttesi"]},{"type":"verse","number":1,"content":[{"text":"Dib taalifu cant.","descriptive":true},{"lineBreak":true},{"text":"Woyleen Aji Sax ji woy wu yees,","poem":1},{"lineBreak":true},{"text":"moo def ay jaloore;","poem":1},{"lineBreak":true},{"text":"kàttanam ak sellaayu dooleem","poem":1},{"lineBreak":true},{"text":"jox na ko ndam li.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aji Sax jee xamleg wallam,","poem":1},{"lineBreak":true},{"text":"feeñal àtteem, xeet yi gis.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Moo fésal bànni Israayil ngoram,","poem":1},{"lineBreak":true},{"text":"fésal ko kóllëreem,","poem":1},{"lineBreak":true},{"text":"àddina ba mu daj di gis","poem":1},{"lineBreak":true},{"text":"ni nu sunu Yàlla walloo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yeen àddina sépp, xaaculleen Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"sampleen, sarxolle te woy!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xalamalleen Aji Sax ji, woyal ko,","poem":1},{"lineBreak":true},{"text":"xalamal ko, woyati!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Walleen liit yi, wal bufta yi","poem":1},{"lineBreak":true},{"text":"te xaacu fa kanam Buur Aji Sax ji!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Na géej riirandook li ko fees,","poem":1},{"lineBreak":true},{"text":"mook àddinaak li ci biiram,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"dex tàccu,","poem":1},{"lineBreak":true},{"text":"tund sarxolleendoo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"gatandoo ko Aji Sax jiy dikk,","poem":1},{"lineBreak":true},{"text":"àttesi àddina,","poem":1},{"lineBreak":true},{"text":"di àtte dun bi dëgg,","poem":1},{"lineBreak":true},{"text":"tey àttee xeet yépp yoon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}