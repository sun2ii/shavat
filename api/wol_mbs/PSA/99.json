{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"PSA","translationId":"wol_mbs","name":"Taalifi cant","commonName":"Taalifi cant","title":"Taalifi cant yu Daawuda ak ñeneen, ngir màggal Yàlla","order":19,"numberOfChapters":150,"sha256":"efd43dd22dc670f0e13029c3759fee86ba1979efbad4a252efb290907053e458","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wol_mbs/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":99,"content":[{"type":"heading","content":["Aji Sax ji buur bu sell la"]},{"type":"verse","number":1,"content":[{"text":"Aji Sax jeey Buur. Yeen xeet yi, ragalleen ko!","poem":1},{"lineBreak":true},{"text":"Moo toogandook malaakay serub yi. Suufoo, soo yeboo, yëngu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aji Sax ji fi Siyoŋ a màgg,","poem":1},{"lineBreak":true},{"text":"kawe, tiim xeetoo xeet.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa tur weeka màgg te raglu. Sàbbaalleen ko.","poem":1},{"lineBreak":true},{"text":"—Kee sell!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buur, jëfe yoon mooy dooleem.","poem":1},{"lineBreak":true},{"text":"Yaa saxal yoon, dëgg ak njub","poem":1},{"lineBreak":true},{"text":"ci askanu Yanqóoba.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Màggalleen sunu Yàlla, Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te sujjóot fa ndëggastalam.","poem":1},{"lineBreak":true},{"text":"—Kee sell!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musaak Aaróona bokk ciy sarxalkatam,","poem":1},{"lineBreak":true},{"text":"Samiyel bokk ca ñay ñaan ci turam.","poem":1},{"lineBreak":true},{"text":"Ñuy ñaan Aji Sax ji, mu di leen nangul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fa biir taxaaru niir wa la waxeek ñoom,","poem":1},{"lineBreak":true},{"text":"ñu topp kàdduy seedeem ak dogalu yoonam ba mu leen joxoon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Céy sunu Yàlla Aji Sax ji, yaa leen nanguloon,","poem":1},{"lineBreak":true},{"text":"di seen Yàlla ju leen di baal,","poem":1},{"lineBreak":true},{"text":"te di leen mbugale seeni jëf ju bon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Màggalleen sunu Yàlla, Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te sujjóot fa tundam wu sell wa.","poem":1},{"lineBreak":true},{"text":"Sunu Yàlla Aji Sax jee sell!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}