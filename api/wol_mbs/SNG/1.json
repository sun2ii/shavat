{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"heading","content":["Cofeel door na"]},{"type":"verse","number":1,"content":["Lii, di ngën-gi-woy, ñeel Suleymaan."]},{"type":"verse","number":2,"content":[{"text":"Fóon maa, ngalla fóon ma,","poem":1},{"lineBreak":true},{"text":"sa cofeel a ma dàqal biiñ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa diw yi ngay xeeñoo neex,","poem":1},{"lineBreak":true},{"text":"saw tur jib, mel ni lu xeeñ a xelli.","poem":1},{"lineBreak":true},{"text":"Moo tax janq ji nob la.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yóbbaale ma, nu daw, dem.","poem":1},{"lineBreak":true},{"text":"Sama buur, yóbbu ma sa néeg,","poem":1},{"lineBreak":true},{"text":"nu bokk mbég ak bànneex,","poem":1},{"lineBreak":true},{"text":"di tàqamtikoo sa cofeel gi dàq biiñ.","poem":1},{"lineBreak":true},{"text":"Ñoo yey nob la!","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Yeen janqi Yerusalem, damaa ñuul, rafet;","poem":1},{"lineBreak":true},{"text":"ñuul ni xayma ya ca Kedar","poem":1},{"noteId":0},{"text":",","poem":1},{"lineBreak":true},{"text":"mel ni ridoy Buur Suleymaan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buleen ma xoole sama ñuulaay bi,","poem":1},{"lineBreak":true},{"text":"jant bee ma lakk.","poem":1},{"lineBreak":true},{"text":"Samay càmmiñ a ma mere,","poem":1},{"lineBreak":true},{"text":"di ma wattuloo tóokëri reseñ ya,","poem":1},{"lineBreak":true},{"text":"te wattuwuma sama tóokëri bopp","poem":1},{"noteId":1},{"text":".","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sama soppey xol, ngalla wax ma ana fooy foral,","poem":1},{"lineBreak":true},{"text":"di fa gooral, digg bëccëg?","poem":1},{"lineBreak":true},{"text":"Lu ko moy may muuru, di la wër","poem":1},{"lineBreak":true},{"text":"fi say xarit ak seeni gétt.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Aa! Xamoo koo?","poem":1},{"lineBreak":true},{"text":"Yaw mi dàq ci jigéen ñi!","poem":1},{"lineBreak":true},{"text":"Génnal rekk, topp wewi jur gi,","poem":1},{"lineBreak":true},{"text":"sàmmi say tef,","poem":1},{"lineBreak":true},{"text":"fi dendeek mbaari sàmm si.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xarit, xam nga lu ma lay xoole?","poem":1},{"lineBreak":true},{"text":"Yànjaayu wajan wu takk watiiru Firawna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sa lex yaa ngi tàkk fi digg sàdd yi!","poem":1},{"lineBreak":true},{"text":"Céy wii loos ak caqu peram!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sàddi wurus lanu lay defaral,","poem":1},{"lineBreak":true},{"text":"tapp ca xaalis.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Li sama buur tëdd, di xéewlu lépp,","poem":1},{"lineBreak":true},{"text":"maa ngi gilli lu neex.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sama nijaay di mbuusum ndàbb","poem":1},{"lineBreak":true},{"text":"may fanaan sama digg ween.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Saa nijaay, saa cabbu tóor-tóoru fuddën,","poem":1},{"lineBreak":true},{"text":"fa digg tóokëri Engedi","poem":1},{"noteId":2},{"text":".","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Xarit, yaaka rafet,","poem":1},{"lineBreak":true},{"text":"yaaka taaru!","poem":1},{"lineBreak":true},{"text":"Say gët niy pitax.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Nijaay, yaaka góorayiw,","poem":1},{"lineBreak":true},{"text":"yaaka maa neex!","poem":1},{"lineBreak":true},{"text":"Mbooy gu naat, nu laloo,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"garabi seedar di sunu xànqi néeg,","poem":1},{"lineBreak":true},{"text":"garab gu dul ruus xadd ko","poem":1},{"noteId":3},{"text":".","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.5 Kedar, diiwaanu Arabi la woon bu genn giirug Ismayla dëkke woon bu yàgg. Dañu daan defare seeni xayma ay deri bëy yu ñuul.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"1.6 tóokër ak sàmm ay baat la yu ñuy méngalee ndaw si ci waxin. Seetal it ci aaya 8 (1.8).","reference":{"chapter":1,"verse":6}},{"noteId":2,"caller":"+","text":"1.14 Engedi, bëtu ndox la bu nekk ca sowub géeju Xorom ga. Engedi di tekki «bëtu ndoxu bëy».","reference":{"chapter":1,"verse":14}},{"noteId":3,"caller":"+","text":"1.17 seedar ak garab gu dul ruus, ay garab lañu yu neex xet.","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/wol_mbs/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}