{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Waaye man saxyaayu joor doŋŋ laa,","poem":1},{"lineBreak":true},{"text":"nirook as tóor-tóor ciw xur.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Xanaa as tóor-tóor su ne ràññ ci biiri dég!","poem":1},{"lineBreak":true},{"text":"Kookooy sama xarit ci biir janq ji.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mbete garab gu gëna neex ci gott bi,","poem":1},{"lineBreak":true},{"text":"kookooy sama nijaay ci biir xale yu góor yi.","poem":1},{"lineBreak":true},{"text":"May bége keppaaram, safoo doom ya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dugal na ma néegub sago-jeex-na,","poem":1},{"lineBreak":true},{"text":"yiire ma mbëggeel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaaweleen ma nàkki reseñ, ma dëgër,","poem":1},{"lineBreak":true},{"text":"leelleen may meññeef, leqalee ma.","poem":1},{"lineBreak":true},{"text":"Wopp laa def ndax mbëggeel!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sama càmmoñu waay, ma gegenoo,","poem":1},{"lineBreak":true},{"text":"ndijooram, ma laxasoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yeen janqi Yerusalem, waatalleen ma","poem":1},{"lineBreak":true},{"text":"ci taaru kéwél ak koobay àll bi,","poem":1},{"lineBreak":true},{"text":"ne dungeen dakkal te dungeen sooke tëraayu mbëggeel","poem":1},{"lineBreak":true},{"text":"te jotul.","poem":1}]},{"type":"heading","content":["Wootante jib na"]},{"type":"verse","number":8,"content":[{"text":"Dégluleen, sama nijaay a,","poem":1},{"lineBreak":true},{"text":"mu ngooguy ñëw,","poem":1},{"lineBreak":true},{"text":"di xéluy jéggi tund yu ndaw yi,","poem":1},{"lineBreak":true},{"text":"di tëb tund yu mag yiy dikk.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sama nijaay a ngi mel ni kéwél,","poem":1},{"lineBreak":true},{"text":"mbaa kooba gu ndaw.","poem":1},{"lineBreak":true},{"text":"Mu ngi noonu taxaw ca gannaaw miir ba,","poem":1},{"lineBreak":true},{"text":"di séentu ci palanteer bi","poem":1},{"lineBreak":true},{"text":"aka yër ci caax bi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sama nijaay ne ma:","poem":1},{"lineBreak":true},{"text":"«Xarit, ayca,","poem":1},{"lineBreak":true},{"text":"jongama sama, dikkal boog!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xoolal, tawub sedd wees na,","poem":1},{"lineBreak":true},{"text":"waame jàll, wéy","poem":1},{"noteId":4},{"text":".","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tóor-tóor yi lal na réew mi,","poem":1},{"lineBreak":true},{"text":"jamonoy woy dikk,","poem":1},{"lineBreak":true},{"text":"sabum péget","poem":1},{"noteId":5},{"text":"jibe sunum réew.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Figg a ngi ñorsi,","poem":1},{"lineBreak":true},{"text":"reseñ tóor, di gilli.","poem":1},{"lineBreak":true},{"text":"Xarit, ayca,","poem":1},{"lineBreak":true},{"text":"jongama sama, dikkal boog!»","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Soppe, sore nga ni xati mu dëkke xar-xari doj,","poem":1},{"lineBreak":true},{"text":"làqoo ruqi mbartal yi.","poem":1},{"lineBreak":true},{"text":"Won ma sa jëmm,","poem":1},{"lineBreak":true},{"text":"dégtal ma sa baat.","poem":1},{"lineBreak":true},{"text":"Sa baat a neex,","poem":1},{"lineBreak":true},{"text":"sa jëmm jekk!","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Jàppalleen ma till yi,","poem":1},{"lineBreak":true},{"text":"till yu ndaw yiy ruur reseñ,","poem":1},{"lineBreak":true},{"text":"te sunu reseñ jiy tóor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Sama nijaay, maa moom, man it, moo moom,","poem":1},{"lineBreak":true},{"text":"di fore digg tóor-tóor yi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nijaay, balaa jant a fenk,","poem":1},{"lineBreak":true},{"text":"ker toxu,","poem":1},{"lineBreak":true},{"text":"dellul gaaw ni kéwél,","poem":1},{"lineBreak":true},{"text":"mbaa kooba gu ndaw kaw tund yu xàjjalikoo ya.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"2.11 Ci Israayil, jamonoy sedd day taw. Bu taw bi jeexee, tàngoor wi dikk, gàncax gi jebbi, daldi naat.","reference":{"chapter":2,"verse":11}},{"noteId":5,"caller":"+","text":"2.12 péget, xeetu picc la mu nirool pitax.","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/wol_mbs/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}