{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"heading","content":["Réeroo, gise"]},{"type":"verse","number":1,"content":[{"text":"Sama kaw lal, guddi,","poem":1},{"lineBreak":true},{"text":"laa seet sama soppey xol.","poem":1},{"lineBreak":true},{"text":"Seet naa ko, gisuma ko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naa jóg, wër dëkk bi.","poem":1},{"lineBreak":true},{"text":"Mbedd yeek pénc yi","poem":1},{"lineBreak":true},{"text":"laay seete sama soppey xol.","poem":1},{"lineBreak":true},{"text":"Seet naa ko, gisuma ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wattukat yee ma gis,","poem":1},{"lineBreak":true},{"text":"ba ñuy wër dëkk bi.","poem":1},{"lineBreak":true},{"text":"Ma ne leen: «Sama soppey xol, gisuleen ko?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma romb leen tuuti rekk,","poem":1},{"lineBreak":true},{"text":"gis sama soppey xol.","poem":1},{"lineBreak":true},{"text":"Ma ne ko taral, bàyyeetuma ko,","poem":1},{"lineBreak":true},{"text":"ba yóbbu ko sama kër yaay,","poem":1},{"lineBreak":true},{"text":"ba sama biir néegu ndey ji ma jur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngalla yeen, janqi Yerusalem, waatalleen ma","poem":1},{"lineBreak":true},{"text":"ci taaru kéwél ak koobay àll bi,","poem":1},{"lineBreak":true},{"text":"ne dungeen dakkal te dungeen sooke tëraayu mbëggeel","poem":1},{"lineBreak":true},{"text":"te jotul.","poem":1}]},{"type":"heading","content":["Daagu, jëm toolu mbëggeel"]},{"type":"verse","number":6,"content":[{"text":"Ana luy jóge màndiŋ ma nii,","poem":1},{"lineBreak":true},{"text":"mel ni taxaaru saxaar,","poem":1},{"lineBreak":true},{"text":"suuroo ndàbb ak xas mu xeeñ","poem":1},{"lineBreak":true},{"text":"ak mboolem cuuraayi jula?","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Laltub Suleymaan a ngoog,","poem":1},{"lineBreak":true},{"text":"juróom benn fukki jàmbaar dar ko,","poem":1},{"lineBreak":true},{"text":"di jàmbaari Israayil.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ñépp mane saamar,","poem":1},{"lineBreak":true},{"text":"ku ci nekk mokkal xare,","poem":1},{"lineBreak":true},{"text":"saamar ci pooj,","poem":1},{"lineBreak":true},{"text":"ngay fàggu mbettum guddi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ab toogu la Buur Suleymaan defarlu,","poem":1},{"lineBreak":true},{"text":"ñu defare ko bantu Libaŋ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ponku ya, mu def ko xaalis,","poem":1},{"lineBreak":true},{"text":"wéeruwaay ba wurus;","poem":1},{"lineBreak":true},{"text":"tooguwaay ba di ndimo lu xonq curr,","poem":1},{"lineBreak":true},{"text":"biir ba di liggéeyu ràbb","poem":1},{"lineBreak":true},{"text":"bu janqi Yerusalem ràbbe cofeel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yeen janqi Siyoŋ, génnleen,","poem":1},{"lineBreak":true},{"text":"xool Buur Suleymaan ak mbaxanam céetal","poem":1},{"lineBreak":true},{"text":"mi ko yaayam solal ci bésub céetalam,","poem":1},{"lineBreak":true},{"text":"bésu bànneexam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}