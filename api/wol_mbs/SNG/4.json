{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Yaaka rafet, xarit, yaaka taaru!","poem":1},{"lineBreak":true},{"text":"Sa gët yi niy pitax, làqoo muuraay bi,","poem":1},{"lineBreak":true},{"text":"njañ liy loy-loyee ngi saf géttu bëy yu ñuul","poem":1},{"lineBreak":true},{"text":"yu bartaloo kaw tundu Galàdd.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sa gëñ yi weex ni xar yu ñu wat","poem":1},{"lineBreak":true},{"text":"ñuy yéege ca sangukaay ba,","poem":1},{"lineBreak":true},{"text":"ku nekk ak seexam,","poem":1},{"lineBreak":true},{"text":"kenn wéetu ca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa tuñ yi mel ni wëñ gu xonq curr,","poem":1},{"lineBreak":true},{"text":"ndaw gémmiñ gu jekk!","poem":1},{"lineBreak":true},{"text":"Sa lex yiy tàkk ni ŋaali gërënaat,","poem":1},{"lineBreak":true},{"text":"làqoo sa muuraay bi;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"sa loos wi ne coleet ni tatay Daawuda,","poem":1},{"lineBreak":true},{"text":"mërgalu ba jekk,","poem":1},{"lineBreak":true},{"text":"caq bay lang ni junniy kiiraayi jàmbaar.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa ween yi ni ñaari tef,","poem":1},{"lineBreak":true},{"text":"mbaa seexi kéwél yuy fore digg tóor-tóor yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Balaa jant a fenk,","poem":1},{"lineBreak":true},{"text":"ker gàddaay,","poem":1},{"lineBreak":true},{"text":"ma ne coww diggante tund wa ndàbb ne bann,","poem":1},{"lineBreak":true},{"text":"ak tund wa xas ma neexe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xarit, sa lépp a rafet,","poem":1},{"lineBreak":true},{"text":"sikk nekkul ci yaw.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Séet sama, jógeel Libaŋ, jege ma,","poem":1},{"lineBreak":true},{"text":"bawool Libaŋ, jegesi ma.","poem":1},{"lineBreak":true},{"text":"Wàcceel colli Amana","poem":1},{"lineBreak":true},{"text":"ak colli Senir ak Ermon.","poem":1},{"lineBreak":true},{"text":"Génnal xunti gaynde yooyook","poem":1},{"lineBreak":true},{"text":"tundi segg ya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jigéen sama, séet sama, benn yoon nga ma xool,","poem":1},{"lineBreak":true},{"text":"sama fit ne tërit.","poem":1},{"lineBreak":true},{"text":"Sa benn peru caq rekk,","poem":1},{"lineBreak":true},{"text":"sama fit ne tërit.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jigéen sama, séet sama,","poem":1},{"lineBreak":true},{"text":"sa mbëggeel a neex!","poem":1},{"lineBreak":true},{"text":"Sa mbëggeel a dàq biiñ,","poem":1},{"lineBreak":true},{"text":"sa diw yu xeeñ dàq luy cuuraay.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Séet sama! Lem ay xellee sa gémmiñ,","poem":1},{"lineBreak":true},{"text":"lem ak meew lal sa làmmiñ.","poem":1},{"lineBreak":true},{"text":"Sa xetu yére xetu àllub Libaŋ la.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Jigéen sama, séet sama, yaay tóokër bu tëje,","poem":1},{"lineBreak":true},{"text":"yaay seyaan bu tëje,","poem":1},{"lineBreak":true},{"text":"di bëtu ndox bu saañe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yaa di toolub gërënaat bu naat,","poem":1},{"lineBreak":true},{"text":"meññ ngën-gi-meññeef","poem":1},{"lineBreak":true},{"text":"ak fuddën ak reen yu xeeñ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"muy reen yu xeeñ, safroŋ, barax, kanel,","poem":1},{"lineBreak":true},{"text":"ak xasoo xas mu xeeñ,","poem":1},{"lineBreak":true},{"text":"ndàbb ak alowes","poem":1},{"lineBreak":true},{"text":"ak lépp lu xeeñ a xeeñ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaa di bëtu ndox ci tool yi,","poem":1},{"lineBreak":true},{"text":"di teen bu fees ak ndox muy daw,","poem":1},{"lineBreak":true},{"text":"wale tundi Libaŋ.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Yaw, ngelawal bëj-gànnaar, yewwul,","poem":1},{"lineBreak":true},{"text":"ngelawal bëj-saalum, dikkal,","poem":1},{"lineBreak":true},{"text":"wolalleen ma sama tool bi,","poem":1},{"lineBreak":true},{"text":"mu gilli;","poem":1},{"lineBreak":true},{"text":"sama nijaay dugg toolam,","poem":1},{"lineBreak":true},{"text":"xéewloo ngën-gi-meññeefam.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}