{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Jigéen sama, séet sama, dikk naa sama tool,","poem":1},{"lineBreak":true},{"text":"sama ndàbb ak sama cuuraay, ma for,","poem":1},{"lineBreak":true},{"text":"sama lem xelli, ma lekk,","poem":1},{"lineBreak":true},{"text":"sama biiñ ak sama meew, ma naan.","poem":1},"Awu",{"text":"Yeen soppe yi, lekkleen;","poem":1},{"lineBreak":true},{"text":"yeen ñi bëggante, naanleen ba màndi.","poem":1}]},{"type":"heading","content":["Xol jeex na, mujje neex"]},{"type":"verse","number":2,"content":[{"text":"Maa ngi nelaw, te xol yewwu;","poem":1},{"lineBreak":true},{"text":"dégluleen, sama nijaay ay fëgg.","poem":1},{"lineBreak":true},{"text":"Mu ne: «Xaritoo, jigéen sama, ubbil ma,","poem":1},{"lineBreak":true},{"text":"sama nenne, alal sama!","poem":1},{"lineBreak":true},{"text":"Sama bopp a ngi laye ba tooy,","poem":1},{"lineBreak":true},{"text":"njañ li fanaanee guus.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma ne ko: «Summiku naa de,","poem":1},{"lineBreak":true},{"text":"xanaa duma soluwaat?","poem":1},{"lineBreak":true},{"text":"Jàngu naa jeeg,","poem":1},{"lineBreak":true},{"text":"xanaa duma taqati?»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sama nijaay yoor loxoom ci xarante bi,","poem":1},{"lineBreak":true},{"text":"sama yaram ne sàyy.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma ne bërét, di ubbil nijaay,","poem":1},{"lineBreak":true},{"text":"sama loxo yi, diwu ndàbb di ca siit,","poem":1},{"lineBreak":true},{"text":"sama waaraam yi, ndàbb rogalaat","poem":1},{"lineBreak":true},{"text":"ba ci njàppul bunt bi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maa ubbil nijaay,","poem":1},{"lineBreak":true},{"text":"waaye nijaay waññiku na, ba wéy.","poem":1},{"lineBreak":true},{"text":"Ba mu waññikoo, tuuti ma dee.","poem":1},{"lineBreak":true},{"text":"Seet naa ko, gisuma ko;","poem":1},{"lineBreak":true},{"text":"ma woo ko, wuyuwul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wattukat yiy wër dëkk bi gis ma;","poem":1},{"lineBreak":true},{"text":"ñu dóor ma, gaañ ma,","poem":1},{"lineBreak":true},{"text":"ñori sama malaan.","poem":1},{"lineBreak":true},{"text":"Wattukati tata jaa!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ngalla yeen, janqi Yerusalem, waatalleen ma","poem":1},{"lineBreak":true},{"text":"ne su ngeen gisee sama nijaay,","poem":1},{"lineBreak":true},{"text":"ne ko damaa wopp ndax mbëggeel.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Yaw mi dàq ci jigéen ñi,","poem":1},{"lineBreak":true},{"text":"ana lu sa nijaay gëne keneen?","poem":1},{"lineBreak":true},{"text":"Ana lu mu ëpplee keneen,","poem":1},{"lineBreak":true},{"text":"ba nga di nu waatloo lii?","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Sama nijaay daa xees, leer;","poem":1},{"lineBreak":true},{"text":"kenn la ci fukki junniy góor.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kanam gi ni wurus, di wurusu ngalam;","poem":1},{"lineBreak":true},{"text":"njañ li lëmësu,","poem":1},{"lineBreak":true},{"text":"ñuul ni ndobin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gët yi ni pitax yu feggook wali ndox,","poem":1},{"lineBreak":true},{"text":"sangoo meew,","poem":1},{"lineBreak":true},{"text":"feggook ndox mu ne xéew","poem":1},{"noteId":6},{"text":".","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lex ya di tool,","poem":1},{"lineBreak":true},{"text":"gàncax ga ne ca bann,","poem":1},{"lineBreak":true},{"text":"tuñ ya diy tóor-tóor,","poem":1},{"lineBreak":true},{"text":"ndàbb wale ca, rogalaat.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Loxo yi banti wurus la,","poem":1},{"lineBreak":true},{"text":"ngën-gi-per tappe ca;","poem":1},{"lineBreak":true},{"text":"jëmm ja rattax ni bëñu ñey","poem":1},{"lineBreak":true},{"text":"laloo peri safiir;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"yeel yi kenuy doj wu jafe la,","poem":1},{"lineBreak":true},{"text":"sampe ci tànki wurusu ngalam.","poem":1},{"lineBreak":true},{"text":"Meloom ni tundi Libaŋ,","poem":1},{"lineBreak":true},{"text":"di tànnéef ni garabi seedar.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gémmiñam, bànneexi neen,","poem":1},{"lineBreak":true},{"text":"jëmmam jépp jara xédd!","poem":1},{"lineBreak":true},{"text":"Yeen janqi Yerusalem,","poem":1},{"lineBreak":true},{"text":"sama nijaay a ngoog, samab xarit.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"5.12 Li ñu wax fii ci làkku ebrë am na werante.","reference":{"chapter":5,"verse":12}}]},"thisChapterLink":"/api/wol_mbs/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}