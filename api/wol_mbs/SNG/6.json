{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Yaw mi dàq ci jigéen ñi,","poem":1},{"lineBreak":true},{"text":"ana fu sa nijaay dem?","poem":1},{"lineBreak":true},{"text":"Wax nu fu sa nijaay jaar,","poem":1},{"lineBreak":true},{"text":"nu seetle la ko.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Sama nijaay dugg na biir toolam,","poem":1},{"lineBreak":true},{"text":"fa gàncax ga ne bann.","poem":1},{"lineBreak":true},{"text":"Mu ngi foral ci tool bi,","poem":1},{"lineBreak":true},{"text":"aka fori tóor-tóor.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Man, nijaay a moom;","poem":1},{"lineBreak":true},{"text":"nijaay it, maa moom.","poem":1},{"lineBreak":true},{"text":"Mooy fore sama digg tóor-tóor yi.","poem":1}]},{"type":"heading","content":["Yaaka taaru"]},{"type":"verse","number":4,"content":[{"text":"Xarit, taaru nga ni Tirca ak Yerusalem,","poem":1},{"lineBreak":true},{"text":"péeyi buur ya,","poem":1},{"lineBreak":true},{"text":"yéeme nga ni gàngoor yi yékkati seeni raaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wuy, geesul fee!","poem":1},{"lineBreak":true},{"text":"Soo ma nee jàkk, ma jànnaxe.","poem":1},{"lineBreak":true},{"text":"Sa njañ liy loy-loyee ngi saf géttu bëy yu ñuul,","poem":1},{"lineBreak":true},{"text":"yu bartaloo kaw tundu Galàdd.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sa gëñ yi ni mbote yu weex,","poem":1},{"lineBreak":true},{"text":"yéege ca sangukaay ba,","poem":1},{"lineBreak":true},{"text":"ku nekk ak seexam,","poem":1},{"lineBreak":true},{"text":"kenn wéetu ca.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sa lex yiy tàkk ni ŋaali gërënaat,","poem":1},{"lineBreak":true},{"text":"làqoo sa muuraay bi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Buur day am juróom benn fukki lingeer","poem":1},{"lineBreak":true},{"text":"ak juróom ñett fukki jongama","poem":1},{"lineBreak":true},{"text":"ak jeeg ju dul jeex.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Waaye sama nenne kenn la, matal ma sëkk,","poem":1},{"lineBreak":true},{"text":"yaayam kennal ko,","poem":1},{"lineBreak":true},{"text":"muy ngëneelu biiru yaayam.","poem":1},{"lineBreak":true},{"text":"Janq ji gis ko, di ko jëwe mbégteem,","poem":1},{"lineBreak":true},{"text":"lingeeri buur aki jongamaam di ko kañ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ña nga naa: «Ndaw sii ku mu?","poem":1},{"lineBreak":true},{"text":"Bu nee xiféet, nga ne fajar a xar,","poem":1},{"lineBreak":true},{"text":"rafet ni leer gu ndaw,","poem":1},{"lineBreak":true},{"text":"yànj ni jant bi,","poem":1},{"lineBreak":true},{"text":"yéeme ni gàngoori biddiiw!»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Damaa wàcc ba ca toolub saal ya,","poem":1},{"lineBreak":true},{"text":"xooli cax mu yees mi ci xur wi,","poem":1},{"lineBreak":true},{"text":"bu reseñ ji jebbee,","poem":1},{"lineBreak":true},{"text":"mbaa gërënaat ji tóor, ma gis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Damaa ràkkaaju bay lox,","poem":1},{"lineBreak":true},{"text":"mel ni ku war watiiru buur","poem":1},{"noteId":7},{"text":".","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"6.12 Li ñu wax fii ci làkku ebrë am na werante.","reference":{"chapter":6,"verse":12}}]},"thisChapterLink":"/api/wol_mbs/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}