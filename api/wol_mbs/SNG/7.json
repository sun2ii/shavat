{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Dikkal, janqu waa Sulam bee, dikkal;","poem":1},{"lineBreak":true},{"text":"dikkal a dikk, nu niir la.","poem":1},"Waa ji",{"text":"Moo, lu ngeen di seetaane janqub waa Sulam bi","poem":1},{"lineBreak":true},{"text":"ni kuy fecc galanu Ñaari dali xare?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Janqoo, lingeer sama,","poem":1},{"lineBreak":true},{"text":"sa tànk yee ka jekk ci sa dàll yi,","poem":1},{"lineBreak":true},{"text":"sa mooco yi mërgalu niy jaaro","poem":1},{"lineBreak":true},{"text":"yu ndaanaanu tëgg yatte loxoom.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa jumbax bi di kaas bu mërgalu,","poem":1},{"lineBreak":true},{"text":"yàlla bumu ñàkk biiñu njafaan!","poem":1},{"lineBreak":true},{"text":"Sa biir bi di jalu pepp","poem":1},{"lineBreak":true},{"text":"mu ay tóor-tóor ñag.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sa ween yi ni ñaari tef,","poem":1},{"lineBreak":true},{"text":"mbaa seexi kéwél.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa loos wi, coleet, rattax, ni tatay bëñi ñey;","poem":1},{"lineBreak":true},{"text":"say gët di lerxat ni déegi Esbon","poem":1},{"lineBreak":true},{"text":"ya feggook buntu Bat Rabim.","poem":1},{"lineBreak":true},{"text":"Sa bakkan bi jub xocc ni tatay Libaŋ","poem":1},{"lineBreak":true},{"text":"ja tiim Damaas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sa bopp siggi ni tundu Karmel,","poem":1},{"lineBreak":true},{"text":"njañ liy nes-nesi ni sooyu buur,","poem":1},{"lineBreak":true},{"text":"létt yay fëy-fëyi, ba laaw buur.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Rafet, sopploo!","poem":1},{"lineBreak":true},{"text":"Soppee, bànneex nga!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sa taxawaay bii garabu tàndarma la,","poem":1},{"lineBreak":true},{"text":"sa ween yi di cëggi doom ya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma ne, maay yéeg tàndarma gi,","poem":1},{"lineBreak":true},{"text":"ŋëb doom yi.","poem":1},{"lineBreak":true},{"text":"Yal na say ween di sama cëggi reseñ,","poem":1},{"lineBreak":true},{"text":"sag noo jox ma doom yu xeeñ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"sa gémmiñ di xelli ngëneelu biiñ.","poem":1},"Ndaw si",{"text":"Na walal sama nijaay,","poem":1},{"lineBreak":true},{"text":"tuurul ñiy nelaw.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Man, nijaay a moom,","poem":1},{"lineBreak":true},{"text":"te maay nammeelam.","poem":1}]},{"type":"heading","content":["Ayca ca tool ba"]},{"type":"verse","number":12,"content":[{"text":"Nijaay, ayca nu dem tool ba,","poem":1},{"lineBreak":true},{"text":"fanaani ca tóor-tóori fuddën ya","poem":1},{"noteId":8},{"text":".","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nan teela xëyi ca tóokëri reseñ ya,","poem":1},{"lineBreak":true},{"text":"bu reseñ ji jebbee,","poem":1},{"lineBreak":true},{"text":"mbaa tóor-tóor yi focci,","poem":1},{"lineBreak":true},{"text":"mbaa gërënaat ji tóor, nu gis.","poem":1},{"lineBreak":true},{"text":"Fa laa lay jébbale mbëggeel.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tóor-tóor yu xeeñ","poem":1},{"noteId":9},{"text":"yaa ngi gilli,","poem":1},{"lineBreak":true},{"text":"lépp luy doom yu neex aje sunu bunt néeg,","poem":1},{"lineBreak":true},{"text":"yu yees yaak ya woon,","poem":1},{"lineBreak":true},{"text":"ma boole dencal la, nijaay.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"7.12 Mbaa: ca dëkk yu ndaw ya.","reference":{"chapter":7,"verse":12}},{"noteId":9,"caller":"+","text":"7.14 tóor-tóor yu xeeñ yi, màndaragoor la ci làkku ebrë. Ñu yaakaar ne, day may góor doole tey giiral jigéen.","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/wol_mbs/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":14}