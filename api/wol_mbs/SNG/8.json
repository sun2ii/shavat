{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"SNG","translationId":"wol_mbs","name":"Ngën-gi-woy","commonName":"Ngën-gi-woy","title":"Ngën-gi-woy","order":22,"numberOfChapters":8,"sha256":"01c11c4d5c84d5d205a5e836bc7da5dc9a22b6ebcc1dd2ee4edd58c34e905cce","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/wol_mbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Éy su meloon ni sama càmmiñ nga,","poem":1},{"lineBreak":true},{"text":"mel ni ku ma bokkal wenn ween,","poem":1},{"lineBreak":true},{"text":"ba ma dajeek yaw biti, sañ laa dar,","poem":1},{"lineBreak":true},{"text":"te du tax ñu sikk ma!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma jàpp la, yóbbu sama néeg yaay,","poem":1},{"lineBreak":true},{"text":"moom mi ma yar","poem":1},{"noteId":10},{"text":",","poem":1},{"lineBreak":true},{"text":"ma may la biiñ bu saf,","poem":1},{"lineBreak":true},{"text":"ak sama ndoxum gërënaat, nga naan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sama càmmoñu waay, ma gegenoo,","poem":1},{"lineBreak":true},{"text":"ndijooram, ma laxasoo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yeen janqi Yerusalem, waatalleen ma","poem":1},{"lineBreak":true},{"text":"ne dungeen dakkal te dungeen sooke tëraayu mbëggeel","poem":1},{"lineBreak":true},{"text":"te jotul.","poem":1}]},{"type":"heading","content":["Joxe naa xol"]},{"type":"verse","number":5,"content":[{"text":"Ana ndaw suy jóge màndiŋ ma nii,","poem":1},{"lineBreak":true},{"text":"wéeroo nijaayam?","poem":1},"Ndaw si",{"text":"Ci ron pom gi laa la yee,","poem":1},{"lineBreak":true},{"text":"fa la sa yaay jàppe ëmb,","poem":1},{"lineBreak":true},{"text":"jur la fa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Teg ma ci sa xol ni torlukaay","poem":1},{"noteId":11},{"text":",","poem":1},{"lineBreak":true},{"text":"mbaa ci sa përëg ni lamu màndarga.","poem":1},{"lineBreak":true},{"text":"Mbëggeel a bare doole ni dee,","poem":1},{"lineBreak":true},{"text":"fiiraange xér ni bàmmeel.","poem":1},{"lineBreak":true},{"text":"Day jàpp jippét,","poem":1},{"lineBreak":true},{"text":"di jum bu Aji Sax ji taal","poem":1},{"noteId":12},{"text":".","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndox mu ne xéew du fey mbëggeel,","poem":1},{"lineBreak":true},{"text":"ay dex du ko mëdd.","poem":1},{"lineBreak":true},{"text":"Ku koy weccee sa alalu kër gépp it,","poem":1},{"lineBreak":true},{"text":"ñu jéppi laa jéppi rekk.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Sunub jigéen lu ndaw la,","poem":1},{"lineBreak":true},{"text":"ween sax amu ko.","poem":1},{"lineBreak":true},{"text":"Lu nuy defal sunub jigéen","poem":1},{"lineBreak":true},{"text":"bés bu ñu koy bëggsi?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Su doon am tata,","poem":1},{"lineBreak":true},{"text":"nu tabaxal ko soorooru xaalis.","poem":1},{"lineBreak":true},{"text":"Su doon bunt,","poem":1},{"lineBreak":true},{"text":"nu aare ko xànqi seedar.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Maa dim tata,","poem":1},{"lineBreak":true},{"text":"sama ween di sooroor ya;","poem":1},{"lineBreak":true},{"text":"moo tax waa ji xam ne","poem":1},{"lineBreak":true},{"text":"maa di jàmmam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Suleymaan am na reseñ ca Baal Amon.","poem":1},{"lineBreak":true},{"text":"Da koo dénk ay beykat.","poem":1},{"lineBreak":true},{"text":"Ku nekk di ko fey meññeef ma","poem":1},{"lineBreak":true},{"text":"junniy dogi xaalis.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Junniy dogi xaalis yi,","poem":1},{"lineBreak":true},{"text":"Suleymaan, yaa ko moom;","poem":1},{"lineBreak":true},{"text":"ñaari téeméer yi, beykat yi.","poem":1},{"lineBreak":true},{"text":"Waaye sama toolub reseñ, maa ko moom.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Yaw mi tooge digg tool bi,","poem":1},{"lineBreak":true},{"text":"samay xarit a ngi teewlu sa baat,","poem":1},{"lineBreak":true},{"text":"waxal boog, ma dégg.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Nijaay, dawsil,","poem":1},{"lineBreak":true},{"text":"melal ni kéwél,","poem":1},{"lineBreak":true},{"text":"mbaa kooba gu ndaw","poem":1},{"lineBreak":true},{"text":"ci kaw tund wi ci gàncax gu xeeñ gi.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"8.2 Mbaa: nga jàngal ma baane,","reference":{"chapter":8,"verse":2}},{"noteId":11,"caller":"+","text":"8.6 torlukaay mooy jumtukaay bu mel ni lu ñuy tàmponee.","reference":{"chapter":8,"verse":6}},{"noteId":12,"caller":"+","text":"8.6 Mbaa: tàkk di sël-sëli.","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/wol_mbs/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}