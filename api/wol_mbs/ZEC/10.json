{"translation":{"id":"wol_mbs","name":"Kàddug Yàlla","website":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wolmbs","licenseNotes":null,"shortName":"MBS","englishName":"Wolof Bible (MBS)","language":"wol","textDirection":"ltr","sha256":"329fd8450c330df6c4f770463e0c4ad30c26caab7ded29c3eb1d9fe64441c97b","availableFormats":["json"],"listOfBooksApiLink":"/api/wol_mbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31128,"languageName":"Wolof","languageEnglishName":"Wolof"},"book":{"id":"ZEC","translationId":"wol_mbs","name":"Sàkkaryaa","commonName":"Sàkkaryaa","title":"Téereb Yonent Yàlla Sàkkaryaa","order":38,"numberOfChapters":14,"sha256":"278b5ad377ad8acfeef4d0ff19e93703ddd961b56db7cdfd16b549fdf67b6566","firstChapterNumber":1,"firstChapterApiLink":"/api/wol_mbs/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/wol_mbs/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Xërëm, neen la"]},{"type":"verse","number":1,"content":[{"text":"Bu suuf maree, ñaanal Aji Sax ji ab taw,","poem":1},{"lineBreak":true},{"text":"Aji Sax ji mooy sàkk ay xàmbaar,","poem":1},{"lineBreak":true},{"text":"sóobal nit ab taw,","poem":1},{"lineBreak":true},{"text":"saxalal ku ne am ñax ci àll bi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xërëm, waxi neen,","poem":1},{"lineBreak":true},{"text":"gisaanekat gisi fen,","poem":1},{"lineBreak":true},{"text":"seeni gént, nari neen,","poem":1},{"lineBreak":true},{"text":"te caaxaani neen lañuy dalalee.","poem":1},{"lineBreak":true},{"text":"Moo tax mbooloo mii di taxawaalu niy xar,","poem":1},{"lineBreak":true},{"text":"tumurànke ndax ñàkkub sàmm.","poem":1}]},{"type":"heading","content":["Yiwiku ñeelati na Israayil"]},{"type":"verse","number":3,"content":[{"text":"«Sàmm yi la sama mer tàkkal,","poem":1},{"lineBreak":true},{"text":"ñoom sikket yooyu laay dikke mbugal.","poem":1},{"lineBreak":true},{"text":"Aji Sax ji Boroom gàngoor yi kat mooy taxawu kërug Yuda, géttam,","poem":1},{"lineBreak":true},{"text":"te moo leen di def aw fasam wu am daraja, ngir xare.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fa Yuda la doju koñu tabax di bawoo,","poem":1},{"lineBreak":true},{"text":"jënu xayma, fa moom,","poem":1},{"lineBreak":true},{"text":"fittu xare, fa moom,","poem":1},{"lineBreak":true},{"text":"mboolem njiit yi ba ñépp daj, fa moom.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni ñeyi xare lañuy mel,","poem":1},{"lineBreak":true},{"text":"di joggati banu mbedd mi ci biir xeex bi.","poem":1},{"lineBreak":true},{"text":"Noonu lañuy xaree, nde ñoom la Aji Sax jiy àndal,","poem":1},{"lineBreak":true},{"text":"ñuy toroxal gawar yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maay jàmbaaral waa kër Yuda,","poem":1},{"lineBreak":true},{"text":"maay wallu waa kër Yuusufa,","poem":1},{"lineBreak":true},{"text":"suqali leen, ñeewante leen,","poem":1},{"lineBreak":true},{"text":"ñu mel ni masuma leena xarab,","poem":1},{"lineBreak":true},{"text":"nde man maay seen Yàlla Aji Sax ji,","poem":1},{"lineBreak":true},{"text":"te maa leen di nangul.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waa Efrayim ni ñeyi xare lañuy mel,","poem":1},{"lineBreak":true},{"text":"seen xol neexe ni bànneexu biiñ,","poem":1},{"lineBreak":true},{"text":"seeni doom gis ko, bég,","poem":1},{"lineBreak":true},{"text":"seenub xol di bànneexoo Aji Sax ji.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Maay waliis, dajale leen,","poem":1},{"lineBreak":true},{"text":"nde maa leen di jot,","poem":1},{"lineBreak":true},{"text":"ñu bareeti na ñu baree woon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fi biir xeet yi laa leen saawi,","poem":1},{"lineBreak":true},{"text":"waaye fa béreb yu sore ya lañu may fàttalikoo,","poem":1},{"lineBreak":true},{"text":"di fa dund ñook seeni doom,","poem":1},{"lineBreak":true},{"text":"ba keroog ñuy délsi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fa réewum Misra laa leen di waññee,","poem":1},{"lineBreak":true},{"text":"te fa Asiri laa leen di dajalee,","poem":1},{"lineBreak":true},{"text":"yóbbu leen réewum Galàdd ak Libaŋ,","poem":1},{"lineBreak":true},{"text":"te deesu fa gis fu ñu xaj.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Maay jàll géeju njàqare ga,","poem":1},{"lineBreak":true},{"text":"dal ca gannax ya,","poem":1},{"lineBreak":true},{"text":"mboolem xóotey dexu Niil wow,","poem":1},{"lineBreak":true},{"text":"sagub Asiri sàggiku,","poem":1},{"lineBreak":true},{"text":"nguurug Misra foq.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ci Aji Sax ji laa leen di jàmbaarale,","poem":1},{"lineBreak":true},{"text":"ciw turam lañuy daagoo.»","poem":1},{"lineBreak":true},{"text":"Kàddug Aji Sax jee!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wol_mbs/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wol_mbs/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wol_mbs/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}