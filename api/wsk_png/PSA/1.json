{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":1,"content":[{"type":"heading","content":["Kariimet diram alo se kariimet memek alo nunga den"]},{"type":"verse","number":1,"content":[{"text":"Awiriya kariimet memek nunga ikia me karo tuso,","poem":1},{"text":"ale kariimet memek betesan mu nunga nomolak me karoso,","poem":2},{"lineBreak":true},{"text":"agi kariimet den nunguning mu mel yam ko betera mu arungu me dagiso,","poem":2},{"lineBreak":true},{"text":"mu nu amilmil ago bagarukko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nu Yawe ko den ninguru ko amilmiloso,","poem":1},{"text":"ale tirom woremkalal den mu ko kuamin tugu se lagoso.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kari umu nu tam yu norogen te aguwa se baga ko tom te nunguning kapa se gawa me marakaso wore toroman.","poem":1},{"text":"Se nu anapeya nungurso mu am ningo la arataso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kariimet memek mu uwuta mena.","poem":1},{"text":"Nuna tam gawa merang daula itugu warso iwitata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Buta se kariimet memek alo mu tutera kam te koma memek tamonko;","poem":1},{"text":"nuna kariimet ningo diram mu nunga biguwura ningi me bagamonko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mu awuk, Yawe mu kariimet ningo diram mu nunga bagara aolak bitaruwoso;","poem":1},{"text":"bare kariimet memek alo mu sarenga namamonko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/RUT/4.json","previousChapterAudioLinks":{},"numberOfVerses":6}