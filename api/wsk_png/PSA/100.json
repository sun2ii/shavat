{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":100,"content":[{"type":"heading","content":["Kaem mu ningo pempem la"]},{"type":"verse","number":1,"content":[{"text":"Ali lilim ko kariimet, nina suen la amilmil","poem":1},{"text":"nirung beteral ale Yawe nup patawuralko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amilmil wur te tairal ale koma te nup patawuralko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ale ikialko, “Yawe nu Kaem!”","poem":1},{"text":"Nu kota nanga nungam, se ana noko;","poem":2},{"text":"ana noko kariimet, se nu nanga bitarso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ana nangamang amilmil biya te kasu","poem":1},{"text":"nagunak ale ko temple laili ningi nup patawunakko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mu awuk, Yawe mu ningo, se noko kua nangara ko munan mu kumik menara mena;","poem":1},{"lineBreak":true},{"text":"se ko munan nangarak pempem la baga","poem":1},{"text":"lagara mu, gue suen la te ta, wore am koma suanta tai lagoso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}