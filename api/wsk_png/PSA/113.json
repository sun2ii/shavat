{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":113,"content":[{"type":"heading","content":["Yawe mu kituwura guat alo nunga Kaem tala113:0 Juda alo Passover na namonko mu girisan Israel Wur 113 se 114 mu kausan ikisan. Se na no kutuwusan mu Israel Wur 115 nama 118 kausan ikisan. Matthew 26:26-30 ago arikko."]},{"type":"verse","number":1,"content":[{"text":"Ana Yawe ko nup patawunakko!","poem":1},{"lineBreak":true},{"text":"Nina ko ura kari alo, noko nup patawuralko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yawe ko nup aitak tom imi te se tom","poem":1},{"text":"udagi te am butata patawu se lagaralko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Koma worem bausa te nama worem","poem":1},{"text":"kapara te, Yawe nup patawuralko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe ali sor suen la bitarso;","poem":1},{"text":"noko nikim nup biya mu taiti gomang kia saparam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awiri Yawe, anananga Kaem, mu toroman?","poem":1},{"text":"Nu ko daiga kuwim kalel biya mu te dagiwa se,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"gomang motam nangarso se taiti ta, ali ta, motam kaposo se","poem":1},{"text":"ninguru ari kutuwuwoso.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nu kariimet kituwura guat, bune tutuk ali te mu gi no se,","poem":1},{"text":"nongota nunumi sangarmonko me terong, mu nunga sangarso,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ale nunga gi terong la noko kariimet","poem":1},{"text":"supuling alo nunga ningi nunga awuso se yawarakala bagasan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nu imet kuin sisira mu nunga bagara aolak te nunga sangarso,","poem":1},{"lineBreak":true},{"text":"se kuriang ilusan ale amilmilasan.","poem":1},{"text":"Se ana Yawe ko nup patawunakko!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}