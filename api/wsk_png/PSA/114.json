{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":114,"content":[{"type":"heading","content":["Passover ko amilmil wur"]},{"type":"verse","number":1,"content":[{"text":"Israel kariimet sor iwareng Egypt beteman ale arataman;","poem":1},{"lineBreak":true},{"text":"nuna mu Jacob ko digo ko kariimet alo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"se tom mu te Kaem Judah noko bagara kuwim ko beteram, ale","poem":1},{"lineBreak":true},{"text":"Israel lilim mu nunga gira kari bagakaso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Se gagi umu arigam ale tagaram naguram,","poem":1},{"text":"se yu Jordan kapawaram mu koma ira gurugam peleram.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Duruk alo mu uririkikasan ale sipsip","poem":1},{"text":"anumang bibiya iwita ting ting makasan,","poem":2},{"lineBreak":true},{"text":"se motongar kuting gotektek mu sipsip gotektek iwita ting ting makasan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O gagi, ni mu awuk se tagerem nagurem?","poem":1},{"text":"O Jordan, se ni awuk se kapawa kema ira gurugem pelerem?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Se nina duruk alo, awuk se ting ting makasan?","poem":1},{"text":"Se nina motongar gotektek koma suanta bitakasan?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O ali, tom Kari Biya Jacob ko Kaem","poem":1},{"text":"taiso mu, koma te mu ni uririkisam;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"nu manga garap ningi yu beteram se lairam bausam,","poem":1},{"text":"manga garap aora garagar mu ningi yu palengam kapakaso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}