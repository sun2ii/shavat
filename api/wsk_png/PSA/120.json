{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":120,"content":[{"type":"heading","content":["Kariimet memek nunga ningi baga se Kaem ko saonga ko guranek"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur)"]},{"type":"verse","number":1,"content":[{"text":"Aninga ikup ningi Yawe arusam,","poem":1},{"text":"se nu agiring iluso.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Yawe, kariimet nuguring kawel karogo wore nuguting te aga sangaru toko,","poem":1},{"lineBreak":true},{"text":"ale kariimet nungamili guruga patawura","poem":1},{"text":"karogo mu nuguting te aga sangaru toko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nina kariimet nigiring memek mu, nu awuk ninga bitiruk i?","poem":1},{"text":"Ale anape bo karogo nengete bitirukko?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nu kager kari ko daga gotek kore buguyam mu te ninga moruk,","poem":1},{"text":"ale tuwer giturum kaniwara mu te ninga kaiyokko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bare ani Meshek kariimet nunga ningi baga maguwu lagasam;","poem":1},{"text":"ani Kedar kariimet nunga ningi memek baga lagasam.","poem":2},{"noteId":76}]},{"type":"verse","number":6,"content":[{"text":"Ani kariimet, lila te bagara ko kiwem mu","poem":1},{"text":"me ko kuawara umu nunga ningi tom maiya biya bagerem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani mu angamang lila ko kari;","poem":1},{"text":"bare tom ani bagara lila mu ko","poem":2},{"lineBreak":true},{"text":"balukasam, mu nuna kager ko la balukasan.","poem":2}]}],"footnotes":[{"noteId":76,"caller":"+","text":"Wonong sor ilagala imi Israel ko awar nuam. Nu Kaem ko me ikia alo se nusupuling lagara ko kariimet wore nunga ningi bagakaso.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/wsk_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}