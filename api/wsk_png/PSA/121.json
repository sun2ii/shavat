{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":121,"content":[{"type":"heading","content":["Yawe kota suanta nika Sinar Kari"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur)"]},{"type":"verse","number":1,"content":[{"text":"Ani amotam duruk te loagasam,","poem":1},{"text":"bare aninga saonga aparete tairukko?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aninga saonga mu Yawe kote tairukko;","poem":1},{"text":"nu taiti se ali kiwolaram.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nu me ka bitiruk se dagulko,","poem":1},{"text":"nika Sinar Kari mu motam me anirukko;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"nunguningta, Israel ko Sinar Kari mu motam me kuiniso, ale me aniso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yawe nu kota ka sinar taukko;","poem":1},{"text":"nu beta dugu te baga se ko tamarum bowa ningi ni bagerko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Se woremkalal mu worem me ka kanirukko,","poem":1},{"text":"se aking tirom mu mel memek bo me ka maguwurokko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawe ka sinar tauk se memek suen biya ka kia kaparukko;","poem":1},{"text":"nu nika bagara aolak ko sinar taukko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nu nika namara taira bagara aolak ko","poem":1},{"text":"sinar tauk se ningo la pempem lagerko. Nunguning.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}