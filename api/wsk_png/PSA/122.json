{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":122,"content":[{"type":"heading","content":["Jerusalem ko Kaem amilmil tuokko wur"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur David batogam)"]},{"type":"verse","number":1,"content":[{"text":"Tom nuna aninga manorman,","poem":1},{"text":"“Ario! ana Yawe ko temple te namanakko,” maman,","poem":2},{"lineBreak":true},{"text":"mu ani ninguru amilmilerem.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Jerusalem, ana aitak nika songkuring ago sanamiwasan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalem wonong mu iwita kaloman,","poem":1},{"text":"numi kitira biya se aora biya nunguningkiri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umu te Yawe ko kariimet Israel, digo","poem":1},{"text":"koma koma te tarigisan, ale te balam uwutata te nup patawusan.","poem":2},{"noteId":77}]},{"type":"verse","number":5,"content":[{"text":"Ale kuwim umu betela ikup guyak te tuati nunga ko kuwim,","poem":1},{"text":"se king bibiya David te kaparam mu nunga daiga kuwim.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Buta se Jerusalem ko marolila ko guranek beteralko:","poem":1},{"text":"“O Jerusalem, awiriya nika kueso mu daiga bagara yawara arigimonko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nika por ka lautam mu ningi mu marolila anirukko,","poem":1},{"text":"se ka kawam suen la mu bitua karogo la!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aninga gue suan alo se aga sikisaki","poem":1},{"lineBreak":true},{"text":"alo nunga ningo ko se, ani iwita balsam,","poem":1},{"text":"“Jerusalem, marolila nika ningi anirukkowo!”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yawe anananga Kaem ko temple laili mu nika ningi aniso mu ko se,","poem":1},{"text":"ani nika ningo pempem la anirukko mu ko nu aru wosenga se lagarikko.","poem":2}]}],"footnotes":[{"noteId":77,"caller":"+","text":"122:4 Deuteronomy 12:13-14.","reference":{"chapter":122,"verse":4}}]},"thisChapterLink":"/api/wsk_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}