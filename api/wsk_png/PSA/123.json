{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":123,"content":[{"type":"heading","content":["Kaem ko gomang lila ko wosenga"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur)"]},{"type":"verse","number":1,"content":[{"text":"O Yawe, ani amotam patawu duruk","poem":1},{"text":"wonong te, nika daiga kuwim te, nikate loagasam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ura dungan kari ko kari biya kote sangam taukko motam beteso iwita,","poem":1},{"text":"agi ura imet, ko imet biya kote sangam taukko motam beteso iwita,","poem":2},{"text":"uwutatala, anananga namotam Yawe,","poem":1},{"text":"nanga Kaem, mu kote loaga se laganak se, gomang lila nangaruk","poem":2},{"lineBreak":true},{"text":"nunguningkiri bare asele terong ko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gemang lila nangaruko, O Yawe, nika gemang lila nangaruko,","poem":1},{"text":"mu awuk, ana ikup yaman ninguru ta giman terong mam.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nunumi patawura ko kariimet alo mu anananga balu sisuwusan,","poem":1},{"text":"ale mel yam ko nanga betesan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}