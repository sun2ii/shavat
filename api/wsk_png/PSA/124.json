{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":124,"content":[{"type":"heading","content":["Kaem ko kariimet nunga Bitua Kari bagoso"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur; David ko wur)"]},{"type":"verse","number":1,"content":[{"text":"O Israel, ikialko! Yawe ana nangarak","poem":1},{"text":"me sanamaram le mu, ana memek taman le.","poem":2},{"lineBreak":true},{"text":"Buta se nina nigiring bolala iwita balalko:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Yawe ana nangarak me sanamaram le mu,","poem":1},{"text":"tom kager kari nangarak kagerman,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"tom nunga nongomang memek nago ko","poem":1},{"text":"beteman, mu nuna ana marak nanga lakuman la;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"se yu lom nanga ira baguram,","poem":1},{"text":"ale nanga iramuram la,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"se yu lom kalel biya mu nanga sarumu waram la.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ana Yawe nup patawunakko,","poem":1},{"text":"nu ana nanga beteram se kager kore ningi me batuwutuk maman.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ana inangnang iwita naguman","poem":1},{"text":"bulamara kari ko dagarok kiaman;","poem":2},{"text":"dagarok mu batagam gogong karogo,","poem":1},{"text":"se ana kiaman ale naguman.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ana Yawe ko nup te saonga tasan,","poem":1},{"text":"nu Kiwol Kari taiti se ali nungam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}