{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":125,"content":[{"type":"heading","content":["Yawe nanga lauta bagoso"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur)"]},{"type":"verse","number":1,"content":[{"text":"Kariimet Yawe te la ira sanamasan mu","poem":1},{"text":"Duruk Zion iwita sokel ago bagamonko;","poem":2},{"text":"duruk mu me namoso taiso, bare pempem sokel ago la baga lagoso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Duruk saki Jerusalem laturu guruguman bagasan iwita,","poem":1},{"lineBreak":true},{"text":"Yawe ko kariimet nunga lautam bagoso, aitak se tom pempem la.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kariimet memek alo mu kariimet ningo","poem":1},{"text":"diram nunga ali sor Yawe nungaram mu me bitaru se lagamonko,","poem":2},{"text":"mu awuk, kariimet ningo diram nononga","poem":1},{"lineBreak":true},{"text":"kiwem memek iki karo tumon bore ko.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O Yawe, ni kariimet ningo diram, nika","poem":1},{"text":"kiring karo tusan, mu munan ningo la nungumik te bitarko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bare arikaya pelesan aking kilek memek ningi namasan,","poem":1},{"lineBreak":true},{"text":"mu Yawe nunga karuk se kariimet memek tasan mu nongorak memek tamonko.","poem":1},{"lineBreak":true},{"text":"O Yawe, aninga angamang mu nika","poem":1},{"text":"gemang lila Israel tui se lila te bagamonko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}