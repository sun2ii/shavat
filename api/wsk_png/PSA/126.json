{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":126,"content":[{"type":"heading","content":["Yawe ko kariimet talipara ningi nongorak peleram wur te Zion tairam"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur)"]},{"type":"verse","number":1,"content":[{"text":"Tom Yawe ana talipara ningi nanga giam nangarak Zion peleram tairam","poem":1},{"text":"mu ana “Ipingisan i?” maman.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ana gusira ngata te, amilmil te, wur la","poem":1},{"text":"taikasan, se sor saki ko kariimet ana nangarkikasan mu balukasan,","poem":2},{"lineBreak":true},{"text":"“Yawe kariimet umu nungumik te kilek bibiya beteram,” makasan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Se mu nunguningta, Yawe ana nangimik te kilek bibiya beteram,","poem":1},{"text":"se ana ninguru amilmilasan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"O Yawe, ana peleman taiman bare mel suen la maga saparam;","poem":1},{"text":"se ni sor garagarayam te tuwik betesam se kaposo iwitata,","poem":2},{"lineBreak":true},{"text":"marak sokel iru nangaru se aking yawarakala te baganakko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Se kariimet nomononge kapa se nunga na inang asursan,","poem":1},{"text":"mu udagi wur amilmil te na inang nunguning gimonko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mu awiriya nomononge kapa se, na inang kumi gisan ale asurmonko namasan,","poem":1},{"lineBreak":true},{"text":"mu udagi te amilmil wur ilu se,","poem":1},{"text":"inang nunguning gi ago taimonko!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}