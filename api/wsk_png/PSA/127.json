{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":127,"content":[{"type":"heading","content":["Yawe te mel suen biya terong la arataso"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur; Solomon wur imi batogam)"]},{"type":"verse","number":1,"content":[{"text":"Yawe nu kawam kaola kari mu arungu me bagaruk agi mu,","poem":1},{"text":"ura kari nongota ura bo nunguning me betemonko.","poem":2},{"text":"Yawe wonong buring tuok agi mu,","poem":1},{"text":"bitua kari mu wonong bitarmonko me terong tala.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tumong biyala barasa ale","poem":1},{"text":"nangata nanga sokel te inang ko ura ilu lagara nama uriluanara,","poem":2},{"lineBreak":true},{"text":"mu ko ikia me terong,","poem":2},{"text":"mu awuk, Yawe ko kariimet nunga kueso mu inang nungarso se nasan,","poem":1},{"text":"ale ninguru anisan nonoman sapasan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawe kuriang nangarso mu noko munan ningo nunguningkiri wore nangarso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kari kulak ko kuriang kari aratasan,","poem":1},{"text":"mu gatu siping ago kari kuting te iluwoso iwita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kari ko gatu gotek suen biya gatu siping ningi, mu nu amilmilarukko.","poem":1},{"lineBreak":true},{"text":"Kariimet sang taimon nu ilak nunumi ilumon, bare nu me ta dolurukko,","poem":1},{"text":"mu awuk, noko kuriang alo mu nu sangarmonko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}