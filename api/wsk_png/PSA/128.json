{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":128,"content":[{"type":"heading","content":["Kari Kaem kuring karo tuso mu koma yawara taso"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur)"]},{"type":"verse","number":1,"content":[{"text":"Arikaya Yawe ko nguangasan","poem":1},{"text":"ale noko munan la karo tusan mu amilmilamonko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uwuta bitar mu ni ka ura kowar ko koma gi noko;","poem":1},{"text":"marak ningo se daiga bagara ningo mu arik ale amilmilerko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nika niwus mu tam ningo bo iwita nunguning kapa kisu se lagarukko;","poem":1},{"text":"nika kuriang mu tam butuk yawara iwita ka laturmonko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Awiriya Yawe ko nguangoso mu,","poem":1},{"text":"nu uwutata marak sokel tuokko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aga angamang mu Yawe Zion baga se, ni","poem":1},{"text":"marak sokel kisok se pempem butata baga se lagerko;","poem":2},{"text":"se Jerusalem bagara ningo se mel kasik la","poem":1},{"text":"karogo terong mauk mu ni arikko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ale ni mu baga laga, ka kuriang nutagu te ka imas aratamon se nungarkiko.","poem":1},{"text":"Kaem ko lila yawara Israel nengerak bagarukko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}