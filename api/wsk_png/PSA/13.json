{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":13,"content":[{"type":"heading","content":["Kaem ko saonga ko niara"]},{"type":"hebrew_subtitle","content":["(David ko wur)"]},{"type":"verse","number":1,"content":[{"text":"O Yawe, ni tom awila nunguningkiri ani ago ko kamili saparukko?","poem":1},{"text":"Ni tom awila nunguningkiri ani ago ko kema kaluwurko?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani tom awila nunguningkiri ikia aga moa lagarukko?","poem":1},{"text":"ale tirom woremkalal angamang bataga lagarukko?","poem":2},{"lineBreak":true},{"text":"Tom awila nunguningkiri aga kager kari aga maguwu lagamonko?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"O Yawe, ni aninga Kaem,","poem":1},{"text":"kema gurugu aisu ale agiring ilupko!","poem":2},{"lineBreak":true},{"text":"Aga sangaru se ani me kuerikko;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kager kari alo balmon, “Ana ka sokel menawuman,” mamon,","poem":1},{"text":"ale amilmilamon, “Ni dagulem,” ma aga balmon bore ko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bare ni ani ago ko kua lagasam mu ko ani angamang ningi nunguning aso;","poem":1},{"text":"ale kager kari nuguting te aga bataguru toko mu ko ani amilmilasam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yawe, ani wur iluwek ale nip patawurikko,","poem":1},{"text":"mu awuk, ni ani ago ko ningo la bita lagasam.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}