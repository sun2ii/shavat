{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":130,"content":[{"type":"heading","content":["Yawe kota anananga memek siwura ikiso"]},{"type":"hebrew_subtitle","content":["(Ilu se temple te nama tarigira ko wur)"]},{"type":"verse","number":1,"content":[{"text":"O Yawe, ani ikup ningi sarenga namarikko iwita se ka arusam.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O aga Biya, agiring ikiko,","poem":1},{"text":"degewa gurugu ale agiring iki ale aga sangaruko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Yawe, ni anananga memek suen la ari kutuwusam,","poem":1},{"lineBreak":true},{"text":"ale memek mu te sanamir mu,","poem":1},{"text":"awiri memek mena se ningo bagarukko? Mena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bare ni anananga memek siwu","poem":1},{"text":"nangarsam, se ana ni bowa ningi kua kisu se laganakko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ani Yawe aga sangukko angamang motam lilim te ko kimi bitawasam,","poem":1},{"text":"ale ko den te la ira sanami lagasam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sor bitua kari sor pasak ukirok se nama","poem":1},{"text":"noman saparukko kimi tui lagoso iwitatala,","poem":2},{"lineBreak":true},{"text":"ani Kari Biya tairuk aga sangukko amotam bitawasam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O Israel, Yawe kote la loaga se lagaralko,","poem":1},{"lineBreak":true},{"text":"mu awuk, nu ana ninguru nanga kua","poem":1},{"text":"lagoso, ale nu nanga sangukko terong.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nu kota anananga memek suen la siwura ikiso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}