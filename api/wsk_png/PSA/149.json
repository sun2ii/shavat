{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":149,"content":[{"type":"heading","content":["Kaem ko kariimet nunga ningo beteram ko amilmil"]},{"type":"verse","number":1,"content":[{"text":"O aleluya! Yawe ko nup patawuralko!","poem":1},{"lineBreak":true},{"text":"Wur iru iluwal ale nup patawuralko;","poem":1},{"text":"nina ko kariimet biguwural ale ko nup patawuralko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israel kariimet, Yawe ko amilmilaralko, nu ninga nungam;","poem":1},{"text":"Zion kariimet, ninga King ko amilmilaralko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bawe moa se, gita ela se, iru seseka se nup patawuralko!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mu awuk, Yawe nina noko kariimet ninga ninguru amilmiloso;","poem":1},{"text":"nu nina ninimi karogo kapaman se nu ninga sangaru tam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nu nenenga ninip biya mu bala iwita","poem":1},{"text":"nisipiling tugumam se ninguru amilmilaralko;","poem":2},{"lineBreak":true},{"text":"ale tirom anira tom te karogo la amilmil wur ilu se lagaralko!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kaem nup biya tuata mu nina nigiring te aniruk se,","poem":1},{"text":"batir kore wuli kapawara mu nigiting te iluwal,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ale te sor saki ko kariimet memek mu nunga memek koma nunga maguwuralko;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ale nunga king se nunga kari bibiya mayang aora te nunga taliparal,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ale Kaem ikup aguwaya nunga memek koma balam mu te nunga beteralko.","poem":1},{"text":"Kaem ko gomang motam noko kariimet nunga mu uwutata.","poem":2},{"lineBreak":true},{"text":"Aleluya! Yawe nup patawuralko!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}