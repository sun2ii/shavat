{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":15,"content":[{"type":"heading","content":["Awiri Yawe ilak bagarukko terong?"]},{"type":"hebrew_subtitle","content":["(David ko wur)"]},{"type":"verse","number":1,"content":[{"text":"O Yawe, awiri nika kuwim laili nunguning mu ningi kasu nagurokko terong?","poem":1},{"text":"Awiri nika duruk Zion mu te bagarukko terong?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mu awiriya ko bagara aolak diram la,","poem":1},{"text":"se munan diram la beteso;","poem":2},{"text":"noko kuring te den nunguning la arataso,","poem":1},{"text":"umutang ni kerak bagarukko terong.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu saki alo me nunga balu maguwuso;","poem":1},{"text":"ale saki alo nungumik te memek bo me beteso;","poem":2},{"lineBreak":true},{"text":"ale saki alo nubiring ko den me balu balu geragoso.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nu kariimet memek nunga me kueso;","poem":1},{"text":"bare nu kariimet Yawe ko kuring karo tusan mu nunga kueso.","poem":2},{"text":"Nu mel bitirukko balso mu eng am butata beteso,","poem":1},{"text":"bitiruk ale ko ikup giokko agi mu me ko nguangoso, am beteso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nu bo manga te sangarso mu koma tuam","poem":1},{"text":"uwutatala aking taso, marir manga bo karogo me taso;","poem":2},{"text":"ale nu kariimet saki alo nungumik den mena, mu nunga bita maguwurokko","poem":1},{"text":"gomang kulukursan ale manga mel te diasan bare mu me taso,","poem":2},{"lineBreak":true},{"text":"ale munan mu me beteso.","poem":2},{"lineBreak":true},{"text":"Awiriya kiwem imi karo saposo, kariimet umutang gek am bagoso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}