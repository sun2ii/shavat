{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":150,"content":[{"type":"heading","content":["Kaem nup patawura ko wur bo"]},{"type":"verse","number":1,"content":[{"text":"O aleluya! Yawe ko nup patawuralko!","poem":1},{"lineBreak":true},{"text":"Noko kuwim laili ningi ko nup patawuralko;","poem":1},{"text":"noko sokel taiti gomang te mu ko nup patawuralko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ura bibiya sokel ago beteram mu ko nup patawuralko;","poem":1},{"text":"noko nup biya kualala biya aniso mu ko nup patawuralko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kua sokelel itugu se nup patawuralko;","poem":1},{"text":"gita kulele ela se nup patawuralko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tambourine sisuwu se, iru se, nup patawuralko;","poem":1},{"text":"goyak bawe ela se, iru se, nup patawuralko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kapa bilik moral ale te nup patawuralko;","poem":1},{"text":"moral se ko nirung biyala kaparuk se te nup patawuralko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Melmasak suen la marak bagasan mu Yawe nup patawuralko!","poem":1},{"lineBreak":true},{"text":"Aleluya! Yawe Biya nup patawuralko!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}