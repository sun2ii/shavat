{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":23,"content":[{"type":"heading","content":["Kari Biya mu aninga Bitua Kari Yawara"]},{"type":"hebrew_subtitle","content":["(David ko wur)"]},{"type":"verse","number":1,"content":[{"text":"Yawe mu aninga Bitua Kari,","poem":1},{"text":"se ani mel bo ko me tukunangasam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nu ani kuwim ningo wolong wore te agarak namoso,","poem":1},{"lineBreak":true},{"text":"yu ningo bo duap te agarak namoso,","poem":1},{"text":"se ani dagisam ale aeman sapasam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu sokel sangam iru aisiso;","poem":1},{"text":"ale kota ko nup biya ko ningo ko,","poem":2},{"text":"nu aninga kiti guruguso se lage ningo diram mu karosam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ani ta memek biya ningi kaparik, bare ani memek mu ko me nguangarikko,","poem":1},{"text":"mu awuk, ni ani agarak bagasam;","poem":2},{"text":"nika tam te aga bitarsam mu se,","poem":1},{"text":"nika sikir te aolak ilu se aga kiti gurugusam mu ani sokel aisiso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ni aninga kager kari nomotam te na ningo ningo angama te awusam;","poem":1},{"lineBreak":true},{"text":"ale oil siring yawara asupuling te warsam;","poem":1},{"text":"se ani ninguru ko amilmilasam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nunguningta, nika ningo se nika gemang","poem":1},{"text":"lila mu ani agarak pempem ani se lagarukko,","poem":2},{"text":"se ani ni kerak ka bagara kuwim te butata baga se lagarikko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}