{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":3,"content":[{"type":"heading","content":["Kaem te la ira sanami se laganakko"]},{"type":"hebrew_subtitle","content":["(David king ko bagakaso, bare noko kuriang Absalom noko ura nu taukko ago kaeyakaso, se David Absalom ko nagu se den imi balam)",{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"O Yawe, ani ago ko kager kari memek suen biya!","poem":1},{"text":"Nuna suen biya nunguningkiri ani agarak kagerawasan!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ale nuna ani ago ko balsan,","poem":1},{"text":"“Kaem nu me sangukko pa!” masan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bare Yawe, ni keta suanta aninga karem se ni aninga lautem;","poem":1},{"lineBreak":true},{"text":"ni aninga kager menawusam ale nup biya se sokel aisisam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ani Yawe kote sail ago niasam,","poem":1},{"text":"se nu ko duruk laili mu te baga se agiring iluso.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ani taga anisam, ale anisam;","poem":1},{"text":"ale ukiso se barasasam;","poem":2},{"text":"Yawe aga bitarso se memek bo me arigisam.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ani kager kari memek suen biya nunguningkiri aga laturu sapaman,","poem":1},{"text":"bare ani me ta nguangasam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O Yawe, aninga Kaem, bares ale aga bataguru toko!","poem":1},{"text":"Ni kari memek alo nogol kulukumur ale nogore motam biagerko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"O Yawe, ni keta anananga Bataguru Ta Kari.","poem":1},{"text":"Nika kariimet marak nungaruko.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Absalom: 2 Samuel 15-18.","reference":{"chapter":3,"verse":0}}]},"thisChapterLink":"/api/wsk_png/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}