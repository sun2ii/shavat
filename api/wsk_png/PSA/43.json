{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":43,"content":[{"type":"heading","content":["Kaem mu aninga Saonga Kari se aninga yumura kuwim aora"]},{"type":"verse","number":1,"content":[{"text":"Aga Kaem, kariimet nubiring ni kisiman","poem":1},{"text":"ale kiwem memek se kawel te aga bita maguwusan","poem":2},{"lineBreak":true},{"text":"umu, nuguting te aga bataguru toko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ni Kaem, aninga yumura kuwim aora.","poem":1},{"text":"Ni awuk se biring gurugu aisem?","poem":2},{"text":"Awuk se kari memek aga maguwuman","poem":1},{"text":"se iwitata ma niara te la bagasam?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nika nikim se nika bitua ningo mu te lage aga kasuru ale","poem":1},{"text":"agarak nika bagara kuwim, ka duruk laili mu te agarak namarko.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Se ani nika altar duap te namarik ale gita moa se ka nip patawurikko,","poem":1},{"text":"mu awuk, ni aninga Kaem,","poem":2},{"text":"ni angamang sangam tuem ale amilmil aisem se ani ni ko ko ninguru amilmilasam.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aninga angamang motam pa awuk se dagulam?","poem":1},{"text":"Awuk se kumik lila mena?","poem":2},{"text":"Bare aninga ikia, aninga loagara mu Kaem kote la bitirikko;","poem":1},{"lineBreak":true},{"text":"se nu aninga sanguk se ani akingtala nup patawurikko;","poem":1},{"lineBreak":true},{"text":"nu aninga Saonga Kari, se aninga Kaem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}