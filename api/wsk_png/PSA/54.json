{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":54,"content":[{"type":"heading","content":["Kari ikup memek ningi baga se kue kumik ko Kaem auram"]},{"type":"hebrew_subtitle","content":["(Ziph kari alo Saul kote namaman ale David nononga sor te yumuram bagoso mu ko Saul manorman se David batoga imi batogam)",{"noteId":13}]},{"type":"verse","number":1,"content":[{"text":"O Kaem, nika nip biya ko sokel te aga bataguru toko;","poem":1},{"text":"ani memek bo me beterem se nika sokel te aga sangaruko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Kaem, aninga guranek ikiko;","poem":1},{"text":"degewa gurugu ale aninga aira ikiko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nusupuling lagara alo mu ani agarak kagerawasan;","poem":1},{"text":"nuna daong kager ko kari se aninga momon se kuerikko;","poem":2},{"lineBreak":true},{"text":"nuna Kaem mel yam ko iwita ikisan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nunguningta, Kaem mu aninga saonga","poem":1},{"text":"kari; nu aninga bitarso se ani terong la bagasam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"O Kaem, nononga memek ani ago ko beteman mu koma nungaruko;","poem":1},{"lineBreak":true},{"text":"ni munan diram la karo tua ko Kaem,","poem":1},{"text":"buta se nunga menawurko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O Yawe, aninga angamang amilmil te tama bo bita kisekko;","poem":1},{"lineBreak":true},{"text":"ani nika nip patawurikko,","poem":1},{"text":"mu awuk, nika nip mu ningo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni aninga sangem se ikup suen la angimik te aratam mu me aga maguwuram,","poem":1},{"text":"ale amotam te aga kager ni nunga maguwurem se nungarkem.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"1 Samuel 23:14-15,19-25.","reference":{"chapter":54,"verse":0}}]},"thisChapterLink":"/api/wsk_png/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}