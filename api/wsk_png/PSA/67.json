{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":67,"content":[{"type":"heading","content":["Kariimet Kaem amilmil tumonko wur"]},{"type":"verse","number":1,"content":[{"text":"O nanga Kaem, nika gemang lila se ka marak nangaruko;","poem":1},{"text":"gemang nangaru ale ka nikim yawara nangaruko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mu te ali lilim ko kariimet nika munan se","poem":1},{"text":"ka sangaru ta ko sokel mu ko ikimonko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Kaem, aninga angamang kariimet","poem":1},{"text":"suen la ni ko ko amilmilamon ale nip patawumonko!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nuna amilmil kelagamon ale wur ilu se nip patawumonko,","poem":1},{"text":"mu awuk, ni munan diram te la kariimet nunga bitarsam,","poem":2},{"lineBreak":true},{"text":"ale ikia ningo te la ali sor suen biya nunga kiti gurugusam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O Kaem, aninga angamang kariimet","poem":1},{"text":"suen la ni ko ko amilmilamon ale nip patawumonko!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Se ali imi te na inang sor magarukko,","poem":1},{"text":"Kaem, anananga Kaem, mu nu marak nangarukko.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nunguningta Kaem gomang nangarukko,","poem":1},{"text":"se ali dun sika te nama dun sika te, nu bowa ningi la bagamonko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}