number":5,"content":[{"text":"Bare ani kituwura, asokel mena;","poem":1},{"text":"buta se O Kaem, tairate tair ale aga bataguru toko.","poem":2},{"text":"O Yawe, ni aninga saonga se aga bataguru ta ko kari;","poem":1},{"text":"ni pasak ala tair ale aga sangaruko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}