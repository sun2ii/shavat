{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":87,"content":[{"type":"heading","content":["Zion nup biya tua ko wur"]},{"type":"hebrew_subtitle","content":["(Korah ko kuriang alo nunga wur bo)"]},{"type":"verse","number":1,"content":[{"text":"Yawe ko wonong duruk laili Zion awote kaolam;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"nu Jacob ko wonong sor suen la ningi, Zion mu nu ninguru ko kueso.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"O Kaem ko wonong, bala ningo ningo ni ko ko balsan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kaem iwita balam,","poem":1},{"lineBreak":true},{"text":"“Wonong sor aninga ikisan mu ningi,","poem":1},{"text":"ani Egypt se Babylonia nunga nunup balik ale,","poem":2},{"text":"Philistia, Tyre, se Cush","poem":1},{"noteId":46},{"text":"mu nunga nunup","poem":1},{"text":"karogo balik, ale iwita balikko,","poem":2},{"text":"‘Sor imi Zion wonong ko kariimet tala,’ maikko.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nunguningta, Zion ko iwita balmonko,","poem":1},{"text":"“Kariimet imi, se kariimet umu, mu Zion ko kariimet tala,” ma balmonko.","poem":2},{"text":"“Se Kaem Sokel Garagar mu eng am Zion sokel tuokko,” ma balmonko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yawe kariimet nunup giok ale nunup duap te mu iwita batagukko,","poem":1},{"text":"“Kariimet imi Zion wonong ko kariimet.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Se nuna wur ilumon ale iru seseka se balmon,","poem":1},{"text":"“Ana nanga mel ningo ningo suen la mu Zion ningi bulowolok maso ale taiso,” mamonko.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"Egypt ko nup bo mu Rahab (NIV arikko). Se Cush mu sor Yu Nile ko supuling ko aniso.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/wsk_png/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}