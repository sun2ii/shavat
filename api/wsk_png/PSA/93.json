{"translation":{"id":"wsk_png","name":"KAEM KO DEN","website":"https://ebible.org/Scriptures/details.php?id=wsk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=wsk","licenseNotes":null,"shortName":"PNG","englishName":"Waskia Bible","language":"wsk","textDirection":"ltr","sha256":"23464256438a5388d98ca1819835696d28e9cddafc7c8e1dfcb90527dbd1e76a","availableFormats":["json"],"listOfBooksApiLink":"/api/wsk_png/books.json","numberOfBooks":38,"totalNumberOfChapters":531,"totalNumberOfVerses":13588,"languageName":"Waskia","languageEnglishName":"Waskia"},"book":{"id":"PSA","translationId":"wsk_png","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"503e736b4bba4139cd55eb68d9be213df27d1fb4195d81d4c7ff798dbb0a1f04","firstChapterNumber":1,"firstChapterApiLink":"/api/wsk_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/wsk_png/PSA/150.json","totalNumberOfVerses":2456},"chapter":{"number":93,"content":[{"type":"heading","content":["Yawe nu King Biya bagoso"]},{"type":"verse","number":1,"content":[{"text":"Yawe nu King Biya;","poem":1},{"text":"nu nup biya nunguningkiri se sokel garagar.","poem":2},{"text":"Nu ali sokel ago nungam se gek am aniso, ale me namaruk tairukko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"O Yawe, ni duap te nunguningkiri bagakasam,","poem":1},{"text":"ale mel suen biya me aratukaso la, ni tom suen biya ko king bagakasam.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gagi mu nirung biyala kaposo,","poem":1},{"text":"ko tamun sokel ago kelagoso se nirung biyala barasoso.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bare ni mu am kualala biya,","poem":1},{"text":"sokel ago nunguningkiri bagasam.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O Yawe, nika munan den mu tom suen","poem":1},{"text":"biya ko; se nika temple tom suen biya laili nunguningkiri anirukko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/wsk_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/wsk_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/wsk_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}