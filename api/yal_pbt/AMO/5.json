{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"AMO","translationId":"yal_pbt","name":"Nabi Amosi Sora","commonName":"Nabi Amosi Sora","title":"Amosi Nabi Amosi Alaa Falan Naxan Sɛbɛ","order":30,"numberOfChapters":9,"sha256":"99f717e85c02856221959666d61bcfc2166a72731e751797e09751a18a8f03a7","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/yal_pbt/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Alaa mawugana"]},{"type":"verse","number":1,"content":[{"text":"Ɛ falani ito ramɛ.","poem":1},{"lineBreak":true},{"text":"N bata ɲande bɛtini ito ba Isirayila yamaan xa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Isirayila bata lu","poem":1},{"lineBreak":true},{"text":"alo sungutun faxaxina,","poem":1},{"lineBreak":true},{"text":"a mi fa kelɛ sɔnɔn.","poem":1},{"lineBreak":true},{"text":"A saxi bɔxɔni,","poem":1},{"lineBreak":true},{"text":"muxu yo mi a rakelɛ.”","poem":1}]},{"type":"verse","number":3,"content":["Marigina Alatala ito nan falaxi, a naxa,",{"text":"“Isirayila bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"taan naxan muxu wuli keden nasigama yɛngɛsodeni,","poem":1},{"lineBreak":true},{"text":"a muxu kɛmɛ nan gbansan toma xɛtɛ.","poem":1},{"lineBreak":true},{"text":"Taan naxan muxu kɛmɛ rasigama yɛngɛsodeni,","poem":1},{"lineBreak":true},{"text":"a muxu fu nan gbansan toma xɛtɛ.”","poem":1}]},{"type":"verse","number":4,"content":["Alatala ito nan falaxi Isirayila yamaan xa, a naxa,",{"text":"“Ɛ xa n fen alogo ɛ niin xa kisi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ nama n fen Betɛli yi,","poem":1},{"lineBreak":true},{"text":"ɛ nama siga Giligali yi,","poem":1},{"lineBreak":true},{"text":"hanma Bɛriseba,","poem":1},{"lineBreak":true},{"text":"bayo Giligali kaan birin sigama nɛn konyiyani,","poem":1},{"lineBreak":true},{"text":"Betɛli fan halagima nɛn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ɛ xa Alatala fen alogo ɛ niin xa kisi.","poem":1},{"lineBreak":true},{"text":"Xa na mi a ra, Yusufu bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"a ɛ ɲanma nɛn alo tɛɛna.","poem":1},{"lineBreak":true},{"text":"Betɛli kaa yo mi na","poem":1},{"lineBreak":true},{"text":"naxan na tɛɛn natuyɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɛ tan bata sariyan maxɛtɛ xɔlɛn na,","poem":1},{"lineBreak":true},{"text":"ɛ bata yo tinxinyaan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"A tan nan Dii Tɛmɛ Solofere sare kurun","poem":1},{"lineBreak":true},{"text":"nun Donso sare kurun yɛbaxi kore xɔnna ma,","poem":1},{"noteId":3},{"lineBreak":true},{"text":"a dimini yalan kuyebaan na,","poem":1},{"lineBreak":true},{"text":"a sogen nagodo kɔɛɛn na,","poem":1},{"lineBreak":true},{"text":"a igen nakeli baani,","poem":1},{"lineBreak":true},{"text":"a na ragodo bɔxɔni tulen na.","poem":1},{"lineBreak":true},{"text":"A tan xili nɛn “Alatala.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"A muxu gbeene halagima nɛn,","poem":1},{"lineBreak":true},{"text":"a e yire makantanxine kala.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛ muxun xɔnnantenyama","poem":1},{"lineBreak":true},{"text":"naxan na ɛ makiti,","poem":1},{"lineBreak":true},{"text":"bayo ɲɔndi falan mi rafan ɛ ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛ sɛnbɛtarene yigbɛtɛnma,","poem":1},{"lineBreak":true},{"text":"ɛ balon nasuxuma e ra mudun na.","poem":1},{"lineBreak":true},{"text":"Ɛ bata banxi faɲine ti gɛmɛne ra,","poem":1},{"lineBreak":true},{"text":"koni ɛ mi fama dɔxɔdeni ne kui.","poem":1},{"lineBreak":true},{"text":"Ɛ bata manpa bili nakɔ faɲine si,","poem":1},{"lineBreak":true},{"text":"koni ɛ mi na dɔlɔ minɲɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amasɔtɔ, n na a kolon ɛ hakɛn nun yulubin gbo.","poem":1},{"lineBreak":true},{"text":"Ɛ tinxin muxune yigbɛtɛnma.","poem":1},{"lineBreak":true},{"text":"Ɛ dimi yi seene rasuxu","poem":1},{"lineBreak":true},{"text":"alogo tɔrɔ muxune nama makiti ɲɔndin na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na na a toxi xaxilimaan dunduma,","poem":1},{"lineBreak":true},{"text":"bayo waxatini ito mi fan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɛ fanna fen,","poem":1},{"lineBreak":true},{"text":"ɛ xɛtɛ fe ɲaxin fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa kisi.","poem":1},{"lineBreak":true},{"text":"Nayi, Alatala, Ala Sɛnbɛn Birin Kanna","poem":1},{"lineBreak":true},{"text":"na luma nɛn ɛ xɔn,","poem":1},{"lineBreak":true},{"text":"alo ɛ a fala kii naxan yi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɛ xa fe ɲaxin naɲaxu.","poem":1},{"lineBreak":true},{"text":"Fe faɲin xa rafan ɛ ma.","poem":1},{"lineBreak":true},{"text":"Ɛ xa kiti tinxinxin sa.","poem":1},{"lineBreak":true},{"text":"Xa ɛ na liga, yanyina nde, Alatala,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛn Birin Kanna diɲama ɛ tan","poem":1},{"lineBreak":true},{"text":"Yusufu bɔnsɔn dɔnxɛn ma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nanara Marigina Alatala,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛn Birin Kanna ito nan falaxi, a naxa,","poem":1},{"lineBreak":true},{"text":"“E wuga xuini tema nɛn taana ngaani,","poem":1},{"lineBreak":true},{"text":"e sunu xuini te kirane birin xɔn.","poem":1},{"lineBreak":true},{"text":"E xɛɛ rawanle xilima nɛn","poem":1},{"lineBreak":true},{"text":"e xa e wuga xuini te,","poem":1},{"lineBreak":true},{"text":"e bɛti baane xilima nɛn,","poem":1},{"lineBreak":true},{"text":"e xa ɲande bɛtine ba.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N na dangu ɛ konni,","poem":1},{"lineBreak":true},{"text":"wuga xuiin tema nɛn ɛ xɛɛne birin ma.”","poem":1},{"lineBreak":true},{"text":"Alatala naxa na kiini.","poem":1}]},{"type":"heading","content":["Gbalon dina muxune xa"]},{"type":"verse","number":18,"content":[{"text":"Gbalon ne xa,","poem":1},{"lineBreak":true},{"text":"naxanye waxi Alatalaa kiti lɔxɔn xa fa.","poem":1},{"lineBreak":true},{"text":"Ɛ wama nanse xɔn ma na lɔxɔni?","poem":1},{"lineBreak":true},{"text":"Na findima dimin nan na ɛ xa,","poem":1},{"lineBreak":true},{"text":"na mi findɛ kɛnɛnna ra ɛ xa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Na luxi nɛn alo muxun","poem":1},{"lineBreak":true},{"text":"naxan a gima yatan yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"a sa kanko xaɲɛ li.","poem":1},{"lineBreak":true},{"text":"A na so banxin kui,","poem":1},{"lineBreak":true},{"text":"a a digan banxini,","poem":1},{"lineBreak":true},{"text":"saɲin yi a xin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatalaa kitin lɔxɔna,","poem":1},{"lineBreak":true},{"text":"dimin xa mi a ra ba?","poem":1},{"lineBreak":true},{"text":"Kɛnɛnna mi a ra ɛ xa na lɔxɔni hali!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"“N bata ɛ sanle raɲaxu,","poem":1},{"lineBreak":true},{"text":"e mi rafan n ma fefe ma.","poem":1},{"lineBreak":true},{"text":"N mi waxi ɛ malanne xɔn feu!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɛ saraxa gan daxi yo,","poem":1},{"lineBreak":true},{"text":"ɛ Ala kise yo,","poem":1},{"lineBreak":true},{"text":"ɛ bɔɲɛ xunbeli saraxa yo,","poem":1},{"lineBreak":true},{"text":"ɛ saraxa turaxi yo,","poem":1},{"lineBreak":true},{"text":"e sese mi rafan n ma.","poem":1},{"lineBreak":true},{"text":"N mi tinma e rasuxɛ hali keden.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɛ bɛti xuiin makuya n na.","poem":1},{"lineBreak":true},{"text":"N mi waxi ɛ konden bɛtin xuiin mɛ feni.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"N wama naxan xɔn,","poem":1},{"lineBreak":true},{"text":"sariya kɛndɛn xa gbo ɛ tagi","poem":1},{"lineBreak":true},{"text":"alo igen naxan baani.","poem":1},{"lineBreak":true},{"text":"Ɛ tinxinyaan xa lu","poem":1},{"lineBreak":true},{"text":"alo xuden naxan mi xɔrima.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ɛ tan Isirayila yamaan to yi na tonbon yireni ɲɛɛ tonge naaninna bun ma,","poem":1},{"lineBreak":true},{"text":"ɛ saraxane ba nɛn n tan xa ba?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ɛ ɛ gbee suxure Sikoti xali nɛn na waxatini ba?","poem":1},{"lineBreak":true},{"text":"Alo ɛ gbee mangana.","poem":1},{"lineBreak":true},{"text":"Hanma ɛ sare ala Kiyun,","poem":1},{"lineBreak":true},{"text":"ɛ naxanye rafalaxi ɛ yɛtɛ xa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nanara, n na ɛ xalima nɛn","poem":1},{"lineBreak":true},{"text":"konyiyani Damasi xanbi ra.”","poem":1},{"lineBreak":true},{"text":"Alatala naxa na kiini.","poem":1},{"lineBreak":true},{"text":"A xili nɛn “Ala Sɛnbɛn Birin Kanna.”","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"5.8Mɛn kaane yi sare kuruneyatɛxi nɛn alo se sawurane, e yi na sare kurune xili sa na seene xun ma.","reference":{"chapter":5,"verse":8}}]},"thisChapterLink":"/api/yal_pbt/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}