{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"AMO","translationId":"yal_pbt","name":"Nabi Amosi Sora","commonName":"Nabi Amosi Sora","title":"Amosi Nabi Amosi Alaa Falan Naxan Sɛbɛ","order":30,"numberOfChapters":9,"sha256":"99f717e85c02856221959666d61bcfc2166a72731e751797e09751a18a8f03a7","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/yal_pbt/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Gbalon nafulu kanne xa"]},{"type":"verse","number":1,"content":[{"text":"Gbalona e xa,","poem":1},{"lineBreak":true},{"text":"naxanye laxi e yɛtɛ ra","poem":1},{"lineBreak":true},{"text":"Siyon nun Samari geyane fari.","poem":1},{"lineBreak":true},{"text":"Ɛ tan muxu gbeene","poem":1},{"lineBreak":true},{"text":"naxanye na siya fisamantenna xun na,","poem":1},{"lineBreak":true},{"text":"Isirayila kaane xaxili tixi ɛ tan nan na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ siga Kalene taan matodeni,","poem":1},{"lineBreak":true},{"text":"hanma Xamata, na taa gbeena.","poem":1},{"lineBreak":true},{"text":"Ɛ mɔn xa godo Filisiti bɔxɔni","poem":1},{"lineBreak":true},{"text":"Gati matodeni.","poem":1},{"lineBreak":true},{"text":"Ne fisa ɛ xa ba?","poem":1},{"lineBreak":true},{"text":"E bɔxɔn gbo ɛ gbeen xa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ a mirixi","poem":1},{"lineBreak":true},{"text":"a ɲaxankata lɔxɔn mi ɛ lima,","poem":1},{"lineBreak":true},{"text":"koni ɛ a ligama nɛn","poem":1},{"lineBreak":true},{"text":"gbalon yi ɛ sɔtɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛ ɛ matabuma sade faɲin ma,","poem":1},{"lineBreak":true},{"text":"ɛ yɛxɛɛn nun ɲinge raturaxin donma,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ɛ sigin sa kondenna ra.","poem":1},{"lineBreak":true},{"text":"Ɛ yengi a ma, a ɛ fatan maxaseene ra","poem":1},{"lineBreak":true},{"text":"alo Nabi Dawuda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ dɔlɔ gbegbe minma,","poem":1},{"lineBreak":true},{"text":"ɛ ture faɲin maso ɛ fatin ma.","poem":1},{"lineBreak":true},{"text":"Koni, ɛ mi kɔntɔfilixi","poem":1},{"lineBreak":true},{"text":"Yusufu bɔnsɔnna kala feen na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nanara, ɛ singe nan sigama konyiyani.","poem":1},{"lineBreak":true},{"text":"Ɛ sumunne danma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Marigina Alatala bata a kɔlɔ a yɛtɛ yi.","poem":1},{"lineBreak":true},{"text":"Alatala, Ala Sɛnbɛn Birin Kanna falan ni ito ra:","poem":1},{"lineBreak":true},{"text":"“Yaxuba bɔnsɔnna wason bata raɲaxu n ma.","poem":1},{"lineBreak":true},{"text":"E yire makantanxine mi rafan n ma.","poem":1},{"lineBreak":true},{"text":"N fama e birin halagideni nɛn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xa muxu fu banxina nde kui,","poem":1},{"lineBreak":true},{"text":"e birin faxama nɛn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E kon kaan na so na banxini,","poem":1},{"lineBreak":true},{"text":"e binbine tongodeni,","poem":1},{"lineBreak":true},{"text":"a xa e gan,","poem":1},{"lineBreak":true},{"text":"a na naxan li banxini","poem":1},{"lineBreak":true},{"text":"a a falama nɛn na xa,","poem":1},{"lineBreak":true},{"text":"“Muxu gbɛtɛ mi be,","poem":1},{"lineBreak":true},{"text":"ba i tan na ba?”","poem":1},{"lineBreak":true},{"text":"A a yabima nɛn, “Ɛn-ɛn.”","poem":1},{"lineBreak":true},{"text":"A mɔn naxa, “I dundu,","poem":1},{"lineBreak":true},{"text":"i nama Alatala xinla fala!”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bayo Alatala bata yamarin fi","poem":1},{"lineBreak":true},{"text":"a banxi gbeene nun banxi xurine,","poem":1},{"lineBreak":true},{"text":"e birin xa rabira, e kala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Soone e giyɛ gɛmɛ yireni ba?","poem":1},{"lineBreak":true},{"text":"Ɲingene mɛnna biyɛ ba?","poem":1},{"lineBreak":true},{"text":"Awa, nanfera ɛ sariyan maxɛtɛma xɔlɛn na,","poem":1},{"lineBreak":true},{"text":"ɛ tinxinyaan maxɛtɛ fe ɲaxin na?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɛ ɲaxanma fe fuune ra.","poem":1},{"lineBreak":true},{"text":"Ɛ naxa, a ɛ fe bata sɔnɔya","poem":1},{"lineBreak":true},{"text":"ɛ yɛtɛɛn sɛnbɛn xɔn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala, Ala Sɛnbɛn Birin Kanna falan ni ito ra:","poem":1},{"lineBreak":true},{"text":"“Nanara, n kelima nɛn ɛ xili ma,","poem":1},{"lineBreak":true},{"text":"Isirayila yamana.","poem":1},{"lineBreak":true},{"text":"Ɛ tan naxanye Lebo-Xamata taani","poem":1},{"lineBreak":true},{"text":"han Araba xudeni,","poem":1},{"lineBreak":true},{"text":"siyana nde fama nɛn ɛ tɔrɔdeni.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}