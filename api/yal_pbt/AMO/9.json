{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"AMO","translationId":"yal_pbt","name":"Nabi Amosi Sora","commonName":"Nabi Amosi Sora","title":"Amosi Nabi Amosi Alaa Falan Naxan Sɛbɛ","order":30,"numberOfChapters":9,"sha256":"99f717e85c02856221959666d61bcfc2166a72731e751797e09751a18a8f03a7","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/yal_pbt/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Nabi Amosi a fe to dɔnxɛna alo xiyena: Halagina"]},{"type":"verse","number":1,"content":[{"text":"N yi fe toona nde ti.","poem":1},{"lineBreak":true},{"text":"Marigin yi a saraxa ganden dɛxɔn.","poem":1},{"lineBreak":true},{"text":"A yi yamarin fi, a naxa,","poem":1},{"lineBreak":true},{"text":"“Sɛnbɛtɛnne konden din,","poem":1},{"lineBreak":true},{"text":"han bɔxɔn yi xuruxurun.","poem":1},{"lineBreak":true},{"text":"Banxin birin xa bira muxune fari.","poem":1},{"lineBreak":true},{"text":"N na e diine halagima nɛn silanfanna ra.","poem":1},{"lineBreak":true},{"text":"Hali muxu keden mi kisima.","poem":1},{"lineBreak":true},{"text":"Muxu keden mi a xunbama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hali e sa e luxun laxira yi,","poem":1},{"lineBreak":true},{"text":"n na e suxuma nɛn.","poem":1},{"lineBreak":true},{"text":"Xa e te kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"n na e ragodoma nɛn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xa e e luxun Karemele geyaan fari,","poem":1},{"lineBreak":true},{"text":"n na e sagatanma nɛn,","poem":1},{"lineBreak":true},{"text":"n na e suxu.","poem":1},{"lineBreak":true},{"text":"Xa e e luxun baan xɔnna ma,","poem":1},{"lineBreak":true},{"text":"n saɲin yamarima nɛn,","poem":1},{"lineBreak":true},{"text":"a xa e xin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xa e yaxune e xali konyiyani,","poem":1},{"lineBreak":true},{"text":"n yamarin fima nɛn,","poem":1},{"lineBreak":true},{"text":"e xa faxa silanfanna ra.","poem":1},{"lineBreak":true},{"text":"N na n yɛɛn tima e ra nɛn,","poem":1},{"lineBreak":true},{"text":"koni e munanfanna mi a ra,","poem":1},{"lineBreak":true},{"text":"n na e ɲaxankatama nɛn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Marigina Alatala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"a tan nan a yiin din bɔxɔn na, a xuya ayi.","poem":1},{"lineBreak":true},{"text":"Muxun birin yi sunu.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn xuruxurunma nɛn,","poem":1},{"lineBreak":true},{"text":"a te, a mɔn yi godo","poem":1},{"lineBreak":true},{"text":"alo Nila Misiran xudena.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A bata a dɔxɔden ti kore xɔnna ma.","poem":1},{"lineBreak":true},{"text":"A bata kore walaxan sa bɔxɔn xun ma.","poem":1},{"lineBreak":true},{"text":"A igen nakelima baani,","poem":1},{"lineBreak":true},{"text":"a na ragodo bɔxɔni tulen na.","poem":1},{"lineBreak":true},{"text":"A xili nɛn “Alatala.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatalaa falan ni ito ra:","poem":1},{"lineBreak":true},{"text":"“Isirayila kaane,","poem":1},{"lineBreak":true},{"text":"ɛ nun Kusi kaane keden mi a ra n tan xa ba?","poem":1},{"lineBreak":true},{"text":"N mi ɛ ramini Misiran bɔxɔn ma,","poem":1},{"lineBreak":true},{"text":"alo n Filisitine ramini Kafatoro kii naxan yi?","poem":1},{"lineBreak":true},{"text":"N mi ɛ ramini Misiran bɔxɔn ma,","poem":1},{"lineBreak":true},{"text":"alo n Arami kaane ramini Kiri kii naxan yi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A mato:","poem":1},{"lineBreak":true},{"text":"Marigina Alatala bata yulubi kanne mangayaan to,","poem":1},{"lineBreak":true},{"text":"n fama na raxɔrideni nɛn bɔxɔni ito ma.","poem":1},{"lineBreak":true},{"text":"Koni n mi Yaxuba yamaan birin halagima.”","poem":1},{"lineBreak":true},{"text":"Alatalaa falan nan na ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"A naxa, “N yamarin fima nɛn","poem":1},{"lineBreak":true},{"text":"alogo Isirayila yamaan xa yimaxa.","poem":1},{"lineBreak":true},{"text":"N na a yifema nɛn","poem":1},{"lineBreak":true},{"text":"alo maali fema kii naxan yi,","poem":1},{"lineBreak":true},{"text":"alogo xɔri faɲin keden nama bira.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni yulubi kanna naxanye n ma yamaan tagi,","poem":1},{"lineBreak":true},{"text":"n na e faxama nɛn silanfanna ra,","poem":1},{"lineBreak":true},{"text":"e tan naxanye a falama,","poem":1},{"lineBreak":true},{"text":"‘A mi fama nxu ɲaxankatadeni,","poem":1},{"lineBreak":true},{"text":"na mi nɔɛ nxu liyɛ.’ ”","poem":1}]},{"type":"heading","content":["Isirayilaa kisi fena"]},{"type":"verse","number":11,"content":[{"text":"“Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"n Dawudaa mangaya kalaxini tɔnma nɛn.","poem":1},{"lineBreak":true},{"text":"N na rafalama nɛn,","poem":1},{"lineBreak":true},{"text":"n na nɛnɛni tɔnma nɛn","poem":1},{"lineBreak":true},{"text":"alo a yi kiinde,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"alogo e mɔn xa Edɔn bɔxɔn sɔtɔ,","poem":1},{"lineBreak":true},{"text":"e nun siyane birin","poem":1},{"lineBreak":true},{"text":"naxanye n xinla batuma.”","poem":1},{"lineBreak":true},{"text":"Alatalaa falan nan na ra,","poem":1},{"lineBreak":true},{"text":"a fama na birin nakamalideni nɛn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatalaa falan ni ito ra, a naxa:","poem":1},{"lineBreak":true},{"text":"“A mato:","poem":1},{"lineBreak":true},{"text":"Lɔxɔne fama,","poem":1},{"lineBreak":true},{"text":"xɛɛ biine nun se xabane","poem":1},{"lineBreak":true},{"text":"walima waxati kedenna nin.","poem":1},{"lineBreak":true},{"text":"Manpa rafalane nun xɛɛ biine,","poem":1},{"lineBreak":true},{"text":"ne fan walima nɛn waxati kedenni.","poem":1},{"lineBreak":true},{"text":"Manpaan gboma ayi nɛn geyane fari,","poem":1},{"lineBreak":true},{"text":"a yi lu alo geyane birin yikunxi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N na n ma yamaan naxɛtɛma nɛn a konni","poem":1},{"lineBreak":true},{"text":"keli konyiyani, Isirayila kaane.","poem":1},{"lineBreak":true},{"text":"E fama nɛn taa kalaxine tideni,","poem":1},{"lineBreak":true},{"text":"e dɔxɔma dɛnaxanye yi.","poem":1},{"lineBreak":true},{"text":"E manpa bili nakɔne sima nɛn,","poem":1},{"lineBreak":true},{"text":"e na minseen min.","poem":1},{"lineBreak":true},{"text":"E nakɔɔn sama nɛn,","poem":1},{"lineBreak":true},{"text":"e na bogin don.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N na Isirayila rasabatima nɛn e gbee bɔxɔni.","poem":1},{"lineBreak":true},{"text":"E mi kelɛ na sɔnɔn,","poem":1},{"lineBreak":true},{"text":"n dɛnaxan fixi e ma.”","poem":1},{"lineBreak":true},{"text":"Alatala naxa na kiini, ɛ Ala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}