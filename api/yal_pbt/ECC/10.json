{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ECC","translationId":"yal_pbt","name":"Karamɔxɔn Sora","commonName":"Karamɔxɔn Sora","title":"Karamɔxɔna Mangana Fe Kolon Falane","order":21,"numberOfChapters":12,"sha256":"35eceec6ff4f879efceff513cb0723c7679ffc20eccc07e297d6f3f956ff68be","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/yal_pbt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"heading","content":["Xaxilitareyaan bɔnɔna"]},{"type":"verse","number":1,"content":[{"text":"Tugetugene faxaxin nɔɛ latikɔnɔnna xiri ɲaxuɛ nɛn.","poem":1},{"lineBreak":true},{"text":"Na kiini xaxilitareyana ndedi nɔɛ fekolonna nun binyen kalɛ nɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fekolonna xaxinla sigan kira faɲin nan xɔn,","poem":1},{"lineBreak":true},{"text":"koni xaxilitaren xaxinla sigan kira ɲaxin nan xɔn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xaxilitaren nɛma sigan tima kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"xaxili mi a ma.","poem":1},{"lineBreak":true},{"text":"Birin a xaxilitareyaan toma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xa kuntigin xɔlɔ i xili ma,","poem":1},{"lineBreak":true},{"text":"i nama keli i ya walideni,","poem":1},{"lineBreak":true},{"text":"bayo maraxaran yulubi gbeen nan matangama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N fe ɲaxina ndee toxi dunuɲa yi,","poem":1},{"lineBreak":true},{"text":"tantanna naxanye fata mangan na:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fekolontarene tide gbeene sɔtɔma,","poem":1},{"lineBreak":true},{"text":"sɛnbɛ kanne yi lu tide xurine yi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bata konyine to soone fari,","poem":1},{"lineBreak":true},{"text":"mangane yi sigan ti e sanni alo konyine.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naxan na yinla ge,","poem":1},{"lineBreak":true},{"text":"a birama nɛn na ra.","poem":1},{"lineBreak":true},{"text":"Naxan na yinna rabira,","poem":1},{"lineBreak":true},{"text":"saɲin nan na xinma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naxan na gɛmɛne maxɛtɛ,","poem":1},{"lineBreak":true},{"text":"na a maxɔlɔma nɛn e ra,","poem":1},{"lineBreak":true},{"text":"naxan wudin bɔma,","poem":1},{"lineBreak":true},{"text":"na nɔɛ a maxɔlɛ nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xa bunbi mɛlɛnna dɛ mi a yi,","poem":1},{"lineBreak":true},{"text":"a mi raxanxanxi,","poem":1},{"lineBreak":true},{"text":"fɔ i xa i sɛnbɛn xun masa nɛn,","poem":1},{"lineBreak":true},{"text":"koni fekolonna feen nɔɛ dangu na ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Naxan fatan saɲin suxɛ,","poem":1},{"lineBreak":true},{"text":"na tɔnɔn nanse ra","poem":1},{"lineBreak":true},{"text":"xa saɲina a xin","poem":1},{"lineBreak":true},{"text":"benun a xa a suxu?","poem":1}]},{"type":"heading","content":["Xaxilimayaan nun daxuyana"]},{"type":"verse","number":12,"content":[{"text":"Fekolonna falane rafexi hinanna nan na,","poem":1},{"lineBreak":true},{"text":"koni xaxilitarena falane bɔnɔn nan tima a ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A falane fɔlɔn xaxilitareyaan nan ma,","poem":1},{"lineBreak":true},{"text":"a raɲan daxuya ɲaxin ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xaxilitaren falane rawuyama ayi nɛn.","poem":1},{"lineBreak":true},{"text":"Adamadiin mi a kolon","poem":1},{"lineBreak":true},{"text":"naxan fama ligadeni.","poem":1},{"lineBreak":true},{"text":"Nde a falɛ a xa","poem":1},{"lineBreak":true},{"text":"naxan fa ligama a xanbi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xaxilitarena wanla a xadanma nɛn,","poem":1},{"lineBreak":true},{"text":"bayo a yɛtɛɛn mi a kolon","poem":1},{"lineBreak":true},{"text":"a sigɛ taani kii naxan yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yamanan naxan manga findixi foningen na,","poem":1},{"lineBreak":true},{"text":"gbalon na xa,","poem":1},{"lineBreak":true},{"text":"e nun naxan ma kuntigiye e waxatin birin nadanguma donse dondeni.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sɛwan na yamaan xa","poem":1},{"lineBreak":true},{"text":"naxan manga findixi muxu binyene diin na,","poem":1},{"lineBreak":true},{"text":"naxan ma kuntigiye e dɛgema a waxatini,","poem":1},{"lineBreak":true},{"text":"e makoon naxan ma,","poem":1},{"lineBreak":true},{"text":"e mɔn mi manpaan minna radangu ayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Muxu narixina xalanben fɔnma nɛn.","poem":1},{"lineBreak":true},{"text":"Xa a mi walɛ, tulen soma nɛn a banxini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Muxune sɛwa bande donna tima ɲaxaɲaxani,","poem":1},{"lineBreak":true},{"text":"manpaan yi e niini fan e ma.","poem":1},{"lineBreak":true},{"text":"Gbetin nan feen birin yabin na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I nama mangan danga,","poem":1},{"lineBreak":true},{"text":"hali i miriyani,","poem":1},{"lineBreak":true},{"text":"i nama nafulu kanna danga i ya banxin kui,","poem":1},{"lineBreak":true},{"text":"bayo a luyɛ nɛn","poem":1},{"lineBreak":true},{"text":"alo xɔliin nan sa i xuiin naligama a xa,","poem":1},{"lineBreak":true},{"text":"a yi i ya falane yɛba a xa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}