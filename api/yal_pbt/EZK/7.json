{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"EZK","translationId":"yal_pbt","name":"Nabi Esekiyɛli Sora","commonName":"Nabi Esekiyɛli Sora","title":"Esekiyɛli Nabi Esekiyɛli Alaa Falan Naxan Sɛbɛ","order":26,"numberOfChapters":48,"sha256":"20b1b32bfe13d51781ee36241b132fb5696421e02ff41b44762fe3a879b5f03b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/yal_pbt/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["Gbalo famatɔna fe"]},{"type":"verse","number":1,"content":["Alatala falani ito nan ti n xa, a naxa,"]},{"type":"verse","number":2,"content":["“Adamadina, Marigina Alatala ito nan falaxi Isirayila kaane xili ma, a naxa,",{"text":"‘A danna nan fa ito ra!","poem":1},{"lineBreak":true},{"text":"A danna bata a li yamanan tongon naaninne birin yi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Awa iki, a danna bata a li ɛ ma.","poem":1},{"lineBreak":true},{"text":"N na n ma xɔlɔn nafama nɛn ɛ ma.","poem":1},{"lineBreak":true},{"text":"N na ɛ makitima nɛn lan ɛ sigati kiin ma,","poem":1},{"lineBreak":true},{"text":"n yi ɛ saran ɛ kɛwali xɔsixine ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N mi kininkininma ɛ ma,","poem":1},{"lineBreak":true},{"text":"n mi ɛ ratangama,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n na ɛ sigati kiin nun ɛ kɛwali xɔsixine saranma nɛn ɛ ra.","poem":1},{"lineBreak":true},{"text":"Nayi, ɛ a kolonma nɛn a Alatala nan n na.’","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Marigina Alatala ito nan falaxi, a naxa,","poem":1},{"lineBreak":true},{"text":"‘Gbalon fama,","poem":1},{"lineBreak":true},{"text":"gbalon naxan ɲɔxɔn mi na!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Feene danna nan na ra!","poem":1},{"lineBreak":true},{"text":"A danna bata a li!","poem":1},{"lineBreak":true},{"text":"A kelima nɛn ɛ xili ma! A fama!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɛ tan yamanan muxune,","poem":1},{"lineBreak":true},{"text":"ɛ waxatin bata a li!","poem":1},{"lineBreak":true},{"text":"Waxati saxin bata a li ɛ ma,","poem":1},{"lineBreak":true},{"text":"a lɔxɔn bata maso!","poem":1},{"lineBreak":true},{"text":"Kɔntɔfinla na a ra!","poem":1},{"lineBreak":true},{"text":"Sɛwa xui mi fa tema geyane fari sɔnɔn!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iki, n mi fa buma,","poem":1},{"lineBreak":true},{"text":"n na n ma xɔlɔn nagodo ɛ ma,","poem":1},{"lineBreak":true},{"text":"n ma bɔɲɛteen sigama nɛn","poem":1},{"lineBreak":true},{"text":"han a danna ɛ xili ma.","poem":1},{"lineBreak":true},{"text":"N na ɛ makitima nɛn","poem":1},{"lineBreak":true},{"text":"lan ɛ sigati kiin ma,","poem":1},{"lineBreak":true},{"text":"n yi ɛ saran ɛ kɛwali xɔsixine ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N mi kininkininma ɛ ma,","poem":1},{"lineBreak":true},{"text":"n mi ɛ ratangama,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n na ɛ sigati kiin nun ɛ kɛwali xɔsixine saranma nɛn ɛ ra.","poem":1},{"lineBreak":true},{"text":"Nayi, ɛ a kolonma nɛn","poem":1},{"lineBreak":true},{"text":"a n tan Alatala,","poem":1},{"lineBreak":true},{"text":"n tan nan ɛ ɲaxankatama.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lɔxɔn bata a li,","poem":1},{"lineBreak":true},{"text":"a bata a li!","poem":1},{"lineBreak":true},{"text":"Ɛ waxatin bata a li!","poem":1},{"lineBreak":true},{"text":"Bɔnbɔ ti dunganna bata a maɲingi!","poem":1},{"lineBreak":true},{"text":"Wason bata sabati ayi!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbalon bata keli,","poem":1},{"lineBreak":true},{"text":"a findi muxu ɲaxine ɲaxankata dunganna ra.","poem":1},{"lineBreak":true},{"text":"E sese mi fa luma,","poem":1},{"lineBreak":true},{"text":"e nafulu mi luma,","poem":1},{"lineBreak":true},{"text":"e mi fa wuyama ayi,","poem":1},{"lineBreak":true},{"text":"e nɔrɔ mi fa luma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waxatin bata a li,","poem":1},{"lineBreak":true},{"text":"lɔxɔn bata maso!","poem":1},{"lineBreak":true},{"text":"Sare soon nama fa sɛwa,","poem":1},{"lineBreak":true},{"text":"sare matiin nama fa sunu,","poem":1},{"lineBreak":true},{"text":"bayo xɔlɔ gbeen fama yamaan birin xili ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sare matiin naxan matixi,","poem":1},{"lineBreak":true},{"text":"a mi na sɔtɔma","poem":1},{"lineBreak":true},{"text":"hali a mɔn lu a nii ra,","poem":1},{"lineBreak":true},{"text":"bayo fe toon naxan tixi lan yamaan ma","poem":1},{"lineBreak":true},{"text":"alo xiyena, na mi kalama,","poem":1},{"lineBreak":true},{"text":"muxu yo mi a niin natangɛ","poem":1},{"lineBreak":true},{"text":"masɔtɔ e hakɛne xɔn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xɔtaan fema nɛn,","poem":1},{"lineBreak":true},{"text":"feen birin yi yitɔn,","poem":1},{"lineBreak":true},{"text":"koni muxu yo mi sigama yɛngɛni","poem":1},{"lineBreak":true},{"text":"bayo n ma xɔlɔn bata godo yamaan birin xili ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yɛngɛn taan nabilinma nɛn,","poem":1},{"lineBreak":true},{"text":"fitina furen nun fitina kamɛn yi so a yi!","poem":1},{"lineBreak":true},{"text":"Naxanye burunna ra,","poem":1},{"lineBreak":true},{"text":"ne yi faxa silanfanna ra.","poem":1},{"lineBreak":true},{"text":"Naxanye taani,","poem":1},{"lineBreak":true},{"text":"fitina kamɛn nun fitina furen yi ne halagi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naxanye na e futuxulu,","poem":1},{"lineBreak":true},{"text":"ne sa e luxunma nɛn geyane fari,","poem":1},{"lineBreak":true},{"text":"e lu kutunɲɛ e yɛtɛ hakɛne fe ra","poem":1},{"lineBreak":true},{"text":"alo ganban naxanye lanbanni.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"E birin fangan ɲanma nɛn,","poem":1},{"lineBreak":true},{"text":"e birin xinbi xudine yi tu ayi,","poem":1},{"lineBreak":true},{"text":"e lu alo igena.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E e maxidima nɛn kasa bɛnbɛli dugine yi sununi,","poem":1},{"lineBreak":true},{"text":"kuisanna yi e birin suxu,","poem":1},{"lineBreak":true},{"text":"e yagi han,","poem":1},{"lineBreak":true},{"text":"e birin yi e xunne bi sununi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E e wure gbetine wolima ayi nɛn kirane xɔn,","poem":1},{"lineBreak":true},{"text":"e yi e mɛ e xɛmane ra","poem":1},{"lineBreak":true},{"text":"alo se haramuxina.","poem":1},{"lineBreak":true},{"text":"Bayo e gbetine nun e xɛmane mi nɔɛ e xunbɛ Alatalaa xɔlɔn lɔxɔni.","poem":1},{"lineBreak":true},{"text":"Ne mi fa e wasɛ,","poem":1},{"lineBreak":true},{"text":"e mi e ralugɛ,","poem":1},{"lineBreak":true},{"text":"bayo ne nan e biraxi hakɛni.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"E bata waso ayi e nafunle xɔn","poem":1},{"lineBreak":true},{"text":"e yi suxure xɔsixi haramuxine rafala e ra.","poem":1},{"lineBreak":true},{"text":"Nanara, n tan Ala ne findima nɛn se xɔsine ra e xa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N na e birin findima nɛn yɛngɛ se tongoxine ra xɔɲɛne xa,","poem":1},{"lineBreak":true},{"text":"fuyantenne yi e ba e yii yɛngɛni,","poem":1},{"lineBreak":true},{"text":"e yi na raxɔsi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N na n xun xanbi soma nɛn e yi,","poem":1},{"lineBreak":true},{"text":"muxune yi n ma yire kɛndɛna sariɲanna kala,","poem":1},{"lineBreak":true},{"text":"mafu tiine yi so a kui,","poem":1},{"lineBreak":true},{"text":"e yi a sariɲanna kala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yɔlɔnxɔnne rafala,","poem":1},{"lineBreak":true},{"text":"bayo faxan bata wara ayi yamanani,","poem":1},{"lineBreak":true},{"text":"gbalon yi gbo ayi taani.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Siyaan naxanye ɲaxu e birin xa,","poem":1},{"lineBreak":true},{"text":"n ne rafama nɛn,","poem":1},{"lineBreak":true},{"text":"e yi e banxine tongo e yii.","poem":1},{"lineBreak":true},{"text":"N sɛnbɛmane wason ɲanma nɛn,","poem":1},{"lineBreak":true},{"text":"e yire sariɲanxine sariɲanna yi kala.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kuisan waxatine na fa,","poem":1},{"lineBreak":true},{"text":"e bɔɲɛ xunbenla fenma nɛn,","poem":1},{"lineBreak":true},{"text":"koni e mi a toɛ!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbalon sama nɛn gbalon fari,","poem":1},{"lineBreak":true},{"text":"xibaru ɲaxine yi sa xibaru ɲaxine fari.","poem":1},{"lineBreak":true},{"text":"E fe toon maxɔdinma nɛn nabine ma fata Ala ra,","poem":1},{"lineBreak":true},{"text":"koni saraxaraline bama nɛn muxune xaranɲɛ sariyan ma,","poem":1},{"lineBreak":true},{"text":"fonne fan yi ba maxadin tiyɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mangan sunuma nɛn,","poem":1},{"lineBreak":true},{"text":"manga diin yi yigitɛgɛ,","poem":1},{"lineBreak":true},{"text":"yamanan muxune birin yiine yi xuruxurun gaxuni.","poem":1},{"lineBreak":true},{"text":"N na e sigati kiin saranma nɛn e ra,","poem":1},{"lineBreak":true},{"text":"n yi e kiti e kiti saxine xɔn,","poem":1},{"lineBreak":true},{"text":"e yi a kolon a Alatala nan n na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}