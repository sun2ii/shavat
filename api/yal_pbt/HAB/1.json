{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HAB","translationId":"yal_pbt","name":"Nabi Xabakuki Sora","commonName":"Nabi Xabakuki Sora","title":"Xabakuki Nabi Xabakuki Alaa Falan Naxan Sɛbɛ","order":35,"numberOfChapters":3,"sha256":"41b9ffead3615d111fde3a17c8c5e6b67a5d7e50017f97e15f8f70b4d74d3ce3","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/yal_pbt/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Waliyiya falan naxan so Nabi Xabakuki yii fe tooni alo xiyena:"]},{"type":"heading","content":["Nabi Xabakuki a mawuga singena"]},{"type":"verse","number":2,"content":[{"text":"Alatala, n luma i maxandɛ","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi n mali feen na","poem":1},{"lineBreak":true},{"text":"i mi n xuiin mɛ?","poem":1},{"lineBreak":true},{"text":"N luma gbelegbelɛ","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi","poem":1},{"lineBreak":true},{"text":"n naxa, “Gbalona!”","poem":1},{"lineBreak":true},{"text":"i mi n nakisi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanfera i tinxi","poem":1},{"lineBreak":true},{"text":"n yɛɛn yi lu hakɛn na?","poem":1},{"lineBreak":true},{"text":"Nanfera i tinxi","poem":1},{"lineBreak":true},{"text":"a yamaan xa ɲaxankata?","poem":1},{"lineBreak":true},{"text":"Halagin nun gbalona n yɛtagi waxatin birin.","poem":1},{"lineBreak":true},{"text":"Lantareyaan nun yɛngɛn bata gbo ayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nanara, sɛnbɛ mi fa sariyan na,","poem":1},{"lineBreak":true},{"text":"kiti kɛndɛn mi sama mumɛ!","poem":1},{"lineBreak":true},{"text":"Bayo muxu ɲaxine bata tinxin muxune rabilin,","poem":1},{"lineBreak":true},{"text":"kiti tinxintarene yi lu sɛ.","poem":1}]},{"type":"line_break"},{"type":"heading","content":["Ala yi Nabi Xabakuki yabi"]},{"type":"verse","number":5,"content":[{"text":"Ɛ yɛɛn ti siyane ra,","poem":1},{"lineBreak":true},{"text":"ɛ e mato, ɛ yi kabɛ,","poem":1},{"lineBreak":true},{"text":"ɛ yigitɛgɛ.","poem":1},{"lineBreak":true},{"text":"Bayo n fena nde ligama nɛn ɛ waxatini ito yi","poem":1},{"lineBreak":true},{"text":"ɛ mi yi lɛ naxan na,","poem":1},{"lineBreak":true},{"text":"hali xa a fala ɛ xa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bayo n Babilɔn kaane rakelima nɛn,","poem":1},{"lineBreak":true},{"text":"siya kininkinintare wɛkilɛxina,","poem":1},{"lineBreak":true},{"text":"e yi bɔxɔn birin yisiga","poem":1},{"lineBreak":true},{"text":"e yi yirene tongo","poem":1},{"lineBreak":true},{"text":"e gbee mi naxanye ra.","poem":1},{"noteId":0}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E magaxu, e sɛnbɛn gbo,","poem":1},{"lineBreak":true},{"text":"e fangan nan e sariyan nun e xunna kenla ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E soone xulun burunna ɲarin xa,","poem":1},{"lineBreak":true},{"text":"e xaɲɛ ɲinbari ra kankone xa.","poem":1},{"lineBreak":true},{"text":"E soo ragine gixin fama nɛn tuganɲɛ","poem":1},{"lineBreak":true},{"text":"sa keli yire makuyeni.","poem":1},{"lineBreak":true},{"text":"E gima alo singbinna nɛɛn fɔnɲɛ seen ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E birin fama gbalon nan xili ma.","poem":1},{"lineBreak":true},{"text":"E ganle yɛɛn tixi e sigaden nan na,","poem":1},{"lineBreak":true},{"text":"e suxu muxune malan","poem":1},{"lineBreak":true},{"text":"alo ɲɛmɛnsinna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E mangane magelema,","poem":1},{"lineBreak":true},{"text":"e gelema kuntigine ma.","poem":1},{"lineBreak":true},{"text":"E gelema yire makantanxine birin ma","poem":1},{"lineBreak":true},{"text":"e gbingbinne nan nafalama taan yinna xɔn","poem":1},{"lineBreak":true},{"text":"e dangu yinna xun ma,","poem":1},{"lineBreak":true},{"text":"e taan suxu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E yi dangu alo foye kala tiina,","poem":1},{"lineBreak":true},{"text":"e birin hakɛ kan,","poem":1},{"lineBreak":true},{"text":"e fangan nan e gbee ala ra.","poem":1}]},{"type":"heading","content":["Xabakuki a mawuga firindena"]},{"type":"verse","number":12,"content":[{"text":"Koni Alatala xa mi i tan na xabu a fɔlɔni ba,","poem":1},{"lineBreak":true},{"text":"n ma Ala sariɲanxina?","poem":1},{"lineBreak":true},{"text":"Nayi, e mi nxu faxama!","poem":1},{"lineBreak":true},{"text":"Alatala, i bata e findi nxu makiti muxune ra.","poem":1},{"lineBreak":true},{"text":"Ala, n kantan fanyena,","poem":1},{"lineBreak":true},{"text":"i bata e sɛnbɛ so","poem":1},{"lineBreak":true},{"text":"alogo e xa nxɔ wanle saran nxu ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I yɛɛne sariɲan fe ɲaxin toon ma.","poem":1},{"lineBreak":true},{"text":"I mi tinɲɛ yamana ɲaxankatan matoɛ.","poem":1},{"lineBreak":true},{"text":"Nanfera nayi,","poem":1},{"lineBreak":true},{"text":"i yɛɛn tixi yanfantenni itoe ra?","poem":1},{"lineBreak":true},{"text":"Nanfera i dunduxi","poem":1},{"lineBreak":true},{"text":"muxu ɲaxini itoe yi yamaan naxɔri","poem":1},{"lineBreak":true},{"text":"naxanye tinxin e xa?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I bata adamadiine liga","poem":1},{"lineBreak":true},{"text":"alo yɛxɛne baani,","poem":1},{"lineBreak":true},{"text":"alo kari mi niimaseen naxanye ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yaxune e birin suxuma kɔnna ra,","poem":1},{"lineBreak":true},{"text":"e yi e rate e yalaan na,","poem":1},{"lineBreak":true},{"text":"e e malan e bɛnbɛnla kui,","poem":1},{"lineBreak":true},{"text":"e ɲaxan han!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nayi, e yi saraxane ba e yalane xa","poem":1},{"lineBreak":true},{"text":"e yi wusulanna gan e bɛnbɛnle xa,","poem":1},{"lineBreak":true},{"text":"bayo ne nan a ligama","poem":1},{"lineBreak":true},{"text":"e balon yi gbo ayi,","poem":1},{"lineBreak":true},{"text":"e donse ɲaxumɛne sɔtɔ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nayi, a mɔn xa lu a yalani kunkunɲɛ nɛn ba,","poem":1},{"lineBreak":true},{"text":"a mɔn yi siga siyane halagɛ kininkinintareyani ba?","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.6 Babilɔnkaane sɛnbɛn gbo nɛn ayi ɲɛɛ kɛmɛ sennin benun Marigi Yesu xa bari. E mangan yi na rabilinna bɔxɔne birin tongo yɛngɛni na waxatini.","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/yal_pbt/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}