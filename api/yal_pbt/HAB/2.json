{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HAB","translationId":"yal_pbt","name":"Nabi Xabakuki Sora","commonName":"Nabi Xabakuki Sora","title":"Xabakuki Nabi Xabakuki Alaa Falan Naxan Sɛbɛ","order":35,"numberOfChapters":3,"sha256":"41b9ffead3615d111fde3a17c8c5e6b67a5d7e50017f97e15f8f70b4d74d3ce3","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/yal_pbt/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"N tan luma nɛn tixi kantan tideni,","poem":1},{"lineBreak":true},{"text":"n yi lu taan nabilinna yinna xuntagi","poem":1},{"lineBreak":true},{"text":"alogo n xa a kolon","poem":1},{"lineBreak":true},{"text":"Ala naxan falama n xa,","poem":1},{"lineBreak":true},{"text":"mawuga xuini ito yabima kii naxan yi.","poem":1}]},{"type":"heading","content":["Ala mɔn yi Nabi Xabakuki yabi"]},{"type":"verse","number":2,"content":[{"text":"Alatala yi n yabi, a naxa,","poem":1},{"lineBreak":true},{"text":"“Fe tooni ito sɛbɛ","poem":1},{"lineBreak":true},{"text":"n naxan yitama i ra,","poem":1},{"lineBreak":true},{"text":"i yi a sɛbɛ walaxane ma ki faɲi","poem":1},{"lineBreak":true},{"text":"alogo muxune xa mafura a xarandeni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bayo fe makɛnɛnxin na a ra","poem":1},{"lineBreak":true},{"text":"naxan nakamalima a waxatini.","poem":1},{"lineBreak":true},{"text":"A fa a waxatin nan legedenma,","poem":1},{"lineBreak":true},{"text":"a mi luma a ligataren na.","poem":1},{"lineBreak":true},{"text":"Hali a bu, a mamɛ,","poem":1},{"lineBreak":true},{"text":"bayo a rakamalima nɛn yati.","poem":1},{"lineBreak":true},{"text":"A mi xunkuyama ayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mato! A yɛtɛ yigboxi,","poem":1},{"lineBreak":true},{"text":"a niin mi fan.","poem":1},{"lineBreak":true},{"text":"Koni tinxin muxun nii rakisin sɔtɔma nɛn","poem":1},{"lineBreak":true},{"text":"a dɛnkɛlɛyaan xɔn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Dɔlɔn mayanfan nan tima.","poem":1},{"lineBreak":true},{"text":"Wasoden mi a raxarɛ mumɛ!","poem":1},{"lineBreak":true},{"text":"A mi wasama alo laxira,","poem":1},{"lineBreak":true},{"text":"alo sayaan to mi wasama.","poem":1},{"lineBreak":true},{"text":"A siyane birin malanma a yɛtɛ xa","poem":1},{"lineBreak":true},{"text":"a e birin suxu yɛngɛni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na muxune birin xa mi a mafalama ba","poem":1},{"lineBreak":true},{"text":"magele falane nun fala xɔlɛne ra?","poem":1},{"lineBreak":true},{"text":"E naxa, ‘Gbalon na kanna xa","poem":1},{"lineBreak":true},{"text":"naxan se muɲaxine malanma.","poem":1},{"lineBreak":true},{"text":"A yi a doli goronna fari sa!","poem":1},{"lineBreak":true},{"text":"Ito fa ligama","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I doli faane mi kelɛ i xili ma ba?","poem":1},{"lineBreak":true},{"text":"Ne mi xulunɲɛ ba,","poem":1},{"lineBreak":true},{"text":"e fa i yimaxa?","poem":1},{"lineBreak":true},{"text":"I fan findima nɛn e se suxin na!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bayo i bata siya wuyaxine yii seene tongo yɛngɛni,","poem":1},{"lineBreak":true},{"text":"yama dɔnxɛne i fan yii seene tongoma nɛn yɛngɛni.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i bata muxune faxa,","poem":1},{"lineBreak":true},{"text":"i yi yamanane nun taane nun e muxune birin halagi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Gbalon na kanna xa,","poem":1},{"lineBreak":true},{"text":"naxan tɔnɔn fenma tinxintareyani","poem":1},{"lineBreak":true},{"text":"alogo a xa tide gbeen sɔtɔ,","poem":1},{"lineBreak":true},{"text":"a yi a futuxulu tɔrɔn na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I bata i ya denbayaan yagi feen nan nata na ra,","poem":1},{"lineBreak":true},{"text":"i yi yama wuyaxi halagi,","poem":1},{"lineBreak":true},{"text":"i bɔnɔ i niini.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bayo hali i banxin tixi gɛmɛn naxanye ra,","poem":1},{"lineBreak":true},{"text":"ne gbelegbelema nɛn i xili xunna,","poem":1},{"lineBreak":true},{"text":"xalanbene fan yi a ratin.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Gbalon na kanna xa,","poem":1},{"lineBreak":true},{"text":"naxan taan nasabatima muxun wunla xɔn","poem":1},{"lineBreak":true},{"text":"naxan taan bɛtɛn sama ɲaxankatan xɔn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna xa mi a ragidixi ba,","poem":1},{"lineBreak":true},{"text":"a yamane wali xɔnne findixi yegen nan tun na tɛɛn xa,","poem":1},{"lineBreak":true},{"text":"a siyane e yɛtɛ yixadanma fuyan?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amasɔtɔ bɔxɔ xɔnna rafema nɛn","poem":1},{"lineBreak":true},{"text":"Alatalaa binyen kolonna ra","poem":1},{"lineBreak":true},{"text":"alo igen baane rafexi kii naxan yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Gbalon na kanna xa,","poem":1},{"lineBreak":true},{"text":"naxan dɔlɔn fima a adamadi bodene ma","poem":1},{"lineBreak":true},{"text":"han e xunne yi keli,","poem":1},{"lineBreak":true},{"text":"a yi e ragenla to.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I tan lugoxi yagin nan tun na,","poem":1},{"lineBreak":true},{"text":"binyen mi a ra.","poem":1},{"lineBreak":true},{"text":"I fan xa i min,","poem":1},{"lineBreak":true},{"text":"i xunna yi keli,","poem":1},{"lineBreak":true},{"text":"i ragenla yi lu.","poem":1},{"lineBreak":true},{"text":"Alatala a yiifari ma igelengen xɔlɛn soma nɛn i yii","poem":1},{"lineBreak":true},{"text":"i ya binyen yi findi yagin na!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bayo i gbalon naxan nabaxi Liban yamanani,","poem":1},{"lineBreak":true},{"text":"na xɛtɛma nɛn i ma.","poem":1},{"lineBreak":true},{"text":"I bata xuruseen naxanye halagi,","poem":1},{"lineBreak":true},{"text":"na feen findima gaxun nan na i ma.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i bata muxune faxa,","poem":1},{"lineBreak":true},{"text":"i yamanane nun taane nun e muxune birin halagi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Suxurene tɔnɔn nanse ra","poem":1},{"lineBreak":true},{"text":"naxan a ligɛ muxune xa e yitɔn?","poem":1},{"lineBreak":true},{"text":"Sawuran nan tun ne ra","poem":1},{"lineBreak":true},{"text":"naxanye rafalaxi wuren naxulunxin na.","poem":1},{"lineBreak":true},{"text":"E wulen nan falama muxune xa","poem":1},{"lineBreak":true},{"text":"alogo e rafala muxun xa e yigi sa e yi.","poem":1},{"lineBreak":true},{"text":"E ala bobone nan nafalama.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbalon na kanna xa,","poem":1},{"lineBreak":true},{"text":"naxan a falama wudin xa,","poem":1},{"lineBreak":true},{"text":"a naxa, ‘Keli!’","poem":1},{"lineBreak":true},{"text":"A yi a fala gɛmɛn xa,","poem":1},{"lineBreak":true},{"text":"a naxa, ‘Xulun!’","poem":1},{"lineBreak":true},{"text":"Xɛmaan nun wure gbeti fixɛn nan soxi a ma,","poem":1},{"lineBreak":true},{"text":"koni nii mi a yi.","poem":1},{"lineBreak":true},{"text":"Na fa i xaranma di?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Koni Alatala nan a Batu Banxi sariɲanxini.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn muxune birin xa sabari a yɛtagi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}