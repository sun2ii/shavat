{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HAB","translationId":"yal_pbt","name":"Nabi Xabakuki Sora","commonName":"Nabi Xabakuki Sora","title":"Xabakuki Nabi Xabakuki Alaa Falan Naxan Sɛbɛ","order":35,"numberOfChapters":3,"sha256":"41b9ffead3615d111fde3a17c8c5e6b67a5d7e50017f97e15f8f70b4d74d3ce3","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/yal_pbt/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Nabi Xabakuki Ala maxandina"]},{"type":"verse","number":1,"content":["Nabi Xabakuki Ala maxandina, muxune naxan bama mawuga bɛtin na."]},{"type":"verse","number":2,"content":[{"text":"Alatala, n bata i xinla mɛ.","poem":1},{"lineBreak":true},{"text":"Alatala, n bata kabɛ i kɛwali gbeene ma.","poem":1},{"lineBreak":true},{"text":"I mɔn xa ne rakamali to!","poem":1},{"lineBreak":true},{"text":"I mɔn xa i kɛwanle yita waxatini ito muxune ra.","poem":1},{"lineBreak":true},{"text":"I ya kininkininna xa rabira i ma i ya xɔlɔni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ala kelima Teman nin.","poem":1},{"lineBreak":true},{"text":"Sariɲantɔɔn sa kelima Paran geyaan nin.","poem":1},"Bɛti xuini te.",{"text":"A binyen kore xɔnna birin ma,","poem":1},{"lineBreak":true},{"text":"a tantunna bɔxɔ xɔnna rafexi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A nɔrɔn gbo alo sogena.","poem":1},{"lineBreak":true},{"text":"Tɛɛ dɛgɛn kelima a yiini","poem":1},{"lineBreak":true},{"text":"a sɛnbɛn luxunxi dɛnaxan yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fitina furen minima a yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"furene biraxi a fɔxɔ ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A na ti, a bɔxɔni maxa.","poem":1},{"lineBreak":true},{"text":"A na a yɛɛn ti siyane ra,","poem":1},{"lineBreak":true},{"text":"e xuruxurun.","poem":1},{"lineBreak":true},{"text":"Habadan geyane xuyama ayi,","poem":1},{"lineBreak":true},{"text":"geya singene kalama,","poem":1},{"lineBreak":true},{"text":"a dangu funfune luma nɛn habadan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N Kusan kaane bubune kalaxine toma,","poem":1},{"lineBreak":true},{"text":"n Midiyan kaane dɔxɔdene yigitɛgɛxin to.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala i yi xɔlɔxi baane nan ma ba?","poem":1},{"lineBreak":true},{"text":"I bɔɲɛ te nɛn xudene xili ma ba?","poem":1},{"lineBreak":true},{"text":"I xɔlɔxi fɔxɔ igen nan ma,","poem":1},{"lineBreak":true},{"text":"i te i ya soone fari waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"i to te i ya yɛngɛ so wontorone kui nɔ sɔtɔni?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I ya xanla bata ramini,","poem":1},{"lineBreak":true},{"text":"i kɔlɔ xuine luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo xalimakunle.","poem":1},"Bɛti xuini te.",{"text":"I bɔxɔni bɔma,","poem":1},{"lineBreak":true},{"text":"baa igene yi mini.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Geyane to i to,","poem":1},{"lineBreak":true},{"text":"e xuruxurun,","poem":1},{"lineBreak":true},{"text":"tule gbeen yi fa,","poem":1},{"lineBreak":true},{"text":"tilinna yi xuxu,","poem":1},{"lineBreak":true},{"text":"a yi a mɔrɔnne yite.","poem":1},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I xalimakunla naxanye wolima","poem":1},{"lineBreak":true},{"text":"sogen nun kiken bata ti e funfuni ne dɛgɛn bun,","poem":1},{"lineBreak":true},{"text":"koren yi a ɲinna masɔxɔn i ya tanban bun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I fitinaxin nan bɔxɔni siga,","poem":1},{"lineBreak":true},{"text":"i siyane halagi xɔlɔni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I minima i ya yamaan nan xunbadeyi,","poem":1},{"lineBreak":true},{"text":"alogo i xa i ya muxu yɛbaxin nakisi.","poem":1},{"lineBreak":true},{"text":"I muxu ɲaxine bɔnsɔnna mangan faxa,","poem":1},{"lineBreak":true},{"text":"i yi a bundɔxɔne birin naxɔri.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":14,"content":[{"text":"I e kuntigine xunne sɔxɔnma","poem":1},{"lineBreak":true},{"text":"e yɛtɛna xalimakunle nan na","poem":1},{"lineBreak":true},{"text":"naxanye gixin yi fama nxu raxuyadeni ayi","poem":1},{"lineBreak":true},{"text":"e gbelegbelema sɛwani,","poem":1},{"lineBreak":true},{"text":"alo e nɛma yiigelitɔne faxama wundoni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I ya soone bata fɔxɔ igeni bodon,","poem":1},{"lineBreak":true},{"text":"igene yi walanɲɛ ayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"N to na birin mɛ,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛn yi mini,","poem":1},{"lineBreak":true},{"text":"n dɛ xara gaxuni.","poem":1},{"lineBreak":true},{"text":"N xɔnne yi n xɔlɔ,","poem":1},{"lineBreak":true},{"text":"n sanne yi lu xuruxurunɲɛ.","poem":1},{"lineBreak":true},{"text":"Anu, n gbalo lɔxɔni ito mamɛma limaniyaan nin","poem":1},{"lineBreak":true},{"text":"bayo a fama nxu ɲaxankata siyaan nan xili ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hali xɔdɛ binle mi fa fugama,","poem":1},{"lineBreak":true},{"text":"manpa binle mi fa bogima,","poem":1},{"lineBreak":true},{"text":"oliwi bogine yi kala,","poem":1},{"lineBreak":true},{"text":"hali donse yo mi fa kelima xɛɛne ma,","poem":1},{"lineBreak":true},{"text":"hali yɛxɛɛne mi fa kulani,","poem":1},{"lineBreak":true},{"text":"ɲingene fan yi ɲan ɛ sansanne yi,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"koni n tan sɛwama nɛn Alatala yi,","poem":1},{"lineBreak":true},{"text":"n tan ɲaxanma nɛn Alaa fe ra,","poem":1},{"lineBreak":true},{"text":"n nakisimana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Marigina Alatala nan n sɛnbɛn na.","poem":1},{"lineBreak":true},{"text":"A bata n sanne lu","poem":1},{"lineBreak":true},{"text":"alo xɛnla sanne","poem":1},{"lineBreak":true},{"text":"a yi geyane xuntagine findi n ma siga tiden na.","poem":1},{"lineBreak":true},"Na sɛbɛxi bɛti baane kuntigin nan xa. A xa ba maxase luti kanne ra."]}],"footnotes":[{"noteId":1,"caller":"+","text":"3.10Igen mɔrɔnne:alo foyen na so igeni.","reference":{"chapter":3,"verse":10}}]},"thisChapterLink":"/api/yal_pbt/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}