{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HOS","translationId":"yal_pbt","name":"Nabi Hose Sora","commonName":"Nabi Hose Sora","title":"Hose Nabi Hose Alaa Falan Naxan Sɛbɛ","order":28,"numberOfChapters":14,"sha256":"35fe2be3fbbe6ab396defb0917fa7842dc0b89d72f0bd9f9fdad6715c12edbde","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/yal_pbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Samari kaane yulubine saranma e ra nɛn,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e bata murutɛ e Ala xili ma.","poem":1},{"lineBreak":true},{"text":"E faxama nɛn silanfanna ra,","poem":1},{"lineBreak":true},{"text":"e dii ɲɔrɛne bira bɔxɔni,","poem":1},{"lineBreak":true},{"text":"e ɲaxalan fudikanne kuine rabɔ ayi.","poem":1}]},{"type":"heading","content":["Isirayila kaane xa tubi Ala ma"]},{"type":"verse","number":2,"content":[{"text":"Isirayila, fa Alatala ma, i ya Ala!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i hakɛne bata i rabira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ tubi Alatala ma","poem":1},{"lineBreak":true},{"text":"ɛ a mafan falan na.","poem":1},{"lineBreak":true},{"text":"Ɛ a fala a xa, ɛ naxa,","poem":1},{"lineBreak":true},{"text":"“Nxu mafelu nxu hakɛne birin na,","poem":1},{"lineBreak":true},{"text":"i nxu rasɛnɛ ki faɲi,","poem":1},{"lineBreak":true},{"text":"alogo nxu xa tantun xuiin findi nxɔ saraxan na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asiriya kaa mi nxu rakisɛ,","poem":1},{"lineBreak":true},{"text":"nxu mi tema soone fari yɛngɛ xinla ma.","poem":1},{"lineBreak":true},{"text":"Nxu mi fa a falɛ nxɔ se rafalaxine ma, ‘Nxɔ ala!’","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i tan nan kininkininma kiridine ma.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na e xɔnfenma nɛn e na xun xɔn sigani.","poem":1},{"lineBreak":true},{"text":"N na e xanuma nɛn fonisireyaan na,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n ma xɔlɔn bata xɛtɛ e fɔxɔ ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N luma nɛn Isirayila xa alo xiila,","poem":1},{"lineBreak":true},{"text":"a tofanma nɛn","poem":1},{"lineBreak":true},{"text":"alo gabalan fugaxina.","poem":1},{"lineBreak":true},{"text":"A sabatima nɛn","poem":1},{"lineBreak":true},{"text":"alo wudi binla naxanye Liban yamanani,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"alo wudi binla na maɲingi a faɲin na,","poem":1},{"lineBreak":true},{"text":"a tofanma nɛn alo oliwi wudina,","poem":1},{"lineBreak":true},{"text":"a xiri faɲin yi mini","poem":1},{"lineBreak":true},{"text":"alo Liban suman fɔtɔnne.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yamaan fama Isirayila ma","poem":1},{"lineBreak":true},{"text":"alo e soma wudi binla nan ninin bun.","poem":1},{"lineBreak":true},{"text":"E maala mɔn fanma nɛn.","poem":1},{"lineBreak":true},{"text":"E sabatima","poem":1},{"lineBreak":true},{"text":"alo manpa binla","poem":1},{"noteId":7},{"text":"na fuga.","poem":1},{"lineBreak":true},{"text":"E xinla sɔtɔma nɛn","poem":1},{"lineBreak":true},{"text":"alo Liban minseen faɲina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Efirami bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"nanse mɔn nxu nun suxurene tagi?","poem":1},{"lineBreak":true},{"text":"N tan nan i ramɛma,","poem":1},{"lineBreak":true},{"text":"n yi n yengi sa i xɔn.","poem":1},{"lineBreak":true},{"text":"N luma nɛn i xa","poem":1},{"lineBreak":true},{"text":"alo wudi gbee xindena.","poem":1},{"lineBreak":true},{"text":"I bogin sɔtɔma n tan nan na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fekolonna nde ra?","poem":1},{"lineBreak":true},{"text":"A xa feni itoe famu!","poem":1},{"lineBreak":true},{"text":"Xaxilimane xa e yɛɛ to!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ Alatalaa kirane tinxin,","poem":1},{"lineBreak":true},{"text":"tinxin muxune sigan tima nɛn e xɔn,","poem":1},{"lineBreak":true},{"text":"koni murutɛ muxune dagalanma ayi nɛn na yi.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"14.8 Wudi binla nde na yi, mɛn kaane naxanye sima, e yi naxanye bogi yitɔnma alo manpana e gbee kiini.","reference":{"chapter":14,"verse":8}}]},"thisChapterLink":"/api/yal_pbt/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}