{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HOS","translationId":"yal_pbt","name":"Nabi Hose Sora","commonName":"Nabi Hose Sora","title":"Hose Nabi Hose Alaa Falan Naxan Sɛbɛ","order":28,"numberOfChapters":14,"sha256":"35fe2be3fbbe6ab396defb0917fa7842dc0b89d72f0bd9f9fdad6715c12edbde","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/yal_pbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Isirayila tinxintarena"]},{"type":"verse","number":1,"content":[{"text":"Isirayila kaane,","poem":1},{"lineBreak":true},{"text":"ɛ Alatalaa falan namɛ!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ kitina Alatala nun ɛ tan tagi.","poem":1},{"lineBreak":true},{"text":"A naxa, “Lannaya mi fa na.","poem":1},{"lineBreak":true},{"text":"Hinan mi na.","poem":1},{"lineBreak":true},{"text":"Ala kolon mi fa yamanani ito yi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dangan nun wulen nun faxan nun muɲan nun yalunyaan nan na.","poem":1},{"lineBreak":true},{"text":"Gbalon bata gbo ayi,","poem":1},{"lineBreak":true},{"text":"faxan tima a bode fari.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanara, ɛ yamanani xarama nɛn,","poem":1},{"lineBreak":true},{"text":"a niimaseen birin yi xɔsi.","poem":1},{"lineBreak":true},{"text":"Subene nun xɔline,","poem":1},{"lineBreak":true},{"text":"hali baa yɛxɛne fan faxama nɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koni muxu yo nama matandin ti,","poem":1},{"lineBreak":true},{"text":"muxu yo nama yamaan mafala,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ kitina nxu nun saraxaraline nan tagi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ tan saraxaraline nun nabine tantanma kɔɛɛn nun yanyin na.","poem":1},{"lineBreak":true},{"text":"Nanara, n na ɛ nga Isirayila faxama nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ma yamaan bata kala,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ kolonna dasaxi a ma.","poem":1},{"lineBreak":true},{"text":"Bayo ɛ bata ɛ mɛ kolonna ra,","poem":1},{"lineBreak":true},{"text":"n bata ɛ ba n ma saraxaraliyani.","poem":1},{"lineBreak":true},{"text":"Bayo ɛ bata ɛ Alaa sariyan nabeɲin,","poem":1},{"lineBreak":true},{"text":"n fan bata ɛ diine rabeɲin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Saraxaraline nɛma wuyɛ ayi,","poem":1},{"lineBreak":true},{"text":"e yulubine fan gboma ayi.","poem":1},{"lineBreak":true},{"text":"Nanara, n na e binyen masarama nɛn yagin na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E lugoma n ma yamaan yulubine xɔn.","poem":1},{"lineBreak":true},{"text":"Yamaan hakɛne e nii yifanma e ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A ligama nɛn saraxaraline ra alo yamana,","poem":1},{"lineBreak":true},{"text":"n yi e kɛwanle saran e ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E e dɛgema nɛn,","poem":1},{"lineBreak":true},{"text":"koni e mi lugoma.","poem":1},{"lineBreak":true},{"text":"E suxurene batuma,","poem":1},{"lineBreak":true},{"text":"koni ne mi e rasabatima.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ e bata Alatala rabeɲin,","poem":1},{"lineBreak":true},{"text":"e yi e sɔbɛ so","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"yalunyaan ma","poem":1},{"lineBreak":true},{"text":"e nun dɔlɔ fonna nun dɔlɔ nɛnɛ minna.","poem":1},{"lineBreak":true},{"text":"Ne nan e xaxinla kalaxi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N ma yamaan suxure wudine maxɔdinma,","poem":1},{"lineBreak":true},{"text":"alo dunganna nan falan tiyɛ e xa.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ yalunya xaxinla bata e ralɔ ayi,","poem":1},{"lineBreak":true},{"text":"e yalunyaan ligama Ala ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E saraxan bama geya gbeene xuntagi.","poem":1},{"lineBreak":true},{"text":"E wusulanna ganma geyane fari,","poem":1},{"lineBreak":true},{"text":"xanamu warine nun wudi tofaɲine nun kondene bun ma,","poem":1},{"lineBreak":true},{"text":"e nun wudi belebelen naxanye ninin gbo.","poem":1},{"lineBreak":true},{"text":"Nanara, ɛ dii tɛmɛne yalunyaan ligama","poem":1},{"lineBreak":true},{"text":"e nun yalunden nan ɛ bitan gilɛne ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N mi ɛ dii tɛmɛne yulubine saranma e ra","poem":1},{"lineBreak":true},{"text":"bayo e yalunyaan ligama,","poem":1},{"lineBreak":true},{"text":"hanma ɛ bitan gilɛne","poem":1},{"lineBreak":true},{"text":"bayo yalunden nan e ra.","poem":1},{"lineBreak":true},{"text":"Bayo ɛ tan yɛtɛn yalunyaan ligama ɛ nun yalundene,","poem":1},{"lineBreak":true},{"text":"ɛ nun ɲaxalan yalunxine saraxan bama.","poem":1},{"lineBreak":true},{"text":"Yama xaxilitarena a gima a bɔnɔni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Isirayila, xa i lu yalunyani,","poem":1},{"lineBreak":true},{"text":"ɛ nama Yuda ti hakɛn ma,","poem":1},{"lineBreak":true},{"text":"ɛ nama siga Giligali yi,","poem":1},{"lineBreak":true},{"text":"ɛ nama te Beti-Aweni yi.","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Ɛ nama ɛ kɔlɔ Alatala xinli!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xa Isirayila murutɛxi","poem":1},{"lineBreak":true},{"text":"alo ɲinge mataganxina,","poem":1},{"lineBreak":true},{"text":"Alatala xa e masuxu di?","poem":1},{"lineBreak":true},{"text":"Alo yɛxɛɛdina mɛrɛmɛrɛ faɲin ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Efirami bɔnsɔnna muxune bata kankan suxure batun ma, e lu na!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa e minseene bata dasa,","poem":1},{"lineBreak":true},{"text":"e sa dangu yalunyaan ma.","poem":1},{"lineBreak":true},{"text":"E mangane waxi yagin nan xɔn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nanara, wuluwunla e xalima nɛn,","poem":1},{"lineBreak":true},{"text":"e yi yagi e saraxane fe ra.","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"4.15Beti-Awenibunna nɛɛn fa fala hakɛ kanne banxina. A falan tima Betɛli taan nan xili ma naxan bunna nɛɛn Alaa banxina.","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/yal_pbt/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}