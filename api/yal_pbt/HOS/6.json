{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HOS","translationId":"yal_pbt","name":"Nabi Hose Sora","commonName":"Nabi Hose Sora","title":"Hose Nabi Hose Alaa Falan Naxan Sɛbɛ","order":28,"numberOfChapters":14,"sha256":"35fe2be3fbbe6ab396defb0917fa7842dc0b89d72f0bd9f9fdad6715c12edbde","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/yal_pbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Isirayila xili fena Ala ma"]},{"type":"verse","number":1,"content":[{"text":"Ɛ fa be,","poem":1},{"lineBreak":true},{"text":"en xɛtɛ Alatala ma!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ a bata en yibɔ,","poem":1},{"lineBreak":true},{"text":"koni a mɔn en nakɛndɛyama nɛn.","poem":1},{"lineBreak":true},{"text":"A bata en garin,","poem":1},{"lineBreak":true},{"text":"koni a en maxɔlɔdene maxidima nɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xii firin na dangu,","poem":1},{"lineBreak":true},{"text":"a en niin birɛ en yi mɔn,","poem":1},{"lineBreak":true},{"text":"a xii saxandeni a en yitɔn,","poem":1},{"lineBreak":true},{"text":"en yi lu a yɛtagi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En xa Alatala kolon,","poem":1},{"lineBreak":true},{"text":"en bira a kolonna fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"Alo kuye yibaan to fama,","poem":1},{"lineBreak":true},{"text":"a fan minima nɛn kɛnɛnni yati!","poem":1},{"lineBreak":true},{"text":"A fama nɛn en xa","poem":1},{"lineBreak":true},{"text":"alo tulen ɲɛmɛn na,","poem":1},{"lineBreak":true},{"text":"alo furu tulen naxan bɔxɔni kunma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N nanse ligama ɛ tan na,","poem":1},{"lineBreak":true},{"text":"Efirami bɔnsɔnna?","poem":1},{"lineBreak":true},{"text":"N nanse ligama ɛ ra,","poem":1},{"lineBreak":true},{"text":"Yuda bɔnsɔnna?","poem":1},{"lineBreak":true},{"text":"Ɛ hinanna luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo xɔtɔn ma kundana,","poem":1},{"lineBreak":true},{"text":"alo xiila naxan yolonma","poem":1},{"lineBreak":true},{"text":"a xuya ayi mafurɛn!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nanara, n na ɛ yɛngɛma nɛn nabine ra,","poem":1},{"lineBreak":true},{"text":"n na ɛ faxama nɛn n dɛɛn fala xuine ra.","poem":1},{"lineBreak":true},{"text":"N ma kitine fixa alo kɛnɛnna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amasɔtɔ hinanna rafan n ma dangu saraxan na.","poem":1},{"lineBreak":true},{"text":"Ala kolonna dangu saraxa gan daxine ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E bata layiri kala alo adamadiine,","poem":1},{"lineBreak":true},{"text":"nayi e bata n yanfa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Galadi taan nafexi fe ɲaxi rabane nan na,","poem":1},{"lineBreak":true},{"text":"han wuli funfune toma ayi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alo mafu tiin naxanye muxune legedenma luxunni,","poem":1},{"lineBreak":true},{"text":"saraxarali ganla fan bata faxan ti Siken taan kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"e gbalone raba.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N bata fe ɲaxine to Isirayila yamaan yɛ:","poem":1},{"lineBreak":true},{"text":"Efirami bɔnsɔnna bata yalunyaan liga,","poem":1},{"lineBreak":true},{"text":"Isirayila bɔnsɔnna e yɛtɛ raxɔsima.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I tan fan, Yuda,","poem":1},{"lineBreak":true},{"text":"se xaba waxatin nagidixi i xa,","poem":1},{"lineBreak":true},{"text":"n na fa n ma yamaan suxu muxune ra waxatin naxan yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}