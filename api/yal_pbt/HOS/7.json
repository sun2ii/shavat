{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HOS","translationId":"yal_pbt","name":"Nabi Hose Sora","commonName":"Nabi Hose Sora","title":"Hose Nabi Hose Alaa Falan Naxan Sɛbɛ","order":28,"numberOfChapters":14,"sha256":"35fe2be3fbbe6ab396defb0917fa7842dc0b89d72f0bd9f9fdad6715c12edbde","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/yal_pbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"heading","content":["Isirayilaa hakɛna"]},{"type":"verse","number":1,"content":[{"text":"N to wa Isirayila bɔnsɔnna rakɛndɛya feni,","poem":1},{"lineBreak":true},{"text":"Efirami bɔnsɔnna hakɛn mɔn yi keli.","poem":1},{"lineBreak":true},{"text":"Samari a ɲaxun yi mini kɛnɛnni.","poem":1},{"lineBreak":true},{"text":"Bayo e darixi yanfan soɛ.","poem":1},{"lineBreak":true},{"text":"Muɲadene soma,","poem":1},{"lineBreak":true},{"text":"mafu tiine yi lu tandeni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E mi e mirima","poem":1},{"lineBreak":true},{"text":"fa fala n xaxili e ɲaxuyane birin xɔn.","poem":1},{"lineBreak":true},{"text":"Iki e kɛwanle e rabilinxi,","poem":1},{"lineBreak":true},{"text":"e hakɛne n yɛtagi waxatin birin.","poem":1}]},{"type":"heading","content":["Yanfan Mangan ma"]},{"type":"verse","number":3,"content":[{"text":"Itoe rafan mangan ma,","poem":1},{"lineBreak":true},{"text":"koni e ɲaxu!","poem":1},{"lineBreak":true},{"text":"E wulene rafan kuntigine ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E birin yalunde.","poem":1},{"lineBreak":true},{"text":"E kui feene wolonxi alo buru gandena.","poem":1},{"lineBreak":true},{"text":"A na wolon,","poem":1},{"lineBreak":true},{"text":"buru ganna mi fa a tɛɛn nafɛ","poem":1},{"lineBreak":true},{"text":"keli burun bɔnbɔ waxatini han a yi te.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na kiini, mangana ɲaxaɲaxan lɔxɔni,","poem":1},{"lineBreak":true},{"text":"kuntigine xunne yi keli dɔlɔn na.","poem":1},{"lineBreak":true},{"text":"Mangan yi magele tiini itoe rasɛnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E xaɲɛ alo sulun tɛɛna,","poem":1},{"noteId":4},{"lineBreak":true},{"text":"e maso mangan na, e xa yanfan so a ma.","poem":1},{"lineBreak":true},{"text":"E bɔɲɛ teen dɛgɛma nɛn kɔɛna ngaan na,","poem":1},{"lineBreak":true},{"text":"xɔtɔnni a keli alo wonson tɛɛna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Isirayila kaane xaɲɛ alo sulun tɛɛna,","poem":1},{"lineBreak":true},{"text":"e e kuntigine raxɔrima,","poem":1},{"lineBreak":true},{"text":"e e mangane birin faxa.","poem":1},{"lineBreak":true},{"text":"Anu, na sese mi n maxandima.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Efirami bɔnsɔnna basanma siyane ra.","poem":1},{"lineBreak":true},{"text":"Efirami bɔnsɔnna findixi buru xunna ra","poem":1},{"lineBreak":true},{"text":"naxan fɔxɔ keden ganxi","poem":1},{"lineBreak":true},{"text":"bode fɔxɔ mi ganxi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xɔɲɛne a sɛnbɛn kalama","poem":1},{"lineBreak":true},{"text":"koni a mi sikɛma.","poem":1},{"lineBreak":true},{"text":"Foriyana a suxuma,","poem":1},{"lineBreak":true},{"text":"koni a mi a rakɔrɔsima.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Isirayilaa wason sereyaan bama a xili ma.","poem":1},{"lineBreak":true},{"text":"Koni na birin kui,","poem":1},{"lineBreak":true},{"text":"a mi xɛtɛma Alatala ma, a Ala,","poem":1},{"lineBreak":true},{"text":"a yi a fen.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efirami bɔnsɔnna luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo ganba xaxilitarena","poem":1},{"lineBreak":true},{"text":"naxan madaxuma sinma!","poem":1},{"lineBreak":true},{"text":"A Misiran bɔxɔn xilima waxatina nde yi,","poem":1},{"lineBreak":true},{"text":"a fa bira Asiriya mangane fɔxɔ ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xa e siga,","poem":1},{"lineBreak":true},{"text":"n yalaan wolima nɛn e fari,","poem":1},{"lineBreak":true},{"text":"n yi e rabira alo xɔlina.","poem":1},{"lineBreak":true},{"text":"N yi e yulubine saran e ra,","poem":1},{"lineBreak":true},{"text":"alo e rakolonxi kii naxan yi e malanni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbalona e xa,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e e gima n ma!","poem":1},{"lineBreak":true},{"text":"Fitina na e xa,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e murutɛxi n ma.","poem":1},{"lineBreak":true},{"text":"N yi waxi e xunba feni,","poem":1},{"lineBreak":true},{"text":"koni e wulene falama n xun ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"E mi n maxandima e bɔɲɛne yi,","poem":1},{"lineBreak":true},{"text":"koni e wugama e sadene nan ma.","poem":1},{"lineBreak":true},{"text":"E kunfama donseen nun dɔlɔn fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"koni e e masiga n tan na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N tan nan e maxaranxi,","poem":1},{"lineBreak":true},{"text":"n yi sɛnbɛn fi e ma,","poem":1},{"lineBreak":true},{"text":"koni e fe ɲaxine mirima n xili ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naxan kore,","poem":1},{"lineBreak":true},{"text":"e mi xɛtɛma na ma,","poem":1},{"lineBreak":true},{"text":"e yanfan tima","poem":1},{"lineBreak":true},{"text":"alo xali yidɔxina.","poem":1},{"lineBreak":true},{"text":"Nanara, e kuntigine faxama nɛn silanfanna ra,","poem":1},{"lineBreak":true},{"text":"e dɛ ɲaxune fe ra.","poem":1},{"lineBreak":true},{"text":"Misiran kaane yi e magele na ra.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"7.6Sulun tɛɛnmɔn falama yirena nde yi fa fala “Furu tɛɛna.”","reference":{"chapter":7,"verse":6}}]},"thisChapterLink":"/api/yal_pbt/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}