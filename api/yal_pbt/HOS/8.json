{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"HOS","translationId":"yal_pbt","name":"Nabi Hose Sora","commonName":"Nabi Hose Sora","title":"Hose Nabi Hose Alaa Falan Naxan Sɛbɛ","order":28,"numberOfChapters":14,"sha256":"35fe2be3fbbe6ab396defb0917fa7842dc0b89d72f0bd9f9fdad6715c12edbde","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/yal_pbt/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Isirayilaa suxure batuna"]},{"type":"verse","number":1,"content":[{"text":"Ɛ xɔtani tɔn,","poem":1},{"lineBreak":true},{"text":"yaxun godoma nɛn Alatala banxin ma alo singbinna.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ yamaan bata n ma layirin kala,","poem":1},{"lineBreak":true},{"text":"e yi murutɛ n ma sariyan ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E sɔnxɔma n xinla ra:","poem":1},{"lineBreak":true},{"text":"“Nxɔ Ala, nxu i kolon,","poem":1},{"lineBreak":true},{"text":"nxu tan, Isirayila!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Koni, naxan fan,","poem":1},{"lineBreak":true},{"text":"Isirayila bata a mɛ na ra,","poem":1},{"lineBreak":true},{"text":"nanara yaxun birama nɛn a fɔxɔ ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E bata mangane ti n ma","poem":1},{"lineBreak":true},{"text":"yamarin mi naxan na,","poem":1},{"lineBreak":true},{"text":"e bata kuntigine ti","poem":1},{"lineBreak":true},{"text":"e mi n maxɔdin.","poem":1},{"lineBreak":true},{"text":"E bata suxurene rafala e gbetine nun e xɛmane ra,","poem":1},{"lineBreak":true},{"text":"nanara e raxɔrima nɛn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ala bata i ya ɲinge dii suxuren nawoli ayi,","poem":1},{"lineBreak":true},{"text":"Samari kaane!","poem":1},{"lineBreak":true},{"text":"N ma xɔlɔn bata keli e xili ma han!","poem":1},{"lineBreak":true},{"text":"Han waxatin mundun yi","poem":1},{"lineBreak":true},{"text":"e tondɛ e rasariɲanɲɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A kelixi ɛ tan nan yii,","poem":1},{"lineBreak":true},{"text":"ɛ tan Isirayila kaane.","poem":1},{"lineBreak":true},{"text":"Walikɛna nde nan a rafalaxi,","poem":1},{"lineBreak":true},{"text":"Ala mi a ra!","poem":1},{"lineBreak":true},{"text":"Nanara, Samari a ɲinge dii suxuren kalama nɛn fefe!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Naxan na fe ɲaxin nakeli,","poem":1},{"lineBreak":true},{"text":"gbalon nan xɛtɛma a ma.","poem":1},{"lineBreak":true},{"text":"Nanara, hali murutun tɔnsɔn keden,","poem":1},{"lineBreak":true},{"text":"e mi a sɔtɔma xɛɛn ma.","poem":1},{"lineBreak":true},{"text":"Xa na nde mini,","poem":1},{"lineBreak":true},{"text":"na mi murutu fuɲi raminɛ.","poem":1},{"lineBreak":true},{"text":"Hali na nde yi na nun,","poem":1},{"lineBreak":true},{"text":"xɔɲɛne nan yi a donma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Isirayila bata kala!","poem":1},{"lineBreak":true},{"text":"E tɔnɔn mi fa na siyane yɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E bata siga Asiriya yi,","poem":1},{"lineBreak":true},{"text":"alo burunna sofanla","poem":1},{"lineBreak":true},{"text":"naxan sa tima a danna.","poem":1},{"lineBreak":true},{"text":"Nayi, Efirami bɔnsɔnna bata a yɛtɛ sara a suxurene ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hali e bata kantan tiine sara siyane tagi,","poem":1},{"lineBreak":true},{"text":"iki n na e birin malanma nɛn,","poem":1},{"lineBreak":true},{"text":"alogo e xa sa tɔrɔ ndedi Manga Gbeena goronne bun ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Efirami bɔnsɔnna bata yulubi xafari saraxa gandene rawuya ayi,","poem":1},{"lineBreak":true},{"text":"koni ne bata findi yulubi tongoden na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N bata n ma sariyane birin sɛbɛ e xa,","poem":1},{"lineBreak":true},{"text":"koni e a toxi alo se xɔɲɛna.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E saraxane ba,","poem":1},{"lineBreak":true},{"text":"e kiseene rali,","poem":1},{"lineBreak":true},{"text":"e a suben don.","poem":1},{"lineBreak":true},{"text":"Koni ne mi rafan Alatala ma.","poem":1},{"lineBreak":true},{"text":"Iki, Alatala xaxili e hakɛne xɔn,","poem":1},{"lineBreak":true},{"text":"a e yulubine saranma e ra nɛn.","poem":1},{"lineBreak":true},{"text":"E xɛtɛ Misiran bɔxɔn ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Naxan Isirayila daxi","poem":1},{"lineBreak":true},{"text":"e bata ɲinan na xɔn,","poem":1},{"lineBreak":true},{"text":"e sa manga banxine ti.","poem":1},{"lineBreak":true},{"text":"Yuda bata a taa ratangaxine rawuya ayi,","poem":1},{"lineBreak":true},{"text":"koni n tɛɛn nafama nɛn e taane yi,","poem":1},{"lineBreak":true},{"text":"a yi e yinne gan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}