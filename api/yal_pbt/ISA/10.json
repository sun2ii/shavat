{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":10,"content":[{"type":"heading","content":["Gbalon Yuda taane xili ma"]},{"type":"verse","number":1,"content":[{"text":"Gbalon na kanne xa","poem":1},{"lineBreak":true},{"text":"naxanye tɔnne dɔxɔma hakɛni,","poem":1},{"lineBreak":true},{"text":"naxanye sariyane sɛbɛma bodene tɔrɔ xinla ma,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"e tondi sɛnbɛtarene xun mayɛngɛ kitin sɛ.","poem":1},{"lineBreak":true},{"text":"Yiigelitɔɔn naxanye n ma yamaan yɛ,","poem":1},{"lineBreak":true},{"text":"e mi ne kitin sama.","poem":1},{"lineBreak":true},{"text":"E kaɲa gilɛne kansunma,","poem":1},{"lineBreak":true},{"text":"e kiridine muɲa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ fe saranna na ɛ sɔtɔ lɔxɔ naxan yi,","poem":1},{"lineBreak":true},{"text":"gbalon na fa sa keli wulani,","poem":1},{"lineBreak":true},{"text":"ɛ nanse ligama?","poem":1},{"lineBreak":true},{"text":"Ɛ ɛ gima siga nde kon yi","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa maliin sɔtɔ?","poem":1},{"lineBreak":true},{"text":"Ɛ nafunle luma minɛn?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fɔ ɛ mafelen kasorasane tagi,","poem":1},{"lineBreak":true},{"text":"hanma ɛ bira bɔxɔni binbine yɛ.","poem":1},{"lineBreak":true},{"text":"Koni hali na birin,","poem":1},{"lineBreak":true},{"text":"Alaa xɔlɔn mi ɲan,","poem":1},{"lineBreak":true},{"text":"a yiin mɔn yi lu yitexi e xili ma.","poem":1}]},{"type":"heading","content":["Gbalona Asiriya kaane xili ma"]},{"type":"verse","number":5,"content":[{"text":"Ala naxa,","poem":1},{"lineBreak":true},{"text":"“Gbalona Asiriya yamanan xa,","poem":1},{"lineBreak":true},{"text":"naxan findixi bosaan na n yii n ma xɔlɔna fe ra!","poem":1},{"lineBreak":true},{"text":"N ma fitinan dunganna a tan nan yii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na a sofane rasigama nɛn","poem":1},{"lineBreak":true},{"text":"Ala kolontare siyaan xili ma.","poem":1},{"lineBreak":true},{"text":"N yi e radin yamaan xili ma","poem":1},{"lineBreak":true},{"text":"naxanye n naxɔlɔma","poem":1},{"lineBreak":true},{"text":"e xa sa mɛn kaane yii seene suxu,","poem":1},{"lineBreak":true},{"text":"e yi e nafunle tongo,","poem":1},{"lineBreak":true},{"text":"e yi e yibodon","poem":1},{"lineBreak":true},{"text":"alo borona kiraan xɔn!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Koni Asiriya kaane mi na feen to na kiini.","poem":1},{"lineBreak":true},{"text":"E tan e miri na fe ma kii gbɛtɛni.","poem":1},{"lineBreak":true},{"text":"E tan yi waxi halagi nan tun ti feni,","poem":1},{"lineBreak":true},{"text":"e yi siya wuyaxine raxɔri fefe!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amasɔtɔ e naxa,","poem":1},{"lineBreak":true},{"text":"‘N ma sofa kuntigine mi findixi mangane xan na ba?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N mi Kalano taan suxi","poem":1},{"lineBreak":true},{"text":"alo Karakemisi taan ba?","poem":1},{"lineBreak":true},{"text":"N mi Xamata taan ligaxi","poem":1},{"lineBreak":true},{"text":"alo Arapada taan ba?","poem":1},{"lineBreak":true},{"text":"N mi Samari taan ligaxi","poem":1},{"lineBreak":true},{"text":"alo Damasi taan ba?","poem":1},{"noteId":11}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N bata suxure batu yamanani itoe suxu,","poem":1},{"lineBreak":true},{"text":"naxanye suxurene yi fisa Yerusalɛn","poem":1},{"lineBreak":true},{"text":"nun Samari yamanan gbeene xa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N naxan liga Samari yamanan nun a suxurene ra,","poem":1},{"lineBreak":true},{"text":"n mi nɔɛ na ligɛ Yerusalɛn nun a suxurene ra ba?’ ”","poem":1}]},{"type":"verse","number":12,"content":["Koni Marigin na yelin a wanle birin nakamalɛ Siyon geyaan fari e nun Yerusalɛn yi, a Asiriya mangan fan saranma nɛn a yɛtɛ yiteen nun a yɛɛ rawason na."]},{"type":"verse","number":13,"content":["Amasɔtɔ na mangan yi a falama nɛn, a naxa,",{"text":"“N feni itoe birin ligaxi","poem":1},{"lineBreak":true},{"text":"n fangan nun n ma fe kolonna nin,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ xaxilimaan nan n na.","poem":1},{"lineBreak":true},{"text":"N bata yamanane danne kala,","poem":1},{"lineBreak":true},{"text":"n yi e nafunle muɲa,","poem":1},{"lineBreak":true},{"text":"n mangane ba e dɔxɔdene yi","poem":1},{"lineBreak":true},{"text":"alo sɛnbɛmaan yɛtɛna.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N bata siyane nafunle tongo","poem":1},{"lineBreak":true},{"text":"alo muxun xɔli tɛɛn tongon kii naxan yi.","poem":1},{"lineBreak":true},{"text":"N bata bɔxɔ xɔnna seene birin malan","poem":1},{"lineBreak":true},{"text":"alo muxun xɔli xɛlɛ rabeɲinxine matongon kii naxan yi.","poem":1},{"lineBreak":true},{"text":"E sese mi nɔxi e gabutɛni tɛ,","poem":1},{"lineBreak":true},{"text":"hanma e dɛ xanli bi, e wuga.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Bunbin nɔɛ a yɛtɛ matɔxɛ","poem":1},{"lineBreak":true},{"text":"dangu a rawali muxun na ba?","poem":1},{"lineBreak":true},{"text":"Sɛrana a yɛtɛ matɔxɛ","poem":1},{"lineBreak":true},{"text":"dangu a rawali muxun na ba?","poem":1},{"lineBreak":true},{"text":"Bosaan nɔɛ a tongo muxun nawalɛ ba?","poem":1},{"lineBreak":true},{"text":"Dunganna nɔɛ muxun tongɛ ba?","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nanara, Marigina Alatala Sɛnbɛn Birin Kanna","poem":1},{"lineBreak":true},{"text":"yama hiyabuxini ito radoyenma nɛn.","poem":1},{"lineBreak":true},{"text":"Halagi ti tɛɛ gbeen yi so e binyen na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Isirayilaa kɛnɛnna,","poem":1},{"lineBreak":true},{"text":"Ala yɛtɛɛn findima nɛn tɛɛn na.","poem":1},{"lineBreak":true},{"text":"E sariɲantɔɔn yi findi tɛɛ dɛgɛn na,","poem":1},{"lineBreak":true},{"text":"a Asiriya yamanan ɲanle","poem":1},{"lineBreak":true},{"text":"nun a sɛxɛne birin gan,","poem":1},{"lineBreak":true},{"text":"e ɲan lɔxɔ kedenni.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A fɔtɔn gbeene raxɔrima nɛn fefe","poem":1},{"lineBreak":true},{"text":"e nun wudin naxanye birin bogima.","poem":1},{"lineBreak":true},{"text":"A yamanan halagi","poem":1},{"lineBreak":true},{"text":"alo furemaan nɛma doyenɲɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wudi dɔnxɛn naxanye na lu Asiriya fɔtɔnne yi","poem":1},{"lineBreak":true},{"text":"hali dii ɲɔrɛna,","poem":1},{"lineBreak":true},{"text":"a nɔɛ e yatɛn sɛbɛ nɛn.","poem":1}]},{"type":"heading","content":["Yamaan muxu dɔnxɛne fe"]},{"type":"verse","number":20,"content":["Na lɔxɔni, Isirayila yamaan muxu dɔnxɛn naxanye na lu e nii ra Yaxuba bɔnsɔnni, ne mi fa e lannantenyaan sama e ɲaxankata muxune yi sɔnɔn. E fa e lannayaan sama Alatala nin, Isirayilaa Ala Sariɲanxina."]},{"type":"verse","number":21,"content":["Yamaan muxu dɔnxɛne xɛtɛma nɛn Ala sɛnbɛmaan ma, Yaxuba bɔnsɔnna muxu dɔnxɛne."]},{"type":"verse","number":22,"content":["Anu, Isirayila kaane, hali ɛ yamaan wuya ayi alo mɛɲɛnsinna naxan fɔxɔ igen dɛ, hali na, e dɔnxɛdin nan tun xɛtɛma. Halagin bata ragidi, naxan gboma ayi, a mɔn tinxin."]},{"type":"verse","number":23,"content":["Marigina Alatala Sɛnbɛn Birin Kanna bata halagin naxan nagidi, a na rakamalima nɛn yamanan birin yi."]},{"type":"heading","content":["Ala a yamaan xunbama nɛn"]},{"type":"verse","number":24,"content":["Nanara, Marigina Alatala Sɛnbɛn Birin Kanna ito nan falaxi, a naxa, “N ma yamana, ɛ tan naxanye dɔxi Siyon yi, ɛ nama gaxu Asiriya kaane yɛɛ ra! E ɛ bɔnbɔma nɛn dunganna ra, e yi gbengbetenni te ɛ xili ma alo Misiran kaane yi a ligama kii naxan yi nun."]},{"type":"verse","number":25,"content":["Koni benun waxati, n ma xɔlɔn ɲanma nɛn ɛ xili ma. N fitinaxin yi keli e kaladeni.”"]},{"type":"verse","number":26,"content":["Alatala Sɛnbɛn Birin Kanna bosaan tongoma nɛn Asiriya kaane xili ma, alo a keli Midiyan kaane xili ma kii naxan yi Orebi fanye yireni. A a dunganni bandunma nɛn baan xun ma, alo a liga Misiran yamanani kii naxan yi."]},{"type":"verse","number":27,"content":[{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"a goronna bama nɛn ɛ tungunna ma,","poem":1},{"lineBreak":true},{"text":"e goron tongo wudin naxan sa ɛ kɔɛ ma konyiyani,","poem":1},{"lineBreak":true},{"text":"ɛ xungboma nɛn han na yi gira, a bira.","poem":1}]},{"type":"heading","content":["Yaxune yi maso Yerusalɛn ra"]},{"type":"verse","number":28,"content":[{"text":"E bata Ayati taan li.","poem":1},{"lineBreak":true},{"text":"E danguma Migiron nin,","poem":1},{"lineBreak":true},{"text":"e yi e goronne lu Mikimasi taani.","poem":1},{"noteId":12}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"E danguma geya longori ra kiraan nan xɔn","poem":1},{"lineBreak":true},{"text":"e a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"“En xi Geba yi.”","poem":1},{"lineBreak":true},{"text":"Rama kaane xuruxurunma gaxuni.","poem":1},{"lineBreak":true},{"text":"Sɔli a taan Gibeya muxune bata e gi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Galin kaane, ɛ gbelegbele!","poem":1},{"lineBreak":true},{"text":"Layisa kaane, ɛ tuli mati!","poem":1},{"lineBreak":true},{"text":"Anatɔti kaane, ɛ makininkinin de!","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Madimena kaane bata xuya ayi,","poem":1},{"lineBreak":true},{"text":"Gebimi kaane e luxunden fenma.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"To, yaxune sa tima nɛn Nobi yi,","poem":1},{"lineBreak":true},{"text":"e yi e yiini te,","poem":1},{"lineBreak":true},{"text":"e yi e kɔnkɔ Siyon taa faɲin geyaan xili ma,","poem":1},{"lineBreak":true},{"text":"Yerusalɛn geyana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Marigina Alatala Sɛnbɛn Birin Kanna","poem":1},{"lineBreak":true},{"text":"wudi yii gbeene sɛgɛma nɛn sɛnbɛni.","poem":1},{"lineBreak":true},{"text":"Wudi kuyene yi rabira bɔxɔni.","poem":1},{"lineBreak":true},{"text":"Naxanye kondeye mate han,","poem":1},{"lineBreak":true},{"text":"a ne ragodoma nɛn.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"A fɔtɔnna ɲansanne sɛgɛma nɛn bunbin na,","poem":1},{"lineBreak":true},{"text":"Liban fɔtɔnne yi bira Sɛnbɛ Kanna bun.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"10.9Asiriya kaane bata yi taani itoe suxu. E sɛbɛ kiina a yitaxi, a e luma e masoɛ Yerusalɛn taan nan na.","reference":{"chapter":10,"verse":9}},{"noteId":12,"caller":"+","text":"10.28Yaxune ganla yi fɛ nɛn Yerusalɛn yɛngɛdeni kirani ito xɔn. A bunna nɛɛn fa fala “Yaxune bata maso.”","reference":{"chapter":10,"verse":28}}]},"thisChapterLink":"/api/yal_pbt/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}