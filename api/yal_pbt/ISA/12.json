{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Yama rakisixin yi Ala tantun"]},{"type":"verse","number":1,"content":["I a falama nɛn na lɔxɔni, i naxa,",{"text":"“Alatala, n ni i tantunma.","poem":1},{"lineBreak":true},{"text":"I yi xɔlɔxi n ma,","poem":1},{"lineBreak":true},{"text":"koni i ya xɔlɔn bata xɛtɛ n fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"i yi n madɛndɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ala nan n nakisixi yati.","poem":1},{"lineBreak":true},{"text":"N na n yigi sama a tan nin,","poem":1},{"lineBreak":true},{"text":"n mi fa gaxuma.","poem":1},{"lineBreak":true},{"text":"Alatala nan n fangan na.","poem":1},{"lineBreak":true},{"text":"Alatala nan n ma bɛti ba xunna ra.","poem":1},{"lineBreak":true},{"text":"N nakisimana a tan nan na.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ kisin sɔtɔma nɛn sɛwani","poem":1},{"lineBreak":true},{"text":"alo ɛ igen bama tigi yinla ra kii naxan yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Na lɔxɔni, ɛ a falama nɛn, ɛ naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ tantunna fi Alatala ma,","poem":1},{"lineBreak":true},{"text":"ɛ xui ramini a ma a xinli,","poem":1},{"lineBreak":true},{"text":"ɛ a kɛwanle rali siyane tagi","poem":1},{"lineBreak":true},{"text":"ɛ a rabira muxune ma a xinla gbo kii naxan yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ bɛtin ba Alatala xa bayo a bata fe gbeene rakamali.","poem":1},{"lineBreak":true},{"text":"Ɛ e fe fala dunuɲa muxune birin xa!”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siyon kaane, ɛ sɔnxɔ sɛwani,","poem":1},{"lineBreak":true},{"text":"ɛ gbelegbele ɲaxanni!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ, Isirayilaa Ala Sariɲanxin gbo,","poem":1},{"lineBreak":true},{"text":"naxan ɛ tagi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}