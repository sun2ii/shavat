{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":15,"content":[{"type":"heading","content":["Waliyiya falan Moyaba xili ma"]},{"type":"verse","number":1,"content":["Waliyiya falana Moyaba yamanan xili ma:",{"text":"Ari taan bata raxɔri Moyaba yamanani","poem":1},{"lineBreak":true},{"text":"a kala kɔɛ kedenna ra.","poem":1},{"lineBreak":true},{"text":"Kiri taan bata raxɔri Moyaba yamanani","poem":1},{"lineBreak":true},{"text":"a kala kɔɛ kedenna ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dibon kaane tema e suxure kide matexine yi","poem":1},{"lineBreak":true},{"text":"e wugama.","poem":1},{"lineBreak":true},{"text":"Moyaba kaane gbelegbelema Nebo nun Medeba taane yi.","poem":1},{"lineBreak":true},{"text":"Muxune birin bata e xunne nun e dɛ xabene bi sununi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sunu dugine nun bɛnbɛnle ragodoxi e ma kirane xɔn ma.","poem":1},{"lineBreak":true},{"text":"E gbelegbelema e banxine fari","poem":1},{"lineBreak":true},{"text":"e nun e yama malandene yi,","poem":1},{"lineBreak":true},{"text":"e birin wugama han!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xɛsibɔn nun Eleyale kaane","poem":1},{"lineBreak":true},{"text":"gbelegbelema mali muxu feen na.","poem":1},{"lineBreak":true},{"text":"E xuiin sa mɛma fɔ Yahasi taani.","poem":1},{"lineBreak":true},{"text":"Nanara, Moyaba sofane gbelegbelema,","poem":1},{"lineBreak":true},{"text":"e bata tunnaxɔlɔ e ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N gbelegbelema Moyaba kaane fe ra.","poem":1},{"lineBreak":true},{"text":"A muxune bata e gi siga han Soyari taani,","poem":1},{"lineBreak":true},{"text":"siga han Egilati-Selisiya taani.","poem":1},{"lineBreak":true},{"text":"E tema wugɛ Luxiti geyaan na.","poem":1},{"lineBreak":true},{"text":"E wuga xuini tema e kalana fe ra Xoronayin kiraan xɔn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nimirimi daraan bata xɔri","poem":1},{"lineBreak":true},{"text":"sɛxɛne bata xara,","poem":1},{"lineBreak":true},{"text":"ɲɔxɔndene bata ɲan.","poem":1},{"lineBreak":true},{"text":"Sese xinde mi fa na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nanara, muxune e se dɔnxɛne tongoma","poem":1},{"lineBreak":true},{"text":"naxanye luxi e yii,","poem":1},{"lineBreak":true},{"text":"e nɔxi naxanye ramarɛ,","poem":1},{"lineBreak":true},{"text":"e yi siga e ra Wudi Tofaɲin Xuden kidi ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɔnxɔ xuiin minima Moyaba yamanan birin yi.","poem":1},{"lineBreak":true},{"text":"E wuga xuiin minima","poem":1},{"lineBreak":true},{"text":"sa keli fɔ Egilayimi taani,","poem":1},{"lineBreak":true},{"text":"sa keli fɔ Elimi xɔɲin yireni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xuden naxan danguma Dimɔn yi,","poem":1},{"lineBreak":true},{"text":"na bata findi wunla ra.","poem":1},{"lineBreak":true},{"text":"Ala naxa,","poem":1},{"lineBreak":true},{"text":"“N mɔn gbalo nɛnɛne rasigama nɛn Dimɔn yi.","poem":1},{"lineBreak":true},{"text":"N yatana nde rafama nɛn Moyaba muxu gixine xili ma,","poem":1},{"lineBreak":true},{"text":"e nun naxanye na lu e yamanani.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}