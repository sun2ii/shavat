{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":21,"content":[{"type":"heading","content":["Falan Babilɔn yamanan xili ma"]},{"type":"verse","number":1,"content":["Waliyiya falan ni i ra tonbonna xili ma fɔxɔ igen dɛ.",{"noteId":17},{"text":"Yaxun fama nɛn","poem":1},{"lineBreak":true},{"text":"sa keli tonbonni yamana magaxuxini","poem":1},{"lineBreak":true},{"text":"alo kala ti foyen nɛma fɛ yiifari ma tonbonna makɔɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ala bata fe magaxuxin yita n na.","poem":1},{"lineBreak":true},{"text":"Yanfantenna bata keli yanfa sodeni.","poem":1},{"lineBreak":true},{"text":"Halagi tiin bata halagin ti fɔlɔ.","poem":1},{"lineBreak":true},{"text":"Elan kaane, ɛ siga yɛngɛni!","poem":1},{"lineBreak":true},{"text":"Mede kaane ɛ taan nabilin!","poem":1},{"noteId":18},{"lineBreak":true},{"text":"Muxune yi kutunma e bun ma,","poem":1},{"lineBreak":true},{"text":"koni n fa danna sama nɛn na ma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanara, n tagin xuruxurunma.","poem":1},{"lineBreak":true},{"text":"N ɲaxankataxi","poem":1},{"lineBreak":true},{"text":"alo ɲaxanla tinna ma.","poem":1},{"lineBreak":true},{"text":"N naxan mɛma,","poem":1},{"lineBreak":true},{"text":"na bata n gaxu ki faɲi!","poem":1},{"lineBreak":true},{"text":"N naxan toma,","poem":1},{"lineBreak":true},{"text":"na bata n kɔntɔfili.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɛkilɛ mi fa n yii,","poem":1},{"lineBreak":true},{"text":"n xuruxurunma gaxuni.","poem":1},{"lineBreak":true},{"text":"N yi ɲinbanna nan mamɛma nun","poem":1},{"lineBreak":true},{"text":"alogo n xa bɔɲɛ xunbeli,","poem":1},{"lineBreak":true},{"text":"koni kɔɛɛn fan bata magaxu ayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Donseen bata rafala,","poem":1},{"lineBreak":true},{"text":"dagine bata yisa,","poem":1},{"lineBreak":true},{"text":"muxune dɔxi e dɛgedeni,","poem":1},{"lineBreak":true},{"text":"e minma.","poem":1},{"lineBreak":true},{"text":"Kuntigine, ɛ keli!","poem":1},{"lineBreak":true},{"text":"Ɛ yɛngɛ so seene yitɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Marigina ito nan falaxi n xa, a naxa,","poem":1},{"lineBreak":true},{"text":"“Sa kantan tina nde ti,","poem":1},{"lineBreak":true},{"text":"a na naxan to, a na fala i xa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xa a yɛngɛ so wontorone to,","poem":1},{"lineBreak":true},{"text":"soone naxanye bandunma,","poem":1},{"lineBreak":true},{"text":"soo ragine dɔxi sofanle fari,","poem":1},{"lineBreak":true},{"text":"ndee fan dɔxi ɲɔgɔmɛne fari,","poem":1},{"lineBreak":true},{"text":"a xa a liga a yeren ma ki faɲi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kantan tiin xa sɔnxɔ, a naxa,","poem":1},{"lineBreak":true},{"text":"“N Marigina, n tixi yinna xuntagi fɛriɲɛn gbɛn!","poem":1},{"lineBreak":true},{"text":"N nan n ma kantan tideni kɔɛna ngaan na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɛ a mato, xɛmɛna nde fama yɛngɛ so wontoron kui","poem":1},{"lineBreak":true},{"text":"soo firin naxan bandunma.","poem":1},{"lineBreak":true},{"text":"Na yi a xuini te, a naxa,","poem":1},{"lineBreak":true},{"text":"‘Babilɔn taan bata kala!","poem":1},{"lineBreak":true},{"text":"A bata kala!","poem":1},{"lineBreak":true},{"text":"E ala sawurane birin bata bira","poem":1},{"lineBreak":true},{"text":"e xuya ayi bɔxɔni.’ ”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N ma yamana,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxan bata bɔnbɔ","poem":1},{"lineBreak":true},{"text":"alo murutun lonna ma,","poem":1},{"lineBreak":true},{"text":"n na nan mɛxi Alatala Sɛnbɛn Birin Kanna ra, Isirayilaa Ala,","poem":1},{"lineBreak":true},{"text":"n yi a rali ɛ ma.","poem":1}]},{"type":"heading","content":["Falana Edɔn yamanan xili ma"]},{"type":"verse","number":11,"content":["Waliyiya falan ni i ra Duma taan xili ma.",{"text":"Xuina nde minima Seyiri yamanani,","poem":1},{"lineBreak":true},{"text":"a naxa, “Kantan tina, kɔɛɛn di?","poem":1},{"lineBreak":true},{"text":"Kantan tina kɔɛɛn di?”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kantan tiin yi a yabi,","poem":1},{"lineBreak":true},{"text":"a naxa, “Xɔtɔnna a lima nɛn,","poem":1},{"lineBreak":true},{"text":"kɔɛɛn fan yi so.","poem":1},{"lineBreak":true},{"text":"Xa i mɔn waxi maxɔdinna ti feni,","poem":1},{"lineBreak":true},{"text":"maxɔdinna ti.","poem":1},{"lineBreak":true},{"text":"Waxati gbɛtɛ, i mɔn yi fa.”","poem":1}]},{"type":"heading","content":["Alaa falana Arabi xili ma"]},{"type":"verse","number":13,"content":["Waliyiya falan ni i ra Arabi yamanan xili ma.",{"text":"Ɛ xima nɛn Arabi burunna ra,","poem":1},{"lineBreak":true},{"text":"Dedan bɔnsɔnna, sigatiine tonbonni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɛ tan Tema kaane,","poem":1},{"lineBreak":true},{"text":"ɛ sa fa igen na muxune xa","poem":1},{"lineBreak":true},{"text":"min xɔnla naxanye ma","poem":1},{"lineBreak":true},{"text":"ɛ fa balon na muxu gixine xa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Muxune bata e gi silanfanna bun","poem":1},{"lineBreak":true},{"text":"silanfanne yi texi e xili ma,","poem":1},{"lineBreak":true},{"text":"xanle bandunxi e xili ma,","poem":1},{"lineBreak":true},{"text":"e gixi yɛngɛn gbalon bun.","poem":1}]},{"type":"verse","number":16,"content":["Marigina ito nan falaxi n xa, a naxa, “Benun ɲɛɛ keden yatɛ, Kedari bɔnsɔnna",{"noteId":19},"binyen birin ɲanma nɛn."]},{"type":"verse","number":17,"content":["Muxu wuyaxi mi fa luma e nii ra e xali wonle yɛ, Kedari yɛngɛsone.” Alatala, Isirayilaa Ala nan na falaxi."]}],"footnotes":[{"noteId":17,"caller":"+","text":"21.1Tonbonna:A Babilɔn nan ma fe falama na ra.","reference":{"chapter":21,"verse":1}},{"noteId":18,"caller":"+","text":"21.2Elan kaane nun Mede kaaneyi Babilɔn kaane xɔyine nan na benun e xa e yɛngɛ, e yi e nɔ.","reference":{"chapter":21,"verse":2}},{"noteId":19,"caller":"+","text":"21.16Kedarifindixi Sumayilaa diin nan na. Na feen sɛbɛxi Dunuɲa Fɔlɔn 25.13 kui.","reference":{"chapter":21,"verse":16}}]},"thisChapterLink":"/api/yal_pbt/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}