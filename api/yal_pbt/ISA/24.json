{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":24,"content":[{"type":"heading","content":["Alatala bɔxɔn birin halagima nɛn"]},{"type":"verse","number":1,"content":[{"text":"Alatala bɔxɔn birin halagima nɛn,","poem":1},{"lineBreak":true},{"text":"a yi a raxɔri.","poem":1},{"lineBreak":true},{"text":"A bɔxɔ xɔnna kalama nɛn,","poem":1},{"lineBreak":true},{"text":"a yi a muxune birin naxuya ayi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na maraɲan ki kedenna nan saraxaraliin nun a yamaan xa,","poem":1},{"lineBreak":true},{"text":"e nun kuntigin nun a walikɛɛn xa,","poem":1},{"lineBreak":true},{"text":"e nun banxi kanna nun a walikɛ ɲaxanla xa,","poem":1},{"lineBreak":true},{"text":"e nun sare matiin nun sare soon xa,","poem":1},{"lineBreak":true},{"text":"e nun doli tongo nun doli soon xa,","poem":1},{"lineBreak":true},{"text":"e nun donla naxan ma","poem":1},{"lineBreak":true},{"text":"e nun seen soma naxan yii.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɔxɔ xɔnna kalama nɛn fefe,","poem":1},{"lineBreak":true},{"text":"a yigenla yi lu","poem":1},{"lineBreak":true},{"text":"amasɔtɔ Alatala bata na fala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɔxɔn sunuxi, a xaraxi.","poem":1},{"lineBreak":true},{"text":"Dunuɲa sigama kalɛ,","poem":1},{"lineBreak":true},{"text":"a muxu gbeene fan yi doyen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Adamadiine bata bɔxɔ xɔnna raharamu.","poem":1},{"lineBreak":true},{"text":"E mi Alaa sariyane suxi,","poem":1},{"lineBreak":true},{"text":"e yi a tɔnne beɲin.","poem":1},{"lineBreak":true},{"text":"E bata habadan layirin kala","poem":1},{"lineBreak":true},{"text":"e nun Ala tagi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanara, Alaa dangan bata bɔxɔ xɔnna suxu,","poem":1},{"lineBreak":true},{"text":"a muxune yi e yulubin yanginna sɔtɔ.","poem":1},{"lineBreak":true},{"text":"A muxune ganma,","poem":1},{"lineBreak":true},{"text":"e wuyaxi mi lu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Manpa nɛnɛn bata xara,","poem":1},{"lineBreak":true},{"text":"manpa binle yi lisi a ra.","poem":1},{"lineBreak":true},{"text":"Naxanye bɔɲɛ yi sɛwaxi,","poem":1},{"lineBreak":true},{"text":"ne wugama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɛwan tanban xuine bata dan,","poem":1},{"lineBreak":true},{"text":"ɲaxaɲaxa xuine bata ɲan,","poem":1},{"lineBreak":true},{"text":"sɛwan bɔlɔn xuine bata dan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Muxune mi fa manpaan minma sigini.","poem":1},{"lineBreak":true},{"text":"Manpane bata xɔlɔ ayi","poem":1},{"lineBreak":true},{"text":"e min muxune dɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taa rabeɲinxin bata kala.","poem":1},{"lineBreak":true},{"text":"Banxine birin nagalixi,","poem":1},{"lineBreak":true},{"text":"muxu yo mi fa nɔɛ soɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Muxune gbelegbelema manpa feen na kirane xɔn.","poem":1},{"lineBreak":true},{"text":"Sɛwan bata findi bɔɲɛ rafɔrɛn na.","poem":1},{"lineBreak":true},{"text":"Ɲaxaɲaxan bata ɲan yamanani.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Banxi xɔnne nan tun fa luxi taani,","poem":1},{"lineBreak":true},{"text":"taan so dɛɛn bata kala,","poem":1},{"lineBreak":true},{"text":"a biraxin yi lu na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A ligama na kii nin bɔxɔni siyane tagi,","poem":1},{"lineBreak":true},{"text":"se wuyaxi mi luma,","poem":1},{"lineBreak":true},{"text":"alo oliwi bogine na yelin malanɲɛ,","poem":1},{"lineBreak":true},{"text":"alo manpa binle xɔri bolon waxatini.","poem":1}]},{"type":"heading","content":["Dunuɲa muxune ɲaxanma"]},{"type":"verse","number":14,"content":[{"text":"Naxanye luxi e nii ra,","poem":1},{"lineBreak":true},{"text":"ne e xuini tema,","poem":1},{"lineBreak":true},{"text":"e sɔnxɔ sɛwani e Alatalaa binyen nali.","poem":1},{"lineBreak":true},{"text":"E gbelegbelema ɲaxaɲaxani keli sogegododen binni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"E naxa,","poem":1},{"lineBreak":true},{"text":"“Sogeteden binna yamanane,","poem":1},{"lineBreak":true},{"text":"ɛ Alatala binya!","poem":1},{"lineBreak":true},{"text":"Ɛ Alatala xinla tantun","poem":1},{"lineBreak":true},{"text":"fɔxɔ ige tagi bɔxɔne yi,","poem":1},{"lineBreak":true},{"text":"Isirayilaa Ala!”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nxu bɛti xuine mɛma nɛn bɔxɔn danne birin yi:","poem":1},{"lineBreak":true},{"text":"“Binyena Ala tinxinxin xa!”","poem":1},{"lineBreak":true},{"text":"Koni n tan naxa,","poem":1},{"lineBreak":true},{"text":"“N bata lɔ ayi, n bata lɔ ayi,","poem":1},{"lineBreak":true},{"text":"gbalona n xa!","poem":1},{"lineBreak":true},{"text":"Yanfantenne yanfan soma!","poem":1},{"lineBreak":true},{"text":"Yanfana!","poem":1},{"lineBreak":true},{"text":"Yanfantenne yanfan soma!”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gaxun nun yili gbeen nun luti ratixine","poem":1},{"lineBreak":true},{"text":"ɛ tan bɔxɔ xɔnna muxune yɛɛ ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Naxan na a gi gbelegbele xuiin bun gaxuni,","poem":1},{"lineBreak":true},{"text":"na yi sin yinla ra.","poem":1},{"lineBreak":true},{"text":"Xa naxan te yinla ra,","poem":1},{"lineBreak":true},{"text":"na yi a suxu lutin na.","poem":1},{"lineBreak":true},{"text":"Kore xɔnna dɛɛne birin nabima nɛn","poem":1},{"lineBreak":true},{"text":"tulen yi fa,","poem":1},{"lineBreak":true},{"text":"bɔxɔ xɔnna bunne birin yi xuruxurun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bɔxɔ xɔnni bɔma nɛn,","poem":1},{"lineBreak":true},{"text":"a xuya ayi, a yolon,","poem":1},{"lineBreak":true},{"text":"bɔxɔn bata yimaxa fefe!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bɔxɔn dingenma ayi nɛn","poem":1},{"lineBreak":true},{"text":"alo dɔlɔ minna,","poem":1},{"lineBreak":true},{"text":"a tintin alo gagen foye gbeen bun.","poem":1},{"lineBreak":true},{"text":"A bira a Ala matandine goronna bun","poem":1},{"lineBreak":true},{"text":"a mi fa nɔɛ kelɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"Alatala sɛnbɛma ganla saranma e kɛwanle ra nɛn","poem":1},{"lineBreak":true},{"text":"naxanye bɔxɔn nun kuyen lan tagini","poem":1},{"lineBreak":true},{"text":"e nun bɔxɔ xɔnni ito mangane.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"E malanma nɛn yili gbeen na","poem":1},{"lineBreak":true},{"text":"alo kasorasane.","poem":1},{"lineBreak":true},{"text":"E balan kasoon na.","poem":1},{"lineBreak":true},{"text":"Waxati xunkuye na dangu,","poem":1},{"lineBreak":true},{"text":"e fa e dɛntɛgɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kiken nun sogen yagima nɛn.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ Alatala Sɛnbɛn Birin Kanna","poem":1},{"lineBreak":true},{"text":"findima nɛn mangan na Yerusalɛn yi,","poem":1},{"lineBreak":true},{"text":"Siyon geyaan fari.","poem":1},{"lineBreak":true},{"text":"A binyen yi makɛnɛn taan fonne birin yɛtagi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}