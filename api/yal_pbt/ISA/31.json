{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":31,"content":[{"type":"heading","content":["Isirayila kaane nama e yigi sa Misiran kaane yi"]},{"type":"verse","number":1,"content":[{"text":"Gbalon ne xa","poem":1},{"lineBreak":true},{"text":"naxanye sigama Misiran yi maliin fendeni,","poem":1},{"lineBreak":true},{"text":"naxanye xaxili tixi soone ra,","poem":1},{"lineBreak":true},{"text":"naxanye e yigi sama yɛngɛ so wontorone yi,","poem":1},{"lineBreak":true},{"text":"bayo e wuya,","poem":1},{"lineBreak":true},{"text":"e nun soo ragine,","poem":1},{"lineBreak":true},{"text":"bayo e sɛnbɛn gbo,","poem":1},{"lineBreak":true},{"text":"koni e mi e yɛɛ rafindima Isirayilaa Ala Sariɲanxin ma,","poem":1},{"lineBreak":true},{"text":"e mi Alatala fenma!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anu, a tan fan fe kolon,","poem":1},{"lineBreak":true},{"text":"a nɔɛ gbalon nafɛ nɛn.","poem":1},{"lineBreak":true},{"text":"A mi a falan maxɛtɛma.","poem":1},{"lineBreak":true},{"text":"A kelima nɛn muxu ɲaxine yamaan xili ma,","poem":1},{"lineBreak":true},{"text":"hakɛ kanne mali muxune.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Misiran kaane findixi adamadiine nan na,","poem":1},{"lineBreak":true},{"text":"Ala mi e ra.","poem":1},{"lineBreak":true},{"text":"E soone mi findixi niin xan na,","poem":1},{"lineBreak":true},{"text":"subene nan tun e ra.","poem":1},{"lineBreak":true},{"text":"Alatala na a yiini te naxan xili ma,","poem":1},{"lineBreak":true},{"text":"naxan na na kanna mali,","poem":1},{"lineBreak":true},{"text":"na salaxunma nɛn,","poem":1},{"lineBreak":true},{"text":"a fan naxan malima,","poem":1},{"lineBreak":true},{"text":"na kanna yi bira,","poem":1},{"lineBreak":true},{"text":"e firinna birin yi halagi e bode xɔn.","poem":1}]},{"type":"heading","content":["Marigin Yerusalɛn kantanma nɛn"]},{"type":"verse","number":4,"content":["Alatala bata a fala n xa, a naxa,",{"text":"“N tan Alatala Sɛnbɛn Birin Kanna godoma nɛn","poem":1},{"lineBreak":true},{"text":"n yi yɛngɛn so Siyon geyaan fari","poem":1},{"lineBreak":true},{"text":"e nun a yire matexine yi","poem":1},{"lineBreak":true},{"text":"alo yatan wurundunma a se suxin ma kii naxan yi,","poem":1},{"lineBreak":true},{"text":"alo yata sɛnbɛmaan na xuruseen suxu.","poem":1},{"lineBreak":true},{"text":"Hali xuruse rabane birin keli a xili ma,","poem":1},{"lineBreak":true},{"text":"a mi gaxuma e sɔnxɔ sɔnxɔn yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"hali e to wuya,","poem":1},{"lineBreak":true},{"text":"a mi tunnaxɔlɔma a ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna Yerusalɛn kantanma nɛn,","poem":1},{"lineBreak":true},{"text":"alo xɔliin naxanye e firifirima e tɛɛn xun ma a kantandeni.","poem":1},{"lineBreak":true},{"text":"A a kantanma nɛn,","poem":1},{"lineBreak":true},{"text":"a yi a xunba.","poem":1},{"lineBreak":true},{"text":"A a ratangama nɛn,","poem":1},{"lineBreak":true},{"text":"a yi a xɔrɔya.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ tan Isirayila kaane,","poem":1},{"lineBreak":true},{"text":"ɛ xun xɛtɛ a ma,","poem":1},{"lineBreak":true},{"text":"ɛ murutɛxi a tan naxan ma fefe!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"ɛ birin ɛ mɛma nɛn ɛ suxure gbeti daxine","poem":1},{"lineBreak":true},{"text":"nun a xɛma daxine ra,","poem":1},{"lineBreak":true},{"text":"ɛ tan yulubitɔne yii fɔxɔne.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Asiriya kaane faxama nɛn silanfanna ra","poem":1},{"lineBreak":true},{"text":"naxan mi findixi muxun gbeen na.","poem":1},{"lineBreak":true},{"text":"Silanfanna naxan mi fataxi adamadi yo ra,","poem":1},{"lineBreak":true},{"text":"na e raxɔrima nɛn.","poem":1},{"lineBreak":true},{"text":"E gima nɛn silanfanna bun,","poem":1},{"lineBreak":true},{"text":"e banxulanne yi findi konyine ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naxan e kantanma, na gaxuxin yi a gi.","poem":1},{"lineBreak":true},{"text":"E kuntigine gaxuma nɛn","poem":1},{"lineBreak":true},{"text":"e na e yaxune taxamasenna to.","poem":1},{"lineBreak":true},{"text":"Alatalaa falan nan na ra","poem":1},{"lineBreak":true},{"text":"naxan ma tɛɛn dɛgɛma Siyon yi,","poem":1},{"lineBreak":true},{"text":"sulun tɛɛn","poem":1},{"noteId":23},{"text":"naxan yii Yerusalɛn yi.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"31.9Sulun tɛɛnmɔn falama yirena nde yi fa fala “Furu tɛɛna.”","reference":{"chapter":31,"verse":9}}]},"thisChapterLink":"/api/yal_pbt/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}