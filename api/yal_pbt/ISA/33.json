{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":33,"content":[{"type":"heading","content":["Gbalon halagi tiin xa"]},{"type":"verse","number":1,"content":[{"text":"Gbaloni i xa,","poem":1},{"lineBreak":true},{"text":"i tan naxan halagin tima","poem":1},{"lineBreak":true},{"text":"i tan naxan munma halagin sɔtɔ singen,","poem":1},{"lineBreak":true},{"text":"i tan naxan bonne yanfama","poem":1},{"lineBreak":true},{"text":"muxe munma i tan naxan yanfa singen!","poem":1},{"lineBreak":true},{"text":"I na yelin halagin tiyɛ waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"i fan yi halagi.","poem":1},{"lineBreak":true},{"text":"I na yanfantenyaan dan waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"muxune yi i fan yanfa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala, hinan nxu ra!","poem":1},{"lineBreak":true},{"text":"Nxu xaxili tixi i tan nan na.","poem":1},{"lineBreak":true},{"text":"Findi nxu fangan na xɔtɔn yo xɔtɔn,","poem":1},{"lineBreak":true},{"text":"i nxu rakisi tɔrɔ waxatini!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siyane na i xuiin mɛ,","poem":1},{"lineBreak":true},{"text":"e yi e gi.","poem":1},{"lineBreak":true},{"text":"I nɛɛn fa keli,","poem":1},{"lineBreak":true},{"text":"yamanane muxune bata xuya ayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛ tan siyane,","poem":1},{"lineBreak":true},{"text":"ɛ seen naxanye tongoxi yɛngɛni,","poem":1},{"lineBreak":true},{"text":"muxune bata fu na ma","poem":1},{"lineBreak":true},{"text":"alo tuguminne na so.","poem":1},{"lineBreak":true},{"text":"Muxune dutunma ne ma","poem":1},{"lineBreak":true},{"text":"alo suɲɛ sɛtɛna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala na feene birin xun ma","poem":1},{"lineBreak":true},{"text":"bayo a dɔxi kore xɔnna ma.","poem":1},{"lineBreak":true},{"text":"A bata sariyan nun tinxinna raso Siyon taan yiren birin yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I tan, Alatalaa yamana,","poem":1},{"lineBreak":true},{"text":"i luma nɛn makantanni.","poem":1},{"lineBreak":true},{"text":"Xaxilimayaan nun Ala kolonna findixi kisin nan na,","poem":1},{"lineBreak":true},{"text":"e nun Marigin binyana","poem":1},{"lineBreak":true},{"text":"na nan findixi i ya nafunla ra.","poem":1}]},{"type":"heading","content":["Ala kelima nɛn yaxune xili ma"]},{"type":"verse","number":7,"content":[{"text":"Sofa wɛkilɛxine nan gbelegbele xui ito ra kirane xɔn.","poem":1},{"lineBreak":true},{"text":"Bɔɲɛ xunbenla rali muxune yi xɛtɛ wugɛ xɔlɛni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kirane bata rabeɲin,","poem":1},{"lineBreak":true},{"text":"muxu yo mi fa danguma kirane xɔn.","poem":1},{"lineBreak":true},{"text":"Yaxun bata layirin kala,","poem":1},{"lineBreak":true},{"text":"a yi taane raɲaxu,","poem":1},{"lineBreak":true},{"text":"a mi muxu yo binyaxi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yamanan bata lu sununi,","poem":1},{"lineBreak":true},{"text":"a kalama.","poem":1},{"lineBreak":true},{"text":"Liban yamanan bata yagi,","poem":1},{"lineBreak":true},{"text":"a fɔtɔnna bata xara.","poem":1},{"lineBreak":true},{"text":"Sarɔn mɛrɛmɛrɛn luxi","poem":1},{"lineBreak":true},{"text":"alo tonbonna,","poem":1},{"lineBreak":true},{"text":"Basan nun Karemele yamanane wudine dɛɛne yi yolon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatala naxa,","poem":1},{"lineBreak":true},{"text":"“Iki, n bata keli.","poem":1},{"lineBreak":true},{"text":"Iki, n na n ma binyen mayitama nɛn.","poem":1},{"lineBreak":true},{"text":"Iki, n na n ma fe yitema nɛn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛ feen naxanye yitɔnma,","poem":1},{"lineBreak":true},{"text":"ne luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo se dagina hanma sɛxɛna.","poem":1},{"lineBreak":true},{"text":"Ɛ yɛtɛɛn yengin yi findi tɛɛn na","poem":1},{"lineBreak":true},{"text":"naxan ɛ raxɔrima.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siyane ganma nɛn","poem":1},{"lineBreak":true},{"text":"e lu alo xuben sulun tɛɛni,","poem":1},{"noteId":24},{"lineBreak":true},{"text":"alo tansinne na masɛgɛ,","poem":1},{"lineBreak":true},{"text":"e gan.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ɛ tan naxanye makuya,","poem":1},{"lineBreak":true},{"text":"ɛ tuli mati n naxan ligaxi.","poem":1},{"lineBreak":true},{"text":"Ɛ tan naxanye maso,","poem":1},{"lineBreak":true},{"text":"ɛ n sɛnbɛn yatɛn kolon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yulubitɔne bata gaxu Siyon yi,","poem":1},{"lineBreak":true},{"text":"xuruxurunna bata so Ala kolontarene yi.","poem":1},{"lineBreak":true},{"text":"E maxɔdinna tima, e naxa,","poem":1},{"lineBreak":true},{"text":"“Nde luyɛ halagi tɛɛni ito dɛxɔn en yɛ?","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ luyɛ habadan tɛɛ wolonni ito dɛxɔn en yɛ?”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fɔ naxan sigan tima tinxinni,","poem":1},{"lineBreak":true},{"text":"a ɲɔndin fala,","poem":1},{"lineBreak":true},{"text":"naxan a mɛma tɔnɔne ra","poem":1},{"lineBreak":true},{"text":"naxanye sɔtɔxi gbaloni,","poem":1},{"lineBreak":true},{"text":"naxan mi tinma dimi yi seen nasuxɛ mayifuni,","poem":1},{"lineBreak":true},{"text":"a tunla ba muxune ra","poem":1},{"lineBreak":true},{"text":"naxanye faxa ti feene yitɔnma,","poem":1},{"lineBreak":true},{"text":"a yɛɛn ba fe ɲaxine ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Na kanna fe luma nɛn","poem":1},{"lineBreak":true},{"text":"alo a na dɔxɔ yire matexini,","poem":1},{"lineBreak":true},{"text":"geyaan faran makantanxin yi findi a luxunden na.","poem":1},{"lineBreak":true},{"text":"A donseen nun igen mi dasama.","poem":1}]},{"type":"heading","content":["Yerusalɛn yi xunba"]},{"type":"verse","number":17,"content":[{"text":"I mangan toma nɛn i yɛɛn na a nɔrɔ gbeeni,","poem":1},{"lineBreak":true},{"text":"i yi yamanan danne to masigaxi pon!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nayi, i mirima nɛn i ya ɲaxankata danguxine ma,","poem":1},{"lineBreak":true},{"text":"i yi a fala, i naxa,","poem":1},{"lineBreak":true},{"text":"“Na kuntigine minɛn","poem":1},{"lineBreak":true},{"text":"naxanye yi mudun nasuxuma","poem":1},{"lineBreak":true},{"text":"e nun naxanye yi makantan yinna xun matoma a ra?”","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I mi fa na yama wasoxin toma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"xɔɲɛn naxanye fala xuine mi nɔɛ famunɲɛ,","poem":1},{"lineBreak":true},{"text":"xɔɲɛn naxanye fala xui mi mɛma a faɲin na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Siyon taan mato,","poem":1},{"lineBreak":true},{"text":"en sanle rabama taan naxan yi.","poem":1},{"lineBreak":true},{"text":"Ɛ yɛɛn tima nɛn Yerusalɛn ra,","poem":1},{"lineBreak":true},{"text":"bɔɲɛ xunbeli yirena,","poem":1},{"lineBreak":true},{"text":"a lu alo bubun naxan mi fa wayanma,","poem":1},{"lineBreak":true},{"text":"naxan wudiye mi fa talama","poem":1},{"lineBreak":true},{"text":"naxan lutiye mi fa fulunma sɔnɔn.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatala a yɛtɛ yitama en na Ala Sɛnbɛmaan na mɛnna nin.","poem":1},{"lineBreak":true},{"text":"Xudene nun baa gbeene luma nɛn mɛnni,","poem":1},{"lineBreak":true},{"text":"yɛngɛ so kunkine mi danguɛ dɛnaxan yi.","poem":1},{"lineBreak":true},{"text":"Kunki gbeene mi danguɛ na mumɛ!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amasɔtɔ Alatala nan en ma kitisaan na.","poem":1},{"lineBreak":true},{"text":"Alatala nan en ma sariyasaan na.","poem":1},{"lineBreak":true},{"text":"Alatala nan en ma mangan na.","poem":1},{"lineBreak":true},{"text":"A tan nan en nakisima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Koni yaxune luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo kunkin naxan lutiye bata fulun,","poem":1},{"lineBreak":true},{"text":"foyen kunkin nasigama dugin naxanye xɔn","poem":1},{"lineBreak":true},{"text":"ne mi fa xidixi sɔnɔn,","poem":1},{"lineBreak":true},{"text":"ne fan singanxi wudi kuyen naxan na,","poem":1},{"lineBreak":true},{"text":"na mi fa suxi.","poem":1},{"lineBreak":true},{"text":"Nayi, e se tongoxi gbeen yɛngɛni,","poem":1},{"lineBreak":true},{"text":"na yitaxunma nɛn","poem":1},{"lineBreak":true},{"text":"hali sankalatɔne e gbeen xalima nɛn.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nayi, Yerusalɛn kaa yo mi a falɛ,","poem":1},{"lineBreak":true},{"text":"e naxa, “N mi yalan.”","poem":1},{"lineBreak":true},{"text":"Na taan muxune hakɛne mafeluma nɛn.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"33.12Sulun tɛɛnmɔn falama yirena nde yi fa fala “Furu tɛɛna.”","reference":{"chapter":33,"verse":12}}]},"thisChapterLink":"/api/yal_pbt/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}