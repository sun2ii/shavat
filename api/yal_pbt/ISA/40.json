{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":40,"content":[{"type":"heading","content":["Alaa yamaan xunba fena"]},{"type":"verse","number":1,"content":[{"text":"Ɛ Ala naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ n ma yamaan madɛndɛn,","poem":1},{"lineBreak":true},{"text":"ɛ a madɛndɛn!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ Yerusalɛn kaane ralimaniya,","poem":1},{"lineBreak":true},{"text":"ɛ a rali e ma,","poem":1},{"lineBreak":true},{"text":"a e ɲaxankata wanle bata ɲan.","poem":1},{"lineBreak":true},{"text":"A e bata mafelu e hakɛn na,","poem":1},{"lineBreak":true},{"text":"e bata yelin e yulubine saranna sɔtɛ","poem":1},{"lineBreak":true},{"text":"Alatala yii han dɔxɔ firin!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Muxuna nde xuiin minima, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ kirani tɔn Alatala yɛɛ ra tonbonni,","poem":1},{"lineBreak":true},{"text":"ɛ kira tinxinxin nafala en ma Ala xa burunna ra!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛ folone birin naxutu,","poem":1},{"lineBreak":true},{"text":"ɛ geyane nun yire matexine birin wuru.","poem":1},{"lineBreak":true},{"text":"Yire tintinxine yi matinxin,","poem":1},{"lineBreak":true},{"text":"gɛmɛ yirene yi findi lantane ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nayi, Alatalaa binyen minima nɛn kɛnɛnni,","poem":1},{"lineBreak":true},{"text":"daala birin yi a to!”","poem":1},{"lineBreak":true},{"text":"Alatala dɛ xuiin nan na ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muxuna nde a falama,","poem":1},{"lineBreak":true},{"text":"a naxa, “I xui ramini!”","poem":1},{"lineBreak":true},{"text":"N yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“N xa nanse fala?”","poem":1},{"lineBreak":true},{"text":"A naxa, “Adamadiine birin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo sɛxɛna","poem":1},{"lineBreak":true},{"text":"e binyen birin yi lu alo se fugena.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala dɛ foyen na dangu sɛxɛne fari,","poem":1},{"lineBreak":true},{"text":"e xarama nɛn,","poem":1},{"lineBreak":true},{"text":"e fugene yi yolon.","poem":1},{"lineBreak":true},{"text":"Yamaan luxi nɛn alo sɛxɛna yati!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sɛxɛne xarama nɛn,","poem":1},{"lineBreak":true},{"text":"e fugene yi yolon,","poem":1},{"lineBreak":true},{"text":"koni en ma Alaa falan luma nɛn habadan.”","poem":1}]},{"type":"heading","content":["Xibaru faɲina fe"]},{"type":"verse","number":9,"content":[{"text":"Ɛ tan Siyon kaan naxanye sa xibaru faɲin xɛrayani bama,","poem":1},{"lineBreak":true},{"text":"ɛ te geya matexin fari,","poem":1},{"lineBreak":true},{"text":"ɛ xuini te han,","poem":1},{"lineBreak":true},{"text":"ɛ tan Yerusalɛn kaan naxanye sa xibaru faɲin xɛrayani bama.","poem":1},{"lineBreak":true},{"text":"Ɛ xuini te, ɛ nama gaxu.","poem":1},{"lineBreak":true},{"text":"Ɛ a fala Yuda yamanan taane xa,","poem":1},{"lineBreak":true},{"text":"ɛ naxa, “Ɛ Ala ni i ra!”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A mato,","poem":1},{"lineBreak":true},{"text":"Marigina Alatala fama fangani.","poem":1},{"lineBreak":true},{"text":"A mangayaan nabama a sɛnbɛni.","poem":1},{"lineBreak":true},{"text":"A fama a yama xunbaxin na,","poem":1},{"lineBreak":true},{"text":"a naxan sɔtɔxi a kɔntɔnna ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A a yamaan masuxuma","poem":1},{"lineBreak":true},{"text":"alo xuruse rabana.","poem":1},{"lineBreak":true},{"text":"A yɛxɛɛ diine tongoma nɛn a yii,","poem":1},{"lineBreak":true},{"text":"a yi e xali a yii kanke,","poem":1},{"lineBreak":true},{"text":"a ti e ngane yɛɛ ra a fanni.","poem":1}]},{"type":"heading","content":["Ala dangu seen birin na"]},{"type":"verse","number":12,"content":[{"text":"Nde fɔxɔ igene saxi a yiin kui,","poem":1},{"lineBreak":true},{"text":"a yi e maliga,","poem":1},{"lineBreak":true},{"text":"a kore xɔnna danne maliga a yiin na?","poem":1},{"lineBreak":true},{"text":"Nde bɔxɔn bɛndɛn yatɛxi deben kui,","poem":1},{"lineBreak":true},{"text":"a geyane yiliga sikeela ra,","poem":1},{"lineBreak":true},{"text":"a yire matexine binyan yatɛn kolon ligaseen xɔn?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nde Alatala miriyane kolon?","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ findɛ a kawandi muxun na,","poem":1},{"lineBreak":true},{"text":"a yi a rakɔta?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala nde maxɔdinxi a maxadi feen na,","poem":1},{"lineBreak":true},{"text":"alogo a xa xaxinla sɔtɔ?","poem":1},{"lineBreak":true},{"text":"Nde a xaranxi kiti kɛndɛ saan ma?","poem":1},{"lineBreak":true},{"text":"Nde a xaranxi fekolonna ma?","poem":1},{"lineBreak":true},{"text":"Nde xaxilimayaan kiraan yitaxi a ra?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Siyane luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo igen dindinna palanna kui.","poem":1},{"lineBreak":true},{"text":"E mi yatɛxi se ra","poem":1},{"lineBreak":true},{"text":"alo gbangbanna na sa sikeela fari.","poem":1},{"lineBreak":true},{"text":"Fɔxɔ ige tagi bɔxɔne yelefu","poem":1},{"lineBreak":true},{"text":"alo gbangbanna naxan tema.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Liban yamanan subene birin xurun saraxan na","poem":1},{"lineBreak":true},{"text":"naxan yi daxa nun a ba Ala xa,","poem":1},{"lineBreak":true},{"text":"a wudine mi wuya","poem":1},{"lineBreak":true},{"text":"naxanye findɛ saraxa gan tɛɛn yegene ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sese mi siyane ra a yɛɛ ra yi!","poem":1},{"lineBreak":true},{"text":"Ala ne yatɛxi fufafuun nan na.","poem":1},{"lineBreak":true},{"text":"A yigenla fisa e xa!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ɛ waxi Ala sa feni nde ma?","poem":1},{"lineBreak":true},{"text":"Ɛ sawuran mundun yitɛ","poem":1},{"lineBreak":true},{"text":"e nun naxan maliga?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Xabun nan sawuran nafalama suxuren na,","poem":1},{"lineBreak":true},{"text":"xɛma wanla yi xɛmaan sa a ma,","poem":1},{"lineBreak":true},{"text":"a yi kɔɛ bira yɔlɔnxɔn wure gbeti daxine rafala.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yiigelitɔɔn naxan mi nɔɛ na sɔtɛ a gbee ala xa,","poem":1},{"lineBreak":true},{"text":"na kanna wudi xɔdɛxɛn nan sugandima,","poem":1},{"lineBreak":true},{"text":"a yi xabu kesuxin fen,","poem":1},{"lineBreak":true},{"text":"na yi suxuren nafala a xa","poem":1},{"lineBreak":true},{"text":"naxan mi kalama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ɛ mi a kolon ba?","poem":1},{"lineBreak":true},{"text":"Ɛ mi a mɛxi ba?","poem":1},{"lineBreak":true},{"text":"A mi ralixi ɛ ma ba,","poem":1},{"lineBreak":true},{"text":"xabu a fɔlɔni?","poem":1},{"lineBreak":true},{"text":"Bɔxɔn bɛtɛn saxi kii naxan yi,","poem":1},{"lineBreak":true},{"text":"ɛ munma na famu ba?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A tan nan dɔxi bɔxɔ xɔri digilinxin xun ma,","poem":1},{"lineBreak":true},{"text":"muxune fan luxi a yɛɛ ra yi nɛn","poem":1},{"lineBreak":true},{"text":"alo suɲɛne.","poem":1},{"lineBreak":true},{"text":"A kore xɔnni fulunma","poem":1},{"lineBreak":true},{"text":"alo dugi yelefuxina xunna soon na,","poem":1},{"lineBreak":true},{"text":"alo gagena a dɔxɔden na.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A tan nan kuntigine sɛnbɛn kalama,","poem":1},{"lineBreak":true},{"text":"e lu fuyan,","poem":1},{"lineBreak":true},{"text":"a yi bɔxɔ xɔnna kitisane lu fuu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"E luxi nɛn alo sansina.","poem":1},{"lineBreak":true},{"text":"E nɛɛn fa si tun,","poem":1},{"lineBreak":true},{"text":"e na woli xɛɛn ma tun,","poem":1},{"lineBreak":true},{"text":"salen yɛtɛ mi e binle ma singen,","poem":1},{"lineBreak":true},{"text":"Alaa foyen yi fa e ma, e xara,","poem":1},{"lineBreak":true},{"text":"wuluwunla yi e xali alo se dagina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ala sariɲanxin naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ n misalima nde ma,","poem":1},{"lineBreak":true},{"text":"nxu nun naxan lan?”","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ɛ yɛɛne rate kore,","poem":1},{"lineBreak":true},{"text":"ɛ a mato!","poem":1},{"lineBreak":true},{"text":"Nde na seene daxi?","poem":1},{"lineBreak":true},{"text":"Nde e ganla dɛfexin naminima,","poem":1},{"lineBreak":true},{"text":"a yi e birin xili e xinla ra?","poem":1},{"lineBreak":true},{"text":"Fata a fanga gbeen nun a sɛnbɛ magaxuxin na,","poem":1},{"lineBreak":true},{"text":"keden peen mi dasama.","poem":1}]},{"type":"heading","content":["Ala nan fangan fima muxune ma"]},{"type":"verse","number":27,"content":[{"text":"Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"nanfera ɛ a falama,","poem":1},{"lineBreak":true},{"text":"Isirayila yixɛtɛne,","poem":1},{"lineBreak":true},{"text":"nanfera ɛ a falama, ɛ naxa,","poem":1},{"lineBreak":true},{"text":"“Nxɔ kiraan bata luxun Alatala ma,","poem":1},{"lineBreak":true},{"text":"nxɔ Ala mi fa nxu xun mafala kitin sama?”","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"I mi a kolon ba?","poem":1},{"lineBreak":true},{"text":"I mi a mɛxi ba?","poem":1},{"lineBreak":true},{"text":"Alatala nan habadan Ala ra,","poem":1},{"lineBreak":true},{"text":"naxan bɔxɔn danne birin daxi.","poem":1},{"lineBreak":true},{"text":"A mi xadanma, a mi taganma.","poem":1},{"lineBreak":true},{"text":"A xaxilimayaan mi nɔɛ fɛsɛfɛsɛ!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"A fangan fima muxu xadanxine ma,","poem":1},{"lineBreak":true},{"text":"a muxu taganxine sɛnbɛn xun masa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Banxulanne yɛtɛɛn xadanma,","poem":1},{"lineBreak":true},{"text":"e tagan,","poem":1},{"lineBreak":true},{"text":"foningene yi bira xadanni.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Koni naxanye xaxili tixi Alatala ra,","poem":1},{"lineBreak":true},{"text":"ne mɔn sɛnbɛn sɔtɔma nɛn.","poem":1},{"lineBreak":true},{"text":"E tuganma nɛn alo singbinna,","poem":1},{"lineBreak":true},{"text":"e yi e gi, e mi xadan,","poem":1},{"lineBreak":true},{"text":"e lu sigan tiyɛ, e mi tagan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}