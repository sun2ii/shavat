{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":41,"content":[{"type":"heading","content":["Ala nun suxurene fe"]},{"type":"verse","number":1,"content":[{"text":"Ala naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ tan fɔxɔ ige tagi bɔxɔn muxune,","poem":1},{"lineBreak":true},{"text":"ɛ dundu alogo ɛ xa n xuiin namɛ.","poem":1},{"lineBreak":true},{"text":"Ɛ tan yamanane muxune,","poem":1},{"lineBreak":true},{"text":"ɛ wɛkilɛn sɔtɔ,","poem":1},{"lineBreak":true},{"text":"ɛ maso, ɛ falan ti.","poem":1},{"lineBreak":true},{"text":"En kitin sa en tagi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nde muxuna nde rakelixi sogeteden binni,","poem":1},{"noteId":27},{"lineBreak":true},{"text":"a yi a xili,","poem":1},{"lineBreak":true},{"text":"a xa lu tinxinna fɔxɔ ra?","poem":1},{"lineBreak":true},{"text":"Nde siyane soxi a yii","poem":1},{"lineBreak":true},{"text":"a mangane xuru a bun,","poem":1},{"lineBreak":true},{"text":"a silanfanna yi e findi burunburunna ra","poem":1},{"lineBreak":true},{"text":"a xanla yi e findi se dagin na","poem":1},{"lineBreak":true},{"text":"foyen naxan xalima!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A muxune sagatanma yɛngɛni,","poem":1},{"lineBreak":true},{"text":"a mɔn yi dangu bɔɲɛ xunbenli kiraan xɔn","poem":1},{"lineBreak":true},{"text":"a munma yi a sanna ti dɛnaxan yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nde feni itoe rakamalixi,","poem":1},{"lineBreak":true},{"text":"a tan naxan yi mayixɛtɛne maxilima","poem":1},{"lineBreak":true},{"text":"xabu a fɔlɔni?","poem":1},{"lineBreak":true},{"text":"N tan Alatala nan a fɔlɔn na,","poem":1},{"lineBreak":true},{"text":"n mɔn luma nɛn a raɲanni.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fɔxɔ ige tagi bɔxɔne muxune bata a to,","poem":1},{"lineBreak":true},{"text":"e gaxu,","poem":1},{"lineBreak":true},{"text":"bɔxɔn danne muxune xuruxurunma,","poem":1},{"lineBreak":true},{"text":"e birin bata keli, e fama.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Birin a bode malima,","poem":1},{"lineBreak":true},{"text":"birin a falama a lanfaan xa,","poem":1},{"lineBreak":true},{"text":"a naxa, “I wɛkilɛ!”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yii rafalan fan xabun sɛnbɛ soma,","poem":1},{"lineBreak":true},{"text":"naxan wuren malaxunma,","poem":1},{"lineBreak":true},{"text":"na xabun nawɛkilɛma,","poem":1},{"lineBreak":true},{"text":"a yi a fala suxuren nafala kiin ma,","poem":1},{"lineBreak":true},{"text":"a naxa, “A lanxi.”","poem":1},{"lineBreak":true},{"text":"A yi suxuren gbangban","poem":1},{"lineBreak":true},{"text":"alogo a nama bira.","poem":1}]},{"type":"heading","content":["Marigin yi Isirayila xunba"]},{"type":"verse","number":8,"content":[{"text":"Koni ɛ tan, Isirayila yixɛtɛne,","poem":1},{"lineBreak":true},{"text":"n ma walikɛne,","poem":1},{"lineBreak":true},{"text":"Yaxuba yixɛtɛne,","poem":1},{"lineBreak":true},{"text":"n naxanye sugandixi,","poem":1},{"lineBreak":true},{"text":"ɛ tan Iburahima bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"n xɔyina,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"n sa ɛ tan nan fenxi bɔxɔn danne ra,","poem":1},{"lineBreak":true},{"text":"n sa ɛ tan nan xilixi bɔxɔn tongonne ra,","poem":1},{"lineBreak":true},{"text":"n na a falaxi ɛ tan nan xa, n naxa,","poem":1},{"lineBreak":true},{"text":"“N ma walikɛɛn nan ɛ ra,","poem":1},{"lineBreak":true},{"text":"n bata ɛ sugandi,","poem":1},{"lineBreak":true},{"text":"n mi n mɛxi ɛ ra.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nayi, ɛ nama gaxu","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n na ɛ xɔn.","poem":1},{"lineBreak":true},{"text":"Ɛ nama kɔntɔfili,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ ɛ Ala nan n na.","poem":1},{"lineBreak":true},{"text":"N na ɛ sɛnbɛn gboma ayi nɛn,","poem":1},{"lineBreak":true},{"text":"n yi ɛ mali,","poem":1},{"lineBreak":true},{"text":"n yi ti ɛ bun sɛnbɛn nun tinxinni.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naxanye birin yi kelixi ɛ xili ma,","poem":1},{"lineBreak":true},{"text":"ne yagima nɛn e xun sin!","poem":1},{"lineBreak":true},{"text":"Naxanye yɛngɛn nakelixi ɛ xili ma,","poem":1},{"lineBreak":true},{"text":"ne luma nɛn fufafu, e raxɔri.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɛ ɛ yɛngɛfane fenma nɛn,","poem":1},{"lineBreak":true},{"text":"koni ɛ mi fa e toma sɔnɔn!","poem":1},{"lineBreak":true},{"text":"Naxanye yi ɛ yɛngɛma,","poem":1},{"lineBreak":true},{"text":"ne luma nɛn fuu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amasɔtɔ n tan nan Alatala ra,","poem":1},{"lineBreak":true},{"text":"ɛ Ala,","poem":1},{"lineBreak":true},{"text":"naxan ɛ yiifari ma yiin suxuma,","poem":1},{"lineBreak":true},{"text":"n yi a fala ɛ xa,","poem":1},{"lineBreak":true},{"text":"n naxa, “Ɛ nama gaxu,","poem":1},{"lineBreak":true},{"text":"n tan nan ɛ malima.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatalaa falan ni ito ra, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ tan Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye luxi alo kunla,","poem":1},{"lineBreak":true},{"text":"ɛ nama gaxu,","poem":1},{"lineBreak":true},{"text":"ɛ tan Isirayila muxudine,","poem":1},{"lineBreak":true},{"text":"n tan nan ɛ malima,","poem":1},{"lineBreak":true},{"text":"n tan Isirayilaa Ala Sariɲanxin naxan ɛ xunbama.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A mato, n bata i findi ɲingen xɛɛ ra bɔnbɔ seen na","poem":1},{"lineBreak":true},{"text":"wure ɲin wuyaxin naxan ma","poem":1},{"lineBreak":true},{"text":"naxanye nɛnɛ a ra, e ɲɔɛ raminixi.","poem":1},{"lineBreak":true},{"text":"I geyane wuruma nɛn,","poem":1},{"lineBreak":true},{"text":"i yi e raxuya ayi,","poem":1},{"lineBreak":true},{"text":"i yi yire matexine liga","poem":1},{"lineBreak":true},{"text":"alo se dagina.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I e yifema nɛn,","poem":1},{"lineBreak":true},{"text":"foyen yi siga e ra,","poem":1},{"lineBreak":true},{"text":"wuluwulu gbeen yi e raxuya ayi.","poem":1},{"lineBreak":true},{"text":"I tan ɲaxanma nɛn Alatala yi,","poem":1},{"lineBreak":true},{"text":"i yi i kanba Isirayilaa Ala Sariɲanxini.”","poem":1}]},{"type":"heading","content":["Tonbonna findima ige yiren na"]},{"type":"verse","number":17,"content":[{"text":"Yiigelitɔne nun tɔrɔ muxune igen fenma,","poem":1},{"lineBreak":true},{"text":"koni sese mi na!","poem":1},{"lineBreak":true},{"text":"Min xɔnla bata e lɛnna maxara.","poem":1},{"lineBreak":true},{"text":"Koni n tan,","poem":1},{"lineBreak":true},{"text":"Alatala, n na e yabima nɛn,","poem":1},{"lineBreak":true},{"text":"n tan, Isirayilaa Ala,","poem":1},{"lineBreak":true},{"text":"n mi e rabeɲinɲɛ mumɛ!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N baa igen nafama nɛn yire matexi magenle fari,","poem":1},{"lineBreak":true},{"text":"n yi ige xunne ramini mɛrɛmɛrɛne tagi,","poem":1},{"lineBreak":true},{"text":"n tonbonne findi darane ra,","poem":1},{"lineBreak":true},{"text":"bɔxɔ xaren yi findi tigi yiren na.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N suman binle nun kasiya binle sima nɛn tonbonni,","poem":1},{"lineBreak":true},{"text":"e nun miriti binle nun oliwi binle.","poem":1},{"lineBreak":true},{"text":"Ige mi yiren naxanye yi,","poem":1},{"lineBreak":true},{"text":"n fɔfɔne nun gbinɲɛne nun xarinne si mɛnne yi e bode xɔn,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"alogo e xa a to, e yi a kolon,","poem":1},{"lineBreak":true},{"text":"e yi a rakɔrɔsi,","poem":1},{"lineBreak":true},{"text":"e birin yi a famu","poem":1},{"lineBreak":true},{"text":"a Alatala nan feni itoe birin ligaxi,","poem":1},{"lineBreak":true},{"text":"a Isirayilaa Ala Sariɲanxin nan e rakamalixi.","poem":1}]},{"type":"heading","content":["Suxurene tɔnɔ mi na"]},{"type":"verse","number":21,"content":[{"text":"Alatala naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ fa ɛ xun mafala kitini.”","poem":1},{"lineBreak":true},{"text":"Yaxubaa Mangan naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ fa ɛ xɔn ba.”","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɛ suxurene xa fa a fala en xa","poem":1},{"lineBreak":true},{"text":"naxan fama ligadeni.","poem":1},{"lineBreak":true},{"text":"Ɛ a fala nxu xa feen naxanye bata liga,","poem":1},{"lineBreak":true},{"text":"alogo nxu xa nxu miri e ma,","poem":1},{"lineBreak":true},{"text":"nxu yi e raɲan kiin kolon.","poem":1},{"lineBreak":true},{"text":"Xanamu, ɛ a yita nxu ra","poem":1},{"lineBreak":true},{"text":"naxan fama ligadeni.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɛ waxati famatɔne fe fala nxu xa.","poem":1},{"lineBreak":true},{"text":"Nayi nxu a kolonma nɛn","poem":1},{"lineBreak":true},{"text":"a alane nan ɛ ra.","poem":1},{"lineBreak":true},{"text":"Ɛ fena nde liga,","poem":1},{"lineBreak":true},{"text":"xa a findi a faɲin na","poem":1},{"lineBreak":true},{"text":"hanma a ɲaxina,","poem":1},{"lineBreak":true},{"text":"alogo nxu birin xa na to,","poem":1},{"lineBreak":true},{"text":"gaxun yi nxu suxu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Koni na yigenla fisa ɛ xa,","poem":1},{"lineBreak":true},{"text":"ɛ wanle mi sese ra.","poem":1},{"lineBreak":true},{"text":"Naxan na ɛ sugandi,","poem":1},{"lineBreak":true},{"text":"muxu haramuxin nan na kanna ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"N bata muxuna nde rakeli sogeteden kɔmɛnna ma,","poem":1},{"lineBreak":true},{"text":"a fama nɛn sa keli sogeteden binni","poem":1},{"lineBreak":true},{"text":"naxan n maxandima.","poem":1},{"lineBreak":true},{"text":"A mangane yibodonma alo borona,","poem":1},{"lineBreak":true},{"text":"alo fɛɲɛ rafalan fɛɲɛ bɛndɛni bodonma kii naxan yi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nayi, nde bata yi na feen fala a fɔlɔni,","poem":1},{"lineBreak":true},{"text":"alogo en xa a kolon?","poem":1},{"lineBreak":true},{"text":"Nde a fala benun a xa liga,","poem":1},{"lineBreak":true},{"text":"alogo en xa a fala, en naxa,","poem":1},{"lineBreak":true},{"text":"“A ɲɔndi”?","poem":1},{"lineBreak":true},{"text":"Muxu yo mi sese fala,","poem":1},{"lineBreak":true},{"text":"feni ito mi falaxi benun a xa liga,","poem":1},{"lineBreak":true},{"text":"muxe mi ɛ fala yo mɛxi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Koni n singe nan a fala Siyon taani,","poem":1},{"lineBreak":true},{"text":"n naxa, “A mato, e tan ni i ra!”","poem":1},{"lineBreak":true},{"text":"N bata xɛrana nde fi Yerusalɛn ma,","poem":1},{"lineBreak":true},{"text":"naxan fama xibaru faɲin na.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Anu n mi kawandi muxu yo toxi suxureni itoe yɛ,","poem":1},{"lineBreak":true},{"text":"n na maxɔdinna ti,","poem":1},{"lineBreak":true},{"text":"e mi n yabima.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"A mato sese mi e ra.","poem":1},{"lineBreak":true},{"text":"E wanle mi sese ra.","poem":1},{"lineBreak":true},{"text":"E suxurene findixi foyen nun fe fuun nan na.","poem":1}]}],"footnotes":[{"noteId":27,"caller":"+","text":"41.2Yanyina nde, a Kirusi nan ma fe falama be, Perisene mangan naxan Babilɔn kaane nɔ yɛngɛni. Na feen mato Taruxune Firinden 36.22-23 kui.","reference":{"chapter":41,"verse":2}}]},"thisChapterLink":"/api/yal_pbt/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}