{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":42,"content":[{"type":"heading","content":["Alaa walikɛna"]},{"type":"verse","number":1,"content":[{"text":"N ma walikɛɛn ni i ra,","poem":1},{"lineBreak":true},{"text":"n naxan sɛnbɛ soma,","poem":1},{"lineBreak":true},{"text":"n naxan sugandixi,","poem":1},{"lineBreak":true},{"text":"naxan n kɛnɛnxi.","poem":1},{"lineBreak":true},{"text":"N na n ma Nii Sariɲanxin sama nɛn a yi,","poem":1},{"lineBreak":true},{"text":"a yi kiti kɛndɛn sa siyane xun na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A mi sɔnxɔ sɔnxɔɛ,","poem":1},{"lineBreak":true},{"text":"a mi a xuini tɛ,","poem":1},{"lineBreak":true},{"text":"a mi falan tiyɛ taan xun xɔn,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"a mi xaye yidɔxini girɛ.","poem":1},{"lineBreak":true},{"text":"A mi lɛnpun tumatɔɔn natuyɛ.","poem":1},{"lineBreak":true},{"text":"Koni, a kiti kɛndɛn sama nɛn ɲɔndin xɔn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mi xadanma,","poem":1},{"lineBreak":true},{"text":"a mi tunnaxɔlɔma a ma,","poem":1},{"lineBreak":true},{"text":"han a yi fa kiti kɛndɛn na bɔxɔ xɔnna fari,","poem":1},{"lineBreak":true},{"text":"han fɔxɔ ige tagi bɔxɔne muxune fan yi e yigi sa a sariyani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala ito nan falaxi, Ala","poem":1},{"lineBreak":true},{"text":"naxan kore xɔnna daxi,","poem":1},{"lineBreak":true},{"text":"a yi a yibandun,","poem":1},{"lineBreak":true},{"text":"naxan bɔxɔn nun a yi seene daxi,","poem":1},{"lineBreak":true},{"text":"a niiraxinla bira adamadiine yi","poem":1},{"lineBreak":true},{"text":"naxanye dɔxi a yi,","poem":1},{"lineBreak":true},{"text":"a niin bira ne yi","poem":1},{"lineBreak":true},{"text":"naxanye sigan tima a fari, a naxa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“N tan Alatala,","poem":1},{"lineBreak":true},{"text":"n tan nan i xilixi tinxinni,","poem":1},{"lineBreak":true},{"text":"n yi i suxu i yii ma,","poem":1},{"lineBreak":true},{"text":"n yi i makantan,","poem":1},{"lineBreak":true},{"text":"n yi n yengi lu i xɔn.","poem":1},{"lineBreak":true},{"text":"N ni i findi n ma yamaan layirin xidi muxun na","poem":1},{"lineBreak":true},{"text":"e nun kɛnɛnna siyane xa,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"alogo i xa danxutɔne yɛɛne rabi,","poem":1},{"lineBreak":true},{"text":"i yi suxu muxune ramini kasoon na,","poem":1},{"lineBreak":true},{"text":"i yi kasorasane xɔrɔya,","poem":1},{"lineBreak":true},{"text":"e mini dimini.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Alatala nan n tan na,","poem":1},{"lineBreak":true},{"text":"n xinla nan na ra.","poem":1},{"lineBreak":true},{"text":"N mi n ma binyen soma gbɛtɛ yii.","poem":1},{"lineBreak":true},{"text":"N mi n ma tantunna fiyɛ suxurene ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Fe singene bata yelin kamalɛ,","poem":1},{"lineBreak":true},{"text":"n fe nɛnɛne nan ma fe ralima ɛ ma","poem":1},{"lineBreak":true},{"text":"benun e xa fɔlɔ,","poem":1},{"lineBreak":true},{"text":"n xa ɛ rakolon ne ma.”","poem":1}]},{"type":"heading","content":["Bɛti nɛnɛna"]},{"type":"verse","number":10,"content":[{"text":"Ɛ bɛti nɛnɛn ba Alatala xa,","poem":1},{"lineBreak":true},{"text":"bɔxɔn danne birin xa a tantun bɛtini,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye sigama fɔxɔ igen xun ma","poem":1},{"lineBreak":true},{"text":"e nun a yi seene birin,","poem":1},{"lineBreak":true},{"text":"fɔxɔ ige tagi bɔxɔne nun e muxune birin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tonbonna nun a taane xa e xuini te,","poem":1},{"lineBreak":true},{"text":"e nun Kedari bɔnsɔnna","poem":1},{"noteId":28},{"text":"dɔxɔdene!","poem":1},{"lineBreak":true},{"text":"Sela kaane xa gbelegbele sɛwani,","poem":1},{"lineBreak":true},{"text":"e xa sɔnxɔ ɲaxaɲaxani geyane xuntagi!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Binyen xa fi Alatala ma!","poem":1},{"lineBreak":true},{"text":"A xa tantun fɔxɔ ige tagi bɔxɔne birin yi!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala minima nɛn alo sofa wɛkilɛxina,","poem":1},{"lineBreak":true},{"text":"a bɔɲɛn tema nɛn alo yɛngɛ so sɛnbɛmana.","poem":1},{"lineBreak":true},{"text":"A sɔnxɔma nɛn yaxune xili ma yɛngɛni,","poem":1},{"lineBreak":true},{"text":"a yi e nɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xabu waxati xunkuye,","poem":1},{"lineBreak":true},{"text":"n dunduxi,","poem":1},{"lineBreak":true},{"text":"n naxaraxi, n na n yɛtɛ suxi.","poem":1},{"lineBreak":true},{"text":"Koni iki, n sɔxɔlɛxi","poem":1},{"lineBreak":true},{"text":"alo ɲaxanla nɛma tinna ma,","poem":1},{"lineBreak":true},{"text":"n gbelegbelema,","poem":1},{"lineBreak":true},{"text":"n kutunma ɲaxankatani.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N geyane nun yire matexine kalama nɛn","poem":1},{"lineBreak":true},{"text":"n yi e se ɲingine birin xara.","poem":1},{"lineBreak":true},{"text":"N baane findima nɛn tonbonne ra","poem":1},{"lineBreak":true},{"text":"n yi darane xɔri.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N danxutɔne rasigama nɛn kiraan xɔn","poem":1},{"lineBreak":true},{"text":"e mi naxan kolon.","poem":1},{"lineBreak":true},{"text":"E yengi mi kiraan naxanye ma,","poem":1},{"lineBreak":true},{"text":"n yi ti e yɛɛ ra ne xɔn,","poem":1},{"lineBreak":true},{"text":"n yi dimin findi kɛnɛnna ra e yɛtagi,","poem":1},{"lineBreak":true},{"text":"n gɛmɛ yirene findi lantaan na e xa.","poem":1},{"lineBreak":true},{"text":"N na nan ligama,","poem":1},{"lineBreak":true},{"text":"n mi e rabeɲinɲɛ mumɛ!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Koni naxanye e yigi sama suxurene yi,","poem":1},{"lineBreak":true},{"text":"e yi a fala sawurane xa,","poem":1},{"lineBreak":true},{"text":"e naxa, “Nxɔ alane nan ɛ ra,”","poem":1},{"lineBreak":true},{"text":"ne xɛtɛma nɛn e xanbi ra,","poem":1},{"lineBreak":true},{"text":"e yagi.","poem":1}]},{"type":"heading","content":["Isirayila yama tondixina"]},{"type":"verse","number":18,"content":[{"text":"Ɛ tan tuli xɔrine, ɛ tuli mati!","poem":1},{"lineBreak":true},{"text":"Ɛ tan danxutɔne, ɛ yɛɛn ti,","poem":1},{"lineBreak":true},{"text":"ɛ seen to!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Danxutɔna nde ra,","poem":1},{"lineBreak":true},{"text":"xa n ma walikɛɛn xa mi a ra?","poem":1},{"lineBreak":true},{"text":"Tuli xɔrina nde ra","poem":1},{"lineBreak":true},{"text":"alo n xɛraan naxan nasigaxi?","poem":1},{"lineBreak":true},{"text":"Danxutɔna nde ra,","poem":1},{"lineBreak":true},{"text":"alo n bɔɲɛ xunbenla fixi naxan ma?","poem":1},{"lineBreak":true},{"text":"Danxutɔna nde ra,","poem":1},{"lineBreak":true},{"text":"alo Alatalaa walikɛna?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I bata fe gbegbe to,","poem":1},{"lineBreak":true},{"text":"koni i mi e famuxi.","poem":1},{"lineBreak":true},{"text":"I tunle rabixi,","poem":1},{"lineBreak":true},{"text":"koni e mi feen mɛma!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatalaa tinxinna fe ra,","poem":1},{"lineBreak":true},{"text":"a bata a kɛnɛn,","poem":1},{"lineBreak":true},{"text":"a xa a sariyan gboon nun a nɔrɔn makɛnɛn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Anu, yama yiigelitɔ halagixini ito mato!","poem":1},{"lineBreak":true},{"text":"E bata e birin suxu,","poem":1},{"lineBreak":true},{"text":"e birin balanxi yinle ra,","poem":1},{"lineBreak":true},{"text":"e birin saxi kasoon na.","poem":1},{"lineBreak":true},{"text":"E yii seene bata suxu yɛngɛni,","poem":1},{"lineBreak":true},{"text":"muxe mi na naxan e xunbɛ.","poem":1},{"lineBreak":true},{"text":"E yɛtɛɛn bata findi se suxin na yɛngɛni,","poem":1},{"lineBreak":true},{"text":"muxe mi na naxan a falɛ,","poem":1},{"lineBreak":true},{"text":"a naxa, “Ne raxɛtɛ!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nde a tuli matima ito ra ɛ yɛ?","poem":1},{"lineBreak":true},{"text":"Nde a ligama a yeren ma,","poem":1},{"lineBreak":true},{"text":"to xanbi ra, a yi a tuli mati?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nde Yaxuba bɔnsɔnna soxi a yaxune yii,","poem":1},{"lineBreak":true},{"text":"a Isirayila so halagi tiine yii?","poem":1},{"lineBreak":true},{"text":"Alatala xa mi a ra,","poem":1},{"lineBreak":true},{"text":"en naxan yulubi tongo,","poem":1},{"lineBreak":true},{"text":"en mi tin birɛ naxan ma kira fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"en tondi a sariyane suxɛ?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nayi, a yi a xɔlɔ gbeen nagodo e fari","poem":1},{"lineBreak":true},{"text":"alo tɛɛna","poem":1},{"lineBreak":true},{"text":"e nun yɛngɛn gbalone.","poem":1},{"lineBreak":true},{"text":"A yi e gan,","poem":1},{"lineBreak":true},{"text":"koni e mi sese famuxi,","poem":1},{"lineBreak":true},{"text":"a yi e raxɔri,","poem":1},{"lineBreak":true},{"text":"koni e mi na feen yatɛ e bɔɲɛni.","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"42.11Kedarifindixi Sumayilaa diin nan na. Na feen sɛbɛxi Dunuɲa Fɔlɔn 25.13 kui.","reference":{"chapter":42,"verse":11}}]},"thisChapterLink":"/api/yal_pbt/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}