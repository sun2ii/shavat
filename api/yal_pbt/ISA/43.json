{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":43,"content":[{"type":"heading","content":["Alatala nan Isirayila xunbama"]},{"type":"verse","number":1,"content":[{"text":"Ala naxan i daxi,","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"naxan i rafalaxi,","poem":1},{"lineBreak":true},{"text":"Isirayila bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"Alatala ito nan falaxi iki,","poem":1},{"lineBreak":true},{"text":"a naxa, “I nama gaxu,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n bata i xunba!","poem":1},{"lineBreak":true},{"text":"N bata i xili i xinla ma.","poem":1},{"lineBreak":true},{"text":"N tan nan gbee i ra!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xa i danguma fɔxɔ igeni,","poem":1},{"lineBreak":true},{"text":"n luma nɛn i xɔn.","poem":1},{"lineBreak":true},{"text":"Xa i danguma baane yi,","poem":1},{"lineBreak":true},{"text":"i mi i maminɲɛ.","poem":1},{"lineBreak":true},{"text":"Xa i danguma tɛɛni,","poem":1},{"lineBreak":true},{"text":"a mi i ganɲɛ,","poem":1},{"lineBreak":true},{"text":"tɛɛ dɛgɛn mi i raxɔrɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amasɔtɔ Alatala nan n na,","poem":1},{"lineBreak":true},{"text":"i ya Ala,","poem":1},{"lineBreak":true},{"text":"Isirayilaa Ala Sariɲanxina,","poem":1},{"lineBreak":true},{"text":"i rakisimana.","poem":1},{"lineBreak":true},{"text":"N bata Misiran yamanan fi i xunbaan na,","poem":1},{"lineBreak":true},{"text":"n yi Kusi yamanan nun Sɛba yamanan findi i ɲɔxɔn na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bayo i yatɛxi n xɔn,","poem":1},{"lineBreak":true},{"text":"i binyaxi n yɛɛ ra yi,","poem":1},{"lineBreak":true},{"text":"n bata i xanu.","poem":1},{"lineBreak":true},{"text":"N bata muxune findi i ɲɔxɔn na,","poem":1},{"lineBreak":true},{"text":"n yi yamane fi i niin xunbaan na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“I nama gaxu,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n luma nɛn i xɔn.","poem":1},{"lineBreak":true},{"text":"N fama nɛn i yixɛtɛne ra","poem":1},{"lineBreak":true},{"text":"sa keli sogeteden binni,","poem":1},{"lineBreak":true},{"text":"n yi sa e malan","poem":1},{"lineBreak":true},{"text":"keli sogegododen binni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na a falama nɛn kɔmɛnna binna xa,","poem":1},{"lineBreak":true},{"text":"n naxa, ‘E beɲin!’","poem":1},{"lineBreak":true},{"text":"N yi a fala yiifanna binna xa,","poem":1},{"lineBreak":true},{"text":"n naxa, ‘I nama e makankan!’","poem":1},{"lineBreak":true},{"text":"Fa n ma dii xɛmɛne ra","poem":1},{"lineBreak":true},{"text":"sa keli yire makuyeni,","poem":1},{"lineBreak":true},{"text":"e nun n ma dii tɛmɛne","poem":1},{"lineBreak":true},{"text":"sa keli bɔxɔn danne ra,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"n xinla falama naxanye birin xun ma","poem":1},{"lineBreak":true},{"text":"n naxanye daxi n ma binyena fe ra,","poem":1},{"lineBreak":true},{"text":"n naxanye rafalaxi,","poem":1},{"lineBreak":true},{"text":"n yi e da.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yamani ito ramini","poem":1},{"lineBreak":true},{"text":"naxanye danxuxi,","poem":1},{"lineBreak":true},{"text":"anu e yɛɛne fan,","poem":1},{"lineBreak":true},{"text":"tuli xɔrini itoe,","poem":1},{"lineBreak":true},{"text":"naxanye tunle fan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Siyane birin xa e malan e bode xɔn,","poem":1},{"lineBreak":true},{"text":"yamanane muxune birin!","poem":1},{"lineBreak":true},{"text":"Nde na fe falaxi e yɛ","poem":1},{"lineBreak":true},{"text":"benun a xa liga?","poem":1},{"lineBreak":true},{"text":"Nde fe fonne ralixi en ma?","poem":1},{"lineBreak":true},{"text":"E xa fa e serene ra,","poem":1},{"lineBreak":true},{"text":"e yi a mayita a yoona e xa!","poem":1},{"lineBreak":true},{"text":"En xa e xuiin namɛ,","poem":1},{"lineBreak":true},{"text":"alogo muxune xa a fala,","poem":1},{"lineBreak":true},{"text":"e naxa, “E ɲɔndi!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatalaa falan ni ito ra,","poem":1},{"lineBreak":true},{"text":"a naxa, “Ɛ tan nan n serene ra,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye findixi n ma walikɛne ra,","poem":1},{"lineBreak":true},{"text":"n naxanye sugandixi","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa n kolon,","poem":1},{"lineBreak":true},{"text":"ɛ yi la n na.","poem":1},{"lineBreak":true},{"text":"N tan yi na yi","poem":1},{"lineBreak":true},{"text":"benun suxure yo xa rafala,","poem":1},{"lineBreak":true},{"text":"ala gbɛtɛ yo mi na n tan xanbi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N tan nan Alatala ra,","poem":1},{"lineBreak":true},{"text":"n tan yati!","poem":1},{"lineBreak":true},{"text":"Ba n tan na,","poem":1},{"lineBreak":true},{"text":"marakisi ti gbɛtɛ yo mi na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N tan nan feene makɛnɛnma,","poem":1},{"lineBreak":true},{"text":"n muxune rakisi, n yi ɛ rakolon!","poem":1},{"lineBreak":true},{"text":"Ala xɔɲɛ mi a ra","poem":1},{"lineBreak":true},{"text":"naxan ɛ tagi fɔ n tan!","poem":1},{"lineBreak":true},{"text":"Nayi, n serene nan ɛ ra,","poem":1},{"lineBreak":true},{"text":"fa fala n tan nan Ala ra.”","poem":1},{"lineBreak":true},{"text":"Alatalaa falan nan na ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"“N tan yatigin nan na ra","poem":1},{"lineBreak":true},{"text":"xabu a fɔlɔni!","poem":1},{"lineBreak":true},{"text":"Muxu yo mi nɔɛ muxun bɛ n yii.","poem":1},{"lineBreak":true},{"text":"N na naxan liga,","poem":1},{"lineBreak":true},{"text":"nde nɔɛ a rakalɛ ayi?”","poem":1}]},{"type":"heading","content":["Alaa kininkininna"]},{"type":"verse","number":14,"content":["Alatala ito nan falaxi, naxan ɛ xunbama, Isirayilaa Ala Sariɲanxina, a naxa,",{"text":"“N muxuna nde rasigama nɛn","poem":1},{"lineBreak":true},{"text":"Babilɔn yamanan xili ma,","poem":1},{"lineBreak":true},{"text":"ɛ tan ma fe ra.","poem":1},{"lineBreak":true},{"text":"N yi Babilɔn muxu gixine kunkine kala,","poem":1},{"lineBreak":true},{"text":"e yi e mamin,","poem":1},{"lineBreak":true},{"text":"e yi e kanbama naxanye yi nun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alatala nan n tan na,","poem":1},{"lineBreak":true},{"text":"ɛ Ala sariɲanxina,","poem":1},{"lineBreak":true},{"text":"naxan Isirayila daxi, ɛ mangana.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alatala ito nan falaxi,","poem":1},{"lineBreak":true},{"text":"naxan kiraan sama baa igen xɔnna ma,","poem":1},{"lineBreak":true},{"text":"dangu ige gbeene yi,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"naxan yɛngɛ so wontorone nun soone rasiga yɛngɛni,","poem":1},{"lineBreak":true},{"text":"e nun ganla nun sofa wɛkilɛxine e bode xɔn,","poem":1},{"lineBreak":true},{"text":"e yi e sa,","poem":1},{"lineBreak":true},{"text":"e mi fa kelima sɔnɔn,","poem":1},{"lineBreak":true},{"text":"e yi tu alo saraban na ɲan.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A naxa:","poem":1},{"lineBreak":true},{"text":"Fe singene nama fa rabira ɛ ma,","poem":1},{"lineBreak":true},{"text":"ɛ ɲinan fe fonne xɔn!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɛ a mato,","poem":1},{"lineBreak":true},{"text":"n fe nɛnɛn nan ligama!","poem":1},{"lineBreak":true},{"text":"Na bata a fɔlɔ iki,","poem":1},{"lineBreak":true},{"text":"ɛ mi a kolon ba?","poem":1},{"lineBreak":true},{"text":"N kiraan sama nɛn tonbonni,","poem":1},{"lineBreak":true},{"text":"n yi baane ramini bɔxɔ xareni.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Burunna subene n binyama nɛn,","poem":1},{"lineBreak":true},{"text":"kankone nun dangaranfulene,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n bata igen namini tonbonni,","poem":1},{"lineBreak":true},{"text":"n yi baane ramini bɔxɔ xareni,","poem":1},{"lineBreak":true},{"text":"alogo n ma yamaan xa e min,","poem":1},{"lineBreak":true},{"text":"n naxan sugandixi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N yamaan naxan nafalaxi,","poem":1},{"lineBreak":true},{"text":"na n tantunma nɛn.","poem":1}]},{"type":"heading","content":["Ala yamaan makitima"]},{"type":"verse","number":22,"content":[{"text":"Ɛ tan Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"ɛ mi n tan xan xilixi!","poem":1},{"lineBreak":true},{"text":"Ɛ tan Isirayila kaane,","poem":1},{"lineBreak":true},{"text":"ɛ bata ɛ tunnaxɔlɔ ɛ ma n tan mabinni.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɛ mi ɛ yɛxɛɛne nun ɛ siine baxi n xa saraxa gan daxin na.","poem":1},{"lineBreak":true},{"text":"Ɛ saraxane mi findixi n ma binyen na.","poem":1},{"lineBreak":true},{"text":"N mi saraxane findixi goronna ra ɛ xun ma,","poem":1},{"lineBreak":true},{"text":"n mi ɛ raxadanxi wusulan saraxane badeni.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ɛ mi gbeti yikalaxi n xa,","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa latikɔnɔnna sara n xa,","poem":1},{"lineBreak":true},{"text":"ɛ saraxa subene turen mi n wasaxi.","poem":1},{"lineBreak":true},{"text":"Koni ɛ yulubine bata findi goronna ra n xun ma","poem":1},{"lineBreak":true},{"text":"ɛ yi n naxadan hakɛne xɔn.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Koni n tan nan keden pe ɛ hakɛne xafarima,","poem":1},{"lineBreak":true},{"text":"n tan yɛtɛna fe ra.","poem":1},{"lineBreak":true},{"text":"N mi fa n mirima ɛ yulubine fe ma sɔnɔn.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fe danguxine rabira n ma.","poem":1},{"lineBreak":true},{"text":"En kiti feni ito yɛba en bode xa.","poem":1},{"lineBreak":true},{"text":"Ɛ falan ti, ɛ yi ɛ yɛtɛ xun mafala.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ɛ benban nan singe yulubin liga,","poem":1},{"lineBreak":true},{"text":"ɛ fala radangune yi murutɛ n xili ma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nanara, n bata yire sariɲanxin kuntigine yatɛ muxu haramuxine ra,","poem":1},{"lineBreak":true},{"text":"n yi halagin nagidi Yaxuba yixɛtɛne ma,","poem":1},{"lineBreak":true},{"text":"n yi marayarabin nagidi Isirayila kaane ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}