{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":44,"content":[{"type":"heading","content":["Alatala nan keden Ala ra"]},{"type":"verse","number":1,"content":[{"text":"Koni iki, Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"n ma walikɛne,","poem":1},{"lineBreak":true},{"text":"ɛ tuli mati,","poem":1},{"lineBreak":true},{"text":"n na Isirayila naxan sugandixi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala ito nan falaxi,","poem":1},{"lineBreak":true},{"text":"naxan i daxi,","poem":1},{"lineBreak":true},{"text":"naxan i rafalaxi i nga kui,","poem":1},{"lineBreak":true},{"text":"naxan i malima, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ nama gaxu, n ma walikɛne,","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"i tan Isirayila tinxinxina","poem":1},{"lineBreak":true},{"text":"n naxan sugandixi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bayo n ni igen nafama nɛn bɔxɔ xareni","poem":1},{"lineBreak":true},{"text":"n yi xudene radangu tonbonni.","poem":1},{"lineBreak":true},{"text":"N na n ma Nii Sariɲanxin nagodoma nɛn i bɔnsɔnne ma,","poem":1},{"lineBreak":true},{"text":"n yi barakan sa i yixɛtɛne fe yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E sabatima nɛn","poem":1},{"lineBreak":true},{"text":"alo sɛxɛne burunna ra,","poem":1},{"lineBreak":true},{"text":"alo wudi faɲine xudene dɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Muxuna nde a falama nɛn,","poem":1},{"lineBreak":true},{"text":"a naxa, ‘Alatala nan gbee n na,’","poem":1},{"lineBreak":true},{"text":"boden yi a fala,","poem":1},{"lineBreak":true},{"text":"a a xili nɛn ‘Yaxuba,’","poem":1},{"lineBreak":true},{"text":"gbɛtɛ yi a sɛbɛ a yiin ma,","poem":1},{"lineBreak":true},{"text":"fa fala ‘Alatala gbeena,’","poem":1},{"lineBreak":true},{"text":"a yi a yɛtɛ xili ba a ‘Isirayila.’ ”","poem":1}]},{"type":"heading","content":["Naxanye suxurene rafalama"]},{"type":"verse","number":6,"content":[{"text":"Alatala ito nan falaxi,","poem":1},{"lineBreak":true},{"text":"Isirayila Mangan naxan a xunbama,","poem":1},{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna naxa,","poem":1},{"lineBreak":true},{"text":"“N tan nan a fɔlɔn nun a raɲanna ra.","poem":1},{"lineBreak":true},{"text":"Ba n tan na,","poem":1},{"lineBreak":true},{"text":"Ala gbɛtɛ mi na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nde luxi alo n tan?","poem":1},{"lineBreak":true},{"text":"Na kanna xa a xuini te!","poem":1},{"lineBreak":true},{"text":"A xa a yɛba n xa,","poem":1},{"lineBreak":true},{"text":"naxan birin bata dangu","poem":1},{"lineBreak":true},{"text":"xabu n singe ra muxune da waxatin naxan yi!","poem":1},{"lineBreak":true},{"text":"A mɔn xa fe famatɔne fe fala,","poem":1},{"lineBreak":true},{"text":"naxanye fama ligadeni!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɛ nama gaxu,","poem":1},{"lineBreak":true},{"text":"ɛ nama xuruxurun,","poem":1},{"lineBreak":true},{"text":"n mi yi ɛ rakolonxi feni ito ma ba,","poem":1},{"lineBreak":true},{"text":"n yi a rali ɛ ma","poem":1},{"lineBreak":true},{"text":"xabu to mi na ra?","poem":1},{"lineBreak":true},{"text":"N serene nan ɛ tan na.","poem":1},{"lineBreak":true},{"text":"Ala gbɛtɛ na,","poem":1},{"lineBreak":true},{"text":"ba n tan na ba?","poem":1},{"lineBreak":true},{"text":"Ɛ kantan fanye gbɛtɛ yo mi na,","poem":1},{"lineBreak":true},{"text":"ba n tan na.","poem":1},{"lineBreak":true},{"text":"N mi gbɛtɛ kolon.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naxanye birin suxurene rafalama,","poem":1},{"lineBreak":true},{"text":"fuyantenne nan ne birin na,","poem":1},{"lineBreak":true},{"text":"e se rafalaxi fisamantenne tɔnɔ yo mi na.","poem":1},{"lineBreak":true},{"text":"E yɛtɛ serene nan e ra:","poem":1},{"lineBreak":true},{"text":"E mi se toma, e mi fe kolon,","poem":1},{"lineBreak":true},{"text":"e mɔn luma nɛn yagini.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muxun na alana nde rafala","poem":1},{"lineBreak":true},{"text":"hanma suxurena nde,","poem":1},{"lineBreak":true},{"text":"na tɔnɔ mi na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Na kanna nun a sifan birin yagima nɛn.","poem":1},{"lineBreak":true},{"text":"Suxuren nafala muxune findixi adamadiine nan tun na.","poem":1},{"lineBreak":true},{"text":"E birin xa e malan,","poem":1},{"lineBreak":true},{"text":"e xa e maso.","poem":1},{"lineBreak":true},{"text":"E gaxuma nɛn,","poem":1},{"lineBreak":true},{"text":"e yagi e bode xɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xabun nɛma bunbin xabuma,","poem":1},{"lineBreak":true},{"text":"a walima tɛ wolonne nan na,","poem":1},{"lineBreak":true},{"text":"a yi a rafala dɛɛramaan na.","poem":1},{"lineBreak":true},{"text":"A a rawalima a sɛnbɛn nan na","poem":1},{"lineBreak":true},{"text":"koni kamɛn na a suxu,","poem":1},{"lineBreak":true},{"text":"a sɛnbɛn yi ɲan,","poem":1},{"lineBreak":true},{"text":"min xɔnla yi a suxu, a xadan.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kabintan lutin sama nɛn wudin ma,","poem":1},{"lineBreak":true},{"text":"a yi lutin funfun naba a ma,","poem":1},{"lineBreak":true},{"text":"a yi a masoli wali seen na,","poem":1},{"lineBreak":true},{"text":"a yi a radigilin,","poem":1},{"lineBreak":true},{"text":"a yi a rafala muxu sawuran na,","poem":1},{"lineBreak":true},{"text":"a lu adamadiyaan nɔrɔn birin yi","poem":1},{"lineBreak":true},{"text":"alogo a xa a ti a batu banxini.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A sumanne nan sɛgɛma","poem":1},{"lineBreak":true},{"text":"hanma xarinne hanma warine","poem":1},{"lineBreak":true},{"text":"a naxanye raluxi fɔtɔnni,","poem":1},{"lineBreak":true},{"text":"e gbo.","poem":1},{"lineBreak":true},{"text":"Xanamu, a fɔfɔna nde tongo,","poem":1},{"lineBreak":true},{"text":"a tan yɛtɛɛn naxan sixi,","poem":1},{"lineBreak":true},{"text":"tule igen yi sa a ma, a gbo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Adamadiine na wudina ndee ganma yegen na,","poem":1},{"lineBreak":true},{"text":"e yi nde tongo,","poem":1},{"lineBreak":true},{"text":"e yi e maxara a ra.","poem":1},{"lineBreak":true},{"text":"E na nan ndee mɔn tongoma,","poem":1},{"lineBreak":true},{"text":"e yi kudin so,","poem":1},{"lineBreak":true},{"text":"e mɔn yi ndee tongo,","poem":1},{"lineBreak":true},{"text":"e yi e gbee alana nde rafala,","poem":1},{"lineBreak":true},{"text":"e yi e xinbi sin a bun,","poem":1},{"lineBreak":true},{"text":"e suxuren nafala, e yi a batu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E yi a wudi dɔnxɛn findi yegen na,","poem":1},{"lineBreak":true},{"text":"a gan,","poem":1},{"lineBreak":true},{"text":"e yi suben ɲin ndee ra,","poem":1},{"lineBreak":true},{"text":"e yi a gan ndee ra,","poem":1},{"lineBreak":true},{"text":"e yi a don han e lugo.","poem":1},{"lineBreak":true},{"text":"A mɔn yi a maxara,","poem":1},{"lineBreak":true},{"text":"a yi a fala, a naxa,","poem":1},{"lineBreak":true},{"text":"“N na n maxarama,","poem":1},{"lineBreak":true},{"text":"n tɛɛ dɛgɛn toma yati! ”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A wudin dɔnxɛna,","poem":1},{"lineBreak":true},{"text":"a yi na rafala a gbee ala ra,","poem":1},{"lineBreak":true},{"text":"a suxurena,","poem":1},{"lineBreak":true},{"text":"a yi a xinbi sin a yɛtagi,","poem":1},{"lineBreak":true},{"text":"a yi a batu, a naxa,","poem":1},{"lineBreak":true},{"text":"“N xunba,","poem":1},{"lineBreak":true},{"text":"bayo i tan nan n ma ala ra!”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E mi fe kolon,","poem":1},{"lineBreak":true},{"text":"e xaxili mi na,","poem":1},{"lineBreak":true},{"text":"e yɛɛne raxixi","poem":1},{"lineBreak":true},{"text":"alogo e nama sese to.","poem":1},{"lineBreak":true},{"text":"E mi nɔɛ e mirɛ,","poem":1},{"lineBreak":true},{"text":"e feene famu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Muxune mi e mirima,","poem":1},{"lineBreak":true},{"text":"e xaxinla sɔtɔ,","poem":1},{"lineBreak":true},{"text":"e mi feene yɛɛ toɛ","poem":1},{"lineBreak":true},{"text":"alogo e xa a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"“N bata wudina ndee gan,","poem":1},{"lineBreak":true},{"text":"n kudin so a ra,","poem":1},{"lineBreak":true},{"text":"n yi suben gan ndee ra,","poem":1},{"lineBreak":true},{"text":"n yi a don.","poem":1},{"lineBreak":true},{"text":"N lan n xa a dɔnxɛn findi se haramuxin na ba,","poem":1},{"lineBreak":true},{"text":"n yi n xinbi sin yegen bun?”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"E kankanma naxan ma,","poem":1},{"lineBreak":true},{"text":"xuben nan gbansan na ra.","poem":1},{"lineBreak":true},{"text":"E bɔɲɛn bata tantan,","poem":1},{"lineBreak":true},{"text":"a e ralɔ ayi.","poem":1},{"lineBreak":true},{"text":"E niin mi xunbama,","poem":1},{"lineBreak":true},{"text":"e mi a falama, e naxa,","poem":1},{"lineBreak":true},{"text":"“Seen naxan n yii ito ra,","poem":1},{"lineBreak":true},{"text":"wulen xa mi a ra ba?”","poem":1}]},{"type":"heading","content":["Tinxinna Ala xa"]},{"type":"verse","number":21,"content":[{"text":"Yaxuba bɔnsɔnne,","poem":1},{"lineBreak":true},{"text":"na feen xa rabira ɛ ma!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ n ma walikɛɛn nan ɛ ra,","poem":1},{"lineBreak":true},{"text":"Isirayila kaane!","poem":1},{"lineBreak":true},{"text":"N na ɛ rafalaxi nɛn","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa findi n ma walikɛne ra,","poem":1},{"lineBreak":true},{"text":"Isirayila kaane,","poem":1},{"lineBreak":true},{"text":"n mi ɲinanma ɛ xɔn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N bata ɛ hakɛne ba ɛ ma","poem":1},{"lineBreak":true},{"text":"alo kundaan kore xɔnna ma","poem":1},{"lineBreak":true},{"text":"e nun ɛ yulubine","poem":1},{"lineBreak":true},{"text":"alo kundaan xɔtɔnni.","poem":1},{"lineBreak":true},{"text":"Ɛ xun xɛtɛ n ma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n bata ɛ xunba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kore xɔnna, gbelegbele sɛwani,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ Alatala bata wali!","poem":1},{"lineBreak":true},{"text":"Bɔxɔn bunna, sɔnxɔ sɛwani,","poem":1},{"lineBreak":true},{"text":"geyane, ɛ xuini te","poem":1},{"lineBreak":true},{"text":"e nun ɛ tan fɔtɔnne nun wudine birin.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ Alatala bata Yaxuba yixɛtɛne xunba,","poem":1},{"lineBreak":true},{"text":"a yi a binyen mayita Isirayila yi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Alatala ito nan falaxi,","poem":1},{"lineBreak":true},{"text":"a tan naxan i xunbama,","poem":1},{"lineBreak":true},{"text":"naxan i rafalaxi","poem":1},{"lineBreak":true},{"text":"xabu i i nga kui, a naxa,","poem":1},{"lineBreak":true},{"text":"“N tan, Alatala,","poem":1},{"lineBreak":true},{"text":"n bata feen birin liga,","poem":1},{"lineBreak":true},{"text":"n tan nan keden kore xɔnni fulunxi,","poem":1},{"lineBreak":true},{"text":"n tan yɛtɛɛn nan bɔxɔ xɔnna saxi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N tan nan waliyine wule mantaxane kalama,","poem":1},{"lineBreak":true},{"text":"n yi yiimatone findi daxune ra,","poem":1},{"lineBreak":true},{"text":"n yi fekolonne raxɛtɛ xanbin na","poem":1},{"lineBreak":true},{"text":"n yi e xaxilimayaan findi xaxilitareyaan na.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N na n ma walikɛna falane rakamalima nɛn.","poem":1},{"lineBreak":true},{"text":"N ma xɛrane na fe famatɔɔn naxanye rali,","poem":1},{"lineBreak":true},{"text":"n na a rakamalima nɛn.","poem":1},{"lineBreak":true},{"text":"N bata a fala Yerusalɛn ma, n naxa,","poem":1},{"lineBreak":true},{"text":"‘Muxune mɔn dɔxɔma nɛn a yi,","poem":1},{"lineBreak":true},{"text":"Yuda taane mɔn tima nɛn,","poem":1},{"lineBreak":true},{"text":"n mɔn yi taa kalaxine yitɔn.’","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"N nɔɛ a falɛ tilinna ma,","poem":1},{"lineBreak":true},{"text":"n naxa, ‘Xara,","poem":1},{"lineBreak":true},{"text":"n xa i ya igen xɔri.’","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"N yi a fala Kirusi ma,","poem":1},{"lineBreak":true},{"text":"n naxa, ‘N ma xuruse rabana!","poem":1},{"lineBreak":true},{"text":"A n waxɔn feene birin ligama nɛn.’","poem":1},{"lineBreak":true},{"text":"N na a fala Yerusalɛn ma,","poem":1},{"lineBreak":true},{"text":"n naxa, ‘A mɔn xa ti!’","poem":1},{"lineBreak":true},{"text":"E nun Ala Batu Banxin ma,","poem":1},{"lineBreak":true},{"text":"n naxa, ‘A mɔn xa bɛtɛn sa!’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}