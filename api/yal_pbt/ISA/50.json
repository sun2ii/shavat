{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":50,"content":[{"type":"heading","content":["Ala nan a yamaan nakisima"]},{"type":"verse","number":1,"content":[{"text":"Alatala ito nan falaxi, a naxa,","poem":1},{"lineBreak":true},{"text":"“Futu kala kɛdin minɛn","poem":1},{"lineBreak":true},{"text":"n na n mɛxi ɛ nga ra naxan xɔn?","poem":1},{"lineBreak":true},{"text":"Hanma n na ɛ matixi n doli faane ma naxan xɔn?","poem":1},{"lineBreak":true},{"text":"Ɛ matixi ɛ hakɛne nan ma fe ra","poem":1},{"lineBreak":true},{"text":"ɛ nga ramɛxi ɛ matandine nan ma fe ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N to fa, nanfera muxe mi yi be?","poem":1},{"lineBreak":true},{"text":"N to xinla ti, nanfera,","poem":1},{"lineBreak":true},{"text":"muxe mi n yabi?","poem":1},{"lineBreak":true},{"text":"N yiin dungi nayi ba,","poem":1},{"lineBreak":true},{"text":"a yi muxune xunba?","poem":1},{"lineBreak":true},{"text":"Sɛnbɛ mi n na ba,","poem":1},{"lineBreak":true},{"text":"n yi muxune xɔrɔya?","poem":1},{"lineBreak":true},{"text":"Anu, n baa igen xɔrima,","poem":1},{"lineBreak":true},{"text":"n na n kɔnkɔ a ma,","poem":1},{"lineBreak":true},{"text":"n yi baane findi tonbonna ra,","poem":1},{"lineBreak":true},{"text":"e yɛxɛne yi kun,","poem":1},{"lineBreak":true},{"text":"bayo ige mi na,","poem":1},{"lineBreak":true},{"text":"e birin yi faxa min xɔnla ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yi dimin naso kore","poem":1},{"lineBreak":true},{"text":"alo sunu dugina.”","poem":1}]},{"type":"heading","content":["Marigina walikɛna"]},{"type":"verse","number":4,"content":[{"text":"Marigina Alatala bata n xaran","poem":1},{"lineBreak":true},{"text":"alogo n xa a kolon","poem":1},{"lineBreak":true},{"text":"n naxan falɛ muxu xadanxine xa,","poem":1},{"lineBreak":true},{"text":"e sɛnbɛn sɔtɔ.","poem":1},{"lineBreak":true},{"text":"A n naxulunma xɔtɔn yo xɔtɔn,","poem":1},{"lineBreak":true},{"text":"alogo n xa a falan namɛ","poem":1},{"lineBreak":true},{"text":"alo a xarandiina.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Marigina Alatala bata n tunle rabi,","poem":1},{"lineBreak":true},{"text":"n tan fan mi murutɛxi a ma,","poem":1},{"lineBreak":true},{"text":"n mi xɛtɛxi xanbin na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na n fanna ti nɛn n bɔnbɔ muxune xa,","poem":1},{"lineBreak":true},{"text":"n yi n dɛɛn ti ne xa","poem":1},{"lineBreak":true},{"text":"naxanye n dɛ xabene matalama.","poem":1},{"lineBreak":true},{"text":"N mi n yɛtagin baxi konbin nun dɛgen bun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Koni Marigina Alatala n mali nɛn,","poem":1},{"lineBreak":true},{"text":"nanara n mi rayarabi.","poem":1},{"lineBreak":true},{"text":"N bata n yɛtagin findi fanyen na,","poem":1},{"lineBreak":true},{"text":"n to a kolon a n mi fama yagideni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naxan yoon fima n ma,","poem":1},{"lineBreak":true},{"text":"na bata maso.","poem":1},{"lineBreak":true},{"text":"Nde waxi n xun maxidi feni nayi?","poem":1},{"lineBreak":true},{"text":"En kitin yɛba en bode xa!","poem":1},{"lineBreak":true},{"text":"Nde mi tinxi n ma yoon ma?","poem":1},{"lineBreak":true},{"text":"A xa fa n xili ma!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Marigina Alatala n malima nɛn.","poem":1},{"lineBreak":true},{"text":"Nayi, nde n yalagima?","poem":1},{"lineBreak":true},{"text":"E birin kalama nɛn","poem":1},{"lineBreak":true},{"text":"alo dugi fonna, kunle yi e don.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nde a tuli matiyɛ Alaa walikɛɛn na Alatala yɛɛragaxun ma?","poem":1},{"lineBreak":true},{"text":"Naxan yo sigan tima dimini,","poem":1},{"lineBreak":true},{"text":"kɛnɛnna dasaxi naxan ma,","poem":1},{"lineBreak":true},{"text":"na xa a yigi sa Alatala yi,","poem":1},{"lineBreak":true},{"text":"a yi a xaxili ti a Ala ra!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koni ɛ tan naxanye tɛɛne soma,","poem":1},{"lineBreak":true},{"text":"ɛ yi tanba radɛgɛxine tongo,","poem":1},{"lineBreak":true},{"text":"nba ɛ sigan ti ɛ yɛtɛna tɛɛ dɛgɛn ma,","poem":1},{"lineBreak":true},{"text":"ɛ tanban naxanye radɛgɛxi.","poem":1},{"lineBreak":true},{"text":"Ɛ fa ito nan sɔtɔma:","poem":1},{"lineBreak":true},{"text":"ɛ faxama sɔxɔlɛn nin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}