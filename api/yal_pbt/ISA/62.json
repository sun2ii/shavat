{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ISA","translationId":"yal_pbt","name":"Nabi Esayi Sora","commonName":"Nabi Esayi Sora","title":"Esayi Nabi Esayi Alaa Falan Naxan Sɛbɛ","order":23,"numberOfChapters":66,"sha256":"fa311d27e1c6d390367c598128e56482fe9f85f7028edd0afb1d44596d97dcee","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yal_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":62,"content":[{"type":"heading","content":["Yerusalɛn taan nakisi fena"]},{"type":"verse","number":1,"content":[{"text":"Siyon taana fe ra,","poem":1},{"lineBreak":true},{"text":"n mi n dunduma,","poem":1},{"lineBreak":true},{"text":"Yerusalɛn ma fe ra,","poem":1},{"lineBreak":true},{"text":"n mi n naxarama,","poem":1},{"lineBreak":true},{"text":"han a tinxinyaan yi makɛnɛn","poem":1},{"lineBreak":true},{"text":"alo sogen tematɔna,","poem":1},{"lineBreak":true},{"text":"a marakisin yi mayilen","poem":1},{"lineBreak":true},{"text":"alo xaye xidi dɛgɛne dimini.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nayi, siyane ɛ tinxinna toma nɛn","poem":1},{"lineBreak":true},{"text":"mangane birin yi ɛ binyen to,","poem":1},{"lineBreak":true},{"text":"ɛ yi xili nɛnɛn sɔtɔ,","poem":1},{"lineBreak":true},{"text":"Alatala na naxan fala a dɛɛn na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ findima nɛn manga kɔmɔti mayilenxin na Alatala yii,","poem":1},{"lineBreak":true},{"text":"e nun mangaya taxamaseri namuna ɛ Ala yii.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mi fa falama ɛ ma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"fa fala “Yama rabeɲinxina.”","poem":1},{"lineBreak":true},{"text":"A mi fa falama ɛ bɔxɔn ma sɔnɔn","poem":1},{"lineBreak":true},{"text":"fa fala “Bɔxɔ raxɔrixina.”","poem":1},{"lineBreak":true},{"text":"Koni ɛ xili bama nɛn","poem":1},{"lineBreak":true},{"text":"fa fala “N nafan yirena,”","poem":1},{"lineBreak":true},{"text":"a fala ɛ bɔxɔn ma","poem":1},{"lineBreak":true},{"text":"fa fala “Ɲaxalan futuxina.”","poem":1},{"lineBreak":true},{"text":"Bayo ɛ rafan Alatala ma,","poem":1},{"lineBreak":true},{"text":"a findima nɛn ɛ bɔxɔn kanna ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ diine ɛ yamanan masuxuma nɛn","poem":1},{"lineBreak":true},{"text":"alo banxulanna sungutunna futuma kii naxan yi,","poem":1},{"lineBreak":true},{"text":"ɛ yi findi sɛwan na ɛ Ala xa","poem":1},{"lineBreak":true},{"text":"alo ɲaxalandina a xɛmɛn nasɛwama kii naxan yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yerusalɛn kaane, n bata kantan tiine dɔxɔ ɛ taan makantan yinna xuntagi,","poem":1},{"lineBreak":true},{"text":"kɔɛɛn nun yanyin na,","poem":1},{"lineBreak":true},{"text":"e mi e dunduma.","poem":1},{"lineBreak":true},{"text":"Ɛ tan naxanye taana fe rabirama Alatala ma","poem":1},{"lineBreak":true},{"text":"ɛ nɛma a maxandɛ,","poem":1},{"lineBreak":true},{"text":"ɛ nama ɛ matabu de!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɛ mɔn nama tin","poem":1},{"lineBreak":true},{"text":"a fan xa a raxara","poem":1},{"lineBreak":true},{"text":"han a yi Yerusalɛn rasabati,","poem":1},{"lineBreak":true},{"text":"bɔxɔ xɔnna muxune birin yi a tantun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala bata a kɔlɔ a yiifanna nun a sɛnbɛ gbeeni, a naxa,","poem":1},{"lineBreak":true},{"text":"“N mi fa ɛ bogi seene soma ɛ yaxune yii e balon na mumɛ,","poem":1},{"lineBreak":true},{"text":"xɔɲɛne mi fa ɛ manpa nɛnɛn minɲɛ mumɛ,","poem":1},{"lineBreak":true},{"text":"ɛ wali xɔnna.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Koni naxanye bogi seene xabama,","poem":1},{"lineBreak":true},{"text":"ne nan e donma","poem":1},{"lineBreak":true},{"text":"e Alatala tantun,","poem":1},{"lineBreak":true},{"text":"naxanye na manpa bogine malan,","poem":1},{"lineBreak":true},{"text":"ne nan e igen minma","poem":1},{"lineBreak":true},{"text":"n ma yire sariɲanxin yinna kui.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɛ mini,","poem":1},{"lineBreak":true},{"text":"ɛ mini taan so dɛɛne ra!","poem":1},{"lineBreak":true},{"text":"Ɛ kirani tɔn yamaan yɛɛ ra!","poem":1},{"lineBreak":true},{"text":"Ɛ kiraan nafala,","poem":1},{"lineBreak":true},{"text":"ɛ a rafala, ɛ gɛmɛne ba a xɔn,","poem":1},{"lineBreak":true},{"text":"ɛ taxamasenni te, a siyane xa fa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛ a mato, Alatala a xuiin naminima","poem":1},{"lineBreak":true},{"text":"han bɔxɔn danne ra,","poem":1},{"lineBreak":true},{"text":"a naxa, “Ɛ a fala Siyon kaane xa,","poem":1},{"lineBreak":true},{"text":"ɛ naxa, ‘Ɛ a mato,","poem":1},{"lineBreak":true},{"text":"ɛ rakisimaan fama!","poem":1},{"lineBreak":true},{"text":"Ɛ a mato, a fama","poem":1},{"lineBreak":true},{"text":"e nun a muxu sɔtɔxine,","poem":1},{"lineBreak":true},{"text":"a kɔntɔnna biraxi a fɔxɔ ra.’ ”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A falama nɛn ne ma","poem":1},{"lineBreak":true},{"text":"a “Yama Sariɲanxina,","poem":1},{"lineBreak":true},{"text":"Alatalaa Muxu Xunbaxine.”","poem":1},{"lineBreak":true},{"text":"A falama nɛn ne ma","poem":1},{"lineBreak":true},{"text":"a “Ala Yamaan Naxan Xɔn Fenxi,","poem":1},{"lineBreak":true},{"text":"Taan Naxan Mi Fa Rabeɲinxi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}