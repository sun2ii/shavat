{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JER","translationId":"yal_pbt","name":"Nabi Yeremi Sora","commonName":"Nabi Yeremi Sora","title":"Yeremi Nabi Yeremi Alaa Falan Naxan Sɛbɛ","order":24,"numberOfChapters":52,"sha256":"14ae4a43c0b828d77b158146170eb03b3661c1e9333029608eefc2ca88061a51","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/yal_pbt/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Alatalaa falan ni ito ra, a naxa,","poem":1},{"lineBreak":true},{"text":"“Isirayila kaane,","poem":1},{"lineBreak":true},{"text":"xa ɛ xun xɛtɛ n ma,","poem":1},{"lineBreak":true},{"text":"xa ɛ xɛtɛ n ma,","poem":1},{"lineBreak":true},{"text":"xa ɛ ɛ suxurene ba n yɛtagi,","poem":1},{"lineBreak":true},{"text":"xa ɛ ba sigɛ na xun xɔn,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"xa ɛ kɔlɔ n tan habadan Alatala yi,","poem":1},{"lineBreak":true},{"text":"ɲɔndin nun kiti kɛndɛn nun tinxinni,","poem":1},{"lineBreak":true},{"text":"nayi, siyane duban sɔtɔma nɛn n tan Ala ra,","poem":1},{"lineBreak":true},{"text":"e yi e kanba n yi.”","poem":1}]},{"type":"verse","number":3,"content":["Amasɔtɔ Alatala ito nan falaxi Yuda bɔnsɔnna muxune nun Yerusalɛn kaane xa, a naxa,",{"text":"“Ɛ xɛ nɛnɛne sɛgɛ,","poem":1},{"lineBreak":true},{"text":"ɛ nama sansiin si ɲanle tagi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛ kafiri bɔɲɛne xa sariɲan","poem":1},{"lineBreak":true},{"text":"alo dɛnkɛlɛyataren na tubi Alatala ma,","poem":1},{"lineBreak":true},{"text":"a banxulan,","poem":1},{"lineBreak":true},{"text":"ɛ tan Yuda bɔnsɔnna muxune nun Yerusalɛn kaane,","poem":1},{"lineBreak":true},{"text":"ɛ tubi","poem":1},{"lineBreak":true},{"text":"alogo n ma xɔlɔn nama godo ɛ ma","poem":1},{"lineBreak":true},{"text":"ɛ kɛwali ɲaxine fe ra","poem":1},{"lineBreak":true},{"text":"alo tɛɛn naxan halagin tima","poem":1},{"lineBreak":true},{"text":"naxan mi nɔɛ ratuyɛ.”","poem":1}]},{"type":"heading","content":["Yaxune fama"]},{"type":"verse","number":5,"content":[{"text":"“Ɛ falani ito rali Yuda yamanani,","poem":1},{"lineBreak":true},{"text":"ɛ yi a rawanga Yerusalɛn taani,","poem":1},{"lineBreak":true},{"text":"ɛ naxa, ‘Ɛ xɔtaan fe yamanan birin yi!’","poem":1},{"lineBreak":true},{"text":"Ɛ a fala ɛ xuini texin na,","poem":1},{"lineBreak":true},{"text":"ɛ naxa, ‘Ɛ malan, en na en gi,","poem":1},{"lineBreak":true},{"text":"sa so taa makantanxine yi!’","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ yɛngɛn taxamasenni te Siyon kaane xa!","poem":1},{"lineBreak":true},{"text":"Ɛ gi, ɛ nama ɛ ti de!","poem":1},{"lineBreak":true},{"text":"Bayo n gbalon nun halagi gbeen nafama nɛn","poem":1},{"lineBreak":true},{"text":"sa keli sogeteden kɔmɛnna ma.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yatan bata mini a yinla ra!","poem":1},{"lineBreak":true},{"text":"Muxun naxan yamanane halagima,","poem":1},{"lineBreak":true},{"text":"na bata kiraan suxu.","poem":1},{"lineBreak":true},{"text":"A bata mini a konni,","poem":1},{"lineBreak":true},{"text":"a xa fa ɛ yamanan kala,","poem":1},{"lineBreak":true},{"text":"a ɛ taane raxɔri,","poem":1},{"lineBreak":true},{"text":"muxu yo mi fa lu e yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nanara, ɛ kasa bɛnbɛli dugine so sununi,","poem":1},{"lineBreak":true},{"text":"ɛ wuga, ɛ gbelegbele,","poem":1},{"lineBreak":true},{"text":"bayo en mi tangama Alatalaa xɔlɔ gbeen ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Alatalaa falan ni ito ra, a naxa,","poem":1},{"lineBreak":true},{"text":"“Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"mangan nun kuntigine tunnaxɔlɔma e ma nɛn,","poem":1},{"lineBreak":true},{"text":"saraxaraline yi yigitɛgɛ.","poem":1},{"lineBreak":true},{"text":"Nabine yi kabɛ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nayi, n yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“Ee! Marigina, Alatala!","poem":1},{"lineBreak":true},{"text":"I bata yamani ito nun Yerusalɛn kaane mayenden,","poem":1},{"lineBreak":true},{"text":"i to a fala, i naxa,","poem":1},{"lineBreak":true},{"text":"‘Ɛ bɔɲɛ xunbenla sɔtɔma nɛn!’","poem":1},{"lineBreak":true},{"text":"Anu, silanfanna yitɔnxi","poem":1},{"lineBreak":true},{"text":"nxu kɔɛ raxaba xinla ma.”","poem":1}]},{"type":"verse","number":11,"content":["Na waxatini, Ala a falama nɛn yamani ito nun Yerusalɛn kaane xa, a naxa,",{"text":"“Foye wolonna fama n ma yamaan ma","poem":1},{"lineBreak":true},{"text":"keli geyane ma tonbonni,","poem":1},{"lineBreak":true},{"text":"a mi fama se fintandeni,","poem":1},{"lineBreak":true},{"text":"a mi se yɛbama.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Foye gbeen nan a ra","poem":1},{"lineBreak":true},{"text":"naxan sa kelixi mɛnni n ma yamarin bun.","poem":1},{"lineBreak":true},{"text":"Iki, n tan nan kitin sama n ma yamaan xili ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yamaan naxa, “A mato!","poem":1},{"lineBreak":true},{"text":"Yaxune nan itoe ra,","poem":1},{"lineBreak":true},{"text":"e tema alo kundana!","poem":1},{"lineBreak":true},{"text":"E yɛngɛ so wontorone fama","poem":1},{"lineBreak":true},{"text":"alo wuluwunla.","poem":1},{"lineBreak":true},{"text":"E soone xulun singbinna xa.","poem":1},{"lineBreak":true},{"text":"Gbalona en xa,","poem":1},{"lineBreak":true},{"text":"bayo en naxɔrimatɔɔn ni i ra!”","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala naxa, “Yerusalɛn kaane,","poem":1},{"lineBreak":true},{"text":"ɛ fe ɲaxin ba ɛ bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa kisi!","poem":1},{"lineBreak":true},{"text":"Ɛ miriya ɲaxine ramarama ɛ yi","poem":1},{"lineBreak":true},{"text":"han waxatin mundun?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bayo, falana nde fama","poem":1},{"lineBreak":true},{"text":"sa keli fɔ Dan yamanani,","poem":1},{"lineBreak":true},{"text":"a halagin nan ma fe ralima","poem":1},{"lineBreak":true},{"text":"sa keli Efirami geyane fari.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɛ siyane rakolon ito ma,","poem":1},{"lineBreak":true},{"text":"ɛ a fala Yerusalɛn kaane xa, ɛ naxa,","poem":1},{"lineBreak":true},{"text":"Sofa ganla fama sa keli yire makuyeni,","poem":1},{"lineBreak":true},{"text":"e xa fa fu taane ma.","poem":1},{"lineBreak":true},{"text":"E yɛngɛ so sɔnxɔni tema Yuda taane xili ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"E Yerusalɛn taan nabilinma nɛn yɛngɛni","poem":1},{"lineBreak":true},{"text":"alo xɛ kantanne,","poem":1},{"lineBreak":true},{"text":"bayo a bata murutɛ n xili ma.”","poem":1},{"lineBreak":true},{"text":"Alatalaa falan nan na ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɛ sigati kiin nun ɛ kɛwanle saren nan na ra.","poem":1},{"lineBreak":true},{"text":"Ɛ fe xɔlɛn ni ito ra,","poem":1},{"lineBreak":true},{"text":"a xɔlɔ mumɛ!","poem":1},{"lineBreak":true},{"text":"A soma nɛn fɔ ɛ bɔɲɛni.","poem":1}]},{"type":"heading","content":["Yeremi a kuisanna lan gbalo famatɔɔn ma"]},{"type":"verse","number":19,"content":[{"text":"N kuisanxi! N kuisanxi!","poem":1},{"lineBreak":true},{"text":"N kutunma tɔrɔyaan ma.","poem":1},{"lineBreak":true},{"text":"Kɔntɔfinla bata n bɔɲɛni li.","poem":1},{"lineBreak":true},{"text":"N bɔɲɛn dinma,","poem":1},{"lineBreak":true},{"text":"n mi nɔɛ n dundɛ!","poem":1},{"lineBreak":true},{"text":"Bayo n bata xɔtaan fe xuiin mɛ,","poem":1},{"lineBreak":true},{"text":"e nun yɛngɛ so sɔnxɔ xuine.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Fitina fena nde nɛma raliyɛ,","poem":1},{"lineBreak":true},{"text":"gbɛtɛ sa fama,","poem":1},{"lineBreak":true},{"text":"bayo halagin bata so yamanan birin yi.","poem":1},{"lineBreak":true},{"text":"N ma bubune birin bata kala,","poem":1},{"lineBreak":true},{"text":"e nun n ma banxine birin sanɲa ma kedenni.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N yɛngɛn taxamasenna toma singanxi","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"N xɔta xuiin mɛma","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ala naxa,","poem":1},{"lineBreak":true},{"text":"“Xaxilitarene nan n ma yamaan na,","poem":1},{"lineBreak":true},{"text":"e mi n kolon.","poem":1},{"lineBreak":true},{"text":"Dii kɔmɔne nan e ra,","poem":1},{"lineBreak":true},{"text":"xaxili yo mi e ma.","poem":1},{"lineBreak":true},{"text":"E fatan fe ɲaxin nan tun ligɛ,","poem":1},{"lineBreak":true},{"text":"e mi a kolon fe faɲin nabama kii naxan yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“N to n yɛɛn ti bɔxɔ xɔnna ra,","poem":1},{"lineBreak":true},{"text":"a yitɔntareyaan nun a yigenla yi lu.","poem":1},{"lineBreak":true},{"text":"N to n yɛɛn ti kore xɔnna ra,","poem":1},{"lineBreak":true},{"text":"kɛnɛnna yi ɲan a yi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"N to n yɛɛn ti geyane ra,","poem":1},{"lineBreak":true},{"text":"e yi xuruxurun","poem":1},{"lineBreak":true},{"text":"yire matexine birin yi yimaxa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N to n yɛɛn ti e ra,","poem":1},{"lineBreak":true},{"text":"muxu yo mi fa lu na,","poem":1},{"lineBreak":true},{"text":"xɔline birin yi e gi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N to n yɛɛn ti yamana sabatixin na,","poem":1},{"lineBreak":true},{"text":"a yi findi tonbonna ra,","poem":1},{"lineBreak":true},{"text":"a taane birin kalaxin yi lu","poem":1},{"lineBreak":true},{"text":"n tan Alatala fitinaxin yɛɛ ra","poem":1},{"lineBreak":true},{"text":"n ma xɔlɔna fe ra.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bayo Alatala ito nan falaxi, a naxa,","poem":1},{"lineBreak":true},{"text":"“Yamanan birin kalama nɛn,","poem":1},{"lineBreak":true},{"text":"koni n mi ɛ raxɔrima.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Na ma, bɔxɔ xɔnna sunuma nɛn,","poem":1},{"lineBreak":true},{"text":"kore xɔnna fan yi yifɔrɔ,","poem":1},{"lineBreak":true},{"text":"bayo n na a fala nɛn,","poem":1},{"lineBreak":true},{"text":"n mi fa nimisama.","poem":1},{"lineBreak":true},{"text":"N bata a feen nagidi,","poem":1},{"lineBreak":true},{"text":"n mi fa xɛtɛma a fɔxɔ ra.”","poem":1}]},{"type":"heading","content":["Yerusalɛn luma nɛn halagin bun"]},{"type":"verse","number":29,"content":[{"text":"Taan muxune birin e gima nɛn","poem":1},{"lineBreak":true},{"text":"soo ragine nun xalimakuli wonle fa xuiin bun,","poem":1},{"lineBreak":true},{"text":"muxuna ndee yi sa e luxun ɲansanne yi,","poem":1},{"lineBreak":true},{"text":"ndee yi so gɛmɛ gbeene longonna ra,","poem":1},{"lineBreak":true},{"text":"taan nabeɲinxin yi lu a yɛtɛ ma.","poem":1},{"lineBreak":true},{"text":"Muxu yo mi fa luma a yi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ɛ tan naxan ma taa kalaxi,","poem":1},{"lineBreak":true},{"text":"ɛ fa nanse ligama?","poem":1},{"lineBreak":true},{"text":"Ɛ fa dugi mamiloxine ragodɛ ɛ ma ba,","poem":1},{"lineBreak":true},{"text":"ɛ yi xɛma maxidi seene so,","poem":1},{"lineBreak":true},{"text":"ɛ ɛ yɛtagine yitɔn?","poem":1},{"lineBreak":true},{"text":"Siyaan naxanye yi ɛ rakunfama","poem":1},{"lineBreak":true},{"text":"alo ɛ yangane,","poem":1},{"lineBreak":true},{"text":"ɛ mi fa rafan ne ma!","poem":1},{"lineBreak":true},{"text":"E waxi ɛ faxa feni.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bayo, n gbelegbele xuina nde mɛma","poem":1},{"lineBreak":true},{"text":"alo ɲaxanla nɛma dii barini,","poem":1},{"lineBreak":true},{"text":"e nun kutun xuina","poem":1},{"lineBreak":true},{"text":"alo ɲaxanla nɛma a dii singen barɛ.","poem":1},{"lineBreak":true},{"text":"Siyon kaane nan xui ne ra,","poem":1},{"lineBreak":true},{"text":"e kutunma,","poem":1},{"lineBreak":true},{"text":"e yiine yibandunma,","poem":1},{"lineBreak":true},{"text":"e yi a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"“Gbalona nxu xa!","poem":1},{"lineBreak":true},{"text":"Muxu faxane nxu niin bamatɔɔn ni i ra.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}