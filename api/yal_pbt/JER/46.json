{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JER","translationId":"yal_pbt","name":"Nabi Yeremi Sora","commonName":"Nabi Yeremi Sora","title":"Yeremi Nabi Yeremi Alaa Falan Naxan Sɛbɛ","order":24,"numberOfChapters":52,"sha256":"14ae4a43c0b828d77b158146170eb03b3661c1e9333029608eefc2ca88061a51","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/yal_pbt/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Alaa falana lan Misiran ma"]},{"type":"verse","number":1,"content":["Alatala falani itoe nan ti Nabi Yeremi xa lan siyane ma:"]},{"type":"verse","number":2,"content":["A ito nan fala lan Misiran yamanan nun Misiran mangan Neko a ganla ma, Babilɔn mangan Nebukadanesari naxan nɔ yɛngɛni Efirati baan dɛ Karakemisi taani, Yuda mangan Yehoyakimi a mangayaan ɲɛɛ naanindeni, Yosiyaa dii xɛmɛna."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ɛ yɛ masansan wure lefa xungbene nun a xurine yitɔn!","poem":1},{"lineBreak":true},{"text":"Ɛ maso, ɛ yɛngɛn so!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛ soone yitɔn,","poem":1},{"lineBreak":true},{"text":"soo ragine xa te e fari!","poem":1},{"lineBreak":true},{"text":"Ɛ xunna makantan wure kɔmɔtine so,","poem":1},{"lineBreak":true},{"text":"ɛ ti ɛ yirene yi!","poem":1},{"lineBreak":true},{"text":"Ɛ tanbane yitɔn!","poem":1},{"lineBreak":true},{"text":"Ɛ kanke yɛ masansanne ragodo ɛ ma!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nanfera, n fa e gaxuxin nan toma iki?","poem":1},{"lineBreak":true},{"text":"E xɛtɛma e xanbi ra,","poem":1},{"lineBreak":true},{"text":"e sofane bata faxa.","poem":1},{"lineBreak":true},{"text":"E xɛtɛma e giyɛ!","poem":1},{"lineBreak":true},{"text":"E e gima, e mi e xanbi rato.","poem":1},{"lineBreak":true},{"text":"E gaxuxin yiren birin yi,”","poem":1},{"lineBreak":true},{"text":"Alatalaa falan nan na ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“Hali xulunlane mi nɔɛ e giyɛ!","poem":1},{"lineBreak":true},{"text":"Hali fangamane mi nɔɛ e futuxulɛ!","poem":1},{"lineBreak":true},{"text":"E sanna radinma,","poem":1},{"lineBreak":true},{"text":"e sa bira","poem":1},{"lineBreak":true},{"text":"fɔ kɔmɛn fɔxɔn yamanani Efirati baan dɛ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Nde ito ra naxan tema","poem":1},{"lineBreak":true},{"text":"alo Nila baana,","poem":1},{"lineBreak":true},{"text":"naxan igeye bɔxɔnma a ma","poem":1},{"lineBreak":true},{"text":"a findi fufaan na?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Misiran nan tema","poem":1},{"lineBreak":true},{"text":"alo Nila baana,","poem":1},{"lineBreak":true},{"text":"naxan igeye bɔxɔnma a ma","poem":1},{"lineBreak":true},{"text":"a findi fufaan na.","poem":1},{"lineBreak":true},{"text":"A a falama, a naxa,","poem":1},{"lineBreak":true},{"text":"‘N tema nɛn,","poem":1},{"lineBreak":true},{"text":"n sa bɔxɔn birin xun ma,","poem":1},{"lineBreak":true},{"text":"n yi taane nun e muxune birin naxɔri.’","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Soo ragine, ɛ te yɛngɛni!","poem":1},{"lineBreak":true},{"text":"Wontoro ragine ɛ fɔn e ma!","poem":1},{"lineBreak":true},{"text":"Sofane, ɛ mini ɛ yɛ masansan wure lefane ra,","poem":1},{"lineBreak":true},{"text":"ɛ tan Kusi kaane nun Puti kaane nun Ludu kaan xali wonle!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Marigina Alatala Sɛnbɛn Birin Kanna nan gbee na lɔxɔn na,","poem":1},{"lineBreak":true},{"text":"a gbeeɲɔxɔ lɔxɔna,","poem":1},{"lineBreak":true},{"text":"a gbeen ɲɔxɔma a yaxune ra lɔxɔn naxan yi.","poem":1},{"lineBreak":true},{"text":"Silanfanna faxan tima nɛn na lɔxɔni","poem":1},{"lineBreak":true},{"text":"han a wasa wunla ra,","poem":1},{"lineBreak":true},{"text":"bayo a luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo saraxana Marigina Alatala Sɛnbɛn Birin Kanna xa,","poem":1},{"lineBreak":true},{"text":"kɔmɛn fɔxɔn yamanani Efirati baan dɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Misiran yama faɲina,","poem":1},{"lineBreak":true},{"text":"ɛ siga Galadi yamanani ɛ sa senna fen.","poem":1},{"lineBreak":true},{"text":"Koni ɛ dandan fɛrɛne fenma fuyan,","poem":1},{"lineBreak":true},{"text":"seri mi fa ɛ yiyalanɲɛ sɔnɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siyane bata i ya yarabina fe mɛ.","poem":1},{"lineBreak":true},{"text":"I gbelegbele xuiin bata bɔxɔn birin suxu.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ sofane tema e bode fari,","poem":1},{"lineBreak":true},{"text":"e birin yi bira.”","poem":1}]},{"type":"heading","content":["Babilɔn mangan yi Misiran yɛngɛ"]},{"type":"verse","number":13,"content":["Alatala falani ito nan ti Nabi Yeremi xa lan Babilɔn mangan Nebukadanesari fa feen ma Misiran yamanan yɛngɛdeni:"]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Ɛ a rawanga Misiran yamanani,","poem":1},{"lineBreak":true},{"text":"Migidoli kaane xa a mɛ,","poem":1},{"lineBreak":true},{"text":"Nofi kaane nun Tapanese kaane xa a mɛ!","poem":1},{"lineBreak":true},{"text":"A fala e xa, ɛ naxa,","poem":1},{"lineBreak":true},{"text":"‘Ɛ keli, ɛ yitɔn,","poem":1},{"lineBreak":true},{"text":"bayo yɛngɛn bata ɛ konna li!’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nanfera ɛ sofane bata raxɔri?","poem":1},{"lineBreak":true},{"text":"E mi tiyɛ,","poem":1},{"lineBreak":true},{"text":"bayo Alatala bata e radin bɔxɔni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A muxu wuyaxi rabirama nɛn.","poem":1},{"lineBreak":true},{"text":"E tema nɛn e bode ma,","poem":1},{"lineBreak":true},{"text":"e bira, e naxa,","poem":1},{"lineBreak":true},{"text":"‘En keli, en xɛtɛ en konne yi,","poem":1},{"lineBreak":true},{"text":"en bari taane!","poem":1},{"lineBreak":true},{"text":"En na en masiga halagi ti yɛngɛni ito ra!’","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"E a falama nɛn mɛnni, e naxa,","poem":1},{"lineBreak":true},{"text":"‘Misiran mangani ito a sɔnxɔn gbo de!","poem":1},{"lineBreak":true},{"text":"Koni na waxatin bata a dan!’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mangana falan ni ito ra","poem":1},{"lineBreak":true},{"text":"naxan xili Alatala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"a naxa, “Habadan Ala nan n na,","poem":1},{"lineBreak":true},{"text":"n bata n kɔlɔ n yɛtɛni,","poem":1},{"lineBreak":true},{"text":"fa fala muxuna nde fama","poem":1},{"lineBreak":true},{"text":"naxan sɛnbɛn gbo","poem":1},{"lineBreak":true},{"text":"alo Taboro geyana geyane tagi,","poem":1},{"lineBreak":true},{"text":"alo Karemele geyana baan dɛxɔn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Misiran kaane, ɛ goronne yitɔn","poem":1},{"lineBreak":true},{"text":"ɛ siga konyiyani!","poem":1},{"lineBreak":true},{"text":"Bayo Nofi taan findima nɛn yire magenla ra,","poem":1},{"lineBreak":true},{"text":"a ganma nɛn,","poem":1},{"lineBreak":true},{"text":"muxu yo mi luma a yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Misiran yamanan findixi ɲinge faɲin nan na.","poem":1},{"lineBreak":true},{"text":"Sigin fama nɛn a xili ma","poem":1},{"lineBreak":true},{"text":"sa keli sogeteden kɔmɛnna ma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Misiran kaane bata xɔɲɛ sofa yɛbaxine ramara e ganli","poem":1},{"lineBreak":true},{"text":"naxanye masuxi e xɔn","poem":1},{"lineBreak":true},{"text":"alo tura raturaxine.","poem":1},{"lineBreak":true},{"text":"Hali ne fan e xun xɛtɛma nɛn,","poem":1},{"lineBreak":true},{"text":"e gi e bode xɔn.","poem":1},{"lineBreak":true},{"text":"E mi tiyɛ e funfuni yɛngɛn lɔxɔni,","poem":1},{"lineBreak":true},{"text":"bayo gbalon lɔxɔn bata fa e ma,","poem":1},{"lineBreak":true},{"text":"n na e kɛwanle saranma e ra lɔxɔn naxan yi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Misiran kaane e gima nɛn","poem":1},{"lineBreak":true},{"text":"e yaxu sɛnbɛmane bun","poem":1},{"lineBreak":true},{"text":"alo saɲina.","poem":1},{"lineBreak":true},{"text":"E fama e xili ma nɛn","poem":1},{"lineBreak":true},{"text":"e nun bunbine,","poem":1},{"lineBreak":true},{"text":"alo naxanye wudine sɛgɛma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Alatalaa falan ni ito ra,","poem":1},{"lineBreak":true},{"text":"e a fɔtɔnna sɛgɛma nɛn,","poem":1},{"lineBreak":true},{"text":"hali muxun mi nɔɛ soɛ fɔtɔnna naxan na","poem":1},{"lineBreak":true},{"text":"bayo e wuya alo tuguminne,","poem":1},{"lineBreak":true},{"text":"e yatɛn mi nɔɛ kolonɲɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yagin nan a ra Misiran yamana faɲin xa.","poem":1},{"lineBreak":true},{"text":"A bata sa yamaan sagoni,","poem":1},{"lineBreak":true},{"text":"naxanye sa kelixi kɔmɛnna ma.”","poem":1}]},{"type":"verse","number":25,"content":["Alatala Sɛnbɛn Birin Kanna, Isirayilaa Ala naxa, “N kelima nɛn No taana ala xili ma, Amɔn e nun Misiran yamanan nun a mangan nun a alane nun a kuntigine e nun naxanye birin e yigi sama Misiran mangani."]},{"type":"verse","number":26,"content":["N na e sama nɛn e yaxune sagoni, naxanye waxi e faxa feni, Babilɔn mangan Nebukadanesari nun a kuntigine. Na xanbi ra, muxune mɔn yi dɔxɔ Misiran yi alo a fɔlɔni,” Alatalaa falan nan na ra."]},{"type":"heading","content":["Isirayila xunbana fe"]},{"type":"verse","number":27,"content":[{"text":"“Ɛ tan Yaxuba yixɛtɛne,","poem":1},{"lineBreak":true},{"text":"n ma walikɛne, ɛ nama gaxu,","poem":1},{"lineBreak":true},{"text":"Isirayila kaane, ɛ nama kuisan!","poem":1},{"lineBreak":true},{"text":"Bayo, n na ɛ rakisima nɛn,","poem":1},{"lineBreak":true},{"text":"n yi sa ɛ ba yire makuyeni,","poem":1},{"lineBreak":true},{"text":"n yi ɛ bɔnsɔnna ba yamanani","poem":1},{"lineBreak":true},{"text":"e sa konyiyani dɛnaxan yi.","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔnna muxune mɔn xɛtɛma nɛn,","poem":1},{"lineBreak":true},{"text":"e yi lu maraxaran nun bɔɲɛ xunbenli.","poem":1},{"lineBreak":true},{"text":"E mi fa yimaxɛ sɔnɔn!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Alatalaa falan ni ito ra, a naxa,","poem":1},{"lineBreak":true},{"text":"‘Ɛ tan Yaxuba yixɛtɛne,","poem":1},{"lineBreak":true},{"text":"n ma walikɛne, ɛ nama gaxu,","poem":1},{"lineBreak":true},{"text":"bayo n luma nɛn ɛ xɔn.","poem":1},{"lineBreak":true},{"text":"N siyane birin naxɔrɛ nɛn,","poem":1},{"lineBreak":true},{"text":"n na ɛ raxuyaxi ayi naxanye yɛ,","poem":1},{"lineBreak":true},{"text":"koni n mi ɛ tan naxɔrima.","poem":1},{"lineBreak":true},{"text":"N na ɛ xuruma nɛn","poem":1},{"lineBreak":true},{"text":"alo a lan kii naxan yi,","poem":1},{"lineBreak":true},{"text":"bayo n mi ɛ yatɛma sɔntarene ra.’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}