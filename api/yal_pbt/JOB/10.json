{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"heading","content":["Yuba mɔn yi yabin ti"]},{"type":"verse","number":1,"content":["Yuba mɔn yi a fala, a naxa,",{"text":"“N ma siimayaan bata raɲaxu n ma,","poem":1},{"lineBreak":true},{"text":"n mi fa n ma mawugane danma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"n na n ma sɔxɔlɛn falama nɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na a falama nɛn Ala xa, n naxa:","poem":1},{"lineBreak":true},{"text":"I nama n yalagi,","poem":1},{"lineBreak":true},{"text":"a yita n na nanfera i xɔlɔxi n ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɲaxankatan findɛ fe faɲin na i tan xa ba?","poem":1},{"lineBreak":true},{"text":"I yɛtɛ wali xɔnna rawolɛ ayi ba?","poem":1},{"lineBreak":true},{"text":"I yi muxu ɲaxine feene rasabati?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I toon tima i muxu yɛɛne nan na ba,","poem":1},{"lineBreak":true},{"text":"i toon tima nɛn alo adamadiine ba?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I ya siimayaan luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo adamadiine gbeen ba?","poem":1},{"lineBreak":true},{"text":"I ya lɔxɔne luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo muxune gbeen ba?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanfera i yi n hakɛne fenma,","poem":1},{"lineBreak":true},{"text":"i yi n yulubine xɔnfen?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Anu, i a kolon a muxu ɲaxi mi n na,","poem":1},{"lineBreak":true},{"text":"muxu yo mɔn mi nɔɛ n nakisɛ i yii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I tan nan n daxi,","poem":1},{"lineBreak":true},{"text":"i yiine yi n nafala,","poem":1},{"lineBreak":true},{"text":"koni iki, i waxi n naxɔri feni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N ma fe xa rabira i ma,","poem":1},{"lineBreak":true},{"text":"a i n nafalaxi nɛn","poem":1},{"lineBreak":true},{"text":"alo bɛndɛ yi sena,","poem":1},{"lineBreak":true},{"text":"i mɔn waxi n naxɛtɛ feen nin bɛndɛni ba?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I n nafala nɛn nga fatini,","poem":1},{"lineBreak":true},{"text":"alo nɔnɔn naxan findin fɛnɛn na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I yi fati bɛndɛn nun fati kidin sa n ma,","poem":1},{"lineBreak":true},{"text":"i yi n nafala xɔnne nun fasane ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I mɔn yi siimayaan fi n ma,","poem":1},{"lineBreak":true},{"text":"i hinan n na,","poem":1},{"lineBreak":true},{"text":"i yi n niin nakantan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Koni, i yi wundo feni ito luxunxi i bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"n na i ya miriyani ito kolon,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"fa fala xa n yulubin liga,","poem":1},{"lineBreak":true},{"text":"i nɔɛ n toɛ nɛn,","poem":1},{"lineBreak":true},{"text":"i mɔn mi diɲɛ n hakɛn ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Xa muxu ɲaxin nan n na nun,","poem":1},{"lineBreak":true},{"text":"gbalona n xa!","poem":1},{"lineBreak":true},{"text":"Hali n tinxin,","poem":1},{"lineBreak":true},{"text":"n mi nɔɛ n xunna rakelɛ,","poem":1},{"lineBreak":true},{"text":"n tan naxan nafexi yagin nun tɔrɔn na.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xa n nan n xunna rakeli,","poem":1},{"lineBreak":true},{"text":"i n kedima nɛn alo yatana,","poem":1},{"lineBreak":true},{"text":"i mɔn yi i ya kabanako feene ragodo n xili ma han!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I mɔn i ya gbalone rakelima n xili ma,","poem":1},{"lineBreak":true},{"text":"i ya xɔlɔn xun masama n xili ma,","poem":1},{"lineBreak":true},{"text":"i ya ganle biraxi e bode fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"n yɛngɛ xinla ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Nanfera i naminixi nga kuini?","poem":1},{"lineBreak":true},{"text":"Hali n yi faxa nun, muxu yo mi n to,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"n lu alo n mi da,","poem":1},{"lineBreak":true},{"text":"n ba nga kuini,","poem":1},{"lineBreak":true},{"text":"n sa maluxun gaburun na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N ma lɔxɔne mi fa wuya sɔnɔn,","poem":1},{"lineBreak":true},{"text":"nayi, a lu, n xa sɛwa ndedi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"benun n xa siga yamanani","poem":1},{"lineBreak":true},{"text":"xɛtɛ mi dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"dɛnaxan nafexi dimin nun sayaan nininna ra,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"yamana yifɔrɛna alo dimina,","poem":1},{"lineBreak":true},{"text":"sayaan nininna nun kalan dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"kɛnɛnna luxi dɛnaxan yi alo dimina.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}