{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Sofara yi falan ti Yuba xa"]},{"type":"verse","number":1,"content":["Nama kaan Sofara yi falan tongo, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“Fala wuyaxini itoe yabi mi na ba?","poem":1},{"lineBreak":true},{"text":"Falan nan tun yoon fima muxun ma ba?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muxune dundɛ i ya fala ɲaxine bun ma ba?","poem":1},{"lineBreak":true},{"text":"I magelen tiyɛ ba, muxe mi i rayagi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I a falama, i naxa,","poem":1},{"lineBreak":true},{"text":"‘N ma fekolonna sariɲan,","poem":1},{"lineBreak":true},{"text":"fɛ yo mi n na Ala yɛtagi.’","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Koni, xa Ala yi waxi falan ti feni nun,","poem":1},{"lineBreak":true},{"text":"xa a yi a dɛni biyɛ a falan ti i xa nun,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"xa a yi a fekolonna wundone fala i xa,","poem":1},{"lineBreak":true},{"text":"naxanye fan xaxinla xa,","poem":1},{"lineBreak":true},{"text":"nayi, i yi a kolonma nɛn","poem":1},{"lineBreak":true},{"text":"a Ala mi i hakɛne birin saranxi i ra.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“I nɔɛ Ala miriyane kolonɲɛ?","poem":1},{"lineBreak":true},{"text":"I nɔɛ Ala Sɛnbɛ Kanna sɛnbɛn danna kolonɲɛ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A mate dangu kore xɔnna ra.","poem":1},{"lineBreak":true},{"text":"I nanse ligɛ? A tilin laxira xa.","poem":1},{"lineBreak":true},{"text":"I nanse famuma?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A kuya dangu bɔxɔn na,","poem":1},{"lineBreak":true},{"text":"a gbo dangu fɔxɔ ige baan na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xa Ala fa muxune suxɛ,","poem":1},{"lineBreak":true},{"text":"xa a e xili kiti sadeni,","poem":1},{"lineBreak":true},{"text":"nde nɔɛ a matandɛ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amasɔtɔ, Ala fuyantenne kolon,","poem":1},{"lineBreak":true},{"text":"a na hakɛn to,","poem":1},{"lineBreak":true},{"text":"a mi a yɛɛn naxiyɛ a ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Koni, kɔmɔn mi nɔɛ findɛ xaxilimaan na,","poem":1},{"lineBreak":true},{"text":"alo sofali xuruxin to mi barɛ burunna ra.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“I bɔɲɛn nafindi Ala ma,","poem":1},{"lineBreak":true},{"text":"i yiin ti a tan xa,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"i mɛ i hakɛne ra,","poem":1},{"lineBreak":true},{"text":"i nama tin tinxintareyaan yi so i konni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nayi, fɛ mi luma i ra,","poem":1},{"lineBreak":true},{"text":"i xunna kenla sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"i findi muxu kɛndɛn na,","poem":1},{"lineBreak":true},{"text":"i mi fa gaxuma sese ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I ɲinanma nɛn i ya sɔxɔlɛne ra,","poem":1},{"lineBreak":true},{"text":"i ɲinanma nɛn e xɔn","poem":1},{"lineBreak":true},{"text":"alo igen naxan danguma xude wunla ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I ya siimayaan makɛnɛnma nɛn","poem":1},{"lineBreak":true},{"text":"alo yanyi tagina,","poem":1},{"lineBreak":true},{"text":"a dimin yi lu alo xɔtɔnna.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I lannayaan sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"bayo i yigin sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"Ala i rakantanma nɛn","poem":1},{"lineBreak":true},{"text":"i lu bɔɲɛ xunbenli.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Muxu yo mi fa i raxulunɲɛ i ya xixɔnli,","poem":1},{"lineBreak":true},{"text":"muxu wuyaxi fama nɛn i xandideni.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Koni, ɲaxudene yɛɛn danxuma nɛn,","poem":1},{"lineBreak":true},{"text":"e yigin kalama nɛn,","poem":1},{"lineBreak":true},{"text":"e yengi fa tixi sayaan nan na.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}