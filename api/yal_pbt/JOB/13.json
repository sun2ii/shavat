{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"heading","content":["Yuba yi wa falan ti feni Ala xa"]},{"type":"verse","number":1,"content":["Yuba mɔn yi a fala, a naxa,",{"text":"“A mato, n yɛɛn bata na birin to,","poem":1},{"lineBreak":true},{"text":"n tunla bata na birin mɛ,","poem":1},{"lineBreak":true},{"text":"n yi a famu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ naxan kolon,","poem":1},{"lineBreak":true},{"text":"n fan na kolon,","poem":1},{"lineBreak":true},{"text":"ɛ mi dangu n na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Koni, n tan waxi","poem":1},{"lineBreak":true},{"text":"falan ti feni Ala Sɛnbɛ Kanna nan xa,","poem":1},{"lineBreak":true},{"text":"n waxi n xa n mawuga Ala xa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koni ɛ tan wulen nan tun sama ɲɔndin yɛ ma,","poem":1},{"lineBreak":true},{"text":"ɛ birin findixi dandan ti fuyanne nan na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xa ɛ yi ɛ dundɛ nun,","poem":1},{"lineBreak":true},{"text":"na yi findɛ ɛ fekolonna ra nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ n ma mawugan namɛ,","poem":1},{"lineBreak":true},{"text":"ɛ tuli mati n ma mawuga xuiin na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ala makoon luyɛ ɛ tinxintareyaan ma ba,","poem":1},{"lineBreak":true},{"text":"ɛ wulene fala Ala mali feen na?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɛ waxi ɛ sa feni Ala nan fari n xili ma ba?","poem":1},{"lineBreak":true},{"text":"Ɛ Ala nan xun mafalama ba?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A na ɛ miriyane yatɛ,","poem":1},{"lineBreak":true},{"text":"na fanɲɛ ɛ ra ba?","poem":1},{"lineBreak":true},{"text":"Ɛ nɔɛ a yanfɛ ba alo muxuna?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɲɔndin naxan na,","poem":1},{"lineBreak":true},{"text":"ɛ na kitin sa yɛtagin ma hali wundoni,","poem":1},{"lineBreak":true},{"text":"Ala falan tima nɛn ɛ xili ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛ mi gaxuma a binyen yɛɛ ra ba?","poem":1},{"lineBreak":true},{"text":"A magaxun mi ɛ suxɛ ba?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɛ sandane luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo xubena,","poem":1},{"lineBreak":true},{"text":"ɛ xun mafala falane kalama nɛn","poem":1},{"lineBreak":true},{"text":"alo bɛndɛna.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ɛ dundu, ɛ n lu!","poem":1},{"lineBreak":true},{"text":"N xa falan ti","poem":1},{"lineBreak":true},{"text":"hali sese n sɔtɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nanfera n nan n fati bɛndɛn xinɲɛ n ɲinne ra,","poem":1},{"lineBreak":true},{"text":"nanfera n tinɲɛ sayaan ma?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Xa Ala wa, a xa n faxa,","poem":1},{"lineBreak":true},{"text":"n yengi mi fa sese ma","poem":1},{"lineBreak":true},{"text":"koni n waxi n sigati kiin xɔnba feni","poem":1},{"lineBreak":true},{"text":"a tan nan yɛtagi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Na yɛtɛɛn findima n ma kisin nan na,","poem":1},{"lineBreak":true},{"text":"bayo Ala kolontare yo mi tima a yɛtagi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɛ tuli mati n ma falan na a faɲin na,","poem":1},{"lineBreak":true},{"text":"n ma fe yɛ xaranna xa so ɛ tunla ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N bata n xun mafala feni tɔn,","poem":1},{"lineBreak":true},{"text":"n na a kolon a ɲɔndina n tan nan xa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nde waxi n xun maxidi feni?","poem":1},{"lineBreak":true},{"text":"Nayi, xa ɲɔndi mi n xa,","poem":1},{"lineBreak":true},{"text":"n tinxi n yi n dundu, n faxa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“N ma Ala,","poem":1},{"lineBreak":true},{"text":"fe firin gbansan masiga n na,","poem":1},{"lineBreak":true},{"text":"nayi, n mi luxunɲɛ i ma:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I ya xɔlɔn masiga n na,","poem":1},{"lineBreak":true},{"text":"i ya magaxun nama fa n suxu sɔnɔn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Na xanbi ra, falan ti n xa,","poem":1},{"lineBreak":true},{"text":"n ni i yabɛ,","poem":1},{"lineBreak":true},{"text":"hanma n yi falan ti, i yi n yabi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yoli n hakɛne nun n yulubine yatɛn na?","poem":1},{"lineBreak":true},{"text":"N ma murutɛ feene nun n ma yulubine yita n na.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nanfera i yɛtagin luxunma n ma,","poem":1},{"lineBreak":true},{"text":"i yi n yatɛ i yaxun na?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"I n tan nan magaxuma ba,","poem":1},{"lineBreak":true},{"text":"n tan naxan luxi","poem":1},{"lineBreak":true},{"text":"alo ɲɔxɔndena foyen sigan naxan na?","poem":1},{"lineBreak":true},{"text":"I n tan nan sagatanma ba,","poem":1},{"lineBreak":true},{"text":"n tan naxan luxi","poem":1},{"lineBreak":true},{"text":"alo malo dagi xarena?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I fe xɔlɛne sɛbɛma n xili ma,","poem":1},{"lineBreak":true},{"text":"i n ma dii ɲɔrɛyaan hakɛn goronna dɔxɔ n xun ma.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"I n sanne sama kutun na,","poem":1},{"lineBreak":true},{"text":"i yɛɛn tixi n sigati kiin birin na,","poem":1},{"lineBreak":true},{"text":"hali n san funfune,","poem":1},{"lineBreak":true},{"text":"i e birin nakɔrɔsima.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Koni, adamadiine kunma","poem":1},{"lineBreak":true},{"text":"alo wudi kalaxi,","poem":1},{"lineBreak":true},{"text":"alo xiine dugin kala kii naxan yi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}