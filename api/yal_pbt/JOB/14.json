{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["Yuba mɔn yi yabin ti"]},{"type":"verse","number":1,"content":["Yuba mɔn yi a fala, a naxa,",{"text":"“Adamadiin minixi ɲaxanla nin,","poem":1},{"lineBreak":true},{"text":"a siimayaan mi xunkuya,","poem":1},{"lineBreak":true},{"text":"a rafexi lanbaranna nan na,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"a luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo wudi fugen naxan minima,","poem":1},{"lineBreak":true},{"text":"a xara, alo nininna, a mi buma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma Ala,","poem":1},{"lineBreak":true},{"text":"i yɛɛn tima n tan nan na ba","poem":1},{"lineBreak":true},{"text":"naxan luxi alo adamadiin bodene?","poem":1},{"lineBreak":true},{"text":"I kitin nasoma en tan nan tagi ba?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nde nɔɛ se sariɲanxin bɛ se haramuxini?","poem":1},{"lineBreak":true},{"text":"Muxu yo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I bata muxuna siimayaan danna ragidi,","poem":1},{"lineBreak":true},{"text":"i yi a siimayaan kikene yatɛ,","poem":1},{"lineBreak":true},{"text":"a mi danguɛ naxanye ra","poem":1},{"lineBreak":true},{"text":"i naxanye saxi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanara, i yɛɛn ba muxun na,","poem":1},{"lineBreak":true},{"text":"a xa a matabu,","poem":1},{"lineBreak":true},{"text":"alogo a xa a waxatin naɲan bɔɲɛ xunbenli","poem":1},{"lineBreak":true},{"text":"alo walikɛɛn yanyin naɲanma kii naxan yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Yigin wudin tan ma,","poem":1},{"lineBreak":true},{"text":"bayo a na sɛgɛ, a mɔn yi mini,","poem":1},{"lineBreak":true},{"text":"a ɲɔxɔn mi ɲanma,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"hali a salenna fori bɔxɔni,","poem":1},{"lineBreak":true},{"text":"a xun dungin yi faxa bɔxɔni,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"igen nɛɛn fa sa a ma tun,","poem":1},{"lineBreak":true},{"text":"a mɔn bata a mabun,","poem":1},{"lineBreak":true},{"text":"a yi a ɲingine ramini","poem":1},{"lineBreak":true},{"text":"alo a yi kii naxan yi a fɔlɔni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni, xa muxun faxa,","poem":1},{"lineBreak":true},{"text":"a sɛnbɛn bata ɲan.","poem":1},{"lineBreak":true},{"text":"Muxun na faxa, a sigan minɛn?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Igen ɲanma nɛn baani,","poem":1},{"lineBreak":true},{"text":"xudene yi xara.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Muxun na faxa,","poem":1},{"lineBreak":true},{"text":"a ɲanma na kii nin,","poem":1},{"lineBreak":true},{"text":"a mi fa kelima sɔnɔn,","poem":1},{"lineBreak":true},{"text":"fanni kore xɔnna na,","poem":1},{"lineBreak":true},{"text":"a mi xulunma,","poem":1},{"lineBreak":true},{"text":"a mi kelima a xixɔnli.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Xa i yi tinɲɛ n luxunɲɛ laxira yi nun,","poem":1},{"lineBreak":true},{"text":"n yi lu na han i ya xɔlɔn yi ɲan!","poem":1},{"lineBreak":true},{"text":"I mɔn yi waxatin nagidi n ma,","poem":1},{"lineBreak":true},{"text":"n ma fe rabirama i ma waxatin naxan yi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Koni muxun naxan bata faxa,","poem":1},{"lineBreak":true},{"text":"na mɔn kelɛ ba?","poem":1},{"lineBreak":true},{"text":"N diɲama nɛn n ma wali waxatin bun,","poem":1},{"lineBreak":true},{"text":"han i fa n naxulunma waxatin naxan yi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nayi, n ni i yabɛ, i na n xili,","poem":1},{"lineBreak":true},{"text":"i na wa n to feni,","poem":1},{"lineBreak":true},{"text":"i tan naxan n daxi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Anu iki, i n sigati kiin birin yatɛxi.","poem":1},{"lineBreak":true},{"text":"Koni na waxatini,","poem":1},{"lineBreak":true},{"text":"i mi fa n yulubine yatɛma,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"i n ma murutɛ feene luxunma nɛn bɛnbɛnla kui,","poem":1},{"lineBreak":true},{"text":"i yi n hakɛne mafelu.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Koni, hali geyane,","poem":1},{"lineBreak":true},{"text":"nde luma bɛ e ra waxatin birin","poem":1},{"lineBreak":true},{"text":"han e xuya ayi,","poem":1},{"lineBreak":true},{"text":"hali fanyene,","poem":1},{"lineBreak":true},{"text":"e bama e funfuni a xunxuri yɛɛn ma,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"igen luma nde bɛ gɛmɛne ra,","poem":1},{"lineBreak":true},{"text":"baa walanxine yi bɔxɔn tongo,","poem":1},{"lineBreak":true},{"text":"i fan adamadiine yigin kalama na kii nin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I muxune yɛngɛma habadan,","poem":1},{"lineBreak":true},{"text":"e yi faxa,","poem":1},{"lineBreak":true},{"text":"i yi e yɛtagin masara, i yi e kedi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Xa binyena e diine ma,","poem":1},{"lineBreak":true},{"text":"e mi na kolon.","poem":1},{"lineBreak":true},{"text":"Xa e rayarabi, e mi na yigbɛma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A tan nan tun a tɔrɔn kolon,","poem":1},{"lineBreak":true},{"text":"a sunuxi a yɛtɛ nan tun ma fe ra.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}