{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"heading","content":["Yuba yigin yi kala"]},{"type":"verse","number":1,"content":["Yuba mɔn yi a fala, a naxa,",{"text":"“N yengin dasama,","poem":1},{"lineBreak":true},{"text":"n ma siimayaan yi ɲan,","poem":1},{"lineBreak":true},{"text":"gaburun dɔxi n yɛɛ ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Magele tiine n nabilinni yati,","poem":1},{"lineBreak":true},{"text":"e fa fuma n ma, n mi nɔɛ xiyɛ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Ala, i bata tolimaan naxan maxɔdin n ma,","poem":1},{"lineBreak":true},{"text":"i yɛtɛɛn xa na so n yii.","poem":1},{"lineBreak":true},{"text":"Xa i tan mi a ra,","poem":1},{"lineBreak":true},{"text":"nde gbɛtɛ n ma donla goronna tongɛ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bayo i bata xaxinla birin ba n xɔyine yi,","poem":1},{"lineBreak":true},{"text":"na ma, i nama tin e xa nɔɔn sɔtɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo muxun naxan yanfan soma a xɔyine xili ma,","poem":1},{"lineBreak":true},{"text":"na yi findi tɔrɔn na a diine xa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Muxune n magelema e sigine yi,","poem":1},{"lineBreak":true},{"text":"e dɛgen namini n yɛtagi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N yɛɛne bata yidimi sununi,","poem":1},{"lineBreak":true},{"text":"n fati bɛndɛn bata yelefu ayi alo a nininna.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Muxu faɲine na n to,","poem":1},{"lineBreak":true},{"text":"n kiin yi e ratɛrɛna,","poem":1},{"lineBreak":true},{"text":"sɔntarene xɔlɔma n ma,","poem":1},{"lineBreak":true},{"text":"e yi n yatɛ Ala kolontaren na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Koni, tinxin muxune xa lu e kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"naxanye sariɲan, ne sɛnbɛn sɔtɔma nɛn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni ɛ tan, ɛ xɛtɛ, ɛ mɔn xa fa.","poem":1},{"lineBreak":true},{"text":"N mi fekolon toma ɛ yɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma siimayaan bata ɲan,","poem":1},{"lineBreak":true},{"text":"n ma wanle bata kala,","poem":1},{"lineBreak":true},{"text":"n waxɔn feene bata kala.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N xɔyine a falama, e naxa,","poem":1},{"lineBreak":true},{"text":"a kɔɛɛn findima nɛn a yanyin na,","poem":1},{"lineBreak":true},{"text":"fitirin na so, e fala a subaxan na a ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N xa n yigi sa laxira yi tun ba,","poem":1},{"lineBreak":true},{"text":"n na n sama dimini dɛnaxan yi?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N falan tima nɛn n gaburun xa","poem":1},{"lineBreak":true},{"text":"alo a tan nan n fafe ra.","poem":1},{"lineBreak":true},{"text":"N falan ti kunle xa","poem":1},{"lineBreak":true},{"text":"alo e tan nan nga nun n magilɛn na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nayi, n yigin minɛn?","poem":1},{"lineBreak":true},{"text":"Nde n yigin toɛ?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yigin laxira yi ba,","poem":1},{"lineBreak":true},{"text":"nxu birin na siga nxu sa nxu sa burunburunni?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}