{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Bilidadaa falan firindena: Fe ɲaxi rabane saranna"]},{"type":"verse","number":1,"content":["Suxa kaan Bilidada mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“I falan danma waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"Xaxili fen, na xanbi ra, en falan tiyɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanfera i nxu yatɛxi xuruseene ra?","poem":1},{"lineBreak":true},{"text":"Nanfera i nxu mirixi xaxilitarene ra?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuba, i tan nan i yɛtɛ maxɔlɔxi i ya xɔlɔni.","poem":1},{"lineBreak":true},{"text":"I laxi a ra a muxune dunuɲa rabeɲinma","poem":1},{"lineBreak":true},{"text":"i tan ma fe ra ba?","poem":1},{"lineBreak":true},{"text":"Fanyen xa keli a dɔxɔdeni i ya fe ra ba?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ɲaxudena tɛɛ dɛgɛn tuma nɛn,","poem":1},{"lineBreak":true},{"text":"a tanden yalanna yi ɲan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛnɛnna yi findi dimin na a konni,","poem":1},{"lineBreak":true},{"text":"a lɛnpun yi tu a xun ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“A madiganma nɛn a sigatiin sɛnbɛni,","poem":1},{"lineBreak":true},{"text":"a feene a rabirama nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A sanne suxuma nɛn yalaan na,","poem":1},{"lineBreak":true},{"text":"a sin yinla ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A suxuma a san tinban nan ma,","poem":1},{"lineBreak":true},{"text":"gbatun yi a suxu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lutin natixi a yɛɛ ra bɔxɔn nin,","poem":1},{"lineBreak":true},{"text":"wosona a kiraan xɔn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gaxun luma ayi nɛn yiren birin yi,","poem":1},{"lineBreak":true},{"text":"a bira a san funfun fɔxɔ ra.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“A tan naxan sɛnbɛ yi gbo,","poem":1},{"lineBreak":true},{"text":"a sɛnbɛn bata ɲan,","poem":1},{"lineBreak":true},{"text":"gbalon bata maso a ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Furen bata a fati kidin kala,","poem":1},{"lineBreak":true},{"text":"saya furen bata a salen seene kun a ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sayaan bata a suxu a konni,","poem":1},{"lineBreak":true},{"text":"a yigi saxi dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"a yi a xali manga magaxuxin fɛma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Muxu gbɛtɛ nɔɛ dɔxɛ nɛn a konni sɔnɔn,","poem":1},{"lineBreak":true},{"text":"a gbee mi fa a ra,","poem":1},{"lineBreak":true},{"text":"seri fuɲin bata sa a konna birin ma.","poem":1},{"noteId":7}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A bata lu","poem":1},{"lineBreak":true},{"text":"alo wudin salenne na xara a bun,","poem":1},{"lineBreak":true},{"text":"a dɛɛne yi xara a ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“A funfun birin bata ɲan bɔxɔn fari,","poem":1},{"lineBreak":true},{"text":"a xinla mi fa falama kiraan xɔn sɔnɔn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A bata radin dimini keli kɛnɛnna ma,","poem":1},{"lineBreak":true},{"text":"a yi ɲan dunuɲa yi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dii yo mi a yii,","poem":1},{"lineBreak":true},{"text":"mayixɛtɛ yo mi a xanbi ra,","poem":1},{"lineBreak":true},{"text":"muxu yo mi fa a konni sɔnɔn.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Muxun naxanye sogeteden binni,","poem":1},{"lineBreak":true},{"text":"ne kabɛma nɛn a raɲanna ma,","poem":1},{"lineBreak":true},{"text":"muxun naxanye sogegododen binni,","poem":1},{"lineBreak":true},{"text":"gaxun yi ne suxu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tinxintarena denbayaan luma na kii nin,","poem":1},{"lineBreak":true},{"text":"Ala kolontaren nan kon na ra.”","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"18.15 Na seri fuɲinsama faxa muxun konna ma nɛn alogo na xa rasariɲan.","reference":{"chapter":18,"verse":15}}]},"thisChapterLink":"/api/yal_pbt/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}