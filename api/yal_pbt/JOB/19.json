{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Yuba yi Bilidada yabi"]},{"type":"verse","number":1,"content":["Yuba yi a yabi, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“Ɛ luma n ɲaxankatɛ","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi,","poem":1},{"lineBreak":true},{"text":"ɛ n sɔxɔlɛ ɛ falane ra?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ bata n konbi","poem":1},{"lineBreak":true},{"text":"han sanɲa ma fu,","poem":1},{"lineBreak":true},{"text":"ɛ mi yagɛ n tɔrɛ sɔnɔn ba?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hali n bata tantan,","poem":1},{"lineBreak":true},{"text":"n ma tantanna goronna luma n tan nan xun ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xa ɛ ɛ yɛtɛ yite n xili ma,","poem":1},{"lineBreak":true},{"text":"ɛ yi n mafala n yagi feen na,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"nayi, ɛ xa a kolon","poem":1},{"lineBreak":true},{"text":"a Ala nan tɔrɔni ito ragidixi n ma,","poem":1},{"lineBreak":true},{"text":"a n mafilin a yalani.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xa n gbelegbele tɔrɔni ito bun,","poem":1},{"lineBreak":true},{"text":"n mi yabi sɔtɔma.","poem":1},{"lineBreak":true},{"text":"N na xinla ti n mali feen na,","poem":1},{"lineBreak":true},{"text":"kiti kɛndɛn mi sɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala bata kiraan suxu n yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"n mi nɔɛ danguɛ,","poem":1},{"lineBreak":true},{"text":"a yi dimin naso n ma kiraan xɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A bata n ma binyen ba n yi,","poem":1},{"lineBreak":true},{"text":"a yi n ma xunna kenla ba n yi","poem":1},{"lineBreak":true},{"text":"naxan yi luxi","poem":1},{"lineBreak":true},{"text":"alo manga kɔmɔtina n xa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A bata n kala yiren birin yi,","poem":1},{"lineBreak":true},{"text":"n naxɔrima nɛn.","poem":1},{"lineBreak":true},{"text":"A bata n yigin kala","poem":1},{"lineBreak":true},{"text":"alo wudin talaxina.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A bata xɔlɔ n xili ma han,","poem":1},{"lineBreak":true},{"text":"a yi n yatɛ a yaxun na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yɛngɛsone bata e malan,","poem":1},{"lineBreak":true},{"text":"e fa n xili ma,","poem":1},{"lineBreak":true},{"text":"e yi n konna rabilin.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“A bata ngaxakedenne masiga n na,","poem":1},{"lineBreak":true},{"text":"naxanye n kolon,","poem":1},{"lineBreak":true},{"text":"ne bata siga ayi pon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N kon kaane bata n nabeɲin,","poem":1},{"lineBreak":true},{"text":"n lanfane yi ɲinan n xɔn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N ma muxune","poem":1},{"lineBreak":true},{"text":"nun n ma walikɛ ɲaxanle birin n yatɛxi","poem":1},{"lineBreak":true},{"text":"alo xɔɲɛna,","poem":1},{"lineBreak":true},{"text":"n bata findi xɔɲɛn na e yɛɛ ra yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N na n ma walikɛɛn xilima,","poem":1},{"lineBreak":true},{"text":"koni a mi n yabima,","poem":1},{"lineBreak":true},{"text":"hali n na a mafan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N ma ɲaxanla mi fa tinɲɛ n dɛɛn xirin ma,","poem":1},{"lineBreak":true},{"text":"n ma fe bata raɲaxu n ma denbayaan ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Hali dii ɲɔrɛne,","poem":1},{"lineBreak":true},{"text":"n naɲaxu e birin ma,","poem":1},{"lineBreak":true},{"text":"n na keli, e n mafala.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N naɲaxu n xɔyi kɛndɛne birin ma,","poem":1},{"lineBreak":true},{"text":"hali naxanye rafan n ma,","poem":1},{"lineBreak":true},{"text":"ne bata e xun xanbi so n yii.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N bata doyen,","poem":1},{"lineBreak":true},{"text":"n kidin nun n xɔnne nan gbansan fan n ma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N xɔyine,","poem":1},{"lineBreak":true},{"text":"ɛ kininkinin n ma,","poem":1},{"lineBreak":true},{"text":"ɛ kininkinin n ma,","poem":1},{"lineBreak":true},{"text":"bayo Ala sɛnbɛn bata n ɲaxankata!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nanfera ɛ n sagatanma alo Ala?","poem":1},{"lineBreak":true},{"text":"Ɛ munma wasa n ɲaxankatadeni ba?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“N yi waxi a xɔn ma nun","poem":1},{"lineBreak":true},{"text":"n ma falane yi sɛbɛ,","poem":1},{"lineBreak":true},{"text":"e yi sa kɛdini,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"e yi sɛbɛ yɔxɔ lefaan ma wure ɲɔɛ ralemunxin na,","poem":1},{"lineBreak":true},{"text":"e yi kɛrɛndɛn fanyen ma han habadan!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N na a kolon","poem":1},{"lineBreak":true},{"text":"a n xunbamana a nii ra.","poem":1},{"lineBreak":true},{"text":"Dɔnxɛn na, a kelima nɛn,","poem":1},{"lineBreak":true},{"text":"a ti bɔxɔ xɔnna ma.","poem":1},{"noteId":8}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Hali n fati kidin birin na kun fureni,","poem":1},{"lineBreak":true},{"text":"n gbindin sa Ala toma nɛn.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"N na a toma nɛn,","poem":1},{"lineBreak":true},{"text":"n na a tan nan toma,","poem":1},{"lineBreak":true},{"text":"gbɛtɛ mi a ra.","poem":1},{"lineBreak":true},{"text":"N kunfaxi na waxatin xɔn!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ɛ a falama, ɛ naxa,","poem":1},{"lineBreak":true},{"text":"‘En na a sagatanma di?","poem":1},{"lineBreak":true},{"text":"En fa fɛɛn mundun toma a ra","poem":1},{"lineBreak":true},{"text":"a yalagi xunna ra?’","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Anu, ɛ yi lan nɛn,","poem":1},{"lineBreak":true},{"text":"ɛ gaxu silanfanna yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ Ala ɛ saranma nɛn ɛ ɲaxankatane ra sayaan na.","poem":1},{"lineBreak":true},{"text":"Nayi, ɛ a kolonma nɛn a Ala kitin na.”","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"19.25Na xunbamanafe mɔn sɛbɛxi Yuba 9.33 nun 16.19-21 kui.","reference":{"chapter":19,"verse":25}}]},"thisChapterLink":"/api/yal_pbt/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}