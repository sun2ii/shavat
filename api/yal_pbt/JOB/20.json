{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Sofaraa yabin firindena: Ɲaxudene xunna kenla mi buma"]},{"type":"verse","number":1,"content":["Nama kaan Sofara mɔn yi a fala, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“N xaminxi ɛ miriyane fe yi","poem":1},{"lineBreak":true},{"text":"na nan n karahanma,","poem":1},{"lineBreak":true},{"text":"n xa yabin ti,","poem":1},{"lineBreak":true},{"text":"n mi fa nɔɛ diɲɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N bata n konbi xuine mɛ,","poem":1},{"lineBreak":true},{"text":"koni, n yabin tima nɛn xaxilimayani.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I mi a kolon ba, waxatin birin,","poem":1},{"lineBreak":true},{"text":"xabu adamadiine lu bɔxɔn fari,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"a ɲaxudene xunna kenla mi buma,","poem":1},{"lineBreak":true},{"text":"a Ala kolontarene sɛwan ɲanma nɛn mafurɛn?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hali a te han kore,","poem":1},{"lineBreak":true},{"text":"hali a xunna sa so kundani,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"a lɔma ayi nɛn habadan","poem":1},{"lineBreak":true},{"text":"alo a gbiina.","poem":1},{"lineBreak":true},{"text":"Naxanye yi a toma,","poem":1},{"lineBreak":true},{"text":"ne a falama nɛn, e naxa,","poem":1},{"lineBreak":true},{"text":"‘A minɛn?’","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A danguma nɛn alo xiyena,","poem":1},{"lineBreak":true},{"text":"a funfun yi lɔ ayi,","poem":1},{"lineBreak":true},{"text":"a ɲanma nɛn","poem":1},{"lineBreak":true},{"text":"alo xiyen kɔɛɛn na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Muxun naxan yi a matoma,","poem":1},{"lineBreak":true},{"text":"na mi fa a matoma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"hali a dɔxɔden mi fa a toma sɔnɔn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A diine karahanxin yi yiigelitɔne yii raxɛtɛ,","poem":1},{"lineBreak":true},{"text":"e tan yɛtɛɛn yi a nafunle raxɛtɛ na muxune ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hali a siimayaan to munma yi xunkuya,","poem":1},{"lineBreak":true},{"text":"a yi sa a gaburun na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Fe ɲaxin ɲaxun a dɛ","poem":1},{"lineBreak":true},{"text":"alo sukana,","poem":1},{"lineBreak":true},{"text":"a naxan luxunma a lɛnna bun,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"a naxan madunxunma a dɛ,","poem":1},{"lineBreak":true},{"text":"a mi waxi naxan xa ɲan,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"koni a donseen kunma nɛn a kui,","poem":1},{"lineBreak":true},{"text":"a findi fɔdɔgɔɔn xɔlɛn na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A bata nafunle magerun,","poem":1},{"lineBreak":true},{"text":"koni a e baxunma nɛn,","poem":1},{"lineBreak":true},{"text":"Ala e raminima nɛn a kui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A yi fɔdɔgɔɔn xɔlɛn nan madunxunma,","poem":1},{"lineBreak":true},{"text":"saɲin xɔlɛn nan a faxama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kumin nun nɔnɔn gbo yamanani","poem":1},{"lineBreak":true},{"text":"alo baa igena,","poem":1},{"lineBreak":true},{"text":"koni a mi fa na toma sɔnɔn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A tɔnɔn naxan sɔtɔxi,","poem":1},{"lineBreak":true},{"text":"a na raxɛtɛma nɛn,","poem":1},{"lineBreak":true},{"text":"a mi a donma,","poem":1},{"lineBreak":true},{"text":"a mi fa a yulaya seene tɔnɔn sɔtɔma sɔnɔn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Na birin ligama nɛn","poem":1},{"lineBreak":true},{"text":"bayo a yiigelitɔne ɲaxankata nɛn,","poem":1},{"lineBreak":true},{"text":"a yi e rabeɲin,","poem":1},{"lineBreak":true},{"text":"a yi banxina nde tongo","poem":1},{"lineBreak":true},{"text":"a mi naxan tixi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“A mi yi wasama a kunfani,","poem":1},{"lineBreak":true},{"text":"nanara, a nafunla sese mi yi luma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Muxu yo mi tangama a kunfan ma,","poem":1},{"lineBreak":true},{"text":"koni a hɛrin mi buma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A kɔntɔfilima nɛn","poem":1},{"lineBreak":true},{"text":"hali a hɛrini,","poem":1},{"lineBreak":true},{"text":"tɔrɔyaan sifan birin yi fa a ma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A na a kuiin nafe,","poem":1},{"lineBreak":true},{"text":"Ala a xɔlɔn nafama nɛn a xili ma,","poem":1},{"lineBreak":true},{"text":"a godoma nɛn a ma alo tulena,","poem":1},{"lineBreak":true},{"text":"a findi a balon na.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Xa a gi wure silanfanna bun,","poem":1},{"lineBreak":true},{"text":"xalimakuli sula daxin nan sa a yisɔxɔnma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"A xalimakunla botinma nɛn a fatini,","poem":1},{"lineBreak":true},{"text":"naxan ɲɔɛ bata sa a bɔɲɛn sɔxɔn,","poem":1},{"lineBreak":true},{"text":"koni sayaan magaxuna a suxuma nɛn.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A nafulu ramaraden nafema","poem":1},{"lineBreak":true},{"text":"dimi gbeen nan tun na.","poem":1},{"lineBreak":true},{"text":"Tɛɛn yi fa a halagideni","poem":1},{"lineBreak":true},{"text":"muxe mi naxan nadɛgɛxi,","poem":1},{"lineBreak":true},{"text":"muxun naxanye mɔn na lu a konni,","poem":1},{"lineBreak":true},{"text":"tɛɛn yi ne fan gan.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kore xɔnna a hakɛne raminima nɛn kɛnɛnni,","poem":1},{"lineBreak":true},{"text":"bɔxɔ xɔnna yi keli a xili ma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A nafunle yi makuyama a ra nɛn,","poem":1},{"lineBreak":true},{"text":"Ala na a xɔlɔn nagodo a xili ma lɔxɔn naxan yi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ala fe ɲaxi rabane raɲanma na kii nin,","poem":1},{"lineBreak":true},{"text":"Ala na nan findixi a kɛɛn na.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}