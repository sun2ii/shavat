{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["Yuba yi Sofara yabi: Nanfera ɲaxudene hɛrini?"]},{"type":"verse","number":1,"content":["Yuba mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“Ɛ tuli mati,","poem":1},{"lineBreak":true},{"text":"ɛ tuli mati n ma falan na,","poem":1},{"lineBreak":true},{"text":"ɛ n nalimaniyama na kiini.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ tin n xa falan ti,","poem":1},{"lineBreak":true},{"text":"n na falan ti,","poem":1},{"lineBreak":true},{"text":"nayi, ɛ nɔɛ n magelɛ nɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N na n mawugama adamadiine nan xɔn ba?","poem":1},{"lineBreak":true},{"text":"Ɛn-ɛn de! Nanfera nayi,","poem":1},{"lineBreak":true},{"text":"ɛ waxi a xɔn a n xa diɲa?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ na ɛ miri n ma fe ma,","poem":1},{"lineBreak":true},{"text":"ɛ kabɛma nɛn,","poem":1},{"lineBreak":true},{"text":"ɛ yi ɛ yiin sa ɛ dɛ ra,","poem":1},{"lineBreak":true},{"text":"ɛ yi ɛ dundu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Feen naxan birin n sɔtɔxi,","poem":1},{"lineBreak":true},{"text":"n na n miri ne ma,","poem":1},{"lineBreak":true},{"text":"n kuisanma nɛn,","poem":1},{"lineBreak":true},{"text":"n fatin yi xuruxurun n ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Nanfera ɲaxudene mɔn e nii ra?","poem":1},{"lineBreak":true},{"text":"Nanfera e siimayaan buma?","poem":1},{"lineBreak":true},{"text":"Nanfera e sɛnbɛn sɔtɔma?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E yi e yixɛtɛne to sabatɛ e dɛxɔn ma,","poem":1},{"lineBreak":true},{"text":"e yi e mamandenne to.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Feene birin lanxi e yii,","poem":1},{"lineBreak":true},{"text":"e mi gaxuma,","poem":1},{"lineBreak":true},{"text":"Ala mi e ratɔrɔnma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E turane e ɲinge gilɛne rawuyama ayi waxatin birin,","poem":1},{"lineBreak":true},{"text":"e ɲingene diine barima,","poem":1},{"lineBreak":true},{"text":"e mi faxama.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E diine e gima na xun xɔn","poem":1},{"lineBreak":true},{"text":"alo xuruse diine, e yi e bodon.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E sigin sama kondenna nun tanban xuini,","poem":1},{"lineBreak":true},{"text":"xulen xuiin nafan e ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E na e siimayani dangu a faɲin na,","poem":1},{"lineBreak":true},{"text":"e siga laxira yi bɔɲɛ xunbenli.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Anu, e a falama Ala xa,","poem":1},{"lineBreak":true},{"text":"e naxa, ‘I masiga nxu ra,","poem":1},{"lineBreak":true},{"text":"nxu mi waxi i ya kirane kolon feni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A lan nxu yi findi Ala Sɛnbɛ Kanna konyine ra ba?","poem":1},{"lineBreak":true},{"text":"Ala mafanna tɔnɔn findɛ nanse ra nxu xa?’","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E laxi a ra a hɛrin kanna e tan nan na,","poem":1},{"lineBreak":true},{"text":"koni, e fe yitɔnxine raɲaxu n ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Ɛ bata ɲaxudene lɛnpun to tuyɛ sanɲa ma yoli?","poem":1},{"lineBreak":true},{"text":"Ɛ bata e to gbaloni ba?","poem":1},{"lineBreak":true},{"text":"Ɛ bata Ala to e ratɔrɔnɲɛ a xɔlɔni ba?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E luxi nɛn ba","poem":1},{"lineBreak":true},{"text":"alo foyen sɛxɛn naxan xalima,","poem":1},{"lineBreak":true},{"text":"alo wuluwunla xuben naxan yitema?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɛ a falama, ɛ naxa,","poem":1},{"lineBreak":true},{"text":"‘Ala ɲaxudene hakɛne saranna ramaraxi e diine nan xa.’","poem":1},{"lineBreak":true},{"text":"Koni, e hakɛne yi lan a xa saran e yɛtɛɛn nan na,","poem":1},{"lineBreak":true},{"text":"alogo e xa a kolon.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A yi lan e yɛtɛɛn yi e halagin to,","poem":1},{"lineBreak":true},{"text":"e yi Ala Sɛnbɛ Kanna xɔlɛn min.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A denbayaan bɔtɛ mundun fa a tan xa","poem":1},{"lineBreak":true},{"text":"a faxa xanbini?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nde nɔɛ Ala xaranɲɛ fe kolonna ma,","poem":1},{"lineBreak":true},{"text":"a tan naxan malekane makitima?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Muxuna nde faxama hɛri gbeen nin,","poem":1},{"lineBreak":true},{"text":"kɔntɔfili yo mi a ma,","poem":1},{"lineBreak":true},{"text":"a bɔɲɛn xunbelixi,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"a tuyanxi,","poem":1},{"lineBreak":true},{"text":"sɛnbɛn mɔn a ra.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Muxu gbɛtɛ bɔɲɛn sunuxin yi faxa,","poem":1},{"lineBreak":true},{"text":"a mi fe faɲi yo sɔtɔ hali keden pe.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Koni, e firinna birin sama bɛndɛn nin,","poem":1},{"lineBreak":true},{"text":"kunle yi e don.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“N bata ɛ miriyane kolon ki faɲi,","poem":1},{"lineBreak":true},{"text":"ɛ feen naxanye yitɔnxi n xili ma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ɛ a falama nɛn,","poem":1},{"lineBreak":true},{"text":"ɛ naxa, ‘Muxu gbeeni ito,","poem":1},{"lineBreak":true},{"text":"a banxin minɛn?","poem":1},{"lineBreak":true},{"text":"Ɲaxuden konna go?","poem":1},{"lineBreak":true},{"text":"E mi fa na.’","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Koni, ɛ mi dangu muxune maxɔdinxi ba?","poem":1},{"lineBreak":true},{"text":"Ɛ mi laxi e sereyaan na ba?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Gbalon na fa,","poem":1},{"lineBreak":true},{"text":"fe ɲaxi rabane yi kisi,","poem":1},{"lineBreak":true},{"text":"Alaa xɔlɔn na fa,","poem":1},{"lineBreak":true},{"text":"a mi sese ligama e tan na.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nde e raxɔlɛ e fe raba kiin ma?","poem":1},{"lineBreak":true},{"text":"Nde e saren fiyɛ e kɛwanle ra?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"E na e maluxun,","poem":1},{"lineBreak":true},{"text":"muxune yi e yengi dɔxɔ e gaburune xɔn,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"mɛrɛmɛrɛn bɛndɛ yelefuxine yi sa e fari.","poem":1},{"lineBreak":true},{"text":"Dunuɲa muxune birin birama nɛn e fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"gali gbeen yi siga e yɛɛ ra.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Nanfera nayi ɛ n masabarima fala fuune ra?","poem":1},{"lineBreak":true},{"text":"Yanfa falane nan tun ɛ yabine ra.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}