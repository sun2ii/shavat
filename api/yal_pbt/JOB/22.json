{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Elifasi a falan saxanden Yuba xa: Hakɛ kanna nan Yuba ra yati!"]},{"type":"verse","number":1,"content":["Teman kaana Elifasi mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“Adamadiin tɔnɔna Ala ma ba?","poem":1},{"lineBreak":true},{"text":"Hali xaxilimana,","poem":1},{"lineBreak":true},{"text":"a tɔnɔn luma a yɛtɛ nan tun ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I na tinxinɲɛ ayi,","poem":1},{"lineBreak":true},{"text":"na tɔnɔna Ala Sɛnbɛ Kanna nan ma ba?","poem":1},{"lineBreak":true},{"text":"Xa fɛ mi i sigati kiin na,","poem":1},{"lineBreak":true},{"text":"na munanfanna a ma ba?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I mirixi a ma ba","poem":1},{"lineBreak":true},{"text":"a Ala i ratɔrɔnma nɛn,","poem":1},{"lineBreak":true},{"text":"a i xali kiti sadeni,","poem":1},{"lineBreak":true},{"text":"i to gaxuxi a yɛɛ ra?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I ya fe ɲaxine mi gbo ba?","poem":1},{"lineBreak":true},{"text":"I hakɛne dan mi na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I yi tolimaan tongoma i ngaxakedenne yii fuun nin,","poem":1},{"lineBreak":true},{"text":"i yi e dugine ba e ma,","poem":1},{"lineBreak":true},{"text":"i yi e magenla lu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I mi yi igen soma muxun yii","poem":1},{"lineBreak":true},{"text":"min xɔnla naxan ma,","poem":1},{"lineBreak":true},{"text":"i yi tondi donseen soɛ kamɛtɔɔn yii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yamanan yi sɛnbɛmaan nan yii,","poem":1},{"lineBreak":true},{"text":"wasoden nan yi dɔxi yamanani.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I yi kaɲa gilɛne raxɛtɛma nɛn e yii genla ra,","poem":1},{"lineBreak":true},{"text":"i yi kiridine ɲaxankata.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nanara, i rabilinxi luti ratixine ra,","poem":1},{"lineBreak":true},{"text":"gaxun yi i suxu xulɛn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nayi, i mi dimini ito toma ba,","poem":1},{"lineBreak":true},{"text":"i mi fufani ito toma ba","poem":1},{"lineBreak":true},{"text":"naxan i rabilinxi?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ala mi kore xɔnna xan ma ba?","poem":1},{"lineBreak":true},{"text":"Sarene mato kore, e mate pon!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I a falama, i naxa,","poem":1},{"lineBreak":true},{"text":"‘Ala nanse kolon?","poem":1},{"lineBreak":true},{"text":"A nɔɛ kitin sɛ kunda dimin xanbi ra ba?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kundana a yɛɛ ma,","poem":1},{"lineBreak":true},{"text":"a mi sese toma,","poem":1},{"lineBreak":true},{"text":"a nɛma kore xɔnna rabilinɲɛ.’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I mɔn waxi lu feni kira fonni ito xɔn ba,","poem":1},{"lineBreak":true},{"text":"muxu ɲaxine sigan tima naxan xɔn?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E faxan nɛn","poem":1},{"lineBreak":true},{"text":"benun e waxatin xa li,","poem":1},{"lineBreak":true},{"text":"alo fufa gbeen banxi kanken xalima kii naxan yi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"E yi a falama nɛn Ala xa,","poem":1},{"lineBreak":true},{"text":"e naxa, ‘I masiga nxu ra.","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna nan i tan na,","poem":1},{"lineBreak":true},{"text":"koni i nɔɛ nanse ligɛ nxu ra?’","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Anu, Ala nan e banxine rafe nafunla ra.","poem":1},{"lineBreak":true},{"text":"Ee! Ɲaxudene fe yitɔnxine raɲaxu n ma!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tinxindene na e to gbaloni, e sɛwa.","poem":1},{"lineBreak":true},{"text":"Sɔntarene e magelema nɛn, e naxa,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"‘En yaxune bata raxɔri!","poem":1},{"lineBreak":true},{"text":"Tɛɛn yi e yiiseene halagi.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Lanna xa lu ɛ nun Ala tagi,","poem":1},{"lineBreak":true},{"text":"nayi, i bɔɲɛ xunbenla sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"i hɛrin sɔtɔ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ala i xaranma naxan ma,","poem":1},{"lineBreak":true},{"text":"i na suxu,","poem":1},{"lineBreak":true},{"text":"i yi a falane sa i bɔɲɛni.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xa i mɔn fa Ala Sɛnbɛ Kanna ma,","poem":1},{"lineBreak":true},{"text":"a mɔn i sɛnbɛ soma nɛn.","poem":1},{"lineBreak":true},{"text":"I xa tinxintareyaan masiga i konna ra,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"i xa i ya xɛma faɲin woli ayi bɔxɔni,","poem":1},{"lineBreak":true},{"text":"hanma i sa a bira xude yi gɛmɛne longonna ra.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna nan xa findi i ya nafunla ra,","poem":1},{"lineBreak":true},{"text":"alo xɛmaan nun gbeti fixɛ gbeena i xa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nayi, i sɛwan sɔtɔma nɛn Ala Sɛnbɛ Kanni,","poem":1},{"lineBreak":true},{"text":"i xunna kenla sɔtɔ Ala yɛtagi,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"i yi a maxandi, a yi i yabi,","poem":1},{"lineBreak":true},{"text":"i yi i dɛ ti xuine rakamali.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Xa i fena nde ragidi,","poem":1},{"lineBreak":true},{"text":"Ala a rakamalima nɛn i xa,","poem":1},{"lineBreak":true},{"text":"kɛnɛnna luma nɛn i ya kiraan birin xɔn.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ala na muxuna nde rayagi,","poem":1},{"lineBreak":true},{"text":"i a falama nɛn","poem":1},{"lineBreak":true},{"text":"a Ala na ligaxi nɛn","poem":1},{"lineBreak":true},{"text":"bayo wasoden nan na kanna ra,","poem":1},{"lineBreak":true},{"text":"koni, naxan na a yɛtɛ magodo,","poem":1},{"lineBreak":true},{"text":"Ala na rakisima nɛn.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ala nan sɔntarene xunbama,","poem":1},{"lineBreak":true},{"text":"nanara, xa i sariɲan,","poem":1},{"lineBreak":true},{"text":"a i xunbama nɛn.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}