{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Yubaa yabina Elifasi xa: Yuba mi fa Ala toma"]},{"type":"verse","number":1,"content":["Yuba mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“N ma mawugan mɔn findixi murutɛn nan na to,","poem":1},{"lineBreak":true},{"text":"n yiin saxi n dɛ ra,","poem":1},{"lineBreak":true},{"text":"koni n wuga xuiin mɔn minima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xa n yi a kolon nun Ala dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"n yi sigama nɛn han a konni,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n yi n ma mawugan yita a ra,","poem":1},{"lineBreak":true},{"text":"n yi n xɔnba fala wuyaxi ti a xa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nayi, n yi a kolonma nɛn","poem":1},{"lineBreak":true},{"text":"a n yabima falan naxan na,","poem":1},{"lineBreak":true},{"text":"n yi a famu","poem":1},{"lineBreak":true},{"text":"a naxan falama n xa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A yi kelɛ n xili ma a sɛnbɛ gbeeni ba?","poem":1},{"lineBreak":true},{"text":"Ɛn-ɛn de, a yi a tuli matima nɛn n na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A yi a kolonma nɛn","poem":1},{"lineBreak":true},{"text":"a muxu faɲin nan falan tima a xa.","poem":1},{"lineBreak":true},{"text":"Nayi, n yi tangama nɛn kitin ma habadan.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Koni, n na siga sogeteden binni,","poem":1},{"lineBreak":true},{"text":"a mi na,","poem":1},{"lineBreak":true},{"text":"n mi a toma sogegododen binni,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"n na a fen n kɔmɛnna ma,","poem":1},{"lineBreak":true},{"text":"n mi a toma,","poem":1},{"lineBreak":true},{"text":"n na xɛtɛ n yiifanna mabinni,","poem":1},{"lineBreak":true},{"text":"n mi a toma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Anu, a n ma kiraan kolon.","poem":1},{"lineBreak":true},{"text":"A na n fɛsɛfɛsɛ tɔrɔni,","poem":1},{"lineBreak":true},{"text":"n sariɲanxin minima nɛn","poem":1},{"lineBreak":true},{"text":"alo xɛmana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N biraxi a san funfun nan tun fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"n lu a kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"n mi keli a xɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N mi tondi a yamarine suxɛ,","poem":1},{"lineBreak":true},{"text":"n na a falane birin namara nɛn n bɔɲɛni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Koni, a na fena nde ragidi,","poem":1},{"lineBreak":true},{"text":"nde a ligɛ a na masara?","poem":1},{"lineBreak":true},{"text":"A na wa naxan xɔn, a na liga.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A naxan nagidixi n ma,","poem":1},{"lineBreak":true},{"text":"a na nan nakamalima,","poem":1},{"lineBreak":true},{"text":"anu a mɔn na fe sifa wuyaxin nagidixi n ma yɛɛn na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nanara, n gaxuma Ala yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"N na n miri, n gaxu a fe yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ala bata n tunnaxɔlɔ n ma,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna bata n nafe gaxun na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Koni hali dimin to so n ma,","poem":1},{"lineBreak":true},{"text":"a yi n nabilin,","poem":1},{"lineBreak":true},{"text":"hali n mi fa sese toma,","poem":1},{"lineBreak":true},{"text":"n mi n dundu.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}