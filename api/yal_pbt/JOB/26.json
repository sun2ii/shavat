{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Yubaa yabin Bilidada xa: I n yabima fuun nin"]},{"type":"verse","number":1,"content":["Yuba mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“I fatan sɛnbɛtarene maliyɛ yati!","poem":1},{"lineBreak":true},{"text":"I bata fa fangatarene malideni!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I fatan fekolontaren kawandɛ,","poem":1},{"lineBreak":true},{"text":"i yi a maxadi han!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koni i ya falane tima nde xa?","poem":1},{"lineBreak":true},{"text":"I falani itoe tongoxi nde yii?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Faxa muxune niine xuruxurunma Ala yɛɛragaxuni laxira yi,","poem":1},{"lineBreak":true},{"text":"naxanye bɔxɔ bun igene bun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala yɛɛn laxira yiren birin na,","poem":1},{"lineBreak":true},{"text":"hali sayani muxe mi e luxunɲɛ a tan ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ala nan kore xɔnni fulunxi na yigenla xun ma,","poem":1},{"lineBreak":true},{"text":"a bɔxɔn singan na yigenli.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala tulen namarama kundani,","poem":1},{"lineBreak":true},{"text":"koni kundane mi kalama igen binyen bun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A yi a mangaya gbɛdɛn luxun,","poem":1},{"lineBreak":true},{"text":"a yi a kundaan sa a yɛɛ ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala yi digilinna sa fɔxɔ igen xun ma,","poem":1},{"lineBreak":true},{"text":"naxan dan findixi kɛnɛnna nun dimin naralanden na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kore xɔnna sɛnbɛtɛnne xuruxurunma,","poem":1},{"lineBreak":true},{"text":"e kabɛ Alaa xɔlɔn ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala bata fɔxɔ igene nɔ a sɛnbɛni,","poem":1},{"lineBreak":true},{"text":"a yi ige yi ninginangan Raxabi faxa a xaxilimayani.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A foyen bata kore xɔnna fixa,","poem":1},{"lineBreak":true},{"text":"a bata ige yi sube ɲaxin faxa a yiin na,","poem":1},{"lineBreak":true},{"text":"saɲin naxan a gima.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A wali xurine nan itoe ra,","poem":1},{"lineBreak":true},{"text":"nxu a ɲununɲunun xuiin nan tun mɛma.","poem":1},{"lineBreak":true},{"text":"Nayi, nde nɔɛ a sɛnbɛn galan xuiin kolonɲɛ?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}