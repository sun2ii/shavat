{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["Yuba mɔn yi yabin ti: Sɔntaren nan n na"]},{"type":"verse","number":1,"content":["Yuba mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“N bata n kɔlɔ habadan Ala yi,","poem":1},{"lineBreak":true},{"text":"naxan tondixi n ma kitin sɛ,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna","poem":1},{"lineBreak":true},{"text":"naxan n niin nafexi xɔlɛn na,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"xa n niin mɔn n yi,","poem":1},{"lineBreak":true},{"text":"xa Alaa foyen mɔn soma n ɲɔɛni,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n bata n kɔlɔ","poem":1},{"lineBreak":true},{"text":"n dɛɛn mi tinxintareya falan tiyɛ,","poem":1},{"lineBreak":true},{"text":"wule yo mi minɛ n dɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na miriyaan makuya n na,","poem":1},{"lineBreak":true},{"text":"n xa ɲɔndin fi ɛ ma.","poem":1},{"lineBreak":true},{"text":"Han n yi faxa,","poem":1},{"lineBreak":true},{"text":"n mi n ma fɛtareya wanle kalɛ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"n luma nɛn tinxinni,","poem":1},{"lineBreak":true},{"text":"n mi a beɲinɲɛ mumɛ,","poem":1},{"lineBreak":true},{"text":"n xaxinla mi n yalagɛ n ma simayani mumɛ!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“N yaxun nan lan a yatɛ ɲaxuden na,","poem":1},{"lineBreak":true},{"text":"naxan kelima n xili ma,","poem":1},{"lineBreak":true},{"text":"na xa yatɛ tinxintaren na!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala kolontarena a yigin sama nanse yi,","poem":1},{"lineBreak":true},{"text":"Ala na a niin ba a yi?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɔrɔn na fa a ma,","poem":1},{"lineBreak":true},{"text":"Ala a gbelegbele xuiin namɛ ba?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A sɛwan sɔtɛ Ala Sɛnbɛ Kanna yii ba?","poem":1},{"lineBreak":true},{"text":"A Ala maxandɛ waxatin birin ba?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Iki, n na Ala sɛnbɛn yitama nɛn ɛ ra,","poem":1},{"lineBreak":true},{"text":"n mi Ala Sɛnbɛ Kanna miriyane luxunma ɛ ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɛ birin bata a to ki faɲi,","poem":1},{"lineBreak":true},{"text":"nayi, nanfera ɛ yɛtɛ luma fe fuune yi?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ala nan kɛɛni ito ramaraxi ɲaxuden xa,","poem":1},{"lineBreak":true},{"text":"ɲaxankata tiin naxan sɔtɔma Ala Sɛnbɛ Kanna yii fa fala:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xa e diine wuya,","poem":1},{"lineBreak":true},{"text":"e faxama yɛngɛn nin,","poem":1},{"lineBreak":true},{"text":"donseen yi dasa e yixɛtɛne ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Naxanye na lu e xanbi ra,","poem":1},{"lineBreak":true},{"text":"furen yi ne faxa,","poem":1},{"lineBreak":true},{"text":"e kaɲa gilɛne mi e wugama.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Hali e gbeti fixɛn makɔ","poem":1},{"lineBreak":true},{"text":"alo burunburunna,","poem":1},{"lineBreak":true},{"text":"e nun dugina alo borona,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"tinxin muxune nan e dugine ragodoma e ma,","poem":1},{"lineBreak":true},{"text":"sɔntarene nan e gbeti fixɛni taxunma e ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E banxine kala ɲaxun","poem":1},{"lineBreak":true},{"text":"alo dondoli xuyenna,","poem":1},{"lineBreak":true},{"text":"alo kantan muxuna bubuna.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E sama nɛn nafulu kanyani,","poem":1},{"lineBreak":true},{"text":"koni a danna nan na ra,","poem":1},{"lineBreak":true},{"text":"e na xulun,","poem":1},{"lineBreak":true},{"text":"e lima nɛn sese mi na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gaxuna e ratɛrɛnama nɛn","poem":1},{"lineBreak":true},{"text":"alo fufana,","poem":1},{"lineBreak":true},{"text":"wuluwunla yi e xasun kɔɛɛn na.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sogeteden foyen yi e tongo,","poem":1},{"lineBreak":true},{"text":"a yi e xali wulani,","poem":1},{"lineBreak":true},{"text":"a yi e ba e dɔxɔdeni,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"a yi e radinɲɛ ayi kininkinintareyani,","poem":1},{"lineBreak":true},{"text":"e yi e gi a sɛnbɛn bun ma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yamaan yi e yii bɔnbɔ e magele feen na,","poem":1},{"lineBreak":true},{"text":"muxune yi kolin e dɔxɔde fonne birin kala kii ma.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}