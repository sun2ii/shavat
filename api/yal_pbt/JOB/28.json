{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["Fekolonna wundona"]},{"type":"verse","number":1,"content":[{"text":"“Ɲɔndin na a ra,","poem":1},{"lineBreak":true},{"text":"gbeti wure fixɛn geden na,","poem":1},{"lineBreak":true},{"text":"xɛmaan fan nasariɲanden na,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"wuren bama bɛndɛn nin,","poem":1},{"lineBreak":true},{"text":"wure gbeela fan bama gɛmɛn nin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wuren fen muxune kɛnɛnna raminima dimin nin bɔxɔn bun,","poem":1},{"lineBreak":true},{"text":"e godoma wuren fenɲɛ han a dandena,","poem":1},{"lineBreak":true},{"text":"e wuren fen naxan luxunxi dimini bɔxɔn bun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wuren fen muxune yili tilinxine gema burunna ra,","poem":1},{"lineBreak":true},{"text":"muxu gbɛtɛ yo mi sigɛ dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"e makuya muxu gbɛtɛne ra,","poem":1},{"lineBreak":true},{"text":"e singanxin nan walima e yinle ra lutine ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɔxɔ xɔnna donseen fima en ma,","poem":1},{"lineBreak":true},{"text":"koni, a bunni maxaxi alo tɛɛn nan a ganxi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gɛmɛ mamiloxi faɲine toma fanye yirene nin,","poem":1},{"lineBreak":true},{"text":"xɛma fuɲin toma bɛndɛn nin.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Dugane mi na bɔxɔ bun kirane kolon,","poem":1},{"lineBreak":true},{"text":"sɛgɛn yɛɛn mi ne toma,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"burunna sube yo munma siga e xɔn,","poem":1},{"lineBreak":true},{"text":"yata yo munma dangu e xɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Koni, muxun susuma fanyen gɛ,","poem":1},{"lineBreak":true},{"text":"a yi geyane ge han e danna,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"a folon gema fanyene yi,","poem":1},{"lineBreak":true},{"text":"a yi se kɛndɛne birin to a yɛɛn na,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"a yi xude xunne xɔri,","poem":1},{"lineBreak":true},{"text":"naxan luxunxi,","poem":1},{"lineBreak":true},{"text":"a yi na ramini kɛnɛnni.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Koni, fekolonna minɛn yi?","poem":1},{"lineBreak":true},{"text":"Xaxilimayaan dɔxi minɛn yi?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Adamadiine mi a saren kolon,","poem":1},{"lineBreak":true},{"text":"a mi niiramane yɛ bɔxɔ xɔnna fari.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fɔxɔ ige gbeena a falama,","poem":1},{"lineBreak":true},{"text":"a naxa, ‘A mi n tan yii.’","poem":1},{"lineBreak":true},{"text":"Baan fan a falama,","poem":1},{"lineBreak":true},{"text":"a naxa, ‘A mi n tan yii.’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Fekolonna mi sɔtɛ xɛmaan xɔn,","poem":1},{"lineBreak":true},{"text":"a mi sarɛ gbeti fixɛn na,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"xɛmaan naxan kelima Ofiri yamanani,","poem":1},{"lineBreak":true},{"text":"a mi sɔtɛ na ra,","poem":1},{"lineBreak":true},{"text":"hanma onixi gɛmɛ tofaɲina,","poem":1},{"lineBreak":true},{"text":"hanma gɛmɛ mamiloxi faɲina.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A mi sɛ xɛmaan ma,","poem":1},{"lineBreak":true},{"text":"a mi sɛ kilasi gɛmɛ fixɛ faɲin ma,","poem":1},{"lineBreak":true},{"text":"a mi masarɛ xɛma faɲin goronna ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A dangu korala gɛmɛ tofaɲin","poem":1},{"lineBreak":true},{"text":"nun gɛmɛ gbɛtɛ ra","poem":1},{"lineBreak":true},{"text":"naxan fixa alo dayimuna.","poem":1},{"lineBreak":true},{"text":"Fekolonna dangu bɔxɔ bun nafunla birin na.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Topasi gɛmɛ faɲin","poem":1},{"lineBreak":true},{"text":"naxan keli Kusi yamanani,","poem":1},{"lineBreak":true},{"text":"a mi sɛ na ma,","poem":1},{"lineBreak":true},{"text":"a mi misalɛ xɛma sensenna ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Nayi, fekolonna kelima minɛn yi?","poem":1},{"lineBreak":true},{"text":"Xaxilimayaan dɔxi minɛn yi?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A luxunxi niiramane birin ma,","poem":1},{"lineBreak":true},{"text":"hali xɔliin naxanye kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"ne mi a toma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sayaan nun laxira yi a fala,","poem":1},{"lineBreak":true},{"text":"e naxa, ‘Nxu a xinla nan gbansan mɛxi.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Koni, Ala a kiraan kolon,","poem":1},{"lineBreak":true},{"text":"a tan nan keden a dɔxɔden kolon,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"bayo a tan nan toon tima","poem":1},{"lineBreak":true},{"text":"han bɔxɔn danna,","poem":1},{"lineBreak":true},{"text":"a seen birin toma kore xɔnna bun.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"A tan foyen sɛnbɛn danna saxi,","poem":1},{"lineBreak":true},{"text":"a yi igene danna sa,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"a yi tulen danna sa,","poem":1},{"lineBreak":true},{"text":"a yi galanna kiraan sa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nayi, Ala yi fekolonna to,","poem":1},{"lineBreak":true},{"text":"a yi a fɛsɛfɛsɛ, a yi a makɛnɛn.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Na xanbi ra,","poem":1},{"lineBreak":true},{"text":"a yi a fala adamadiine xa, a naxa,","poem":1},{"lineBreak":true},{"text":"‘Marigin yɛɛragaxun nan findixi fekolonna ra!","poem":1},{"lineBreak":true},{"text":"Xaxilimayaan nan fe ɲaxin matangan na!’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}