{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["Yubaa xun mafalana: Waxati danguxine yi ɲaxun"]},{"type":"verse","number":1,"content":["Yuba mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“Xa n yi luyɛ nun","poem":1},{"lineBreak":true},{"text":"alo waxati danguxine yi,","poem":1},{"lineBreak":true},{"text":"na yi lanɲɛ!","poem":1},{"lineBreak":true},{"text":"Na waxati danguxine yi,","poem":1},{"lineBreak":true},{"text":"Ala yi yengi dɔxi n xɔn nun,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"a lɛnpun yi dɛgɛma n xun ma,","poem":1},{"lineBreak":true},{"text":"n yi sigan tima a kɛnɛnna nin","poem":1},{"lineBreak":true},{"text":"hali kɔɛɛn na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yi kɛndɛ,","poem":1},{"lineBreak":true},{"text":"Alaa xanuntenyaan yi n konni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na waxatini,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna mɔn yi n xɔn,","poem":1},{"lineBreak":true},{"text":"n ma diine birin mɔn yi n dɛxɔn,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"n yi n sanne maxama nɔnɔn fɛnɛn nan na,","poem":1},{"lineBreak":true},{"text":"hali turen yi minima fanyeni n xa!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Na waxatini,","poem":1},{"lineBreak":true},{"text":"n na yi mini siga taan so dɛɛn na,","poem":1},{"lineBreak":true},{"text":"n sa n ma gbɛdɛn dɔxɔ yamaan malandeni,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"banxulanne yi n to,","poem":1},{"lineBreak":true},{"text":"e yi xɛtɛma nɛn,","poem":1},{"lineBreak":true},{"text":"fonne yi keli,","poem":1},{"lineBreak":true},{"text":"e lu tixi n yɛtagi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kuntigine yi e falan dan,","poem":1},{"lineBreak":true},{"text":"e dundu,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"mangane yi e falane dan,","poem":1},{"lineBreak":true},{"text":"e lɛnne yi xidi e dɛ kankeni.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Muxu yo na yi n ma falane mɛ,","poem":1},{"lineBreak":true},{"text":"na kanna yi a falama nɛn n ma a dubadiina.","poem":1},{"lineBreak":true},{"text":"Muxu yo na yi n to,","poem":1},{"lineBreak":true},{"text":"a yi n matɔxɔ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"amasɔtɔ n yi yiigelitɔne ratangama","poem":1},{"lineBreak":true},{"text":"naxanye yi e mawugama n xa,","poem":1},{"lineBreak":true},{"text":"n yi kiridine ratanga","poem":1},{"lineBreak":true},{"text":"muxu yo mi naxanye malima.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Saya furen yi muxun naxanye ma,","poem":1},{"lineBreak":true},{"text":"ne yi dubama n tan nan xa,","poem":1},{"lineBreak":true},{"text":"n yi kaɲa gilɛn nasɛwama.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tinxinyaan yi ragodoxi n ma","poem":1},{"lineBreak":true},{"text":"alo n ma domana,","poem":1},{"lineBreak":true},{"text":"kiti kɛndɛn nan yi findixi n ma dugin nun n ma kɔmɔtin na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N tan nan yi findixi danxutɔɔn yɛɛne ra,","poem":1},{"lineBreak":true},{"text":"n tan nan yi madɔntɔɔn sanne ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N yi findixi tɔrɔ muxune fafe ra,","poem":1},{"lineBreak":true},{"text":"n yi xɔɲɛne xun mayɛngɛ kitini.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N tan nan yi tinxintarene sɛnbɛn kalama,","poem":1},{"lineBreak":true},{"text":"n yi e se tongoxine ba e yii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nayi, n yi a fala n yɛtɛ ma,","poem":1},{"lineBreak":true},{"text":"n naxa, ‘N faxama nɛn sabatini,","poem":1},{"lineBreak":true},{"text":"n ma lɔxɔne gboma ayi nɛn","poem":1},{"lineBreak":true},{"text":"alo ɲɛmɛnsinna,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"n luma nɛn alo wudina,","poem":1},{"lineBreak":true},{"text":"naxan salen sinxi igeni,","poem":1},{"lineBreak":true},{"text":"xiila sama naxan yii ra kɔɛɛn na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N ma binyen gboma ayi nɛn,","poem":1},{"lineBreak":true},{"text":"n sɛnbɛn mi ɲanma mumɛ,","poem":1},{"lineBreak":true},{"text":"a lu alo xali bandunxina.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Na waxatini,","poem":1},{"lineBreak":true},{"text":"muxune yi e tuli matima n na sabarini.","poem":1},{"lineBreak":true},{"text":"N na yi e kawandi,","poem":1},{"lineBreak":true},{"text":"e yi e dundu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N na yi falan ti,","poem":1},{"lineBreak":true},{"text":"e mi yi a matandima.","poem":1},{"lineBreak":true},{"text":"N ma falane yi luxi nɛn e xa","poem":1},{"lineBreak":true},{"text":"alo tulen naxan godoma bɔxɔ xaren ma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"E yi n mamɛma nɛn","poem":1},{"lineBreak":true},{"text":"alo e tulen mamɛma kii naxan yi,","poem":1},{"lineBreak":true},{"text":"e dɛɛne yi lu yibixi n bun","poem":1},{"lineBreak":true},{"text":"alo muxun naxanye tulen mamɛma soge furen na.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"E na yi yigitɛgɛ,","poem":1},{"lineBreak":true},{"text":"n yi e ralimaniya,","poem":1},{"lineBreak":true},{"text":"e mi yi wama fula feni n ma fanna ra.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N tan nan yi dɔxi e xun na,","poem":1},{"lineBreak":true},{"text":"n kiraan yita e ra,","poem":1},{"lineBreak":true},{"text":"alo mangana a ganla xun na,","poem":1},{"lineBreak":true},{"text":"alo muxun naxan tɔrɔ muxune masabarima.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}