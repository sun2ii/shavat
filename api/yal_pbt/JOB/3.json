{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Yubaa falane"]},{"type":"verse","number":1,"content":["Na xanbi ra, Yuba yi a dɛni bi, a yi a bari lɔxɔn danga."]},{"type":"verse","number":2,"content":["Yuba yi a fala, a naxa,"]},{"type":"verse","number":3,"content":[{"text":"“N bari lɔxɔn xa raxɔri,","poem":1},{"lineBreak":true},{"text":"e nun kɔɛna","poem":1},{"lineBreak":true},{"text":"muxune a fala waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"e naxa, ‘Dii xɛmɛn bata bari!’","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na lɔxɔn xa findi dimin na,","poem":1},{"lineBreak":true},{"text":"Ala mako nama lu a ma kore,","poem":1},{"lineBreak":true},{"text":"kɛnɛnna nama fa mini a ma sɔnɔn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dimi gbeen xa a suxu,","poem":1},{"lineBreak":true},{"text":"kunda fɔrɛn yi godo na lɔxɔn ma,","poem":1},{"lineBreak":true},{"text":"han dimin yi sogen suxu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na kɔɛɛn xa findi dimi gbeen na,","poem":1},{"lineBreak":true},{"text":"a nama fa yatɛ ɲɛɛn lɔxɔne yɛ","poem":1},{"lineBreak":true},{"text":"a nama fa lu kikene yi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na lɔxɔn xa findi gbantan na,","poem":1},{"lineBreak":true},{"text":"sɛwa xui nama lu a yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naxanye gbalo lɔxɔne fe falama,","poem":1},{"lineBreak":true},{"text":"naxanye fatan ige yi sube ɲaxin naxulunɲɛ,","poem":1},{"lineBreak":true},{"text":"ne xa na lɔxɔn danga.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A subaxa ma sarene xa yidimi,","poem":1},{"lineBreak":true},{"text":"a yengi xa lu kɛnɛnna xɔn,","poem":1},{"lineBreak":true},{"text":"koni a nama a to,","poem":1},{"lineBreak":true},{"text":"a nama xɔtɔnna to.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amasɔtɔ, a mi sese ligaxi","poem":1},{"lineBreak":true},{"text":"alogo n nama sɔtɔ,","poem":1},{"lineBreak":true},{"text":"a bata n lu, n yi sɔxɔlɛni ito sɔtɔ to.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nanfera n mi faxa n to bari?","poem":1},{"lineBreak":true},{"text":"Nanfera n mi faxa n xali lɔxɔni?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nanfera n bata xinbi firinna li n yɛɛ ra","poem":1},{"lineBreak":true},{"text":"n nasuxudeni,","poem":1},{"lineBreak":true},{"text":"e nun xiɲɛne alogo n xa xiɲɛn min?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xa n yi faxa nun,","poem":1},{"lineBreak":true},{"text":"a lima nɛn nun","poem":1},{"lineBreak":true},{"text":"n saxi n ma gaburun na bɔɲɛ xunbenli,","poem":1},{"lineBreak":true},{"text":"nayi, n yi xima nɛn xaxili sani nun","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"manga fonne fɛma, bɔxɔn kuntigine,","poem":1},{"lineBreak":true},{"text":"naxanye banxi faɲine tixi","poem":1},{"lineBreak":true},{"text":"naxanye kalaxin bata lu iki,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"e nun kuntigi fonne fɛma,","poem":1},{"lineBreak":true},{"text":"xɛmaan yi naxanye yii,","poem":1},{"lineBreak":true},{"text":"naxanye e banxine rafe gbeti fixɛn na.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xanamu, a yi lan nun n mi balo,","poem":1},{"lineBreak":true},{"text":"alo diin naxan faxaxi barixi,","poem":1},{"lineBreak":true},{"text":"a mi kɛnɛnna to.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bayo, muxu ɲaxine mi fa walima gaburun na,","poem":1},{"lineBreak":true},{"text":"muxu xadanxine e matabuma dɛnaxan yi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kasorasane fan birin yi bɔɲɛ xunbenla sɔtɔ,","poem":1},{"lineBreak":true},{"text":"e mi fa ɲaxankata tiin xuiin mɛma sɔnɔn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sɛnbɛtaren nun sɛnbɛ kanna na,","poem":1},{"lineBreak":true},{"text":"konyin yi xunba a kanna ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nanfera Ala,","poem":1},{"lineBreak":true},{"text":"i kɛnɛnna fima tɔrɔ muxune ma?","poem":1},{"lineBreak":true},{"text":"Nanfera i siimayaan fima muxu nimisaxine ma,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"naxanye faxan mamɛma,","poem":1},{"lineBreak":true},{"text":"a mi fama,","poem":1},{"lineBreak":true},{"text":"naxanye sayaan fenma dangu nafunla ra?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bayo e yi luma nɛn sɛwani","poem":1},{"lineBreak":true},{"text":"e na siga laxira yi,","poem":1},{"lineBreak":true},{"text":"e bɔɲɛn yi xunbelima nɛn","poem":1},{"lineBreak":true},{"text":"e na maluxun waxatin naxan yi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nanfera muxun luyɛ a nii ra","poem":1},{"lineBreak":true},{"text":"naxan mi kira yo toma a sigɛ naxan xɔn,","poem":1},{"lineBreak":true},{"text":"Ala yɛtɛɛn naxan saxi sansanna kui?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"N ma tɔrɔne bata findi n balon na,","poem":1},{"lineBreak":true},{"text":"n gbelegbele xuiin minima alo igena.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N gaxuxi naxan birin yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"na nan n sɔtɔn be.","poem":1},{"lineBreak":true},{"text":"N yi gaxuxi tɔrɔn naxanye yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"ne nan n fari be.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N mi fa raxaraxi,","poem":1},{"lineBreak":true},{"text":"n mi bɔɲɛ xunbelixi,","poem":1},{"lineBreak":true},{"text":"n mi n matabuma,","poem":1},{"lineBreak":true},{"text":"n kɔntɔfilixi yɛyɛ.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}