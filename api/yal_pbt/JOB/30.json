{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"heading","content":["Yubaa xun mafalana: Tɔrɔya waxatin bata fa"]},{"type":"verse","number":1,"content":[{"text":"“Koni iki,","poem":1},{"lineBreak":true},{"text":"n bata findi magele seen na diidine xa,","poem":1},{"lineBreak":true},{"text":"naxanye babaye yi raɲaxu n ma,","poem":1},{"lineBreak":true},{"text":"han n mi yi tinɲɛ","poem":1},{"lineBreak":true},{"text":"e lu n ma barene yɛ","poem":1},{"lineBreak":true},{"text":"n ma xuruseene kantandeni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E babane yi nɔɛ nanse ligɛ n xa e sɛnbɛni?","poem":1},{"lineBreak":true},{"text":"E sɛnbɛn birin bata yi ɲan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kamɛn nun tɔrɔn bata yi e raxadan,","poem":1},{"lineBreak":true},{"text":"e yi donseen fenma tonbonna nin,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"e yi donseen fenma fɔtɔnne nin burunna ra,","poem":1},{"lineBreak":true},{"text":"budemaan nan tun yi e yii balon na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E yi kedixi muxune yɛ,","poem":1},{"lineBreak":true},{"text":"muxune gbelegbele e fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"alo muɲadene nan yi e ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E yi e banxine tima geya kankene nan na,","poem":1},{"lineBreak":true},{"text":"e nun yili yirene nun faran yinle ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E yi wugama fɔtɔndine nin","poem":1},{"lineBreak":true},{"text":"alo sofanle,","poem":1},{"lineBreak":true},{"text":"e yi sa e sa ɲanle yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xaxilitarene nan ne ra,","poem":1},{"lineBreak":true},{"text":"xili mi e ra,","poem":1},{"lineBreak":true},{"text":"naxanye yi kedima gbelemɛn na yamanani.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Koni iki,","poem":1},{"lineBreak":true},{"text":"n bata findi magele seen na e sigine yi,","poem":1},{"lineBreak":true},{"text":"e lu n konbɛ tun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N naɲaxu e ma,","poem":1},{"lineBreak":true},{"text":"e masigama n na.","poem":1},{"lineBreak":true},{"text":"E mi sikɛma dɛgen naminɛ n yɛtagi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bayo Ala bata n sɛnbɛn kala,","poem":1},{"lineBreak":true},{"text":"a yi n nayarabi,","poem":1},{"lineBreak":true},{"text":"e mi fa yagima feen ligɛ n na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Muxu kobine kelima n xili ma n yiifanna ma,","poem":1},{"lineBreak":true},{"text":"e katama n nabiradeni e sanne ra,","poem":1},{"lineBreak":true},{"text":"e n yɛngɛma","poem":1},{"lineBreak":true},{"text":"alogo e xa n halagi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E bata n ma kirane kala.","poem":1},{"lineBreak":true},{"text":"Birin kataxi gbalon xa n sɔtɔ,","poem":1},{"lineBreak":true},{"text":"e mako mi muxu yo ma na feni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"E fa n yɛngɛma","poem":1},{"lineBreak":true},{"text":"alo sofane na fu taan ma","poem":1},{"lineBreak":true},{"text":"e yinna rabira.","poem":1},{"lineBreak":true},{"text":"E mi sikɛma fadeni n xili ma","poem":1},{"lineBreak":true},{"text":"n ɲaxankata waxatini.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gaxun bata n nabilin,","poem":1},{"lineBreak":true},{"text":"n ma binyen bata siga","poem":1},{"lineBreak":true},{"text":"alo foyen nan a xalixi,","poem":1},{"lineBreak":true},{"text":"n ma hɛrin waxatin bata dangu","poem":1},{"lineBreak":true},{"text":"alo kundana.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Iki, n niin bama n yi.","poem":1},{"lineBreak":true},{"text":"Tɔrɔ lɔxɔne bata n li.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xɔlɛna n suxuma kɔɛɛn na","poem":1},{"lineBreak":true},{"text":"han n xɔnne,","poem":1},{"lineBreak":true},{"text":"naxan dan mi na.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ala n suxuma a sɛnbɛn birin yi n ma domaan ma,","poem":1},{"lineBreak":true},{"text":"a yi n yidɛtɛn","poem":1},{"lineBreak":true},{"text":"alo doma kɔɛɛn naxan muxune kɔɛni dɛtɛnma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A bata n woli boroni.","poem":1},{"lineBreak":true},{"text":"N bata lu","poem":1},{"lineBreak":true},{"text":"alo xuben nun burunburunna.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“N ma Ala, n na i xilima,","poem":1},{"lineBreak":true},{"text":"koni i mi n yabima.","poem":1},{"lineBreak":true},{"text":"N tima i yɛtagi,","poem":1},{"lineBreak":true},{"text":"koni i n matoma nɛn gbansan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I bata i yɛɛ xɔdɔxɔ n ma,","poem":1},{"lineBreak":true},{"text":"i n yɛngɛ i sɛnbɛn birin na.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"I bata n lu foyeni, a lu sigɛ n na.","poem":1},{"lineBreak":true},{"text":"Wuluwunla n xalima na xun xɔn.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N na a kolon a i n xalima sayaan nin,","poem":1},{"lineBreak":true},{"text":"niiramane birin sigama dɛnaxan yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“N mi yi tɔrɔ muxune mali ba,","poem":1},{"lineBreak":true},{"text":"naxanye n xili e ɲaxankatani?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Naxanye yi tɔrɔxi,","poem":1},{"lineBreak":true},{"text":"n mi wuga ne xɔn ba?","poem":1},{"lineBreak":true},{"text":"N bɔɲɛn mi yi sunu yiigelitɔne fe ra ba?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N yengi yi fe faɲine nan ma,","poem":1},{"lineBreak":true},{"text":"koni fe ɲaxine bata fa.","poem":1},{"lineBreak":true},{"text":"N yi kɛnɛnna nan mamɛma,","poem":1},{"lineBreak":true},{"text":"koni dimin bata fa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Xabu tɔrɔna n sɔtɔ,","poem":1},{"lineBreak":true},{"text":"n kui seene ɲinma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"N sigan tiin dimin nan tun yi,","poem":1},{"lineBreak":true},{"text":"n mi sogen toma mumɛ!","poem":1},{"lineBreak":true},{"text":"N tima yamaan tagi,","poem":1},{"lineBreak":true},{"text":"n yi e mafan n mali feen na,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"n wuga xuiin minima alo kankone,","poem":1},{"lineBreak":true},{"text":"alo dangaranfulene.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"N fati kidin bata fɔrɔ n ma,","poem":1},{"lineBreak":true},{"text":"a yi koyen.","poem":1},{"lineBreak":true},{"text":"Fati mawolonna bata n xɔnne yili.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"N ma kondenna bata findi sunu sigi sa seen na,","poem":1},{"lineBreak":true},{"text":"n ma xulenna yi findi wuga seen na.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}