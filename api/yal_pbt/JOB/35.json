{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"heading","content":["Elihu a falane: Fe fuun nan Yubaa falane ra"]},{"type":"verse","number":1,"content":["Nayi, Elihu mɔn yi falan ti, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“I laxi a ra a ɲɔndina i xa ba?","poem":1},{"lineBreak":true},{"text":"I yi a fala, i naxa,","poem":1},{"lineBreak":true},{"text":"‘N tinxin Ala yɛɛ ra yi.’","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Koni, i mɔn a falama,","poem":1},{"lineBreak":true},{"text":"i naxa, ‘N to mi yulubi ligaxi,","poem":1},{"lineBreak":true},{"text":"na tɔnɔn nanse ra n tan xa?’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Awa, n tan nan i yabima,","poem":1},{"lineBreak":true},{"text":"e nun i xɔyin naxanye i fɛma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I yɛɛn ti kore, i kundaan mato,","poem":1},{"lineBreak":true},{"text":"e mate i xun ma pon!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xa i yulubin liga,","poem":1},{"lineBreak":true},{"text":"na sa Ala tɔrɛ mɛnni ba?","poem":1},{"lineBreak":true},{"text":"I ya murutɛn na gbo ayi,","poem":1},{"lineBreak":true},{"text":"na nanse ligɛ a ra?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xa i tinxin, na nanse fima Ala ma?","poem":1},{"lineBreak":true},{"text":"A nanse sɔtɔma i yii na ma?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I ya fe ɲaxine muxune nan tun tɔrɔma,","poem":1},{"lineBreak":true},{"text":"i ya tinxinyaan munanfanna muxune nan ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ɲaxankatan na gbo ayi yamaan ma,","poem":1},{"lineBreak":true},{"text":"e mawugama nɛn.","poem":1},{"lineBreak":true},{"text":"Sɛnbɛmaan na e tɔrɔ,","poem":1},{"lineBreak":true},{"text":"e xui ramini malina fe ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni, muxu yo mi a falɛ, a naxa,","poem":1},{"lineBreak":true},{"text":"‘Ala minɛn, a tan naxan n daxi?","poem":1},{"lineBreak":true},{"text":"A muxune rawɛkilɛma e bɛtin ba dimini,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"a en xaranma burunna subene kɛɲane xɔn.","poem":1},{"lineBreak":true},{"text":"A fekolonna fi en ma xɔline kiine xɔn.’","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Na muxune gbelegbelema malina fe ra,","poem":1},{"lineBreak":true},{"text":"koni Ala mi e yabima,","poem":1},{"lineBreak":true},{"text":"bayo e tan findixi fe ɲaxi rabane nun wasodene nan na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E gbelegbelema fuyan,","poem":1},{"lineBreak":true},{"text":"Ala mi e ramɛma,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna mi a tuli matima e xuiin na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A i xuiin namɛma di nayi,","poem":1},{"lineBreak":true},{"text":"i tan naxan a falama a i mi a toma?","poem":1},{"lineBreak":true},{"text":"I yi a fala a i bata i ya kitin so a yii,","poem":1},{"lineBreak":true},{"text":"i a tan nan mamɛma!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Iki, bayo Alaa xɔlɔn munma fa,","poem":1},{"lineBreak":true},{"text":"e nun a mi a tuli matixi murutɛ falane ra,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"nayi, Yuba luma a fala fuun nan tun tiyɛ,","poem":1},{"lineBreak":true},{"text":"a yi fekolontare falane rawuya ayi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}