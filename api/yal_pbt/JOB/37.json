{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“Nanara, n bɔɲɛn xuruxurunma,","poem":1},{"lineBreak":true},{"text":"a keli a sadeni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ tuli mati,","poem":1},{"lineBreak":true},{"text":"ɛ tuli mati kuye sarinna ra","poem":1},{"lineBreak":true},{"text":"naxan findixi Ala xuiin na,","poem":1},{"lineBreak":true},{"text":"a sɔnxɔ xuiin naxan minima a dɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala a galanna ragodoma keli kore,","poem":1},{"lineBreak":true},{"text":"a yi a ragodo dunuɲa birin xun xɔn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na xanbi ra, a sɔnxɔ,","poem":1},{"lineBreak":true},{"text":"a yi a xui gbeen namini","poem":1},{"lineBreak":true},{"text":"alo kuye sarinna,","poem":1},{"lineBreak":true},{"text":"a mi fa galanni tima","poem":1},{"lineBreak":true},{"text":"a na a xui ramini.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A kabanako feene rabama a sɔnxɔ xuiin xɔn,","poem":1},{"lineBreak":true},{"text":"en mi nɔɛ naxanye famunɲɛ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Ala yi balabalan kɛsɛne yamari,","poem":1},{"lineBreak":true},{"text":"a naxa, ‘Ɛ godo bɔxɔni,’","poem":1},{"lineBreak":true},{"text":"a yi tulen nagodo, tule gbeen yati.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A yi muxune wanle ratima na kii nin","poem":1},{"lineBreak":true},{"text":"alogo ne birin xa a wanla kolon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hali burunna subene soma nɛn faranne kui,","poem":1},{"lineBreak":true},{"text":"e lu e yinle ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kala ti foyen yi keli sogeteden yiifanna ma,","poem":1},{"lineBreak":true},{"text":"xunbenla yi keli kɔmɛn fɔxɔni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala niiraxinla nan ige xundin naminima,","poem":1},{"lineBreak":true},{"text":"igen xunmaan yi xɔdɔxɔ alo wurena.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A yi kundane rafe tule igen na,","poem":1},{"lineBreak":true},{"text":"e nun kuye ɲin masɔxɔnna,","poem":1},{"lineBreak":true},{"text":"a yi e raxuya ayi yiren birin yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A tan nan e rasigama","poem":1},{"lineBreak":true},{"text":"alo a ragidixi kii naxan yi","poem":1},{"lineBreak":true},{"text":"alogo e xa a yamarin birin nakamali,","poem":1},{"lineBreak":true},{"text":"dunuɲa birin yi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nayi, Ala a waxɔnna nan ligama bɔxɔn fari,","poem":1},{"lineBreak":true},{"text":"a yi muxune ratɔrɔn","poem":1},{"lineBreak":true},{"text":"hanma a yi hinan e ra.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Yuba, i tuli mati ito ra.","poem":1},{"lineBreak":true},{"text":"Ti, i maɲɔxɔn Alaa kabanako feene ma!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I a kolon ba","poem":1},{"lineBreak":true},{"text":"Ala e yamarima kii naxan yi?","poem":1},{"lineBreak":true},{"text":"I a kolon ba","poem":1},{"lineBreak":true},{"text":"a galanna ragodoma kii naxan yi kundani?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I a kolon ba","poem":1},{"lineBreak":true},{"text":"e singanxi kii naxan yi foyeni?","poem":1},{"lineBreak":true},{"text":"Kabanako feni itoe findixi fekolon kamalixina wanla nan na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Koni i tan,","poem":1},{"lineBreak":true},{"text":"i luma kuye wolonxini i ya dugine yi,","poem":1},{"lineBreak":true},{"text":"foyen nɛma bɔxɔn ganɲɛ waxatin naxan yi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I nɔɛ Ala maliyɛ kuyen dadeni ba","poem":1},{"lineBreak":true},{"text":"naxan xɔdɔxɔ alo wure kikena?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yuba, a yita nxu ra","poem":1},{"lineBreak":true},{"text":"nxu nɔɛ naxan falɛ Ala xa.","poem":1},{"lineBreak":true},{"text":"Sese mi makɛnɛnxi nxu xa,","poem":1},{"lineBreak":true},{"text":"nxu dimin nin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N mi waxi n xa falan ti Ala xa.","poem":1},{"lineBreak":true},{"text":"Muxu mundun waxi Ala xa a raxɔri?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Muxu yo mi nɔɛ a yɛɛn tiyɛ sogen na,","poem":1},{"lineBreak":true},{"text":"a na te kore,","poem":1},{"lineBreak":true},{"text":"foyen na kundaan ba a yɛɛ ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Na ki kedenni,","poem":1},{"lineBreak":true},{"text":"Alaa kɛnɛnna fama","poem":1},{"lineBreak":true},{"text":"sa keli sogeteden kɔmɛn fɔxɔni","poem":1},{"lineBreak":true},{"text":"naxan luxi alo xɛmana,","poem":1},{"lineBreak":true},{"text":"nɔrɔn gbeen yi Ala rabilin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna nan a ra,","poem":1},{"lineBreak":true},{"text":"en mi nɔɛ en masoɛ naxan na,","poem":1},{"lineBreak":true},{"text":"a sɛnbɛn gbo, a kiti kɛndɛne gbo,","poem":1},{"lineBreak":true},{"text":"a mi muxu tinxinxine ɲaxankatama.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nanara, muxune gaxuma a yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"koni a tan yɛtɛɛn mi na muxune yatɛxi","poem":1},{"lineBreak":true},{"text":"naxanye e yɛtɛ yatɛxi xaxilimane ra.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}