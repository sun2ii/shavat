{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“I a kolon ba","poem":1},{"lineBreak":true},{"text":"bolen diin xalima waxatin naxan yi?","poem":1},{"lineBreak":true},{"text":"I xɛnle toma ba, e nɛma diin xalɛ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I e kuiin maxali waxatin yatɛma ba?","poem":1},{"lineBreak":true},{"text":"I e dii xali waxatin kolon ba,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"e na e felen e dii xalin tɔrɔni,","poem":1},{"lineBreak":true},{"text":"e yi e diin xali?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E diine sɛnbɛn sɔtɔma,","poem":1},{"lineBreak":true},{"text":"e gbo xunnabani.","poem":1},{"lineBreak":true},{"text":"Na xanbi ra, e keli e ngane fɛma,","poem":1},{"lineBreak":true},{"text":"e mi fa fama sɔnɔn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Nde burunna sofanla xunnabaxi?","poem":1},{"lineBreak":true},{"text":"Nde a fulunxi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N bata tonbonna findi a dɔxɔden na,","poem":1},{"lineBreak":true},{"text":"fɔxɔ bɔxɔn yi findi a konna ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A na sɔnxɔ sɔnxɔ xuiin mɛ taane yi,","poem":1},{"lineBreak":true},{"text":"a gele,","poem":1},{"lineBreak":true},{"text":"a mi soo ragiin xuiin mɛ mumɛ!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A sigama a dɛgɛdeni geyane nan fari,","poem":1},{"lineBreak":true},{"text":"dɛnaxan xinde, a yi mɛn fen.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Burunna ɲingen tinɲɛ findɛ i ya walikɛɛn na ba?","poem":1},{"lineBreak":true},{"text":"A xiyɛ i ya xuruseene balon sa seen dɛxɔn ba?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I nɔɛ a xidɛ","poem":1},{"lineBreak":true},{"text":"alogo a xa i ya xɛɛn bi ba?","poem":1},{"lineBreak":true},{"text":"A xɛɛ rabɔnbɔ seen bandunɲɛ i fɔxɔ ra mɛrɛmɛrɛne yi ba?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I yigin sɛ a yi ba,","poem":1},{"lineBreak":true},{"text":"bayo a sɛnbɛn gbo?","poem":1},{"lineBreak":true},{"text":"I ya wali xɔdɛxɛne luyɛ a ma ba?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I yengi sɛ a ma ba?","poem":1},{"lineBreak":true},{"text":"A fɛ i ya se xabaxine ra i xa,","poem":1},{"lineBreak":true},{"text":"a fa e sa i ya lonna ma?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dangaranfulene gabutɛne yitema sɛwani,","poem":1},{"lineBreak":true},{"text":"koni e mi nɔɛ tuganɲɛ","poem":1},{"lineBreak":true},{"text":"alo xɔliin bodene.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A xɛlɛne luma biraxi bɔxɔn nan ma,","poem":1},{"lineBreak":true},{"text":"a yi e lu burunburun wolonni.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A mi mirixi a ma","poem":1},{"lineBreak":true},{"text":"fa fala e nɔɛ yibɔɛ nɛn,","poem":1},{"lineBreak":true},{"text":"a burunna subena nde tiyɛ e yi nɛn.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A ɲaxu a diine ra","poem":1},{"lineBreak":true},{"text":"alo a tan xa mi e xalixi,","poem":1},{"lineBreak":true},{"text":"a mi gaxuma","poem":1},{"lineBreak":true},{"text":"fa fala a bata tɔrɔ fuuni e xalideni.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ala bata a kuma fe kolonna ra,","poem":1},{"lineBreak":true},{"text":"a mi xaxili fixi a ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koni, a na keli a gideni,","poem":1},{"lineBreak":true},{"text":"a gelema nɛn soon nun soo ragiin ma.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“I tan nan sɛnbɛn fima soon ma ba?","poem":1},{"lineBreak":true},{"text":"I tan nan a kɔɛ ma xabene saxi ba?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I nɔɛ a ratuganɲɛ alo suɲɛna?","poem":1},{"lineBreak":true},{"text":"A gbelegbele xuiin magaxun nan tima.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A bɔxɔni sɔxɔnma a torone ra lanbanni,","poem":1},{"lineBreak":true},{"text":"a sɛwaxi a fangan na,","poem":1},{"lineBreak":true},{"text":"a sigama ganla yɛɛ ra yɛngɛni.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gaxun bɔtɛ mi a xa,","poem":1},{"lineBreak":true},{"text":"a mi kuisanna kolon,","poem":1},{"lineBreak":true},{"text":"a mi xɛtɛma a xanbi ra silanfanna yɛɛ ra.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xalimakuli sa seen nun tanban gbeen nun a xurin naxan xidixi a fari,","poem":1},{"lineBreak":true},{"text":"ne xuiin minima a nɛma a giyɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A kunfaxin tuganma, a siga.","poem":1},{"lineBreak":true},{"text":"Xɔtaan na fe,","poem":1},{"lineBreak":true},{"text":"a mi fa nɔɛ tiyɛ yɛngɛni.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Xɔta xuiin na mini,","poem":1},{"lineBreak":true},{"text":"a gbelegbele sɛwani,","poem":1},{"lineBreak":true},{"text":"a yɛngɛn xirin mɛma","poem":1},{"lineBreak":true},{"text":"hali a nɛma sa wulani,","poem":1},{"lineBreak":true},{"text":"e nun kuntigine gbelegbele xuiin nun yɛngɛ so xuina.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Sɛgɛn tuganma i ya xaxilimayaan nan xɔn ba,","poem":1},{"lineBreak":true},{"text":"a yi a gabutɛne yibandun sogeteden yiifanna binni?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Singbinna tuganma i ya yamarin nan bun ba,","poem":1},{"lineBreak":true},{"text":"a yi a tɛɛn sa geya matexine fari?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A yigiyaxi gɛmɛ yirene nin,","poem":1},{"lineBreak":true},{"text":"a yire makantanxine nin geyane xuntagi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"A a donseen fenma mɛnna nin","poem":1},{"lineBreak":true},{"text":"a nɛma dɔxi,","poem":1},{"lineBreak":true},{"text":"a yi sa a to yire makuyeni.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Binbine dɛnaxan yi, a mɛnna nin,","poem":1},{"lineBreak":true},{"text":"a diine baloma wunla nan na.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}