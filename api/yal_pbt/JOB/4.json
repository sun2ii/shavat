{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifasi a falan Yuba xa"]},{"type":"verse","number":1,"content":["Nayi, Teman kaana Elifasi yi falan tongo, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“Xa n falan ti i xa,","poem":1},{"lineBreak":true},{"text":"i nɔɛ diɲɛ na ma ba?","poem":1},{"lineBreak":true},{"text":"Koni, nde nɔɛ a dundɛ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mato,","poem":1},{"lineBreak":true},{"text":"i bata muxu wuyaxi xaran,","poem":1},{"lineBreak":true},{"text":"i yi sɛnbɛtarene madɛndɛn,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"naxanye yi birama,","poem":1},{"lineBreak":true},{"text":"i ya falan yi ne rakeli,","poem":1},{"lineBreak":true},{"text":"naxanye san yi xadanma,","poem":1},{"lineBreak":true},{"text":"i yi ne mali.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iki, na bata i fan sɔtɔ,","poem":1},{"lineBreak":true},{"text":"anu i bata yigitɛgɛ.","poem":1},{"lineBreak":true},{"text":"A to i tan li, i yi kɔntɔfili.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ya lannantenyaan xa lu i ya Ala yɛɛragaxuni,","poem":1},{"lineBreak":true},{"text":"i ya fɛtareyaan yi findi i yigin na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Awa, i miri,","poem":1},{"lineBreak":true},{"text":"sɔntaren mundun bata halagi?","poem":1},{"lineBreak":true},{"text":"Muxu faɲin mundun bata raxɔri?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N naxan nakɔrɔsixi,","poem":1},{"lineBreak":true},{"text":"naxanye hakɛ feene ligama e nun","poem":1},{"lineBreak":true},{"text":"naxanye ɲaxankatan tima,","poem":1},{"lineBreak":true},{"text":"ne na saranna sɔtɔma nɛn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alaa foyen nan e halagima,","poem":1},{"lineBreak":true},{"text":"a xɔlɔn tɛɛn yi e gan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala yatane wurundun xuiin nadunduma,","poem":1},{"lineBreak":true},{"text":"a yi yata sɛnbɛmane ɲinne gira.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nayi, yatan faxama donsetareyaan nan na,","poem":1},{"lineBreak":true},{"text":"yatana diine yi xuya ayi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Xibarun bata fa n ma","poem":1},{"lineBreak":true},{"text":"alo wundona,","poem":1},{"lineBreak":true},{"text":"n tunla bata ɲunuɲunun xuiin mɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xiyene nɛma fɛ kɔɛɛn na,","poem":1},{"lineBreak":true},{"text":"xixɔnla nɛma muxune fari,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"gaxu gbeen yi n suxu,","poem":1},{"lineBreak":true},{"text":"n xɔnne birin yi xuruxurun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yinnan yi dangu n yɛtagi,","poem":1},{"lineBreak":true},{"text":"n fati ma xaben yi ramaxa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sena nde yi tixi n yɛtagi,","poem":1},{"lineBreak":true},{"text":"n mi yi naxan kolon,","poem":1},{"lineBreak":true},{"text":"a nininna yi n yɛɛ ma.","poem":1},{"lineBreak":true},{"text":"Na yi madundu,","poem":1},{"lineBreak":true},{"text":"na xanbi ra n yi xuina nde mɛ, a naxa,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"‘Adamadiin tinxinɲɛ ayi dangu Ala ra ba?","poem":1},{"lineBreak":true},{"text":"Muxun sariɲanɲɛ ayi","poem":1},{"lineBreak":true},{"text":"dangu a Dali Marigin na ba?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa Ala mi laxi a walikɛne ra,","poem":1},{"lineBreak":true},{"text":"xa a fe ɲaxin to a malekane yi,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"a fa lɛ muxune ra nayi ba,","poem":1},{"lineBreak":true},{"text":"naxanye bɛndɛ banxine kui,","poem":1},{"lineBreak":true},{"text":"naxanye fatiye findixi bɛndɛn na,","poem":1},{"lineBreak":true},{"text":"naxanye yibutuxunɲɛ","poem":1},{"lineBreak":true},{"text":"alo laxaturane?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"E faxɛ nɛn lɔxɔ kedenni.","poem":1},{"lineBreak":true},{"text":"E halagɛ nɛn habadan,","poem":1},{"lineBreak":true},{"text":"muxe mi kɔntɔfili e fe ra.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"E bubune xidi lutine bata bolon,","poem":1},{"lineBreak":true},{"text":"e faxama nɛn e fekolontareyani.’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}