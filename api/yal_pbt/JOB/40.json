{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["Alatala mɔn yi a fala Yuba xa, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“I tan naxan Ala Sɛnbɛ Kanna yalagima,","poem":1},{"lineBreak":true},{"text":"i mɔn luyɛ a matandɛ?","poem":1},{"lineBreak":true},{"text":"I tan naxan Ala mafalama,","poem":1},{"lineBreak":true},{"text":"i nɔɛ a yabɛ?”","poem":1}]},{"type":"heading","content":["Yuba yi Ala yabi"]},{"type":"verse","number":3,"content":["Yuba yi Alatala yabi, a naxa,"]},{"type":"verse","number":4,"content":[{"text":"“Sese mi n tan na.","poem":1},{"lineBreak":true},{"text":"N nɔɛ i yabɛ nanse ra?","poem":1},{"lineBreak":true},{"text":"Fɔ n na n yiin sa n dɛ ra,","poem":1},{"lineBreak":true},{"text":"n yi n dundu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N bata falan ti,","poem":1},{"lineBreak":true},{"text":"n mi fa yabi tima.","poem":1},{"lineBreak":true},{"text":"N bata a radangu ayi,","poem":1},{"lineBreak":true},{"text":"n mi fa sese falama.”","poem":1}]},{"type":"heading","content":["Alaa yabina"]},{"type":"verse","number":6,"content":["Alatala yi Yuba yabi wuluwulu gbeeni, a naxa,"]},{"type":"verse","number":7,"content":[{"text":"“Keli, i yitɔn alo xɛmɛ wɛkilɛxina,","poem":1},{"lineBreak":true},{"text":"n xa i maxɔdin, i yi n yabi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I waxi a fala feen nin ba","poem":1},{"lineBreak":true},{"text":"fa fala a n mi kiti kɛndɛn sama?","poem":1},{"lineBreak":true},{"text":"I waxi n yalagi feen nin ba,","poem":1},{"lineBreak":true},{"text":"i yi yoon fi i yɛtɛ ma?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I sɛnbɛn gbo alo Ala ba?","poem":1},{"lineBreak":true},{"text":"I xuiin findɛ kuye sarinna ra ba","poem":1},{"lineBreak":true},{"text":"alo Ala gbeena?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“I yɛtɛ maxidi binyen nun gboon na,","poem":1},{"lineBreak":true},{"text":"i yi i maxidi nɔrɔn nun xunnayerenna ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I ya xɔlɔn nasiga muxune ma,","poem":1},{"lineBreak":true},{"text":"i wasodene birin nagodo sanɲa yi kedenni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I wasodene birin nagodo sanɲa yi kedenni yati,","poem":1},{"lineBreak":true},{"text":"i ɲaxudene birin halagi","poem":1},{"lineBreak":true},{"text":"e dɛnaxanye yi,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"i yi ne birin maluxun,","poem":1},{"lineBreak":true},{"text":"i yi e balan gaburun kui.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nayi, xa i yi na liga nun,","poem":1},{"lineBreak":true},{"text":"n tan yɛtɛɛn yi i matɔxɔma nɛn,","poem":1},{"lineBreak":true},{"text":"bayo i yɛtɛ sɛnbɛn yi i rakisima nɛn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Malinna mato, sube magaxuxina.","poem":1},{"lineBreak":true},{"text":"N tan nan a daxi","poem":1},{"lineBreak":true},{"text":"alo n ni i daxi kii naxan yi.","poem":1},{"lineBreak":true},{"text":"A sɛxɛn donma alo ɲingena.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A sɛnbɛna a tagin nin.","poem":1},{"lineBreak":true},{"text":"A sɛnbɛna a fudi ma fasane nin.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A xunla xɔdɔxɔ alo sumanna,","poem":1},{"lineBreak":true},{"text":"a danba subene fasane yibalanxi ken!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A xɔnne fan luxi alo sulana,","poem":1},{"lineBreak":true},{"text":"a ɲɛnsɛn xɔnne luxi alo wurena.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“A findixi Alaa dalise fisamantenna nan na.","poem":1},{"lineBreak":true},{"text":"N tan, a da mangan nan keden nɔɔn sɔtɔma a ma silanfanna ra.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A balon sɔtɔma geyane fari,","poem":1},{"lineBreak":true},{"text":"burunna subene birin dɛnaxan yi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A sama wudine nan bun,","poem":1},{"lineBreak":true},{"text":"a yi a luxun dara yi gbalane bun,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"a matabuma wudine nininna nan na,","poem":1},{"lineBreak":true},{"text":"wudin naxanye xuden dɛ,","poem":1},{"lineBreak":true},{"text":"ne yi a rabilin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Xa igen gbo ayi, a mi gaxuma,","poem":1},{"lineBreak":true},{"text":"hali Yurudɛn baa igen fa han a dɛ,","poem":1},{"lineBreak":true},{"text":"a luma nɛn xaxili sani.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Xa a yɛɛne rabixi,","poem":1},{"lineBreak":true},{"text":"nde nɔɛ a suxɛ?","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ a suxɛ,","poem":1},{"lineBreak":true},{"text":"a wuren bira a ɲɔɛni?","poem":1}]},{"type":"heading","content":["Ige yi sube ɲaxina"]},{"type":"verse","number":25,"content":[{"text":"I ige yi sube ɲaxin suxɛ kɔnna ra ba?","poem":1},{"lineBreak":true},{"text":"I a suxɛ a lɛnna ma ba i ya lutin na?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I gbalan sɔtɛ a ɲɔɛɛn kui ba,","poem":1},{"lineBreak":true},{"text":"i yi a gbɛgbɛn sɔxɔn wuren na?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"I mirixi a ma","poem":1},{"lineBreak":true},{"text":"a kankanɲɛ i mafanna ma ba,","poem":1},{"lineBreak":true},{"text":"a fala faɲine ti i xa?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A layirin xidɛ ɛ tagi ba,","poem":1},{"lineBreak":true},{"text":"a findɛ i ya konyin na habadan?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"I sabaan soɛ a ra ba alo xɔlina?","poem":1},{"lineBreak":true},{"text":"I lutin xidɛ a sanna ra ba,","poem":1},{"lineBreak":true},{"text":"i yi a so i ya dii tɛmɛne yii?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yɛxɛ suxune a matiyɛ lɔxɔni ba,","poem":1},{"lineBreak":true},{"text":"e a yitaxunɲɛ yulane ra?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"I nɔɛ a kidin kalɛ xalimakunle ra ba?","poem":1},{"lineBreak":true},{"text":"I nɔɛ a xunna sɔxɔnɲɛ kulundene ra ba?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nayi, hali i yiin din a ra a yɛngɛ xinla ma","poem":1},{"lineBreak":true},{"text":"sanɲa ma keden pe,","poem":1},{"lineBreak":true},{"text":"i mi fa na ɲɔxɔn ligama sɔnɔn.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":32}