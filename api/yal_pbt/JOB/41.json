{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“Muxun naxan waxi a xa a nɔ,","poem":1},{"lineBreak":true},{"text":"na a yɛtɛ nan madaxuma.","poem":1},{"lineBreak":true},{"text":"Muxu yo na a to tun,","poem":1},{"lineBreak":true},{"text":"na birama nɛn a xanbiramaan na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muxu yo mi susɛ yɛngɛn bagɛ a ma,","poem":1},{"lineBreak":true},{"text":"nayi nde susɛ tiyɛ n yɛtagi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nde a doli n ma,","poem":1},{"lineBreak":true},{"text":"alogo n xa a fi?","poem":1},{"lineBreak":true},{"text":"N tan nan gbee dunuɲa seene birin na!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“N mɔn xa falan ti ige yi sube ɲaxin salen seene ma,","poem":1},{"lineBreak":true},{"text":"e nun a sɛnbɛ magaxuxin nun a fati faɲina.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nde nɔɛ a kidin bɛ a ma?","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ a xanle sɔxɔnɲɛ","poem":1},{"lineBreak":true},{"text":"naxanye xɔdɔxɔ alo wurena?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nde nɔɛ a gbɛgbɛni biyɛ?","poem":1},{"lineBreak":true},{"text":"Muxune gaxuma a ɲinne nan yɛɛ ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A xali xɔdɛxɛne safa wuyaxi nan a fari,","poem":1},{"lineBreak":true},{"text":"e dɔxi e bode ra a fari","poem":1},{"lineBreak":true},{"text":"alo yɛ masansan wure lefane.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E saxi e bode fari,","poem":1},{"lineBreak":true},{"text":"hali foyen mi nɔɛ danguɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E tugunxi e bode ra,","poem":1},{"lineBreak":true},{"text":"e bode suxi,","poem":1},{"lineBreak":true},{"text":"e mi nɔɛ bɛ e bode ra.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ige yi sube ɲaxin na tison,","poem":1},{"lineBreak":true},{"text":"kɛnɛnna yi mini,","poem":1},{"lineBreak":true},{"text":"a yɛɛne luxi alo subaxana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɛɛ dɛgɛn minima a dɛ,","poem":1},{"lineBreak":true},{"text":"tɛɛ wolonne tuganma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A ɲɔɛ tutin tema,","poem":1},{"lineBreak":true},{"text":"alo tunde wolonna,","poem":1},{"lineBreak":true},{"text":"alo sɛxɛ tutina.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A ɲɔɛ foyen tigine radɛgɛma,","poem":1},{"lineBreak":true},{"text":"tɛɛ dɛgɛn yi mini a dɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sɛnbɛna a kɔɛɛn nin,","poem":1},{"lineBreak":true},{"text":"gaxun nan sigama a yɛɛ ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A fati kidin ɲixiriɲixirine wuya,","poem":1},{"lineBreak":true},{"text":"e bata xɔdɔxɔ ayi a ma,","poem":1},{"lineBreak":true},{"text":"sese mi bama a ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A bɔɲɛn xɔdɔxɔ alo gɛmɛna,","poem":1},{"lineBreak":true},{"text":"a xɔdɔxɔ alo se kunba gɛmɛna.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“A na keli, alane yi gaxu,","poem":1},{"lineBreak":true},{"text":"e yigitɛgɛxin yi xɛtɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Silanfanna mi sese ligama a ra,","poem":1},{"lineBreak":true},{"text":"hanma tanba xurin nun dɛgɛmaan nun tanba gbeena.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wuren luxi nɛn a tan xa","poem":1},{"lineBreak":true},{"text":"alo sɛxɛna,","poem":1},{"lineBreak":true},{"text":"sulana alo wudi kunxina.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A mi a gima xalimakunla yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"lantan gɛmɛne findixi se dagin nan na a tan xa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbelemɛn luxi nɛn a tan xa","poem":1},{"lineBreak":true},{"text":"alo sɛxɛna,","poem":1},{"lineBreak":true},{"text":"a gelen tanban woli xuiin ma nɛn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A kui kidin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo gɛmɛ ralemunxine,","poem":1},{"lineBreak":true},{"text":"alo xɛɛ rabɔnbɔ seen naxan bubuma boroni.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“A na sin fɔxɔ igen tilinna ma,","poem":1},{"lineBreak":true},{"text":"igen yi a ramini alo a tɛɛn nan ma.","poem":1},{"lineBreak":true},{"text":"A fɔxɔ igeni maxama nɛn","poem":1},{"lineBreak":true},{"text":"alo seri igen tɛɛn ma.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A funfuni yalanxin nan luma a xanbi ra igeni,","poem":1},{"lineBreak":true},{"text":"a lu alo fonna xun sɛxɛn na mini fufaan fari.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"A kanna mi muxu yo ra bɔxɔ xɔnna fari.","poem":1},{"lineBreak":true},{"text":"Dali seen na a ra naxan mi gaxuma.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A yaxu sɛnbɛma yo na keli,","poem":1},{"lineBreak":true},{"text":"a yɛɛn yoma na kanna ma nɛn,","poem":1},{"lineBreak":true},{"text":"bayo a tan nan sube xaɲɛne birin ma mangan na.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":26}