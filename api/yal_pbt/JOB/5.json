{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“Iki, xinla ti i mali feen na!","poem":1},{"lineBreak":true},{"text":"Muxuna nde na ba naxan i yabɛ?","poem":1},{"lineBreak":true},{"text":"I falan tima maleka sariɲanxin mundun xa?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fe matandin nan xaxilitaren faxama.","poem":1},{"lineBreak":true},{"text":"Xɔxɔlɔnya gbeen yi kɔmɔn faxa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N xaxilitaren to nɛn sabatɛ,","poem":1},{"lineBreak":true},{"text":"koni dangan so nɛn a banxini xulɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mali ti yo mi a diine xa,","poem":1},{"lineBreak":true},{"text":"e bata yalagi taan kitisadeni,","poem":1},{"lineBreak":true},{"text":"muxu yo mi e xunba!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kamɛtɔne a sansi bogine donma.","poem":1},{"lineBreak":true},{"text":"Hali naxanye ɲanle tagi,","poem":1},{"lineBreak":true},{"text":"e yi ne birin tongo,","poem":1},{"lineBreak":true},{"text":"yiigelitɔne yi a yiiseene tongo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hakɛn mi kelima bɔxɔn xan yi,","poem":1},{"lineBreak":true},{"text":"sɔxɔlɛn mi solima bɔxɔni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Muxun daxi sɔxɔlɛn nan xili yi,","poem":1},{"lineBreak":true},{"text":"alo tɛɛ budone to tuganma ayi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Xa n tan na yi a ra nun,","poem":1},{"lineBreak":true},{"text":"n yi Ala nan maxandima,","poem":1},{"lineBreak":true},{"text":"n yi n ma kɔntɔfinla yita Ala ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A feen naxanye ligama ne gbo,","poem":1},{"lineBreak":true},{"text":"e mi yɛɛ toɛ,","poem":1},{"lineBreak":true},{"text":"a kabanako feene dan mi na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A tulen nafama bɔxɔn fari,","poem":1},{"lineBreak":true},{"text":"a igen nafa xɛɛne ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Muxun naxanye magodoxi,","poem":1},{"lineBreak":true},{"text":"a ne yite.","poem":1},{"lineBreak":true},{"text":"Naxanye sunuxi,","poem":1},{"lineBreak":true},{"text":"a kisin fi ne ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A muxu kɔtaxine miriyane kalama,","poem":1},{"lineBreak":true},{"text":"e mi nɔ sɔtɔma e feene yi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A xaxilimane suxuma","poem":1},{"lineBreak":true},{"text":"e yɛtɛna kɔtɛne nan xɔn,","poem":1},{"lineBreak":true},{"text":"kɔtadene fe yitɔnxine kalama nɛn xulɛn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"E soma dimini yanyi tagin nin,","poem":1},{"lineBreak":true},{"text":"e tantanma yanyi tagini","poem":1},{"lineBreak":true},{"text":"alo kɔɛɛn na a ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Koni, a tan tɔrɔ muxun natangama fala ɲaxin ma","poem":1},{"lineBreak":true},{"text":"naxan luxi alo silanfanna,","poem":1},{"noteId":1},{"lineBreak":true},{"text":"a e rakisi sɛnbɛ kanna ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nayi, yigin sɛnbɛtaren xa,","poem":1},{"lineBreak":true},{"text":"koni fala mi tinxintaren dɛ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Nayi, sɛwan na kanna xa","poem":1},{"lineBreak":true},{"text":"Ala na naxan natɔrɔn!","poem":1},{"lineBreak":true},{"text":"I nama i mɛ Ala Sɛnbɛ Kanna a xurun na.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amasɔtɔ a tan nan maxɔlɔn tima,","poem":1},{"lineBreak":true},{"text":"a yi dandanna ti.","poem":1},{"lineBreak":true},{"text":"A tan nan faxan tima,","poem":1},{"lineBreak":true},{"text":"a mɔn yi marakisin ti.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A i rakisɛ nɛn tɔrɔn ma","poem":1},{"lineBreak":true},{"text":"dɔxɔɲa ma sennin,","poem":1},{"lineBreak":true},{"text":"a i ratanga fe ɲaxin ma","poem":1},{"lineBreak":true},{"text":"dɔxɔɲa ma solofere.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A i rakisima nɛn","poem":1},{"lineBreak":true},{"text":"faxan ma fitina kamɛni,","poem":1},{"lineBreak":true},{"text":"a i rakisi silanfanna ma yɛngɛni.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A i ratangama nɛn fala ɲaxin ma,","poem":1},{"lineBreak":true},{"text":"i mi gaxuma halagin waxatini.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Halagin nun fitina kamɛn bɔtɛ mi luma i xa,","poem":1},{"lineBreak":true},{"text":"i mi gaxuma burunna subene yɛɛ ra.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gɛmɛ mi taranma i ya xɛɛn ma,","poem":1},{"lineBreak":true},{"text":"hali burunna subene,","poem":1},{"lineBreak":true},{"text":"yɛngɛ mi luma ɛ nun ne tagi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bɔɲɛ xunbenla luma nɛn i konni.","poem":1},{"lineBreak":true},{"text":"I na i ya xuruseene xun mato a ra,","poem":1},{"lineBreak":true},{"text":"i a lima nɛn sese mi dasaxi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"I ya diine wuyama ayi nɛn,","poem":1},{"lineBreak":true},{"text":"i yixɛtɛne yigboma ayi nɛn alo sɛxɛna.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I faxama foriyaan nin,","poem":1},{"lineBreak":true},{"text":"alo murutuna a xaba waxatini.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Nxɔ fe xɔnfenna xun soon nan na ra.","poem":1},{"lineBreak":true},{"text":"I tuli mati na ra, i xaxili sɔtɔ.”","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"5.15Silanfanna:Sofane yɛngɛso dɛgɛmana.","reference":{"chapter":5,"verse":15}}]},"thisChapterLink":"/api/yal_pbt/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}