{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Yubaa yabina Elifasi xa"]},{"type":"verse","number":1,"content":["Yuba yi a yabi, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“N yi wama nɛn","poem":1},{"lineBreak":true},{"text":"n ma sunun yatɛn xa kolon,","poem":1},{"lineBreak":true},{"text":"n ma tɔrɔn yi sa sikeela kanke ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A yi binyama ayi nɛn","poem":1},{"lineBreak":true},{"text":"dangu baan ɲɛmɛnsinna ra.","poem":1},{"lineBreak":true},{"text":"Nanara, n ma falan bata radangu ayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɲɔndin na a ra,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna bata n sɔxɔn","poem":1},{"lineBreak":true},{"text":"a xalimakunle ra,","poem":1},{"lineBreak":true},{"text":"e xɔlɛn yi so n niini,","poem":1},{"lineBreak":true},{"text":"n bata gaxu gbalone yɛɛ ra","poem":1},{"lineBreak":true},{"text":"Ala naxanye rafama n xili ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Burunna sofanla luyɛ wugɛ sɛxɛ sabatixini ba?","poem":1},{"lineBreak":true},{"text":"Ɲingen wugɛ sɛxɛ xɔnla ma sɛxɛni ba?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Donseen naxan mi ɲaxun,","poem":1},{"lineBreak":true},{"text":"na donɲɛ ba xa fɔxɔ mi a yi?","poem":1},{"lineBreak":true},{"text":"Silon xinden ɲaxun muxun dɛ ba?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N mi yi waxi","poem":1},{"lineBreak":true},{"text":"n yiin din feni na donseene ra.","poem":1},{"lineBreak":true},{"text":"N ma tɔrɔn bata findi donseen na n xa","poem":1},{"lineBreak":true},{"text":"naxan mi ɲaxun!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“N waxi nɛn","poem":1},{"lineBreak":true},{"text":"n ma maxɔdinna xa yabi,","poem":1},{"lineBreak":true},{"text":"Ala yi n waxɔn feen liga n xa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A xa Ala kɛnɛn, a yi n faxa.","poem":1},{"lineBreak":true},{"text":"A xa a yiini bandun, a yi n naɲan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nayi, n bɔɲɛ xunbenla sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"n sɛwa n ma tɔrɔ ɲantareni,","poem":1},{"lineBreak":true},{"text":"bayo n mi n mɛma Ala sariɲanxina falane ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N sɛnbɛn bata ɲan,","poem":1},{"lineBreak":true},{"text":"n yi yigitɛgɛ.","poem":1},{"lineBreak":true},{"text":"N naɲanna findima nanse ra,","poem":1},{"lineBreak":true},{"text":"n to luma n nii ra?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N sɛnbɛn luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo gɛmɛ xɔdɛxɛn ba?","poem":1},{"lineBreak":true},{"text":"N fati bɛndɛn findixi sulan nan na ba?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N mali se yo mi fa n yii,","poem":1},{"lineBreak":true},{"text":"hali a xuridina, a mi fa n yii.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Muxun naxan yigitɛgɛni","poem":1},{"lineBreak":true},{"text":"na lan a hinanna sɔtɔ a xɔyine ra,","poem":1},{"lineBreak":true},{"text":"hali a na a mɛ Ala Sɛnbɛ Kanna yɛɛragaxun na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Anu, n xɔyine tan bata n yanfa","poem":1},{"lineBreak":true},{"text":"alo baa igen na xara tonbonni,","poem":1},{"lineBreak":true},{"text":"alo baa wunle na xara.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xunbeli waxatin naɲanni,","poem":1},{"lineBreak":true},{"text":"e findima nɛn fufaan na,","poem":1},{"lineBreak":true},{"text":"e rafe ige xunbenla nun ige dundun na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Soge furen na, e xɔri,","poem":1},{"lineBreak":true},{"text":"sogen na te, e xara xulɛn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yulane kiraan beɲinma","poem":1},{"lineBreak":true},{"text":"siga na ige fendeni,","poem":1},{"lineBreak":true},{"text":"e siga tonbonni, e faxa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tema kaa yulane igen fenma,","poem":1},{"lineBreak":true},{"text":"Saba kaa sigatiine tan","poem":1},{"lineBreak":true},{"text":"ne laxi a ra a igen na yi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Koni, e yagima nɛn","poem":1},{"lineBreak":true},{"text":"bayo e bata e yigi sa na yi,","poem":1},{"lineBreak":true},{"text":"e na na li, e sunuma nɛn.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɛ luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo na igen tonbonni n tan xa.","poem":1},{"lineBreak":true},{"text":"Ɛ na n ma tɔrɔn to, ɛ gaxuma nɛn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N bata ɛ maxɔdin kisena nde ma ba?","poem":1},{"lineBreak":true},{"text":"N bata ɛ maxɔdin","poem":1},{"lineBreak":true},{"text":"a ɛ xa finmase yifuxina nde fi muxuna nde ma n xa ba?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N bata ɛ maxɔdin","poem":1},{"lineBreak":true},{"text":"a ɛ xa n ba yaxun yii ba?","poem":1},{"lineBreak":true},{"text":"N bata ɛ maxɔdin","poem":1},{"lineBreak":true},{"text":"a ɛ xa n xunba n ɲaxankata muxune yii ba?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Ɛ n xaran, nayi, n xa n dundu.","poem":1},{"lineBreak":true},{"text":"N naxan kalaxi, ɛ na fala n xa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Fala faɲine mi muxun tɔrɔma,","poem":1},{"lineBreak":true},{"text":"koni ɛ mafalane tɔnɔn nanse ra?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ɛ waxi n ma falane nan matandi fe yi","poem":1},{"lineBreak":true},{"text":"alo yigitarena fala fuune.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ɛ muxu sifan susɛ masɛnsɛnna tiyɛ","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa kiridin sɔtɔ ɛ konyin na,","poem":1},{"lineBreak":true},{"text":"ɛ yi sa ɛ xɔyi kɛndɛn mati konyiyani!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Iki, ɛ yɛɛ ra findi n ma,","poem":1},{"lineBreak":true},{"text":"n wulen falɛ ɛ yɛtagi ba?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ɛ xɛtɛ na falan fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"n bata ɛ mafan,","poem":1},{"lineBreak":true},{"text":"ɛ nama findi tinxintarene ra.","poem":1},{"lineBreak":true},{"text":"Ɛ mɔn xa xɛtɛ, ɛ miri,","poem":1},{"lineBreak":true},{"text":"n ma tinxinyaan nan a bunna ra.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tinxintareya falana n dɛ ba?","poem":1},{"lineBreak":true},{"text":"N mi nɔɛ fe ɲaxin kolonɲɛ ba?”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}