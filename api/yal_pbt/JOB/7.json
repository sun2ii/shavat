{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"heading","content":["Yuba yi a tɔrɔna fe fala Ala xa"]},{"type":"verse","number":1,"content":[{"text":"“Adamadina dunuɲa yi gidin xɔdɔxɔ","poem":1},{"lineBreak":true},{"text":"alo sofa wanla ganli,","poem":1},{"lineBreak":true},{"text":"a siimayana","poem":1},{"lineBreak":true},{"text":"alo karahan walikɛɛn gbeena,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"alo konyina,","poem":1},{"lineBreak":true},{"text":"nininna xɔnla naxan ma,","poem":1},{"lineBreak":true},{"text":"alo walikɛɛn naxan a saren mamɛma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na kiini, n kɛɛn bata findi fuun na","poem":1},{"lineBreak":true},{"text":"n ma siimayani,","poem":1},{"lineBreak":true},{"text":"kɔɛne yi rafe sɔxɔlɛne ra n tan xa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N na n sa, n yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"‘N kelima waxatin mundun yi?’","poem":1},{"lineBreak":true},{"text":"Kɔɛɛn mi ɲanma,","poem":1},{"lineBreak":true},{"text":"n lu n maxɛtɛ n ma saden ma","poem":1},{"lineBreak":true},{"text":"han xɔtɔnni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kunle nun bɛndɛna n fatin ma","poem":1},{"lineBreak":true},{"text":"alo dugina,","poem":1},{"lineBreak":true},{"text":"setene sɔxɔnma n fatin birin ma,","poem":1},{"lineBreak":true},{"text":"a kun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ma siimayaan mafura danguɛ","poem":1},{"lineBreak":true},{"text":"dangu gɛsɛ sɔxɔnna kinaan na,","poem":1},{"lineBreak":true},{"text":"a danguma yigitɛgɛni.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ala, a xa rabira i ma,","poem":1},{"lineBreak":true},{"text":"a n ma siimayaan mi buma,","poem":1},{"lineBreak":true},{"text":"n mi fa hɛrin toma n yɛɛn na sɔnɔn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yɛɛn naxan n matoma,","poem":1},{"lineBreak":true},{"text":"na mi fa n toma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"i n fenma nɛn, koni n mi fa na sɔnɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kundaan naxan danguma,","poem":1},{"lineBreak":true},{"text":"na ɲanma nɛn.","poem":1},{"lineBreak":true},{"text":"Na kiini, muxun naxan na siga laxira yi,","poem":1},{"lineBreak":true},{"text":"na mi fa xɛtɛma sɔnɔn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A mi fa xɛtɛma a banxini sɔnɔn,","poem":1},{"lineBreak":true},{"text":"a konna mi fa a kolonma sɔnɔn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nanara, n mi fa n dunduma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"n falan tima nɛn n niin ɲaxankatani.","poem":1},{"lineBreak":true},{"text":"N nan n mawugama nɛn n niin xɔlɛni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nanfera i kantan muxun dɔxi n xili ma?","poem":1},{"lineBreak":true},{"text":"N tan magaxu ba, alo fufana,","poem":1},{"lineBreak":true},{"text":"hanma ige yi sube xaɲɛna nde?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N na a falama, n naxa,","poem":1},{"lineBreak":true},{"text":"‘N sadena n masabarima nɛn,","poem":1},{"lineBreak":true},{"text":"n xiden yi n mali n ma mawugani suxɛ.’","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nayi, i n magaxuma xiyene yi,","poem":1},{"lineBreak":true},{"text":"i n xibaruma kuisan feene nan ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A yi rafanɲɛ n ma nun, n faxa.","poem":1},{"lineBreak":true},{"text":"Sayaan fisa n xa","poem":1},{"lineBreak":true},{"text":"benun n xa lu doyenɲɛ tun.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N ma siimayaan bata raɲaxu n ma,","poem":1},{"lineBreak":true},{"text":"n mi waxi a xɔn n xa lu n nii ra habadan.","poem":1},{"lineBreak":true},{"text":"Nayi, xɛtɛ n fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n ma siimayaan mi xunkuya.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Nanse adamadiin na","poem":1},{"lineBreak":true},{"text":"alogo i xa feni itoe birin liga a ra,","poem":1},{"lineBreak":true},{"text":"han i yi i yengi dɔxɔ a xɔn ma iki,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"han i yi lu fɛ a xɔn xɔtɔn yo xɔtɔn,","poem":1},{"lineBreak":true},{"text":"i yi lu a fɛsɛfɛsɛ waxatin birin?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I xun xanbi soma n yi","poem":1},{"lineBreak":true},{"text":"waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"I a luma waxatin mundun yi","poem":1},{"lineBreak":true},{"text":"n yi n dɛgen nagerun?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hali n bata yulubin liga,","poem":1},{"lineBreak":true},{"text":"n nɔɛ nanse ligɛ i ra,","poem":1},{"lineBreak":true},{"text":"i tan naxan adamadiine rakɔrɔsima?","poem":1},{"lineBreak":true},{"text":"Nanfera i n yatɛxi se kala daxin na?","poem":1},{"lineBreak":true},{"text":"N goronna i tan xun ma di?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nanfera i mi n ma matandine mafeluyɛ,","poem":1},{"lineBreak":true},{"text":"i n hakɛne ba n ma?","poem":1},{"lineBreak":true},{"text":"Iki, n na n sama nɛn burunburunni,","poem":1},{"lineBreak":true},{"text":"i n fenma nɛn, n mi fa na.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}