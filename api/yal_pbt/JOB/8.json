{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOB","translationId":"yal_pbt","name":"Yuba Sora","commonName":"Yuba Sora","title":"Yuba Nabi Yubaa Fe Taruxuna","order":18,"numberOfChapters":42,"sha256":"851f5e29302860f08568e0821d45130e962e03aa4cf81154aebcf8f9ee87d029","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yal_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Bilidadaa fala singena Yuba xa"]},{"type":"verse","number":1,"content":["Suxa kaan Bilidada yi falan tongo, a naxa,"]},{"type":"verse","number":2,"content":[{"text":"“Han waxatin mundun yi,","poem":1},{"lineBreak":true},{"text":"i luyɛ i fala xuini?","poem":1},{"lineBreak":true},{"text":"Han waxatin mundun yi,","poem":1},{"lineBreak":true},{"text":"i fala xuine findɛ foye ɲaxin na?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alaa sariyan kalɛ ba?","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna tinxinna kalɛ ba?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I ya diine yulubin liga nɛn a ra,","poem":1},{"lineBreak":true},{"text":"Ala yi e saran e murutɛ feene ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Koni, xa i tan Ala fen,","poem":1},{"lineBreak":true},{"text":"xa i Ala Sɛnbɛ Kanna maxandi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"xa i sariɲan, xa i fanɲɛ ayi,","poem":1},{"lineBreak":true},{"text":"a i malima nɛn,","poem":1},{"lineBreak":true},{"text":"a i raxɛtɛ i funfuni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I kii fonna mi yi sese ra,","poem":1},{"lineBreak":true},{"text":"i kii nɛnɛn findima nɛn binye gbeen na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nayi, mayixɛtɛ danguxine maxɔdin,","poem":1},{"lineBreak":true},{"text":"i xaxili dɔxɔ e benbane xaxilimayaan xɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amasɔtɔ, en barixi xoroni,","poem":1},{"lineBreak":true},{"text":"en mi sese kolon,","poem":1},{"lineBreak":true},{"text":"en ma siimayaan luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo nininna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni, e i xaranma,","poem":1},{"lineBreak":true},{"text":"e falan tima i xa e xaxilimayani.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Gbalan solɛ daraan xanbi ba?","poem":1},{"lineBreak":true},{"text":"Gbalan sabatɛ igen xanbi ba?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hali a xindena,","poem":1},{"lineBreak":true},{"text":"a mi sɛgɛxi,","poem":1},{"lineBreak":true},{"text":"a xarɛ sinma sɛxɛn bonne yɛɛ ra","poem":1},{"lineBreak":true},{"text":"xa a mi igeni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na nan ligama muxune birin na","poem":1},{"lineBreak":true},{"text":"naxanye ɲinanma Ala xɔn.","poem":1},{"lineBreak":true},{"text":"Naxanye mi Ala kolon,","poem":1},{"lineBreak":true},{"text":"ne yigin ɲanma nɛn,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"e yigin kalama nɛn","poem":1},{"lineBreak":true},{"text":"alo simisamana yalana.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A yigi sama a banxin nin,","poem":1},{"lineBreak":true},{"text":"koni a mi sensen,","poem":1},{"lineBreak":true},{"text":"a kankanxi a yiiseene ma,","poem":1},{"lineBreak":true},{"text":"koni e mi luma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo wudi xinden sogen na,","poem":1},{"lineBreak":true},{"text":"naxan a yiine yibandunma nakɔɔn xun ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A salenne godoxi","poem":1},{"lineBreak":true},{"text":"han e sa so gɛmɛni,","poem":1},{"lineBreak":true},{"text":"a sa gɛmɛn kuiin li.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koni, xa a ba a tideni,","poem":1},{"lineBreak":true},{"text":"mɛnna bɔxɔna a mɛma a ra nɛn,","poem":1},{"lineBreak":true},{"text":"a naxa, ‘N tan munma i tan to.’","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E sɛwan ɲanma na kii nin","poem":1},{"lineBreak":true},{"text":"naxanye ɲinanma Ala xɔn,","poem":1},{"lineBreak":true},{"text":"gbɛtɛye fan yi mini e funfuni.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A mato,","poem":1},{"lineBreak":true},{"text":"Ala mi sɔntaren nawolima ayi,","poem":1},{"lineBreak":true},{"text":"a mi fe ɲaxi rabane sɛnbɛ soma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ala i ragelema nɛn,","poem":1},{"lineBreak":true},{"text":"a yi sɛwan sa i yi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"I yaxune yagima nɛn,","poem":1},{"lineBreak":true},{"text":"ɲaxudene yi ɲan.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}