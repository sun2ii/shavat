{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOL","translationId":"yal_pbt","name":"Nabi Yowɛli Sora","commonName":"Nabi Yowɛli Sora","title":"Yowɛli Nabi Yowɛli Alaa Falan Naxan Sɛbɛ","order":29,"numberOfChapters":4,"sha256":"432e8b0531db3d619c83051a0a899f4f3cc998e81ecdedbf44893d1d3802cce2","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/yal_pbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Alatala falan naxan ti Yowɛli xa, Petuweli a dii xɛmɛna."]},{"type":"heading","content":["Tuguminne gbalon yamanani"]},{"type":"verse","number":2,"content":[{"text":"Ɛ tan fonne, ɛ feni ito ramɛ,","poem":1},{"lineBreak":true},{"text":"ɛ tan yamanan muxune,","poem":1},{"lineBreak":true},{"text":"ɛ birin xa ɛ tuli mati.","poem":1},{"lineBreak":true},{"text":"Fe sifani ito ɲɔxɔnna bata yi liga ɛ waxatini ba,","poem":1},{"lineBreak":true},{"text":"hanma ɛ benbane waxatini?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ a yɛba ɛ diine xa,","poem":1},{"lineBreak":true},{"text":"ɛ diine yi a yɛba e diine xa,","poem":1},{"lineBreak":true},{"text":"e diine yi a yɛba mayixɛtɛ famatɔne xa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Suɲɛne donseen naxanye luxi,","poem":1},{"lineBreak":true},{"text":"tuguminne bata ne don.","poem":1},{"lineBreak":true},{"text":"Tuguminne naxan luxi,","poem":1},{"lineBreak":true},{"text":"xoxorone bata na don.","poem":1},{"lineBreak":true},{"text":"Xoxorone naxan luxi,","poem":1},{"lineBreak":true},{"text":"songolonbalane bata na don.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɛ xulun, dɔlɔ minne,","poem":1},{"lineBreak":true},{"text":"ɛ wuga!","poem":1},{"lineBreak":true},{"text":"Ɛ birin xa gbelegbele,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye dɔlɔn minma,","poem":1},{"lineBreak":true},{"text":"bayo manpa bogine bata kala,","poem":1},{"lineBreak":true},{"text":"e ba ɛ dɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ganla nde bata fa fu n ma yamanan ma,","poem":1},{"lineBreak":true},{"text":"e fangan gbo,","poem":1},{"lineBreak":true},{"text":"e wuya han e mi yatɛ.","poem":1},{"lineBreak":true},{"text":"E ɲinne luxi alo yatan ɲinne,","poem":1},{"lineBreak":true},{"text":"e gbɛgbɛne luxi","poem":1},{"lineBreak":true},{"text":"alo yata gilɛn gbeene.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E n ma manpa binle kalama.","poem":1},{"lineBreak":true},{"text":"E n ma xɔdɛ binle ɲan fefe,","poem":1},{"lineBreak":true},{"text":"e yi e yixin,","poem":1},{"lineBreak":true},{"text":"e yi e kobelene ba e ma,","poem":1},{"lineBreak":true},{"text":"e yiine yi gbendu fefe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɛ mawuga","poem":1},{"lineBreak":true},{"text":"alo sungutunna kasa dugini ɲandeni","poem":1},{"lineBreak":true},{"text":"naxan a xɛmɛn wugama,","poem":1},{"lineBreak":true},{"text":"a baxi dɔxɔdeni naxan xɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bogise saraxan nun minse saraxan bata ɲan Alatalaa banxini.","poem":1},{"lineBreak":true},{"text":"Saraxaraline sunuxi, Alatalaa walikɛne.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xɛɛne bata kala,","poem":1},{"lineBreak":true},{"text":"bɔxɔn bata xara.","poem":1},{"lineBreak":true},{"text":"Bogiseene bata raxɔri.","poem":1},{"lineBreak":true},{"text":"Manpa bogi igen bata so a ra.","poem":1},{"lineBreak":true},{"text":"Turen bata ɲan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xɛɛ biine bata yigitɛgɛ.","poem":1},{"lineBreak":true},{"text":"Manpa bili nakɔ sane gbelegbelema sununi,","poem":1},{"lineBreak":true},{"text":"murutun nun fundenna fe ra,","poem":1},{"lineBreak":true},{"text":"bayo se xaba daxine bata halagi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manpa binle bata xara ayi.","poem":1},{"lineBreak":true},{"text":"Xɔdɛ binle bata lisi a ra","poem":1},{"lineBreak":true},{"text":"e nun Girenada wudine nun tugu binle nun pɔnmi binle.","poem":1},{"lineBreak":true},{"text":"Xɛɛ ma wudine birin bata xara.","poem":1},{"lineBreak":true},{"text":"Muxune sɛwan birin bata ɲan.","poem":1}]},{"type":"heading","content":["Yamaan xa tubi Alaa lɔxɔna fe ra"]},{"type":"verse","number":13,"content":[{"text":"Ɛ sunu dugine tongo,","poem":1},{"lineBreak":true},{"text":"ɛ wuga, ɛ tan saraxaraline.","poem":1},{"lineBreak":true},{"text":"Ɛ gbelegbele,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye walima saraxa ganden yɛtagi.","poem":1},{"lineBreak":true},{"text":"N ma Alaa walikɛne, ɛ fa,","poem":1},{"lineBreak":true},{"text":"ɛ xi maxidixi kasa bɛnbɛli dugine yi nimisani,","poem":1},{"lineBreak":true},{"text":"bayo bogise saraxane nun minse saraxane bata ɲan ɛ Alaa banxini.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɛ sun suxu waxatin nagidi,","poem":1},{"lineBreak":true},{"text":"ɛ yamaan maxili malan sariɲanxini,","poem":1},{"lineBreak":true},{"text":"ɛ fonne malan","poem":1},{"lineBreak":true},{"text":"e nun yamanan muxune birin,","poem":1},{"lineBreak":true},{"text":"e xa fa Alatalaa banxini, ɛ Ala,","poem":1},{"lineBreak":true},{"text":"ɛ yi ɛ xuini te Alatala ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lɔxɔ xɔdɛxɛn bata a li de!","poem":1},{"lineBreak":true},{"text":"Alatalaa lɔxɔn bata maso,","poem":1},{"lineBreak":true},{"text":"a fama kalan nan na","poem":1},{"lineBreak":true},{"text":"fata Ala Sɛnbɛ Kanna ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Donseen bata ɲan en yɛɛ xɔri yati!","poem":1},{"lineBreak":true},{"text":"Sɛwan nun ɲaxanna bata ɲan en ma Alaa banxini!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sansi xɔnne bata xara ayi xutune bun,","poem":1},{"lineBreak":true},{"text":"sagane bata kui geli.","poem":1},{"lineBreak":true},{"text":"Se ramaradene bata kala,","poem":1},{"lineBreak":true},{"text":"bayo murutu mi fa na.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xuruseene wuga xuiin gbo iki!","poem":1},{"lineBreak":true},{"text":"Ɲinge kurune xuyaxi ayi na xun xɔn ma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ sɛxɛ mi fa na,","poem":1},{"lineBreak":true},{"text":"hali yɛxɛɛne fan tɔrɔxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Alatala, n nan n xuini te i tan nan ma!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ tɛɛn bata burunna halagi,","poem":1},{"lineBreak":true},{"text":"tɛɛ dɛgɛn bata xɛɛ ma wudine birin gan.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Na ma, hali burunna subene e wuga xuini tema i tan Ala ma.","poem":1},{"lineBreak":true},{"text":"Xudene bata xɔri,","poem":1},{"lineBreak":true},{"text":"tɛɛn bata burunna halagi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}