{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOL","translationId":"yal_pbt","name":"Nabi Yowɛli Sora","commonName":"Nabi Yowɛli Sora","title":"Yowɛli Nabi Yowɛli Alaa Falan Naxan Sɛbɛ","order":29,"numberOfChapters":4,"sha256":"432e8b0531db3d619c83051a0a899f4f3cc998e81ecdedbf44893d1d3802cce2","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/yal_pbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Alatalaa lɔxɔn bata maso"]},{"type":"verse","number":1,"content":[{"text":"Ɛ xɔtaan fe Siyon yi!","poem":1},{"lineBreak":true},{"text":"Ɛ gbelegbele n ma geya sariɲanxin fari!","poem":1},{"lineBreak":true},{"text":"Yamanan muxune birin xa xuruxurun gaxuni","poem":1},{"lineBreak":true},{"text":"bayo Alatalaa lɔxɔn fama,","poem":1},{"lineBreak":true},{"text":"a bata maso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dimin nun nii rafɔrɛn lɔxɔna,","poem":1},{"lineBreak":true},{"text":"kundaan nun kuye yifɔrɔn lɔxɔna.","poem":1},{"lineBreak":true},{"text":"Ganla","poem":1},{"noteId":0},{"text":"fama","poem":1},{"lineBreak":true},{"text":"alo kuye yi yalanna geyaan kanke ra subaxani.","poem":1},{"lineBreak":true},{"text":"Gali gbee sɛnbɛmaan fama,","poem":1},{"lineBreak":true},{"text":"naxan ɲɔxɔn munma to,","poem":1},{"lineBreak":true},{"text":"naxan ɲɔxɔn mi fa toma waxati famatɔne birin yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tɛɛ dɛgɛna e yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"a e xanbi ra.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn tofan e yɛɛ ra","poem":1},{"lineBreak":true},{"text":"alo Eden nakɔna.","poem":1},{"noteId":1},{"lineBreak":true},{"text":"Tonbonna nan a ra e xanbi ra.","poem":1},{"lineBreak":true},{"text":"Sese mi a futuxuluma e yii.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E maliga soo yama gbeen nan na,","poem":1},{"lineBreak":true},{"text":"alo soo ragine ganla,","poem":1},{"lineBreak":true},{"text":"naxanye xulun e gideni han!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E dangu xuiin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo yɛngɛ so wontorone.","poem":1},{"lineBreak":true},{"text":"E tuganma geyane xun ma,","poem":1},{"lineBreak":true},{"text":"alo tɛɛ gbeen nɛma sɛxɛ xaren ganɲɛ","poem":1},{"lineBreak":true},{"text":"alo gali sɛnbɛmaan na ti yɛngɛ so xinla ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Siyane birin xuruxurunma e yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e yɛtagine yi tɔɲɔnxi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E fɔnma seene ma","poem":1},{"lineBreak":true},{"text":"alo yɛngɛ sone,","poem":1},{"lineBreak":true},{"text":"e tema taan nabilinna yinna ma","poem":1},{"lineBreak":true},{"text":"alo sofane.","poem":1},{"lineBreak":true},{"text":"E birin sigama e kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"e mi kiraan fatama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E sese mi dinma e bode ra,","poem":1},{"lineBreak":true},{"text":"birin sigama a tinxinni.","poem":1},{"lineBreak":true},{"text":"Sese na ti e yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e tuganma nɛn na xun ma,","poem":1},{"lineBreak":true},{"text":"e safane mi kalama.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E na bɔxɔn taan ma,","poem":1},{"lineBreak":true},{"text":"e e gi yinna ma,","poem":1},{"lineBreak":true},{"text":"e tema banxine ma,","poem":1},{"lineBreak":true},{"text":"e so banxin foye sodene ra","poem":1},{"lineBreak":true},{"text":"alo muɲadene.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bɔxɔn xuruxurunma e yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"kore xɔnna yi maxa.","poem":1},{"lineBreak":true},{"text":"Sogen nun kiken yi yidimi.","poem":1},{"lineBreak":true},{"text":"Sarene mi fa dɛgɛma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala sɔnxɔma a ganla yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"A yamaan mi nɔɛ yatɛ.","poem":1},{"lineBreak":true},{"text":"Naxanye a falan suxuma,","poem":1},{"lineBreak":true},{"text":"ne sɛnbɛn gbo!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ Alatalaa lɔxɔn gbo,","poem":1},{"lineBreak":true},{"text":"a magaxu!","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ tiyɛ a bun?","poem":1}]},{"type":"heading","content":["Yamaan xa tubi Ala ma"]},{"type":"verse","number":12,"content":[{"text":"Alatalaa falan ni ito ra, a naxa,","poem":1},{"lineBreak":true},{"text":"“Koni iki, ɛ mɔn xa xɛtɛ n ma ɛ bɔɲɛni feu,","poem":1},{"lineBreak":true},{"text":"sun suxun nun wugan nun gbelegbele xuine yi!”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Benun ɛ xa ɛ dugine yibɔ nimisani","poem":1},{"lineBreak":true},{"text":"ɛ bɔɲɛne nan xa kala.","poem":1},{"lineBreak":true},{"text":"Ɛ xɛtɛ Alatala ma, ɛ Ala","poem":1},{"lineBreak":true},{"text":"bayo a diɲa, a kininkinin,","poem":1},{"lineBreak":true},{"text":"a mi xɔlɔn xulɛn,","poem":1},{"lineBreak":true},{"text":"a hinanna gbo.","poem":1},{"lineBreak":true},{"text":"A a yɛtɛ ratangaxi yihadin ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nde a kolon xa a mi maxɛtɛma","poem":1},{"lineBreak":true},{"text":"a kininkinin ɛ ma,","poem":1},{"lineBreak":true},{"text":"a yi baraka sa ɛ feene yi,","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa nɔ bogise saraxane","poem":1},{"lineBreak":true},{"text":"nun minse saraxane bɛ Alatala xa, ɛ Ala?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ɛ xɔtaan fe Siyon yi!","poem":1},{"lineBreak":true},{"text":"Ɛ sun suxu waxatin nagidi.","poem":1},{"lineBreak":true},{"text":"Ɛ yamaan maxili malan sariɲanxini.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɛ yamaan malan, ɛ malanna rasariɲan.","poem":1},{"lineBreak":true},{"text":"Ɛ fonne malan,","poem":1},{"lineBreak":true},{"text":"ɛ dii ɲɔrɛne malan","poem":1},{"lineBreak":true},{"text":"hali naxanye xiɲɛn minma.","poem":1},{"lineBreak":true},{"text":"Hali xɛmɛn naxan baxi ɲaxanla dɔxɔdeni,","poem":1},{"lineBreak":true},{"text":"na fan xa mini a banxini,","poem":1},{"lineBreak":true},{"text":"a ɲaxanla fan xa fa malanni.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Saraxaraliin naxanye walima Alatala xa","poem":1},{"lineBreak":true},{"text":"ne xa wuga Ala Batu Banxin","poem":1},{"lineBreak":true},{"text":"so dɛɛn nun saraxa ganden tagini.","poem":1},{"lineBreak":true},{"text":"E yi Ala mafan, e naxa,","poem":1},{"lineBreak":true},{"text":"“Alatala, kininkinin nxu ma,","poem":1},{"lineBreak":true},{"text":"nxu tan i ya yamana.","poem":1},{"lineBreak":true},{"text":"I nama i ya muxune rayagi,","poem":1},{"lineBreak":true},{"text":"i nama tin yama xɔɲɛne yi nxu magele,","poem":1},{"lineBreak":true},{"text":"e a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"‘E Ala minɛn yi?’ ”","poem":1}]},{"type":"heading","content":["Alatala yi a yamaan yabi"]},{"type":"verse","number":18,"content":[{"text":"Nayi, Alatalaa xɔxɔlɔnna kelima nɛn","poem":1},{"lineBreak":true},{"text":"a yamanana fe ra,","poem":1},{"lineBreak":true},{"text":"a yamaan kininkininna yi a suxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Alatala a yamaan yabima nɛn nayi, a naxa,","poem":1},{"lineBreak":true},{"text":"“N mɔn bogiseene ragidima ɛ ma nɛn,","poem":1},{"lineBreak":true},{"text":"e nun manpa bogine nun ture faɲina.","poem":1},{"lineBreak":true},{"text":"Ɛ lugoma nɛn ken!","poem":1},{"lineBreak":true},{"text":"N mi fa ɛ findima magele seen na siyane tagi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yaxun naxan kelima sogeteden kɔmɛnna ma,","poem":1},{"lineBreak":true},{"text":"n na a masigama nɛn ɛ ra pon!","poem":1},{"lineBreak":true},{"text":"N na a kedima nɛn","poem":1},{"lineBreak":true},{"text":"siga bɔxɔ xare madunduxin mabinni.","poem":1},{"lineBreak":true},{"text":"N na a ganla yɛɛ ra xiin naxuyama ayi nɛn","poem":1},{"lineBreak":true},{"text":"siga han sogeteden baana,","poem":1},{"lineBreak":true},{"text":"e nun a xanbi ra xiina","poem":1},{"lineBreak":true},{"text":"siga han sogegododen fɔxɔ igena.","poem":1},{"lineBreak":true},{"text":"E faxaxine xiri ɲaxin minima nɛn,","poem":1},{"lineBreak":true},{"text":"a findi furen na foyeni.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ Ala wali gbeen kɛma nɛn.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I tan, bɔxɔna,","poem":1},{"lineBreak":true},{"text":"i nama gaxu!","poem":1},{"lineBreak":true},{"text":"I ya sɛwan xa gbo ayi,","poem":1},{"lineBreak":true},{"text":"i ɲaxan!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ Alatala bata fe gbeene rakamali.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɛ tan, subene,","poem":1},{"lineBreak":true},{"text":"ɛ nama gaxu!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ burunna sɛxɛne mɔn ɲingima nɛn,","poem":1},{"lineBreak":true},{"text":"wudine mɔn yi bogi.","poem":1},{"lineBreak":true},{"text":"Xɔdɛ binle nun manpa binle mɔn yi dahamun namini.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɛ tan, Siyon kaane, ɛ ɲaxan,","poem":1},{"lineBreak":true},{"text":"ɛ sɛwa Alatala yi, ɛ Ala,","poem":1},{"lineBreak":true},{"text":"bayo a mɔn tulen fima ɛ ma a waxatini a tinxinni,","poem":1},{"lineBreak":true},{"text":"a tule gbeen nafa ɛ ma","poem":1},{"lineBreak":true},{"text":"a darixi fɛ waxatin naxanye birin yi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lonne rafema nɛn,","poem":1},{"lineBreak":true},{"text":"kundine yi rafe manpa nɛnɛn nun turen na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“N ɲɛɛ danguxine seene ɲɔxɔne raxɛtɛma nɛn ɛ ma","poem":1},{"lineBreak":true},{"text":"tuguminne nun xoxorone naxanye donxi,","poem":1},{"lineBreak":true},{"text":"e nun songolonbalane nun suɲɛne,","poem":1},{"lineBreak":true},{"text":"n ma gali gbeena,","poem":1},{"lineBreak":true},{"text":"n naxan nasiga ɛ xili ma.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ɛ dɛgema nɛn han ɛ lugo.","poem":1},{"lineBreak":true},{"text":"Ɛ Alatala xinla tantunma nɛn, ɛ Ala,","poem":1},{"lineBreak":true},{"text":"naxan bata kabanako feene liga ɛ xa.","poem":1},{"lineBreak":true},{"text":"N ma yamaan mi fa yagima mumɛ!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ɛ a kolonma nɛn nayi","poem":1},{"lineBreak":true},{"text":"a n luxi Isirayila kaane yɛ.","poem":1},{"lineBreak":true},{"text":"Alatala nan n tan na, ɛ Ala.","poem":1},{"lineBreak":true},{"text":"Ala gbɛtɛ mi na mumɛ.","poem":1},{"lineBreak":true},{"text":"N ma yamaan mi fa yagima mumɛ!”","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.2Yanyina nde ganliito findixi tuguminne nan na naxanye halagin naso yamanani Alaa xɔlɔn bun ma.","reference":{"chapter":2,"verse":2}},{"noteId":1,"caller":"+","text":"2.3Eden nakɔnafe sɛbɛxi Dunuɲa Fɔlɔn 2.8-9 kui. E nun Esekiyɛli 36.35.","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/yal_pbt/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":27}