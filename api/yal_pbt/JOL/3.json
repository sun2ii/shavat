{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"JOL","translationId":"yal_pbt","name":"Nabi Yowɛli Sora","commonName":"Nabi Yowɛli Sora","title":"Yowɛli Nabi Yowɛli Alaa Falan Naxan Sɛbɛ","order":29,"numberOfChapters":4,"sha256":"432e8b0531db3d619c83051a0a899f4f3cc998e81ecdedbf44893d1d3802cce2","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/yal_pbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Alaa lɔxɔna fe"]},{"type":"verse","number":1,"content":[{"text":"“Na xanbi ra,","poem":1},{"lineBreak":true},{"text":"n na n ma Nii Sariɲanxin nagodoma nɛn","poem":1},{"lineBreak":true},{"text":"adamadiin birin ma.","poem":1},{"lineBreak":true},{"text":"Ɛ dii xɛmɛne nun ɛ dii tɛmɛne nabiya falane tima nɛn.","poem":1},{"lineBreak":true},{"text":"Ɛ xɛmɛ fonne yi xiye sa.","poem":1},{"lineBreak":true},{"text":"Ɛ banxulanne yi fe toon ti alo xiyena.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na lɔxɔne yi,","poem":1},{"lineBreak":true},{"text":"n na n ma Nii Sariɲanxin nagodoma nɛn","poem":1},{"lineBreak":true},{"text":"hali konyi xɛmɛne nun konyi gilɛne xun ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N kabanako feene yitama nɛn kore xɔnna ma","poem":1},{"lineBreak":true},{"text":"e nun bɔxɔ xɔnna ma,","poem":1},{"lineBreak":true},{"text":"wunla nun tɛɛn nun tɛɛ tuti gbeen minima nɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sogeni dimima nɛn,","poem":1},{"lineBreak":true},{"text":"kiken yi gbeeli alo wunla,","poem":1},{"lineBreak":true},{"text":"benun Alatalaa lɔxɔ binye gbeen xa a li.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nba, naxan yo na Alatala maxandi a xinla ra,","poem":1},{"lineBreak":true},{"text":"na kisima nɛn.","poem":1},{"lineBreak":true},{"text":"Nayi, yamaan muxu dɔnxɛna ndee luma nɛn e nii ra","poem":1},{"lineBreak":true},{"text":"Ala na naxanye xili,","poem":1},{"lineBreak":true},{"text":"ne nan xunbama Siyon geyaan fari","poem":1},{"lineBreak":true},{"text":"e nun Yerusalɛn yi","poem":1},{"lineBreak":true},{"text":"alo Alatala a fala kii naxan yi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}