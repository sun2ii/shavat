danguma n fari.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yi a falama nɛn, n naxa,","poem":1},{"lineBreak":true},{"text":"I bata n kedi i yɛtagi.","poem":1},{"lineBreak":true},{"text":"Koni, n mɔn i ya banxi sariɲanxin toma nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Igen bata te han n kɔɛna.","poem":1},{"lineBreak":true},{"text":"N bata lu tilinna ma.","poem":1},{"lineBreak":true},{"text":"Fɔxɔ igen sɛxɛne yi filin n xunna ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bata yi godo igeni","poem":1},{"lineBreak":true},{"text":"han geyane bun.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn bata yi raxutu n ma","poem":1},{"lineBreak":true},{"text":"han habadan.","poem":1},{"lineBreak":true},{"text":"Koni i tan Alatala, n ma Ala,","poem":1},{"lineBreak":true},{"text":"i bata n kɛndɛn ba faxan dɛ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“N niin ba waxatini,","poem":1},{"lineBreak":true},{"text":"n yi n miri i tan Alatala ma,","poem":1},{"lineBreak":true},{"text":"n ma maxandi xuiin yi sa i li i ya banxi sariɲanxini.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naxanye suxurene batuma fuyan","poem":1},{"lineBreak":true},{"text":"ne e makuyama hinanna nan na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N tan saraxane bama i xa nɛn,","poem":1},{"lineBreak":true},{"text":"n yi barikan bira i xa bɛtini.","poem":1},{"lineBreak":true},{"text":"N dɛ xuiin naxanye tongoxi,","poem":1},{"lineBreak":true},{"text":"n yi ne liga.","poem":1},{"lineBreak":true},{"text":"Alatala, i tan nan kisin kanna ra.”","poem":1}]},{"type":"verse","number":11,"content":["Alatala yi yɛxɛn yamari alogo a xa sa Yunusa baxun xaren na."]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.4Igen mɔrɔnne:alo foyen na so igeni.","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":