{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"LAM","translationId":"yal_pbt","name":"Mawuga Xuine Sora","commonName":"Mawuga Xuine Sora","title":"Mawuga Xuine Mawuga Falane Lan Yerusalɛn Kala Fe Ma","order":25,"numberOfChapters":5,"sha256":"2109056197b08b6fb42f6f8e050089c8554ce402b46afd321a7f9d16d2e93850","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/yal_pbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Isirayila kaane Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Alatala, feen naxan nxu sɔtɔxi,","poem":1},{"lineBreak":true},{"text":"i nama ɲinan na xɔn.","poem":1},{"lineBreak":true},{"text":"I yɛɛn ti,","poem":1},{"lineBreak":true},{"text":"i yi a to e nxu rayarabima kii naxan yi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nxɔ kɛɛ bɔxɔn bata findi xɔɲɛne gbeen na,","poem":1},{"lineBreak":true},{"text":"nxɔ banxine bata lu muxu gbɛtɛye xa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nxu fafane mi fa be,","poem":1},{"lineBreak":true},{"text":"nxu bata findi kiridine ra.","poem":1},{"lineBreak":true},{"text":"Nxu ngane bata lu alo kaɲa gilɛne.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nxu mi fa nɔɛ nxɔ igene minɲɛ","poem":1},{"lineBreak":true},{"text":"fɔ nxu a sara,","poem":1},{"lineBreak":true},{"text":"hali nxɔ yegene","poem":1},{"lineBreak":true},{"text":"fɔ nxu xa e sara nɛn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Muxun naxanye nxu tɔrɔma,","poem":1},{"lineBreak":true},{"text":"ne nxu kɔɛɛn suxi.","poem":1},{"lineBreak":true},{"text":"Nxu bata xadan,","poem":1},{"lineBreak":true},{"text":"matabu mi nxu xa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nxu nxu yiin tima Misiran yamanan nun Asiriya yamanan xa","poem":1},{"lineBreak":true},{"text":"alogo nxu xa donseene sɔtɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nxu fafane bata yulubin liga,","poem":1},{"lineBreak":true},{"text":"e mi fa be.","poem":1},{"lineBreak":true},{"text":"Nxu tan nan fa e hakɛn goronna tongoma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Konyine bata findi nxu kanne ra,","poem":1},{"lineBreak":true},{"text":"muxu yo mi na naxan nxu bɛ e yii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nxu sayaan nan dɛ,","poem":1},{"lineBreak":true},{"text":"nxu na mini donse fendeni","poem":1},{"lineBreak":true},{"text":"bayo mafu tiine burunna ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kamɛn bata nxu suxu","poem":1},{"lineBreak":true},{"text":"han nxu fatin yi gan","poem":1},{"lineBreak":true},{"text":"alo nxu nɛma wonson tɛɛni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nxu yaxune bata fu ɲaxanle","poem":1},{"lineBreak":true},{"text":"nun sungutunne ma Siyon taan nun Yuda taane yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E yɛtɛɛn bata kuntigine singan,","poem":1},{"lineBreak":true},{"text":"e mi binye yo sama fonne ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Diidine walima se dindeni.","poem":1},{"lineBreak":true},{"text":"Banxulanne yegene maxalima han e tagan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fonne mi fa e malanma taan so dɛɛn na,","poem":1},{"lineBreak":true},{"text":"diidine fan mi fa sigi sama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sɛwan bata ɲan nxu bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"nxɔ sumunne bata findi sunun na.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xunna kenla bata ba nxu yii.","poem":1},{"lineBreak":true},{"text":"Gbalona nxu xa,","poem":1},{"lineBreak":true},{"text":"bayo nxu bata yulubin liga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nanara, nxu bɔɲɛn tɔrɔxi,","poem":1},{"lineBreak":true},{"text":"nxu mi fa fefe yigbɛma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Siyon geyaan bata findi yire rabeɲinxin na","poem":1},{"lineBreak":true},{"text":"e nun kankone kurudena.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Koni, Alatala,","poem":1},{"lineBreak":true},{"text":"mangan nan i tan na habadan,","poem":1},{"lineBreak":true},{"text":"i ya mangayaan sɛnbɛn luma nɛn","poem":1},{"lineBreak":true},{"text":"han mayixɛtɛ nun mayixɛtɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nanfera i ɲinanɲɛ nxu xɔn han habadan?","poem":1},{"lineBreak":true},{"text":"I nxu rabeɲinɲɛ nxu siin birin yi ba?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatala, nxu raxɛtɛ i ma,","poem":1},{"lineBreak":true},{"text":"nxu fan yi xɛtɛ i ma yati!","poem":1},{"lineBreak":true},{"text":"Nxu yi kii naxan yi a fɔlɔni,","poem":1},{"lineBreak":true},{"text":"i mɔn xa nxɔ fe yitɔn na kiini.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"I bata i mɛ nxu ra ba fefe?","poem":1},{"lineBreak":true},{"text":"I xɔlɔxi nxu ma han a dangu ayi ba?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}