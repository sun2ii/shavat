{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"NAM","translationId":"yal_pbt","name":"Nabi Nahun Sora","commonName":"Nabi Nahun Sora","title":"Nahun Nabi Nahun Alaa Falan Naxan Sɛbɛ","order":34,"numberOfChapters":3,"sha256":"c46ecca1f50d95f3687c12e753663f1fecc87e9d708e6a227a056c00773fbf5e","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/yal_pbt/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ɛ mi a to,","poem":1},{"lineBreak":true},{"text":"xɛraan sigan tima geyane fari,","poem":1},{"lineBreak":true},{"text":"naxan fama xibaru faɲin na","poem":1},{"lineBreak":true},{"text":"naxan bɔɲɛ xunbenla a fe ralima.","poem":1},{"lineBreak":true},{"text":"Yuda kaane, ɛ sanle raba,","poem":1},{"lineBreak":true},{"text":"ɛ dɛ ti xuine rakamali.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ halagi tiin mi fa danguma ɛ konni.","poem":1},{"lineBreak":true},{"text":"A bata raxɔri fefe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Niniwa kaane,","poem":1},{"lineBreak":true},{"text":"halagi tiine bata keli ɛ xili ma.","poem":1},{"lineBreak":true},{"text":"Ɛ yinna makantan,","poem":1},{"lineBreak":true},{"text":"ɛ yɛɛn ti kirane ra,","poem":1},{"lineBreak":true},{"text":"ɛ tagi xidi yɛngɛ so xinla ma,","poem":1},{"lineBreak":true},{"text":"ɛ fangan birin malan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amasɔtɔ Alatala mɔn binyen soma nɛn","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔnne yii e nun Isirayila bɔxɔna,","poem":1},{"lineBreak":true},{"text":"hali halagi tiine to bata yi so na kaladeni","poem":1},{"lineBreak":true},{"text":"e yi e manpa binle ɲan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yaxu sofani itoe yɛ masansan wure lefane gbeeli.","poem":1},{"lineBreak":true},{"text":"E sofa wɛkilɛxine maxidixi dugi gbeele nin.","poem":1},{"lineBreak":true},{"text":"Wurene mayilenma e wontorone ma,","poem":1},{"lineBreak":true},{"text":"e na e yitɔn yɛngɛso lɔxɔn xili yi,","poem":1},{"lineBreak":true},{"text":"e yi tanbane tongo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yɛngɛ so wontorone e gima taan kirane xɔn han!","poem":1},{"lineBreak":true},{"text":"E gixin sigama yama malandene yi.","poem":1},{"lineBreak":true},{"text":"E mayilenma alo xaye xidi dɛgɛne,","poem":1},{"lineBreak":true},{"text":"e xulun alo kuye sarinna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"A bata a sofa yɛbaxine maxili,","poem":1},{"lineBreak":true},{"text":"koni e fama dagalanɲɛ ayi.","poem":1},{"lineBreak":true},{"text":"E e gima siga taan nabilinna yinna ma,","poem":1},{"lineBreak":true},{"text":"e luxun e yɛ masansan wurene bun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Taan so dɛɛne bata rabi baan mabinni,","poem":1},{"lineBreak":true},{"text":"manga banxin fan birama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Feen bata ragidi,","poem":1},{"lineBreak":true},{"text":"e bata taan muxune suxu,","poem":1},{"lineBreak":true},{"text":"e siga e ra konyiyani.","poem":1},{"lineBreak":true},{"text":"Taan konyi gilɛne yi lu kutunɲɛ","poem":1},{"lineBreak":true},{"text":"alo ganbane,","poem":1},{"lineBreak":true},{"text":"e siga e kanken makudunɲɛ sununi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niniwa taan luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo ige sa sena","poem":1},{"lineBreak":true},{"text":"igen minima naxan na.","poem":1},{"lineBreak":true},{"text":"E a falama a muxu gixine xa,","poem":1},{"lineBreak":true},{"text":"e naxa, “Ɛ ti! Ɛ ti!”","poem":1},{"lineBreak":true},{"text":"Koni muxu yo mi xɛtɛma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛ gbetin tongo!","poem":1},{"lineBreak":true},{"text":"Ɛ xɛmaan tongo!","poem":1},{"lineBreak":true},{"text":"Nafunla na naxan mi ɲanma.","poem":1},{"lineBreak":true},{"text":"A sifan birin malanxi na yi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kalan nun halagin nun bɔnɔna!","poem":1},{"lineBreak":true},{"text":"Bɔɲɛne bata kala,","poem":1},{"lineBreak":true},{"text":"xinbine yi sin.","poem":1},{"lineBreak":true},{"text":"Fatine birin yi xuruxurun,","poem":1},{"lineBreak":true},{"text":"yɛtagine birin yi yitɔɲɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yatane sodeni ito luxi di,","poem":1},{"lineBreak":true},{"text":"dɛnaxan yi findixi yatadine dɛgeden na,","poem":1},{"lineBreak":true},{"text":"yatane nun e diine yi e gima dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"muxu yo mi e yikala?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yatan yi subene faxama a diine xa,","poem":1},{"lineBreak":true},{"text":"a yi a se suxine kɔɛɛn bolon a gilɛɛn xa,","poem":1},{"lineBreak":true},{"text":"a luxunden nafe xɔɔyi seene ra","poem":1},{"lineBreak":true},{"text":"a soden nafe se suxine ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna falan ni ito ra,","poem":1},{"lineBreak":true},{"text":"a naxa, “N bata keli ɛ xili ma!","poem":1},{"lineBreak":true},{"text":"N na ɛ yɛngɛ so wontorone ganma nɛn","poem":1},{"lineBreak":true},{"text":"e findi tutin na.","poem":1},{"lineBreak":true},{"text":"Ɛ banxulanne faxama nɛn silanfanna ra","poem":1},{"noteId":1},{"lineBreak":true},{"text":"alo yata sɛnbɛmane.","poem":1},{"lineBreak":true},{"text":"N danna sa ɛ se tongon na yɛngɛne yi dunuɲa yi.","poem":1},{"lineBreak":true},{"text":"Muxu yo mi fa ɛ xɛrane xuiin mɛma sɔnɔn.”","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"2.14Silanfanna:Sofane yɛngɛso dɛgɛmana.","reference":{"chapter":2,"verse":14}}]},"thisChapterLink":"/api/yal_pbt/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}