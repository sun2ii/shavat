{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"NUM","translationId":"yal_pbt","name":"Yatɛne Sora","commonName":"Yatɛne Sora","title":"Yatɛne Nabi Musa Alaa Falan Naxan Sɛbɛ","order":4,"numberOfChapters":36,"sha256":"7679489fc065a735dd72e25f58bc41492662878296cf9347ba0c0152dfda5e95","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/yal_pbt/NUM/36.json","totalNumberOfVerses":1289},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Balami yi a to fa fala a yi rafan Alatala ma a xa duba Isirayila xa. Nayi, a mi kɔɛraya feene rawali alo waxatin danguxine yi. Koni a yi a yɛɛ rafindi tonbonna binni."]},{"type":"verse","number":2,"content":["Balami to a yɛɛne rakeli, a yi Isirayila kaane to malanxi bɔnsɔn yɛɛn ma. Nayi, Alaa Nii Sariɲanxin yi godo a ma."]},{"type":"verse","number":3,"content":["Balami yi waliyiya falane ti, a naxa,",{"text":"N tan Balami, Beyori a dii xɛmɛna,","poem":1},{"lineBreak":true},{"text":"n tan naxan feene fixɛn toma,","poem":1},{"lineBreak":true},{"text":"n ma falan ni i ra:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ni ito nan falama,","poem":1},{"lineBreak":true},{"text":"n tan naxan Alaa falane mɛma,","poem":1},{"lineBreak":true},{"text":"naxan fe toon tima alo xiyene","poem":1},{"lineBreak":true},{"text":"fata Ala Sɛnbɛ Kanna ra,","poem":1},{"lineBreak":true},{"text":"naxan a xinbi sinma,","poem":1},{"lineBreak":true},{"text":"a yɛɛne yi rabi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"ɛ tan Isirayila kaane!","poem":1},{"lineBreak":true},{"text":"Ɛ dɔxɔdene tofan!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E wuya bɔxɔn fari alo baane,","poem":1},{"lineBreak":true},{"text":"alo nakɔne baan dɛ,","poem":1},{"lineBreak":true},{"text":"alo Alatala sansi xiri faɲin naxanye sixi,","poem":1},{"lineBreak":true},{"text":"alo suman wudine igene dɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E ige ramaradene rafema nɛn ken!","poem":1},{"lineBreak":true},{"text":"E sansine ige sa a faɲin na!","poem":1},{"lineBreak":true},{"text":"E mangan gboma nɛn Manga Agaga xa,","poem":1},{"lineBreak":true},{"text":"a mangayaan sɛnbɛn gboma ayi nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala nan faxi e ra","poem":1},{"lineBreak":true},{"text":"sa keli Misiran yi,","poem":1},{"lineBreak":true},{"text":"a nɔɔn tima e xa","poem":1},{"lineBreak":true},{"text":"alo burunna ɲingena.","poem":1},{"lineBreak":true},{"text":"E siyane nɔma nɛn","poem":1},{"lineBreak":true},{"text":"naxanye e yɛngɛma,","poem":1},{"lineBreak":true},{"text":"e yi e bun e xalimakunle ra,","poem":1},{"lineBreak":true},{"text":"e yi e xɔnne yigira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E e sama nɛn alo yatane.","poem":1},{"lineBreak":true},{"text":"Nde susuɛ e rakelɛ?","poem":1},{"lineBreak":true},{"text":"Naxan na duba i xa,","poem":1},{"lineBreak":true},{"text":"Ala xa na kanna baraka!","poem":1},{"lineBreak":true},{"text":"Naxan na i danga,","poem":1},{"lineBreak":true},{"text":"Ala xa na kanna danga!","poem":1}]},{"type":"verse","number":10,"content":["Balaki yi xɔlɔ Balami ma han! A yi a yiine bɔnbɔ, a yi a fala Balami xa, a naxa, “N ni i xilixi nɛn alogo i xa n yaxune danga, koni i tan bata duba e xa sanɲa ma saxan."]},{"type":"verse","number":11,"content":["Iki keli be, siga i konni. N yi a ragidixi nɛn n xa i saren fi han, koni Alatala bata i kuma!”"]},{"type":"verse","number":12,"content":["Balami yi Balaki yabi, a naxa, “Anu, n na a fala nɛn i ya xɛrane xa, n naxa,"]},{"type":"verse","number":13,"content":["‘Hali Balaki a banxin so n yii naxan nafexi gbetin nun xɛmaan na, n mi nɔɛ Alatalaa yamarin matandɛ fefe ma. Alatala na naxan fala, fɔ n xa na nan fala.’"]},{"type":"verse","number":14,"content":["Awa iki, n bata siga n kon kaane fɛma. Koni ɛ tuli mati. N xa i rakolon siyani ito naxan ligama i ya yamaan na waxati famatɔni.”"]},{"type":"verse","number":15,"content":["Balami yi waliyiya falane ti, a naxa:",{"text":"N tan Balami, Beyori a dii xɛmɛna,","poem":1},{"lineBreak":true},{"text":"n tan naxan feene fixɛn toma,","poem":1},{"lineBreak":true},{"text":"n ma falan ni i ra:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N ni ito nan falama,","poem":1},{"lineBreak":true},{"text":"n tan naxan Alaa falane mɛma,","poem":1},{"lineBreak":true},{"text":"naxan Kore Xɔnna Ala wundo feene kolon,","poem":1},{"lineBreak":true},{"text":"naxan fe toon tima alo xiyena","poem":1},{"lineBreak":true},{"text":"fata Ala Sɛnbɛ Kanna ra,","poem":1},{"lineBreak":true},{"text":"naxan a xinbi sinma,","poem":1},{"lineBreak":true},{"text":"a yɛɛne yi rabi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N na a toma,","poem":1},{"lineBreak":true},{"text":"koni iki mi a ra.","poem":1},{"lineBreak":true},{"text":"N na a toma,","poem":1},{"lineBreak":true},{"text":"koni a mɔn makuya.","poem":1},{"lineBreak":true},{"text":"Sarena nde minima nɛn Yaxuba bɔnsɔnni,","poem":1},{"lineBreak":true},{"text":"mangan kelima nɛn Isirayila yamanani.","poem":1},{"lineBreak":true},{"text":"A Moyaba yamanan mangane yɛngɛma nɛn,","poem":1},{"lineBreak":true},{"text":"a Seti bɔnsɔnna nɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A Edɔn yamanan tongoma nɛn,","poem":1},{"lineBreak":true},{"text":"e nun Seyiri yamanana, a yaxuna.","poem":1},{"lineBreak":true},{"text":"Koni Isirayila sɛnbɛn gboma ayi nɛn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nɔ tiin minima nɛn Yaxuba bɔnsɔnni,","poem":1},{"lineBreak":true},{"text":"a yi e taane muxu dɔnxɛne raxɔri.","poem":1}]},{"type":"verse","number":20,"content":["Balami yi Amalɛkine to. A yi waliyiya falan ti, a naxa:",{"text":"Amalɛki nan yi yamana singen na dunuɲa yi,","poem":1},{"lineBreak":true},{"text":"koni dɔnxɛn na,","poem":1},{"lineBreak":true},{"text":"a tununma nɛn habadan!","poem":1}]},{"type":"verse","number":21,"content":["A mɔn yi Keni kaane to. A yi waliyiya falan ti, a naxa:",{"text":"I dɔxɔden natangaxi,","poem":1},{"lineBreak":true},{"text":"alo xɔliin naxan a tɛɛn saxi faranna ra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Koni Asuri na ɛ suxu konyiyani,","poem":1},{"lineBreak":true},{"text":"Kenine ɲanma nɛn.","poem":1}]},{"type":"verse","number":23,"content":["A mɔn yi waliyiya falan ti, a naxa:",{"text":"Ee! Ala na ito liga,","poem":1},{"lineBreak":true},{"text":"nde luyɛ a nii ra?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kunkine kelima nɛn Sipiri yi,","poem":1},{"lineBreak":true},{"text":"e yi Asuri rayarabi, e nun Eberi.","poem":1},{"lineBreak":true},{"text":"Koni e fan faxama nɛn.","poem":1}]},{"type":"verse","number":25,"content":["Balami yi keli, a xɛtɛ a konni. Balaki fan yi siga."]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}