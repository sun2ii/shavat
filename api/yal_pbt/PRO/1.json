{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["Sandane tɔnɔna"]},{"type":"verse","number":1,"content":["Dawuda dii xɛmɛn Sulemani a sandane, Isirayila Mangana."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sandani itoe sɛbɛxi nɛn","poem":1},{"lineBreak":true},{"text":"alogo muxune xa fe kolonna nun xurun sɔtɔ","poem":1},{"lineBreak":true},{"text":"e yi xaxilimaya falane famu","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"alogo e xa xuru, e xaxili sɔtɔ","poem":1},{"lineBreak":true},{"text":"e tinxinna nun kiti sa kɛndɛn nun fe faɲin liga,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"fe kolontarene yi e ɲɔxɔ lu,","poem":1},{"lineBreak":true},{"text":"foningene yi kolonna sɔtɔ,","poem":1},{"lineBreak":true},{"text":"e feene yɛ fen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe kolonne xa itoe ramɛ,","poem":1},{"lineBreak":true},{"text":"e yi e fe kolonna fari sa,","poem":1},{"lineBreak":true},{"text":"xaxilimane yi fatan muxune maxadɛ","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"alogo e xa sandane nun taline bunna kolon","poem":1},{"lineBreak":true},{"text":"e nun fe kolonne wundo falane","poem":1},{"lineBreak":true},{"text":"nun e maxɔdin tilinxine.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xaxilimayaan fɔlɔma Alatala yɛɛragaxun nan ma.","poem":1},{"lineBreak":true},{"text":"Fe kolonna nun xurun naɲaxu xaxilitarene nan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"i fafe nɛma i xuru falane tiyɛ,","poem":1},{"lineBreak":true},{"text":"i tuli mati a ra,","poem":1},{"lineBreak":true},{"text":"i nama i ngaa kawandi falane beɲin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo mangaya kɔmɔtina i xunna","poem":1},{"lineBreak":true},{"text":"alo ɲɛrɛna i kɔɛ i maxidi seen na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"xa yulubitɔne kata i mayendendeni,","poem":1},{"lineBreak":true},{"text":"i nama tin de!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xa e a fala i xa,","poem":1},{"lineBreak":true},{"text":"e naxa, “Fa nxu fɔxɔ ra!","poem":1},{"lineBreak":true},{"text":"En sa dɔxɔ muxuna nde yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"en yi a faxa.","poem":1},{"lineBreak":true},{"text":"En sa fu sɔntarena ndee ma,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"en yi e ɲɛɲɛne ralɔ ayi","poem":1},{"lineBreak":true},{"text":"alo gaburun muxun gerunma kii naxan yi,","poem":1},{"lineBreak":true},{"text":"e gbindin birin alo en tan nan yi sayaan na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"En se faɲi kɛndɛn sifan birin sɔtɔma nɛn","poem":1},{"lineBreak":true},{"text":"en yi en ma banxine rafe se tongoxine ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nxu na seene yitaxun,","poem":1},{"lineBreak":true},{"text":"i fan i gbeen sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"en ma gbetine birin yi malan","poem":1},{"lineBreak":true},{"text":"gbeti sase kedenna kui.”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"i nama bira ne fɔxɔ ra mumɛ!","poem":1},{"lineBreak":true},{"text":"I nama bira ne kiraan fɔxɔ ra de!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E gima siga fe ɲaxin nabadeni,","poem":1},{"lineBreak":true},{"text":"e mafura wunla raminɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Naxan na lutin nati xɔline yɛɛ ra","poem":1},{"lineBreak":true},{"text":"xɔline yɛɛn tixi a ra,","poem":1},{"lineBreak":true},{"text":"a na ligan nɛn fufafu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Muxu sifani ito lutin natima e yɛtɛ nan yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e yanfan soma e yɛtɛ nan ma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Awa, naxanye kunfama se muɲaxine xɔn,","poem":1},{"lineBreak":true},{"text":"ne niin luma na nin.","poem":1}]},{"type":"heading","content":["Xaxilimayaan falan tima"]},{"type":"verse","number":20,"content":[{"text":"Xaxilimayaan","poem":1},{"noteId":0},{"text":"falan tima kirane xɔn,","poem":1},{"lineBreak":true},{"text":"a xuini te yamaan malandeni,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"a sɔnxɔma kira xunne ma","poem":1},{"lineBreak":true},{"text":"yamaan gbo dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"a kawandin ba taan so dɛɛne ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"A naxa, “Ɛ tan fe kolontarene,","poem":1},{"lineBreak":true},{"text":"fe kolontareyaan nafanɲɛ ɛ ma","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"Ɛ tan magele tiine,","poem":1},{"lineBreak":true},{"text":"magelen nafanɲɛ ɛ ma","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi,","poem":1},{"lineBreak":true},{"text":"xaxilitarene yi kolonna raɲaxu?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N na ɛ sɔnna fala,","poem":1},{"lineBreak":true},{"text":"ɛ n xuiin namɛ.","poem":1},{"lineBreak":true},{"text":"Nayi, n nan n ma niin sa ɛ yii,","poem":1},{"lineBreak":true},{"text":"n yi n ma falane makɛnɛn ɛ xa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Koni bayo n bata ɛ xili,","poem":1},{"lineBreak":true},{"text":"ɛ tondixi n ma xinla ratinɲɛ,","poem":1},{"lineBreak":true},{"text":"n yi n yiini bandun ɛ xa,","poem":1},{"lineBreak":true},{"text":"ɛ mi a suxu,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ɛ yi ɛ mɛ n ma maxadi xuine birin na","poem":1},{"lineBreak":true},{"text":"n yi ɛ sɔnna fala ɛ xa,","poem":1},{"lineBreak":true},{"text":"ɛ mi na yatɛ,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"nayi, gbalon na ɛ sɔtɔ,","poem":1},{"lineBreak":true},{"text":"n fan gelema ɛ ma nɛn.","poem":1},{"lineBreak":true},{"text":"Fe magaxuxin na ɛ sɔtɔ,","poem":1},{"lineBreak":true},{"text":"n yi ɛ magele.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fe magaxuxin fama ɛ ma nɛn","poem":1},{"lineBreak":true},{"text":"alo tule gbeena,","poem":1},{"lineBreak":true},{"text":"gbalona ɛ sɔtɔma","poem":1},{"lineBreak":true},{"text":"alo foye gbeen na keli,","poem":1},{"lineBreak":true},{"text":"tɔrɔyaan nun nii yifɔrɛn yi ɛ yili.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Na waxatini,","poem":1},{"lineBreak":true},{"text":"ɛ n xilima nɛn ɛ malideni","poem":1},{"lineBreak":true},{"text":"koni n mi ɛ yabima,","poem":1},{"lineBreak":true},{"text":"ɛ yi n fen koni ɛ mi n toma.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Amasɔtɔ ɛ bata kolonna raɲaxu,","poem":1},{"lineBreak":true},{"text":"ɛ yi ɛ mɛ Alatala yɛɛragaxun na,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"bayo ɛ mi tin n ma maxadi xuine ramɛ,","poem":1},{"lineBreak":true},{"text":"n to ɛ sɔnna fala ɛ xa,","poem":1},{"lineBreak":true},{"text":"na yi raɲaxu ɛ ma.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ɛ sigati kiin saranna sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"ɛ wasa ɛ kɛwanle ra.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Amasɔtɔ fe kolontarene faxama nɛn e dina suxutareyani,","poem":1},{"lineBreak":true},{"text":"xaxilitarene yi halagi e bɔtɛ rabani.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Koni naxan na a tuli mati n na,","poem":1},{"lineBreak":true},{"text":"na ratangama nɛn a lu bɔɲɛ xunbenli","poem":1},{"lineBreak":true},{"text":"tɔrɔn mi a magaxuma.”","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.20xaxilimayana:Sandani ito kui, xaxilimayaan bata findi muxun na naxan adamadiine kawandima alogo e xa fe kolonna sɔtɔ.","reference":{"chapter":1,"verse":20}}]},"thisChapterLink":"/api/yal_pbt/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}