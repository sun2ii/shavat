{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Sikeela naxan muxun mayendenma","poem":1},{"lineBreak":true},{"text":"na findixi fe ɲaxin nan na Alatala yɛɛ ra yi.","poem":1},{"lineBreak":true},{"text":"Koni ligase sensenne a kɛnɛnxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wason fama maraɲaxun nan na.","poem":1},{"lineBreak":true},{"text":"Koni yɛtɛ magodon fama fe kolonna nan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Muxu faɲine fɛtareya wanle nan e tima kira faɲin xɔn.","poem":1},{"lineBreak":true},{"text":"Koni yanfantenne tinxintareyaan nan e halagima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sese mi nafunla ra Ala kiti sa lɔxɔni.","poem":1},{"lineBreak":true},{"text":"Koni tinxinna nan muxune xunbama sayaan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sɔntarene tinxinyaan nan e kiraan fixama.","poem":1},{"lineBreak":true},{"text":"Koni fe ɲaxin nan muxu ɲaxin nabirama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Muxu faɲine tinxinyaan nan e xunbama,","poem":1},{"lineBreak":true},{"text":"koni kunfa ɲaxine findima luti ratixin nan na yanfantenne yɛɛ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Muxu ɲaxin na faxa,","poem":1},{"lineBreak":true},{"text":"a yigin birin bata kala,","poem":1},{"lineBreak":true},{"text":"a xaxili tixi sɛnbɛn naxan na,","poem":1},{"lineBreak":true},{"text":"na bata lɔ ayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Muxu tinxinxin xunbama nɛn a tɔrɔyani,","poem":1},{"lineBreak":true},{"text":"na tɔrɔyaan yi sa muxu ɲaxin sɔtɔ a funfuni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ala kolontarena a adamadi bodene halagima a fala xuiin nan na.","poem":1},{"lineBreak":true},{"text":"Koni tinxin muxune xunbama e fe kolonna nan xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xa tinxin muxune sɛwa,","poem":1},{"lineBreak":true},{"text":"taan birin nan ɲaxanma.","poem":1},{"lineBreak":true},{"text":"Koni muxu ɲaxine na faxa,","poem":1},{"lineBreak":true},{"text":"ɲaxaɲaxan nan na ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Taan sabatima muxu faɲine duban nan xɔn.","poem":1},{"lineBreak":true},{"text":"Koni a kalama nɛn muxu ɲaxine dɛ xuiin ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Naxan na a adamadi boden naɲaxu,","poem":1},{"lineBreak":true},{"text":"na xaxili mi na.","poem":1},{"lineBreak":true},{"text":"Koni xaxilimana a dunduma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mafala tiin wundo feene nan naminima kɛnɛnni.","poem":1},{"lineBreak":true},{"text":"Koni lannaya muxuna e ramarama nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Xa maxadin mi na,","poem":1},{"lineBreak":true},{"text":"yamaan birama nɛn.","poem":1},{"lineBreak":true},{"text":"Koni kisin na a ra","poem":1},{"lineBreak":true},{"text":"xa kawandi muxune wuya ayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Naxan na a bodena donla goronna tongo,","poem":1},{"lineBreak":true},{"text":"na tɔrɔma nɛn yati.","poem":1},{"lineBreak":true},{"text":"Koni naxan na tondi na dɛ xui sifane ma,","poem":1},{"lineBreak":true},{"text":"na kanna luma makantanna nin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɲaxalan faɲin binyen nan sɔtɔma.","poem":1},{"lineBreak":true},{"text":"Koni xaɲɛden tan nafunla nan sɔtɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lannaya muxuna a yɛtɛ nan malima.","poem":1},{"lineBreak":true},{"text":"Koni kininkinintarena a yɛtɛ nan tɔrɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Muxu ɲaxine walima nɛn fuu!","poem":1},{"lineBreak":true},{"text":"Koni naxan na tinxinyaan liga,","poem":1},{"lineBreak":true},{"text":"na saran kɛndɛn nan sɔtɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tinxinyaan fama nii rakisin nan na.","poem":1},{"lineBreak":true},{"text":"Koni naxan na lu fe ɲaxin fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"na faxama nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Muxu bɔɲɛ ɲaxine mi rafan Alatala ma.","poem":1},{"lineBreak":true},{"text":"Koni fɛ mi naxanye sigati ki ra,","poem":1},{"lineBreak":true},{"text":"ne nan a kɛnɛnxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Muxu ɲaxine saranma nɛn e kɛwanle ra.","poem":1},{"lineBreak":true},{"text":"Koni tinxin muxune xunbama nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ɲaxalan tofaɲin na findi xaxilitaren na,","poem":1},{"lineBreak":true},{"text":"na luxi nɛn alo xɛma wuredin xɔsɛn ɲɔɛɛn na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tinxin muxun waxɔn feen nan fe faɲin na,","poem":1},{"lineBreak":true},{"text":"koni muxu ɲaxine natan nan xɔlɔn na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Muxuna ndee kiin tima","poem":1},{"lineBreak":true},{"text":"e findi nafulu kanne ra,","poem":1},{"lineBreak":true},{"text":"gbɛtɛye yi kuma ayi,","poem":1},{"lineBreak":true},{"text":"e findi yiigelitɔne ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Muxun naxan luma dubɛ bonne xa,","poem":1},{"lineBreak":true},{"text":"na bannama nɛn.","poem":1},{"lineBreak":true},{"text":"Naxan bonne nii yifanma e ma,","poem":1},{"lineBreak":true},{"text":"na fan nii yifanma a ma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Naxan na maala malan,","poem":1},{"lineBreak":true},{"text":"a tondi a matiyɛ,","poem":1},{"lineBreak":true},{"text":"yamaan na dangama nɛn.","poem":1},{"lineBreak":true},{"text":"Koni naxan na a mati,","poem":1},{"lineBreak":true},{"text":"yamaan dubama nɛn na fan xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Naxan na fe faɲin fen","poem":1},{"lineBreak":true},{"text":"na rafan muxune ma.","poem":1},{"lineBreak":true},{"text":"Koni naxan na fe ɲaxin fen,","poem":1},{"lineBreak":true},{"text":"na yati a sɔtɔma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Naxan na la a nafunle ra,","poem":1},{"lineBreak":true},{"text":"na birama nɛn.","poem":1},{"lineBreak":true},{"text":"Koni tinxin muxune sabatima nɛn","poem":1},{"lineBreak":true},{"text":"alo ɲɔxɔndena.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Naxan na a denbayaan tɔrɔ","poem":1},{"lineBreak":true},{"text":"na mi kɛɛ sɔtɔma fɔ foyena.","poem":1},{"lineBreak":true},{"text":"Xaxilitarene luma nɛn fe kolonne konyiyani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Tinxin muxune kɛwanle luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo siimaya wudina.","poem":1},{"lineBreak":true},{"text":"Fe kolonna naxan yi,","poem":1},{"lineBreak":true},{"text":"na muxune niin nan nakisima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Tinxin muxuna a saranna sɔtɔma dunuɲa yi,","poem":1},{"lineBreak":true},{"text":"e faxi fa muxu ɲaxine nun yulubi kanne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}