{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Muxun naxan a danna,","poem":1},{"lineBreak":true},{"text":"na tɔnɔn fenma a yɛtɛ nan xa.","poem":1},{"lineBreak":true},{"text":"A bɔɲɛn tema nɛn xaxilimaya falane birin ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Fe famunna bɔtɛ mi xaxilitaren xa,","poem":1},{"lineBreak":true},{"text":"fɔ a yɛtɛ miriyane fala fena.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Muxu ɲaxin na fa,","poem":1},{"lineBreak":true},{"text":"maraɲaxun fan yi fa.","poem":1},{"lineBreak":true},{"text":"Konbin fama yagin nan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Adamadiine falane luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo tilinna,","poem":1},{"lineBreak":true},{"text":"koni fe kolonna luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo tigi igen naxan tema ayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A mi lan muxu ɲaxin xa rafisa bodene xa,","poem":1},{"lineBreak":true},{"text":"hanma muxun yi tondi kiti kɛndɛn sɛ tinxin muxun xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xaxilitarena falane fe matandin nan nakelima,","poem":1},{"lineBreak":true},{"text":"a bɔnbɔ a dɛ xuiin ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xaxilitaren dɛna a halagima nɛn,","poem":1},{"lineBreak":true},{"text":"a fala xuine findixi luti ratixin nan na a xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nafigina falane luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo donse ɲaxumɛn","poem":1},{"lineBreak":true},{"text":"naxan godon muxun kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Naxan tunnaxɔlɔ a wanli","poem":1},{"lineBreak":true},{"text":"na nun se kalan birin muxu keden.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatala xinla muxun natangama","poem":1},{"lineBreak":true},{"text":"alo yin barakaxina,","poem":1},{"lineBreak":true},{"text":"tinxin muxuna a gima nɛn a siga a kui,","poem":1},{"lineBreak":true},{"text":"a lu makantanni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nafulu kanna kɛɛn findixi a taa makantanxin nan na.","poem":1},{"lineBreak":true},{"text":"A miriyani, yinna na a ra naxan mi nɔɛ kalɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Muxuna wasona a xalin kalan nan ma,","poem":1},{"lineBreak":true},{"text":"koni binyen sɔtɔma yɛtɛ magodon nan xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Naxan yabin tima benun a xa a tuli mati,","poem":1},{"lineBreak":true},{"text":"daxuyaan nan na ra, e nun yagina!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Muxuna limaniyaan nan a malima a fureni.","poem":1},{"lineBreak":true},{"text":"Koni xa a nii yifɔrɔ a ma,","poem":1},{"lineBreak":true},{"text":"nde a rasɛwama?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Xaxilimaan fe kolonna nan sɔtɔma a bɔɲɛni.","poem":1},{"lineBreak":true},{"text":"Fekolonne e tuli matima fe kolonna nan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Finma seen kiraan nan nabima a fi muxun yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"siga muxu gbeene fɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Naxan singe na a yaxaseri masa,","poem":1},{"lineBreak":true},{"text":"na maliga yo kanna ra,","poem":1},{"lineBreak":true},{"text":"han a yɛngɛfaan yi fa maxɔdinna ti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Masɛnsɛnna sɔnxɔ sɔnxɔne raxunbelima nɛn,","poem":1},{"lineBreak":true},{"text":"a yɛngɛne ɲan sɛnbɛmane tagi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Xa muxuna a ngaxakedenna konbi","poem":1},{"lineBreak":true},{"text":"na bɔɲɛn xɔdɔxɔma ayi nɛn a ma","poem":1},{"lineBreak":true},{"text":"dangu taa makantanxin yinna ra.","poem":1},{"lineBreak":true},{"text":"Fe matandine xɔdɔxɔ manga banxin dɛɛn balan wurene xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Muxun fala xuine nan balon sɔtɔma a xa.","poem":1},{"lineBreak":true},{"text":"Falan naxan minima a dɛ,","poem":1},{"lineBreak":true},{"text":"na nan a ralugoma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sayaan nun siimayaan binla findixi falan nan na.","poem":1},{"lineBreak":true},{"text":"A rafan naxan ma, na a tɔnɔn sɔtɔma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Naxan na ɲaxanla sɔtɔ,","poem":1},{"lineBreak":true},{"text":"na bata hɛrin sɔtɔ,","poem":1},{"lineBreak":true},{"text":"a Alatala fanna nan sɔtɔxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yiigelitɔɔn falan tima mafanna nin,","poem":1},{"lineBreak":true},{"text":"koni nafulu kanna yabi xɔdɛxɛn nan tima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Xɔyi wuyaxi nɔɛ findɛ nɛn bɔnɔn na muxun ma.","poem":1},{"lineBreak":true},{"text":"Koni xɔyina nde na,","poem":1},{"lineBreak":true},{"text":"na lannayaan dangu ngaxakedenna ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}