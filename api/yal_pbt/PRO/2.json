{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Fekolonna luxi nɛn alo nafulu luxunxina"]},{"type":"verse","number":1,"content":[{"text":"N ma diina, xa i n ma falane suxu,","poem":1},{"lineBreak":true},{"text":"xa i n ma yamarine suxu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"xa i fe kolonna xaranne ramɛ,","poem":1},{"lineBreak":true},{"text":"i yi kata e famudeni,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"xa i xaxilimayaan fen,","poem":1},{"lineBreak":true},{"text":"i yi i xui ramini a famun feen na,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"xa i a fen alo gbetina,","poem":1},{"lineBreak":true},{"text":"i yi a xɔn fen alo nafulu luxunxina","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"nayi, i Alatala yɛɛragaxun famuma nɛn","poem":1},{"lineBreak":true},{"text":"i yi Ala kolonna sɔtɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amasɔtɔ Alatala nan fekolonna fima,","poem":1},{"lineBreak":true},{"text":"kolonna nun xaxilimayaan fataxi a falane nan na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A muxu faɲine malima,","poem":1},{"lineBreak":true},{"text":"naxanye sigan tima fɛtareyani,","poem":1},{"lineBreak":true},{"text":"a ne yɛ masansanma","poem":1},{"lineBreak":true},{"text":"alo wure lefana e rabilinni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naxanye sigan tima tinxinni,","poem":1},{"lineBreak":true},{"text":"a ne ratangama.","poem":1},{"lineBreak":true},{"text":"A yi a muxu tɔgɔndiyaxine kantan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xa i n xuiin namɛ,","poem":1},{"lineBreak":true},{"text":"i tinxinna nun kiti sa kɛndɛn","poem":1},{"lineBreak":true},{"text":"nun fe faɲin nun kira faɲin birin famuma nɛn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amasɔtɔ fe kolonna luma nɛn i yi,","poem":1},{"lineBreak":true},{"text":"kolonna yi i nii yifan i ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I na feene yɛ fen,","poem":1},{"lineBreak":true},{"text":"na i ratangama nɛn","poem":1},{"lineBreak":true},{"text":"famun yi i kantan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"E yi i xunba kɛwali ɲaxin kiraan ma,","poem":1},{"lineBreak":true},{"text":"e i ratanga wuledene falane ma","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"naxanye kira tinxinxin beɲinma","poem":1},{"lineBreak":true},{"text":"e siga kira yidimixine xɔn","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"naxanye sɛwan fe ɲaxin ligadeni,","poem":1},{"lineBreak":true},{"text":"e yi ɲaxan fe ɲaxin na tinxintareyani","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"naxanye sigati ki mi tinxin,","poem":1},{"lineBreak":true},{"text":"e kɛwanle kobi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"I xunbama ɲaxalan yalunxin yii na kii nin.","poem":1},{"lineBreak":true},{"text":"Muxu gbɛtɛna ɲaxanla mi nɔɛ i rakunfɛ fala ɲaxumɛne ra,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ɲaxanla naxan bata a mɛ a xɛmɛn na","poem":1},{"lineBreak":true},{"text":"a dɔxɔ xɛmɛn naxan xɔn a sungutun waxatini","poem":1},{"lineBreak":true},{"text":"a yi ɲinan na futu layirin xɔn","poem":1},{"lineBreak":true},{"text":"a naxan xidi Ala yɛtagi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A kɛwanle findima bɔnɔn nan na a ma,","poem":1},{"lineBreak":true},{"text":"a sigati kiin yi a xali sayani.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Naxan na siga a konni,","poem":1},{"lineBreak":true},{"text":"na mi fa xɛtɛma","poem":1},{"lineBreak":true},{"text":"a mi fa nii rakisin kiraan masɔtɔma mumɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I sigama muxu faɲine kiraan xɔn na kii nin,","poem":1},{"lineBreak":true},{"text":"i lu tinxinyaan fari.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Amasɔtɔ muxu faɲine siimayaan sɔtɔma nɛn yamanani.","poem":1},{"lineBreak":true},{"text":"Fɛ mi muxun naxanye ra,","poem":1},{"lineBreak":true},{"text":"ne luma nɛn yamanani.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Koni muxu ɲaxine bama nɛn yamanani,","poem":1},{"lineBreak":true},{"text":"yanfantenne yi raxɔri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}