{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Xa ɛ nun kuntigina nde dɔxɔma ɛ dɛgedeni,","poem":1},{"lineBreak":true},{"text":"naxan i yɛtagi,","poem":1},{"lineBreak":true},{"text":"na rakɔrɔsi ki faɲi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xa i fudi ɲaxu,","poem":1},{"lineBreak":true},{"text":"i yɛtɛ suxu a xɔdɛxɛn na de!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I nama mila a donse faɲine xɔn,","poem":1},{"lineBreak":true},{"text":"bayo yanfa so donseene nan ne ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I nama i yɛtɛ raxadan nafunla fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"i xaxili ba na xɔn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I nɛma fa i yɛɛn ti nafunla ra","poem":1},{"lineBreak":true},{"text":"a bata ɲan!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ gabutɛne minima a ma nɛn,","poem":1},{"lineBreak":true},{"text":"a tugan, te kore alo singbinna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I nama muxu yɛtagi yifɔrɛna balon don,","poem":1},{"lineBreak":true},{"text":"i nama kunfa a donse faɲine xɔn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bayo i a lima nɛn,","poem":1},{"lineBreak":true},{"text":"a bata fena nde nata,","poem":1},{"lineBreak":true},{"text":"a naxa, “I dɛge, i min.”","poem":1},{"lineBreak":true},{"text":"Koni na mi a bɔɲɛni!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I naxan donxi,","poem":1},{"lineBreak":true},{"text":"i a baxunma nɛn,","poem":1},{"lineBreak":true},{"text":"i bɔnɔ i ya fala faɲine yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I nama fala ti xaxilitaren xa,","poem":1},{"lineBreak":true},{"text":"bayo i ya xaxilimaya falane bɔtɛ mi a xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I nama bɔxɔn danna taxamaseri gɛmɛ singene ba e funfuni.","poem":1},{"lineBreak":true},{"text":"I nama se ba kiri diine xɛɛne ra,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"amasɔtɔ Ala fangan gbo e xunbadeni,","poem":1},{"lineBreak":true},{"text":"a e xun mayɛngɛn soma nɛn i xili ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"I xaxinla rabi i xuru falane ma.","poem":1},{"lineBreak":true},{"text":"I tuli mati fekolon falane ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"I nama diin nafutuxulu a xurun ma,","poem":1},{"lineBreak":true},{"text":"xa i a bɔnbɔ, a mi faxama.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I na diin xuru bosaan na,","poem":1},{"lineBreak":true},{"text":"i a niin nakisima nɛn sayaan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"xa fekolonna lu i bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"nayi, n fan bɔɲɛn sɛwama nɛn.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N sɔndɔmɛ yɛtɛn ɲaxanma nɛn,","poem":1},{"lineBreak":true},{"text":"i na fala faɲin ti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"I nama yulubitɔne maxɔxɔlɔn i bɔɲɛni","poem":1},{"lineBreak":true},{"text":"koni gaxu Alatala yɛɛ ra waxatin birin yi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nayi, i yigin sɔtɔma nɛn waxati famatɔne yi,","poem":1},{"lineBreak":true},{"text":"i mi yigitɛgɛ mumɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"I tan n ma diina, i tuli mati,","poem":1},{"lineBreak":true},{"text":"i findi fekolonna ra,","poem":1},{"lineBreak":true},{"text":"i yi i bɔɲɛn lu kira faɲin xɔn.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I nama lu dɔlɔ minne yɛ,","poem":1},{"lineBreak":true},{"text":"e nun naxanye suben donma,","poem":1},{"lineBreak":true},{"text":"e a radangu ayi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Amasɔtɔ fudimane nun dɔlɔ minne yiigelima nɛn,","poem":1},{"lineBreak":true},{"text":"e tunnaxɔlɔn yi marabɛnna ti e ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"I tuli mati i baba ra,","poem":1},{"lineBreak":true},{"text":"a tan naxan i sɔtɔxi.","poem":1},{"lineBreak":true},{"text":"I nama yo i nga ma a foriyani.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ɲɔndin nun fe kolonna nun xurun nun xaxilimayaan fen,","poem":1},{"lineBreak":true},{"text":"i nama ne masara sese ra.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tinxin muxun baba ɲaxanma nɛn,","poem":1},{"lineBreak":true},{"text":"dii fekolonna sɔtɔ muxun luma nɛn sɛwani.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ala xa sɛwan fi i baba nun i nga ma,","poem":1},{"lineBreak":true},{"text":"i bari muxun yi ɲaxan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"N ma diina, i xaxili ti n na,","poem":1},{"lineBreak":true},{"text":"i yɛɛn ti n ma misaala ra.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Amasɔtɔ ɲaxalan yalunden muxun nabirama nɛn","poem":1},{"lineBreak":true},{"text":"alo yili tilinxina,","poem":1},{"lineBreak":true},{"text":"muxu gbɛtɛna ɲaxanla magaxu","poem":1},{"lineBreak":true},{"text":"alo xɔɲin naxurina.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A dɔxɔma nɛn muxune yɛɛ ra","poem":1},{"lineBreak":true},{"text":"alo mafu tiina.","poem":1},{"lineBreak":true},{"text":"A xɛmɛ wuyaxi findi yanfantenne ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tɔrɔna nde xa?","poem":1},{"lineBreak":true},{"text":"Nimisana nde xa?","poem":1},{"lineBreak":true},{"text":"Matandine nde fɔxɔ ra?","poem":1},{"lineBreak":true},{"text":"Mawugane nde xɔn?","poem":1},{"lineBreak":true},{"text":"Maxɔlɔde fufafune nde ma?","poem":1},{"lineBreak":true},{"text":"Nde yɛɛ gbeelixi?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Dɔlɔ minne nan na kiini,","poem":1},{"lineBreak":true},{"text":"naxanye sa dɔlɔ faɲine fenma,","poem":1},{"lineBreak":true},{"text":"e xa e mato.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"I nama i yɛɛn ti dɔlɔ to faɲi gbeela ra,","poem":1},{"lineBreak":true},{"text":"a yiyalanxi igelengenna kui waxatin naxan yi","poem":1},{"lineBreak":true},{"text":"godo xinla ma muxun kɔɛ ra ki faɲi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bayo na xanbi ra, a xɔlɔma i ra nɛn","poem":1},{"lineBreak":true},{"text":"alo saɲin na muxun xin","poem":1},{"lineBreak":true},{"text":"a i gan alo koson xin dɛna.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"I fe magaxuxine toma nɛn","poem":1},{"lineBreak":true},{"text":"i yi lu fala yifuxine tiyɛ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"I xun magima i ra nɛn","poem":1},{"lineBreak":true},{"text":"alo muxun naxan saxi kunkin kui fɔxɔ igen tagi,","poem":1},{"lineBreak":true},{"text":"kunkin xuntagi yɛtɛni.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"I luma a falɛ nɛn, i naxa,","poem":1},{"lineBreak":true},{"text":"“E bata n garin,","poem":1},{"lineBreak":true},{"text":"anu a mi n xɔlɔxi!","poem":1},{"lineBreak":true},{"text":"E bata n mabɔnbɔ,","poem":1},{"lineBreak":true},{"text":"anu n mi fe kolonxi a yi!","poem":1},{"lineBreak":true},{"text":"N fa xulunma waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"Dɔlɔ xɔnla mɔn n ma!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}