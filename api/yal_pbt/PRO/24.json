{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"I nama mila muxu ɲaxine fe xɔn.","poem":1},{"lineBreak":true},{"text":"E yɛ lu xɔnla nama i suxu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amasɔtɔ e gbalo feen nan yitɔnma e bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"fe ɲaxin nan minima e dɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Banxin tima fe kolonna nan xɔn,","poem":1},{"lineBreak":true},{"text":"a sabatima xaxinla nan xɔn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Banxin nafema hɛrisigɛ kɛndɛne nun se faɲine ra","poem":1},{"lineBreak":true},{"text":"fe kolonna sabun nin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Fe kolonne sɛnbɛn gbo han!","poem":1},{"lineBreak":true},{"text":"Kolonna muxun naxan yi,","poem":1},{"lineBreak":true},{"text":"na fangan xun masama nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amasɔtɔ fɔ muxun xa a miri ki faɲi","poem":1},{"lineBreak":true},{"text":"benun a xa mini yɛngɛ sodeni.","poem":1},{"lineBreak":true},{"text":"Nɔɔn sɔtɔma maxadi muxu wuyaxi nan baraka yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Xaxilimayaan gbo xaxilitaren ma,","poem":1},{"lineBreak":true},{"text":"a mi falan tiyɛ taan fonne malanni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naxan fe ɲaxini tɔnma,","poem":1},{"lineBreak":true},{"text":"na xilima nɛn a kɔtɛ ɲaxin kanna.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xaxilitareyana miriyane findixi yulubin nan na.","poem":1},{"lineBreak":true},{"text":"Magele tiin naɲaxuma nɛn muxune tagi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xa wɛkilɛn ɲan i yi gbalon lɔxɔni,","poem":1},{"lineBreak":true},{"text":"sese mi i fangan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Muxune xunba naxanye xalima e faxadeni,","poem":1},{"lineBreak":true},{"text":"i yi muxune rakisi naxanye faxamatɔ a ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xa i a fala, i naxa,","poem":1},{"lineBreak":true},{"text":"“Nxu mi yi a kolon,”","poem":1},{"lineBreak":true},{"text":"naxan bɔɲɛne fɛsɛfɛsɛma,","poem":1},{"lineBreak":true},{"text":"na mi ɲɔndin kolonɲɛ ba?","poem":1},{"lineBreak":true},{"text":"Naxan i niin kantanma,","poem":1},{"lineBreak":true},{"text":"na mi a kolon ba?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"kumina nde kɔn bayo a fan.","poem":1},{"lineBreak":true},{"text":"Kumi dɛngbɛn ɲaxun i dɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fe kolonna fan na kii nin i niin xa.","poem":1},{"lineBreak":true},{"text":"Xa i a sɔtɔ,","poem":1},{"lineBreak":true},{"text":"i hɛrin sɔtɔma nɛn yɛɛn na,","poem":1},{"lineBreak":true},{"text":"i mi yigitɛgɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Muxu ɲaxine,","poem":1},{"lineBreak":true},{"text":"ɛ nama dɔxɔ muxune yɛɛ ra","poem":1},{"lineBreak":true},{"text":"e suxu xinla ma tinxin muxun konni,","poem":1},{"lineBreak":true},{"text":"ɛ fu a dɔxɔden ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bayo tinxin muxun nɔɛ birɛ nɛn dɔxɔɲa ma solofere","poem":1},{"lineBreak":true},{"text":"a mɔn yi keli.","poem":1},{"lineBreak":true},{"text":"Koni muxu ɲaxine birama nɛn gbaloni keden na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"I nama ɲaxan xa i yaxun bira.","poem":1},{"lineBreak":true},{"text":"Xa a dagalanɲɛ ayi,","poem":1},{"lineBreak":true},{"text":"i nama sɛwa i bɔɲɛni","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"alogo Alatala nama na to,","poem":1},{"lineBreak":true},{"text":"na yi raɲaxu a ma,","poem":1},{"lineBreak":true},{"text":"a yi ba xɔlɔxi i yaxun ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"I nama xɔlɔ muxu ɲaxine fe ra,","poem":1},{"lineBreak":true},{"text":"i nama mila e seene xɔn.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Amasɔtɔ fe ɲaxi rabaan mi hɛrin lima a yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"Muxu ɲaxine lɛnpun tuma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"N ma diina, gaxu Alatala yɛɛ ra","poem":1},{"lineBreak":true},{"text":"e nun mangana,","poem":1},{"lineBreak":true},{"text":"i nama lu muxu murutɛxine yɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Amasɔtɔ e tɔrɔn kelima nɛn sanɲa ma kedenni.","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ a kolonɲɛ","poem":1},{"lineBreak":true},{"text":"Ala nun mangan halagin naxan nagidima?","poem":1}]},{"type":"heading","content":["Fekolonne fala gbɛtɛne"]},{"type":"verse","number":23,"content":[{"text":"Fekolonne mɔn ito nan falaxi:","poem":1},{"lineBreak":true},{"text":"A mi lan muxune xa rafisa e bode xa kiti sadeni.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Naxan na a fala muxu ɲaxin ma,","poem":1},{"lineBreak":true},{"text":"a naxa, “I tinxin,”","poem":1},{"lineBreak":true},{"text":"yamaan nan na kanna dangama,","poem":1},{"lineBreak":true},{"text":"siyane yi xɔlɔ a xili ma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Koni naxan na muxu ɲaxin yalagi,","poem":1},{"lineBreak":true},{"text":"na lanxi.","poem":1},{"lineBreak":true},{"text":"Duba gbeen nan na kanna xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yabi tinxinxin ɲaxun","poem":1},{"lineBreak":true},{"text":"alo marafan sunbuna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"I ya wanle rakamali tanden ma,","poem":1},{"lineBreak":true},{"text":"i yi i ya xɛɛne yitɔn,","poem":1},{"lineBreak":true},{"text":"na xanbi ra i fa i ya banxin ti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"I nama i adamadi boden tɔɲɛgɛ,","poem":1},{"lineBreak":true},{"text":"i wulen nan sama a xun ma ba?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"I nama a fala, i naxa,","poem":1},{"lineBreak":true},{"text":"“A to bata a liga n na,","poem":1},{"lineBreak":true},{"text":"n fan xa a ɲɔxɔn liga a ra,","poem":1},{"lineBreak":true},{"text":"n muxun birin saren fima a wanla nan na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"N dangu nɛn muxu narixina nde a xɛɛn dɛxɔn ma,","poem":1},{"lineBreak":true},{"text":"xaxilitarena nde nakɔ yirena.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Xalone bata yi mini yirena ngaani,","poem":1},{"lineBreak":true},{"text":"sɛxɛ ɲaxine yi xɛɛn birin ma,","poem":1},{"lineBreak":true},{"text":"a gɛmɛ sansanna bata yi bira.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"N to na to,","poem":1},{"lineBreak":true},{"text":"n yi a rakɔrɔsi,","poem":1},{"lineBreak":true},{"text":"n yi na feen sa n bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"n yi xurun sɔtɔ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"I na i sa,","poem":1},{"lineBreak":true},{"text":"yeriyerinna yi dangu i ma ndedi,","poem":1},{"lineBreak":true},{"text":"i xi ndedi,","poem":1},{"lineBreak":true},{"text":"i yi i yiine filin e bode ma ndedi,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"yiigelitɔyaan yi baga i ma","poem":1},{"lineBreak":true},{"text":"alo mafu tiina,","poem":1},{"lineBreak":true},{"text":"e nun setareyana alo muɲadena.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}