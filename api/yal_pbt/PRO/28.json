{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Muxu ɲaxina a gima nɛn","poem":1},{"lineBreak":true},{"text":"hali muxe mi a fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"koni tinxin muxun tan susu","poem":1},{"lineBreak":true},{"text":"alo yata sɛnbɛmana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Xa yamanan dugurenne murutɛ,","poem":1},{"lineBreak":true},{"text":"kuntigine wuyama ayi nɛn na yi.","poem":1},{"lineBreak":true},{"text":"Koni manga xaxilimaan naxan fe kolon,","poem":1},{"lineBreak":true},{"text":"na a ligama nɛn yamaan yi e raxara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yiigelitɔɔn naxan sɛnbɛtarene ɲaxankatama","poem":1},{"lineBreak":true},{"text":"na luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo kala ti tulen naxan mi balo luma na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Naxanye sariyan beɲinma","poem":1},{"lineBreak":true},{"text":"ne muxu ɲaxine nan tantunma,","poem":1},{"lineBreak":true},{"text":"koni naxanye sariyan suxuma","poem":1},{"lineBreak":true},{"text":"ne xɔlɔma nɛn e ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Muxu ɲaxine mi kiti kɛndɛn kolon","poem":1},{"lineBreak":true},{"text":"koni naxanye Alatala fenma","poem":1},{"lineBreak":true},{"text":"ne a birin famuma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yiigelitɔɔn naxan sigan tiin tinxinni,","poem":1},{"lineBreak":true},{"text":"na fisa nafulu kanna xa","poem":1},{"lineBreak":true},{"text":"naxan kira yifuxin xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naxan na sariyan suxu,","poem":1},{"lineBreak":true},{"text":"dii xaxilimaan nan na ra,","poem":1},{"lineBreak":true},{"text":"koni naxan na lu fuyantenne yɛ,","poem":1},{"lineBreak":true},{"text":"na fama yagin nan na a baba ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naxan na dahamu gbeti donla tɔnɔ gbeene xɔn","poem":1},{"lineBreak":true},{"text":"na a malanma muxu gbɛtɛn nan xa","poem":1},{"lineBreak":true},{"text":"naxan hinanma sɛnbɛtarene ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Xa muxuna nde a tunla ba sariyan na","poem":1},{"lineBreak":true},{"text":"alogo a nama a mɛ,","poem":1},{"lineBreak":true},{"text":"hali a na sali,","poem":1},{"lineBreak":true},{"text":"na yɛtɛɛn haramuxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Naxan na muxu faɲine xali kira ɲaxin xɔn,","poem":1},{"lineBreak":true},{"text":"na biran yinla nan na a naxan gexi.","poem":1},{"lineBreak":true},{"text":"Koni fɛ mi naxan na,","poem":1},{"lineBreak":true},{"text":"na hɛrin nan sɔtɔma a kɛɛn na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nafulu kanna a mirixi nɛn a fe kolon,","poem":1},{"lineBreak":true},{"text":"koni yiigelitɔ xaxilimana a kɛɲaan nakɔrɔsima nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tinxin muxune na nɔɔn sɔtɔ,","poem":1},{"lineBreak":true},{"text":"binye gbeen na a ra,","poem":1},{"lineBreak":true},{"text":"koni xa muxu ɲaxine keli,","poem":1},{"lineBreak":true},{"text":"birin a luxunma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Naxan na a hakɛne luxun,","poem":1},{"lineBreak":true},{"text":"na mi hɛrin sɔtɔma.","poem":1},{"lineBreak":true},{"text":"Koni naxan na a ti e ra,","poem":1},{"lineBreak":true},{"text":"a xɛtɛ e fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"Ala kininkininma na ma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sɛwan na kanna xa","poem":1},{"lineBreak":true},{"text":"naxan gaxun Ala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"koni naxan na a bɔɲɛni xɔdɔxɔ","poem":1},{"lineBreak":true},{"text":"na birama tɔrɔni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yatan naxan wurundunma","poem":1},{"lineBreak":true},{"text":"e nun kanko gbeen naxan fɔnma muxun ma,","poem":1},{"lineBreak":true},{"text":"na luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo muxu ɲaxina yama sɛnbɛtaren xun na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Manga xaxilitaren tinxintare wanle wuya.","poem":1},{"lineBreak":true},{"text":"Koni hɛrisigɛn naxan sɔtɔxi wulen xɔn,","poem":1},{"lineBreak":true},{"text":"na raɲaxu naxan ma,","poem":1},{"lineBreak":true},{"text":"na siimayaan xunkuyama ayi nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Faxa ti goronna muxun naxan xun ma,","poem":1},{"lineBreak":true},{"text":"na a gima nɛn han a sa a gaburun li.","poem":1},{"lineBreak":true},{"text":"Muxu yo nama a rati!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Naxan na sigan ti fɛtareyani,","poem":1},{"lineBreak":true},{"text":"na kisima nɛn.","poem":1},{"lineBreak":true},{"text":"Koni naxan na tinxintareyaan liga,","poem":1},{"lineBreak":true},{"text":"a kira firinna suxu","poem":1},{"lineBreak":true},{"text":"na birama nɛn na nde kedenna xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Naxan na a bɔxɔn nawali,","poem":1},{"lineBreak":true},{"text":"na lugoma nɛn.","poem":1},{"lineBreak":true},{"text":"Koni naxan na bira fe fuune fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"na wasama yiigelitɔyaan nan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lannaya muxun wasaxi barakan nan na.","poem":1},{"lineBreak":true},{"text":"Koni naxan kunfaxi bannayaan xɔn,","poem":1},{"lineBreak":true},{"text":"na saranma nɛn na feen na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"A mi lan i muxune rafisa e bode xa,","poem":1},{"lineBreak":true},{"text":"anu, muxun hakɛn sɔtɔma buru dungin xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Naxan kuma,","poem":1},{"lineBreak":true},{"text":"na kunfaxi bannayaan nan xɔn,","poem":1},{"lineBreak":true},{"text":"a mi a kolon a tɔrɔn nan fama a ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Naxan na muxun sɔnna fala a xa,","poem":1},{"lineBreak":true},{"text":"na rafanma nɛn na kanna ma nɛn dɔnxɛn na","poem":1},{"lineBreak":true},{"text":"dangu muxun na","poem":1},{"lineBreak":true},{"text":"naxan a matɔxɔma wuleni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Naxan na a baba nun a nga muɲa,","poem":1},{"lineBreak":true},{"text":"a yi a fala, a naxa,","poem":1},{"lineBreak":true},{"text":"“Fe ɲaxi mi na ra,”","poem":1},{"lineBreak":true},{"text":"na findixi halagi tiin fɔxɔrabiran nan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Naxan a yɛtɛ yigboma,","poem":1},{"lineBreak":true},{"text":"na yɛngɛne nan nakelima.","poem":1},{"lineBreak":true},{"text":"Koni naxan na a yigin sa Alatala yi,","poem":1},{"lineBreak":true},{"text":"na sabatima nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Naxan na a yigi sa a yɛtɛ xaxinli","poem":1},{"lineBreak":true},{"text":"xaxilitaren nan na ra.","poem":1},{"lineBreak":true},{"text":"Koni naxan sigan tima fe kolonni,","poem":1},{"lineBreak":true},{"text":"na kisima nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Naxan yiigelitɔne kima,","poem":1},{"lineBreak":true},{"text":"sese mi dasɛ na ma.","poem":1},{"lineBreak":true},{"text":"Koni naxan na a yɛɛn naxi e ma,","poem":1},{"lineBreak":true},{"text":"na danga gbeen nan sɔtɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Xa muxu ɲaxine keli,","poem":1},{"lineBreak":true},{"text":"birin a luxunma nɛn.","poem":1},{"lineBreak":true},{"text":"Koni xa e halagi,","poem":1},{"lineBreak":true},{"text":"tinxin muxune nan wuyama ayi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}