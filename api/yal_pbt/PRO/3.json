{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Fe kolonna tɔnɔna"]},{"type":"verse","number":1,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"i nama ɲinan n ma xaranna xɔn,","poem":1},{"lineBreak":true},{"text":"i xa n ma yamarine suxu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"amasɔtɔ e i ya siimayaan xɔnkuyama ayi nɛn,","poem":1},{"lineBreak":true},{"text":"i ya bɔɲɛ xunbeli ɲɛɛne yi fari sa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hinanna nun lannayaan nama ɲan i yi,","poem":1},{"lineBreak":true},{"text":"e bira i kɔɛ ɲɛrɛn na,","poem":1},{"lineBreak":true},{"text":"i e sa i bɔɲɛni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nayi, i marafanna nun xili faɲin sɔtɔma nɛn,","poem":1},{"lineBreak":true},{"text":"Ala nun muxune ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I yigin sa Alatala yi i bɔɲɛn ma feu!","poem":1},{"lineBreak":true},{"text":"I nama la i ya xaxilimayaan na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I xa Ala kolon i ya feene birin yi,","poem":1},{"lineBreak":true},{"text":"a tan yi i ya kirane matinxin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I nama i yɛtɛ yatɛ fe kolonna ra.","poem":1},{"lineBreak":true},{"text":"Gaxu Alatala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"i masiga fe ɲaxin na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na findima nɛn kɛndɛyaan na i fatini,","poem":1},{"lineBreak":true},{"text":"a yi i xɔnne sɛnbɛ so.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala binya i yii seene ra","poem":1},{"lineBreak":true},{"text":"e nun i ya bogi se xabaxi singene.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nayi, i ya sagane rafema nɛn kenken,","poem":1},{"lineBreak":true},{"text":"i ya kundine yi rafe manpaan nɛnɛn na","poem":1},{"lineBreak":true},{"text":"han e bɔxɔn a ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"Alatala nɛma i xurɛ,","poem":1},{"lineBreak":true},{"text":"i nama yo na ma.","poem":1},{"lineBreak":true},{"text":"A nɛma i sɔnna yitɛ i ra,","poem":1},{"lineBreak":true},{"text":"i nama xɔlɔ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amasɔtɔ Alatala a xanuntenne xuruma,","poem":1},{"lineBreak":true},{"text":"alo dii fafan nafan dii xɛmɛna.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sɛwan na kanna xa,","poem":1},{"lineBreak":true},{"text":"naxan na fekolonna sɔtɔ,","poem":1},{"lineBreak":true},{"text":"naxan na famunna sɔtɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amasɔtɔ a tɔnɔn gbo","poem":1},{"lineBreak":true},{"text":"dangu gbetin na,","poem":1},{"lineBreak":true},{"text":"a seen naxanye sɔtɔma,","poem":1},{"lineBreak":true},{"text":"ne fisa xɛmaan xa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A fan dangu bɔxɔ bun nafunla ra,","poem":1},{"lineBreak":true},{"text":"i waxɔn se yo mi nɔɛ sɛ a ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A siimaya xɔnkuyen fima muxun ma,","poem":1},{"lineBreak":true},{"text":"a nafunla nun binyen fi a ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A kirane birin fan,","poem":1},{"lineBreak":true},{"text":"bɔɲɛ xunbenla nan ne ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Naxanye fekolonna fenma","poem":1},{"lineBreak":true},{"text":"a findixi siimaya wudin nan na ne xa.","poem":1},{"lineBreak":true},{"text":"Naxanye a sɔtɔma,","poem":1},{"lineBreak":true},{"text":"sɛwan ne xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Alatala bɔxɔn nafalaxi fe kolonna nan xɔn,","poem":1},{"lineBreak":true},{"text":"a famun yi kuyen da,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"tilinne rabixi a kolonna nan ma,","poem":1},{"lineBreak":true},{"text":"kundane yi xiila rafa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"xaxilimayaan namara,","poem":1},{"lineBreak":true},{"text":"i feene yɛ fen,","poem":1},{"lineBreak":true},{"text":"i lu na fari waxatin birin.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Na findima nɛn siimayaan na i niin xa,","poem":1},{"lineBreak":true},{"text":"a lu alo ɲɛrɛna i kɔɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nayi, i sigan tima nɛn xaxili sani i ya kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"i mi i sanna radinɲɛ sese ra.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"I na i sa, i mi gaxuɛ.","poem":1},{"lineBreak":true},{"text":"I nɛma saxi, i ya xixɔnla ɲaxunma nɛn.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"I nama gaxu fe magaxuxi yo yɛɛ ra","poem":1},{"lineBreak":true},{"text":"naxan fɛ sanɲa ma kedenni,","poem":1},{"lineBreak":true},{"text":"hanma gbalon naxan muxu ɲaxine sɔtɔma,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"amasɔtɔ Alatala findima nɛn i ya xaxili ragidin na.","poem":1},{"lineBreak":true},{"text":"A i sanne ratanga luti ratixine birin ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"I nama tondi fe faɲin nabɛ muxune xa,","poem":1},{"lineBreak":true},{"text":"naxanye daxa e a sɔtɔ,","poem":1},{"lineBreak":true},{"text":"xa fɛrɛna i xa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Xa sena i yii iki,","poem":1},{"lineBreak":true},{"text":"i nama a fala i adamadi boden xa,","poem":1},{"lineBreak":true},{"text":"i naxa, “Siga, tila i fa,","poem":1},{"lineBreak":true},{"text":"n na a soma i yii!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"I nama fe ɲaxini tɔn i adamadi boden xili ma,","poem":1},{"lineBreak":true},{"text":"a nɛma dɔxi i fɛma lannayani.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"I nama muxun kansun","poem":1},{"lineBreak":true},{"text":"xa yo mi i xa,","poem":1},{"lineBreak":true},{"text":"a mi fe ɲaxi ligaxi i ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"I nama gbalotɔɔn maxɔxɔlɔn,","poem":1},{"lineBreak":true},{"text":"i nama a kira yo sugandi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Amasɔtɔ muxu ɲaxin mi rafan Alatala ma,","poem":1},{"lineBreak":true},{"text":"koni Alaa wundo feene muxu faɲine nan xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Alatala dangan muxu ɲaxina denbayaan fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"koni a barakan sama nɛn tinxin muxune konni.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"A magele ti wasoxine magelema nɛn,","poem":1},{"lineBreak":true},{"text":"koni a hinanma nɛn yɛtɛ magodone ra.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Fekolonne binyen nan sɔtɔma e kɛɛn na,","poem":1},{"lineBreak":true},{"text":"koni xaxilitarene yagi gbeen nan sɔtɔma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}