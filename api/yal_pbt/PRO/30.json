{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Aguri a sandane"]},{"type":"verse","number":1,"content":[{"text":"Yakɛ a dii xɛmɛna Aguri a waliyiya falane.","poem":1},{"lineBreak":true},{"text":"A fala nɛn Itiyeli nun Yukala xa, a naxa:","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Xaxilitaren nan n na","poem":1},{"lineBreak":true},{"text":"dangu muxun birin na.","poem":1},{"lineBreak":true},{"text":"Adamadi xaxili mi n ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N mi fe kolonna sɔtɔxi,","poem":1},{"lineBreak":true},{"text":"n mi Ala Sariɲanxina kolonna sɔtɔxi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nde texi kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"a mɔn yi godo?","poem":1},{"lineBreak":true},{"text":"Nde foyen malanxi a yiine kui?","poem":1},{"lineBreak":true},{"text":"Nde igen naxudu a domani?","poem":1},{"lineBreak":true},{"text":"Nde bɔxɔn danne birin nafalaxi?","poem":1},{"lineBreak":true},{"text":"A xili di, a diin fan xili di?","poem":1},{"lineBreak":true},{"text":"I na kolon ba?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alaa falane birin sariɲan.","poem":1},{"lineBreak":true},{"text":"Naxanye e luxunma a yi,","poem":1},{"lineBreak":true},{"text":"a ne yɛ masansanma nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I nama sese sa a falane fari","poem":1},{"lineBreak":true},{"text":"alogo a nama i maxadi,","poem":1},{"lineBreak":true},{"text":"i yi kolon wule falan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N fe firin nan maxɔdinma i ma, Ala.","poem":1},{"lineBreak":true},{"text":"I nama tondi e ma n xa,","poem":1},{"lineBreak":true},{"text":"benun n xa faxa!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fuyantenyaan nun wulen masiga n na.","poem":1},{"lineBreak":true},{"text":"I nama bannayaan fi n ma hanma yiigelitɔyana,","poem":1},{"lineBreak":true},{"text":"fɔ n mako donseen naxan ma","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"alogo n nama lugo ɲaxi ra,","poem":1},{"lineBreak":true},{"text":"n na n mɛ i ra","poem":1},{"lineBreak":true},{"text":"n yi a fala, n naxa, “Nde Alatala ra?”","poem":1},{"lineBreak":true},{"text":"Hanma n findi yiigelitɔɔn na,","poem":1},{"lineBreak":true},{"text":"n yi muɲan ti,","poem":1},{"lineBreak":true},{"text":"n yi n ma Ala xili kala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I nama walikɛ mafala a kanna xa","poem":1},{"lineBreak":true},{"text":"alogo a nama i danga,","poem":1},{"lineBreak":true},{"text":"a hakɛn yi lu i ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Muxuna ndee na","poem":1},{"lineBreak":true},{"text":"naxanye e baba dangama,","poem":1},{"lineBreak":true},{"text":"naxanye mi dubama e nga xa,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"naxanye sariɲan e yɛtɛ yɛɛ ra yi","poem":1},{"lineBreak":true},{"text":"anu, e xɔsin mi baxi e ma","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"naxanye yɛɛ rawaso","poem":1},{"lineBreak":true},{"text":"e muxune matoma yɛtɛ yigboni,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"naxanye ɲinne luxi alo silanfanne","poem":1},{"lineBreak":true},{"text":"e gbɛgbɛne maxɔlɔn tima alo filɛne,","poem":1},{"lineBreak":true},{"text":"alogo e xa yiigelitɔne raxɔri bɔxɔn fari","poem":1},{"lineBreak":true},{"text":"e tɔrɔ muxune ɲan adamadiine yɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dii firin yi nusun yii","poem":1},{"lineBreak":true},{"text":"naxanye yi a falama tun,","poem":1},{"lineBreak":true},{"text":"e naxa, “N ki! N ki!”","poem":1},{"lineBreak":true},{"text":"Se saxan nan na","poem":1},{"lineBreak":true},{"text":"naxanye mi wasama mumɛ,","poem":1},{"lineBreak":true},{"text":"han se naanin naxanye mi a falɛ,","poem":1},{"lineBreak":true},{"text":"e naxa, “Na lan.”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E tan ni i ra:","poem":1},{"lineBreak":true},{"text":"Laxira nun gbantan nun","poem":1},{"lineBreak":true},{"text":"bɔxɔn naxan mi wasama igen na,","poem":1},{"lineBreak":true},{"text":"e nun tɛɛn naxan mi a falan mumɛ,","poem":1},{"lineBreak":true},{"text":"a naxa, “Na lan.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Muxun naxan yɛɛ yoma a baba ma,","poem":1},{"lineBreak":true},{"text":"naxan tondima a nga xuiin suxɛ,","poem":1},{"lineBreak":true},{"text":"xude xɔn xaxane a yɛɛne gema nɛn a kui,","poem":1},{"lineBreak":true},{"text":"dugane yi e don.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Se saxan na","poem":1},{"lineBreak":true},{"text":"naxanye dangu n na,","poem":1},{"lineBreak":true},{"text":"han naanin","poem":1},{"lineBreak":true},{"text":"n mi naxanye famuxi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E tan ni i ra:","poem":1},{"lineBreak":true},{"text":"Singbinna kirana kore,","poem":1},{"lineBreak":true},{"text":"saɲina kirana gɛmɛn fari,","poem":1},{"lineBreak":true},{"text":"kunkina kirana fɔxɔ igen xun ma,","poem":1},{"lineBreak":true},{"text":"e nun banxulanna kirana sungutunna konni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ɲaxalan yalunden kɛɲaan ni ito ra:","poem":1},{"lineBreak":true},{"text":"A na a dɛge,","poem":1},{"lineBreak":true},{"text":"a a dɛɛn nasugusugu,","poem":1},{"lineBreak":true},{"text":"a yi a fala, a naxa,","poem":1},{"lineBreak":true},{"text":"“N mi sese ligaxi a ɲaxin na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bɔxɔn xuruxurunma se saxan bun,","poem":1},{"lineBreak":true},{"text":"han naanin a mi tiyɛ naxan bun.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"E tan ni i ra:","poem":1},{"lineBreak":true},{"text":"Konyin na findi mangan na,","poem":1},{"lineBreak":true},{"text":"kɔmɔn na lugo donseen na,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ɲaxalan naɲaxuxin na futu,","poem":1},{"lineBreak":true},{"text":"e nun konyi gilɛn na a kanna kɛɛn tongo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Sube naanin xurun bɔxɔn ma","poem":1},{"lineBreak":true},{"text":"koni e tan nan fekolonna sɔtɔxi:","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dondonle fanga mi na,","poem":1},{"lineBreak":true},{"text":"koni e e donseen namarama a waxatini.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fanye ra siine sɛnbɛ mi na,","poem":1},{"lineBreak":true},{"text":"koni e sodene rafalaxi gɛmɛne nin.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Manga mi tuguminne xun na,","poem":1},{"lineBreak":true},{"text":"koni e birin minima e gali yɛ ma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Dangene suxɛ nɛn yiin na,","poem":1},{"lineBreak":true},{"text":"koni e toma manga banxine kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Se saxan na naxanye rayabu,","poem":1},{"lineBreak":true},{"text":"han naanin naxanye sigati kiin tofan.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Yatana, susulaan subene tagi,","poem":1},{"lineBreak":true},{"text":"naxan mi a gima muxu yo bun,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"donton kanbaxina, hanma kɔtɔna,","poem":1},{"lineBreak":true},{"text":"e nun mangana a ganli.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Xa i bata i yɛtɛ yigbo xaxilitareyani,","poem":1},{"lineBreak":true},{"text":"xa i bata kɔtɛni tɔn,","poem":1},{"lineBreak":true},{"text":"nayi, i dɛɛn suxu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Amasɔtɔ muxun na nɔnɔn naxi,","poem":1},{"lineBreak":true},{"text":"na nan findin fɛnɛn na,","poem":1},{"lineBreak":true},{"text":"i na muxun ɲɔɛɛn din,","poem":1},{"lineBreak":true},{"text":"wunla nan minima,","poem":1},{"lineBreak":true},{"text":"i mɔn na xɔlɔn nakeli,","poem":1},{"lineBreak":true},{"text":"na raɲanma yɛngɛn nan ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}