{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"heading","content":["Manga Lemuyɛli a sandane"]},{"type":"verse","number":1,"content":["Manga Lemuyɛli a sandane. A nga a xaran waliyiya falan naxanye ma."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"n nanse falama i xa?","poem":1},{"lineBreak":true},{"text":"N nanse falama i xa,","poem":1},{"lineBreak":true},{"text":"n diin naxan barixi,","poem":1},{"lineBreak":true},{"text":"n naxan sɔtɔxi Ala barakani?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I nama i sɛnbɛ lu ɲaxanle yii.","poem":1},{"lineBreak":true},{"text":"I fangan nama ɲan ne fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"naxanye mangane ralɔma ayi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I tan Lemuyɛli,","poem":1},{"lineBreak":true},{"text":"a mi daxa mangane xa,","poem":1},{"lineBreak":true},{"text":"a mi daxa mangane yi manpaan min,","poem":1},{"lineBreak":true},{"text":"kuntigine mi lan e bira dɔlɔn fɔxɔ ra","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"alogo e minxin nama ɲinan tɔnne xɔn,","poem":1},{"lineBreak":true},{"text":"e fa muxu ɲaxankataxine yanfa kitini.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ dɔlɔn lu na muxune xa","poem":1},{"lineBreak":true},{"text":"naxanye halagima,","poem":1},{"lineBreak":true},{"text":"naxanye niin nafexi xɔlɛn na,","poem":1},{"lineBreak":true},{"text":"ɛ manpaan lu ne xa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ne na e min,","poem":1},{"lineBreak":true},{"text":"e ɲinanma e yiigelitɔyaan xɔn nɛn,","poem":1},{"lineBreak":true},{"text":"e tɔrɔyaan mi fa rabirama e ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dɛtarene xun mafala,","poem":1},{"lineBreak":true},{"text":"i muxu nɔxine birin mali e kitine yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I falan ti, i kitin sa tinxinni,","poem":1},{"lineBreak":true},{"text":"i yiigelitɔne nun tɔrɔ muxune xun mayɛngɛ kitini.","poem":1}]},{"type":"heading","content":["Ɲaxalan faɲina"]},{"type":"verse","number":10,"content":[{"text":"Nde nɔɛ ɲaxalan faɲin sɔtɛ?","poem":1},{"lineBreak":true},{"text":"A tɔnɔn dangu bɔxɔ bun nafunle ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A xɛmɛn xaxili tixi a tan nan na,","poem":1},{"lineBreak":true},{"text":"a munanfanna mi ɲanɲɛ mumɛ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A fe faɲin nan ligama a xa,","poem":1},{"lineBreak":true},{"text":"a ɲaxin mi a ra,","poem":1},{"lineBreak":true},{"text":"a siin sogen birin yi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yɛxɛɛ xabe garin nun gɛsɛ futu garin nan fenma","poem":1},{"lineBreak":true},{"text":"a e rafala dugin na sɛwani.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A faan balon na nɛn sa keli wulani","poem":1},{"lineBreak":true},{"text":"alo yulaya kunkine.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A kurunma nɛn subaxa,","poem":1},{"lineBreak":true},{"text":"a kudin so a denbayaan xa,","poem":1},{"lineBreak":true},{"text":"a fa a walikɛ ɲaxanle ti e wanle ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A na miri xɛɛna nde ma, a yi a sɔtɔ,","poem":1},{"lineBreak":true},{"text":"a nakɔɔn sa a tɔnɔ sɔtɔxine gbetin na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A wanle dɛ suxuma tunnafanna nin.","poem":1},{"lineBreak":true},{"text":"A wali a yiin na sɛnbɛni.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A a kolon a feene sɔnɔyama nɛn,","poem":1},{"lineBreak":true},{"text":"a lɛnpun mi tuma kɔɛɛn na.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A gɛsɛn wurundun a yiin na,","poem":1},{"lineBreak":true},{"text":"a gɛsɛn sɔxɔn dugin na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A yiine dɔxɔn yiigelitɔne bun.","poem":1},{"lineBreak":true},{"text":"A yiin ti tɔrɔ muxune xa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A mi gaxun xunbenla fe ra a denbayaan xa,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e birin marabɛri baxi dugi faɲin nan na.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A bitinganne rafalama,","poem":1},{"lineBreak":true},{"text":"a marabɛri baxi taa dugine nun dugi mamiloxine nan na.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A xɛmɛn yatɛxi fonne malanni,","poem":1},{"lineBreak":true},{"text":"a dɔxɔma taan fonne yɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A taa dugi domane rafalama,","poem":1},{"lineBreak":true},{"text":"a e mati,","poem":1},{"lineBreak":true},{"text":"a tagi xidine rafala yulane xa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sɛnbɛn nun binyena a ma","poem":1},{"lineBreak":true},{"text":"alo domana.","poem":1},{"lineBreak":true},{"text":"A na a miri waxati famatɔne ma,","poem":1},{"lineBreak":true},{"text":"a gele.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A falan tima fe kolonna nin,","poem":1},{"lineBreak":true},{"text":"a muxune xaran hinan falane ma.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A yengi dɔxi a denbayana feene xɔn,","poem":1},{"lineBreak":true},{"text":"a mi narin kolon.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A diine kelima nɛn,","poem":1},{"lineBreak":true},{"text":"e a fala a ma a dubadena.","poem":1},{"lineBreak":true},{"text":"A xɛmɛn fan yi keli,","poem":1},{"lineBreak":true},{"text":"a yi a tantun,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"a naxa, “Kɛwali faɲin ɲaxalan wuyaxi yi,","poem":1},{"lineBreak":true},{"text":"koni i tan, i dangu e birin na.”","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Marayabun yanfan tima,","poem":1},{"lineBreak":true},{"text":"tofanna danguma,","poem":1},{"lineBreak":true},{"text":"koni ɲaxanla naxan gaxuma Alatala yɛɛ ra","poem":1},{"lineBreak":true},{"text":"na nan lan a tantun.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ɛ saranna so a yii,","poem":1},{"lineBreak":true},{"text":"a wanle xa findi a tantun xunna ra taani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}