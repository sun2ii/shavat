{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Fe kolonna sɔtɔ fena"]},{"type":"verse","number":1,"content":[{"text":"N ma diine,","poem":1},{"lineBreak":true},{"text":"ɛ n tan fafana maxuru falane ramɛ.","poem":1},{"lineBreak":true},{"text":"Ɛ liga ɛ yeren ma","poem":1},{"lineBreak":true},{"text":"alogo ɛ xa xaxilimayaan kolonna sɔtɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N yi n ma fe kolon kɛndɛn so ɛ yii.","poem":1},{"lineBreak":true},{"text":"Ɛ nama n ma xaranna woli ayi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yi n baba konni waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n nga n nafan nɛn han alo dii kedenna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N baba yi n xaranma ikiini, a naxa,","poem":1},{"lineBreak":true},{"text":"“N ma falane ramɛ ki faɲi,","poem":1},{"lineBreak":true},{"text":"i n ma yamarine suxu, alogo i xa kisi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fekolonna nun xaxilimayaan fen,","poem":1},{"lineBreak":true},{"text":"i nama ɲinan n ma falane xɔn.","poem":1},{"lineBreak":true},{"text":"I nama ne sese xɔn beɲin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I nama fekolonna rabeɲin,","poem":1},{"lineBreak":true},{"text":"a i kantanma nɛn,","poem":1},{"lineBreak":true},{"text":"a xa rafan i ma, a i ratangama nɛn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fekolonna fɔlɔn findixi xaxili fenna nan na.","poem":1},{"lineBreak":true},{"text":"Hali i sɔtɔ seene birin fi,","poem":1},{"lineBreak":true},{"text":"alogo i xa xaxilimayaan sɔtɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fekolonna ramara,","poem":1},{"lineBreak":true},{"text":"a i findima nɛn muxu gbeen na,","poem":1},{"lineBreak":true},{"text":"i yii firinna dɔxɔ a bun,","poem":1},{"lineBreak":true},{"text":"a binyen fima i ma nɛn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A luma nɛn","poem":1},{"lineBreak":true},{"text":"alo i xunna na maxidi hinanna ra,","poem":1},{"lineBreak":true},{"text":"alo manga kɔmɔti mayilenxin na so i xun na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I tuli mati n ma diina,","poem":1},{"lineBreak":true},{"text":"i tin n ma falan ma,","poem":1},{"lineBreak":true},{"text":"i ɲɛɛ wuyaxi sɔtɔma nɛn i ya siimayaan na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N bata i xaran fe kolonna kiraan ma,","poem":1},{"lineBreak":true},{"text":"n na i matinxinma sigati ki tinxinxin ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nayi, i sanna mi raxidɛ siga tideni,","poem":1},{"lineBreak":true},{"text":"i mi birɛ i gideni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I xurun naxan sɔtɔxi,","poem":1},{"lineBreak":true},{"text":"na ramara,","poem":1},{"lineBreak":true},{"text":"kankan a ma","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i ya siimayaan binla na a ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I nama ti muxu ɲaxine kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"i nama bira fe ɲaxi rabane fɔxɔ ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I masiga e kiraan na.","poem":1},{"lineBreak":true},{"text":"I nama dangu a xɔn.","poem":1},{"lineBreak":true},{"text":"A matanga,","poem":1},{"lineBreak":true},{"text":"i dangu yire gbɛtɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Muxu ɲaxin mi nɔɛ xiyɛ,","poem":1},{"lineBreak":true},{"text":"xa a mi fe ɲaxin liga.","poem":1},{"lineBreak":true},{"text":"Xixɔnla a gima e ma nɛn,","poem":1},{"lineBreak":true},{"text":"xa e munma muxun nabira.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amasɔtɔ e baloma fe ɲaxin nan na,","poem":1},{"lineBreak":true},{"text":"gbalon nafan e ma","poem":1},{"lineBreak":true},{"text":"alo e na dɔlɔn min.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tinxin muxune sigati kiin fixa","poem":1},{"lineBreak":true},{"text":"alo kuye yi yalanna subaxani,","poem":1},{"lineBreak":true},{"text":"kɛnɛnna naxan sigan minɛ","poem":1},{"lineBreak":true},{"text":"han yanyin yi dɛfe.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Koni muxu ɲaxine sigati kiin findixi dimin nan na.","poem":1},{"lineBreak":true},{"text":"E mi na seen toma","poem":1},{"lineBreak":true},{"text":"naxan e rabirɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"N ma diina,","poem":1},{"lineBreak":true},{"text":"n ma falane fe liga i yeren ma","poem":1},{"lineBreak":true},{"text":"i yi i tuli mati n xuiin na.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I nama ɲinan e xɔn,","poem":1},{"lineBreak":true},{"text":"koni e ramara i bɔɲɛni.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Naxanye birin e sɔtɔma","poem":1},{"lineBreak":true},{"text":"e siimayaan nun kɛndɛyaan nan fima ne ma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"I bɔɲɛn suxu dangu seen birin na,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ siimayaan binla nan na ra.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"I dɛɛn natanga wulen ma,","poem":1},{"lineBreak":true},{"text":"i dɛɛn nama yanfa falane ti.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"I yɛɛn xa lu tixi i yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"i matoon ti tinxinni i yɛtagi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I dangu kirani tɔn, a yɛlan,","poem":1},{"lineBreak":true},{"text":"i xa siga kira kɛndɛne nan tun xɔn.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"I nama kiraan fata yiifanna ma","poem":1},{"lineBreak":true},{"text":"hanma kɔmɛnna ma.","poem":1},{"lineBreak":true},{"text":"I masiga fe ɲaxin na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}