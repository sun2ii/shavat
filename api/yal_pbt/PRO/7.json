{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Marakolonna lan ɲaxalan yalunxina fe ma"]},{"type":"verse","number":1,"content":[{"text":"N ma diina, n ma falane suxu.","poem":1},{"lineBreak":true},{"text":"I n ma yamarine suxu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ma yamarine suxu","poem":1},{"lineBreak":true},{"text":"alogo i xa kisi.","poem":1},{"lineBreak":true},{"text":"N ma xaranne mara i bɔɲɛni","poem":1},{"lineBreak":true},{"text":"alo i yɛ kɛsɛne makantanma kii naxan yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E xidi i yiin na,","poem":1},{"lineBreak":true},{"text":"i yi e sa i bɔɲɛni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fe kolonna suxu alo i magilɛna,","poem":1},{"lineBreak":true},{"text":"xaxilimayana alo i kon kaana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E i ratangama nɛn yalunde ɲaxanla ma,","poem":1},{"lineBreak":true},{"text":"e nun muxu gbɛtɛna ɲaxanla marakunfa falane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lɔxɔna nde,","poem":1},{"lineBreak":true},{"text":"n yi tixi n ma banxi foye soden na","poem":1},{"lineBreak":true},{"text":"n yi tanden matoma,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"n foninge keden nakɔrɔsi banxulan fe kolontarene yɛ.","poem":1},{"lineBreak":true},{"text":"Xaxili mi yi na banxulanna ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A yi danguma kiraan xɔn,","poem":1},{"lineBreak":true},{"text":"dɛnaxan maso ɲaxanla nde konna kira fataden na","poem":1},{"lineBreak":true},{"text":"a yi danguma a banxin mabinni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sogen godomatɔɔn nan yi a ra,","poem":1},{"lineBreak":true},{"text":"kɔɛna a li waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"dimin yi so.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ɲaxanla yi mini a ralandeni,","poem":1},{"lineBreak":true},{"text":"a maxidixi alo yalundena,","poem":1},{"lineBreak":true},{"text":"kɔtɛ ɲaxin yi a bɔɲɛni.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xurutaren nan yi a ra","poem":1},{"lineBreak":true},{"text":"naxan mi yagima,","poem":1},{"lineBreak":true},{"text":"a mi luyɛ a konni mumɛ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Waxatina nde, a sa kirane xɔn","poem":1},{"lineBreak":true},{"text":"waxati gbɛtɛ a sa yama malandene yi,","poem":1},{"lineBreak":true},{"text":"a dɔxi xɛmɛne yɛɛ ra kira xunne birin na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yi na banxulanna suxu,","poem":1},{"lineBreak":true},{"text":"a yi a sunbu.","poem":1},{"lineBreak":true},{"text":"A yi a fala a xa a yɛɛni yalanxin na, a naxa,","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“N bata yi dɛ xuiin tongo","poem":1},{"lineBreak":true},{"text":"n xa bɔɲɛ xunbeli saraxan ba Ala xa.","poem":1},{"lineBreak":true},{"text":"To n bata a ba, na suben sa banxini.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nanara, n bata mini i ralandeni.","poem":1},{"lineBreak":true},{"text":"N yi i tan nan fenma,","poem":1},{"lineBreak":true},{"text":"anu n bata i to!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N bata n ma sadeni tɔn bitingan faɲine ra,","poem":1},{"lineBreak":true},{"text":"Misiran yamanan taa dugine.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N bata mirihi latikɔnɔnna sa a ma,","poem":1},{"lineBreak":true},{"text":"e nun wudi ige xiri ɲaxumɛn","poem":1},{"lineBreak":true},{"text":"nun sinamon wudi ige xiri ɲaxumɛna.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Fa be, en fa kafu han xɔtɔnni,","poem":1},{"lineBreak":true},{"text":"en lu marafanna ɲaxunni!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N ma xɛmɛn mi banxini,","poem":1},{"lineBreak":true},{"text":"a bata siga yire makuyeni sigatini.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A bata a gbeti saseen xali,","poem":1},{"lineBreak":true},{"text":"a rafexi,","poem":1},{"lineBreak":true},{"text":"a mi fama fɔ kiken na kɔxɔ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"A to fatan falan tiyɛ,","poem":1},{"lineBreak":true},{"text":"a yi a mabandun,","poem":1},{"lineBreak":true},{"text":"a yi a rakunfa","poem":1},{"lineBreak":true},{"text":"a fala ɲaxumɛne xɔn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sanɲa ma kedenni,","poem":1},{"lineBreak":true},{"text":"a yi bira a fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"alo ɲingen naxan sigama a kɔɛ raxabadeni,","poem":1},{"lineBreak":true},{"text":"alo daxun naxan xidima","poem":1},{"lineBreak":true},{"text":"alogo a xa xuru,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"han xalimakunla yi a bɔɲɛn sɔxɔn,","poem":1},{"lineBreak":true},{"text":"alo xɔliin naxan so luti ratixin na,","poem":1},{"lineBreak":true},{"text":"a mi a kolon a niin nan bama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Nanara, n ma diine,","poem":1},{"lineBreak":true},{"text":"ɛ tuli mati,","poem":1},{"lineBreak":true},{"text":"ɛ n ma fala xuine fe liga ɛ yeren ma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ɛ bɔɲɛn nama mayenden","poem":1},{"lineBreak":true},{"text":"ɛ bira na ɲaxalan sifan fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"ɛ lɔ ayi a kirane xɔn.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A bata muxu wuyaxi rabira.","poem":1},{"lineBreak":true},{"text":"A bata xɛmɛn yatɛn naxanye faxa,","poem":1},{"lineBreak":true},{"text":"ne nun gali sɛnbɛmaan xasabin lan.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A banxin findixi gaburun kira yisoxin nan na","poem":1},{"lineBreak":true},{"text":"siga laxira yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}