{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PRO","translationId":"yal_pbt","name":"Sandane Sora","commonName":"Sandane Sora","title":"Sandane Muluku Sulemani a Sandane","order":20,"numberOfChapters":31,"sha256":"0fd51edad439495accb25e0fd4af82a10449e1644be63c68f4431a22e83cddea","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/yal_pbt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Xaxilimayaan xinla tima alo muxuna"]},{"type":"verse","number":1,"content":[{"text":"Fe kolonna","poem":1},{"noteId":6},{"text":"bata sɛnbɛtɛn solofere masoli,","poem":1},{"lineBreak":true},{"text":"a banxin ti alo muxuna.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A bata suben ɲin,","poem":1},{"lineBreak":true},{"text":"a minseen nafala,","poem":1},{"lineBreak":true},{"text":"a donseene dɔxɔ tabanla ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A bata a walikɛ ɲaxanle rasiga","poem":1},{"lineBreak":true},{"text":"e xa sa a xili xuini ito rawanga taan yire matexini, e naxa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“Ɛ tan fe kolontarene,","poem":1},{"lineBreak":true},{"text":"ɛ fa dangu be binni.”","poem":1},{"lineBreak":true},{"text":"Xaxili mi naxanye ma,","poem":1},{"lineBreak":true},{"text":"a falani ito ti ne ma, a naxa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Ɛ fa n ma donseene don,","poem":1},{"lineBreak":true},{"text":"ɛ n ma minseen min n naxan nafalaxi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ xɛtɛ ɛ fe kolontareyaan fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"ɛ kisima nɛn,","poem":1},{"lineBreak":true},{"text":"nayi ɛ ti xaxilimayaan kiraan xɔn.”","poem":1}]},{"type":"heading","content":["Xaxilimaan nun wasodena"]},{"type":"verse","number":7,"content":[{"text":"Naxan na magele tiin maxadi,","poem":1},{"lineBreak":true},{"text":"na konbin nan sɔtɔma.","poem":1},{"lineBreak":true},{"text":"Naxan na muxu ɲaxin sɔnna fala a xa,","poem":1},{"lineBreak":true},{"text":"na tɔrɔma nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I nama magele tiin sɔnna fala","poem":1},{"lineBreak":true},{"text":"alogo a nama i raɲaxu,","poem":1},{"lineBreak":true},{"text":"koni i na fe kolonna sɔnna fala a xa,","poem":1},{"lineBreak":true},{"text":"a i xanuma nɛn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I na fe kolonna maxadi,","poem":1},{"lineBreak":true},{"text":"na nde sama nɛn a fe kolonna fari.","poem":1},{"lineBreak":true},{"text":"I na tinxin muxun xaran,","poem":1},{"lineBreak":true},{"text":"na a fekolonna nan xun masama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fe kolonna fɔlɔma Alatala yɛɛragaxun nan ma.","poem":1},{"lineBreak":true},{"text":"Muxu sariɲanxine fe kolonna findixi xaxilimayaan nan na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N tan fe kolonna,","poem":1},{"lineBreak":true},{"text":"n na i siin sogene rawuyama ayi nɛn,","poem":1},{"lineBreak":true},{"text":"n yi ɲɛɛna ndee sa i ya siimayaan fari.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xa i findi fe kolonna ra,","poem":1},{"lineBreak":true},{"text":"i tan nan a saranna sɔtɔma.","poem":1},{"lineBreak":true},{"text":"Xa i findi magele tiin na,","poem":1},{"lineBreak":true},{"text":"i tan nan tɔrɔ sɔtɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xaxilitareyaan luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo ɲaxanla naxan sɔnxɔma.","poem":1},{"lineBreak":true},{"text":"Xurutaren na a ra","poem":1},{"lineBreak":true},{"text":"naxan mi sese kolon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A dɔxi a banxin dɛ ra,","poem":1},{"lineBreak":true},{"text":"taan yire matexini.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A lu dangu muxune xilɛ mɛnni","poem":1},{"lineBreak":true},{"text":"naxanye sigama e yɛɛ ra tinxinni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A naxa, “Ɛ tan fe kolontarene,","poem":1},{"lineBreak":true},{"text":"ɛ dangu be binni.”","poem":1},{"lineBreak":true},{"text":"Xaxili mi naxanye ma,","poem":1},{"lineBreak":true},{"text":"a ne nan xilima.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A naxa, “Minseen naxan muɲaxi","poem":1},{"lineBreak":true},{"text":"na nan ɲaxun,","poem":1},{"lineBreak":true},{"text":"donseen naxan donxi luxunni","poem":1},{"lineBreak":true},{"text":"na nan ɲaxun.”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E mi a kolon a faxa muxune nan mɛnni,","poem":1},{"lineBreak":true},{"text":"a na ɲaxanla a muxu xilixine sigan laxirani.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"9.1fe kolonna:Falani ito kui, fe kolonna bata findi muxun na a yamaan kawandi.","reference":{"chapter":9,"verse":1}}]},"thisChapterLink":"/api/yal_pbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}