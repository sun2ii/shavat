{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":1,"content":[{"type":"heading","content":["Kira firinna"]},{"type":"verse","number":1,"content":[{"text":"Sɛwan na kanna xa,","poem":1},{"lineBreak":true},{"text":"naxan mi muxu ɲaxine maxadi xuine suxuma,","poem":1},{"lineBreak":true},{"text":"naxan mi birama yulubitɔne kiraan fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"naxan mi a sama magele tiine fari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na kanna sɛwama nɛn","poem":1},{"lineBreak":true},{"text":"Alatalaa sariyan suxudeni,","poem":1},{"lineBreak":true},{"text":"a a xaxili lu Alaa sariyan xɔn kɔɛɛn nun yanyin na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A sabatima nɛn","poem":1},{"lineBreak":true},{"text":"alo wudi binla naxan xude dɛni,","poem":1},{"lineBreak":true},{"text":"a bogima nɛn a waxatini,","poem":1},{"lineBreak":true},{"text":"a dɛɛne mi xarɛ.","poem":1},{"lineBreak":true},{"text":"Na kanna na fefe suxu,","poem":1},{"lineBreak":true},{"text":"a sɔnɔyama nɛn a xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Koni muxu ɲaxine mi na kiini mumɛ,","poem":1},{"lineBreak":true},{"text":"e luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo foyen se dagin naxan xalima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nanara, muxu ɲaxine yalagima nɛn kiti sa waxatini,","poem":1},{"lineBreak":true},{"text":"yulubitɔne mi tiyɛ tinxin muxune yɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala a ɲɔxɔ luma nɛn tinxin muxune xɔn,","poem":1},{"lineBreak":true},{"text":"koni muxu ɲaxine kiraan sigama gbalon nin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}