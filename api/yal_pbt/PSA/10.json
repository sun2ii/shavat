{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":10,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Alatala, nanfera i makuyaxi nxu ra?","poem":1},{"lineBreak":true},{"text":"I luxunma nxu ma tɔrɔ waxatine yi nanfera?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muxu ɲaxine bata waso ayi,","poem":1},{"lineBreak":true},{"text":"e mɔn yiigelitɔne bɛsɛnxɔnyama.","poem":1},{"lineBreak":true},{"text":"A e suxu a kɔtɛne ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kanbama a nata ɲaxine yi.","poem":1},{"lineBreak":true},{"text":"Kumadena Alatala raɲaxuma,","poem":1},{"lineBreak":true},{"text":"a a mɛ a ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Muxu ɲaxina a falama dɛ ɲaxun na, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ala mi muxe yulubine saranma e ra!","poem":1},{"lineBreak":true},{"text":"Ala mi na!”","poem":1},{"lineBreak":true},{"text":"A a miriyaan birin nan na ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A feen birin nasɔnɔyama.","poem":1},{"lineBreak":true},{"text":"A mi i ya kitine suxuma,","poem":1},{"lineBreak":true},{"text":"a mɔn yoma a yaxune ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A a falama a yɛtɛ ma, a naxa,","poem":1},{"lineBreak":true},{"text":"“N mi fulɛ mumɛ,","poem":1},{"lineBreak":true},{"text":"n mi luyɛ tɔrɔni mumɛ!”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A dɛɛn nafexi dangane nun wulene","poem":1},{"lineBreak":true},{"text":"nun fala xui xɔlɛne nan na.","poem":1},{"lineBreak":true},{"text":"A fe ɲaxin nun tɔrɔ feen nan tun falama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A a luxunma banxidɛne ra,","poem":1},{"lineBreak":true},{"text":"a sɔntarene legedenma e faxa feen na.","poem":1},{"lineBreak":true},{"text":"A yɛɛ masama fangatarene ma wundoni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A legedenna tima a luxundeni","poem":1},{"lineBreak":true},{"text":"alo yatana.","poem":1},{"lineBreak":true},{"text":"A saxi, a yiigelitɔne legedenma,","poem":1},{"lineBreak":true},{"text":"a e suxu a lutin na,","poem":1},{"lineBreak":true},{"text":"a e bubu, a e xali.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fangatarene e felenma e bira,","poem":1},{"lineBreak":true},{"text":"e lu a nɔɔn bun ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A yi a fala a yɛtɛ ma, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ala a fe mi a yi!","poem":1},{"lineBreak":true},{"text":"A bata a yɛɛne raxi. A mi n toɛ!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alatala, keli! I fangan mayita, Ala!","poem":1},{"lineBreak":true},{"text":"I nama ɲinan yiigelitɔne ma!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanfera muxu ɲaxina Ala raɲaxuma,","poem":1},{"lineBreak":true},{"text":"a yi a fala a yɛtɛ ma, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ala mi n ɲaxankatɛ?”","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Koni i tan Ala,","poem":1},{"lineBreak":true},{"text":"i tɔrɔn nun sɔxɔlɛn toma yati!","poem":1},{"lineBreak":true},{"text":"I xaxili luma nɛn ne xɔn ma mali xinla ma.","poem":1},{"lineBreak":true},{"text":"Fangatarene bata e yɛtɛ taxu i tan na.","poem":1},{"lineBreak":true},{"text":"Kiridi mali tiin nan i tan na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Muxu ɲaxin fangan kala,","poem":1},{"lineBreak":true},{"text":"i yi a ɲaxankata a fe ɲaxine fe ra","poem":1},{"lineBreak":true},{"text":"han i yi a raxɔri.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Alatala nan mangan na habadan.","poem":1},{"lineBreak":true},{"text":"Suxure batune raxɔrima nɛn a bɔxɔn ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala, i yiigelitɔne maxandi xuiin mɛma nɛn,","poem":1},{"lineBreak":true},{"text":"i yi e bɔɲɛn sɛnbɛ so.","poem":1},{"lineBreak":true},{"text":"I yi e wuga xuiin namɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I xa sariya kɛndɛn sa kiridine xa","poem":1},{"lineBreak":true},{"text":"e nun muxu ɲaxankataxine.","poem":1},{"lineBreak":true},{"text":"Nanara, daɲɔxɔn mi fa magaxun tiyɛ sɔnɔn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}