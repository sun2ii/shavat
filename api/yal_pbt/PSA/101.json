{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":101,"content":[{"type":"heading","content":["Mangana dɛ xui tongona Ala xa"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"N bɛtini ito bama","poem":1},{"lineBreak":true},{"text":"i ya hinanna nun i ya sariya kɛndɛn nan ma fe ra.","poem":1},{"lineBreak":true},{"text":"Alatala, n tantun bɛtin bama i tan nan xa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N katama nɛn","poem":1},{"lineBreak":true},{"text":"n xa lu kira kamalixin xɔn.","poem":1},{"lineBreak":true},{"text":"I fama n fɛma waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"N sigan ti tinxinni n ma banxini.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N mi tinɲɛ fe ɲaxin ma mumɛ!","poem":1},{"lineBreak":true},{"text":"N dɛnkɛlɛyatarene kɛwanle raɲaxuma nɛn.","poem":1},{"lineBreak":true},{"text":"Nxu mi sese malanɲɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N mi findɛ tinxintaren na.","poem":1},{"lineBreak":true},{"text":"N mi fe ɲaxi yo rabɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naxanye muxune mafalan wundoni,","poem":1},{"lineBreak":true},{"text":"n ne dɛɛn suxuma nɛn.","poem":1},{"lineBreak":true},{"text":"Naxanye muxune matoma a ɲaxin na wasoni,","poem":1},{"lineBreak":true},{"text":"n mi diɲɛ ne ma mumɛ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na n yɛɛn tima nɛn muxu tɔgɔndiyaxine ra yamanani,","poem":1},{"lineBreak":true},{"text":"alogo e xa lu n fɛma.","poem":1},{"lineBreak":true},{"text":"Naxan na sigan ti tinxinni,","poem":1},{"lineBreak":true},{"text":"na luma nɛn n ma wanla ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yanfanten yo mi luyɛ n konni.","poem":1},{"lineBreak":true},{"text":"Wule fala yo mi luyɛ n yɛtagi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xɔtɔn yo xɔtɔn","poem":1},{"lineBreak":true},{"text":"n muxu ɲaxine bama nɛn yamanani,","poem":1},{"lineBreak":true},{"text":"n fe ɲaxi rabane birin kedima nɛn Alatalaa taani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}