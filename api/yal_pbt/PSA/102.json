{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":102,"content":[{"type":"heading","content":["Tɔrɔ muxuna Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Tɔrɔ muxuna Ala maxandina sɔxɔlɛni, a a mawuga Alatala xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i tuli mati n ma maxandin na.","poem":1},{"lineBreak":true},{"text":"I n ma mawuga xuiin namɛ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I nama i yɛtagin luxun n ma","poem":1},{"lineBreak":true},{"text":"n nɛma tɔrɔni waxatin naxan yi!","poem":1},{"lineBreak":true},{"text":"I tuli mati n na.","poem":1},{"lineBreak":true},{"text":"N na i xili,","poem":1},{"lineBreak":true},{"text":"n yabi mafurɛn!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amasɔtɔ, n siin ɲanmatɔɔn ni i ra","poem":1},{"lineBreak":true},{"text":"alo tutina.","poem":1},{"lineBreak":true},{"text":"N fatin ganma alo tɛɛ wolonna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N bɔɲɛn xaraxi alo sɛxɛna.","poem":1},{"lineBreak":true},{"text":"Donse xɔli mi fa n na sɔnɔn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kutunna bata n doyen.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bata liga","poem":1},{"lineBreak":true},{"text":"alo toxorona tonbonni,","poem":1},{"lineBreak":true},{"text":"alo kutunxunban taa xɔnni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N mi xima.","poem":1},{"lineBreak":true},{"text":"N bata lu yɛɛ radunduni","poem":1},{"lineBreak":true},{"text":"alo xɔliin banxin fari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N yaxune n konbima fɛriɲɛn gbɛn,","poem":1},{"lineBreak":true},{"text":"e fala xɔlɛn ti n ma,","poem":1},{"lineBreak":true},{"text":"e n xinla findi danga ti seen na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N xube fuɲin nan donma.","poem":1},{"lineBreak":true},{"text":"N yɛɛgen bata basan n min igen na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amasɔtɔ i ya xɔlɔna fe ra,","poem":1},{"lineBreak":true},{"text":"i bata n tongo i yi n woli ayi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N siin ɲanmatɔɔn ni i ra","poem":1},{"lineBreak":true},{"text":"alo nininna ɲinbanna ra.","poem":1},{"lineBreak":true},{"text":"N bata liga alo sɛxɛ xarena.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Koni Alatala,","poem":1},{"lineBreak":true},{"text":"i tan nan mangan na habadan!","poem":1},{"lineBreak":true},{"text":"Mayixɛtɛne nun mayixɛtɛne i ya fe falama nɛn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I kelima nɛn i kininkinin Siyon taan ma.","poem":1},{"lineBreak":true},{"text":"I diɲa waxatin bata a li a ma.","poem":1},{"lineBreak":true},{"text":"Waxati saxi yɛtɛɛn ni ito ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hali taani ito gɛmɛne rafan nxu tan i ya walikɛne ma.","poem":1},{"lineBreak":true},{"text":"A gbangbanna yɛtɛɛn kininkininna nxu ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Siyane birin gaxuma Alatala yɛɛ ra nɛn.","poem":1},{"lineBreak":true},{"text":"Dunuɲa mangane birin yi gaxu i ya binyen yɛɛ ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala mɔn na Siyon ti waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"a yi a yɛtɛ makɛnɛn a binyeni.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A a yɛɛ ra findi muxu ramɛxine ma,","poem":1},{"lineBreak":true},{"text":"a yi a tuli mati e maxandi xuiin na.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Na xa sɛbɛ mayixɛtɛ famatɔne xa,","poem":1},{"lineBreak":true},{"text":"alogo yama famatɔɔn xa Alatala matɔxɔ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatala bata a yɛɛ ragodo","poem":1},{"lineBreak":true},{"text":"keli a yire sariɲanxini kore xɔnna ma.","poem":1},{"lineBreak":true},{"text":"A bata a yɛɛ ragodo dunuɲa ma","poem":1},{"lineBreak":true},{"text":"keli ariyanna yi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Muxun naxanye kasoon na","poem":1},{"lineBreak":true},{"text":"a bata ne kutun xuine mɛ.","poem":1},{"lineBreak":true},{"text":"A bata na muxu yalagixine xɔrɔya,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"alogo e xa Alatala xinla fala Siyon yi,","poem":1},{"lineBreak":true},{"text":"e yi a tantun Yerusalɛn taani,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"siyane nun yamanane birin na e malan waxatin naxan yi Alatala batudeni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Marigin bata n sɛnbɛn ɲan n ma siimayani,","poem":1},{"lineBreak":true},{"text":"a yi n siin ɲan.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“N ma Ala, i nama n faxa.","poem":1},{"lineBreak":true},{"text":"N munma fori. I tan luma nɛn habadan!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"I bɔxɔ xɔnna da nɛn,","poem":1},{"lineBreak":true},{"text":"xabu a fɔlɔni.","poem":1},{"lineBreak":true},{"text":"I yii fɔxɔn nan kore xɔnna ra.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ne birin danguma nɛn,","poem":1},{"lineBreak":true},{"text":"koni i tan luma nɛn na.","poem":1},{"lineBreak":true},{"text":"Ne birin forima nɛn,","poem":1},{"lineBreak":true},{"text":"e kala alo dugina,","poem":1},{"lineBreak":true},{"text":"i yi e masara.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Koni i tan luma nɛn i kiini waxatin birin.","poem":1},{"lineBreak":true},{"text":"I ya siimayaan mi ɲanɲɛ mumɛ!","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nxu tan i ya walikɛne diine luma nɛn i fɛma,","poem":1},{"lineBreak":true},{"text":"e yixɛtɛne fan yi sabati i yɛtagi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":29}