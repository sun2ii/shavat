{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":103,"content":[{"type":"heading","content":["Alaa hinanna"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"N xa Alatala tantun n niin birin na!","poem":1},{"lineBreak":true},{"text":"N xa a xili sariɲanxin tantun n bɔɲɛn ma feu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N xa Alatala tantun n niin birin na!","poem":1},{"lineBreak":true},{"text":"N nama ɲinan a wali faɲi yo xɔn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A tan nan n mafeluma n hakɛn birin na.","poem":1},{"lineBreak":true},{"text":"A tan nan n nakɛndɛyama furen birin ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A tan nan n natangama sayaan ma,","poem":1},{"lineBreak":true},{"text":"a yi n nakamali hinanna nun kininkininni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A tan nan siimaya faɲin fima n ma,","poem":1},{"lineBreak":true},{"text":"alogo n mɔn xa fangan sɔtɔ","poem":1},{"lineBreak":true},{"text":"alo singbinna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alatala tinxin,","poem":1},{"lineBreak":true},{"text":"a tan nan kiti kɛndɛn sama muxu ɲaxankataxine xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A bata a feene yita Nabi Musa ra,","poem":1},{"lineBreak":true},{"text":"a yi a kɛwanle yita Isirayila yamaan na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala kininkinin, a diɲa.","poem":1},{"lineBreak":true},{"text":"A mi xɔlɔn xulɛn. A hinanna gbo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A xɔlɔxin mi en mafalɛ yɛyɛ!","poem":1},{"lineBreak":true},{"text":"A mi luyɛ xɔlɔxi han habadan!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A mi en suxuma en yulubine ra.","poem":1},{"lineBreak":true},{"text":"A mi en saranma en hakɛne ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"A hinanna gbo a yɛɛragaxu muxune yɛɛ ra yi,","poem":1},{"lineBreak":true},{"text":"alo kore xɔnna makuya bɔxɔ xɔnna ra kii naxan yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A bata en yulubine ba en ma,","poem":1},{"lineBreak":true},{"text":"a yi e makuya en na","poem":1},{"lineBreak":true},{"text":"alo sogeteden nun sogegododen tagi kuya kii naxan yi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala kininkininma a yɛɛragaxu muxune ma nɛn","poem":1},{"lineBreak":true},{"text":"alo fafan kininkininma a diine ma kii naxan yi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A en da kiin kolon,","poem":1},{"lineBreak":true},{"text":"a kolon fa fala en kelixi bɛndɛn nin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Muxuna siimayaan luxi nɛn alo sɛxɛna,","poem":1},{"lineBreak":true},{"text":"a sabatima nɛn alo sɛxɛ fugena,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"koni foye wolonna na sa a ma a xara ayi,","poem":1},{"lineBreak":true},{"text":"a yi ɲan hali a funfuna,","poem":1},{"lineBreak":true},{"text":"a mi luma na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Koni Alatalaa hinanna luma nɛn","poem":1},{"lineBreak":true},{"text":"a yɛɛragaxu muxune xa habadan han habadan.","poem":1},{"lineBreak":true},{"text":"A tinxinna yi lu e diine diine xa,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"xa e a layirin suxu,","poem":1},{"lineBreak":true},{"text":"e yi e miri a fe ragidixine ma","poem":1},{"lineBreak":true},{"text":"alogo e xa e rakamali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Alatala bata a mangaya gbɛdɛn nafala kore xɔnna ma.","poem":1},{"lineBreak":true},{"text":"A tan nan mangayani seene birin xunna.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ɛ Alatala tantun, ɛ tan malekane.","poem":1},{"lineBreak":true},{"text":"Ɛ tan naxanye sɛnbɛ kanne ra,","poem":1},{"lineBreak":true},{"text":"naxanye a falane ligama,","poem":1},{"lineBreak":true},{"text":"naxanye a fala xuine suxuma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɛ Alatala tantun,","poem":1},{"lineBreak":true},{"text":"ɛ tan a ganle kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"ɛ tan, a walikɛɛn naxanye a sagoon ligama.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ɛ Alatala tantun,","poem":1},{"lineBreak":true},{"text":"ɛ tan a dali seene birin,","poem":1},{"lineBreak":true},{"text":"ɛ na lu dɛdɛ a mangayaan bun.","poem":1},{"lineBreak":true},{"text":"N xa Alatala tantun n niin birin na!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}