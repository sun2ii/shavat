{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":108,"content":[{"type":"heading","content":["Ala maxandina malina fe ra lan yaxune fe ma"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina. Sigi sariɲanxina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, n ma binyena,","poem":1},{"lineBreak":true},{"text":"n xaxili ragidixi yati!","poem":1},{"lineBreak":true},{"text":"N bɛtin bama nɛn, n yi i tantun!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N xulunma nɛn sinma,","poem":1},{"lineBreak":true},{"text":"n yi n ma bɔlɔnna nun kondenna maxa!","poem":1},{"lineBreak":true},{"text":"N kurunma bɛtin bɛ nɛn subaxa!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala, n ni i tantunma nɛn siyane yɛ.","poem":1},{"lineBreak":true},{"text":"N bɛtin bama i xa nɛn bɔnsɔnne tagi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I ya hinanna gbo han ariyanna.","poem":1},{"lineBreak":true},{"text":"I ya lannayaan texi han kore xɔnna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala,","poem":1},{"lineBreak":true},{"text":"i ya binyen xa mayita kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"a yi bɔxɔn nafe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I xanuntenne xunba,","poem":1},{"lineBreak":true},{"text":"i yi e rakisi i sɛnbɛni.","poem":1},{"lineBreak":true},{"text":"I yi n yabi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala bata falan ti a yire sariɲanxini,","poem":1},{"lineBreak":true},{"text":"a naxa, “N nɔɔn tima nɛn,","poem":1},{"lineBreak":true},{"text":"n Siken taani taxun,","poem":1},{"lineBreak":true},{"text":"n yi Sukɔti lanbanna danne sa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N tan nan gbee Galadi bɔxɔn nun Manase ra.","poem":1},{"lineBreak":true},{"text":"Efirami kaane findixi n ma yɛngɛsone nan na.","poem":1},{"lineBreak":true},{"text":"Yuda luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo n ma mangaya dunganna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni n ma konyin nan Moyaba yamanan na.","poem":1},{"lineBreak":true},{"text":"N tan nan Edɔn yamanan kanna ra.","poem":1},{"lineBreak":true},{"text":"N yɛngɛ sɔnxɔni tema Filisiti yamanani.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ala, nde sigama n na na taa makantanxini?","poem":1},{"lineBreak":true},{"text":"Nde tima n yɛɛ ra siga Edɔn yi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala, i tan xa mi i mɛxi nxu ra ba?","poem":1},{"lineBreak":true},{"text":"I mi fa nxɔ ganla fɔxɔ ra sɔnɔn ba?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nxu mali yaxune yɛngɛdeni!","poem":1},{"lineBreak":true},{"text":"Sese mi adamana maliin na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Koni Ala na lu en xɔn,","poem":1},{"lineBreak":true},{"text":"en nɔɔn sɔtɔma nɛn.","poem":1},{"lineBreak":true},{"text":"A tan nan en yaxune halagima.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}