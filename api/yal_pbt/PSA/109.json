{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":109,"content":[{"type":"heading","content":["Tɔrɔ muxuna mawugana"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true},{"text":"Ala, n naxan tantunma, i nama lu dunduxi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amasɔtɔ muxu ɲaxine nun wuledene n mafalama.","poem":1},{"lineBreak":true},{"text":"E wulene sama n xun ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E mɔn fala ɲaxine tima lan n ma.","poem":1},{"lineBreak":true},{"text":"E n yɛngɛma na kiini fuu!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N tan e xanuxi,","poem":1},{"lineBreak":true},{"text":"e tan n tɔɲɛgɛma.","poem":1},{"lineBreak":true},{"text":"Koni n tan Ala maxandima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E n ma fe faɲin saranma fe ɲaxin na,","poem":1},{"lineBreak":true},{"text":"e n ma xanuntenyaan saran xɔnnantenyaan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E a falama n ma e naxa,","poem":1},{"lineBreak":true},{"text":"“Gbalo feen xa sa a xun ma,","poem":1},{"lineBreak":true},{"text":"muxuna nde yi a tɔɲɛgɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A na makiti, a yi yalagi.","poem":1},{"lineBreak":true},{"text":"A Ala maxandi xuine yi yatɛ hakɛn na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala xa a siin ɲan mafurɛn,","poem":1},{"lineBreak":true},{"text":"muxu gbɛtɛ yi a tiden tongo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala xa a diine findi kiridine ra,","poem":1},{"lineBreak":true},{"text":"a ɲaxanla yi findi kaɲa gilɛn na!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala xa a diine findi sigatine nun xandi tiine ra,","poem":1},{"lineBreak":true},{"text":"e yi makuya e banxi xɔnne ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala xa a doli faan siga a yii seene birin na,","poem":1},{"lineBreak":true},{"text":"xɔɲɛne yi a wali xɔnne birin tongo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala xa muxe nama fa hinan a ra sɔnɔn,","poem":1},{"lineBreak":true},{"text":"hanma muxe yi e yengi dɔxɔ a kiridine xɔn ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ala xa a yixɛtɛne birin halagi,","poem":1},{"lineBreak":true},{"text":"e xinle yi lɔ ayi habadan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala xa a xaxili lu a benbane hakɛne xɔn ma.","poem":1},{"lineBreak":true},{"text":"Alatala nama a nga yulubine xafari mumɛ!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alatala xa a yengi lu e hakɛne xɔn ma waxatin birin,","poem":1},{"lineBreak":true},{"text":"koni Ala xa ɲinan xa ti e fe xɔn ma fefe!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bayo xɛmɛni ito mi findixi hinanten na","poem":1},{"lineBreak":true},{"text":"a yi yiigelitɔne nun tɔrɔ muxune ɲaxankatama,","poem":1},{"lineBreak":true},{"text":"han a yi muxu sunuxin faxa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Danga tiin yi rafan a ma,","poem":1},{"lineBreak":true},{"text":"Ala xa ne raxɛtɛ a ma.","poem":1},{"lineBreak":true},{"text":"A mi yi rafan a ma","poem":1},{"lineBreak":true},{"text":"a xa duba muxe xa,","poem":1},{"lineBreak":true},{"text":"Ala xa duban masiga a ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A yi rabilinxi a danga xuine ra","poem":1},{"lineBreak":true},{"text":"alo a dugina.","poem":1},{"lineBreak":true},{"text":"Ala xa a gbee dangana a li","poem":1},{"lineBreak":true},{"text":"alo igena a fatin ma,","poem":1},{"lineBreak":true},{"text":"e nun alo turena a xɔnne yi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A dangane xa lu a fari","poem":1},{"lineBreak":true},{"text":"alo a dugina a ma.","poem":1},{"lineBreak":true},{"text":"E lu a ma waxatin birin","poem":1},{"lineBreak":true},{"text":"alo a tagi xidina.”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatala xa n tɔɲɛgɛ muxune saran na kii nin","poem":1},{"lineBreak":true},{"text":"e nun naxanye n mafalama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Awa, Marigina Alatala,","poem":1},{"lineBreak":true},{"text":"n mali i xili binyena fe ra.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i ya hinanna gbo,","poem":1},{"lineBreak":true},{"text":"n xunba.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yiigelitɔɔn nun tɔrɔ muxun nan n na,","poem":1},{"lineBreak":true},{"text":"n niin sunuxi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N tununmaan ni i ra","poem":1},{"lineBreak":true},{"text":"alo nininna ɲinbanna ra.","poem":1},{"lineBreak":true},{"text":"E n kedima alo suɲɛna.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"N xinbi xudine bata tuyɛ ayi sun suxuni.","poem":1},{"lineBreak":true},{"text":"N bata doyen, n xɔsi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"E na n to, e yi e xunni maxa,","poem":1},{"lineBreak":true},{"text":"e n magele.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Alatala n ma Ala, n mali,","poem":1},{"lineBreak":true},{"text":"i n nakisi i ya hinanni,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"alogo e xa a kolon","poem":1},{"lineBreak":true},{"text":"a i tan Alatala nan na ligaxi i sɛnbɛni.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"E tan n dangama nɛn,","poem":1},{"lineBreak":true},{"text":"i tan yi barakan sa n ma fe yi.","poem":1},{"lineBreak":true},{"text":"E na keli n xili ma, e yagima nɛn,","poem":1},{"lineBreak":true},{"text":"n tan, i ya walikɛɛn yi sɛwa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ala xa n tɔɲɛgɛ muxune yalagi.","poem":1},{"lineBreak":true},{"text":"Ala xa yagin so e xunna alo dugina.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"N nan n xuini tema nɛn,","poem":1},{"lineBreak":true},{"text":"n na Alatala tantun han!","poem":1},{"lineBreak":true},{"text":"N yi a matɔxɔ yamani.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Amasɔtɔ a keli nɛn","poem":1},{"lineBreak":true},{"text":"a ti tɔrɔ muxun xɔn,","poem":1},{"lineBreak":true},{"text":"a yi a rakisi a yalagi muxune ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}