Banxi Sariɲanxini.","poem":1},{"lineBreak":true},{"text":"Alatala a manga gbɛdɛni ariyanna yi.","poem":1},{"lineBreak":true},{"text":"A adamadiine xun matoma a ra","poem":1},{"lineBreak":true},{"text":"a e rakɔrɔsima a yɛɛn na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala tinxin muxune nun muxu ɲaxine rakɔrɔsima.","poem":1},{"lineBreak":true},{"text":"Gbalo feen nafanxi naxanye ma,","poem":1},{"lineBreak":true},{"text":"a ne raɲaxuma a niin birin yi nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tɛɛ wolonna nun dole tɛɛn nagodoma nɛn muxu ɲaxine ma.","poem":1},{"lineBreak":true},{"text":"A e tɔrɔma foye wolonna ra nɛn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala tinxin,","poem":1},{"lineBreak":true},{"text":"tinxinyaan nafan a ma.","poem":1},{"lineBreak":true},{"text":"Muxu faɲine a yɛtagin toma nɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}