{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":110,"content":[{"type":"heading","content":["Alaa manga sugandixina"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"Alatalaa falan ni ito ra n marigin xa,","poem":1},{"lineBreak":true},{"text":"a naxa, “Dɔxɔ n yiifanna ma,","poem":1},{"lineBreak":true},{"text":"han n yi i yaxune sa i sanna bun ma.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala xa i ya mangayaan sɛnbɛn gbo ayi","poem":1},{"lineBreak":true},{"text":"fɔlɔ Siyon ma,","poem":1},{"lineBreak":true},{"text":"i yi i yaxune nɔ i rabilinni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I na i ya ganla xili,","poem":1},{"lineBreak":true},{"text":"i ya yamana a sɔbɛ soma nɛn.","poem":1},{"lineBreak":true},{"text":"I ya banxulanne yi fa i ma xunna kenla nun sariɲanni","poem":1},{"lineBreak":true},{"text":"alo xiila subaxani.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala bata a kɔlɔ,","poem":1},{"lineBreak":true},{"text":"a mi a xuiin maxɛtɛma, a naxa,","poem":1},{"lineBreak":true},{"text":"“Saraxaraliin nan i ra habadan,","poem":1},{"lineBreak":true},{"text":"alo Mɛlikisedeki yi kii naxan yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Marigina i xɔn.","poem":1},{"lineBreak":true},{"text":"Xa a xɔlɔ lɔxɔn naxan yi,","poem":1},{"lineBreak":true},{"text":"a mangane halagima nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A siyane makitima nɛn,","poem":1},{"lineBreak":true},{"text":"binbine yi lu yiren birin yi.","poem":1},{"lineBreak":true},{"text":"A dunuɲa mangane birin nɔma nɛn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mangana a minma nɛn xudeni kira yi,","poem":1},{"lineBreak":true},{"text":"a xunna keli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}