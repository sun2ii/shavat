{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":111,"content":[{"type":"heading","content":["Ala tantun"]},{"type":"verse","number":1,"content":[{"text":"Tantunna Ala xa!","poem":1},{"lineBreak":true},{"text":"N na Alatala tantunma nɛn n bɔɲɛn ma feu,","poem":1},{"lineBreak":true},{"text":"muxu faɲine nun yamaan yɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala kɛwanle gbo!","poem":1},{"lineBreak":true},{"text":"E rafan naxanye ma,","poem":1},{"lineBreak":true},{"text":"ne maɲɔxɔnma e ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kɛwanle magaxu, e gbo.","poem":1},{"lineBreak":true},{"text":"A tinxinyaan luma nɛn habadan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A bata a kabanako feene rabira en ma.","poem":1},{"lineBreak":true},{"text":"Alatala diɲa, a kininkinin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A balon fima nɛn a yɛɛragaxu muxune ma.","poem":1},{"lineBreak":true},{"text":"A mi ɲinanma a layirin xɔn mumɛ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A bata a sɛnbɛn yita a muxune ra,","poem":1},{"lineBreak":true},{"text":"a yi xɔɲɛne bɔxɔn so e yii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɲɔndin nun sariya kɛndɛna a kɛwanle yi.","poem":1},{"lineBreak":true},{"text":"Lannayana a fe ragidixine birin yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E na waxatin birin,","poem":1},{"lineBreak":true},{"text":"lannayaan nun tinxinna nan e ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A bata a muxune xɔrɔya,","poem":1},{"lineBreak":true},{"text":"a yi habadan layirin xidi e xɔn ma.","poem":1},{"lineBreak":true},{"text":"A xinla sariɲan, a magaxu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fe kolonna fɔlɔma Alatala yɛɛragaxun nan ma.","poem":1},{"lineBreak":true},{"text":"Xaxilimaan nan ne ra naxanye na ligama.","poem":1},{"lineBreak":true},{"text":"Tantunna a xa habadan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}