xa donla so fonisireyani,","poem":1},{"lineBreak":true},{"text":"a yi a feene raba tinxinni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bayo tinxin muxun mi tantanɲɛ mumɛ!","poem":1},{"lineBreak":true},{"text":"Yamaan mi ɲinanɲɛ a fe xɔn habadan!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A mi gaxun xibaru ɲaxina fe ra.","poem":1},{"lineBreak":true},{"text":"A xaxili ragidi,","poem":1},{"lineBreak":true},{"text":"a yigi saxi Alatala nan fari.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A bɔɲɛn mi xuruxurunma,","poem":1},{"lineBreak":true},{"text":"a mi gaxuma.","poem":1},{"lineBreak":true},{"text":"Dɔnxɛn na,","poem":1},{"lineBreak":true},{"text":"a a yaxune biraxin toma nɛn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A tan nan tɔrɔ muxune kima fonisireyani.","poem":1},{"lineBreak":true},{"text":"A tinxinyaan luma nɛn habadan!","poem":1},{"lineBreak":true},{"text":"A sɛnbɛn xun masama nɛn binyeni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muxu ɲaxin na na to,","poem":1},{"lineBreak":true},{"text":"a xɔlɔma nɛn,","poem":1},{"lineBreak":true},{"text":"a sunu, a yi a ɲinna raxin.","poem":1},{"lineBreak":true},{"text":"Muxu ɲaxin waxɔn feene kalama nɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}