t":[{"text":"Nde luxi alo Alatala,","poem":1},{"lineBreak":true},{"text":"a tan naxan dɔxi ariyanna yi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"a tan naxan a yigodoma,","poem":1},{"lineBreak":true},{"text":"a kore xɔnna nun bɔxɔ xɔnna mato?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A sɛnbɛtarene rakelima,","poem":1},{"lineBreak":true},{"text":"a tɔrɔ muxune ba e tɔrɔni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A yi e radɔxɔ muxu gbeene fɛma a yamani.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A gbantan findi dii barin na,","poem":1},{"lineBreak":true},{"text":"a yi a findi dii nga sɛwaxin na.","poem":1},{"lineBreak":true},{"text":"Tantunna Alatala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}