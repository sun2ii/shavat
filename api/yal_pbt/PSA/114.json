{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":114,"content":[{"type":"heading","content":["Halagi Tiin Dangu Lɔxɔn Sanla"]},{"type":"verse","number":1,"content":[{"text":"Isirayila to mini Misiran yamanani,","poem":1},{"lineBreak":true},{"text":"Yaxuba yixɛtɛne to keli yamanani","poem":1},{"lineBreak":true},{"text":"e yi xɔɲɛyani dɛnaxan yi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yuda yi findi Alaa yama sariɲanxin na.","poem":1},{"lineBreak":true},{"text":"Isirayila yi findi a gbeen na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Fɔxɔ igen to a to, a yi a gi,","poem":1},{"lineBreak":true},{"text":"Yurudɛn Baan yi xɛtɛ a xanbi ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Geyane yi tugan alo kontonne","poem":1},{"lineBreak":true},{"text":"yire matexine fan yi tugan","poem":1},{"lineBreak":true},{"text":"alo yɛxɛɛ diine.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fɔxɔ igena, nanfera i i gima?","poem":1},{"lineBreak":true},{"text":"Yurudɛn baana,","poem":1},{"lineBreak":true},{"text":"nanfera i xɛtɛma i xanbi ra?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ tan geyane, nanfera ɛ tuganma","poem":1},{"lineBreak":true},{"text":"alo kontonne,","poem":1},{"lineBreak":true},{"text":"ɛ tan yire matexine,","poem":1},{"lineBreak":true},{"text":"nanfera ɛ tuganma alo yɛxɛɛ diine?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bɔxɔn xa xuruxurun Marigin yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A tan naxan fanyene findi darane ra,","poem":1},{"lineBreak":true},{"text":"a yi gɛmɛ gbeen findi tigin na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}