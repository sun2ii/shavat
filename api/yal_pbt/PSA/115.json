{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":115,"content":[{"type":"heading","content":["Binyen xa fi Ala nan keden ma"]},{"type":"verse","number":1,"content":[{"text":"Alatala, nxu tan mi a ra de!","poem":1},{"lineBreak":true},{"text":"I tan nan xili xa binya","poem":1},{"lineBreak":true},{"text":"i ya hinanna nun lannayana fe ra.","poem":1},{"lineBreak":true},{"text":"Nxu tan mi a ra!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nanfera siyane maxɔdinna tima,","poem":1},{"lineBreak":true},{"text":"e naxa, “E Ala go?”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En ma Ala ariyanna yi.","poem":1},{"lineBreak":true},{"text":"Naxan nafan a ma,","poem":1},{"lineBreak":true},{"text":"a na nan ligama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gbetin nun xɛmaan nan tun e tan ma suxurene ra!","poem":1},{"lineBreak":true},{"text":"Muxune nan ne rafalaxi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E dɛ na, koni e mi fala tima.","poem":1},{"lineBreak":true},{"text":"E yɛɛne na, koni e mi sese toma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E tunle na, koni e mi fefe mɛma.","poem":1},{"lineBreak":true},{"text":"E ɲɔɛɛn na, koni e mi sese xiri mɛma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E yiine na, koni e mi nɔɛ seen suxɛ.","poem":1},{"lineBreak":true},{"text":"E sanne na, koni e mi nɔɛ sigan tiyɛ.","poem":1},{"lineBreak":true},{"text":"E mi nɔɛ xui yo raminɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naxan na e rafala,","poem":1},{"lineBreak":true},{"text":"a a yigin sa e yi,","poem":1},{"lineBreak":true},{"text":"na fan luma nɛn alo e tan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛ tan Isirayila yamana,","poem":1},{"lineBreak":true},{"text":"ɛ yigin sa Alatala nin,","poem":1},{"lineBreak":true},{"text":"a tan nan ɛ malima","poem":1},{"lineBreak":true},{"text":"alo yɛ masansan wure lefana.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛ tan saraxaraline,","poem":1},{"lineBreak":true},{"text":"ɛ yigin sa Alatala nin,","poem":1},{"lineBreak":true},{"text":"a tan nan ɛ malima","poem":1},{"lineBreak":true},{"text":"alo yɛ masansan wure lefana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛ tan a yɛɛ ra gaxu muxune,","poem":1},{"lineBreak":true},{"text":"ɛ yigin sa Alatala nin,","poem":1},{"lineBreak":true},{"text":"a tan nan ɛ malima","poem":1},{"lineBreak":true},{"text":"alo yɛ masansan wure lefana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alatala a ɲɔxɔ luma en xɔn ma nɛn,","poem":1},{"lineBreak":true},{"text":"a en baraka.","poem":1},{"lineBreak":true},{"text":"A Isirayila yamaan barakama nɛn","poem":1},{"lineBreak":true},{"text":"e nun a saraxaraline.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala a yɛɛ ra gaxu muxune birin barakama nɛn,","poem":1},{"lineBreak":true},{"text":"muxudine nun muxu gbeene.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala xa diine fi ɛ nun ɛ diine ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alatala xa ɛ baraka","poem":1},{"lineBreak":true},{"text":"naxan koren nun bɔxɔn daxi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alatala nan gbee ariyanna ra,","poem":1},{"lineBreak":true},{"text":"koni a bata bɔxɔn taxu adamadiine ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Faxa muxune xa mi Alatala tantunma de!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koni en tan nan barikan birama a xa","poem":1},{"lineBreak":true},{"text":"iki e nun habadan.","poem":1},{"lineBreak":true},{"text":"Tantunna Alatala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}