{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":116,"content":[{"type":"heading","content":["Muxu rakisixina Ala tantunna"]},{"type":"verse","number":1,"content":[{"text":"N bata Alatala xanu","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a n ma maxandi xuiin namɛma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na a xili waxati yo yi,","poem":1},{"lineBreak":true},{"text":"a a tuli matiyɛ n na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sayaan gbalon bata yi n nabilin nun,","poem":1},{"lineBreak":true},{"text":"n bata yi maso gaburun na nun,","poem":1},{"lineBreak":true},{"text":"gaxun nun kuisanna bata yi n li nun,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n yi Alatala maxandi a xinla ra,","poem":1},{"lineBreak":true},{"text":"n naxa, “Alatala, n nakisi!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala diɲa, a tinxin.","poem":1},{"lineBreak":true},{"text":"En ma Ala kininkinin han!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala muxu bɔɲɛ fixɛne nan natangama.","poem":1},{"lineBreak":true},{"text":"N sɛnbɛn bata yi ɲan,","poem":1},{"lineBreak":true},{"text":"a yi n nakisi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bɔɲɛn xa xunbeli,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ Alatala bata fe faɲin liga n xa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala bata n niin natanga sayaan ma.","poem":1},{"lineBreak":true},{"text":"A bata n yɛɛgen fitan n yɛtagi.","poem":1},{"lineBreak":true},{"text":"A mi tinxi n bira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N sigan tima nɛn Alatala yɛtagi dunuɲa yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N dɛnkɛlɛyaxi,","poem":1},{"lineBreak":true},{"text":"nanara n yi falan ti,","poem":1},{"lineBreak":true},{"text":"n naxa, “N tɔrɔxi ki faɲi!”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N yi gaxuni waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“Adamadiine birin wule!”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N fa nanse soma Alatala yii","poem":1},{"lineBreak":true},{"text":"lan na fe faɲine birin ma","poem":1},{"lineBreak":true},{"text":"a bata naxanye liga n xa?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N minse saraxan bama nɛn a xa a marakisina fe ra","poem":1},{"lineBreak":true},{"text":"n yi Alatala maxandi a xinla ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N nan n dɛ xuine rakamalima nɛn","poem":1},{"lineBreak":true},{"text":"yamaan birin yɛɛ xɔri","poem":1},{"lineBreak":true},{"text":"n naxanye tongo Alatala xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Alatalaa tɔgɔndiya muxuna nde na faxa","poem":1},{"lineBreak":true},{"text":"na a tɔrɔma nɛn han!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Alatala, i ya walikɛɛn nan n na,","poem":1},{"lineBreak":true},{"text":"i ya walikɛ ɲaxanla naxan barixi.","poem":1},{"lineBreak":true},{"text":"I bata n naxɔrɔya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N barika bira saraxan bama i xa nɛn","poem":1},{"lineBreak":true},{"text":"n yi Alatala maxandi a xinla ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N nan n dɛ xuine rakamalima nɛn","poem":1},{"lineBreak":true},{"text":"yamaan birin yɛɛ xɔri","poem":1},{"lineBreak":true},{"text":"n naxanye tongo Alatala xa,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Alatalaa banxin tanden ma,","poem":1},{"lineBreak":true},{"text":"Yerusalɛn taani.","poem":1},{"lineBreak":true},{"text":"Tantunna Alatala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}