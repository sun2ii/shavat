{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":118,"content":[{"type":"heading","content":["Barika birana Ala xa"]},{"type":"verse","number":1,"content":[{"text":"Alatala xa tantun amasɔtɔ a fan.","poem":1},{"lineBreak":true},{"text":"A hinanna luma nɛn habadan!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isirayila muxune xa a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"“A hinanna luma nɛn habadan!”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alaa saraxaraline xa a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"“A hinanna luma nɛn habadan!”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala yɛɛ ra gaxu muxune xa a fala,","poem":1},{"lineBreak":true},{"text":"e naxa, “A hinanna luma nɛn habadan!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N yi tɔrɔni waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n yi n xui ramini Alatala ma.","poem":1},{"lineBreak":true},{"text":"A yi n yabi, a n xɔrɔya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala n xɔn, n mi gaxuɛ mumɛ!","poem":1},{"lineBreak":true},{"text":"Adamadiine nɔɛ nanse ligɛ n na?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala n xɔn, a tan nan n malima.","poem":1},{"lineBreak":true},{"text":"N na n yaxune biraxin toma nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A fisa muxun yi a yigin sa Alatala yi","poem":1},{"lineBreak":true},{"text":"benun a xa a yigin sa adamadiine yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A fisa muxun yi a yigin sa Alatala yi","poem":1},{"lineBreak":true},{"text":"benun a xa a yigin sa mangane yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Siyane birin bata yi n nabilin yɛngɛni nun,","poem":1},{"lineBreak":true},{"text":"koni n na e birin halagi nɛn Alatala barakani!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E yi n nabilinxi yiren birin yi nun,","poem":1},{"lineBreak":true},{"text":"koni n na e birin halagi nɛn Alatala barakani!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E so nɛn n xun na","poem":1},{"lineBreak":true},{"text":"alo kumi ɲɛɲɛne,","poem":1},{"lineBreak":true},{"text":"koni e raxɔri nɛn mafurɛn","poem":1},{"lineBreak":true},{"text":"alo tɛɛn na sɛxɛ xaren gan,","poem":1},{"lineBreak":true},{"text":"n yi e halagi Alatala barakani.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E yi n nadinma nɛn","poem":1},{"lineBreak":true},{"text":"alogo n xa bira,","poem":1},{"lineBreak":true},{"text":"koni Alatala yi n mali.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala nan n sɛnbɛn na,","poem":1},{"lineBreak":true},{"text":"n ma bɛtina.","poem":1},{"lineBreak":true},{"text":"A tan nan n nakisixi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Muxu tinxinxine bata e sɛwa xuini te","poem":1},{"lineBreak":true},{"text":"kisina fe ra, e naxa,","poem":1},{"lineBreak":true},{"text":"“Alatala sɛnbɛn gbo!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Marigin bata nɔɔn ti a sɛnbɛni!","poem":1},{"lineBreak":true},{"text":"Alatala sɛnbɛn gbo!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nayi, n mi faxama,","poem":1},{"lineBreak":true},{"text":"n luma nɛn n nii ra,","poem":1},{"lineBreak":true},{"text":"n yi a fala Alatala naxan ligaxi n xa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alatala bata yi n saran n hakɛne ra,","poem":1},{"lineBreak":true},{"text":"koni a mi tinxi n faxa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Alaa banxin dɛɛne xa rabi n xa.","poem":1},{"lineBreak":true},{"text":"N xa so, n yi Alatala tantun.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatalaa banxin dɛɛn ni i ra,","poem":1},{"lineBreak":true},{"text":"tinxin muxune soon dɛɛn naxan na.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ala, n ni i tantunma nɛn,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i bata n yabi,","poem":1},{"lineBreak":true},{"text":"bayo i bata n nakisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Banxi tiine e mɛ gɛmɛn naxan na,","poem":1},{"lineBreak":true},{"text":"na bata findi banxin gɛmɛ fisamantenna ra.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Alatala nan na ligaxi,","poem":1},{"lineBreak":true},{"text":"kabanako feen nan na ra en yɛɛ ra yi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Alatala toon lɔxɔn nan nagidixi,","poem":1},{"lineBreak":true},{"text":"en ɲaxan, en sɛwa a fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Alatala, fa nxu rakisi,","poem":1},{"lineBreak":true},{"text":"Alatala, tin, nxu xa nɔɔn ti.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Naxan fama Alatala xinli,","poem":1},{"lineBreak":true},{"text":"Ala xa na baraka!","poem":1},{"lineBreak":true},{"text":"Nxu dubama ɛ xa Alatalaa banxini.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Alatala nan Ala ra,","poem":1},{"lineBreak":true},{"text":"a bata en lu a kɛnɛnyani.","poem":1},{"lineBreak":true},{"text":"Ɛ ɲɔxɔnde dɛɛne suxu ɛ yii,","poem":1},{"lineBreak":true},{"text":"ɛ fa sanla raba","poem":1},{"lineBreak":true},{"text":"siga han saraxa ganden nabilinni.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"I tan nan n ma Ala ra,","poem":1},{"lineBreak":true},{"text":"n ni i tantunma nɛn.","poem":1},{"lineBreak":true},{"text":"I tan nan n ma Ala ra,","poem":1},{"lineBreak":true},{"text":"n ni i batuma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ɛ Alatala tantun, bayo a fan.","poem":1},{"lineBreak":true},{"text":"A hinanna luma nɛn habadan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}