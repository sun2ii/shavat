{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":12,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba kondenna luti solomasɛxɛn na.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, nxu mali,","poem":1},{"lineBreak":true},{"text":"bayo muxu tɔgɔndiyaxine bata ɲan.","poem":1},{"lineBreak":true},{"text":"Dɛnkɛlɛya muxu yo mi fa adamadiine yɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Birin wulen falama a boden xa.","poem":1},{"lineBreak":true},{"text":"E e bode yanfa wule matɔxɔn xɔn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala, na muxune dɛɛn suxu","poem":1},{"lineBreak":true},{"text":"naxanye wule matɔxɔn tima,","poem":1},{"lineBreak":true},{"text":"e nun muxu dɛ raɲaxuxine,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"naxanye a falama, e naxa,","poem":1},{"lineBreak":true},{"text":"“Nxu nɔɔn sɔtɔma nxu fala xuine nan xɔn.","poem":1},{"lineBreak":true},{"text":"Nxu dɛɛn fatan han!","poem":1},{"lineBreak":true},{"text":"Nde nxu nɔɛ?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Awa, Alatala naxa,","poem":1},{"lineBreak":true},{"text":"“Bayo yiigelitɔne ɲaxankataxi,","poem":1},{"lineBreak":true},{"text":"e nun tɔrɔ muxune wugama,","poem":1},{"lineBreak":true},{"text":"nba iki, n bata keli,","poem":1},{"lineBreak":true},{"text":"n na e ratangama nɛn","poem":1},{"lineBreak":true},{"text":"naxanye raɲaxuxi.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatalaa falane,","poem":1},{"lineBreak":true},{"text":"fala sariɲanxin nan e ra","poem":1},{"lineBreak":true},{"text":"alo gbeti fixɛna","poem":1},{"lineBreak":true},{"text":"naxan nasɛnsɛnxi sulun tɛɛn","poem":1},{"noteId":1},{"text":"na","poem":1},{"lineBreak":true},{"text":"han sanɲa ma solofere.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, i nxu kantanɲɛ,","poem":1},{"lineBreak":true},{"text":"i nxu ratanga muxu sifani itoe ma habadan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na muxu ɲaxine e kanbama yiren birin yi","poem":1},{"lineBreak":true},{"text":"bayo Adamadiine fe fuune yatɛxi.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"12.7Sulun tɛɛnmɔn falama yirena nde yi fa fala “Furu tɛɛna.”","reference":{"chapter":12,"verse":7}}]},"thisChapterLink":"/api/yal_pbt/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}