true},{"text":"n lu ɛ tagi, ɛ tan Mesɛki kaane,","poem":1},{"lineBreak":true},{"text":"n dɔxɔ ɛ yɛ","poem":1},{"lineBreak":true},{"text":"alo Kedari bɔnsɔnna muxune wulaan kui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N bata bu muxune tagi","poem":1},{"lineBreak":true},{"text":"bɔɲɛ xunbenla mi rafan naxanye ma!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N na bɔɲɛ xunbenla fe fala,","poem":1},{"lineBreak":true},{"text":"e tan yi yɛngɛn so.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}