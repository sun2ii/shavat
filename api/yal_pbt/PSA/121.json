{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":121,"content":[{"type":"heading","content":["Ala nan en natanga muxun na"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina.","descriptive":true},{"text":"N bata n yɛɛ rate geyane ma,","poem":1},{"lineBreak":true},{"text":"n naxa, “N ma maliin kelima minɛn yi?”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ma maliin kelima Alatala nan ma","poem":1},{"lineBreak":true},{"text":"naxan ariyanna nun dunuɲa daxi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mi tinɲɛ, i yi bira.","poem":1},{"lineBreak":true},{"text":"I kantanmaan mi xiyɛ mumɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isirayila kantanmaan mi kinsanɲɛ,","poem":1},{"lineBreak":true},{"text":"a mi xiyɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala i kantanma,","poem":1},{"lineBreak":true},{"text":"a i dɛxɔn ma alo i nininna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sogen mi fefe ligɛ i ra yanyin na,","poem":1},{"lineBreak":true},{"text":"kiken fan mi fefe ligɛ i ra kɔɛɛn na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala i kantanma nɛn fe ɲaxin birin ma,","poem":1},{"lineBreak":true},{"text":"a yi i niin natanga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala i kantanma nɛn i ya sigan nun xɛtɛni,","poem":1},{"lineBreak":true},{"text":"fɔlɔ iki ma han habadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}