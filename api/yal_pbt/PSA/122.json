{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"heading","content":["Yerusalɛn matɔxɔ bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina, Dawuda gbeena.","descriptive":true},{"text":"Sɛwan na a ra n xa, e na a fala n xa,","poem":1},{"lineBreak":true},{"text":"“En siga Alatalaa banxini!”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iki, en tixi Yerusalɛn so dɛɛn na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yerusalɛn tixi ki faɲi","poem":1},{"lineBreak":true},{"text":"a banxine tugunxi e bode ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatalaa yamaan sigama mɛnna nin bɔnsɔn yɛɛn ma,","poem":1},{"lineBreak":true},{"text":"alo a sariyana a falaxi Isirayila xa kii naxan yi,","poem":1},{"lineBreak":true},{"text":"alogo e xa sa a xinla tantun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mangane kitin sama mɛnna nin","poem":1},{"lineBreak":true},{"text":"Dawudaa manga gbɛdɛn ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ Ala maxandi bɔɲɛ xunbenla fe ra Yerusalɛn xa.","poem":1},{"lineBreak":true},{"text":"Ala xa bɔɲɛ xunbenla fi a rafan muxune ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ala xa bɔɲɛ xunbenla lu taani.","poem":1},{"lineBreak":true},{"text":"Ala xa hɛrin fi taa yi kaane ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ngaxakedenne nun n xɔyine fe ra, n naxa,","poem":1},{"lineBreak":true},{"text":"“Ala xa bɔɲɛ xunbenla fi Yerusalɛn ma.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N taana bɔɲɛ xunbenla nan fenma","poem":1},{"lineBreak":true},{"text":"Alatalaa banxina fe ra, en ma Ala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}