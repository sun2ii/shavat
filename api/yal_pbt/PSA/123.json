{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":123,"content":[{"type":"heading","content":["Ala xa hinan en na"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina.","descriptive":true},{"text":"I tan naxan dɔxi kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"n na n yɛɛ ratema i tan nan ma,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"alo konyine e yɛɛn tima e kanna ra kii naxan yi,","poem":1},{"lineBreak":true},{"text":"alo walikɛ ɲaxanla yɛɛne luma tixi a kanna ra kii naxan yi.","poem":1},{"lineBreak":true},{"text":"En na en yɛɛne tima","poem":1},{"lineBreak":true},{"text":"en ma Ala ra na kii nin, Alatala,","poem":1},{"lineBreak":true},{"text":"en yi a hinanna mamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hinan nxu ra, Alatala, hinan nxu ra,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e nxu raɲaxuxi han!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nxu niin bata wasa fɛrɛ kanne nun","poem":1},{"lineBreak":true},{"text":"wasodene magele xuine ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}