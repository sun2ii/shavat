{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":124,"content":[{"type":"heading","content":["Ala nan a muxune ratangama"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina, Dawuda gbeena.","descriptive":true},{"text":"Xa Alatala mi yi ti en xɔn nun,","poem":1},{"lineBreak":true},{"text":"Isirayila muxune fan xa a fala, e naxa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Xa Alatala mi yi ti en xɔn nun","poem":1},{"lineBreak":true},{"text":"yaxune yi en yɛngɛma waxatin naxan yi,”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"e yi en ɲɛɲɛn gerunma nɛn nun","poem":1},{"lineBreak":true},{"text":"e xɔlɔ en xili ma waxatin naxan yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nayi, walanna yi sigama en na nɛn nun,","poem":1},{"lineBreak":true},{"text":"fufaan yi en mamin,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ige xunfan gbeen yi sa en xun ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"En barikan bira Alatala xa,","poem":1},{"lineBreak":true},{"text":"a mi tinxi en yaxune yi en ɲan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nxu bata nxu sɔtɔ","poem":1},{"lineBreak":true},{"text":"alo xɔlina a sɔtɔma xɔli suxuna lutin na kii naxan yi.","poem":1},{"lineBreak":true},{"text":"Lutin bata bolon, nxu xɔrɔya!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"En ma maliin kelima Alatala nan yii","poem":1},{"lineBreak":true},{"text":"naxan ariyanna nun dunuɲa daxi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}