{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":125,"content":[{"type":"heading","content":["Alaa muxune rakisi fena"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina.","descriptive":true},{"text":"Naxanye e yigi sama Alatala yi,","poem":1},{"lineBreak":true},{"text":"na kanne ligaxi nɛn alo Siyon Geyana,","poem":1},{"lineBreak":true},{"text":"naxan luma a funfuni habadan,","poem":1},{"lineBreak":true},{"text":"a mi mamaxɛ mumɛ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yerusalɛn rabilinxi geyane ra kii naxan yi,","poem":1},{"lineBreak":true},{"text":"Alatala fan a muxune rabilinma na kii nin,","poem":1},{"lineBreak":true},{"text":"keli to ma han habadan!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amasɔtɔ tinxintarene mi luyɛ","poem":1},{"lineBreak":true},{"text":"tinxin muxune yamanan xun na mumɛ,","poem":1},{"lineBreak":true},{"text":"alogo tinxin muxune fan nama fe ɲaxin liga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala, fe faɲin naba na kanne xa","poem":1},{"lineBreak":true},{"text":"naxanye fan e nun naxanye sɔndɔmɛn fan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Koni, naxanye kira tinxintarene fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"Alatala xa ne nun fe ɲaxi rabane ɲan","poem":1},{"lineBreak":true},{"text":"e bode xɔn ma.","poem":1},{"lineBreak":true},{"text":"Ala xa bɔɲɛ xunbenla fi Isirayila ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}