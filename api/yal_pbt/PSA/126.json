{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":126,"content":[{"type":"heading","content":["Ala maxandina xunbana fe ra"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina.","descriptive":true},{"text":"Alatala mɔn faxina en tan muxu suxine ra Siyon taani,","poem":1},{"lineBreak":true},{"text":"a liga nɛn en yɛɛ ra yi","poem":1},{"lineBreak":true},{"text":"alo xiyen na a ra!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"En gele nɛn han,","poem":1},{"lineBreak":true},{"text":"en yi sɛwa bɛtine ba!","poem":1},{"lineBreak":true},{"text":"Siyaan bonne yi a falama nɛn, e naxa,","poem":1},{"lineBreak":true},{"text":"“Alatala bata fe gbeene liga e xa.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala bata fe gbeene liga en xa,","poem":1},{"lineBreak":true},{"text":"en birin bata sɛwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala, i mɔn xa nxɔ yamanan sɛnbɛ so","poem":1},{"lineBreak":true},{"text":"alo tulen fama igen na","poem":1},{"lineBreak":true},{"text":"xude wuli yixaren na kii naxan yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naxanye sansiin wolima e wugama,","poem":1},{"lineBreak":true},{"text":"ne sɔnxɔma nɛn sɛwani se xabadeni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naxanye sigama wugɛ sansi wolideni,","poem":1},{"lineBreak":true},{"text":"ne xɛtɛma gelɛ nɛn malo xidine ra e xun ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}