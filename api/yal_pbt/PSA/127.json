{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"heading","content":["Ala wali faɲi kolonna"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina, Sulemani gbeena.","descriptive":true},{"text":"Xa Alatala xa mi banxin tima,","poem":1},{"lineBreak":true},{"text":"banxi tiine wali fuun nan kɛma.","poem":1},{"lineBreak":true},{"text":"Xa Alatala xa mi taan makantan,","poem":1},{"lineBreak":true},{"text":"taa kantanne fe fuun nan xun na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ kurunma walideni fuyan,","poem":1},{"lineBreak":true},{"text":"ɛ kɔɛ rasoma fuyan,","poem":1},{"lineBreak":true},{"text":"ɛ balon sɔtɔma tɔrɔn nin.","poem":1},{"lineBreak":true},{"text":"Anu, Ala balon soma a xanuntenne yii nɛn,","poem":1},{"lineBreak":true},{"text":"e saxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alatala diine fima muxune ma nɛn e kɛɛn na.","poem":1},{"lineBreak":true},{"text":"E findixi kɔntɔnna nan na","poem":1},{"lineBreak":true},{"text":"Alatala naxan fima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xɛmɛn dii xɛmɛn naxanye sɔtɔma banxulanyani,","poem":1},{"lineBreak":true},{"text":"ne ligaxi nɛn","poem":1},{"lineBreak":true},{"text":"alo xalimakunla sofaan yii kii naxan yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sɛwan na xɛmɛn xa","poem":1},{"lineBreak":true},{"text":"xalimakuli wuyaxin naxan yii.","poem":1},{"lineBreak":true},{"text":"E nun a yaxune na kiti, a mi yagima.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}