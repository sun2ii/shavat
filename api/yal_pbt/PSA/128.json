{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":128,"content":[{"type":"heading","content":["Duban Ala yɛɛragaxu muxune xa"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina.","descriptive":true},{"text":"Sɛwan na kanne xa","poem":1},{"lineBreak":true},{"text":"naxanye gaxuma Alatala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"naxanye birama a kiraan fɔxɔ ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I wali xɔnna i makone fanma nɛn.","poem":1},{"lineBreak":true},{"text":"I sɛwama nɛn i mɔn yi sabati.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I ya ɲaxanla diine barima nɛn","poem":1},{"lineBreak":true},{"text":"alo wudi bili bogilana.","poem":1},{"lineBreak":true},{"text":"I ya dii xɛmɛne i ya tabanla rabilinma nɛn","poem":1},{"lineBreak":true},{"text":"alo oliwi wudi binle.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muxun naxan gaxuma Alatala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"na kanna dubani itoe nan sɔtɔma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala xa barakan sa i ya fe yi","poem":1},{"lineBreak":true},{"text":"keli Siyon yi!","poem":1},{"lineBreak":true},{"text":"Ala xa i Yerusalɛn sabatixin to","poem":1},{"lineBreak":true},{"text":"i siin birin yi!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala xa i i mamandenne to!","poem":1},{"lineBreak":true},{"text":"Ala xa bɔɲɛ xunbenla fi Isirayila ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}