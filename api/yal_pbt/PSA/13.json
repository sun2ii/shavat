{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, han waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"I ɲinanɲɛ n xɔn han habadan?","poem":1},{"lineBreak":true},{"text":"I yɛtagin luxunɲɛ n ma han waxatin mundun yi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N niin xa tɔrɔ,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛn yi fɛriɲɛn sunuxi","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"N yaxuna n fari","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala n ma Ala,","poem":1},{"lineBreak":true},{"text":"n mato, i n yabi.","poem":1},{"lineBreak":true},{"text":"N fangan xun masa,","poem":1},{"lineBreak":true},{"text":"xa na mi a ra, n faxama nɛn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yaxun yi a fala,","poem":1},{"lineBreak":true},{"text":"a naxa, “N bata a nɔ.”","poem":1},{"lineBreak":true},{"text":"N yaxune sɛwama nɛn","poem":1},{"lineBreak":true},{"text":"n na bira waxatin naxan yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N tan n yigin saxi i ya hinanna nin,","poem":1},{"lineBreak":true},{"text":"sɛwana n bɔɲɛni i ya kisina fe ra.","poem":1},{"lineBreak":true},{"text":"Alatala, n bɛtin bama i xa nɛn","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i bata fe faɲin liga n xa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}