{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":130,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina.","descriptive":true},{"text":"Alatala, n bata n xui ramini i ma tɔrɔni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Marigina, n xuiin namɛ,","poem":1},{"lineBreak":true},{"text":"i yi i tuli mati n ma maxandi xuiin na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala, xa i nxu suxu nxu hakɛne ra,","poem":1},{"lineBreak":true},{"text":"Marigina, nde luma a yalagitaren na?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koni i tan nan nxu mafeluma nxu hakɛne ra,","poem":1},{"lineBreak":true},{"text":"nxu yi gaxu i yɛɛ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N yengi saxi Alatala nan ma,","poem":1},{"lineBreak":true},{"text":"n niin taxuxi a ra,","poem":1},{"lineBreak":true},{"text":"n xaxili tixi a falan nan na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N yengi tixi Marigin na","poem":1},{"lineBreak":true},{"text":"alo taa kantanne yengi kuye yibaan ma kii naxan yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isirayila, i yengi ti Alatala ra,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a hinan, a nɔɛ i xunbɛ nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A tan nan Isirayila rakisima a hakɛn birin ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}