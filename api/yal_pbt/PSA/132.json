{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":132,"content":[{"type":"heading","content":["Dawudaa taan nan Alatala dɔxɔden na"]},{"type":"verse","number":1,"content":[{"text":"Ala Batu Banxi yisiga bɛtina.","descriptive":true},{"text":"Alatala, Dawudaa fe xa rabira i ma,","poem":1},{"lineBreak":true},{"text":"e nun a tɔrɔne birin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A tan nan a kɔlɔ Alatala xa,","poem":1},{"lineBreak":true},{"text":"a yi a dɛ ti Yaxubaa Ala Sɛnbɛmaan xa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A naxa, “N mi soma n konni,","poem":1},{"lineBreak":true},{"text":"n mi n sama n ma saden ma,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n mi tinɲɛ n yi kinsan hanma n yi xi,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"han n yiren fen Alatala xa,","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala Sɛnbɛmaan luma dɛnaxan yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nxu bata a fe mɛ Efarata yi,","poem":1},{"lineBreak":true},{"text":"nxu bata a to Yaari taan nabilinni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E naxa, “En siga Alaa banxini,","poem":1},{"lineBreak":true},{"text":"en yi en xinbi sin a san bun.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, keli, i fa i dɔxɔdeni,","poem":1},{"lineBreak":true},{"text":"i tan nun i ya kankirana,","poem":1},{"lineBreak":true},{"text":"i sɛnbɛn naxan yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala xa i ya saraxaraline findi tinxin muxune ra,","poem":1},{"lineBreak":true},{"text":"i ya tɔgɔndiya muxune yi sɔnxɔ sɛwani.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I nama i ya manga sugandixin nabeɲin,","poem":1},{"lineBreak":true},{"text":"i ya walikɛɛn Dawuda fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alatala bata a kɔlɔ Dawuda xa,","poem":1},{"lineBreak":true},{"text":"a mi a kalɛ mumɛ! A naxa,","poem":1},{"lineBreak":true},{"text":"“N ni i ya dii xɛmɛna nde nan sugandima,","poem":1},{"lineBreak":true},{"text":"a ti i funfuni mangan na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xa i ya dii xɛmɛne n ma layirin suxu,","poem":1},{"lineBreak":true},{"text":"e nun n ma maxadi xuine,","poem":1},{"lineBreak":true},{"text":"n na e xaranma naxanye ma,","poem":1},{"lineBreak":true},{"text":"e diine fan dɔxɔma nɛn","poem":1},{"lineBreak":true},{"text":"i ya mangaya gbɛdɛni han habadan.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alatala bata Siyon sugandi a dɔxɔden na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A bata a fala, a naxa,","poem":1},{"lineBreak":true},{"text":"“N luma be nin habadan.","poem":1},{"lineBreak":true},{"text":"N waxi mangayaan liga feni be nin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N baraka gbeen sama nɛn Siyon ma baloni,","poem":1},{"lineBreak":true},{"text":"n donseen so a tɔrɔ muxune birin yii.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N kisin fima nɛn a saraxaraline birin ma,","poem":1},{"lineBreak":true},{"text":"a tɔgɔndiya muxune yi sɔnxɔ sɛwani.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N mangana nde raminima nɛn","poem":1},{"lineBreak":true},{"text":"Dawuda yixɛtɛne yɛ mɛnni,","poem":1},{"lineBreak":true},{"text":"na yi lu n ma manga sugandixin funfuni.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N na a yaxune rayagima nɛn,","poem":1},{"lineBreak":true},{"text":"koni a mangayaan taxamasenna nɔrɔma nɛn han!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}