{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":135,"content":[{"type":"heading","content":["Tantun bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Tantunna Ala xa!","poem":1},{"lineBreak":true},{"text":"Ɛ Alatala xinla tantun!","poem":1},{"lineBreak":true},{"text":"Ɛ tan Alatalaa walikɛne, ɛ a tantun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ tan naxanye tixi Alatalaa banxini","poem":1},{"lineBreak":true},{"text":"naxanye en ma Alaa banxin tanden ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tantunna Ala xa! Amasɔtɔ Alatala fan.","poem":1},{"lineBreak":true},{"text":"Ɛ a tantun bɛtine yi, amasɔtɔ a diɲa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala nan Yaxuba sugandixi a yɛtɛ xa,","poem":1},{"lineBreak":true},{"text":"a yi Isirayila findi a gbeen na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N na a kolon fa fala Alatala gbo,","poem":1},{"lineBreak":true},{"text":"en Marigin gbo alane birin xa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kore xɔnna nun bɔxɔ xɔnna ma,","poem":1},{"lineBreak":true},{"text":"fɔxɔ igene nun yire tilinxine birin yi,","poem":1},{"lineBreak":true},{"text":"naxan na rafan Alatala ma,","poem":1},{"lineBreak":true},{"text":"a na nan ligama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A bata foyen nun tulen nakeli bɔxɔn danna ra,","poem":1},{"lineBreak":true},{"text":"a kuye sarinna ramini e nun tulena,","poem":1},{"lineBreak":true},{"text":"a foyen nakeli a ramaradeni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A yi dii singene","poem":1},{"lineBreak":true},{"text":"nun xuruse dii singene faxa Misiran yamanani.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A yi kabanako feene liga ɛ tan Misiran kaane tagi,","poem":1},{"lineBreak":true},{"text":"Firawona nun a kuntigine birin xili ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A siya wuyaxine halagi,","poem":1},{"lineBreak":true},{"text":"a yi manga sɛnbɛmane faxa,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"sa fɔlɔ Amorine Manga Sixɔn ma,","poem":1},{"lineBreak":true},{"text":"e nun Basan Manga Ogo","poem":1},{"lineBreak":true},{"text":"e nun mangan naxanye birin Kanan yamanani.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yi e bɔxɔne so Isirayila yii e kɛɛn na,","poem":1},{"lineBreak":true},{"text":"a findi a yamaan kɛɛn na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alatala, i xinla fe luma nɛn habadan!","poem":1},{"lineBreak":true},{"text":"Mayixɛtɛne nun mayixɛtɛne e xaxili luma i xɔn ma nɛn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala a muxune xun mayɛngɛ kitin sama nɛn.","poem":1},{"lineBreak":true},{"text":"A kininkinin a walikɛne ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gbetin nun xɛmaan nan tun siyane suxurene ra!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E dɛɛn na, koni e mi fala tima.","poem":1},{"lineBreak":true},{"text":"E yɛɛne na, koni e mi sese toma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"E tunle na, koni e mi fefe mɛma.","poem":1},{"lineBreak":true},{"text":"Niiraxili yo mi e yi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Naxan na e rafala, a a yigin sa e yi,","poem":1},{"lineBreak":true},{"text":"na fan luma nɛn alo e tan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɛ tan Isirayila yamana, ɛ Alatala tantun.","poem":1},{"lineBreak":true},{"text":"Ɛ tan saraxaraline, ɛ Alatala tantun.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ɛ tan Lewi bɔnsɔnna, ɛ Alatala tantun.","poem":1},{"lineBreak":true},{"text":"Ɛ tan a yɛɛragaxu muxune, ɛ Alatala tantun.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Barikan bira Alatala xa Siyon yi,","poem":1},{"lineBreak":true},{"text":"a tan naxan luma Yerusalɛn taani.","poem":1},{"lineBreak":true},{"text":"Tantunna Ala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}