{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"heading","content":["Isirayila muxu suxine fe"]},{"type":"verse","number":1,"content":[{"text":"Nxu yi dɔxi Babilɔn xude dɛɛne yi waxatin naxan yi","poem":1},{"lineBreak":true},{"text":"nxu wugama, nxu yi lu nxu mirɛ Siyon ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nxu yi nxɔ bɔlɔnne singan","poem":1},{"lineBreak":true},{"text":"na yamanan wudi tofaɲine ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muxun naxanye nxu suxu,","poem":1},{"lineBreak":true},{"text":"ne yi bɛtine maxɔdin nxu ma.","poem":1},{"lineBreak":true},{"text":"Nxu ɲaxankata muxune yi sɛwa bɛtine maxɔdin nxu ma,","poem":1},{"lineBreak":true},{"text":"e naxa, “Ɛ Siyon bɛtina nde ba nxu xa.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nxu tan bɛtin bama Alatala xa di xɔɲɛ taani?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xa n ɲinan i xɔn Yerusalɛn,","poem":1},{"lineBreak":true},{"text":"Ala xa n yiifanna faxa n ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xa n ɲinan i tan xɔn,","poem":1},{"lineBreak":true},{"text":"xa n mi lu Yerusalɛn yatɛ n ma sɛwan birin yi,","poem":1},{"lineBreak":true},{"text":"Ala xa n dɛɛn suxu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala, Edɔn kaane fe xa rabira i ma,","poem":1},{"lineBreak":true},{"text":"e yi naxan falama Yerusalɛn suxu lɔxɔni,","poem":1},{"lineBreak":true},{"text":"e naxa, “Ɛ a kala, ɛ taan naxɔri fefe!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I tan Babilɔn taana, i halagima nɛn fefe!","poem":1},{"lineBreak":true},{"text":"Sɛwan na kanna xa naxan i ya donla saranma","poem":1},{"lineBreak":true},{"text":"alo i a ligaxi nxu ra kii naxan yi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"naxanye ɛ dii futene tongoma","poem":1},{"lineBreak":true},{"text":"e yi e yigɔlɔn fanyen ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}