{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":138,"content":[{"type":"heading","content":["Ala tantun fena"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"Ala, n bata i tantun n bɔɲɛni fefe!","poem":1},{"lineBreak":true},{"text":"N bɛtin bama Ala yɛtagi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na n xinbi sinma i ya Banxi Sariɲanxin yɛtagi,","poem":1},{"lineBreak":true},{"text":"n yi i xinla tantun i ya hinanna nun i ya lannayana fe ra.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i bata i dɛ xuiin nafisa i xinla yɛtɛɛn xa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ni i xili waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"i n yabi nɛn,","poem":1},{"lineBreak":true},{"text":"i yi n sɛnbɛ so, i n xaxili ragidi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala, dunuɲa mangane birin i tantunma nɛn,","poem":1},{"lineBreak":true},{"text":"e na i ya falane mɛ waxatin naxan yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, e i kɛwanle matɔxɔma nɛn bɛtini,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i ya binyen gbo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hali Alatala to mate,","poem":1},{"lineBreak":true},{"text":"a yengi dɔxi muxu diɲaxine xɔn,","poem":1},{"lineBreak":true},{"text":"koni a yɛɛn tixi wasodene ra wulani.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xa n sigan tima tɔrɔni,","poem":1},{"lineBreak":true},{"text":"i n nakisima nɛn,","poem":1},{"lineBreak":true},{"text":"i yi n yaxune yɛngɛ i sɛnbɛni,","poem":1},{"lineBreak":true},{"text":"n kisi i sɛnbɛn xɔn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala feene raɲanma a faɲin nan ma n xa.","poem":1},{"lineBreak":true},{"text":"Alatala i ya hinanna luma nɛn habadan!","poem":1},{"lineBreak":true},{"text":"I nama i wali xɔnne rabeɲin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}