{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":139,"content":[{"type":"heading","content":["Ala ɲɔxɔ luxi adamadiine xɔn"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true},{"text":"Alatala, i bata n fɛsɛfɛsɛ, i n kolon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I n sa waxatin nun n keli waxatin birin kolon.","poem":1},{"lineBreak":true},{"text":"Hali i makuya n na, i n ma miriyane birin kolon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I a kolon n nɛma sigatini","poem":1},{"lineBreak":true},{"text":"hanma n nɛma saxi,","poem":1},{"lineBreak":true},{"text":"i n kɛwanle birin kolon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala, benun n xa falan ti waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n naxan falama i na kolon ki faɲi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I n nabilinni,","poem":1},{"lineBreak":true},{"text":"n yɛɛ ra e nun n xanbi ra.","poem":1},{"lineBreak":true},{"text":"N ni i tan nan yii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na fe kolonna magaxu n tan yɛɛ ra yi.","poem":1},{"lineBreak":true},{"text":"A dangu n na, n mi nɔɛ a yigbɛ mumɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N nɔɛ sigɛ minɛn,","poem":1},{"lineBreak":true},{"text":"n yi n luxun i ya Nii Sariɲanxin ma?","poem":1},{"lineBreak":true},{"text":"N sigan minɛn yi, n keli i tan yɛtagi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xa n te ariyanna yi, i na yi.","poem":1},{"lineBreak":true},{"text":"N na siga laxira yi, i na yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Hali n siga han sogetedeni,","poem":1},{"lineBreak":true},{"text":"hanma n sa dɔxɔ fɔxɔ igen xanbi ra,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"i tima nɛn n yɛɛ ra mɛnna fan yi,","poem":1},{"lineBreak":true},{"text":"i mi n nabeɲinɲɛ mumɛ!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xa n na a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“N xa n luxun dimini.","poem":1},{"lineBreak":true},{"text":"Kɛnɛnna xa findi kɔɛɛn na n nabilinni.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Koni sese mi dimin na i tan yɛɛ ra yi,","poem":1},{"lineBreak":true},{"text":"kɔɛni yalan alo yanyina i tan yɛɛ ra yi.","poem":1},{"lineBreak":true},{"text":"Dimin nun yanyin birin lan i tan xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"I tan nan n sɔndɔmɛn daxi,","poem":1},{"lineBreak":true},{"text":"i tan nan n saxi nga fatini.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala, n ni i tantunma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n da kiin magaxu,","poem":1},{"lineBreak":true},{"text":"i kɛwanle magaxu.","poem":1},{"lineBreak":true},{"text":"N na a kolon n niini ki faɲi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N fati bɛndɛn mi yi luxunxi i tan ma,","poem":1},{"lineBreak":true},{"text":"i to yi n nafalama suturani","poem":1},{"lineBreak":true},{"text":"i yi n dama nga kui waxatin naxan yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I yi n toma benun n fatin xa yelin nafalɛ.","poem":1},{"lineBreak":true},{"text":"I bata yi n ma siimayaan xasabin sɛbɛ i ya kitabun kui,","poem":1},{"lineBreak":true},{"text":"benun a xa fɔlɔ waxatin naxan yi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ala, i ya miriyane famu raxɔlɔ n xɔn.","poem":1},{"lineBreak":true},{"text":"E xasabin wuya!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa n na e yatɛ, e wuya mɛɲɛnsinna xa.","poem":1},{"lineBreak":true},{"text":"N na xulun waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n mɔn luma i tan nan fɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ala, a yi lan nun i xa muxu ɲaxine faxa!","poem":1},{"lineBreak":true},{"text":"Faxa tiine, ɛ masiga n na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"E fala ɲaxine tima, e i xili kala.","poem":1},{"lineBreak":true},{"text":"I yɛngɛfane i xinla falama fuun nin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatala, n mi muxune raɲaxuɛ ba","poem":1},{"lineBreak":true},{"text":"naxanye i raɲaxuma?","poem":1},{"lineBreak":true},{"text":"N bata n mɛ na muxune ra","poem":1},{"lineBreak":true},{"text":"naxanye murutɛxi i xili ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"E mi rafan n ma mumɛ!","poem":1},{"lineBreak":true},{"text":"N bata e yatɛ yaxune ra.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ala, n fɛsɛfɛsɛ i yi n bɔɲɛni feen kolon.","poem":1},{"lineBreak":true},{"text":"N mato, i yi n ma miriyane kolon.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A mato, xa n kira ɲaxin nan xɔn,","poem":1},{"lineBreak":true},{"text":"i siga n na habadan kira faɲin xɔn ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}