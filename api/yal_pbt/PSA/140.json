{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":140,"content":[{"type":"heading","content":["Ala maxandina xunbana fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n xunba muxu ɲaxine yii.","poem":1},{"lineBreak":true},{"text":"N natanga gbalotɔne ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E fe ɲaxi yitɔnna nin waxatin birin.","poem":1},{"lineBreak":true},{"text":"E yɛngɛ ralanna nin lɔxɔ yo lɔxɔ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fala xɔlɛne nan e lɛnne ma","poem":1},{"lineBreak":true},{"text":"alo saɲina.","poem":1},{"lineBreak":true},{"text":"E fala xuine xɔlɔ alo koson xɔlɛna.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala, n natanga muxu ɲaxine sɛnbɛn ma.","poem":1},{"lineBreak":true},{"text":"N nakisi gbalotɔne ma,","poem":1},{"lineBreak":true},{"text":"naxanye kataxi n nabira feen na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muxu wasoxine bata lutin nati n yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"E bata e gbatune rati kiraan xɔn ma n suxu xinla ma.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N bata a fala Alatala xa n naxa,","poem":1},{"lineBreak":true},{"text":"“N ma Ala nan i tan na.","poem":1},{"lineBreak":true},{"text":"Alatala n ma maxandi xuiin namɛ!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Marigina Alatala, n nakisi sɛnbɛna,","poem":1},{"lineBreak":true},{"text":"i n xun mayɛngɛma yɛngɛ so waxatini.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, i nama tin","poem":1},{"lineBreak":true},{"text":"muxu ɲaxine waxɔn feen yi liga.","poem":1},{"lineBreak":true},{"text":"I nama tin e fe nataxine yi kamali,","poem":1},{"lineBreak":true},{"text":"e yi waso ayi.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I nama tin n yaxune yi nɔɔn sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Ala xa n yaxune gbalo falane so e xun na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala xa tɛɛ wolonne bɔxɔn e ma.","poem":1},{"lineBreak":true},{"text":"Ala xa e woli ayi tɛɛni.","poem":1},{"lineBreak":true},{"text":"Ala xa e woli yinla kui","poem":1},{"lineBreak":true},{"text":"e mi nɔɛ tɛ naxan na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nafigine mi luma yamanani.","poem":1},{"lineBreak":true},{"text":"Ala xa yihadin so gbalotɔne xun na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N na a kolon","poem":1},{"lineBreak":true},{"text":"a Alatala kiti kɛndɛn sama tɔrɔ muxune xa,","poem":1},{"lineBreak":true},{"text":"a yi yiigelitɔne xun mayɛngɛ kitin sa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tinxin muxune i tantunma nɛn yati!","poem":1},{"lineBreak":true},{"text":"Muxu faɲine yi lu i yɛtagi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}