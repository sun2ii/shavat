{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":141,"content":[{"type":"heading","content":["Ala maxandina ɲinbanna ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"Alatala, n bata n xui ramini i ma,","poem":1},{"lineBreak":true},{"text":"fa n mali mafurɛn!","poem":1},{"lineBreak":true},{"text":"N na i xili, i tuli mati n na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ma maxandin xa lu","poem":1},{"lineBreak":true},{"text":"alo wusulanna i yɛtagi.","poem":1},{"lineBreak":true},{"text":"N yiine yitexin xa liga","poem":1},{"lineBreak":true},{"text":"alo ɲinbari ra saraxana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala i yengi dɔxɔ n fala xuiin xɔn,","poem":1},{"lineBreak":true},{"text":"i yi n dɛɛn kantan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I nama tin n bɔɲɛn yi lu fe ɲaxini,","poem":1},{"lineBreak":true},{"text":"n nama fe ɲaxine liga nxu nun fe ɲaxi rabane.","poem":1},{"lineBreak":true},{"text":"Nxu nama nxu dɛge nxu bode xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N tinma nɛn tinxin muxun yi n bɔnbɔ,","poem":1},{"lineBreak":true},{"text":"bayo hinanna na a ra.","poem":1},{"lineBreak":true},{"text":"A rafan n ma, a yi n kawandi.","poem":1},{"lineBreak":true},{"text":"Na luxi nɛn alo turen na susan n xunni.","poem":1},{"lineBreak":true},{"text":"N mi tondɛ na ma.","poem":1},{"lineBreak":true},{"text":"Koni n na Ala maxandima nɛn","poem":1},{"lineBreak":true},{"text":"fe ɲaxi rabane wanle xili ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E mangane radinma nɛn geyaan san bun fanyene ma,","poem":1},{"lineBreak":true},{"text":"muxu ɲaxine yi a kolon nayi","poem":1},{"lineBreak":true},{"text":"a ɲɔndin nan n ma falane ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xɛɛn bima kiin de,","poem":1},{"lineBreak":true},{"text":"bɔxɔn yi buxa,","poem":1},{"lineBreak":true},{"text":"nxu xɔnne xuyama ayi na kiini laxira so dɛɛn na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Marigina Alatala,","poem":1},{"lineBreak":true},{"text":"n yɛɛn tixi i tan nan na.","poem":1},{"lineBreak":true},{"text":"N na n luxunma i tan nin,","poem":1},{"lineBreak":true},{"text":"i nama tin n faxa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N natanga na lutine ma","poem":1},{"lineBreak":true},{"text":"e naxanye ratixi n yɛɛ ra","poem":1},{"lineBreak":true},{"text":"e nun fe ɲaxi rabane wosone.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala xa muxu ɲaxine suxu","poem":1},{"lineBreak":true},{"text":"e yɛtɛna luti ratixine ra,","poem":1},{"lineBreak":true},{"text":"koni n tan xa dangu bɔɲɛ xunbenli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}