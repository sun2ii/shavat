{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":142,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa fala ɲaxumɛna, a yi faranna ra waxatin naxan yi. Ala maxandina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N na n xui raminima Alatala ma,","poem":1},{"lineBreak":true},{"text":"n yi a mafan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N na n kɔntɔfili feene birin fala a xa,","poem":1},{"lineBreak":true},{"text":"n yi n ma tɔrɔne birin yita a ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɛkilɛn na ɲan n yi,","poem":1},{"lineBreak":true},{"text":"i tan n sigaden kolon.","poem":1},{"lineBreak":true},{"text":"N sigan tima kiraan naxan xɔn,","poem":1},{"lineBreak":true},{"text":"e bata woson nati n yɛɛ ra na xɔn ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N dɛxɔn to,","poem":1},{"lineBreak":true},{"text":"muxune mi e ɲɔxɔ luma n tan xɔn.","poem":1},{"lineBreak":true},{"text":"Luxunde yo mi fa n tan ma.","poem":1},{"lineBreak":true},{"text":"Muxu yo mi kɔntɔfilixi n ma fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alatala, n ni i tan nan mafanma.","poem":1},{"lineBreak":true},{"text":"N naxa, “I tan nan n luxunden na.","poem":1},{"lineBreak":true},{"text":"I tan nan findixi n gbeen na bɔxɔ xɔnna fari.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I tuli mati n ma mawuga xuiin na.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ n bata xadan.","poem":1},{"lineBreak":true},{"text":"N xunba n sagatan muxune yii.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ e sɛnbɛn gbo n xa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N namini kasoon na,","poem":1},{"lineBreak":true},{"text":"alogo n xa i xinla tantun.","poem":1},{"lineBreak":true},{"text":"Tinxin muxune yi n nabilin","poem":1},{"lineBreak":true},{"text":"bayo i bata fe faɲin naba n xa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}