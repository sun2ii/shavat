{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":143,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"Alatala, n ma maxandi xuiin namɛ!","poem":1},{"lineBreak":true},{"text":"I tuli mati n xuiin na.","poem":1},{"lineBreak":true},{"text":"N yabi i ya tinxinna nun i ya hinanna nin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I nama n tan i ya walikɛɛn makiti,","poem":1},{"lineBreak":true},{"text":"bayo muxu yo mi tinxin i tan yɛtagi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yaxuna n sagatanma,","poem":1},{"lineBreak":true},{"text":"a yi n nabira bɔxɔni,","poem":1},{"lineBreak":true},{"text":"a yi n lu dimini","poem":1},{"lineBreak":true},{"text":"alo muxu singe faxaxine.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɛkilɛn bata ɲan n yi,","poem":1},{"lineBreak":true},{"text":"n sɛnbɛ mi fa na sɔnɔn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na n mirima waxati danguxine ma.","poem":1},{"lineBreak":true},{"text":"I feen naxanye birin nabaxi,","poem":1},{"lineBreak":true},{"text":"n na n mirima ne ma,","poem":1},{"lineBreak":true},{"text":"n na n mirima i kɛwanle ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na n yiine tima i tan nan xa.","poem":1},{"lineBreak":true},{"text":"N niin xaraxi i yɛtagi","poem":1},{"lineBreak":true},{"text":"alo bɔxɔ xarena.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala, n yabi iki sa!","poem":1},{"lineBreak":true},{"text":"N niin ɲanmatɔɔn na a ra.","poem":1},{"lineBreak":true},{"text":"I nama i yɛtagin luxun n ma.","poem":1},{"lineBreak":true},{"text":"Xanamu n sama faxa muxune fari nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Benun xɔtɔnni,","poem":1},{"lineBreak":true},{"text":"i xa n yabi i ya hinanni.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ n na n yigi saxi i tan nin.","poem":1},{"lineBreak":true},{"text":"A yita n na","poem":1},{"lineBreak":true},{"text":"n lan n xa sigan ti","poem":1},{"lineBreak":true},{"text":"kiraan naxan xɔn.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ n na n niin taxuxi i tan nan na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, n xunba n yaxune yii.","poem":1},{"lineBreak":true},{"text":"N na n luxunxi i tan nan fɛma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N xaran i sagoon ligan ma,","poem":1},{"lineBreak":true},{"text":"bayo n ma Ala nan i ra.","poem":1},{"lineBreak":true},{"text":"I ya Nii faɲin xa n xali bɔxɔ faɲini.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala siimayaan fi n ma i xinla fe ra.","poem":1},{"lineBreak":true},{"text":"I xa n ba tɔrɔni i ya tinxinni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N yaxune dɛ xidi i ya hinanni.","poem":1},{"lineBreak":true},{"text":"N yɛngɛfane halagi,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i ya walikɛɛn nan n na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}