{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":144,"content":[{"type":"heading","content":["Mangana Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"Barikan bira Alatala xa,","poem":1},{"lineBreak":true},{"text":"n kantan muxuna,","poem":1},{"lineBreak":true},{"text":"naxan n maxaranma yɛngɛ sodeni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A tan nan hinanma n na,","poem":1},{"lineBreak":true},{"text":"n ma yinna,","poem":1},{"lineBreak":true},{"text":"n ma faran makantanxina,","poem":1},{"lineBreak":true},{"text":"n xunba muxuna,","poem":1},{"lineBreak":true},{"text":"e nun n yɛ masansan wure lefana.","poem":1},{"lineBreak":true},{"text":"N na n luxunma a tan nin.","poem":1},{"lineBreak":true},{"text":"A tan nan siyane luma n sanna bun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala, nanse muxun na","poem":1},{"lineBreak":true},{"text":"alogo i xa i ɲɔxɔ lu a xɔn?","poem":1},{"lineBreak":true},{"text":"Nanse adamadiin na","poem":1},{"lineBreak":true},{"text":"alogo i xa i miri a ma?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adamadiin luxi nɛn alo foyedina.","poem":1},{"lineBreak":true},{"text":"A siimayaan luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo nininna naxan danguma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, kuyen tintin, i godo.","poem":1},{"lineBreak":true},{"text":"I yiin din geyane ra,","poem":1},{"lineBreak":true},{"text":"e tutin xa te.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuye sarinne rasiga,","poem":1},{"lineBreak":true},{"text":"i yi yaxune raxuya ayi.","poem":1},{"lineBreak":true},{"text":"I ya xalimakunle woli,","poem":1},{"lineBreak":true},{"text":"i yi e kedi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I yiin nagodo keli kore,","poem":1},{"lineBreak":true},{"text":"i yi n ba tilinna ma.","poem":1},{"lineBreak":true},{"text":"N ba xɔɲɛne sɛnbɛn bun","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"naxanye wulen falama,","poem":1},{"lineBreak":true},{"text":"naxanye mi e fala xuine rakamalima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ala, n bɛti nɛnɛn bama nɛn i xa,","poem":1},{"lineBreak":true},{"text":"n yi i tantun kondenna ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A tan nan mangane rakisima.","poem":1},{"lineBreak":true},{"text":"A tan nan a walikɛɛn Dawuda rakisima silanfanna ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N xunba,","poem":1},{"lineBreak":true},{"text":"i n ba xɔɲɛne sɛnbɛn bun ma,","poem":1},{"lineBreak":true},{"text":"naxanye wulen falama,","poem":1},{"lineBreak":true},{"text":"naxanye mi e fala xuine rakamalima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ala xa en ma dii xɛmɛne rasabati","poem":1},{"lineBreak":true},{"text":"alo wudi binle.","poem":1},{"lineBreak":true},{"text":"Ala xa en ma dii tɛmɛne xa tofanɲɛ ayi","poem":1},{"lineBreak":true},{"text":"alo gɛmɛ sɛnbɛtɛn nayabuxin","poem":1},{"lineBreak":true},{"text":"naxanye manga banxine bun.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ala xa en ma sagane rafe donseen sifan birin na.","poem":1},{"lineBreak":true},{"text":"Ala xa en ma xuruseene rawuya ayi xɛɛn ma,","poem":1},{"lineBreak":true},{"text":"dɔxɔɲa ma wuli keden han wuli fu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala xa en ma ɲingene rasabati.","poem":1},{"lineBreak":true},{"text":"Ala xa en tanga yɛngɛn ma","poem":1},{"lineBreak":true},{"text":"alogo muxe nama suxu,","poem":1},{"lineBreak":true},{"text":"wuga xuiin yi te taani.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sɛwan na yamaan xa,","poem":1},{"lineBreak":true},{"text":"na feene ligama naxanye xa.","poem":1},{"lineBreak":true},{"text":"Sɛwan na yamaan xa,","poem":1},{"lineBreak":true},{"text":"naxanye Ala findixi Alatala ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}