{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":145,"content":[{"type":"heading","content":["Tantun bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Dawuda Ala tantunna.","descriptive":true},{"text":"N ma Ala, n ma mangana,","poem":1},{"lineBreak":true},{"text":"n ni i batuma.","poem":1},{"lineBreak":true},{"text":"N barikan birama i xa nɛn","poem":1},{"lineBreak":true},{"text":"habadan han habadan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lɔxɔ yo lɔxɔ n barikan birɛ i xa.","poem":1},{"lineBreak":true},{"text":"N ni i xinla tantunma nɛn","poem":1},{"lineBreak":true},{"text":"habadan han habadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alatala gbo, a lan a yi tantun.","poem":1},{"lineBreak":true},{"text":"A gboon dan mi na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mayixɛtɛne birin xa i ya wanle fe fala","poem":1},{"lineBreak":true},{"text":"mayixɛtɛ famatɔne xa,","poem":1},{"lineBreak":true},{"text":"e yi i kɛwanle fe yɛba e xa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E i ya binye gbeen nun nɔrɔna fe fala.","poem":1},{"lineBreak":true},{"text":"N luma nɛn n mirɛ i ya kabanako wanle ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E xa i sɛnbɛ magaxuxina fe fala.","poem":1},{"lineBreak":true},{"text":"N tan i ya gbona fe falama nɛn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E xa i ya nɛmana fe fala,","poem":1},{"lineBreak":true},{"text":"e yi i ya tinxinna fe rali sɛwani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala diɲa, a kininkinin,","poem":1},{"lineBreak":true},{"text":"a mi xɔlɔn xulɛn, a hinanna gbo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala fe faɲin nabama muxun birin xa.","poem":1},{"lineBreak":true},{"text":"A kininkininma a daala birin ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala, i ya dali seene birin i tantunma nɛn.","poem":1},{"lineBreak":true},{"text":"I ya tɔgɔndiya muxune birin barikan birama i xa nɛn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E i ya mangayaan binyena fe falama nɛn.","poem":1},{"lineBreak":true},{"text":"E mɔn yi i sɛnbɛna fe yɛba","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"alogo muxun birin xa i kɛwanle kolon,","poem":1},{"lineBreak":true},{"text":"e nun i ya mangayaan binye gbeena.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I ya mangayaan findixi habadan mangayaan nan na.","poem":1},{"lineBreak":true},{"text":"I sɛnbɛn luma nɛn mayixɛtɛne nun mayixɛtɛne xun na.","poem":1},{"lineBreak":true},{"text":"Ala a dɛ xuine birin nakamalima,","poem":1},{"lineBreak":true},{"text":"a hinan a daala birin na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatala ne malima nɛn","poem":1},{"lineBreak":true},{"text":"naxanye biraxi,","poem":1},{"lineBreak":true},{"text":"a yi muxune rakeli","poem":1},{"lineBreak":true},{"text":"naxanye felenxi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Birin yɛɛn tixi i tan nan na","poem":1},{"lineBreak":true},{"text":"alogo i xa donseen so e yii a waxatini.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I tan nan i yiin nabima,","poem":1},{"lineBreak":true},{"text":"i yi donseen so niimaseene birin yii.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala feen birin ligama tinxinna nin.","poem":1},{"lineBreak":true},{"text":"A hinan a kɛwanle birin yi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alatala maso na muxune ra","poem":1},{"lineBreak":true},{"text":"naxanye a xilima,","poem":1},{"lineBreak":true},{"text":"naxanye birin a xilima ɲɔndini.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A a yɛɛragaxu muxune rafan feene ligama nɛn,","poem":1},{"lineBreak":true},{"text":"a e xuiin mɛ, a yi e rakisi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatala muxune kantanma","poem":1},{"lineBreak":true},{"text":"a rafan naxanye birin ma.","poem":1},{"lineBreak":true},{"text":"Koni a muxu ɲaxine birin halagima nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"N na Alatala tantunma nɛn.","poem":1},{"lineBreak":true},{"text":"Dali seene birin xa a xili sariɲanxin tantun","poem":1},{"lineBreak":true},{"text":"habadan han habadan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}