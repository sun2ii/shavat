{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"heading","content":["Ala nan sɛnbɛtarene kantanma"]},{"type":"verse","number":1,"content":[{"text":"Tantunna Ala xa!","poem":1},{"lineBreak":true},{"text":"N xa Alatala tantun n niini fefe!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fanni n na n nii ra,","poem":1},{"lineBreak":true},{"text":"n na Alatala tantunma nɛn.","poem":1},{"lineBreak":true},{"text":"Fanni n daxi,","poem":1},{"lineBreak":true},{"text":"n na n ma Ala tantunma nɛn bɛtini.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ nama ɛ yigi sa mangane yi,","poem":1},{"lineBreak":true},{"text":"adamadiine nan ne ra.","poem":1},{"lineBreak":true},{"text":"Ɛ rakisi fɛrɛ yo mi ne xa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E na faxa, e xɛtɛma nɛn bɛndɛni.","poem":1},{"lineBreak":true},{"text":"E fe yitɔnxine birin kalama na lɔxɔn yɛtɛɛn nin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sɛwan na kanna xa,","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala muxun naxan malima,","poem":1},{"lineBreak":true},{"text":"naxan a yigin sama Alatala yi, a Ala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"A tan nan ariyanna nun dunuɲa daxi","poem":1},{"lineBreak":true},{"text":"e nun e yi seene birin.","poem":1},{"lineBreak":true},{"text":"A tinxinyaan luma nɛn han habadan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A tan nan kiti kɛndɛn sama muxu ɲaxankataxine xa,","poem":1},{"lineBreak":true},{"text":"a donseen so kamɛtɔne yii.","poem":1},{"lineBreak":true},{"text":"Alatala nan kasorasane xunbama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala nan danxutɔne yɛɛne rabama ayi.","poem":1},{"lineBreak":true},{"text":"A tan nan muxu mafelenxine rakelima.","poem":1},{"lineBreak":true},{"text":"Tinxin muxune rafan Alatala ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala nan xɔɲɛne kantanma.","poem":1},{"lineBreak":true},{"text":"A kaɲa gilɛne nun kiridine mali.","poem":1},{"lineBreak":true},{"text":"Koni a muxu ɲaxine fe yitɔnxine kalama nɛn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala nan habadan mangan na.","poem":1},{"lineBreak":true},{"text":"Siyon, a tan nan i ya Ala ra","poem":1},{"lineBreak":true},{"text":"habadan han habadan.","poem":1},{"lineBreak":true},{"text":"Tantunna Ala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}