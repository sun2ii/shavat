{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":147,"content":[{"type":"heading","content":["Ala tantun fena"]},{"type":"verse","number":1,"content":[{"text":"Tantunna Alatala xa!","poem":1},{"lineBreak":true},{"text":"A lan tantun bɛtin xa ba en ma Ala xa.","poem":1},{"lineBreak":true},{"text":"Fe faɲin nan a tantunna ra e nun sɛwana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala mɔn Yerusalɛn tima nɛn.","poem":1},{"lineBreak":true},{"text":"A mɔn fama na muxu suxine ra nɛn","poem":1},{"lineBreak":true},{"text":"Isirayila kaan naxanye bata yi xuya ayi nun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A muxune dandan","poem":1},{"lineBreak":true},{"text":"naxanye bɔɲɛye kalaxi.","poem":1},{"lineBreak":true},{"text":"A yi e maxɔlɔdene maxidi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A tan nan sarene xasabin nagidima,","poem":1},{"lineBreak":true},{"text":"a yi e birin xili sa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nxu Marigin gbo,","poem":1},{"lineBreak":true},{"text":"a sɛnbɛn magaxu.","poem":1},{"lineBreak":true},{"text":"A xaxilimayaan dan mi na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala muxu limaniyaxine malima nɛn.","poem":1},{"lineBreak":true},{"text":"Koni a muxu ɲaxine rabirama nɛn bɔxɔni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɛ barika bira bɛtin ba Alatala xa.","poem":1},{"lineBreak":true},{"text":"Ɛ tantun bɛtin ba en ma Ala xa bɔlɔnna ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A tan nan kundani fulunxi kore xɔnna ma.","poem":1},{"lineBreak":true},{"text":"A yi tulen nafa bɔxɔni.","poem":1},{"lineBreak":true},{"text":"A yi sɛxɛn nasoli geyane ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A xuruseene balon nagidi e ma.","poem":1},{"lineBreak":true},{"text":"A xɔline dɛge","poem":1},{"lineBreak":true},{"text":"e na e xui ramini a ma waxatin naxan yi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Soo kɛndɛne xa mi a kɛnɛnma.","poem":1},{"lineBreak":true},{"text":"A mi sɛwama muxun sɛnbɛn fan na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koni naxanye gaxuxi Alatala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e xaxili tixi a hinanna ra,","poem":1},{"lineBreak":true},{"text":"ne nan a rasɛwama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yerusalɛn kaane, ɛ Alatala binya.","poem":1},{"lineBreak":true},{"text":"Siyon kaane, ɛ Ala tantun.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Amasɔtɔ a bata taan so dɛɛn sɛnbɛ so,","poem":1},{"lineBreak":true},{"text":"a yi taa yi kaane baraka.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A tan nan bɔɲɛ xunbenla fima ɛ yamanan ma,","poem":1},{"lineBreak":true},{"text":"a balo faɲin fi ɛ ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A yi a dɛ xui tongoxine rafa bɔxɔn ma,","poem":1},{"lineBreak":true},{"text":"a falan yi siga ayi mafurɛn.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A kundani fulun","poem":1},{"lineBreak":true},{"text":"alo dugi fixɛna,","poem":1},{"lineBreak":true},{"text":"a ige xundin xuya bɔxɔn ma","poem":1},{"lineBreak":true},{"text":"alo xubena,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"a balabalan kɛsɛn nagodo.","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ a xunbenla raxanɲɛ?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koni a falan ti nɛn,","poem":1},{"lineBreak":true},{"text":"ige xundin yi xuya ayi.","poem":1},{"lineBreak":true},{"text":"A foyen nafa, igene yi godo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A yi a falane makɛnɛn Yaxuba bɔnsɔnna xɔn.","poem":1},{"lineBreak":true},{"text":"A bata tɔnne nun sariyane sɛbɛ Isirayila xa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A mi na ɲɔxɔnna ligaxi siya gbɛtɛ yo xa.","poem":1},{"lineBreak":true},{"text":"E mi a sariyane kolon.","poem":1},{"lineBreak":true},{"text":"Tantunna Alatala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}