"poem":1},{"lineBreak":true},{"text":"e nun ɛ tan","poem":1},{"lineBreak":true},{"text":"igen naxanye kore walaxan fari.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ Alatala xinla tantun!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ e daxi a yamarin nan bun ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A yi e ti e funfuni habadan han habadan.","poem":1},{"lineBreak":true},{"text":"A yi yamarin fi","poem":1},{"lineBreak":true},{"text":"naxan mi matandɛ mumɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɛ Alatala tantun bɔxɔ xɔnna fari,","poem":1},{"lineBreak":true},{"text":"ɛ tan ige yi sube magaxuxine,","poem":1},{"lineBreak":true},{"text":"ɛ tan fɔxɔ igen tilinne,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kuye sarinna, balabalan kɛsɛna,","poem":1},{"lineBreak":true},{"text":"kundaan nun ige xundina,","poem":1},{"lineBreak":true},{"text":"foye gbeen naxan a falan suxu,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ɛ tan geyane nun yire matexine,","poem":1},{"lineBreak":true},{"text":"wudi bogilane nun sumanne birin,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"burunna subene nun xuruseene,","poem":1},{"lineBreak":true},{"text":"xɔline nun bubu seene,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"bɔxɔn mangane nun siyane birin,","poem":1},{"lineBreak":true},{"text":"ɛ tan kuntigine","poem":1},{"lineBreak":true},{"text":"nun kitisaan naxanye birin bɔxɔn ma,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"banxulanne nun sungutunne,","poem":1},{"lineBreak":true},{"text":"xɛmɛ fonne nun dii ɲɔrɛne,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ɛ birin xa Alatala xinla tantun!","poem":1},{"lineBreak":true},{"text":"A xili keden peen nan binyaxi.","poem":1},{"lineBreak":true},{"text":"A tan nan nɔɔn nabama bɔxɔn nun koren xun na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A bata a tɔgɔndiya muxune sɛnbɛ so.","poem":1},{"lineBreak":true},{"text":"Isirayila muxune rafan a ma han!","poem":1},{"lineBreak":true},{"text":"Tantunna Alatala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}