{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":149,"content":[{"type":"heading","content":["Tantun bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Tantunna Ala xa!","poem":1},{"lineBreak":true},{"text":"Ɛ bɛti nɛnɛn ba Alatala xa.","poem":1},{"lineBreak":true},{"text":"Ɛ a tantun a tɔgɔndiya muxune malanni.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isirayila muxune, ɛ sɛwa,","poem":1},{"lineBreak":true},{"text":"a tan nan ɛ daxi.","poem":1},{"lineBreak":true},{"text":"Siyon muxune xa ɲaxan e mangan na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E xa e bodon,","poem":1},{"lineBreak":true},{"text":"e yi Ala tantun,","poem":1},{"lineBreak":true},{"text":"e tanbanna nun bɔlɔnna maxa a xa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatalaa muxune a kɛnɛnxi,","poem":1},{"lineBreak":true},{"text":"naxanye limaniyaxi,","poem":1},{"lineBreak":true},{"text":"a ne rakisima nɛn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tɔgɔndiya muxune xa ɲaxan,","poem":1},{"lineBreak":true},{"text":"e binyen fi Ala ma,","poem":1},{"lineBreak":true},{"text":"e sɔnxɔ sɛwani e sadene ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E xa lu Ala tantunɲɛ,","poem":1},{"lineBreak":true},{"text":"e yi silanfan dɛ firin kanna suxu e yii,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"e e gbeen ɲɔxɔ siyane ra,","poem":1},{"lineBreak":true},{"text":"e siya gbɛtɛne ɲaxankata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E yi yɔlɔnxɔnna sa e mangane ma,","poem":1},{"lineBreak":true},{"text":"e yi e kuntigine xidi wuren na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E yi e ɲaxankata","poem":1},{"lineBreak":true},{"text":"alo e yalagi feen sɛbɛxi kii naxan yi.","poem":1},{"lineBreak":true},{"text":"A tɔgɔndiya muxune birin ma xunna kenla nan na ra.","poem":1},{"lineBreak":true},{"text":"Tantunna Alatala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}