{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":15,"content":[{"type":"heading","content":["Alaa muxuna"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"Alatala nde nɔɛ luyɛ i ya yire sariɲanxini?","poem":1},{"lineBreak":true},{"text":"Nde luyɛ i ya geya sariɲanxin fari?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Fɛ mi naxan kɛwanle ra,","poem":1},{"lineBreak":true},{"text":"a tinxin, a ɲɔndin falama","poem":1},{"lineBreak":true},{"text":"fata a sɔndɔmɛn na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mi bonne xili kalama,","poem":1},{"lineBreak":true},{"text":"a mi fe ɲaxi yo ligama a dɔxɔ boden na,","poem":1},{"lineBreak":true},{"text":"a mɔn mi a rayagima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala bata naxanye raɲaxu,","poem":1},{"lineBreak":true},{"text":"a mɛma nɛn ne ra.","poem":1},{"lineBreak":true},{"text":"Koni a Alatala yɛɛragaxu muxune binyama nɛn.","poem":1},{"lineBreak":true},{"text":"Hali a tɔrɔ,","poem":1},{"lineBreak":true},{"text":"a fala xuiin nakamalima nɛn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A muxune dolima","poem":1},{"lineBreak":true},{"text":"koni e mi se sama a fari a raxɛtɛdeni.","poem":1},{"lineBreak":true},{"text":"A mi dimi yi seene rasuxuma","poem":1},{"lineBreak":true},{"text":"alogo a xa wulen sa sɔntaren xun ma.","poem":1},{"lineBreak":true},{"text":"Naxan na feni itoe liga,","poem":1},{"lineBreak":true},{"text":"na mi mamaxɛ mumɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}