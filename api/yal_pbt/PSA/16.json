{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":16,"content":[{"type":"heading","content":["Ala maxandina yigina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawuda Ala maxandi faɲina.","descriptive":true},{"text":"Ala, n kantan,","poem":1},{"lineBreak":true},{"text":"bayo n bata n luxun i yi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N bata a fala Alatala xa, n naxa,","poem":1},{"lineBreak":true},{"text":"“N Marigin nan i tan na.","poem":1},{"lineBreak":true},{"text":"Se faɲi gbɛtɛ mi n yii ba i tan na.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N sɛwaxi","poem":1},{"lineBreak":true},{"text":"yamanan muxu sariɲanxi gbeene nan ma fe ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Naxanye suxurene batuma,","poem":1},{"lineBreak":true},{"text":"ne tɔrɔyaan gboma ayi nɛn.","poem":1},{"lineBreak":true},{"text":"Koni n tan mi saraxan bɛ e xa,","poem":1},{"lineBreak":true},{"text":"n dɛ mi e xinle falɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, i tan nan keden pe n yii,","poem":1},{"lineBreak":true},{"text":"i maragidi faɲin fima n ma.","poem":1},{"lineBreak":true},{"text":"N ma dunuɲa yi gidina i tan nan yii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala naxan soxi n yii,","poem":1},{"lineBreak":true},{"text":"na rafan n ma,","poem":1},{"lineBreak":true},{"text":"n bata sɛwa n ma kɛɛ sɔtɔxin na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N barikan birama Alatala xa","poem":1},{"lineBreak":true},{"text":"naxan n kawandima.","poem":1},{"lineBreak":true},{"text":"Hali kɔɛɛn na, n xaxili sɔtɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N xaxili Alatala xɔn ma waxatin birin,","poem":1},{"lineBreak":true},{"text":"bayo a n dɛxɔn ma,","poem":1},{"lineBreak":true},{"text":"sese mi n mamaxɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nanara, n bɔɲɛn sɛwaxi,","poem":1},{"lineBreak":true},{"text":"n niin yi yifan n ma,","poem":1},{"lineBreak":true},{"text":"n yi n matabu bɔɲɛ xunbenli.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amasɔtɔ, i mi i mɛ n na,","poem":1},{"lineBreak":true},{"text":"n siga laxira yi.","poem":1},{"lineBreak":true},{"text":"I mi tinɲɛ","poem":1},{"lineBreak":true},{"text":"i ya muxu tɔgɔndiyaxin yi kun gaburun kui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I nii rakisi kiraan yitama n na nɛn,","poem":1},{"lineBreak":true},{"text":"nanara n sɛwama nɛn i yɛtagi han!","poem":1},{"lineBreak":true},{"text":"Nii fanna mi ɲanɲɛ i dɛxɔn ma habadan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}