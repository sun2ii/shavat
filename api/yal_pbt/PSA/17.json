{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":17,"content":[{"type":"heading","content":["Sɔntarene Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa Ala maxandina.","descriptive":true},{"text":"Alatala, n ma maxandin namɛ tinxinyana fe ra.","poem":1},{"lineBreak":true},{"text":"I tuli mati n wuga xuiin na!","poem":1},{"lineBreak":true},{"text":"I tuli mati n ma maxandi xuiin na,","poem":1},{"lineBreak":true},{"text":"wule mi naxan yi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I n xun mafala kitin bolon","poem":1},{"lineBreak":true},{"text":"amasɔtɔ naxan tinxin,","poem":1},{"lineBreak":true},{"text":"i na kolon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I na n bɔɲɛni feene fɛsɛfɛsɛ,","poem":1},{"lineBreak":true},{"text":"i na n nakɔrɔsi kɔɛɛn na,","poem":1},{"lineBreak":true},{"text":"i na n kɛɲaan fɛsɛfɛsɛ,","poem":1},{"lineBreak":true},{"text":"i mi fɛ yo toɛ n na.","poem":1},{"lineBreak":true},{"text":"N mi tinɲɛ","poem":1},{"lineBreak":true},{"text":"fala ɲaxin yi mini n dɛ","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"alo muxu gbɛtɛne kɛwanle kii naxan yi.","poem":1},{"lineBreak":true},{"text":"N bata i ya yamarin suxu.","poem":1},{"lineBreak":true},{"text":"N mɔn mi biraxi gbalotɔne kirane fɔxɔ ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N sigan tima i ya kirane nan xɔn ma tun,","poem":1},{"lineBreak":true},{"text":"han iki, n munma dagalanɲɛ ayi singen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ala, n na i maxandima","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i n yabima nɛn,","poem":1},{"lineBreak":true},{"text":"nanara i firifiri n xɔn ma,","poem":1},{"lineBreak":true},{"text":"i yi i tuli mati n ma maxandi xuiin na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I ya kabanako hinanna yita nxu ra,","poem":1},{"lineBreak":true},{"text":"i tan naxan muxune rakisima e yaxune ma","poem":1},{"lineBreak":true},{"text":"naxan na a luxun i yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N natanga alo i yɛɛne.","poem":1},{"lineBreak":true},{"text":"N luxun","poem":1},{"lineBreak":true},{"text":"alo tɔxɛ diin soma a nga gabutɛne bun ma kii naxan yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nanara, muxu ɲaxine mi n liyɛ,","poem":1},{"lineBreak":true},{"text":"n yaxu ɲaxin naxanye n nabilinni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kininkinin yo mi e yi,","poem":1},{"lineBreak":true},{"text":"e falan tima yandan na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E bata fa n fɔxɔ ra iki,","poem":1},{"lineBreak":true},{"text":"e n nabilinni.","poem":1},{"lineBreak":true},{"text":"E yɛɛne tixi n na e fɛrɛn fenma","poem":1},{"lineBreak":true},{"text":"e n nabira bɔxɔni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E ligaxi alo yatana","poem":1},{"lineBreak":true},{"text":"xɔɔyi se xɔnla naxan na,","poem":1},{"lineBreak":true},{"text":"alo yata gbeen naxan n legedenma luxunni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Keli Alatala!","poem":1},{"lineBreak":true},{"text":"N yaxune yɛngɛ, i yi e nɔ.","poem":1},{"lineBreak":true},{"text":"N natanga muxu ɲaxine ma i ya silanfanna ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala, n natanga na dunuɲa muxu sifane ma","poem":1},{"lineBreak":true},{"text":"naxanye e kɔntɔnna sɔtɔma e siimayani.","poem":1},{"lineBreak":true},{"text":"E ralugo na kɔntɔnna ra ken","poem":1},{"lineBreak":true},{"text":"i naxan namaraxi e xa,","poem":1},{"lineBreak":true},{"text":"e diine fan xa wasa a ra,","poem":1},{"lineBreak":true},{"text":"a dɔnxɛn mɔn yi lu e mamandenne xa!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Koni n na i yɛtagin toma nɛn tinxinni,","poem":1},{"lineBreak":true},{"text":"n na xulun, n wasa i yɛtagin na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}