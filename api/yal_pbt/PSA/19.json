{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":19,"content":[{"type":"heading","content":["Alaa nɔrɔn nun a sariyana"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Kore xɔnna nan Ala a nɔrɔn mayitama.","poem":1},{"lineBreak":true},{"text":"Koren nan Ala a wanla makɛnɛnma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yanyin kawandin bama lɔxɔ yo lɔxɔ.","poem":1},{"lineBreak":true},{"text":"Dimin xaxili fima kɔɛ yo kɔɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xui yati mi a ra,","poem":1},{"lineBreak":true},{"text":"falane fan mi a ra.","poem":1},{"lineBreak":true},{"text":"Tunla mi e xuiin mɛma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Koni, hali na,","poem":1},{"lineBreak":true},{"text":"e fala xuiin bɔxɔn birin lima,","poem":1},{"lineBreak":true},{"text":"e falane yi siga han dunuɲa danna.","poem":1},{"lineBreak":true},{"text":"Ala nan banxin nafalaxi sogen xa kore.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sogen minima nɛn","poem":1},{"lineBreak":true},{"text":"alo xɛmɛn naxan minima a banxini","poem":1},{"lineBreak":true},{"text":"siga futu xidideni,","poem":1},{"lineBreak":true},{"text":"alo fangamaan naxan sigan tima a yɛtɛna a kiraan xɔn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A minima sogetedeni,","poem":1},{"lineBreak":true},{"text":"a sa ɲan sogegododeni.","poem":1},{"lineBreak":true},{"text":"Sese mi luxunɲɛ a xɔlɔn ma.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatalaa sariyan kamalixi,","poem":1},{"lineBreak":true},{"text":"a muxun nii yifanma a ma.","poem":1},{"lineBreak":true},{"text":"Ɲɔndin nan Alatalaa maxadi xuine ra.","poem":1},{"lineBreak":true},{"text":"E xaxilitarene findima xaxilimane ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala fe ragidixine tinxin.","poem":1},{"lineBreak":true},{"text":"A muxun bɔɲɛn nasɛwama nɛn.","poem":1},{"lineBreak":true},{"text":"Alatalaa yamarine nɔrɔxi.","poem":1},{"lineBreak":true},{"text":"A muxun xaxinla rabima nɛn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala a yɛɛragaxun sariɲan.","poem":1},{"lineBreak":true},{"text":"A buma habadan.","poem":1},{"lineBreak":true},{"text":"Ɲɔndin nan Alatalaa kitine ra,","poem":1},{"lineBreak":true},{"text":"e tinxin feu!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E fisa xɛmaan xa,","poem":1},{"lineBreak":true},{"text":"e fan xɛma faɲine birin xa.","poem":1},{"lineBreak":true},{"text":"E ɲaxun kumin xa,","poem":1},{"lineBreak":true},{"text":"dangu kumi xinden na.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":12,"content":[{"text":"I ya walikɛɛn xaxili sɔtɔma nɛn e xɔn.","poem":1},{"lineBreak":true},{"text":"A tɔnɔn gbegbe sɔtɔma nɛn e xɔn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nde nɔɛ a yɛtɛna tantanne birin kolonɲɛ?","poem":1},{"lineBreak":true},{"text":"I xa n ma hakɛ luxunxine mafelu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N natanga tondin ma,","poem":1},{"lineBreak":true},{"text":"a nama n nɔ.","poem":1},{"lineBreak":true},{"text":"Nayi, n findima muxu dɛfexin na nɛn","poem":1},{"lineBreak":true},{"text":"naxan mi matandi ɲaxin tiyɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Falan naxanye minima n dɛ,","poem":1},{"lineBreak":true},{"text":"e nun miriyaan naxanye n bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"Alatala xa ne rasuxu sɛwani,","poem":1},{"lineBreak":true},{"text":"n kantan fanyena","poem":1},{"lineBreak":true},{"text":"e nun n xunbamana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":15}