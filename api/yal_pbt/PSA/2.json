{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":2,"content":[{"type":"heading","content":["Alaa manga sugandixina"]},{"type":"verse","number":1,"content":[{"text":"Nanfera siyane murutɛma?","poem":1},{"lineBreak":true},{"text":"Nanfera yamanane muxune yanfa fuune soma?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dunuɲa mangane bata tondi,","poem":1},{"lineBreak":true},{"text":"kuntigine bata e malan","poem":1},{"lineBreak":true},{"text":"Alatala nun a muxu sugandixin xili ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E naxa, “En xa en yɛtɛ ba e nɔɔn bun,","poem":1},{"lineBreak":true},{"text":"en xa en xunna ba e yamarin bun.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Marigin naxan ariyanna yi","poem":1},{"lineBreak":true},{"text":"na gelema e ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A fitinaxin yi falan ti e xili ma,","poem":1},{"lineBreak":true},{"text":"a e magaxu a xɔlɔni,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"a naxa, “N bata n ma mangan dɔxɔ","poem":1},{"lineBreak":true},{"text":"n ma geya sariɲanxin fari Siyon yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mangan fan naxa,","poem":1},{"lineBreak":true},{"text":"“Alatala bata naxan nagidi,","poem":1},{"lineBreak":true},{"text":"n na a ralima nɛn:","poem":1},{"lineBreak":true},{"text":"a naxa n na,","poem":1},{"lineBreak":true},{"text":"‘N ma dii xɛmɛn nan i tan na.","poem":1},{"lineBreak":true},{"text":"N bata findi i fafe ra to.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N maxɔdin,","poem":1},{"lineBreak":true},{"text":"n siyane soma nɛn i yii i kɛɛn na,","poem":1},{"lineBreak":true},{"text":"bɔxɔn danne birin yi findi i gbeen na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I e nɔma nɛn mangaya wure dunganna ra,","poem":1},{"lineBreak":true},{"text":"i yi e rayensenɲɛ ayi alo fɛɲɛna.’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nayi, ɛ tan mangane,","poem":1},{"lineBreak":true},{"text":"ɛ xaxili fen.","poem":1},{"lineBreak":true},{"text":"Ɛ tan dunuɲa kuntigine,","poem":1},{"lineBreak":true},{"text":"ɛ kawandin namɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛ Alatala batu, ɛ gaxu a yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"ɛ sɛwa, ɛ xuruxurun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɛ dii xɛmɛn mafan,","poem":1},{"lineBreak":true},{"text":"alogo a nama xɔlɔ, a yi ɛ raxɔri.","poem":1},{"lineBreak":true},{"text":"Bayo, a bɔɲɛn mafura tɛ.","poem":1},{"lineBreak":true},{"text":"Sɛwan ne xa, naxanye e yigiya a ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}