{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":20,"content":[{"type":"heading","content":["Ala xa mangan baraka"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala xa i yabi","poem":1},{"lineBreak":true},{"text":"i tɔrɔni waxatin naxan yi.","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala xa i ratanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala xa a maliin nagodo i ma","poem":1},{"lineBreak":true},{"text":"keli a yire sariɲanxini,","poem":1},{"lineBreak":true},{"text":"a xa i mali keli Siyon Geyaan fari.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala xa i ya kiseene birin nasuxu,","poem":1},{"lineBreak":true},{"text":"a mɔn yi sɛwa i ya saraxa gan daxine birin na.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":5,"content":[{"text":"Ala xa i bɔɲɛn waxɔn feene so i yii,","poem":1},{"lineBreak":true},{"text":"a mɔn yi i ya fe yitɔnxine birin nasabati.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanara, nxu sɔnxɔɛ sɛwani i ya nɔ sɔtɔna fe ra.","poem":1},{"lineBreak":true},{"text":"En yi en gbee taxamaseri dugine rate Ala xinli.","poem":1},{"lineBreak":true},{"text":"Alatala xa tin i ya maxandin birin ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N na a kolon yati,","poem":1},{"lineBreak":true},{"text":"Alatalaa muxu sugandixin nakisima nɛn.","poem":1},{"lineBreak":true},{"text":"A a yabima nɛn","poem":1},{"lineBreak":true},{"text":"keli a ariyanna sariɲanxini,","poem":1},{"lineBreak":true},{"text":"a yi a rakisi a sɛnbɛn na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndee yigin sama e yɛngɛ so wontoroni,","poem":1},{"lineBreak":true},{"text":"bonne yi e yigin sa e soone yi,","poem":1},{"lineBreak":true},{"text":"koni en tan yigin saxi Alatala xinla nin,","poem":1},{"lineBreak":true},{"text":"en ma Ala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na kanne tantanma nɛn e bira,","poem":1},{"lineBreak":true},{"text":"koni en tan kelima nɛn, en ti ken!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala xa mangan nakisi!","poem":1},{"lineBreak":true},{"text":"I xa nxu yabi,","poem":1},{"lineBreak":true},{"text":"nxu na i maxandi waxatin naxan yi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}