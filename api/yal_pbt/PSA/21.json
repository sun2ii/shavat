{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":21,"content":[{"type":"heading","content":["Ala tantunna mangan xɔn"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, mangan bata sɛwa i fangan na.","poem":1},{"lineBreak":true},{"text":"A sɛwan gbo bayo i bata a rakisi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A waxi naxan xɔn, i tinxi na ma.","poem":1},{"lineBreak":true},{"text":"I bata a maxandin yabi.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":4,"content":[{"text":"I bata a rasɛnɛ duba faɲine ra,","poem":1},{"lineBreak":true},{"text":"i mɔn yi xɛma mangaya taxamasenna so a xun na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A maxɔdinna ti nɛn a siimayana fe ra,","poem":1},{"lineBreak":true},{"text":"i yi sii xunkuyen so a yii,","poem":1},{"lineBreak":true},{"text":"naxan luma habadan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A binyen bata gbo ayi fata i ya marakisin na.","poem":1},{"lineBreak":true},{"text":"I nɔrɔn nun xunnayerenna fixi nɛn a ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I a barakama habadan!","poem":1},{"lineBreak":true},{"text":"I a ralugoma sɛwan na i yɛtagi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bayo Mangan yigin saxi Alatala nin,","poem":1},{"lineBreak":true},{"text":"a kantanxi Kore Xɔnna Ala hinanna nan baraka yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I tan i yaxune birin suxuma nɛn.","poem":1},{"lineBreak":true},{"text":"Naxanye i raɲaxuxi,","poem":1},{"lineBreak":true},{"text":"i ne suxuma nɛn i fangan na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I na mini kɛnɛnni waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"i e ɲanma nɛn alo sulun tɛɛna.","poem":1},{"noteId":2},{"lineBreak":true},{"text":"Alatala xɔlɔxina e halagima nɛn","poem":1},{"lineBreak":true},{"text":"tɛɛn yi e gan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I e yixɛtɛne raxɔrima nɛn dunuɲa yi,","poem":1},{"lineBreak":true},{"text":"e nun e bɔnsɔnne adamadiine yɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hali e fe ɲaxini tɔn i xili ma,","poem":1},{"lineBreak":true},{"text":"e mɔn yi e miri kɔtɛ ɲaxine ma,","poem":1},{"lineBreak":true},{"text":"e fulama nɛn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bayo, i na i ya xalimakunle ti e ra,","poem":1},{"lineBreak":true},{"text":"e e xun xanbi soma nɛn, e yi e gi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala xa batu a sɛnbɛ gbeena fe ra.","poem":1},{"lineBreak":true},{"text":"Nxu bɛtin bama nɛn,","poem":1},{"lineBreak":true},{"text":"nxu yi i tantun i fangana fe ra.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"21.10Sulun tɛɛnmɔn falama yirena nde yi fa fala “Furu tɛɛna.”","reference":{"chapter":21,"verse":10}}]},"thisChapterLink":"/api/yal_pbt/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}