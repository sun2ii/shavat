{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":22,"content":[{"type":"heading","content":["Wugan nun tantunna"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba alo bɛtin naxan xili: “Xɔtɔnna Xɛli Gilɛna.”","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N ma Ala! N ma Ala!","poem":1},{"lineBreak":true},{"text":"I n nabeɲinxi nanfera?","poem":1},{"lineBreak":true},{"text":"Nanfera i ya marakisin makuyaxi n na?","poem":1},{"lineBreak":true},{"text":"Nanfera i mi n kutun xuiin namɛma?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma Ala, n ni i xilima yanyin na,","poem":1},{"lineBreak":true},{"text":"koni i mi n yabima.","poem":1},{"lineBreak":true},{"text":"Hali kɔɛɛn na, n mi n dundɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koni i tan sariɲan,","poem":1},{"lineBreak":true},{"text":"i ya mangaya gbɛdɛn nabilinxi Isirayilaa tantunna ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nxu benbane yigin saxi i tan nan yi.","poem":1},{"lineBreak":true},{"text":"E e yigin sa i yi,","poem":1},{"lineBreak":true},{"text":"i yi e ratanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E to e xui ramini i ma,","poem":1},{"lineBreak":true},{"text":"i yi e xɔrɔya.","poem":1},{"lineBreak":true},{"text":"E yigin saxi i yi,","poem":1},{"lineBreak":true},{"text":"nanara, e mi yagixi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Koni daɲɔxɔ mi fa n tan na sɔnɔn.","poem":1},{"lineBreak":true},{"text":"N ligaxi nɛn alo kunla","poem":1},{"lineBreak":true},{"text":"adamadiin naxan naɲaxuxi","poem":1},{"lineBreak":true},{"text":"yamaan naxan bɔtɛ raba.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naxanye na n to,","poem":1},{"lineBreak":true},{"text":"e yo n ma.","poem":1},{"lineBreak":true},{"text":"E yi e dɛɛn bɛtɛxun,","poem":1},{"lineBreak":true},{"text":"e e xunne yimaxa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E naxa, “A tan naxan Alatalaa fe yi,","poem":1},{"lineBreak":true},{"text":"Alatala a ratangama ba?","poem":1},{"lineBreak":true},{"text":"Xa a rafan Alatala ma,","poem":1},{"lineBreak":true},{"text":"a xa a xunba.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni i tan nan n naminixi nga kuini,","poem":1},{"lineBreak":true},{"text":"i yi n sa nga kanken ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xabu n bari lɔxɔni,","poem":1},{"lineBreak":true},{"text":"n taxuxi i ra.","poem":1},{"lineBreak":true},{"text":"N ma Ala nan i ra,","poem":1},{"lineBreak":true},{"text":"xabu n yi nga kuini waxatin naxan yi han iki.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I nama i makuya n na.","poem":1},{"lineBreak":true},{"text":"Tɔrɔn bata maso n na,","poem":1},{"lineBreak":true},{"text":"muxu yo mi na yi","poem":1},{"lineBreak":true},{"text":"naxan n maliyɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N yaxune n nabilinxi","poem":1},{"lineBreak":true},{"text":"alo turane,","poem":1},{"lineBreak":true},{"text":"alo Basan yamanan tura xaɲɛne.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"E dɛɛne yibixi alo yatane,","poem":1},{"lineBreak":true},{"text":"e wurundunma n ma,","poem":1},{"lineBreak":true},{"text":"e xa n yibɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N fangan bata ɲan","poem":1},{"lineBreak":true},{"text":"alo ige bɔxɔnxina.","poem":1},{"lineBreak":true},{"text":"N xɔnne birin bata ba e bode ra.","poem":1},{"lineBreak":true},{"text":"N bɔɲɛn bata liga","poem":1},{"lineBreak":true},{"text":"alo dolen na yilo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N fangan bata ɲan feu!","poem":1},{"lineBreak":true},{"text":"N lɛnna xaraxin bata kankan n dɛ.","poem":1},{"lineBreak":true},{"text":"I bata n sa faxa bɛndɛni.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Muxu ɲaxi ganla bata n nabilin","poem":1},{"lineBreak":true},{"text":"alo barene.","poem":1},{"lineBreak":true},{"text":"E bata n yiine nun n sanne mabɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N xɔnne birin kɛnɛnni.","poem":1},{"lineBreak":true},{"text":"E yɛɛne kankanxi n na.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E bata masɛnsɛnna ti n ma dugine fe ra,","poem":1},{"lineBreak":true},{"text":"e xa e yitaxun e bode tagi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatala, i nama i makuya n na!","poem":1},{"lineBreak":true},{"text":"N ma sɛnbɛmaan nan i tan na.","poem":1},{"lineBreak":true},{"text":"N mali iki sa!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N niin xunba silanfanna yii.","poem":1},{"lineBreak":true},{"text":"N natanga bareni itoe ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N nakisi yatani itoe ma.","poem":1},{"lineBreak":true},{"text":"N nakisi burunna turaan fenne ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"N na i xinla ralima nɛn ngaxakedenne ma.","poem":1},{"lineBreak":true},{"text":"N ni i matɔxɔ nɛn yamaan yɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ɛ tan naxanye gaxu Alatala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"ɛ a matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Ɛ tan Yaxuba bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"ɛ a binya.","poem":1},{"lineBreak":true},{"text":"Ɛ tan Isirayila kaane,","poem":1},{"lineBreak":true},{"text":"ɛ gaxu a yɛɛ ra.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Bayo, a mi a mɛxi yiigelitɔne tɔrɔne ra,","poem":1},{"lineBreak":true},{"text":"a mi a rabeɲinma.","poem":1},{"lineBreak":true},{"text":"A mi a yɛtagin luxunma a ma.","poem":1},{"lineBreak":true},{"text":"Fɔ a a xandi xuiin namɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N ni i tantunma yamaan malan gbeeni.","poem":1},{"lineBreak":true},{"text":"N na n ma dɛ ti xuine rakamalima nɛn","poem":1},{"lineBreak":true},{"text":"i yɛɛ ragaxu muxune yɛɛ xɔri.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yiigelitɔne xa e dɛge,","poem":1},{"lineBreak":true},{"text":"e lugo.","poem":1},{"lineBreak":true},{"text":"Naxanye Alatala fenma,","poem":1},{"lineBreak":true},{"text":"ne xa a matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Ala xa siimayaan fi ɛ ma habadan!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bɔxɔn danna muxun birin","poem":1},{"lineBreak":true},{"text":"e xaxili luma nɛn Alatala xɔn,","poem":1},{"lineBreak":true},{"text":"e yi e yɛɛ rafindi a ma.","poem":1},{"lineBreak":true},{"text":"Siyane bɔnsɔnne birin a batuma nɛn.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bayo, Alatala nan mangan na siyane xun na.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nafulu kanne fan fama nɛn e dɛgedeni,","poem":1},{"lineBreak":true},{"text":"e a batu.","poem":1},{"lineBreak":true},{"text":"Naxanye birin xɛtɛma bɛndɛni,","poem":1},{"lineBreak":true},{"text":"ne xinbi sinma nɛn a bun ma,","poem":1},{"lineBreak":true},{"text":"naxanye mi nɔɛ e niin nakisɛ.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Waxati famatɔɔn muxune walima a xa nɛn","poem":1},{"lineBreak":true},{"text":"Marigina a fe falama nɛn mamandenne xa.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"A tinxinyaan fama nɛn nalideni muxune ma","poem":1},{"lineBreak":true},{"text":"naxanye munma bari,","poem":1},{"lineBreak":true},{"text":"Ala bata na ragidi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":32}