{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":23,"content":[{"type":"heading","content":["Alatala nan n kantanma"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"Alatala n masuxuma","poem":1},{"lineBreak":true},{"text":"alo xuruse rabana a xuruseene kantanma kii naxan yi.","poem":1},{"lineBreak":true},{"text":"Nanara, n mi dasɛ sese ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A matabuden fi n ma","poem":1},{"lineBreak":true},{"text":"sɛxɛ ɲingi faɲin dɛnaxan yi.","poem":1},{"lineBreak":true},{"text":"A yi siga n na","poem":1},{"lineBreak":true},{"text":"ige xunbenla dɛxɔn ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A bata n nii yifan n ma.","poem":1},{"lineBreak":true},{"text":"A n xalima kira tinxinxin xɔn ma nɛn","poem":1},{"lineBreak":true},{"text":"a xinla fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hali n so sayaan tilinna dimin xɔrɛ ra,","poem":1},{"lineBreak":true},{"text":"n mi gaxuɛ sese yɛɛ ra","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i tan Ala n xɔn ma.","poem":1},{"lineBreak":true},{"text":"I ya gbengbetenna n nakantanma","poem":1},{"lineBreak":true},{"text":"i ya dunganna n gbɛngbɛnma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I bata donseen nafala n xa","poem":1},{"lineBreak":true},{"text":"n yaxune yɛɛ xɔri,","poem":1},{"lineBreak":true},{"text":"i yi n masuxu","poem":1},{"lineBreak":true},{"text":"alo xɔɲɛ binyena,","poem":1},{"lineBreak":true},{"text":"i turen sa n xunni.","poem":1},{"lineBreak":true},{"text":"I bata n ma igelengenna rafe","poem":1},{"lineBreak":true},{"text":"han a bɔxɔnɲɛ a ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yati, i ya fanna","poem":1},{"lineBreak":true},{"text":"nun i ya hinanna birama n fɔxɔ ra nɛn","poem":1},{"lineBreak":true},{"text":"n siin sogen birin yi.","poem":1},{"lineBreak":true},{"text":"N luma nɛn Alatalaa banxin kui","poem":1},{"lineBreak":true},{"text":"han n siin soge dɔnxɛna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}