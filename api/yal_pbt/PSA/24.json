{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":24,"content":[{"type":"heading","content":["Manga binyena"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"Alatala nan gbee bɔxɔn nun ayi seene birin na","poem":1},{"lineBreak":true},{"text":"e nun dunuɲa nun muxun naxanye birin dɔxi a yi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amasɔtɔ a tan nan bɔxɔn dɔxi igen tagi.","poem":1},{"lineBreak":true},{"text":"A yi a dɔxɔ igene fari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nde lan a te Alatala geyaan fari?","poem":1},{"lineBreak":true},{"text":"Nde tiyɛ a yire sariɲanxini?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Naxanye sariɲan e kɛwanle nun e sɔndɔmɛne yi,","poem":1},{"lineBreak":true},{"text":"naxanye mi suxurene batuma,","poem":1},{"lineBreak":true},{"text":"xanamu naxanye mi e kɔlɔma wuleni,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala ne barakama nɛn.","poem":1},{"lineBreak":true},{"text":"Marakisi Tiina Ala yoon fima e ma nɛn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muxu sifani itoe nan Ala fenma,","poem":1},{"lineBreak":true},{"text":"naxanye Yaxubaa Ala yɛtagin fenma.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yinna","poem":1},{"noteId":3},{"text":"dɛɛne xa rabi fefe,","poem":1},{"lineBreak":true},{"text":"dɛ fonne xa rabi mumɛ,","poem":1},{"lineBreak":true},{"text":"nanara Manga Binyen soɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nde Manga Binyeni ito ra?","poem":1},{"lineBreak":true},{"text":"Alatala na a ra","poem":1},{"lineBreak":true},{"text":"fangamaan nun sɛnbɛmana!","poem":1},{"lineBreak":true},{"text":"Alatala na a ra","poem":1},{"lineBreak":true},{"text":"naxan sɛnbɛn gbo yɛngɛni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yinna dɛɛne xa rabi fefe,","poem":1},{"lineBreak":true},{"text":"dɛ fonne xa rabi mumɛ,","poem":1},{"lineBreak":true},{"text":"nanara Manga Binyen soɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nde Manga Binyeni ito ra?","poem":1},{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"a tan nan manga binyen na.","poem":1},"Bɛti xuini te."]}],"footnotes":[{"noteId":3,"caller":"+","text":"24.7Ala Batu Banxin nabilinna yinnanan na ra.","reference":{"chapter":24,"verse":7}}]},"thisChapterLink":"/api/yal_pbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}