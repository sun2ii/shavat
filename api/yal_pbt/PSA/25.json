{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":25,"content":[{"type":"heading","content":["Maxandina maratanga fena"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"Alatala, n bata i maxandi n niin birin na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ma Ala,","poem":1},{"lineBreak":true},{"text":"n yigin saxi i tan nan yi.","poem":1},{"lineBreak":true},{"text":"N nama yagi.","poem":1},{"lineBreak":true},{"text":"I nama tin n yaxune yi n nɔ,","poem":1},{"lineBreak":true},{"text":"e sɛwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naxan na a xaxili ti i ra,","poem":1},{"lineBreak":true},{"text":"na kanna mi yarabima mumɛ!","poem":1},{"lineBreak":true},{"text":"Koni naxanye yanfan soma,","poem":1},{"lineBreak":true},{"text":"ne yagin sɔtɔma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala, kiraan yita n na,","poem":1},{"lineBreak":true},{"text":"i xa n xaran i ya kiraan ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N xa sigan ti i ya ɲɔndini,","poem":1},{"lineBreak":true},{"text":"n xaran.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ n nakisima Ala nan i tan na.","poem":1},{"lineBreak":true},{"text":"N xaxili tixi i ra fɛriɲɛn gbɛn!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala, i xaxili lu i ya kininkininna nun hinanna xɔn","poem":1},{"lineBreak":true},{"text":"bayo e yi na xabu a fɔlɔni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I nama i miri n ma foningeya yulubine nun matandine ma!","poem":1},{"lineBreak":true},{"text":"N suxu i ya hinanni,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i fan, Alatala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala fan, a mɔn tinxin,","poem":1},{"lineBreak":true},{"text":"nanara a yulubi kanne xaranma a kirane ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naxan a yɛtɛ magodoma,","poem":1},{"lineBreak":true},{"text":"a a sariyan nabirama na ma.","poem":1},{"lineBreak":true},{"text":"A mɔn a xaranma a sagoon na nɛn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naxanye a layirin maxadine suxi,","poem":1},{"lineBreak":true},{"text":"Alatala hinan,","poem":1},{"lineBreak":true},{"text":"a mɔn lannayaan nabama","poem":1},{"lineBreak":true},{"text":"ne nan xa kiin birin yi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala, n hakɛne mafelu i xinla a fe ra,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a gbo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nde gaxuma Alatala yɛɛ ra?","poem":1},{"lineBreak":true},{"text":"A kiraan yitama na kanna ra","poem":1},{"lineBreak":true},{"text":"a lan a xa sigan ti naxan xɔn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na kanna sabatima nɛn a siimayani,","poem":1},{"lineBreak":true},{"text":"bɔxɔn yi findi a diine kɛɛn na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala a wundone makɛnɛnma nɛn","poem":1},{"lineBreak":true},{"text":"a yɛɛ ragaxu muxune xa.","poem":1},{"lineBreak":true},{"text":"A a layirin yitama e ra nɛn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N yɛɛn tixi Alatala ra waxatin birin,","poem":1},{"lineBreak":true},{"text":"bayo a tan nan n natangama suxu yalaan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ala, yandi, kininkinin n ma","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n kedenna na a ra,","poem":1},{"lineBreak":true},{"text":"n tɔrɔxi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nii yifɔrɛn bata n yili,","poem":1},{"lineBreak":true},{"text":"n namini na tɔrɔni.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I miri n ma tɔrɔne","poem":1},{"lineBreak":true},{"text":"nun n ma sɔxɔlɛne ma,","poem":1},{"lineBreak":true},{"text":"i yi n ma yulubine xafari.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A mato, n yaxune wuya,","poem":1},{"lineBreak":true},{"text":"e n naɲaxuxi kati!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"N niin nakantan,","poem":1},{"lineBreak":true},{"text":"i yi n xunba.","poem":1},{"lineBreak":true},{"text":"N nama yarabi,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n bata n luxun i yi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N ma fɛtareyaan","poem":1},{"lineBreak":true},{"text":"nun tinxinyaan xa n kantan","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n xaxili tixi i tan nan na.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ala, i xa Isirayila xunba a tɔrɔne birin yii!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}