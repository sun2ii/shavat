{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":26,"content":[{"type":"heading","content":["Sɔntarena Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"Alatala, n ma kitin sa","poem":1},{"lineBreak":true},{"text":"amasɔtɔ fɛ yo mi n kɛwanle ra,","poem":1},{"lineBreak":true},{"text":"n yigin mɔn i yi feu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala, n fɛsɛfɛsɛ,","poem":1},{"lineBreak":true},{"text":"i yi n mato,","poem":1},{"lineBreak":true},{"text":"n sɔndɔmɛn nun bɔɲɛn nakɔrɔsi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I ya hinanna n yi waxatin birin yi,","poem":1},{"lineBreak":true},{"text":"n sigan tima i ya lannayani!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N tan mi n magodɛ fuyantenne fɛma,","poem":1},{"lineBreak":true},{"text":"nxu nun nafigine mi fe kedenni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe ɲaxi raba yamaan mi rafan n ma.","poem":1},{"lineBreak":true},{"text":"N mi dɔxɛ muxu ɲaxine fɛma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala, n bata n yiin naxa sɔntareyani,","poem":1},{"lineBreak":true},{"text":"n yi so i batudeni,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"n barikan bira i xa n xui yitexin na,","poem":1},{"lineBreak":true},{"text":"n yi i ya kabanako feene fala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, i ya banxin nafan n ma,","poem":1},{"lineBreak":true},{"text":"i nɔrɔn dɛnaxan yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I nama nxu nun hakɛ kanne faxa nxu bode xɔn,","poem":1},{"lineBreak":true},{"text":"i nama nxu nun faxa tiine raɲanna findi kedenna ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na muxune fe ɲaxin ligama,","poem":1},{"lineBreak":true},{"text":"e dimi yi seene rasuxu mayifuni.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koni, n tan, fɛ yo mi n kɛwanle ra.","poem":1},{"lineBreak":true},{"text":"N xunba, i diɲa n ma!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N tixi tinxinni ken!","poem":1},{"lineBreak":true},{"text":"N na Alatala tantunma nɛn a yama gbeeni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}