{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":27,"content":[{"type":"heading","content":["Marakisi Tiina Alatala"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"Alatala nan n ma kɛnɛnna nun n ma kisin na.","poem":1},{"lineBreak":true},{"text":"N xa gaxu mundun yɛɛ ra?","poem":1},{"lineBreak":true},{"text":"Alatala nan n ma dunuɲa yi gidin","poem":1},{"lineBreak":true},{"text":"xun mayɛngɛ muxun na.","poem":1},{"lineBreak":true},{"text":"Nde n magaxuɛ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muxu ɲaxine na keli n xili ma","poem":1},{"lineBreak":true},{"text":"alogo e xa n halagi,","poem":1},{"lineBreak":true},{"text":"yaxune na n yɛngɛ,","poem":1},{"lineBreak":true},{"text":"e tan nan dagalanma ayi nɛn,","poem":1},{"lineBreak":true},{"text":"e bira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hali sofa ganla na n nabilin,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛn susuma nɛn.","poem":1},{"lineBreak":true},{"text":"Hali yɛngɛ gbeen na keli n xili ma","poem":1},{"lineBreak":true},{"text":"n yigin tixi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N bata Alatala maxɔdin fe keden ma.","poem":1},{"lineBreak":true},{"text":"N fe keden peen nan fenma.","poem":1},{"lineBreak":true},{"text":"N lu Alatalaa banxin kui","poem":1},{"lineBreak":true},{"text":"han n siin soge danna.","poem":1},{"lineBreak":true},{"text":"N Alatala wali faɲin kolon,","poem":1},{"lineBreak":true},{"text":"n yi lu a batuɛ a banxini.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amasɔtɔ a n namarɛ nɛn","poem":1},{"lineBreak":true},{"text":"a banxini tɔrɔ waxatini.","poem":1},{"lineBreak":true},{"text":"A n luxunɲɛ nɛn a Batu Banxini.","poem":1},{"lineBreak":true},{"text":"A n natema nɛn geyaan xuntagi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A xunna kenla fima n ma nɛn","poem":1},{"lineBreak":true},{"text":"n yaxune tagi.","poem":1},{"lineBreak":true},{"text":"N saraxane bama nɛn Ala Batu Banxini,","poem":1},{"lineBreak":true},{"text":"n sɔnxɔ sɛwani.","poem":1},{"lineBreak":true},{"text":"N bɛtin bama nɛn,","poem":1},{"lineBreak":true},{"text":"n na Alatala tantun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala, i tuli mati n xuiin na,","poem":1},{"lineBreak":true},{"text":"n na i xili waxatin naxan yi.","poem":1},{"lineBreak":true},{"text":"Kininkinin n ma, i yi n yabi!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N bɔɲɛn waxi i fen feni.","poem":1},{"lineBreak":true},{"text":"Alatala, n ni i fenma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"i nama i yɛtagi luxun n ma!","poem":1},{"lineBreak":true},{"text":"I nama i ya walikɛɛn kedi xɔlɔni.","poem":1},{"lineBreak":true},{"text":"I bata findi n mali muxun na.","poem":1},{"lineBreak":true},{"text":"I nama n nabeɲin,","poem":1},{"lineBreak":true},{"text":"i nama i mɛ n na,","poem":1},{"lineBreak":true},{"text":"n nakisimana Ala.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hali nga nun n fafe n nabeɲin,","poem":1},{"lineBreak":true},{"text":"Alatala n yisuxuma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alatala, n xaran sigati kiin ma.","poem":1},{"lineBreak":true},{"text":"Ti n yɛɛ ra kira faɲin xɔn ma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n yaxune wuya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I nama n so n yaxune yii,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ wule serene bata keli n xili ma,","poem":1},{"lineBreak":true},{"text":"e e kɔnkɔma n ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N mɔn laxi ito ra:","poem":1},{"lineBreak":true},{"text":"n na Alatalaa nɛmaan toma nɛn dunuɲa yi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I xaxili ti Alatala ra!","poem":1},{"lineBreak":true},{"text":"I sɛnbɛ so! I bɔɲɛn xa limaniya!","poem":1},{"lineBreak":true},{"text":"I xaxili ti Alatala ra!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}