{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":28,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"Alatala n ma fanyena,","poem":1},{"lineBreak":true},{"text":"n bata i xili.","poem":1},{"lineBreak":true},{"text":"I tuli mati n na!","poem":1},{"lineBreak":true},{"text":"Xa i mi n yabi,","poem":1},{"lineBreak":true},{"text":"n sama laxira faxa muxune fari nɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ma mayandi xuiin mɛ malina fe ra,","poem":1},{"lineBreak":true},{"text":"n bata n yiini te","poem":1},{"lineBreak":true},{"text":"i Batu Banxin yire sariɲanxin mabinni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I nama nxu nun muxu ɲaxine yalagi nxu bode xɔn,","poem":1},{"lineBreak":true},{"text":"fe ɲaxi rabane naxanye fala faɲine tima","poem":1},{"lineBreak":true},{"text":"koni maraɲaxuna e bɔɲɛne yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E kɛwanle saranna fi,","poem":1},{"lineBreak":true},{"text":"e nun e wali ɲaxine","poem":1},{"lineBreak":true},{"text":"e bata naxanye liga.","poem":1},{"lineBreak":true},{"text":"A liga e ra naxan lan e kɛwanle ma.","poem":1},{"lineBreak":true},{"text":"E lan e xa naxan sɔtɔ, na so e yii!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E xaxili mi luxi Alatalaa wanle xɔn ma,","poem":1},{"lineBreak":true},{"text":"hanma a yiine bata naxan da.","poem":1},{"lineBreak":true},{"text":"Nanara, a e kalama nɛn","poem":1},{"lineBreak":true},{"text":"a e ɲan habadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Barikan bira Alatala xa,","poem":1},{"lineBreak":true},{"text":"a bata n ma mayandi xuiin mɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala nan n sɛnbɛn na.","poem":1},{"lineBreak":true},{"text":"A n xun mayɛngɛma","poem":1},{"lineBreak":true},{"text":"alo wure lefana.","poem":1},{"lineBreak":true},{"text":"N yigin saxi a fari,","poem":1},{"lineBreak":true},{"text":"bayo a n malima.","poem":1},{"lineBreak":true},{"text":"Nanara, n bɔɲɛn bata rafe sɛwan na.","poem":1},{"lineBreak":true},{"text":"N na a tantunma nɛn bɛtine yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala nan a yamaan sɛnbɛn na,","poem":1},{"lineBreak":true},{"text":"e nun yigiya kantanxina a muxu sugandixin xa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I ya yamaan nakisi,","poem":1},{"lineBreak":true},{"text":"i mɔn yi e baraka.","poem":1},{"lineBreak":true},{"text":"Findi e gbɛngbɛn muxun na,","poem":1},{"lineBreak":true},{"text":"i yi i yengi dɔxɔ e xɔn ma habadan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}