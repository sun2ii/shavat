{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":29,"content":[{"type":"heading","content":["Alatala Sɛnbɛn Birin Kanna"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina.","descriptive":true},{"text":"Ɛ tan malekane,","poem":1},{"lineBreak":true},{"text":"ɛ fa Alatala tantun,","poem":1},{"lineBreak":true},{"text":"ɛ a tantun a binyen nun a sɛnbɛna fe ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ binyen fi Alatala ma a xinla fe ra,","poem":1},{"lineBreak":true},{"text":"ɛ Alatala batu a nɔrɔ sariɲanxini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alatala xuiin mɛma fɔxɔ igene yi,","poem":1},{"lineBreak":true},{"text":"Ala binye kanna sarinma,","poem":1},{"lineBreak":true},{"text":"Alatala a xuiin nasigama ige gbeene xun ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala xuiin sɛnbɛn gbo,","poem":1},{"lineBreak":true},{"text":"Alatala xuiin nɔrɔxi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala xuiin suman binle yigirama,","poem":1},{"lineBreak":true},{"text":"hali suman wudin naxanye Liban yamanani.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala Liban geyane ratuganma","poem":1},{"lineBreak":true},{"text":"alo ɲinge diina,","poem":1},{"lineBreak":true},{"text":"e nun Siriyon geyana","poem":1},{"lineBreak":true},{"text":"alo burunna ɲingena.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala xuiin sigama ayi","poem":1},{"lineBreak":true},{"text":"alo kuye sarinna.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala xuiin tonbon yirene yimaxama,","poem":1},{"lineBreak":true},{"text":"a Kadesi tonbonni maxa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xɛnle diin xalima Alatala xuiin ma,","poem":1},{"lineBreak":true},{"text":"a mɔn yi warine dɛɛne rayolon,","poem":1},{"lineBreak":true},{"text":"yamaan birin sɔnxɔma a Batu Banxini,","poem":1},{"lineBreak":true},{"text":"e naxa, “Binyen xa fi a ma!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatala dɔxi fufane xun na.","poem":1},{"lineBreak":true},{"text":"A mangayaan na habadan!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala nan sɛnbɛn fima a yamaan ma,","poem":1},{"lineBreak":true},{"text":"a bɔɲɛ xunbeli barakan sa e yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}