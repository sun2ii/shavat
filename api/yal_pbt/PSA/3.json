{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"heading","content":["Ala nan marakisi tiin na"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, a to a gi a dii Abisalomi bun.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n yɛngɛfane bata wuya ayi.","poem":1},{"lineBreak":true},{"text":"E gbegbe bata keli n xili ma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E n ma fe falama,","poem":1},{"lineBreak":true},{"text":"e naxa, “Ala mi a malima.”","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Koni, Alatala,","poem":1},{"lineBreak":true},{"text":"i tan nan n ma yɛ masansan wure lefaan na.","poem":1},{"lineBreak":true},{"text":"I binyen fima n ma,","poem":1},{"lineBreak":true},{"text":"e nun xunna kenla.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na n xuini tema Alatala ma,","poem":1},{"lineBreak":true},{"text":"a yi n yabi keli a geya sariɲanxini.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N na n sa, n yi xi, n yi xulun","poem":1},{"lineBreak":true},{"text":"bayo Alatala n kantanma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N mi gaxuɛ yaxu wuli wuyaxin yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"naxanye n nabilinxi yiren birin yi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala keli! N nakisi, n ma Ala.","poem":1},{"lineBreak":true},{"text":"N yaxune birin dɛɛne bɔnbɔ,","poem":1},{"lineBreak":true},{"text":"i yi muxu ɲaxine ɲinne magira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Marakisi Tiin nan Alatala ra!","poem":1},{"lineBreak":true},{"text":"Ala xa a yamaan baraka.","poem":1},"Bɛti xuini te."]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}