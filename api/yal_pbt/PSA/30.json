{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":30,"content":[{"type":"heading","content":["Barika birana Ala xa"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina. Sigi sariɲanxina. Batu Banxin nasariɲan bɛtina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n ni i batuma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i bata n yite.","poem":1},{"lineBreak":true},{"text":"I mi tin","poem":1},{"lineBreak":true},{"text":"n yaxune yi e xunnayeren n xun na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala n ma Ala,","poem":1},{"lineBreak":true},{"text":"n ni i mafan nɛn malina fe ra,","poem":1},{"lineBreak":true},{"text":"i yi n nakɛndɛya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala i n niin masiga nɛn laxira ra,","poem":1},{"lineBreak":true},{"text":"i n faxamatɔɔn nakisi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatalaa tɔgɔndiya muxune birin xa bɛtin ba a xa!","poem":1},{"lineBreak":true},{"text":"Ɛ a matɔxɔ a wali sariɲanxine fe ra!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bayo, a xɔlɔn mi xunkuya,","poem":1},{"lineBreak":true},{"text":"koni a marafanna luma nɛn muxun siin sogen birin.","poem":1},{"lineBreak":true},{"text":"Wuga xuiin minima nɛn kɔɛɛn na,","poem":1},{"lineBreak":true},{"text":"koni sɛwan fama nɛn xɔtɔnni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N yi laxi n ma hɛrin na waxatin naxan yi","poem":1},{"lineBreak":true},{"text":"n naxa, “Sese mi n yimaxɛ!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, n to yi i ya xanuntenyani,","poem":1},{"lineBreak":true},{"text":"i n lu nɛn fangani alo geyana.","poem":1},{"lineBreak":true},{"text":"Koni i to i yɛtagin luxun n ma,","poem":1},{"lineBreak":true},{"text":"na yi n kɔntɔfili.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N yi i tan Alatala xili,","poem":1},{"lineBreak":true},{"text":"n yi Marigin mafan,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"n naxa, “N na faxa,","poem":1},{"lineBreak":true},{"text":"i tɔnɔn mundun sɔtɔma nayi?","poem":1},{"lineBreak":true},{"text":"N na sa gaburun kui,","poem":1},{"lineBreak":true},{"text":"tɔnɔn mundun na ra?","poem":1},{"lineBreak":true},{"text":"Faxa muxune nɔɛ i tantunɲɛ ba?","poem":1},{"lineBreak":true},{"text":"E nɔɛ i ya lannayaan matɔxɛ ba?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala, i tuli mati n na,","poem":1},{"lineBreak":true},{"text":"i kininkinin n ma!","poem":1},{"lineBreak":true},{"text":"Alatala, n mali!”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I bata n ma nimisan maxɛtɛ sɛwan na.","poem":1},{"lineBreak":true},{"text":"I n makininkininna ba n ma,","poem":1},{"lineBreak":true},{"text":"i yi n nabilin sɛwan na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanara, n mi n dundɛ,","poem":1},{"lineBreak":true},{"text":"n bɛtin bama i xa nɛn.","poem":1},{"lineBreak":true},{"text":"Alatala n ma Ala,","poem":1},{"lineBreak":true},{"text":"n barikan birama i xa nɛn habadan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}