{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":31,"content":[{"type":"heading","content":["Yigi sa fena Ala fari"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n bata n luxun i yi.","poem":1},{"lineBreak":true},{"text":"I nama tin n yi yarabi!","poem":1},{"lineBreak":true},{"text":"N natanga i ya tinxinyana fe ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I tuli mati n na,","poem":1},{"lineBreak":true},{"text":"i yi n xunba iki sa!","poem":1},{"lineBreak":true},{"text":"Findi n yigiya gɛmɛn na,","poem":1},{"lineBreak":true},{"text":"e nun n makantan yinna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ma gɛmɛ gbeen nun","poem":1},{"lineBreak":true},{"text":"n ma yinna nan i tan na.","poem":1},{"lineBreak":true},{"text":"Ti n yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"i yi n maxaran i xinla a fe ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N natanga na luti ratixin ma n yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"bayo i tan nan n xun mayɛngɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N bata n niin so i yii,","poem":1},{"lineBreak":true},{"text":"n xunba Alatala, lannaya Ala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bata ne raɲaxu","poem":1},{"lineBreak":true},{"text":"naxanye suxure fufafune batuma,","poem":1},{"lineBreak":true},{"text":"koni n tan yigin saxi Alatala nan fari.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N sɛwama nɛn,","poem":1},{"lineBreak":true},{"text":"n ɲaxan i ya hinanna fe ra,","poem":1},{"lineBreak":true},{"text":"bayo, i bata n ma tɔrɔne to,","poem":1},{"lineBreak":true},{"text":"i n sɔndɔmɛna sɔxɔlɛn kolon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I mi n soxi n yaxune yii,","poem":1},{"lineBreak":true},{"text":"koni i n xɔrɔyaxi nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatala, kininkinin n ma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n tɔrɔni.","poem":1},{"lineBreak":true},{"text":"N bata xadan wugɛ.","poem":1},{"lineBreak":true},{"text":"Sunun bata n niin nun n fatin natagan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sunun bata n ma dunuɲa yi gidin ɲan,","poem":1},{"lineBreak":true},{"text":"wugan yi nde ba n siin na.","poem":1},{"lineBreak":true},{"text":"N fangan bata ɲan n yi n ma tɔrɔne fe ra.","poem":1},{"lineBreak":true},{"text":"N xɔnne bata yelefu ayi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N yaxune birin,","poem":1},{"lineBreak":true},{"text":"katarabi n dɔxɔ bodene ma,","poem":1},{"lineBreak":true},{"text":"ne n nayarabima.","poem":1},{"lineBreak":true},{"text":"N xɔyine bata gaxu n yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e na n to kiraan xɔn ma,","poem":1},{"lineBreak":true},{"text":"e e gi n yɛɛ ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E birin bata ɲinan n xɔn ma","poem":1},{"lineBreak":true},{"text":"alo n faxaxin na a ra.","poem":1},{"lineBreak":true},{"text":"N bata lu alo fɛɲɛ kalaxina.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N bata yaxu wuyaxi kɔyɛkɔyɛn xuiin mɛ,","poem":1},{"lineBreak":true},{"text":"gbalona n nabilinni.","poem":1},{"lineBreak":true},{"text":"E feene yitɔnma lan n faxa feen ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Alatala, n tan yigin saxi i tan nin,","poem":1},{"lineBreak":true},{"text":"n naxa, “I tan nan n ma Ala ra.”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N ma waxatine i sagoni.","poem":1},{"lineBreak":true},{"text":"N natanga n yaxune ma","poem":1},{"lineBreak":true},{"text":"naxanye n bɛsɛnxɔnyama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I nɔrɔn xa godo i ya walikɛɛn ma,","poem":1},{"lineBreak":true},{"text":"n nakisi i ya hinanni.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alatala, n bata n xui ramini i ma,","poem":1},{"lineBreak":true},{"text":"i nama tin n yi rayarabi.","poem":1},{"lineBreak":true},{"text":"Ala xa muxu ɲaxine yarabi,","poem":1},{"lineBreak":true},{"text":"Ala xa e dunduxin nagodo laxira yi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Na wule xɛlɛne radundu,","poem":1},{"lineBreak":true},{"text":"na wasode yandaxine birin","poem":1},{"lineBreak":true},{"text":"naxanye fala ɲaxin tima tinxin muxune ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I ya nɛmaan makabɛ,","poem":1},{"lineBreak":true},{"text":"i bata naxan namara i yɛɛragaxu muxune xa!","poem":1},{"lineBreak":true},{"text":"Muxun birin yɛtagi,","poem":1},{"lineBreak":true},{"text":"i ya fanna fima ne ma nɛn","poem":1},{"lineBreak":true},{"text":"naxanye luxunxi i yi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I bata e yigiya i fɛma,","poem":1},{"lineBreak":true},{"text":"i e kantanma muxune fe yitɔnxine ma.","poem":1},{"lineBreak":true},{"text":"I bata e ratanga wule xɛlɛne ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Barikan bira Alatala xa!","poem":1},{"lineBreak":true},{"text":"N yi rabilinxi yaxune ra waxatin naxan yi","poem":1},{"lineBreak":true},{"text":"n yɛngɛ xinla ma,","poem":1},{"lineBreak":true},{"text":"a yi a hinanna yita n na.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N ma gaxuni, n yi a fala,","poem":1},{"lineBreak":true},{"text":"n naxa, “I bata n kedi i yɛtagi.”","poem":1},{"lineBreak":true},{"text":"Koni n to n xuiin namini i ma","poem":1},{"lineBreak":true},{"text":"malina fe ra,","poem":1},{"lineBreak":true},{"text":"i yi n ma mayandi xuiin mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ɛ tan tɔgɔndiya muxune birin xa Alatala xanu!","poem":1},{"lineBreak":true},{"text":"Alatala dɛnkɛlɛya muxune ratangama nɛn,","poem":1},{"lineBreak":true},{"text":"koni a yandadene sare fima nɛn","poem":1},{"lineBreak":true},{"text":"alo a lan kiinde.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ɛ tan naxanye birin yigi saxi Alatala fari,","poem":1},{"lineBreak":true},{"text":"ɛ sɛnbɛn so, ɛ bɔɲɛ ragidi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":25}