{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":32,"content":[{"type":"heading","content":["Yulubi xafari fena"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa fala ɲaxumɛna.","descriptive":true},{"text":"Sɛwan na kanna xa","poem":1},{"lineBreak":true},{"text":"naxan ma matandine bata mafelu","poem":1},{"lineBreak":true},{"text":"naxan yulubine bata xafari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sɛwan na adaman xa","poem":1},{"lineBreak":true},{"text":"Alatala bata diɲa naxan hakɛn ma","poem":1},{"lineBreak":true},{"text":"e nun mayifu mi naxan yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N to munma yi n ti n hakɛne ra nun,","poem":1},{"lineBreak":true},{"text":"fɛriɲɛn gbɛn kutunne yi n nayelefuma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I ya tɔrɔn yi n fari kɔɛɛn nun yanyin na.","poem":1},{"lineBreak":true},{"text":"Fangan yi ɲan n na","poem":1},{"lineBreak":true},{"text":"a liga alo n tonbon yiren nin.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Awa, n yi n ti n yulubine ra i xa.","poem":1},{"lineBreak":true},{"text":"N mi n ma hakɛ yo luxun i ma.","poem":1},{"lineBreak":true},{"text":"N naxa, “N na n tima nɛn","poem":1},{"lineBreak":true},{"text":"n ma matandine ra Alatala xa.”","poem":1},{"lineBreak":true},{"text":"Awa, i yi n hakɛne nun yulubine birin ba n ma.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nanara, muxu tɔgɔndiyaxine birin xa i mafan a waxatini,","poem":1},{"lineBreak":true},{"text":"alogo fufaan na fa,","poem":1},{"lineBreak":true},{"text":"a nama e li.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N luxunden nan i tan na.","poem":1},{"lineBreak":true},{"text":"I tan nan n natangama tɔrɔn ma,","poem":1},{"lineBreak":true},{"text":"yamaan birin yi xɔrɔya bɛtine ba.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nanara, n na ɛ xaranma kiraan ma","poem":1},{"lineBreak":true},{"text":"ɛ birɛ naxan fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"N na ɛ kawandima,","poem":1},{"lineBreak":true},{"text":"n yi n yengi sa ɛ xɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I nama findi daxun na","poem":1},{"lineBreak":true},{"text":"alo soona hanma sofanla","poem":1},{"lineBreak":true},{"text":"naxanye mi sigɛ","poem":1},{"lineBreak":true},{"text":"fɔ karafen na bira e ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muxu ɲaxine tɔrɔn gbo.","poem":1},{"lineBreak":true},{"text":"Koni naxanye e yigi saxi Alatala yi,","poem":1},{"lineBreak":true},{"text":"a ne rabilinma nɛn hinanna ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛ tan tinxin muxune xa ɲaxan Alatala a fe ra,","poem":1},{"lineBreak":true},{"text":"ɛ sɛwa, ɛ bɛtin ba,","poem":1},{"lineBreak":true},{"text":"ɛ tan muxu sɔndɔmɛ faɲine.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}