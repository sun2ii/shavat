{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":33,"content":[{"type":"heading","content":["Tantun bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Ɛ bɛtin ba sɛwani Alatala xa,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye tinxin!","poem":1},{"lineBreak":true},{"text":"Muxu faɲine lan e xa a tantun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ barikan bira Alatala xa bɔlɔnna ra,","poem":1},{"lineBreak":true},{"text":"ɛ barikan bira a xa kondenna ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ bɛti nɛnɛn ba a xa.","poem":1},{"lineBreak":true},{"text":"Ɛ maxa seene maxa ki faɲi,","poem":1},{"lineBreak":true},{"text":"ɛ yi ɛ xuini te a ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɲɔndin nan Alatalaa falan na.","poem":1},{"lineBreak":true},{"text":"A kɛwanle birin kamalima tinxinna nin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tinxinyaan nun sariya suxun nafan Alatala ma,","poem":1},{"lineBreak":true},{"text":"dunuɲa birin wasaxi a hinanna ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala kore xɔnna daxi a fala xuiin barakan nin,","poem":1},{"lineBreak":true},{"text":"e nun yanban seene a dɛ xuiin na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A fɔxɔ igene birin malanma yire kedenni,","poem":1},{"lineBreak":true},{"text":"a fufane ramara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bɔxɔn birin xa gaxu Alatala yɛɛ ra!","poem":1},{"lineBreak":true},{"text":"Dunuɲa muxune birin xa a binya!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A falan nan tixi,","poem":1},{"lineBreak":true},{"text":"dunuɲa yi da.","poem":1},{"lineBreak":true},{"text":"A yamarin fi,","poem":1},{"lineBreak":true},{"text":"seen birin yi taran na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala siyane natane kalama nɛn.","poem":1},{"lineBreak":true},{"text":"A mi tinɲɛ siyane yi e miriyane rawali.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koni Alatalaa fe ragidixine luma nɛn habadan!","poem":1},{"lineBreak":true},{"text":"A miriyane yi lu habadan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Sɛwan na siyaan xa","poem":1},{"lineBreak":true},{"text":"naxan ma Ala findixi Alatala ra.","poem":1},{"lineBreak":true},{"text":"Sɛwan na muxune xa","poem":1},{"lineBreak":true},{"text":"Alatala bata naxanye sugandi!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala a yɛɛ ragodoma keli ariyanna yi,","poem":1},{"lineBreak":true},{"text":"a muxune birin mato.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Keli a mangaya yireni,","poem":1},{"lineBreak":true},{"text":"a dunuɲa muxune birin xun mato a ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A e sɔndɔmɛne rafixa,","poem":1},{"lineBreak":true},{"text":"a a xaxili lu e kɛwanle birin xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Manga yo mi kisɛ a ganla sɛnbɛn ma.","poem":1},{"lineBreak":true},{"text":"Sofa yo mi ratangɛ a fangan xɔn.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xunba se mi soon na yɛngɛni,","poem":1},{"lineBreak":true},{"text":"a fangan na gbo ki yo ki,","poem":1},{"lineBreak":true},{"text":"a mi marakisin tiyɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koni Alatala yɛɛn tixi a yɛɛragaxu muxune ra,","poem":1},{"lineBreak":true},{"text":"naxanye e xaxili tixi a hinanna ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A ne rakisima sayaan ma nɛn,","poem":1},{"lineBreak":true},{"text":"a mɔn yi e niine rakisi fitina kamɛn ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"En xaxili tixi Alatala nan na.","poem":1},{"lineBreak":true},{"text":"A tan nan en mali muxun na","poem":1},{"lineBreak":true},{"text":"e nun en yɛ masansan wure lefana.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"En bɔɲɛne sɛwaxi a tan nan ma fe ra,","poem":1},{"lineBreak":true},{"text":"bayo en bata en yigi sa a xili sariɲanxini.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Alatala, i ya hinanna xa lu nxu xɔn","poem":1},{"lineBreak":true},{"text":"bayo nxu nxu yigi saxi i tan nin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}