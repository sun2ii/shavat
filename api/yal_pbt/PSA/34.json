{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":34,"content":[{"type":"heading","content":["Ala fan"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena. A to a yɛtɛ findi fatɔɔn na Abimeleki fɛma, naxan a kedi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N barikan birama Alatala xa waxatin birin,","poem":1},{"lineBreak":true},{"text":"n lu a tantunɲɛ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N na Alatala matɔxɔma n sɔndɔmɛni.","poem":1},{"lineBreak":true},{"text":"Tɔrɔ muxune yi a mɛ, e ɲaxan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"En xa Alatala gbona fe fala!","poem":1},{"lineBreak":true},{"text":"En na a xinli te en bode xɔn!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N bata Alatala xandi,","poem":1},{"lineBreak":true},{"text":"a yi n yabi,","poem":1},{"lineBreak":true},{"text":"a gaxun birin ba n yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naxanye yɛɛn tixi a tan na,","poem":1},{"lineBreak":true},{"text":"ne sɛwama nɛn,","poem":1},{"lineBreak":true},{"text":"e mi yarabɛ mumɛ!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N tan yiigelitɔna n xui ramini nɛn Alatala ma,","poem":1},{"lineBreak":true},{"text":"a yi n xuiin mɛ,","poem":1},{"lineBreak":true},{"text":"a yi n nakisi gbalon ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatalaa malekana a yɛɛragaxu muxune rabilinma nɛn,","poem":1},{"lineBreak":true},{"text":"a yi e kantan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A mato,","poem":1},{"lineBreak":true},{"text":"i a kolonɲɛ a Alatala fan.","poem":1},{"lineBreak":true},{"text":"Sɛwan na kanna xa","poem":1},{"lineBreak":true},{"text":"naxan na a luxun i tan yi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛ gaxu Alatala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"ɛ tan a yama sariɲanxina,","poem":1},{"lineBreak":true},{"text":"bayo naxan na gaxu a yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"na makoon fanma nɛn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hali yatane,","poem":1},{"lineBreak":true},{"text":"kamɛna e suxuma nɛn,","poem":1},{"lineBreak":true},{"text":"koni naxanye Alatala fenma,","poem":1},{"lineBreak":true},{"text":"ne mi dasɛ se faɲi yo ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"N ma diidine, ɛ fa,","poem":1},{"lineBreak":true},{"text":"ɛ fa ɛ tuli mati n na.","poem":1},{"lineBreak":true},{"text":"N xa ɛ xaran Alatala yɛɛragaxun ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndee waxi siimayaan xɔn?","poem":1},{"lineBreak":true},{"text":"Ndee waxi siimaya xunkuyen nun sɛwan xɔn?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nayi, ɛ fala ɲaxine yiba,","poem":1},{"lineBreak":true},{"text":"e nun wulena.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɛ ɛ xun xanbi so fe ɲaxini,","poem":1},{"lineBreak":true},{"text":"ɛ fe faɲin liga.","poem":1},{"lineBreak":true},{"text":"Ɛ bɔɲɛ xunbenla fen,","poem":1},{"lineBreak":true},{"text":"ɛ lu a fɔxɔ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alatala yɛɛn muxu tinxinxine ra,","poem":1},{"lineBreak":true},{"text":"a tuli matixi e xuiin na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala xun xanbi soxi fe ɲaxi rabane yi.","poem":1},{"lineBreak":true},{"text":"E na faxa,","poem":1},{"lineBreak":true},{"text":"ɲinan tima e xɔn nɛn sinma!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tinxin muxune na e mawuga Alatala xa,","poem":1},{"lineBreak":true},{"text":"a tuli matima e ra nɛn,","poem":1},{"lineBreak":true},{"text":"a e xunba e tɔrɔne birin yi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Alatala luma nɛn ne xɔn","poem":1},{"lineBreak":true},{"text":"naxanye bɔɲɛn kalaxi.","poem":1},{"lineBreak":true},{"text":"A yigitɛgɛtɔne rakisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tɔrɔ wuyaxi tinxin muxun lima nɛn,","poem":1},{"lineBreak":true},{"text":"koni Alatala a bama nɛn e birin yi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ala a xɔnne birin kantanma nɛn,","poem":1},{"lineBreak":true},{"text":"hali keden, a mi girɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fe ɲaxin nan muxu ɲaxin faxama.","poem":1},{"lineBreak":true},{"text":"Tinxin muxune yaxune yalagima nɛn.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Alatala a walikɛne niin xunbama nɛn.","poem":1},{"lineBreak":true},{"text":"Naxan na a luxun a yi,","poem":1},{"lineBreak":true},{"text":"na mi yalagɛ mumɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":23}