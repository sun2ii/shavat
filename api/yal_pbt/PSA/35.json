{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":35,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"Alatala, n kiti muxun makiti.","poem":1},{"lineBreak":true},{"text":"I n yɛngɛfaan yɛngɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Keli, i ya wure lefane tongo","poem":1},{"lineBreak":true},{"text":"i fa n mali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I ya tanban nun bunbini te ne xili ma","poem":1},{"lineBreak":true},{"text":"naxanye n fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"A fala n xa,","poem":1},{"lineBreak":true},{"text":"a i tan nan n nakisima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala xa ne rayagi a e rayarabi,","poem":1},{"lineBreak":true},{"text":"naxanye katama n faxa feen na!","poem":1},{"lineBreak":true},{"text":"Naxanye fe ɲaxine yitɔnma n xili ma,","poem":1},{"lineBreak":true},{"text":"Ala xa ne yɛ yifu a e raxɛtɛ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E xa liga","poem":1},{"lineBreak":true},{"text":"alo foyen sigama se dagin naxan na.","poem":1},{"lineBreak":true},{"text":"Alatalaa malekan xa e kedi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala xa e kirani fɔrɔ,","poem":1},{"lineBreak":true},{"text":"a salaxunɲɛ ayi,","poem":1},{"lineBreak":true},{"text":"Alatalaa malekan yi e sagatan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E lutin natixi nɛn n yɛɛ ra fuu!","poem":1},{"lineBreak":true},{"text":"E yili ratilinxin ge n suxu feen na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nanara, e xa e tɛrɛna halagin na,","poem":1},{"lineBreak":true},{"text":"e suxu e luti ratixin na,","poem":1},{"lineBreak":true},{"text":"e bira, e faxa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nayi, n niin sɛwama nɛn Alatala ra.","poem":1},{"lineBreak":true},{"text":"N ɲaxan a marakisina fe ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N na falɛ n bɔɲɛn ma feu!","poem":1},{"lineBreak":true},{"text":"N naxa, “Muxu yo mi luxi","poem":1},{"lineBreak":true},{"text":"alo i tan Alatala.","poem":1},{"lineBreak":true},{"text":"I yiigelitɔne ratangama fanga kanne ma.","poem":1},{"lineBreak":true},{"text":"I tɔrɔ muxune ratanga ne ma","poem":1},{"lineBreak":true},{"text":"naxanye e yigbɛtɛnxi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Muxu ɲaxine n kansunma.","poem":1},{"lineBreak":true},{"text":"E sɔnne sama n na,","poem":1},{"lineBreak":true},{"text":"n mi naxanye fe kolon mumɛ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E n ma fanna ɲɔxɔ a ɲaxin na.","poem":1},{"lineBreak":true},{"text":"N yifuxin yi lu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Koni e yi furaxi waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n yi n maxidima sunun nin.","poem":1},{"lineBreak":true},{"text":"N yi n yɛtɛ magodo sun suxuni.","poem":1},{"lineBreak":true},{"text":"N ma maxandi xuiin to mi yabi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"n sunuxin yi lu e fe ra","poem":1},{"lineBreak":true},{"text":"alo n xɔyina hanma","poem":1},{"lineBreak":true},{"text":"alo ngaxakedenna nan yi e ra nun.","poem":1},{"lineBreak":true},{"text":"N xun sinxin yi lu nimisani","poem":1},{"lineBreak":true},{"text":"alo n nga nan yi a ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Koni tɔrɔn to n tan li,","poem":1},{"lineBreak":true},{"text":"e birin yi ɲaxan.","poem":1},{"lineBreak":true},{"text":"E e malan n xili ma.","poem":1},{"lineBreak":true},{"text":"N yɛngɛfane,","poem":1},{"lineBreak":true},{"text":"n mi yi naxanye kolon,","poem":1},{"lineBreak":true},{"text":"ne yi lu n tɔrɛ tun!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E n naɲaxu, e n magele.","poem":1},{"lineBreak":true},{"text":"E e ɲinne raxinma n xili ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Marigina, i yɛɛn sama e xɔn","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"N niin natanga e yɛngɛni,","poem":1},{"lineBreak":true},{"text":"i n nakisi yatani itoe ma!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nayi, n barikan birama nɛn i xa yamani.","poem":1},{"lineBreak":true},{"text":"N ni i matɔxɔ e birin yɛtagi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"I nama tin","poem":1},{"lineBreak":true},{"text":"n yaxu wuledene yi ɲaxan n ma fe ra.","poem":1},{"lineBreak":true},{"text":"Naxanye n naɲaxuxi fuuni,","poem":1},{"lineBreak":true},{"text":"ne nama gele n ma.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"E mi ngaxakedenya fala tima,","poem":1},{"lineBreak":true},{"text":"fɔ e yi bɔɲɛ xunbelitɔne kansun wulen na.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"E feene falama n xun ma,","poem":1},{"lineBreak":true},{"text":"e sɔnxɔ, e naxa,","poem":1},{"lineBreak":true},{"text":"“Yɔ! I naxan ligaxi nxu bata a to!”","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Alatala, i tan bata ne to,","poem":1},{"lineBreak":true},{"text":"nayi, i nama i dundu.","poem":1},{"lineBreak":true},{"text":"Marigina, i nama i makuya n na!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Marigina, keli, i yi n xun mayɛngɛ.","poem":1},{"lineBreak":true},{"text":"N ma Ala, n ma yɛngɛn so.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Alatala n ma Ala,","poem":1},{"lineBreak":true},{"text":"yoon fi n ma bayo i tinxin.","poem":1},{"lineBreak":true},{"text":"I nama tin","poem":1},{"lineBreak":true},{"text":"n yaxune yi ɲaxan n ma fe ra.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"I nama tin e yi a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"“Yɔ! Nxu bata a manɔ!","poem":1},{"lineBreak":true},{"text":"Nxu yi waxi na nan tun xɔn ma!”","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Muxun naxanye sɛwama n tɔrɔ feen na,","poem":1},{"lineBreak":true},{"text":"Ala xa ne rayagi, a e yifu.","poem":1},{"lineBreak":true},{"text":"Ala xa ne rayagi, a yi e rayarabi","poem":1},{"lineBreak":true},{"text":"naxanye e yɛtɛ yitema n ma.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Naxanye waxi n xɔrɔyaxin to feni,","poem":1},{"lineBreak":true},{"text":"ne xa sɔnxɔ sɛwani,","poem":1},{"lineBreak":true},{"text":"e naxa, “Alatala gbo!","poem":1},{"lineBreak":true},{"text":"A bata sɛwa a walikɛna yɛɛ ra sigan na.”","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nayi, n ni i ya tinxinyana fe falama nɛn,","poem":1},{"lineBreak":true},{"text":"n yi i tantun fɛriɲɛn gbɛn!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}