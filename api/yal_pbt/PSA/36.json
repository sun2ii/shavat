{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":36,"content":[{"type":"heading","content":["Muxu ɲaxina"]},{"type":"verse","number":1,"content":[{"text":"Alatalaa walikɛɛn Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yulubin falan tima muxu ɲaxin xa a bɔɲɛni.","poem":1},{"lineBreak":true},{"text":"A mi gaxuma Ala yɛɛ ra mumɛ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bayo a lugoxi a yɛtɛ ra","poem":1},{"lineBreak":true},{"text":"a mi nɔɛ a yulubine kolonɲɛ,","poem":1},{"lineBreak":true},{"text":"a a mɛ e ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A falane ɲaxu,","poem":1},{"lineBreak":true},{"text":"wulen nan gbansan e ra.","poem":1},{"lineBreak":true},{"text":"A mi fa xaxilimaya feeye rabama.","poem":1},{"lineBreak":true},{"text":"A mi fe faɲi ligama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A nɛma saxi a saden ma,","poem":1},{"lineBreak":true},{"text":"a fe ɲaxine mirima,","poem":1},{"lineBreak":true},{"text":"a kira kobine natama,","poem":1},{"lineBreak":true},{"text":"a mi a mɛma fe ɲaxi yo ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alatala, i ya hinanna gbo","poem":1},{"lineBreak":true},{"text":"han ariyanna,","poem":1},{"lineBreak":true},{"text":"i ya lannayaan gbo han kore.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I ya tinxinna gbo alo geyane.","poem":1},{"lineBreak":true},{"text":"I ya kiti sa kiin tilin alo fɔxɔ igena.","poem":1},{"lineBreak":true},{"text":"Daɲɔxɔne nun subene i tan nan yii, Alatala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala, i ya hinanna kɛndɛ han!","poem":1},{"lineBreak":true},{"text":"Adamadiine birin luxunden sɔtɔma nɛn i yi","poem":1},{"lineBreak":true},{"text":"alo tɔxɛ diine e nga gabutɛne bun kii naxan yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E lugoma i ya donse gbeen nan na.","poem":1},{"lineBreak":true},{"text":"E e min i ya fanni alo xudena.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Niin binla i tan nan yi.","poem":1},{"lineBreak":true},{"text":"Nxu bata kɛnɛnna to i ya kɛnɛnna xɔn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I xa hinan ne ra","poem":1},{"lineBreak":true},{"text":"naxanye i kolon.","poem":1},{"lineBreak":true},{"text":"I ya tinxinyaan yita sɔndɔmɛ faɲi kanne ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I nama tin yandadene yi n yɛngɛ,","poem":1},{"lineBreak":true},{"text":"hanma muxu ɲaxine yi n kedi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A mato,","poem":1},{"lineBreak":true},{"text":"fe ɲaxi rabane bata bira.","poem":1},{"lineBreak":true},{"text":"E saxi, e mi nɔɛ kelɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}