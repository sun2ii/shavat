{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":37,"content":[{"type":"heading","content":["Muxu ɲaxin nun muxu faɲin kɔntɔnna"]},{"type":"verse","number":1,"content":[{"text":"Dawuda gbeena.","descriptive":true},{"text":"I nama xamin muxu ɲaxine ra.","poem":1},{"lineBreak":true},{"text":"I nama i sa fe ɲaxi rabane ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E tununma nɛn xulɛn","poem":1},{"lineBreak":true},{"text":"alo sɛxɛ xarena.","poem":1},{"lineBreak":true},{"text":"E faxama nɛn","poem":1},{"lineBreak":true},{"text":"alo si seen naxan bata lisi a ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I yigin sa Alatala yi,","poem":1},{"lineBreak":true},{"text":"i yi fe faɲin naba.","poem":1},{"lineBreak":true},{"text":"Nayi, i luyɛ yamanani nɛn,","poem":1},{"lineBreak":true},{"text":"i yi sabati bɔɲɛ xunbenli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I xa sɛwa Alatala yi","poem":1},{"lineBreak":true},{"text":"nanara a i bɔɲɛn waxɔn feene ligɛ i xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bira Alatalaa kiraan nan xɔn.","poem":1},{"lineBreak":true},{"text":"I yigin sa a yi.","poem":1},{"lineBreak":true},{"text":"Nanara a i maliyɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ya tinxinyaan","poem":1},{"lineBreak":true},{"text":"nun sariya suxun makɛnɛnma nɛn","poem":1},{"lineBreak":true},{"text":"a tan barakani alo yanyi tagi sogena.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I xa diɲa, i Alatala legeden.","poem":1},{"lineBreak":true},{"text":"I nama xamin na muxune ra","poem":1},{"lineBreak":true},{"text":"naxanye sabatima,","poem":1},{"lineBreak":true},{"text":"naxanye e fe yitɔnxine rasɔnɔyama a ɲaxin na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I nama xɔlɔ, i nama fitina,","poem":1},{"lineBreak":true},{"text":"i nama xamin.","poem":1},{"lineBreak":true},{"text":"Ne i birama tɔrɔni nɛn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Muxu ɲaxine ɲanma nɛn,","poem":1},{"lineBreak":true},{"text":"koni naxanye e yigin sama Alatala yi,","poem":1},{"lineBreak":true},{"text":"bɔxɔn luma ne nan xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"A mi buma muxu ɲaxine yi tunun.","poem":1},{"lineBreak":true},{"text":"Ɛ ɛ yɛɛ rakoɲinma e ma nɛn,","poem":1},{"lineBreak":true},{"text":"koni ɛ mi e toɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naxanye limaniyaxi,","poem":1},{"lineBreak":true},{"text":"bɔxɔn luma ne xa nɛn, e yi sabati,","poem":1},{"lineBreak":true},{"text":"e bɔɲɛ xunbenla sɔtɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Muxu ɲaxin fe ɲaxin nan yitɔnma tinxin muxun xili ma,","poem":1},{"lineBreak":true},{"text":"a a ɲinne raxin a xili ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Koni Marigin gelema muxu ɲaxine ma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a a kolon,","poem":1},{"lineBreak":true},{"text":"e fitina lɔxɔn mi fa buma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Muxu ɲaxine bata e silanfanne botin,","poem":1},{"lineBreak":true},{"text":"e e xanle ba,","poem":1},{"lineBreak":true},{"text":"e xa yiigelitɔne nun tɔrɔ muxune yɛngɛ,","poem":1},{"lineBreak":true},{"text":"e xa muxu faɲine faxa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Koni, e sɔxɔnma e gbee silanfanne nan na.","poem":1},{"lineBreak":true},{"text":"E xanle yi gira.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Se xurin naxan tinxin muxun yii,","poem":1},{"lineBreak":true},{"text":"na fisa muxu ɲaxine bannayaan xa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Amasɔtɔ muxu ɲaxine sɛnbɛn kalama nɛn,","poem":1},{"lineBreak":true},{"text":"koni Alatala tinxin muxune ratangama nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Alatala yengi dɔxi sɔntarene xɔn.","poem":1},{"lineBreak":true},{"text":"E kɛɛn luma nɛn habadan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E mi tɔrɛ waxati xɔdɛxɛne yi.","poem":1},{"lineBreak":true},{"text":"Fitina kamɛn na so,","poem":1},{"lineBreak":true},{"text":"e tan lugoma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Koni muxu ɲaxine faxama nɛn.","poem":1},{"lineBreak":true},{"text":"Alatala yaxune yi tunun","poem":1},{"lineBreak":true},{"text":"alo xɛɛn fugene.","poem":1},{"lineBreak":true},{"text":"E lɔma ayi nɛn alo tutina.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Muxu ɲaxin donla tongoma nɛn,","poem":1},{"lineBreak":true},{"text":"a mi a fiyɛ.","poem":1},{"lineBreak":true},{"text":"Koni tinxin muxun kiin tima fonisireyaan nin.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ala naxanye barakama,","poem":1},{"lineBreak":true},{"text":"bɔxɔn luma ne xa nɛn.","poem":1},{"lineBreak":true},{"text":"Koni a naxanye dangama,","poem":1},{"lineBreak":true},{"text":"ne ɲanma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Alatala nan muxun sigati kiin nagidima","poem":1},{"lineBreak":true},{"text":"a lu na kiraan xɔn","poem":1},{"lineBreak":true},{"text":"naxan nafan a ma.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Xa a dagalanɲɛ ayi,","poem":1},{"lineBreak":true},{"text":"a mi birɛ,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ Alatala a malima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Dii mɛsɛn nan yi n na,","poem":1},{"lineBreak":true},{"text":"koni iki n bata fori.","poem":1},{"lineBreak":true},{"text":"N siin bata waxati xunkuye sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Koni n munma tinxin muxun nabeɲinxin to singen,","poem":1},{"lineBreak":true},{"text":"hanma a diine yi donseen maxandi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A kiin tima fonisireyaan nan na waxatin birin yi,","poem":1},{"lineBreak":true},{"text":"a mɔn bonne dolima.","poem":1},{"lineBreak":true},{"text":"Dubana a diine xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ɛ xun xanbi so fe ɲaxini,","poem":1},{"lineBreak":true},{"text":"ɛ fe faɲin naba,","poem":1},{"lineBreak":true},{"text":"nanara i mamandenne luyɛ bɔxɔn ma habadan!","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Amasɔtɔ sariya suxun nafan Alatala ma.","poem":1},{"lineBreak":true},{"text":"A mi a muxu tɔgɔndiyaxin nabeɲinɲɛ.","poem":1},{"lineBreak":true},{"text":"A a kantanma nɛn habadan.","poem":1},{"lineBreak":true},{"text":"Koni muxu ɲaxine mamandenne tan ɲanma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tinxin muxune bɔxɔn sɔtɔma nɛn","poem":1},{"lineBreak":true},{"text":"alo kɛɛna, e lu na yi habadan.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tinxin muxun xaxilimaya falane nan tima.","poem":1},{"lineBreak":true},{"text":"Sariyan nan a falan na.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"A Alaa sariyan namarama a bɔɲɛni nɛn.","poem":1},{"lineBreak":true},{"text":"A mi tantanma a fe yi mumɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Muxu ɲaxin tinxin muxun legedenma","poem":1},{"lineBreak":true},{"text":"a faxa feen nan na.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Koni Alatala mi a luyɛ a yaxune sɛnbɛn bun ma.","poem":1},{"lineBreak":true},{"text":"A mi tinɲɛ a yalagi feen ma,","poem":1},{"lineBreak":true},{"text":"a na kiti waxatin naxan yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ɛ ɛ xaxili ti Alatala ra,","poem":1},{"lineBreak":true},{"text":"ɛ yi lu a kiraan xɔn.","poem":1},{"lineBreak":true},{"text":"A ɛ yitema nɛn,","poem":1},{"lineBreak":true},{"text":"a yamanan so ɛ yii.","poem":1},{"lineBreak":true},{"text":"Ɛ a toma nɛn nayi muxu ɲaxine bata ɲan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"N yi muxu ɲaxina nde kolon nun,","poem":1},{"lineBreak":true},{"text":"gbalotɔɔn nan yi a ra","poem":1},{"lineBreak":true},{"text":"naxan bata yi sabati","poem":1},{"lineBreak":true},{"text":"alo wudi gbeena.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Koni a danguxi nɛn,","poem":1},{"lineBreak":true},{"text":"a lɔ ayi feu!","poem":1},{"lineBreak":true},{"text":"N yi a fen, koni n mi a to.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"I xaxili lu sɔntaren xɔn.","poem":1},{"lineBreak":true},{"text":"I yɛɛn sa muxu faɲin xɔn.","poem":1},{"lineBreak":true},{"text":"Bɔɲɛ xunbelitɔɔn mayixɛtɛne sɔtɔma nɛn.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Koni yulubi kanne kalama nɛn feu!","poem":1},{"lineBreak":true},{"text":"E bɔnsɔnna birin yi raxɔri.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Alatala tinxin muxune rakisima nɛn.","poem":1},{"lineBreak":true},{"text":"E yigiya makantanxin nan a tan na tɔrɔ waxatine yi.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Alatala e malima nɛn a e ratanga.","poem":1},{"lineBreak":true},{"text":"A e ratanga muxu ɲaxine ma nɛn,","poem":1},{"lineBreak":true},{"text":"a e rakisi,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e luxunxi a yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}