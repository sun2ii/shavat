{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":38,"content":[{"type":"heading","content":["Tɔrɔ muxuna maxandina"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina. Maxandina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i nama n maxadi xɔlɔni!","poem":1},{"lineBreak":true},{"text":"I nama fitina n xili ma,","poem":1},{"lineBreak":true},{"text":"i n ɲaxankata.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bata n maxɔlɔ i ya xalimakunla ra.","poem":1},{"lineBreak":true},{"text":"I yi n nabira.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛndɛya mi fa n fatini i ya xɔlɔna fe ra.","poem":1},{"lineBreak":true},{"text":"N gbindin mi yalan n yulubina fe ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N hakɛne bata gbo ayi n xun ma","poem":1},{"lineBreak":true},{"text":"han a radangu ayi,","poem":1},{"lineBreak":true},{"text":"alo goronna naxan binya n mi a nɔɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ma korone bata kun,","poem":1},{"lineBreak":true},{"text":"e xirin yi mini.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ daxun nan yi n na nun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N bɔɲɛn bata kala","poem":1},{"lineBreak":true},{"text":"han n yi n xun sin.","poem":1},{"lineBreak":true},{"text":"N lu wugɛ n bɔɲɛni fɛriɲɛn gbɛn!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N fatin birin wolonxi n ma kati!","poem":1},{"lineBreak":true},{"text":"Kɛndɛya yo mi fa n fatini.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N bata yelefu bɔxɔn ma,","poem":1},{"lineBreak":true},{"text":"n bata kala feu!","poem":1},{"lineBreak":true},{"text":"N bɔɲɛn tɔrɔxi, n kutunma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n sɔxɔlɛxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Marigina, n naxan fenma,","poem":1},{"lineBreak":true},{"text":"i na kolon.","poem":1},{"lineBreak":true},{"text":"I bata n kutun xuiin birin mɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N bɔɲɛn dinma,","poem":1},{"lineBreak":true},{"text":"n fangan bata ɲan.","poem":1},{"lineBreak":true},{"text":"N yɛtagin bata yitɔɲɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N xɔyine nun n dɔxɔ bodene mi fa fama n fɛma","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n ma furen xɔn.","poem":1},{"lineBreak":true},{"text":"Hali n kon kaane bata e makuya n na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Naxanye waxi n faxa feni,","poem":1},{"lineBreak":true},{"text":"ne bata lutin nati n yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"Naxanye waxi n maxɔlɔ feni,","poem":1},{"lineBreak":true},{"text":"ne n kala feen falama.","poem":1},{"lineBreak":true},{"text":"E mi xadanma fe ɲaxi yitɔndeni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N bata liga alo tuli xɔrina,","poem":1},{"lineBreak":true},{"text":"n mi fe mɛma.","poem":1},{"lineBreak":true},{"text":"N bata liga alo bobona,","poem":1},{"lineBreak":true},{"text":"n mi fala tima.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N bata liga","poem":1},{"lineBreak":true},{"text":"alo muxun naxan mi yabin tiyɛ","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a mi fe mɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Koni Alatala, n xaxili tixi i tan na.","poem":1},{"lineBreak":true},{"text":"I n yabima nɛn, Marigina n ma Ala.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N naxa, “I nama tin","poem":1},{"lineBreak":true},{"text":"n yaxune yi e xunnayeren n na,","poem":1},{"lineBreak":true},{"text":"e nama ɲaxan n ma tɔrɔn na.”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N biramatɔɔn na a ra.","poem":1},{"lineBreak":true},{"text":"N xɔlɛni waxatin birin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N bata n ti n hakɛne ra,","poem":1},{"lineBreak":true},{"text":"n yulubine bata n naxamin kati!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N yaxune tan kɛndɛ,","poem":1},{"lineBreak":true},{"text":"e yixɔdɔxɔ.","poem":1},{"lineBreak":true},{"text":"E wuya","poem":1},{"lineBreak":true},{"text":"naxanye n naɲaxuxi fuu!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Naxanye fe faɲin saranma fe ɲaxin na,","poem":1},{"lineBreak":true},{"text":"ne n tɔrɔma,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n tan a faɲin nan fɔxɔ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Alatala, i nama n nabeɲin.","poem":1},{"lineBreak":true},{"text":"N ma Ala, i nama i makuya n na.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N Marigina, n nakisimana,","poem":1},{"lineBreak":true},{"text":"n mali iki sa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}