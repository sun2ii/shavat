{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":39,"content":[{"type":"heading","content":["Tɔrɔ muxun ti fena a hakɛn na"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa, Yedutun xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N bata a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“N na n kɛwanle rakɔrɔsima nɛn,","poem":1},{"lineBreak":true},{"text":"alogo n dɛ xuiin nama n bira yulubini.","poem":1},{"lineBreak":true},{"text":"N mi fa fala yo tiyɛ muxu ɲaxine yɛɛ xɔri.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yi n dundu,","poem":1},{"lineBreak":true},{"text":"n yi n naxara,","poem":1},{"lineBreak":true},{"text":"n mi yi fala yo tima","poem":1},{"lineBreak":true},{"text":"hali fe faɲina,","poem":1},{"lineBreak":true},{"text":"koni n ma sɔxɔlɛn yi siga fari sɛ tun!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N bɔɲɛn yi wolon n kui.","poem":1},{"lineBreak":true},{"text":"N to yi n mirima a ma,","poem":1},{"lineBreak":true},{"text":"a yi n kuiin gan fɔlɔ","poem":1},{"lineBreak":true},{"text":"alo tɛɛna.","poem":1},{"lineBreak":true},{"text":"N yi falan ti fɔlɔ, n naxa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Alatala,","poem":1},{"lineBreak":true},{"text":"n siin soge dɔnxɛn yita n na","poem":1},{"lineBreak":true},{"text":"e nun a yatɛ saxina.","poem":1},{"lineBreak":true},{"text":"I xa n nakolon","poem":1},{"lineBreak":true},{"text":"a n ma siimayaan mi buma.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I tan nan n ma lɔxɔne yatɛn nadungixi ayi.","poem":1},{"lineBreak":true},{"text":"Sese mi n siin waxatin na","poem":1},{"lineBreak":true},{"text":"i yɛɛ ra yi.","poem":1},{"lineBreak":true},{"text":"Adamadiin birin buma nɛn","poem":1},{"lineBreak":true},{"text":"alo foyedin gbansan!","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nininna nan gbansan a tan na.","poem":1},{"lineBreak":true},{"text":"Muxuna a masigama,","poem":1},{"lineBreak":true},{"text":"a feen ligama koni fuyan!","poem":1},{"lineBreak":true},{"text":"A nafunla malanma,","poem":1},{"lineBreak":true},{"text":"koni naxan a sɔtɛ a xanbi","poem":1},{"lineBreak":true},{"text":"a mi na kolon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Marigina, n fa n xaxili tima nanse ra nayi?","poem":1},{"lineBreak":true},{"text":"N na n yigin sama i tan nan yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N nakisi n yulubin birin ma.","poem":1},{"lineBreak":true},{"text":"I nama tin daxune yi gele n ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N yi dunduxi nɛn.","poem":1},{"lineBreak":true},{"text":"N mi yi fala yo tima.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i tan nan ito ligaxi n na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I ya furen ba n ma,","poem":1},{"lineBreak":true},{"text":"benun i xa n naɲan tɔrɔni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I muxun maxadima a hakɛna fe ra","poem":1},{"lineBreak":true},{"text":"i yi a hakɛn saran a ra.","poem":1},{"lineBreak":true},{"text":"I muxuna nafunle kalama alo xiine.","poem":1},{"lineBreak":true},{"text":"Adamadi yɛtɛɛn ligaxi nɛn alo foyedina.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alatala, n ma maxandi xuiin mɛ.","poem":1},{"lineBreak":true},{"text":"I yi i tuli mati n ma mawuga xuiin na.","poem":1},{"lineBreak":true},{"text":"N na wuga, i nama i dundu.","poem":1},{"lineBreak":true},{"text":"I ya xɔɲɛn nan tun n tan na sigatini,","poem":1},{"lineBreak":true},{"text":"alo n benbane yi kii naxan yi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N yiba singen","poem":1},{"lineBreak":true},{"text":"alogo n xa sɛwa benun n xa dangu,","poem":1},{"lineBreak":true},{"text":"benun n xa faxa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}