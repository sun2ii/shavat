{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":4,"content":[{"type":"heading","content":["Yigi sana Ala yi"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba maxase luti kanne ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N ma Ala tinxinxina,","poem":1},{"lineBreak":true},{"text":"n na i xili, i xa n yabi.","poem":1},{"lineBreak":true},{"text":"N ma tɔrɔni, i xa n mali.","poem":1},{"lineBreak":true},{"text":"Kininkinin n ma,","poem":1},{"lineBreak":true},{"text":"i yi n ma maxandin namɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɛ tan adamadiine,","poem":1},{"lineBreak":true},{"text":"ɛ n ma binyen findima yagin na","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"Ɛ fatama fe fuune nun wulene ma","poem":1},{"lineBreak":true},{"text":"waxatin mundun yi?","poem":1},"Bɛti xuini te."]},{"type":"verse","number":4,"content":[{"text":"Ɛ xa a kolon,","poem":1},{"lineBreak":true},{"text":"a Alatala bata muxu tɔgɔndiyaxine sugandi a yɛtɛ xa.","poem":1},{"lineBreak":true},{"text":"N na Alatala maxandi,","poem":1},{"lineBreak":true},{"text":"a n xuiin mɛma nɛn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ gaxu, ɛ fata yulubi ligan ma.","poem":1},{"lineBreak":true},{"text":"Ɛ na ɛ sa, ɛ raxara,","poem":1},{"lineBreak":true},{"text":"ɛ bɔɲɛn namiri.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":6,"content":[{"text":"Ɛ saraxan ba Ala xa tinxinni.","poem":1},{"lineBreak":true},{"text":"Ɛ yigin sa Alatala yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Muxu wuyaxi naxa,","poem":1},{"lineBreak":true},{"text":"“Nde hɛrin yitɛ en na?","poem":1},{"lineBreak":true},{"text":"Alatala, i nɔrɔn xa godo nxu ma!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Koni i bata n bɔɲɛn nasɛwa han,","poem":1},{"lineBreak":true},{"text":"dangu se xaba waxatin lugon sɛwan na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N na n sa,","poem":1},{"lineBreak":true},{"text":"n xima bɔɲɛ xunbenla nin,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i tan Alatala nan tun n makantanma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}