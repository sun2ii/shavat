{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":40,"content":[{"type":"heading","content":["Tantun Bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N diɲa nɛn Alatala maliin legedendeni,","poem":1},{"lineBreak":true},{"text":"a yi a tuli mati,","poem":1},{"lineBreak":true},{"text":"a yi n ma mawuga xuiin mɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A n ba yili ɲaxin na,","poem":1},{"lineBreak":true},{"text":"a n ba boron nun bɛndɛni.","poem":1},{"lineBreak":true},{"text":"A yi n ti fanyen fari,","poem":1},{"lineBreak":true},{"text":"a san tide faɲin fi n ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A yi n xaran bɛti nɛnɛn ma,","poem":1},{"lineBreak":true},{"text":"n na en ma Ala tantunma naxan na.","poem":1},{"lineBreak":true},{"text":"Muxu wuyaxi na toma nɛn","poem":1},{"lineBreak":true},{"text":"e yi gaxu a yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e mɔn yi e yigin sa Alatala yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sɛwan na kanna xa,","poem":1},{"lineBreak":true},{"text":"naxan na a yigi sa Alatala yi,","poem":1},{"lineBreak":true},{"text":"naxan mi kidene batuma,","poem":1},{"lineBreak":true},{"text":"naxan mi a sama suxure batune ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ya wali faɲine wuya ayi!","poem":1},{"lineBreak":true},{"text":"Alatala, n ma Ala, i ɲɔxɔn mi na!","poem":1},{"lineBreak":true},{"text":"I bata kabanako fe wuyaxi yitɔn nxu xa!","poem":1},{"lineBreak":true},{"text":"N mi nɔɛ e fe falɛ,","poem":1},{"lineBreak":true},{"text":"e yatɛn bata gbo ayi!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I mi waxi saraxan nun kiseen xɔn gbansan,","poem":1},{"lineBreak":true},{"text":"fɔ i n tunle raba ayi.","poem":1},{"lineBreak":true},{"text":"I mi yi saraxa gan daxine","poem":1},{"lineBreak":true},{"text":"nun yulubi xafari saraxane gbansan fɔxɔ ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nanara, n naxa, “N tan ni i ra.","poem":1},{"lineBreak":true},{"text":"N bata fa.","poem":1},{"lineBreak":true},{"text":"N ma fe sɛbɛxi Kitabuni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N ma Ala, i sagoon nafan n ma!","poem":1},{"lineBreak":true},{"text":"I ya sariyan namaraxi n bɔɲɛni.”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N tinxinyaan nalima nɛn i ya yamani.","poem":1},{"lineBreak":true},{"text":"Alatala, i a kolon,","poem":1},{"lineBreak":true},{"text":"n mi n dundɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N mi i ya tinxinyaan namaraxi n kedenna xa.","poem":1},{"lineBreak":true},{"text":"N ni i ya ɲɔndin nun marakisina fe falama nɛn.","poem":1},{"lineBreak":true},{"text":"N mi i ya hinanna nun i ya lannayaan luxunɲɛ yamaan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"I nama tondi kininkininɲɛ n ma, Alatala.","poem":1},{"lineBreak":true},{"text":"I ya hinanna nun lannayana n marama nɛn waxatin birin.","poem":1}]},{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":13,"content":[{"text":"Amasɔtɔ, n ma tɔrɔne bata wuya","poem":1},{"lineBreak":true},{"text":"han e mi yatɛ!","poem":1},{"lineBreak":true},{"text":"N hakɛne bata n suxu,","poem":1},{"lineBreak":true},{"text":"n mi fa se toma.","poem":1},{"lineBreak":true},{"text":"E wuya dangu n xunsɛxɛne ra.","poem":1},{"lineBreak":true},{"text":"Bɔɲɛ yixɔdɛxɛ mi fa n yi sɔnɔn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yandi, Alatala, n nakisi!","poem":1},{"lineBreak":true},{"text":"Alatala, fa n mali iki sa!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ala xa ne yarabi","poem":1},{"lineBreak":true},{"text":"naxanye katama n faxa feen na,","poem":1},{"lineBreak":true},{"text":"a e yɛ yifu fefe!","poem":1},{"lineBreak":true},{"text":"Ala xa ne raxɛtɛ marafɛyani","poem":1},{"lineBreak":true},{"text":"n ma tɔrɔyaan nafanxi naxanye ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ala xa ne ratɛrɛna e yagin na,","poem":1},{"lineBreak":true},{"text":"naxanye a falama n ma,","poem":1},{"lineBreak":true},{"text":"e naxa, “Yɔ! I suxi yati!”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Naxanye birin i tan fenma,","poem":1},{"lineBreak":true},{"text":"i xa ne birin nasɛwa.","poem":1},{"lineBreak":true},{"text":"I ya kisin xɔnla naxanye ra,","poem":1},{"lineBreak":true},{"text":"ne xa lu a falɛ,","poem":1},{"lineBreak":true},{"text":"e naxa, “Alatala gbo!”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Koni, yiigelitɔɔn nun tɔrɔ muxun nan n tan na.","poem":1},{"lineBreak":true},{"text":"N Marigin nama ɲinan n xɔn.","poem":1},{"lineBreak":true},{"text":"I tan nan n maliin nun n ma maratanga tiin na.","poem":1},{"lineBreak":true},{"text":"Ala, i nama buyɛ ayi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":18}