{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":41,"content":[{"type":"heading","content":["Furetɔna Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Sɛwan na kanna xa","poem":1},{"lineBreak":true},{"text":"naxan yengi dɔxi sɛnbɛtarene xɔn.","poem":1},{"lineBreak":true},{"text":"Alatala na kanna xunbama tɔrɔ waxatine yi nɛn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala a ratangama nɛn","poem":1},{"lineBreak":true},{"text":"a a niin nakisi.","poem":1},{"lineBreak":true},{"text":"A a barakama nɛn bɔxɔn ma.","poem":1},{"lineBreak":true},{"text":"A mi a luyɛ a yaxune sɛnbɛn bun ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala a malima nɛn,","poem":1},{"lineBreak":true},{"text":"furen na a li waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"a a rakɛndɛya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N na a fala nɛn, n naxa,","poem":1},{"lineBreak":true},{"text":"“Alatala, diɲa, i n nakɛndɛya,","poem":1},{"lineBreak":true},{"text":"bayo n bata yulubin liga i ra.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N yaxune fala ɲaxine tima n ma,","poem":1},{"lineBreak":true},{"text":"e naxa, “A faxama waxatin mundun yi,","poem":1},{"lineBreak":true},{"text":"a xinla yi lɔ ayi?”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Naxanye fama n xɔntɔndeni,","poem":1},{"lineBreak":true},{"text":"ne fala faɲine nan tima n xa nafigiyani.","poem":1},{"lineBreak":true},{"text":"Koni, a dɛntɛgɛ ɲaxini tɔnma n ma fe ra,","poem":1},{"lineBreak":true},{"text":"a yi mini a ralideni yiren birin yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Naxanye birin n naɲaxuxi,","poem":1},{"lineBreak":true},{"text":"ne kɔyɛkɔyɛnma e bode xa n ma fe ra.","poem":1},{"lineBreak":true},{"text":"E mirixi a ɲaxin nan ma n ma fe yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E naxa, “Fure ɲaxin bata a suxu!","poem":1},{"lineBreak":true},{"text":"A mi fa kelɛ a sadeni feu!”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hali n lanfa faɲina,","poem":1},{"lineBreak":true},{"text":"n yi laxi naxan na,","poem":1},{"lineBreak":true},{"text":"nxu nun naxan yi donseen donma nxu bode xɔn,","poem":1},{"lineBreak":true},{"text":"na bata keli n xili ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alatala, kininkinin n ma,","poem":1},{"lineBreak":true},{"text":"i yi n nakeli sɔnɔn,","poem":1},{"lineBreak":true},{"text":"nanara n na n yaxune donla saranɲɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N na a kolon","poem":1},{"lineBreak":true},{"text":"fa fala n bata i kɛnɛn","poem":1},{"lineBreak":true},{"text":"bayo e mi n nɔɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I n malima nɛn","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n tinxin.","poem":1},{"lineBreak":true},{"text":"I yi n lu i yɛtagi habadan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Barikan xa bira Alatala xa, Isirayilaa Ala!","poem":1},{"lineBreak":true},{"text":"Habadan han habadan! Amina! Amina!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}