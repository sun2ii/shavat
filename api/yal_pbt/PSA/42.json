{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":42,"content":[{"type":"heading","content":["Yigi sana Ala yi"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine fala ɲaxumɛna. Bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, i xɔnla n niin suxuma","poem":1},{"lineBreak":true},{"text":"alo ige xunbenla xɔnla xɛnla suxun kii naxan yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Habadan Ala xɔnla n niin suxuma nɛn","poem":1},{"lineBreak":true},{"text":"alo min xɔnla.","poem":1},{"lineBreak":true},{"text":"N sigama waxatin mundun yi","poem":1},{"lineBreak":true},{"text":"n sa ti Ala yɛtagi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N wugama kɔɛɛn nun yanyin na.","poem":1},{"lineBreak":true},{"text":"N baloma yɛɛgen nin.","poem":1},{"lineBreak":true},{"text":"N yaxune n maxɔdinma waxatin birin","poem":1},{"lineBreak":true},{"text":"e naxa, “I ya Ala minɛn yi?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waxati danguxine fe na rabira n ma,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛn yi kala.","poem":1},{"lineBreak":true},{"text":"Nxu nun yamaan nan yi sigama Alaa banxini,","poem":1},{"lineBreak":true},{"text":"n yi tima e yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e sɛwaxin sɔnxɔma,","poem":1},{"lineBreak":true},{"text":"e barikan birama Ala xa ɲaxan nin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanfera n niin sɔxɔlɛxi?","poem":1},{"lineBreak":true},{"text":"Nanfera n bɔɲɛn sunuxi?","poem":1},{"lineBreak":true},{"text":"N xa n yigi sa Ala yi.","poem":1},{"lineBreak":true},{"text":"N mɔn a tantunma nɛn.","poem":1},{"lineBreak":true},{"text":"N kisi muxun nun n ma Ala nan a ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Koni iki, n niin sɔxɔlɛxi,","poem":1},{"lineBreak":true},{"text":"nanara n na n mirima i ma Yurudɛn bɔxɔni,","poem":1},{"lineBreak":true},{"text":"Xerimon geyane xuntagi,","poem":1},{"lineBreak":true},{"text":"e nun Misari geyaan ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fufaan sama fufaan fari n xili ma,","poem":1},{"lineBreak":true},{"text":"igen xuxu xuiin yi gbo ayi a surundeni.","poem":1},{"lineBreak":true},{"text":"I xunfan gbeene radangu n xun ma,","poem":1},{"lineBreak":true},{"text":"gbalon yi keli n xili ma alo walanna.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala xa a hinanna mayita yanyin na","poem":1},{"lineBreak":true},{"text":"alogo n yi xi bɛtin bɛ a xa kɔɛɛn na.","poem":1},{"lineBreak":true},{"text":"N ma dunuɲa yi gidin Ala nan maxandima.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N na a falama n natangamana Ala nan xa,","poem":1},{"lineBreak":true},{"text":"n naxa, “Nanfera i ɲinanxi n xɔn ma?","poem":1},{"lineBreak":true},{"text":"Nanfera n luma tɔrɛ n yaxune yii?”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N niin tɔrɔxi n yaxune xɔn","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e fɛriɲɛnma n maxɔdinɲɛ nɛn,","poem":1},{"lineBreak":true},{"text":"e naxa, “I ya Ala minɛn?”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nanfera n niin sɔxɔlɛxi?","poem":1},{"lineBreak":true},{"text":"Nanfera n bɔɲɛn sunuxi?","poem":1},{"lineBreak":true},{"text":"N xa n yigin sa Ala yi.","poem":1},{"lineBreak":true},{"text":"N mɔn a tantunma nɛn","poem":1},{"lineBreak":true},{"text":"n ma Ala, n nakisimana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":12}