{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ala, yoon fi n ma,","poem":1},{"lineBreak":true},{"text":"i n xun mayɛngɛn so dɛnkɛlɛyatare yamaan xili ma.","poem":1},{"lineBreak":true},{"text":"N natanga wuledene nun muxu ɲaxine ma!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N kantan muxun nan i tan na.","poem":1},{"lineBreak":true},{"text":"Nanfera i n nabeɲinma?","poem":1},{"lineBreak":true},{"text":"Nanfera n sunuxin luma tɔrɛ muxu ɲaxine xɔn?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I ya kɛnɛnna nun i ya ɲɔndin nafa n ma!","poem":1},{"lineBreak":true},{"text":"E xa ti n yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"siga i ya geya sariɲanxin fari i yɛtagi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nayi, n sigama nɛn Alaa saraxa ganden dɛxɔn,","poem":1},{"lineBreak":true},{"text":"Ala naxan findixi n ma sɛwan nun n ma ɲaxanna ra.","poem":1},{"lineBreak":true},{"text":"N na n ma bɔlɔnna maxa","poem":1},{"lineBreak":true},{"text":"n tantun bɛtin ba i tan Ala xa,","poem":1},{"lineBreak":true},{"text":"n ma Ala.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nanfera n niin sɔxɔlɛxi?","poem":1},{"lineBreak":true},{"text":"Nanfera n bɔɲɛn sunuxi?","poem":1},{"lineBreak":true},{"text":"N xa n yigin sa Ala yi.","poem":1},{"lineBreak":true},{"text":"N mɔn a tantunma nɛn","poem":1},{"lineBreak":true},{"text":"n ma Ala, n nakisimana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}