{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":46,"content":[{"type":"heading","content":["En fangana Ala nan na"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine Ala tantun sigina, bɛti baane kuntigin xa. Sungutunne xa a ba.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala nan en yigiyaan na","poem":1},{"lineBreak":true},{"text":"e nun en fangana.","poem":1},{"lineBreak":true},{"text":"A yitɔnxi mali ti feen na tɔrɔ waxatine birin yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nanara, hali bɔxɔn xuruxurun,","poem":1},{"lineBreak":true},{"text":"geyane yi bira fɔxɔ ige tilinxine yi,","poem":1},{"lineBreak":true},{"text":"en mi gaxuɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hali fɔxɔ igene xuxu,","poem":1},{"lineBreak":true},{"text":"geyane fan yi yimaxa gbaloni","poem":1},{"lineBreak":true},{"text":"en mi gaxuɛ.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xudena Alaa taani","poem":1},{"lineBreak":true},{"text":"naxan a muxune rasɛwama","poem":1},{"lineBreak":true},{"text":"naxan findixi Kore Xɔnna Ala dɔxɔde sariɲanxin na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala na taani,","poem":1},{"lineBreak":true},{"text":"a mi yimaxɛ mumɛ!","poem":1},{"lineBreak":true},{"text":"Kuye nɛma yiba,","poem":1},{"lineBreak":true},{"text":"Ala bata taan mali,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"siyane yi sɔnxɔn nate,","poem":1},{"lineBreak":true},{"text":"mangayane yi yimaxa.","poem":1},{"lineBreak":true},{"text":"Ala na a xuini te,","poem":1},{"lineBreak":true},{"text":"bɔxɔn yi xuruxurun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna nan en xɔn.","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala nan en ma faran makantanxin na.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛ fa Alatala a wanle mato,","poem":1},{"lineBreak":true},{"text":"a gbalon naxanye rakelixi bɔxɔn ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A yɛngɛne ɲanma","poem":1},{"lineBreak":true},{"text":"han bɔxɔn danna birin yi.","poem":1},{"lineBreak":true},{"text":"A xanle yigirama,","poem":1},{"lineBreak":true},{"text":"a tanbane kala,","poem":1},{"lineBreak":true},{"text":"a yi yɛ masansan wure lefane gan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A yi a fala, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ɛ ɛ raxara,","poem":1},{"lineBreak":true},{"text":"ɛ yi a kolon a n tan nan Ala ra.","poem":1},{"lineBreak":true},{"text":"N batuma nɛn siyane tagi.","poem":1},{"lineBreak":true},{"text":"N yi batu bɔxɔn birin yi.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna en tan nan xɔn.","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala nan en ma faran makantanxin na.","poem":1},"Bɛti xuini te."]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":12}