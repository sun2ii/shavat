{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"heading","content":["Ala fisamanten mangana"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ɛ tan, siyane birin xa ɛ yiin bɔnbɔ,","poem":1},{"lineBreak":true},{"text":"ɛ sɔnxɔ, ɛ xuini te sɛwani Ala xa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala, Kore Xɔnna Ala magaxu han!","poem":1},{"lineBreak":true},{"text":"Manga gbeen na a ra dunuɲa birin xun na!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A bata nɔɔn fi en ma siyane xun na,","poem":1},{"lineBreak":true},{"text":"a yamane raso en ma nɔɔn bun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A bɔxɔn sugandi nɛn nxu xa,","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔnne sabatima","poem":1},{"lineBreak":true},{"text":"dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"a naxanye xanuxi.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ala bata dɔxɔ a mangaya gbɛdɛni.","poem":1},{"lineBreak":true},{"text":"Yamaan sɔnxɔma sɛwani,","poem":1},{"lineBreak":true},{"text":"xɔta xuine yi mini Alatala xa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tantun bɛtin ba Ala xa,","poem":1},{"lineBreak":true},{"text":"bɛtine ba han!","poem":1},{"lineBreak":true},{"text":"Tantun bɛtin ba en ma mangan xa,","poem":1},{"lineBreak":true},{"text":"bɛtine ba han!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala nan mangan na dunuɲa birin xun na,","poem":1},{"lineBreak":true},{"text":"ɛ a tantun bɛtini.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala dɔxi a manga gbɛdɛ sariɲanxini,","poem":1},{"lineBreak":true},{"text":"a mangayaan nabama siyane xun na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siyane mangane sama nɛn","poem":1},{"lineBreak":true},{"text":"Iburahimaa Alaa yamaan fari.","poem":1},{"lineBreak":true},{"text":"A tan nan gbee dunuɲa ganle birin na.","poem":1},{"lineBreak":true},{"text":"Ala gbo han!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}