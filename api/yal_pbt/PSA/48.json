{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":48,"content":[{"type":"heading","content":["Siyon Ala gbee taana"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine bɛtina. Sigi sariɲanxina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala gbo,","poem":1},{"lineBreak":true},{"text":"a lan a xa matɔxɔ","poem":1},{"lineBreak":true},{"text":"a gbee taani geya sariɲanxin fari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siyon, Alaa geyana,","poem":1},{"lineBreak":true},{"text":"a mate, a tofan,","poem":1},{"lineBreak":true},{"text":"dunuɲa birin sɛwama a fe ra.","poem":1},{"lineBreak":true},{"text":"A mate","poem":1},{"lineBreak":true},{"text":"alo bɔxɔne birin manga taana","poem":1},{"lineBreak":true},{"text":"Manga Gbeen dɔxi dɛnaxan yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala a yengi sama nɛn a taa makantanxin xɔn,","poem":1},{"lineBreak":true},{"text":"a bata a yɛtɛ findi a kantanmaan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mangane to e malan Siyon yɛngɛ xinla ma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"e yi a to, e kabɛ,","poem":1},{"lineBreak":true},{"text":"e gaxu, e yi e gi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xuruxurunna nun kuisanna yi e suxu na,","poem":1},{"lineBreak":true},{"text":"alo ɲaxanla kuiin na keli a ra,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"alo kunkibane na kɔntɔfili foye gbeena fe ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala kabanako feen naxanye ligaxi,","poem":1},{"lineBreak":true},{"text":"nxu bata ne mɛ.","poem":1},{"lineBreak":true},{"text":"Iki, nxu bata ne to Alatala Sɛnbɛn Birin Kanna taani.","poem":1},{"lineBreak":true},{"text":"A na taan nakisima nɛn habadan!","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nanara, Ala nxu nxu mirima i ya hinanna ma i Batu Banxini.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I tan xili kanna tantunma dunuɲa yiren birin yi.","poem":1},{"lineBreak":true},{"text":"I mangayaan ligama tinxinyaan na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yamaan xa ɲaxan Siyon geyaan fari,","poem":1},{"lineBreak":true},{"text":"Yuda taa kaane xa sɛwa","poem":1},{"lineBreak":true},{"text":"i ya kitisana fe ra!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɛ bilin Siyon ma,","poem":1},{"lineBreak":true},{"text":"ɛ yi a kondene yatɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɛ ɛ xaxili lu a yinna xɔn ma,","poem":1},{"lineBreak":true},{"text":"ɛ mɔn yi a sangansone mato,","poem":1},{"lineBreak":true},{"text":"nanara ɛ a falɛ mayixɛtɛ famatɔne xa,","poem":1},{"lineBreak":true},{"text":"ɛ naxa,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"“Ala ito,","poem":1},{"lineBreak":true},{"text":"nxɔ Ala na a ra habadan!","poem":1},{"lineBreak":true},{"text":"A tima nxu yɛɛ ra nɛn han a raɲanni.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}