{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":49,"content":[{"type":"heading","content":["Nafulu fuyanna fe"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ɛ ito mɛ, ɛ tan siyane,","poem":1},{"lineBreak":true},{"text":"ɛ tuli mati","poem":1},{"lineBreak":true},{"text":"ɛ tan muxun naxanye birin dunuɲa yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fanga kanne nun tɔrɔ muxune,","poem":1},{"lineBreak":true},{"text":"nafulu kanne nun yiigelitɔne,","poem":1},{"lineBreak":true},{"text":"birin xa a tuli mati.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N fekolonna falane nan tima,","poem":1},{"lineBreak":true},{"text":"n mirine xaxili faɲin nan fima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na n xaxinla rasigama sandan nan xɔn,","poem":1},{"lineBreak":true},{"text":"n yi a yɛba, n nɛma n ma bɔlɔnna maxɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanfera n gaxuma gbalo lɔxɔne yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"hakɛ kan yanfantenne n nabilinma waxatin naxan yi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E yigin saxi e se kanyaan nan ma,","poem":1},{"lineBreak":true},{"text":"e mɔn yi e kanba e nafulu kanyani.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Muxun mi nɔɛ a boden xunbɛ.","poem":1},{"lineBreak":true},{"text":"A mi nɔɛ a niin saren soɛ Ala yii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amasɔtɔ muxun niin xunbaan xɔdɔxɔ!","poem":1},{"lineBreak":true},{"text":"A mi nɔɛ a saren fiyɛ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"alogo a xa bu habadan, a mi faxa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amasɔtɔ, en birin a kolon xaxilimane fan faxama","poem":1},{"lineBreak":true},{"text":"e nun daxune nun kɔmɔne.","poem":1},{"lineBreak":true},{"text":"E birin e nafunle luma muxu gbɛtɛne nan yii.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gaburun yi findi e habadan banxin na,","poem":1},{"lineBreak":true},{"text":"e luma dɛnaxan yi, dan mi naxan na,","poem":1},{"lineBreak":true},{"text":"hali bɔxɔn to yi e yii e yɛtɛ ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Muxuna gboon mi a rabuyɛ.","poem":1},{"lineBreak":true},{"text":"A fan faxama nɛn alo subene.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Muxun naxanye laxi e yɛtɛ ra fuyan nin,","poem":1},{"lineBreak":true},{"text":"e sigaden nan na ra,","poem":1},{"lineBreak":true},{"text":"naxanye wasaxi e nafunle ra,","poem":1},{"lineBreak":true},{"text":"ne raɲanma na kii nin.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":15,"content":[{"text":"E rasigama laxira yi nɛn","poem":1},{"lineBreak":true},{"text":"alo yɛxɛɛn naɲanna to faxan na.","poem":1},{"lineBreak":true},{"text":"Sayaan yi e gbindine don.","poem":1},{"lineBreak":true},{"text":"Muxu faɲine nɔɔn sɔtɔma nɛn e xun na sinma,","poem":1},{"lineBreak":true},{"text":"e tofanna yi kala,","poem":1},{"lineBreak":true},{"text":"e siga gaburuni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Koni Ala n niin xunbama nɛn laxira yi yati!","poem":1},{"lineBreak":true},{"text":"A yi n xali.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Muxun na nafunla sɔtɔ,","poem":1},{"lineBreak":true},{"text":"a nafunli gbo ayi,","poem":1},{"lineBreak":true},{"text":"i nama gaxu,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"bayo a mi sese xalima a yii laxira yi.","poem":1},{"lineBreak":true},{"text":"A hɛrisigɛn mi birama a fɔxɔ ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hali duba diin nan yi a ra a dunuɲa yi gidini,","poem":1},{"lineBreak":true},{"text":"hali a to matɔxɔxi,","poem":1},{"lineBreak":true},{"text":"a yi sabatixi waxatin naxan yi,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"a sama a benbane fari nɛn laxira yi.","poem":1},{"lineBreak":true},{"text":"Ne mi fa dunuɲa toma sɔnɔn.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nafulu kanna naxan xaxili xurun,","poem":1},{"lineBreak":true},{"text":"na maliga xuruseen nan na,","poem":1},{"lineBreak":true},{"text":"naxan faxamatɔ a ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":21}