{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":5,"content":[{"type":"heading","content":["Ala xa en natanga"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba xulenna ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i tuli mati n fala xuine ra,","poem":1},{"lineBreak":true},{"text":"i yi i tuli mati n kutun xuiin na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma Ala nun n ma mangana,","poem":1},{"lineBreak":true},{"text":"i tuli mati n ma wuga xuiin na.","poem":1},{"lineBreak":true},{"text":"N ni i tan nan maxandima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala, xɔtɔnni i n xuiin namɛma.","poem":1},{"lineBreak":true},{"text":"Xɔtɔnni, n na n yitama i ra,","poem":1},{"lineBreak":true},{"text":"n yi i ya yabin mamɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ala mi i tan na","poem":1},{"lineBreak":true},{"text":"fe ɲaxin nafan naxan ma.","poem":1},{"lineBreak":true},{"text":"I mi tinɲɛ muxu ɲaxi yo ra i yɛtagi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wasodene mi tiyɛ i yɛtagi.","poem":1},{"lineBreak":true},{"text":"I fe ɲaxi rabane birin naɲaxuma nɛn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I wuledene halagima nɛn.","poem":1},{"lineBreak":true},{"text":"Alatala faxa tiine nun yanfantenne raɲaxuma nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Koni n tan soma nɛn i konni","poem":1},{"lineBreak":true},{"text":"i ya hinan gbeen xɔn ma,","poem":1},{"lineBreak":true},{"text":"n ni i batuma nɛn i ya Banxi Sariɲanxini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Alatala, ti n yɛɛ ra i ya tinxinni n yaxune e fe ra.","poem":1},{"lineBreak":true},{"text":"I ya kiraan yita n na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N mi lɛ n yaxune fala xui yo ra,","poem":1},{"lineBreak":true},{"text":"e waxi fe kalan nan tun xɔn ma.","poem":1},{"lineBreak":true},{"text":"E kɔɛ yinle rabixi alo gaburuna,","poem":1},{"lineBreak":true},{"text":"yanfa falane nan e lɛnne ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala, e yalagi,","poem":1},{"lineBreak":true},{"text":"e kɔtɛne xa findi e yɛtɛ bira xunna ra.","poem":1},{"lineBreak":true},{"text":"E kedi i yɛtagi e matandine fe ra,","poem":1},{"lineBreak":true},{"text":"bayo e bata murutɛ i ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Koni ne birin xa ɲaxan,","poem":1},{"lineBreak":true},{"text":"naxanye e luxunxi i yi.","poem":1},{"lineBreak":true},{"text":"E xa bɛtin ba sɛwani habadan!","poem":1},{"lineBreak":true},{"text":"Na muxune ratanga","poem":1},{"lineBreak":true},{"text":"i xinla rafan naxanye ma,","poem":1},{"lineBreak":true},{"text":"e yi sɛwa i ya fe ra!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala, i tinxin muxune barakama nɛn,","poem":1},{"lineBreak":true},{"text":"i yi e rabilin fanna ra","poem":1},{"lineBreak":true},{"text":"i yi e ratanga","poem":1},{"lineBreak":true},{"text":"alo yɛ masansan wure lefana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}