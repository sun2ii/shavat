{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":50,"content":[{"type":"heading","content":["Saraxan naxan Ala kɛnɛn"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina.","descriptive":true},{"text":"Fangamana, Marigina Alatala falan tima,","poem":1},{"lineBreak":true},{"text":"a dunuɲa muxune birin maxili,","poem":1},{"lineBreak":true},{"text":"sa fɔlɔ sogetedeni","poem":1},{"lineBreak":true},{"text":"han sa dɔxɔ sogegododen na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alaa nɔrɔn mayilenma keli Siyon yi","poem":1},{"lineBreak":true},{"text":"na taa kamalixi tofaɲina.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En ma Ala fama,","poem":1},{"lineBreak":true},{"text":"a mi dunduxi.","poem":1},{"lineBreak":true},{"text":"Kala ti tɛɛ gbeena a yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"foye gbeena a rabilinxi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A koren nun bɔxɔn xilima","poem":1},{"lineBreak":true},{"text":"e xa findi seren na a yamaan makitideni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A yi a fala, a naxa,","poem":1},{"lineBreak":true},{"text":"“N ma muxu tɔgɔndiyaxine malan n fɛma,","poem":1},{"lineBreak":true},{"text":"naxanye layirin xidixi n xɔn ma saraxa baan na.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Koren xɔnna a tinxinyaan nalima nɛn,","poem":1},{"lineBreak":true},{"text":"bayo Ala yɛtɛɛn nan kitisaan na.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“N ma yamana, ɛ ɛ tuli mati,","poem":1},{"lineBreak":true},{"text":"n falan tima nɛn.","poem":1},{"lineBreak":true},{"text":"Isirayila, n na ɛ maxadima,","poem":1},{"lineBreak":true},{"text":"bayo Ala nan n tan na, ɛ Ala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N mi ɛ maxadima ɛ saraxane xan ma fe ra.","poem":1},{"lineBreak":true},{"text":"Ɛ saraxa gan daxine bama n xa waxatin birin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Koni, n mi turaan xa tongoma ɛ sansanne yi","poem":1},{"lineBreak":true},{"text":"xanamu kɔtɔn naxan ɛ kulane yi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amasɔtɔ n gbeen nan burunna subene birin na.","poem":1},{"lineBreak":true},{"text":"N gbeen nan ɲingene ra","poem":1},{"lineBreak":true},{"text":"naxanye geya wuli wuyaxine ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N tan nan xɔline ngaan kanna ra","poem":1},{"lineBreak":true},{"text":"naxanye geyane ma","poem":1},{"lineBreak":true},{"text":"e nun niimaseen naxanye birin fixɛne ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xa kamɛn yi n suxun nɛn nun,","poem":1},{"lineBreak":true},{"text":"n mi na falɛ i xa,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n tan nan gbee dunuɲa","poem":1},{"lineBreak":true},{"text":"nun ayi seene birin na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N ɲinge suben donɲɛ ba?","poem":1},{"lineBreak":true},{"text":"Ɛn-ɛn de!","poem":1},{"lineBreak":true},{"text":"Xanamu n siin wunla min?","poem":1},{"lineBreak":true},{"text":"Ɛn-ɛn de!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nanara, barika biran xa findi ɛ saraxan na Ala xa.","poem":1},{"lineBreak":true},{"text":"Ɛ ɛ dɛ ti xuine rakamali Kore Xɔnna Ala xa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N xili tɔrɔ waxatini.","poem":1},{"lineBreak":true},{"text":"N ni i kantanma nɛn, i yi n binya.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Koni Ala a falama muxu ɲaxine xa nɛn,","poem":1},{"lineBreak":true},{"text":"a naxa, “Nanfera ɛ xɛtɛma n ma tɔnne falan ma,","poem":1},{"lineBreak":true},{"text":"ɛ yi n ma layirina fe fala,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"koni n ma xaranna mi rafan ɛ ma?","poem":1},{"lineBreak":true},{"text":"Ɛ mɛxi n ma falane ra!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɛ nun muɲadene na a ra.","poem":1},{"lineBreak":true},{"text":"Ɛ nun yalundene na a ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ɛ fala ɲaxin nan tun tima.","poem":1},{"lineBreak":true},{"text":"Ɛ wulen nan tun falama.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ɛ ngaxakedenne kansunma waxatin birin yi.","poem":1},{"lineBreak":true},{"text":"Ɛ katama e tɔɲɛgɛdeni.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ɛ bata ito birin liga","poem":1},{"lineBreak":true},{"text":"n mi fala ti.","poem":1},{"lineBreak":true},{"text":"Nanara, ɛ mirixi a n fan ligaxi","poem":1},{"lineBreak":true},{"text":"alo ɛ tan.","poem":1},{"lineBreak":true},{"text":"Koni iki, n na ɛ maxadima,","poem":1},{"lineBreak":true},{"text":"n yi a yɛba ɛ xa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Iki, ɛ ito famu,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye Ala bɔtɛ rabaxi.","poem":1},{"lineBreak":true},{"text":"Xa na mi a ra,","poem":1},{"lineBreak":true},{"text":"n na ɛ raxɔrima nɛn.","poem":1},{"lineBreak":true},{"text":"Muxu yo mi ɛ xunbɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Naxan na saraxa baan findi barika biran na,","poem":1},{"lineBreak":true},{"text":"na nan n binyaxi.","poem":1},{"lineBreak":true},{"text":"Naxan na siga kira faɲin xɔn,","poem":1},{"lineBreak":true},{"text":"n na Ala kisin yitama nɛn na ra.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}