{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":51,"content":[{"type":"heading","content":["Yulubi ratina"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"A naxan ba Nabi Natan to fa a fɛma a yalunyaan ligaxina e nun Batiseba.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Ala, diɲa n ma i ya hinanna nin.","poem":1},{"lineBreak":true},{"text":"N ma matandine mafelu","poem":1},{"lineBreak":true},{"text":"i ya kininkinin gbeeni!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N hakɛne birin ba n ma.","poem":1},{"lineBreak":true},{"text":"I yi n yulubine xafari.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na n ma matandine kolon.","poem":1},{"lineBreak":true},{"text":"N na n mirima n yulubine ma waxatin birin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na i tan nan keden yulubi tongoxi.","poem":1},{"lineBreak":true},{"text":"N naxan nabaxi,","poem":1},{"lineBreak":true},{"text":"na ɲaxu i yɛɛ ra yi.","poem":1},{"lineBreak":true},{"text":"Nanara, i na falan ti,","poem":1},{"lineBreak":true},{"text":"i tan nan tinxin,","poem":1},{"lineBreak":true},{"text":"i na kitin sa, i yoon sɔtɔ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N barixi hakɛn nin yati!","poem":1},{"lineBreak":true},{"text":"Yulubi kanna nan yi n na","poem":1},{"lineBreak":true},{"text":"xabu nga fudikan na a ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I waxi ɲɔndin nan xɔn ma n sɔndɔmɛni yati!","poem":1},{"lineBreak":true},{"text":"I n xaranma fekolonna ma n bɔɲɛni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"N yulubin ba n ma","poem":1},{"lineBreak":true},{"text":"nanara n sariɲanɲɛ.","poem":1},{"lineBreak":true},{"text":"I xa n maxa nanara n fixɛ","poem":1},{"lineBreak":true},{"text":"dangu balabalan kɛsɛn na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N mɔn xa sɛwa n ɲaxan.","poem":1},{"lineBreak":true},{"text":"I bɔɲɛn naxan kalaxi,","poem":1},{"lineBreak":true},{"text":"na mɔn xa sɛwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I yɛɛn ba n yulubine ra,","poem":1},{"lineBreak":true},{"text":"i yi n mafelu n hakɛne birin na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala, bɔɲɛ sariɲanxin sa n yi.","poem":1},{"lineBreak":true},{"text":"I mɔn yi n xaxili ragidi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I nama n kedi i yɛtagi.","poem":1},{"lineBreak":true},{"text":"I nama i ya Nii Sariɲanxin ba n yi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I mɔn xa kisin sɛwan fi n ma.","poem":1},{"lineBreak":true},{"text":"Xaxili faɲin xa n mali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Nanara, n matandi tiine xaranɲɛ","poem":1},{"lineBreak":true},{"text":"i ya kirane ma,","poem":1},{"lineBreak":true},{"text":"yulubi kanne yi xɛtɛ i ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N nakisimana, Ala,","poem":1},{"lineBreak":true},{"text":"n nakisi n ma faxa tixin ma.","poem":1},{"lineBreak":true},{"text":"Ala, yandi n xunba,","poem":1},{"lineBreak":true},{"text":"alogo n xa i ya tinxinyaan nali bɛtini.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Marigina, na liga n xa,","poem":1},{"lineBreak":true},{"text":"n xa i tantun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Saraxan mi rafan i ma,","poem":1},{"lineBreak":true},{"text":"xa na mi a ra,","poem":1},{"lineBreak":true},{"text":"n yi a bama i xa nɛn nun.","poem":1},{"lineBreak":true},{"text":"Saraxa gan daxin mi i kɛnɛnɲɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yɛtɛ magodon nan Ala rafan saraxan na.","poem":1},{"lineBreak":true},{"text":"Ala, i mi na kanna rabeɲinɲɛ","poem":1},{"lineBreak":true},{"text":"naxan nimisaxi a bɔɲɛni a tubi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tin, i Siyon nasabati.","poem":1},{"lineBreak":true},{"text":"I mɔn xa Yerusalɛn yinna ti.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Na waxatini,","poem":1},{"lineBreak":true},{"text":"tinxin saraxane rafanma i ma nɛn.","poem":1},{"lineBreak":true},{"text":"Saraxa gan daxine yi i kɛnɛn.","poem":1},{"lineBreak":true},{"text":"Na waxatini,","poem":1},{"lineBreak":true},{"text":"nxu yi turane rali i xa i ya saraxa ganden fari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":21}