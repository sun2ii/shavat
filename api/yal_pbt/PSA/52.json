{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":52,"content":[{"type":"heading","content":["Ala xa wuleden makiti"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa fala ɲaxumɛna, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"A naxan ba, Dowegi Edɔn kaan to siga Sɔli fɛma, a naxa, “Dawuda bata siga Aximeleki a banxini.”","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Ee! Muxu gbeena!","poem":1},{"lineBreak":true},{"text":"Nanfera i kanbama i ya fe ɲaxine yi?","poem":1},{"lineBreak":true},{"text":"Alaa hinanna luma nɛn habadan!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I feene yitɔnma bonne kala xinla ma.","poem":1},{"lineBreak":true},{"text":"I lɛnna luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo filɛ xɛnxɛna.","poem":1},{"lineBreak":true},{"text":"Ee! Yanfantenna!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe ɲaxin nafan i ma dangu fe faɲin na.","poem":1},{"lineBreak":true},{"text":"Wulen nafan i ma dangu ɲɔndin na.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":6,"content":[{"text":"Ee! Wuledena!","poem":1},{"lineBreak":true},{"text":"Fala xɔlɛne rafan i ma!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nanara, Ala i raxɔrima nɛn habadan!","poem":1},{"lineBreak":true},{"text":"A i suxuma nɛn,","poem":1},{"lineBreak":true},{"text":"a i ba i konni.","poem":1},{"lineBreak":true},{"text":"A i bama nɛn kɛndɛ muxune yɛ dunuɲa yi.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":8,"content":[{"text":"Tinxin muxune ito toma nɛn,","poem":1},{"lineBreak":true},{"text":"e gaxu.","poem":1},{"lineBreak":true},{"text":"Nayi, e gelema i ma nɛn,","poem":1},{"lineBreak":true},{"text":"e naxa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Na xɛmɛn mato,","poem":1},{"lineBreak":true},{"text":"naxan mi Ala findi a kantanmaan na.","poem":1},{"lineBreak":true},{"text":"Koni a yigin saxi a nafulu gbeen nin.","poem":1},{"lineBreak":true},{"text":"A fangan sɔtɔxi a boden kalan nan xɔn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Koni, n tan luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo Oliwi wudin naxan sabatima Alaa banxini.","poem":1},{"lineBreak":true},{"text":"N yigin saxi a hinanna nin","poem":1},{"lineBreak":true},{"text":"habadan han habadan!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ni i tan Ala tantunma nɛn","poem":1},{"lineBreak":true},{"text":"i ya wanla a fe ra habadan!","poem":1},{"lineBreak":true},{"text":"N ni i xinla binyama nɛn","poem":1},{"lineBreak":true},{"text":"i ya tɔgɔndiya muxune yɛ,","poem":1},{"lineBreak":true},{"text":"bayo i tan fan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}