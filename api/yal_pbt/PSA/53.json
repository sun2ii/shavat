{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":53,"content":[{"type":"heading","content":["Muxuna ɲaxuyana"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa fala ɲaxumɛna, bɛti baane kuntigin xa. A xa ba xulenna ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Xaxilitarena a falama a bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"a naxa, “Ala mi na.”","poem":1},{"lineBreak":true},{"text":"E birin yifu,","poem":1},{"lineBreak":true},{"text":"e haramu feene ligama.","poem":1},{"lineBreak":true},{"text":"Muxu yo mi a faɲin nabama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ala a yɛɛn nagodoma adamadiine ma","poem":1},{"lineBreak":true},{"text":"keli ariyanna yi,","poem":1},{"lineBreak":true},{"text":"a xa a to xa nde na","poem":1},{"lineBreak":true},{"text":"naxan xaxili sɔtɛ, a Ala fen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koni birin bata kiraan fata,","poem":1},{"lineBreak":true},{"text":"e ɲaxu ayi.","poem":1},{"lineBreak":true},{"text":"Hali keden pe mi a faɲin ligama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe ɲaxi rabane mi fe kolon ba?","poem":1},{"lineBreak":true},{"text":"E n ma yamaan tɔnɔn donma","poem":1},{"lineBreak":true},{"text":"alo donsena,","poem":1},{"lineBreak":true},{"text":"koni e mi Ala xandima mumɛ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Awa nayi, gaxun ne suxuma nɛn","poem":1},{"lineBreak":true},{"text":"e tan naxanye mi yi gaxuma.","poem":1},{"lineBreak":true},{"text":"Ala e kalama nɛn,","poem":1},{"lineBreak":true},{"text":"a e rayarabi","poem":1},{"lineBreak":true},{"text":"bayo e raɲaxu a ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nde kelɛ Siyon yi a Isirayila rakisi?","poem":1},{"lineBreak":true},{"text":"Ala mɔn na a yamaan sɛnbɛ so,","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔnna sɛwama nɛn,","poem":1},{"lineBreak":true},{"text":"Isirayila yi ɲaxan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}