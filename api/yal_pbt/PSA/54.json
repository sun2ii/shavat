{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"heading","content":["Ala maxandin maratanga feen na"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa fala ɲaxumɛna, bɛti baane kuntigin xa. A xa ba kondenne ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dawuda bɛti naxan ba, Sifi kaane to siga Sɔli fɛma e naxa, “Dawuda luxunxi nxu tagi.”","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Ala, n nakisi i sɛnbɛn na.","poem":1},{"lineBreak":true},{"text":"N xun mafala kitin bolon!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala, n ma maxandi xuiin namɛ.","poem":1},{"lineBreak":true},{"text":"I tuli mati n fala xuine ra!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xɔɲɛne bata keli n xili ma.","poem":1},{"lineBreak":true},{"text":"Gbalotɔne katama n faxa feen na.","poem":1},{"lineBreak":true},{"text":"E mi e mirima Ala ma.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Koni Ala nan n mali muxun na.","poem":1},{"lineBreak":true},{"text":"Marigin nan n niin kantanma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A n yaxune fe ɲaxine raxɛtɛ e ma.","poem":1},{"lineBreak":true},{"text":"E halagi amasɔtɔ i lannayaan nabama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nayi, n ɲɛnige ma saraxan bama i xa nɛn,","poem":1},{"lineBreak":true},{"text":"n yi i tan Alatala tantun amasɔtɔ i fan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bayo, i tan nan n baxi n ma tɔrɔne yi,","poem":1},{"lineBreak":true},{"text":"n yi n yaxune biraxin to.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}