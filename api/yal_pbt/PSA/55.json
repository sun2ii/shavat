{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":55,"content":[{"type":"heading","content":["Muxu yanfaxina Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa fala ɲaxumɛna, bɛti baane kuntigin xa. A xa ba kondenne ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, n ma maxandi xuiin namɛ.","poem":1},{"lineBreak":true},{"text":"I nama i xun xanbi so n ma mawugani!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I tuli mati n na,","poem":1},{"lineBreak":true},{"text":"i yi n yabi.","poem":1},{"lineBreak":true},{"text":"Xaminna bata n suxu","poem":1},{"lineBreak":true},{"text":"han n kuisan","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n yaxune fala xuine fe ra.","poem":1},{"lineBreak":true},{"text":"Muxu ɲaxine n yigbɛtɛnma,","poem":1},{"lineBreak":true},{"text":"e n tɔrɔma.","poem":1},{"lineBreak":true},{"text":"E bata xɔlɔ n ma,","poem":1},{"lineBreak":true},{"text":"e yi n naɲaxu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N bata kɔntɔfili.","poem":1},{"lineBreak":true},{"text":"Sayaan gbalon bata n xun matugan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gaxun nun xuruxurunna bata n suxu.","poem":1},{"lineBreak":true},{"text":"Gbalon yi n nabilin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xa gabutɛɛn yi n ma nun","poem":1},{"lineBreak":true},{"text":"alo ganbana,","poem":1},{"lineBreak":true},{"text":"n yi tuganma nɛn nun","poem":1},{"lineBreak":true},{"text":"n sa dɔxɔden fen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N yi n gima nɛn,","poem":1},{"lineBreak":true},{"text":"n siga yire makuyeni.","poem":1},{"lineBreak":true},{"text":"N yi lu burunna ra.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":9,"content":[{"text":"N yi maratangaden fenma nɛn mafurɛn","poem":1},{"lineBreak":true},{"text":"n keli foye gbeen nun gbalon bun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muxu ɲaxine raxuya ayi, Marigina,","poem":1},{"lineBreak":true},{"text":"e fala xuine yifu!","poem":1},{"lineBreak":true},{"text":"Bayo, n gbalon nun yɛngɛn toma taani han!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɔɛɛn nun yanyin na,","poem":1},{"lineBreak":true},{"text":"e taan nabilinma,","poem":1},{"lineBreak":true},{"text":"hakɛn nun yɛngɛne nan taani.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kala tiin gboma ayi taani.","poem":1},{"lineBreak":true},{"text":"Bɛsɛnxɔnyaan nun mayifuun nan taani.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xa yaxun nan tun yi n makonbima nun,","poem":1},{"lineBreak":true},{"text":"n yi diɲama a bun ma nɛn.","poem":1},{"lineBreak":true},{"text":"Xa n naɲaxu muxun nan tun yi a yɛtɛ yigboma n yɛ nun,","poem":1},{"lineBreak":true},{"text":"n yi n luxunma a ma nɛn nun.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Koni i tan na a ra, n lanfana,","poem":1},{"lineBreak":true},{"text":"n bodena, n xɔyi kɛndɛna!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"En ma lanfamayaan yi ɲaxun Alaa banxini","poem":1},{"lineBreak":true},{"text":"en yi sigan tima yamaan yɛ waxatin naxan yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sayaan xa n yaxune ratɛrɛna,","poem":1},{"lineBreak":true},{"text":"e kɛndɛn yi siga laxira yi.","poem":1},{"lineBreak":true},{"text":"Bayo fe ɲaxina e yi e konni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Koni n bata Ala xili,","poem":1},{"lineBreak":true},{"text":"Alatala n nakisima nɛn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N ma mawugan nun kutun xuina a lima nɛn.","poem":1},{"lineBreak":true},{"text":"Xɔtɔnna nun yanyin nun ɲinbanna ra,","poem":1},{"lineBreak":true},{"text":"a n xuiin mɛma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A n niin natangama,","poem":1},{"lineBreak":true},{"text":"n yi keli yɛngɛni hɛrini","poem":1},{"lineBreak":true},{"text":"hali n yaxune to yi wuya!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Habadan mangana Ala a tuli matima nɛn,","poem":1},{"lineBreak":true},{"text":"a yi n yaxune rabira.","poem":1},"Bɛti xuini te.",{"text":"Amasɔtɔ e bata tondi tubɛ.","poem":1},{"lineBreak":true},{"text":"E mɔn mi gaxuxi Ala yɛɛ ra.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N lanfana a xɔyine yɛngɛma.","poem":1},{"lineBreak":true},{"text":"A a layiri xidixine kalama.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A fala xuiin ɲaxun fɛnɛn xa","poem":1},{"lineBreak":true},{"text":"koni maraɲaxuna a bɔɲɛni.","poem":1},{"lineBreak":true},{"text":"A fala xuine salaxun alo turena.","poem":1},{"lineBreak":true},{"text":"Koni e sɛgɛn tima","poem":1},{"lineBreak":true},{"text":"alo silanfan xɛnxɛna.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"I ya kɔntɔfinle lu Alatala ma.","poem":1},{"lineBreak":true},{"text":"A i malima nɛn.","poem":1},{"lineBreak":true},{"text":"A mi tinɲɛ tinxin muxun yi bira mumɛ!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Koni i tan, Ala,","poem":1},{"lineBreak":true},{"text":"i na muxu faxane nun wuledene faxama nɛn","poem":1},{"lineBreak":true},{"text":"benun e siin tagiin xa a li.","poem":1},{"lineBreak":true},{"text":"N tan mabinni,","poem":1},{"lineBreak":true},{"text":"n na n yigi sama i tan nin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":24}