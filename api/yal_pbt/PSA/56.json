{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":56,"content":[{"type":"heading","content":["Yigi sana Ala yi"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa maxandi ɲaxumɛna. Bɛti baane kuntigin xa: a xa ba alo bɛtin naxan xili, “Ganban Wudi Makuyeni” a naxan ba Filisitine to a suxu Gati taani.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, kininkinin n ma","poem":1},{"lineBreak":true},{"text":"amasɔtɔ e n yɛngɛma.","poem":1},{"lineBreak":true},{"text":"N yaxune n bɛsɛnxɔnyama fɛriɲɛn gbɛn!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fɛriɲɛn gbɛn n yaxune n yɛngɛma.","poem":1},{"lineBreak":true},{"text":"N yɛngɛfane bata wuya ayi,","poem":1},{"lineBreak":true},{"text":"e waso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N na gaxu waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n na n yigi sama i tan nan yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na Alaa fala kamalixine matɔxɔma,","poem":1},{"lineBreak":true},{"text":"n yi n yigi sa a yi,","poem":1},{"lineBreak":true},{"text":"nanara n mi gaxuɛ mumɛ!","poem":1},{"lineBreak":true},{"text":"Daɲɔxɔn dɔrɔnna nanse ligɛ n na?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fɛriɲɛn gbɛn n yaxune n tɔrɔma.","poem":1},{"lineBreak":true},{"text":"E n ɲaxankata feni tɔnma waxatin birin!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E e malanma luxundene yi,","poem":1},{"lineBreak":true},{"text":"e yɛɛne tixi n na, n nɛɛn dɛdɛ.","poem":1},{"lineBreak":true},{"text":"E yengi a ma e n faxɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I nama tin e rakisi feen ma e fe ɲaxine ma.","poem":1},{"lineBreak":true},{"text":"Ee! Ala! I xɔlɔxin xa na muxune rabira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N ma sunun yatɛ.","poem":1},{"lineBreak":true},{"text":"N yɛɛgena fe xa rabira i ma.","poem":1},{"lineBreak":true},{"text":"I xaxili mi dɔxi e xɔn ba?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N na i xili waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n yaxune xɛtɛma n fɔxɔ ra nɛn,","poem":1},{"lineBreak":true},{"text":"n yi a kolon a Ala n xɔn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N na Ala matɔxɔma a falane fe ra!","poem":1},{"lineBreak":true},{"text":"N na Alatala matɔxɔma!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N yigi saxi Ala nin,","poem":1},{"lineBreak":true},{"text":"n mi gaxuɛ mumɛ!","poem":1},{"lineBreak":true},{"text":"Adamadiin nanse ligama n na?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ala, n dɛ xuiin naxan tongoxi,","poem":1},{"lineBreak":true},{"text":"n na a rakamalima nɛn.","poem":1},{"lineBreak":true},{"text":"N na barika bira saraxan bama i xa nɛn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Amasɔtɔ i bata n ba sayani,","poem":1},{"lineBreak":true},{"text":"i yi n natanga biran ma.","poem":1},{"lineBreak":true},{"text":"Nanara, n sigan tima Ala yɛtagi","poem":1},{"lineBreak":true},{"text":"n ma siimayani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}