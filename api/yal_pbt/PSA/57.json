{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":57,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa maxandi ɲaxumɛna, bɛti baane kuntigin xa. A xa ba alo bɛtin naxan xili, “I Nama Halagin Ti” Dawuda naxan ba a to a gi Sɔli bun, a sa a so faran yinla ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Kininkinin n ma!","poem":1},{"lineBreak":true},{"text":"Ee! Ala! Kininkinin n ma!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ n niin marakisin fenma i tan nan yii.","poem":1},{"lineBreak":true},{"text":"N xa luxunden sɔtɔ i gabutɛɛn bun,","poem":1},{"lineBreak":true},{"text":"han yihadin yi dangu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N bata Kore Xɔnna Ala maxandi","poem":1},{"lineBreak":true},{"text":"naxan n ma feene rasɔnɔyama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A n yabima nɛn keli ariyanna yi,","poem":1},{"lineBreak":true},{"text":"a n nakisi.","poem":1},{"lineBreak":true},{"text":"A ne mafalama nɛn","poem":1},{"lineBreak":true},{"text":"naxanye n yɛngɛma.","poem":1},"Bɛti xuini te.",{"text":"Alaa hinanna nun a lannayaan yitama n na nɛn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yatane bata n nabilin,","poem":1},{"lineBreak":true},{"text":"n saxi adamadi ɲaxine tagi.","poem":1},{"lineBreak":true},{"text":"E ɲinne ligaxi nɛn","poem":1},{"lineBreak":true},{"text":"alo tanbane nun xalimakunle.","poem":1},{"lineBreak":true},{"text":"E lɛnne ligaxi nɛn","poem":1},{"lineBreak":true},{"text":"alo silanfan xɛnxɛne.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala, i ya binyen xa mayita kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"a yi bɔxɔn nafe!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E bata yalaan nati n yɛɛ ra n suxu xinla ma,","poem":1},{"lineBreak":true},{"text":"e yi n nayagi.","poem":1},{"lineBreak":true},{"text":"E bata yinla ge n yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"koni e tan yɛtɛɛn bata bira a kui.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":8,"content":[{"text":"Ala, n xaxili ragidixi yati!","poem":1},{"lineBreak":true},{"text":"N bɛtin bama nɛn, n yi i tantun!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N xulunma nɛn sinma,","poem":1},{"lineBreak":true},{"text":"n yi n ma bɔlɔnna nun kondenna maxa!","poem":1},{"lineBreak":true},{"text":"N kurunma bɛtin bɛ nɛn subaxa!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Marigina, n ni i tantunma nɛn siyane yɛ.","poem":1},{"lineBreak":true},{"text":"N bɛtin bama i xa nɛn bɔnsɔnne tagi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I ya hinanna gbo han ariyanna.","poem":1},{"lineBreak":true},{"text":"I ya lannayaan texi han kore xɔnna.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala i ya binyen xa mayita kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"a yi bɔxɔn nafe!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}