{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":58,"content":[{"type":"heading","content":["Ala nan kitisa tinxinxin na"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa maxandi ɲaxumɛna, bɛti baane kuntigin xa. A xa ba alo bɛtin naxan xili: “I Nama Halagin Ti.”","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ɛ tan muxu gbeene,","poem":1},{"lineBreak":true},{"text":"ɛ falane mi tinxin feu!","poem":1},{"lineBreak":true},{"text":"Ɛ nɔɛ adamadiine makitɛ tinxinni ba?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛn-ɛn de! Tinxintareyana ɛ bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"ɛ gbalon nakelima bɔxɔn ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xabu e bari waxatini, e ɲaxu.","poem":1},{"lineBreak":true},{"text":"Wuledene lɔxi ayi xabu e bari lɔxɔni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E xɔlɛn luxi nɛn alo saɲin xɔlɛna,","poem":1},{"lineBreak":true},{"text":"alo fɔdɔgɔɔn naxan mi saɲi suxun xuiin mɛma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"naxan mi a kanna xuiin namɛma.","poem":1},{"lineBreak":true},{"text":"Saɲi suxun na fatan kiki,","poem":1},{"lineBreak":true},{"text":"a mi nɔɛ a suxɛ.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ala, i xa e ɲinne magira e dɛ!","poem":1},{"lineBreak":true},{"text":"Alatala, i xa na yatane dɛɛn kala!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E xa ɲan alo igen naxan bɔxɔnma.","poem":1},{"lineBreak":true},{"text":"E tanbane xa yelefu ayi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E xa liga","poem":1},{"lineBreak":true},{"text":"alo korosiraan naxan fati tununma ayi lingini,","poem":1},{"lineBreak":true},{"text":"alo diin naxan faxaxi barixi, a mi sogen to.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tansin xindena hanma a xarena,","poem":1},{"lineBreak":true},{"text":"ne ganma nɛn tunden bun.","poem":1},{"lineBreak":true},{"text":"Foyen ɲaxudene fan xalima nɛn,","poem":1},{"lineBreak":true},{"text":"a e raxɔri.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tinxin muxune ɲaxanma nɛn","poem":1},{"lineBreak":true},{"text":"bayo a gbeen ɲɔxɔma nɛn.","poem":1},{"lineBreak":true},{"text":"E fama e sanna maxadeni nɛn","poem":1},{"lineBreak":true},{"text":"muxu ɲaxine wunla ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nayi, adamadiine yi a fala,","poem":1},{"lineBreak":true},{"text":"“Ala tinxin muxune saren fima yati!","poem":1},{"lineBreak":true},{"text":"Ala na yatigi, naxan dunuɲa makitima!”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}