{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":59,"content":[{"type":"heading","content":["Ala maxandina marakisina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa maxandi ɲaxumɛna, bɛti baane kuntigin xa. A xa ba alo bɛtin naxan xili: “I Nama Halagin Ti,” a naxan ba Sɔli to sofane xɛ e xa sa e luxun Dawuda yɛɛ ra a banxini a faxa xinla ma.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N ma Ala, n xunba n yaxune yii.","poem":1},{"lineBreak":true},{"text":"N natanga ne ma","poem":1},{"lineBreak":true},{"text":"naxanye kelixi n xili ma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N xunba fe ɲaxi rabane yii.","poem":1},{"lineBreak":true},{"text":"N nakisi na muxu faxane ma!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mato,","poem":1},{"lineBreak":true},{"text":"e n legedenma n faxa feen na.","poem":1},{"lineBreak":true},{"text":"Sɛnbɛmane e malanma n xili ma.","poem":1},{"lineBreak":true},{"text":"N mi i matandixi,","poem":1},{"lineBreak":true},{"text":"n mi yulubi ligaxi, Alatala.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N sɔnna mi a ra,","poem":1},{"lineBreak":true},{"text":"koni e yitɔnxi e xa n yɛngɛ.","poem":1},{"lineBreak":true},{"text":"Keli, i fa n mali!","poem":1},{"lineBreak":true},{"text":"Yandi n mato!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala, Ala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"Isirayilaa Ala, keli!","poem":1},{"lineBreak":true},{"text":"I yi siya dɛnkɛlɛyatarene fe ɲaxine saran e ra.","poem":1},{"lineBreak":true},{"text":"I nama diɲa yanfanten ɲaxine ma mumɛ!","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E fama ɲinbanna ra.","poem":1},{"lineBreak":true},{"text":"E xaɲɛ alo barene taan xun xɔn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I tuli mati e konbi ti xuine ra.","poem":1},{"lineBreak":true},{"text":"E lɛnne luxi nɛn e dɛ","poem":1},{"lineBreak":true},{"text":"alo silanfanne,","poem":1},{"lineBreak":true},{"text":"e mɔn a falama, e naxa,","poem":1},{"lineBreak":true},{"text":"“Nde nɔɛ en ma falan mɛ?”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Koni Alatala, i gelema e ma.","poem":1},{"lineBreak":true},{"text":"I siya dɛnkɛlɛyatarene birin magelema.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala n sɛnbɛna,","poem":1},{"lineBreak":true},{"text":"n xaxili tixi i tan nan na.","poem":1},{"lineBreak":true},{"text":"I tan nan n ma faran makantanxin na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N ma hinantenna Ala,","poem":1},{"lineBreak":true},{"text":"a tima n yɛɛ ra nɛn.","poem":1},{"lineBreak":true},{"text":"A a liga,","poem":1},{"lineBreak":true},{"text":"n na n yɛɛn nagodo n yaxune ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Koni, i nama e faxa,","poem":1},{"lineBreak":true},{"text":"Marigina, nxu yɛ masansan wure lefana.","poem":1},{"lineBreak":true},{"text":"Nanara, n ma muxune mi ɲinanɲɛ.","poem":1},{"lineBreak":true},{"text":"E raxuya ayi i sɛnbɛni,","poem":1},{"lineBreak":true},{"text":"i yi e nɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bayo yulubi falane e dɛ","poem":1},{"lineBreak":true},{"text":"e xa suxu e yɛtɛna wasona fe ra!","poem":1},{"lineBreak":true},{"text":"Bayo e dangane tima","poem":1},{"lineBreak":true},{"text":"e wulene falama,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"e ɲan i ya xɔlɔni!","poem":1},{"lineBreak":true},{"text":"E ɲan fefe! Sese nama lu!","poem":1},{"lineBreak":true},{"text":"Nayi, birin a kolonma nɛn fa fala","poem":1},{"lineBreak":true},{"text":"Ala mangayaan nabama Yaxuba bɔnsɔnna xun na","poem":1},{"lineBreak":true},{"text":"han bɔxɔn danna birin.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"E fama ɲinbanna ra.","poem":1},{"lineBreak":true},{"text":"E xaɲɛ alo barene taan xun xɔn.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Barene nɛma donse fenni,","poem":1},{"lineBreak":true},{"text":"xa e mi lugo,","poem":1},{"lineBreak":true},{"text":"e wurundunma nɛn.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Koni n tan i sɛnbɛn matɔxɔma nɛn bɛtini.","poem":1},{"lineBreak":true},{"text":"Xɔtɔnni, n na n ma bɛti xuini tema nɛn","poem":1},{"lineBreak":true},{"text":"i ya hinanna fe ra.","poem":1},{"lineBreak":true},{"text":"Bayo, n ma faran makantanxin nan i tan na,","poem":1},{"lineBreak":true},{"text":"n na n yigiyama dɛnaxan yi tɔrɔ waxatine yi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N sɛnbɛna,","poem":1},{"lineBreak":true},{"text":"n bɛtin bama i xa nɛn.","poem":1},{"lineBreak":true},{"text":"I tan Ala nan n ma faran makantanxin na","poem":1},{"lineBreak":true},{"text":"n ma hinantenna Ala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":18}