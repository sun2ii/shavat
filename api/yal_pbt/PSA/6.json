{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":6,"content":[{"type":"heading","content":["Ala maxandin tɔrɔ waxatini"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba maxase luti kanne ra e nun kondenna luti solomasɛxɛ kanna ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i nama n maxadi xɔlɔni!","poem":1},{"lineBreak":true},{"text":"I nama fitina n xili ma,","poem":1},{"lineBreak":true},{"text":"i n ɲaxankata!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala, kininkinin n ma,","poem":1},{"lineBreak":true},{"text":"n bata xadan!","poem":1},{"lineBreak":true},{"text":"Alatala, n nakɛndɛya,","poem":1},{"lineBreak":true},{"text":"bayo fanga mi fa n na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N niin tɔrɔxi han!","poem":1},{"lineBreak":true},{"text":"Alatala, han waxatin mundun yi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala, fa n kantan.","poem":1},{"lineBreak":true},{"text":"N niin nakisi i ya hinanni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muxe mi e mirɛ i tan ma sayani.","poem":1},{"lineBreak":true},{"text":"Nde nɔɛ i tantunɲɛ laxira yi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bata xadan kutundeni,","poem":1},{"lineBreak":true},{"text":"n ma sadeni kunxi yɛɛgen na kɔɛ yo kɔɛ,","poem":1},{"lineBreak":true},{"text":"n wugama han n ma xunbunsaan yi yikun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sunun bata n yɛɛni fɔrɔ.","poem":1},{"lineBreak":true},{"text":"Wugan bata n yɛɛne buturun n yaxune fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛ makuya n na,","poem":1},{"lineBreak":true},{"text":"ɛ tan fe ɲaxi rabane!","poem":1},{"lineBreak":true},{"text":"Bayo Alatala n wuga xuiin mɛma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala bata n ma mayandi xuiin mɛ,","poem":1},{"lineBreak":true},{"text":"Alatala mɔn bata n ma maxandin suxu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N yaxune birin yagima nɛn,","poem":1},{"lineBreak":true},{"text":"e yarabi.","poem":1},{"lineBreak":true},{"text":"E kuisanxin xɛtɛma nɛn mafurɛn!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}