{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":60,"content":[{"type":"heading","content":["Ala maxandina nɔ ti fena"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa maxandi ɲaxumɛna, bɛti baane kuntigin xa, a xa ba alo bɛtin naxan xili: “Gabalan Fugaxina Sereyana.” A xa ba xaran feen na.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dawuda bɛtini ito nan ba a to Arami kaane yɛngɛ naxanye keli Mesopotamiya yamanan nun Soba yamanani, Yowaba yi xɛtɛ, a Edɔn kaa wuli fu nun firin faxa Fɔxɔ Lanbanni.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Ala, i bata i mɛ nxu ra,","poem":1},{"lineBreak":true},{"text":"i yi gbalon nakeli nxu ma.","poem":1},{"lineBreak":true},{"text":"I bata xɔlɔ nxu ma.","poem":1},{"lineBreak":true},{"text":"Koni iki, i mɔn xa nxu yitɔn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I bata bɔxɔn naxuruxurun,","poem":1},{"lineBreak":true},{"text":"a yibɔ.","poem":1},{"lineBreak":true},{"text":"I mɔn xa a tugun a bode ra,","poem":1},{"lineBreak":true},{"text":"a nama xuya ayi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I bata waxatine raxɔdɔxɔ i ya muxune ma.","poem":1},{"lineBreak":true},{"text":"Nxu dagalanma ayi","poem":1},{"lineBreak":true},{"text":"alo nxu minxin na a ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Koni naxanye gaxuxi i yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"i bata taxamasenni te ne xa,","poem":1},{"lineBreak":true},{"text":"naxan e ratangama xalimakunle ma.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I xa i xanuntenne kantan","poem":1},{"lineBreak":true},{"text":"i yi e rakisi i sɛnbɛni.","poem":1},{"lineBreak":true},{"text":"I yi nxɔ maxandin yabi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala bata falan ti a yire sariɲanxini,","poem":1},{"lineBreak":true},{"text":"a naxa, “N nɔɔn tima nɛn,","poem":1},{"lineBreak":true},{"text":"n Siken taani taxun,","poem":1},{"lineBreak":true},{"text":"n yi Sukɔti lanbanna danne sa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N tan nan gbee Galadi bɔxɔn nun Manase ra.","poem":1},{"lineBreak":true},{"text":"Efirami kaane findixi n ma yɛngɛsone nan na.","poem":1},{"lineBreak":true},{"text":"Yuda luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo n ma mangaya dunganna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Koni n ma konyin nan Moyaba yamanan na.","poem":1},{"lineBreak":true},{"text":"N tan nan Edɔn yamanan kanna ra.","poem":1},{"lineBreak":true},{"text":"N yɛngɛ sɔnxɔni tema Filisiti yamanani.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala, nde sigama n na na taa makantanxini?","poem":1},{"lineBreak":true},{"text":"Nde tima n yɛɛ ra siga Edɔn yi?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala, i tan xa mi i mɛxi nxu ra ba?","poem":1},{"lineBreak":true},{"text":"I mi fa nxɔ ganla fɔxɔ ra sɔnɔn ba?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nxu mali yaxune yɛngɛdeni!","poem":1},{"lineBreak":true},{"text":"Sese mi adamana maliin na.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Koni Ala na lu en xɔn,","poem":1},{"lineBreak":true},{"text":"en nɔɔn sɔtɔma nɛn.","poem":1},{"lineBreak":true},{"text":"A tan nan en yaxune halagima.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":14}