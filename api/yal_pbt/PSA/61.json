{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"heading","content":["Ala, n xa lu i fɛma"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba kondenne ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala n ma mawuga xuiin mɛ.","poem":1},{"lineBreak":true},{"text":"I tuli mati n ma maxandi xuiin na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yigitɛgɛxin bata n xui ramini i ma wulani.","poem":1},{"lineBreak":true},{"text":"N xali na geyaan fari","poem":1},{"lineBreak":true},{"text":"naxan mate n xa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Amasɔtɔ i tan nan n yigiyaden na,","poem":1},{"lineBreak":true},{"text":"e nun yinna","poem":1},{"lineBreak":true},{"text":"naxan n natangama n yaxune ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N waxi lu feni i konni waxatin birin yi.","poem":1},{"lineBreak":true},{"text":"N xa luxunden sɔtɔ i gabutɛne bun ma.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":6,"content":[{"text":"Ala, i bata n dɛ ti xuine mɛ.","poem":1},{"lineBreak":true},{"text":"I bata na kɛɛn so n yii","poem":1},{"lineBreak":true},{"text":"i naxan namaraxi i ya yɛɛragaxu muxune xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ala xa mangan siin xun masa,","poem":1},{"lineBreak":true},{"text":"a xa bu han!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala xa mangan sabati a yɛtagi habadan!","poem":1},{"lineBreak":true},{"text":"A ratanga i ya hinanna nun i ya lannayaan nin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nanara, n tantun bɛtin bɛ i xinli waxatin birin,","poem":1},{"lineBreak":true},{"text":"n yi n dɛ ti xuine rakamali lɔxɔ yo lɔxɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}