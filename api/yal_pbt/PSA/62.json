{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":62,"content":[{"type":"heading","content":["Ala nan bɔɲɛ xunbenla fima"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa Yedutun xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N bɔɲɛn saxi Ala nan baraka yi,","poem":1},{"lineBreak":true},{"text":"a tan nan n nakisima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A tan kedenna nan n kantan fanyen na,","poem":1},{"lineBreak":true},{"text":"n nakisimana.","poem":1},{"lineBreak":true},{"text":"N ma faran makantanxin nan a ra.","poem":1},{"lineBreak":true},{"text":"Yaxune mi n nɔɛ mumɛ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Han waxatin mundun yi,","poem":1},{"lineBreak":true},{"text":"ɛ luyɛ fuyɛ muxune ma?","poem":1},{"lineBreak":true},{"text":"Ɛ tan e rabirama","poem":1},{"lineBreak":true},{"text":"alo banxi xɔnna hanma langa fonna?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E waxi muxune ragodo feni tun,","poem":1},{"lineBreak":true},{"text":"keli a binyeni.","poem":1},{"lineBreak":true},{"text":"E e yoron wuleni.","poem":1},{"lineBreak":true},{"text":"E duban tima e dɛni,","poem":1},{"lineBreak":true},{"text":"koni e dangan tima e bɔɲɛni.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N bɔɲɛ xunbenla sɔtɔma Ala nan xɔn.","poem":1},{"lineBreak":true},{"text":"A tan nan n yigin na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A tan nan n kantan fanyen na,","poem":1},{"lineBreak":true},{"text":"n nakisimana.","poem":1},{"lineBreak":true},{"text":"N ma faran makantanxin nan a ra.","poem":1},{"lineBreak":true},{"text":"Yaxune mi n nɔɛ mumɛ!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N ma kisin nun n ma binyena Ala nan yii.","poem":1},{"lineBreak":true},{"text":"N kantan fanyen sɛnbɛmaan nan Ala ra.","poem":1},{"lineBreak":true},{"text":"N ma yigiyana a tan nan na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yamana, ɛ ɛ yigin sa a yi waxatin birin!","poem":1},{"lineBreak":true},{"text":"Ɛ yi ɛ kɔntɔfinle so Ala yii,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ en yigiyaden nan Ala ra.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Adamadiine ligaxi nɛn alo foyedina.","poem":1},{"lineBreak":true},{"text":"A xungbeen nun a xurina, sese mi e ra.","poem":1},{"lineBreak":true},{"text":"Hali e rate sikeela fari, e yelefu.","poem":1},{"lineBreak":true},{"text":"E malanxin yelefu foyedin xa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I nama i yigin sa gbalo feene yi.","poem":1},{"lineBreak":true},{"text":"I nama i waso se muɲaxini.","poem":1},{"lineBreak":true},{"text":"Hali nafunla gbo i yii han,","poem":1},{"lineBreak":true},{"text":"i nama i yigin sa a yi!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala luma a falɛ,","poem":1},{"lineBreak":true},{"text":"fa fala a tan nan gbee fangan na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I gbeen nan hinanna ra, n Marigina.","poem":1},{"lineBreak":true},{"text":"Bayo i tan muxun kɔntɔnna fima nɛn","poem":1},{"lineBreak":true},{"text":"alo a kɛwanla.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}