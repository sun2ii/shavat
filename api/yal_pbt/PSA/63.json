{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":63,"content":[{"type":"heading","content":["Alaa hinanna fisa siimayaan xa"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, a yi Yuda tonbon yireni waxatin naxan yi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, n ni i fenma,","poem":1},{"lineBreak":true},{"text":"n ma Ala nan i tan na.","poem":1},{"lineBreak":true},{"text":"I xɔnla n sɔndɔmɛn na.","poem":1},{"lineBreak":true},{"text":"I xɔnla n fati bɛndɛn ma","poem":1},{"lineBreak":true},{"text":"alo min xɔnla n suxuma","poem":1},{"lineBreak":true},{"text":"tonbonni ito yi kii naxan yi,","poem":1},{"lineBreak":true},{"text":"bɔxɔ magenla, ige mi dɛnaxan yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N xa i to i ya yire sariɲanxini.","poem":1},{"lineBreak":true},{"text":"N yi i sɛnbɛn nun binyeni gbɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I ya hinanna fisa siimayaan xa.","poem":1},{"lineBreak":true},{"text":"Nanara, n na i batuma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N barikan birama i xa nɛn","poem":1},{"lineBreak":true},{"text":"n ma siimayaan birin yi,","poem":1},{"lineBreak":true},{"text":"n na n yiine yite i maxandideni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N nii yifanma n ma nɛn,","poem":1},{"lineBreak":true},{"text":"alo n na wasa donse hagigɛne ra.","poem":1},{"lineBreak":true},{"text":"N yi i tantun sɛwa bɛtine yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N nɛma saxi n ma saden ma,","poem":1},{"lineBreak":true},{"text":"n na n mirima i ma.","poem":1},{"lineBreak":true},{"text":"N xaxili luma i xɔn nɛn kɔɛɛn birin na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Amasɔtɔ i tan nan n mali muxun na,","poem":1},{"lineBreak":true},{"text":"n sɛwa bɛtin ba i nininna bun ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N bata kankan i ma,","poem":1},{"lineBreak":true},{"text":"i yiin nan n natangama.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naxanye katama n faxa feen na,","poem":1},{"lineBreak":true},{"text":"ne faxama nɛn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E faxama silanfanna ra nɛn yɛngɛni,","poem":1},{"lineBreak":true},{"text":"kankone yi e binbine don.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nayi, Mangan sɛwama nɛn Ala yi.","poem":1},{"lineBreak":true},{"text":"Naxanye e kɔlɔma Ala xinli,","poem":1},{"lineBreak":true},{"text":"ne a matɔxɔma nɛn.","poem":1},{"lineBreak":true},{"text":"Koni wuledene dɛɛne raxutuma nɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}