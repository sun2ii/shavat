{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":64,"content":[{"type":"heading","content":["Ala maxandin maratangana fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, i tuli mati n ma mawuga xuiin na!","poem":1},{"lineBreak":true},{"text":"N bata gaxu n yaxune yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"N niin natanga!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N luxun muxu ɲaxine ma","poem":1},{"lineBreak":true},{"text":"naxanye e bode toma wundoni,","poem":1},{"lineBreak":true},{"text":"e nun fe ɲaxi raba ganla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E lɛnne xanxan alo silanfanna.","poem":1},{"lineBreak":true},{"text":"Fala ɲaxine minima e dɛ","poem":1},{"lineBreak":true},{"text":"alo xalimakuli ralemunxina.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E e xanle tima sɔntaren na wundoni.","poem":1},{"lineBreak":true},{"text":"E mafura bunna tiyɛ, e mi gaxuma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E e bode rawɛkilɛma kɛwali ɲaxin ma.","poem":1},{"lineBreak":true},{"text":"E e bode toma,","poem":1},{"lineBreak":true},{"text":"e lutine ratima dɛnaxan yi.","poem":1},{"lineBreak":true},{"text":"E naxa, “Nde nɔɛ e toɛ?”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E tinxintareyani tɔnma, e naxa,","poem":1},{"lineBreak":true},{"text":"“En ma kɔtɛ yitɔnxin mi fulɛ mumɛ!”","poem":1},{"lineBreak":true},{"text":"Muxun kui feene kolon naxɔlɔ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Koni Alaa xalimakunle wolima e ma nɛn,","poem":1},{"lineBreak":true},{"text":"a e li keden na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E gbee fala xuine xɛtɛma e ma nɛn,","poem":1},{"lineBreak":true},{"text":"e yi halagi.","poem":1},{"lineBreak":true},{"text":"Naxan yo na e to,","poem":1},{"lineBreak":true},{"text":"ne e xunne yimaxama nɛn e mageledeni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nayi, gaxun adaman birin suxuma nɛn.","poem":1},{"lineBreak":true},{"text":"E e xaxili lu Ala a wanla xɔn,","poem":1},{"lineBreak":true},{"text":"e yi a fe rabaxine famu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tinxin muxune xa sɛwa Alatala yi,","poem":1},{"lineBreak":true},{"text":"e yi a findi e luxunden na.","poem":1},{"lineBreak":true},{"text":"Muxu sɔndɔmɛ faɲin birin xa a matɔxɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}