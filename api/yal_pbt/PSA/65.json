{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":65,"content":[{"type":"heading","content":["Tantunna nun barika birana"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. Sigi sariɲanxina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, a lan yamaan yi i tantun Siyon yi,","poem":1},{"lineBreak":true},{"text":"nxu mɔn yi nxu dɛ ti xuine rakamali.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I tan naxan maxandi xuine ramɛma,","poem":1},{"lineBreak":true},{"text":"muxun birin fama nɛn i fɛma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hakɛne to sɛnbɛn sɔtɔ nxu xun ma","poem":1},{"lineBreak":true},{"text":"i yi nxɔ matandine mafelu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sɛwan ne xa,","poem":1},{"lineBreak":true},{"text":"i bata naxanye sugandi","poem":1},{"lineBreak":true},{"text":"e xa lu i konni!","poem":1},{"lineBreak":true},{"text":"Nxu bata lugo i ya banxin fe faɲine ra,","poem":1},{"lineBreak":true},{"text":"i Batu Banxi Sariɲanxina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I nxɔ maxandin yabima","poem":1},{"lineBreak":true},{"text":"kabanakoon nan na tinxinni.","poem":1},{"lineBreak":true},{"text":"Ala nxu rakisimana,","poem":1},{"lineBreak":true},{"text":"bɔxɔn danna muxun birin yigina i tan nan na,","poem":1},{"lineBreak":true},{"text":"e nun naxanye fɔxɔ igen kidi ma pon!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I sɛnbɛn bata geyane da","poem":1},{"lineBreak":true},{"text":"bayo fangamaan ni i ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I bata baan xuini ti,","poem":1},{"lineBreak":true},{"text":"i yi a walanne raxara.","poem":1},{"lineBreak":true},{"text":"I mɔn yi siyane masabari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dunuɲa birin gaxuma i ya kabanakone yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"Keli sogetedeni han sogegododeni,","poem":1},{"lineBreak":true},{"text":"e birin bɛtin bama i xa sɛwani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I yengi dɔxi bɔxɔn xɔn","poem":1},{"lineBreak":true},{"text":"i yi tule igen sa a ma, han a ramɔ.","poem":1},{"lineBreak":true},{"text":"Alaa xuden nafexi igen na,","poem":1},{"lineBreak":true},{"text":"alogo donseen xa sɔtɔ.","poem":1},{"lineBreak":true},{"text":"I tan nan na ragidixi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I tule gbeen nafama xɛɛ bixine ma","poem":1},{"lineBreak":true},{"text":"bɔxɔn yi xunbeli, a yogon igen na.","poem":1},{"lineBreak":true},{"text":"I tan barakan sama xɛɛni, a sabati.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xɛɛ xaba waxatini,","poem":1},{"lineBreak":true},{"text":"i ya fanna warama ayi nɛn.","poem":1},{"lineBreak":true},{"text":"I na dangu dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"mɛnna yi sabati.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fixɛne fanma e nun fiile.","poem":1},{"lineBreak":true},{"text":"Geyane rayabuma nɛn han!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xuruseene yiriwama nɛn fixɛne ma.","poem":1},{"lineBreak":true},{"text":"Lanbanne yi rafe siseene ra.","poem":1},{"lineBreak":true},{"text":"Na birin yi findi bɛti ba xunna ra","poem":1},{"lineBreak":true},{"text":"e nun sɛwa sɔnxɔna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":14}