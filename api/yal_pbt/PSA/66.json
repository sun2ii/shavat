{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":66,"content":[{"type":"heading","content":["Barika birana Ala xa"]},{"type":"verse","number":1,"content":[{"text":"Sigi sariɲanxina. Tantun bɛtina. Bɛti baane kuntigin xa.","descriptive":true},{"text":"Dunuɲa muxun birin xa sɔnxɔ sɛwani Ala xa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɛ a xinla binya bɛtin ba!","poem":1},{"lineBreak":true},{"text":"Ɛ tantun gbeen fi a ma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ a fala Ala xa,","poem":1},{"lineBreak":true},{"text":"“I ya kabanako wanle magaxu!","poem":1},{"lineBreak":true},{"text":"I sɛnbɛn gbo han!","poem":1},{"lineBreak":true},{"text":"Nanara, i yaxune gaxuxin felenxi i bun ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Muxun birin i batuma dunuɲa yi,","poem":1},{"lineBreak":true},{"text":"e tantun bɛtin ba i xa.","poem":1},{"lineBreak":true},{"text":"E i xinla tantunma bɛtini.”","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɛ fa be!","poem":1},{"lineBreak":true},{"text":"Ɛ a mato Ala bata naxan liga!","poem":1},{"lineBreak":true},{"text":"A wanle magaxu adamadiine yɛ han!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A fɔxɔ igen findi nɛn yire yixaren na,","poem":1},{"lineBreak":true},{"text":"en benbane yi gidi baan tagi e sanni.","poem":1},{"lineBreak":true},{"text":"Nayi, en xa ɲaxan a tan yi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A mangayaan nabama a sɛnbɛni habadan!","poem":1},{"lineBreak":true},{"text":"A yɛɛn tixi siyane ra,","poem":1},{"lineBreak":true},{"text":"nanara muxu yo nama murutɛ.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Siyane, ɛ barikan bira en ma Ala xa!","poem":1},{"lineBreak":true},{"text":"Ɛ a tantun xuini te!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A bata siimayaan fi en ma,","poem":1},{"lineBreak":true},{"text":"a mi tin en yi bira.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala i nxu rasariɲanma","poem":1},{"lineBreak":true},{"text":"sulun tɛɛni alo wure gbetina.","poem":1},{"noteId":4}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I a liga nɛn nxu yi suxu,","poem":1},{"lineBreak":true},{"text":"i mɔn yi goron gbeen sa nxu xun ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I tin nɛn nxu yaxune yi ti nxu fari.","poem":1},{"lineBreak":true},{"text":"Nxu yi dangu ige tilinxin nun tɛɛni.","poem":1},{"lineBreak":true},{"text":"Koni, i fa nxu ra dahamu bɔxɔni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N fama saraxa gan daxin na nɛn i ya banxini.","poem":1},{"lineBreak":true},{"text":"N bata dɛ xuiin naxan tongo i xa,","poem":1},{"lineBreak":true},{"text":"n na rakamalima nɛn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dɛ ti xuini itoe falaxi nɛn","poem":1},{"lineBreak":true},{"text":"n yi tɔrɔni waxatin naxan yi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N sube turaxine bama saraxa gan daxin na nɛn,","poem":1},{"lineBreak":true},{"text":"n yi kontonne ba,","poem":1},{"lineBreak":true},{"text":"e tutin yi te kore.","poem":1},{"lineBreak":true},{"text":"N turane nun kɔtɔne fan bama nɛn.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɛ fa be! Ɛ ɛ tuli mati,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye birin gaxu Ala yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"A bata naxan liga n xa,","poem":1},{"lineBreak":true},{"text":"n na a falama ɛ xa nɛn.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N bata a xili malina fe ra,","poem":1},{"lineBreak":true},{"text":"n yi a batu n dɛ xuiin na.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa hakɛn yi ramaraxi n bɔɲɛni nun,","poem":1},{"lineBreak":true},{"text":"Marigin mi yi a tuli matima n xuiin na nun.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Koni Ala yatin bata n namɛ,","poem":1},{"lineBreak":true},{"text":"a a tuli mati n ma maxandi xuiin na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N barikan birama Ala xa","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a mi a mɛxi n ma maxandi xuiin na.","poem":1},{"lineBreak":true},{"text":"A mi a hinanna baxi n yii.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"66.10Sulun tɛɛnmɔn falama yirena nde yi fa fala “Furu tɛɛna.”","reference":{"chapter":66,"verse":10}}]},"thisChapterLink":"/api/yal_pbt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}