{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":67,"content":[{"type":"heading","content":["Siyane birin xa Ala tantun"]},{"type":"verse","number":1,"content":[{"text":"Tantun bɛtina, bɛti baane kuntigin xa. A xa ba kondenne ra. Sigi sariɲanxina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala xa kininkinin en ma,","poem":1},{"lineBreak":true},{"text":"Ala xa en baraka.","poem":1},{"lineBreak":true},{"text":"Ala nɔrɔn xa godo en ma.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":3,"content":[{"text":"Nanara, dunuɲa birin i ya kiraan kolonɲɛ,","poem":1},{"lineBreak":true},{"text":"siyane birin yi i ya marakisin kolon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siyane xa i tantun Ala,","poem":1},{"lineBreak":true},{"text":"siyane birin xa i tantun!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Muxune xa ɲaxan,","poem":1},{"lineBreak":true},{"text":"e bɛtin ba sɛwani,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i siyane makitima tinxinna nin.","poem":1},{"lineBreak":true},{"text":"I tixi dunuɲa muxune birin yɛɛ ra.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Siyane xa i tantun Ala,","poem":1},{"lineBreak":true},{"text":"siyane birin xa i tantun!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nayi, bɔxɔn donse gbegbe fima.","poem":1},{"lineBreak":true},{"text":"Ala, en ma Ala en barakama nɛn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala en barakama nɛn,","poem":1},{"lineBreak":true},{"text":"bɔxɔn danna muxun birin yi gaxu a yɛɛ ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}