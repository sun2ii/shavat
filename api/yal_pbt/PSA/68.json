{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":68,"content":[{"type":"heading","content":["Alaa nɔna Isirayila xa"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. Sigi sariɲanxina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala xa keli,","poem":1},{"lineBreak":true},{"text":"a yi a yaxune raxuya ayi.","poem":1},{"lineBreak":true},{"text":"Naxanye a raɲaxuxi,","poem":1},{"lineBreak":true},{"text":"ne yi e gi a bun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E kedi,","poem":1},{"lineBreak":true},{"text":"alo foyen sigama tutin na kii naxan yi.","poem":1},{"lineBreak":true},{"text":"E xa ɲan Ala yɛtagi","poem":1},{"lineBreak":true},{"text":"alo dolen na lo tɛɛni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koni tinxin muxune xa ɲaxan,","poem":1},{"lineBreak":true},{"text":"e sɛwa Ala yɛtagi.","poem":1},{"lineBreak":true},{"text":"E xa gele ɲaxanni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛtin ba Ala xa,","poem":1},{"lineBreak":true},{"text":"a xinla xa tantun bɛtini.","poem":1},{"lineBreak":true},{"text":"Naxan fama kundani,","poem":1},{"lineBreak":true},{"text":"ɛ na rasɛnɛ!","poem":1},{"lineBreak":true},{"text":"A xili nɛn Alatala.","poem":1},{"lineBreak":true},{"text":"En xa en sɛwa xuini te a yɛɛ ra!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala naxan a kon sariɲanxini,","poem":1},{"lineBreak":true},{"text":"kiridine fafe na a ra,","poem":1},{"lineBreak":true},{"text":"kaɲa gilɛne xun mayɛngɛn na a ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ala denbayaan fima denbayatarene ma,","poem":1},{"lineBreak":true},{"text":"A kasorasane xɔrɔyama,","poem":1},{"lineBreak":true},{"text":"e mini bɛtin bɛ.","poem":1},{"lineBreak":true},{"text":"Koni murutɛ muxune luma bɔxɔ yidunduxin nin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ala, i to ti i ya yamaan yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"i siga na tonbon yireni.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":9,"content":[{"text":"Bɔxɔn yi xuruxurun,","poem":1},{"lineBreak":true},{"text":"koren yi rabi Ala yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"Sinayi Geyana Ala,","poem":1},{"lineBreak":true},{"text":"Isirayilaa Ala.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala, i tule gbeen nafa nɛn,","poem":1},{"lineBreak":true},{"text":"i ya bɔxɔn mɔn yi xɛtɛ a kiini.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I ya yamaan yi dɔxɔ na,","poem":1},{"lineBreak":true},{"text":"I yi yiigelitɔne ki i ya nɛmana fe ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Marigin bata feni ito xibarun fi,","poem":1},{"lineBreak":true},{"text":"ɲaxalan gali gbeen yi siga a ralideni, e naxa,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"“Mangane nun sofane e gima!","poem":1},{"lineBreak":true},{"text":"E e gima!","poem":1},{"lineBreak":true},{"text":"Nxu tan ɲaxanle yi yɛngɛ yi se tongoxine yitaxun.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɛ tan naxanye fan luxi xuruseene dɛxɔn,","poem":1},{"lineBreak":true},{"text":"ɛ a mɛ,","poem":1},{"lineBreak":true},{"text":"Ala a yamaan suturama nɛn","poem":1},{"lineBreak":true},{"text":"alo ganba tofaɲina","poem":1},{"lineBreak":true},{"text":"naxan gabutɛye rafalaxi gbetin nun xɛma faɲin na.”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanna to na mangane raxuya ayi,","poem":1},{"lineBreak":true},{"text":"e yolon alo balabalan kɛsɛna Geya Fɔrɛn ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Basan yamanan geyane gbo!","poem":1},{"lineBreak":true},{"text":"Yire matexi wuyaxi e ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nanfera ɛ Alaa geya sugandixin matoma xɔxɔlɔnni,","poem":1},{"lineBreak":true},{"text":"Ala yɛtɛɛn dɔxi dɛnaxan yi?","poem":1},{"lineBreak":true},{"text":"Alatala luma dɛnaxan yi habadan!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Marigin bata fa a yire sariɲanxini","poem":1},{"lineBreak":true},{"text":"keli Sinayi Geyaan ma","poem":1},{"lineBreak":true},{"text":"e nun a yɛngɛ so wontoro wuli wuli wuyaxi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Marigina Alatala, i bata te kore,","poem":1},{"lineBreak":true},{"text":"muxu suxine biraxi i fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"I yi kiseene rasuxu adamadiine ra,","poem":1},{"lineBreak":true},{"text":"hali muxu murutɛxine,","poem":1},{"lineBreak":true},{"text":"i yi dɔxɔ na yi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Barikan xa bira Marigin xa lɔxɔ yo lɔxɔ,","poem":1},{"lineBreak":true},{"text":"en ma goronna saxi naxan xun ma,","poem":1},{"lineBreak":true},{"text":"Ala en nakisimana.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":21,"content":[{"text":"En ma Ala, Ala na a ra","poem":1},{"lineBreak":true},{"text":"naxan muxune rakisima.","poem":1},{"lineBreak":true},{"text":"En Marigina Alatala na a ra","poem":1},{"lineBreak":true},{"text":"naxan en bama sayani.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ala yatina a yaxune xunne yibɔma nɛn","poem":1},{"lineBreak":true},{"text":"naxanye kankanxi e sɔnne ma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Marigin bata a fala, a naxa,","poem":1},{"lineBreak":true},{"text":"“N fama nɛn ɛ yaxune ra keli Basan yi.","poem":1},{"lineBreak":true},{"text":"N fama e ra nɛn sa keli fɔxɔ igen xɔnna ma","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"alogo ɛ xa ɛ sanne sin e wunli","poem":1},{"lineBreak":true},{"text":"ɛ barene fan yi e wunla kɔn han e wasa.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ala, nxu bata i ya yamaan famatɔɔn to.","poem":1},{"lineBreak":true},{"text":"I ya yamaan soma yire sariɲanxini","poem":1},{"lineBreak":true},{"text":"i tan n ma Ala nun n ma mangana.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bɛti baane yɛɛn na,","poem":1},{"lineBreak":true},{"text":"maxa se maxane xanbin na,","poem":1},{"lineBreak":true},{"text":"sungutunne wɔsɔwɔsɔnne maxama ne tagi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Barikan bira Ala xa a malan gbeeni.","poem":1},{"lineBreak":true},{"text":"Isirayila bɔnsɔnna birin xa Alatala tantun.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bunyamin bɔnsɔnna,","poem":1},{"lineBreak":true},{"text":"dɔnxɛ ra barin tixi e yɛɛ ra.","poem":1},{"lineBreak":true},{"text":"Yuda bɔnsɔnna mangane fan fama,","poem":1},{"lineBreak":true},{"text":"e sɔnxɔma e nun Sabulon mangane","poem":1},{"lineBreak":true},{"text":"nun Nafatali mangane.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ala, i sɛnbɛn nagodo,","poem":1},{"lineBreak":true},{"text":"i sɛnbɛn mayita, Ala,","poem":1},{"lineBreak":true},{"text":"alo waxati danguxini.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"I Batu Banxin Yerusalɛn taani,","poem":1},{"lineBreak":true},{"text":"mangane fama kiseene ra i xa na yi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"I xa falan ti Misiran bɔxɔn xili ma","poem":1},{"lineBreak":true},{"text":"naxan nun sube xaɲɛn maliga sɛxɛni.","poem":1},{"lineBreak":true},{"text":"Misiran luxi nɛn alo tura ganla","poem":1},{"lineBreak":true},{"text":"siya gbɛtɛne biraxi naxan fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"alo ɲinge diine.","poem":1},{"lineBreak":true},{"text":"E ragodo han e fa mudu gbetin na.","poem":1},{"lineBreak":true},{"text":"Na siya yɛngɛ ralanne raxuya ayi!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Xɛrane kelima nɛn Misiran yamanani,","poem":1},{"lineBreak":true},{"text":"Kusi kaane yi e yiine ti Ala xa a maxandideni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Dunuɲa yamanane,","poem":1},{"lineBreak":true},{"text":"ɛ bɛtin ba Ala xa,","poem":1},{"lineBreak":true},{"text":"ɛ Marigin tantun bɛtini.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":34,"content":[{"text":"A masiga tima kore xɔnna ma","poem":1},{"lineBreak":true},{"text":"xabu waxati xunkuye.","poem":1},{"lineBreak":true},{"text":"A galan xuiin naminima fangani.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ɛ Ala sɛnbɛna fe rali,","poem":1},{"lineBreak":true},{"text":"a mangayaan nabama Isirayila xun na.","poem":1},{"lineBreak":true},{"text":"A sɛnbɛn kore xɔnna ma.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ala na mini a Yire Sariɲanxini,","poem":1},{"lineBreak":true},{"text":"a magaxu han!","poem":1},{"lineBreak":true},{"text":"Isirayilaa Ala sɛnbɛn fima a yamaan ma nɛn","poem":1},{"lineBreak":true},{"text":"e nun fangana.","poem":1},{"lineBreak":true},{"text":"Barikan xa bira Ala xa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":36}