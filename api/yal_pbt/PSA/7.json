{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":7,"content":[{"type":"heading","content":["Ala maxandin malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa mawugan bɛtina, a naxan baxi Alatala xa Kusi Bunyamin kaana fe ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala n ma Ala,","poem":1},{"lineBreak":true},{"text":"n bata n luxun i yi.","poem":1},{"lineBreak":true},{"text":"N xunba, i yi n nakisi","poem":1},{"lineBreak":true},{"text":"ne birin ma naxanye n fɔxɔ ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaxune nama n yibɔ alo yatana,","poem":1},{"lineBreak":true},{"text":"naxan ma se suxi mi xunbɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala n ma Ala,","poem":1},{"lineBreak":true},{"text":"e n kansunma naxan na,","poem":1},{"lineBreak":true},{"text":"xa n sɔnna na a ra,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"xa n bata fe ɲaxin dɔxɔ muxun na,","poem":1},{"lineBreak":true},{"text":"nxu nun naxan dɔxi bɔɲɛ xunbenli,","poem":1},{"lineBreak":true},{"text":"xa n bata n yɛngɛfaan muɲa tɔɲɛgɛni,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"nayi, i xa tin n yaxune xa n kedi,","poem":1},{"lineBreak":true},{"text":"e yi n suxu,","poem":1},{"lineBreak":true},{"text":"e yi n mabodon,","poem":1},{"lineBreak":true},{"text":"e yi n fatin lu saxi gbangbanni.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala keli i ya xɔlɔni,","poem":1},{"lineBreak":true},{"text":"keli n yaxu xaɲɛne xili ma.","poem":1},{"lineBreak":true},{"text":"Keli, n ma Ala,","poem":1},{"lineBreak":true},{"text":"i sariya kɛndɛn sa!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siyane malanxin xa i rabilin,","poem":1},{"lineBreak":true},{"text":"i mangayaan liga e xunna.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala xa siyane makiti.","poem":1},{"lineBreak":true},{"text":"Alatala, i xa n ma kitin sa n ma tinxinni,","poem":1},{"lineBreak":true},{"text":"bayo fɛ yo mi n na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Danna sa muxu ɲaxine gbalone ra!","poem":1},{"lineBreak":true},{"text":"I xa tinxin muxune ratanga,","poem":1},{"lineBreak":true},{"text":"i tan Ala tinxinxina,","poem":1},{"lineBreak":true},{"text":"i tan naxan muxun bɔɲɛne nun sɔndɔmɛne rakɔrɔsima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ala nan n yɛ masansan wure lefaan na.","poem":1},{"lineBreak":true},{"text":"A muxu sɔndɔmɛ faɲine rakisima nɛn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala nan kitisa tinxinxin na.","poem":1},{"lineBreak":true},{"text":"Ala na a ra naxan xɔlɔma waxatin birin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xa muxu ɲaxin mi tubi Ala ma,","poem":1},{"lineBreak":true},{"text":"a silanfanna raxanxanma nɛn,","poem":1},{"noteId":0},{"lineBreak":true},{"text":"a yi a xanla ba a woli xinla ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala bata a faxa ti seene tongo,","poem":1},{"lineBreak":true},{"text":"a a xalimakunle findi tɛɛn na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Naxan lugoxi tinxintareyaan na,","poem":1},{"lineBreak":true},{"text":"a mɔn nafexi gbalon na,","poem":1},{"lineBreak":true},{"text":"a raɲanna nan wulen na.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A yinla gema a a ratilin,","poem":1},{"lineBreak":true},{"text":"a yɛtɛɛn yi bira a kui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A tɔrɔn nun gbalon nakeli,","poem":1},{"lineBreak":true},{"text":"ne yi xɛtɛ a ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"N na Alatala tantunma a tinxinna fe ra.","poem":1},{"lineBreak":true},{"text":"N bɛtin bama nɛn Kore Xɔnna Alatala xinli.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"7.13Silanfanna:Sofane yɛngɛso dɛgɛmana.","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/yal_pbt/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}