{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. Maxandina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, n nakisi!","poem":1},{"lineBreak":true},{"text":"Alatala, fa n mali iki sa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala xa ne yarabi","poem":1},{"lineBreak":true},{"text":"naxanye n faxa feni tɔnma,","poem":1},{"lineBreak":true},{"text":"e yifu.","poem":1},{"lineBreak":true},{"text":"Ala xa ne raxɛtɛ marafɛyani","poem":1},{"lineBreak":true},{"text":"n ma tɔrɔn nafanxi naxanye ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E yagixin xa xɛtɛ naxanye a falama,","poem":1},{"lineBreak":true},{"text":"e naxa, “Yɔ! I suxi!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naxanye birin i tan fenma,","poem":1},{"lineBreak":true},{"text":"i xa ne birin nasɛwa.","poem":1},{"lineBreak":true},{"text":"Naxanye waxi i ya kisi feen xɔn,","poem":1},{"lineBreak":true},{"text":"ne xa lu a falɛ,","poem":1},{"lineBreak":true},{"text":"“Ala gbo!”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Koni, yiigelitɔɔn nun tɔrɔ muxun nan n tan na.","poem":1},{"lineBreak":true},{"text":"Ala, fa n fɛma mafurɛn!","poem":1},{"lineBreak":true},{"text":"I tan nan n malimaan nun n natangamaan na.","poem":1},{"lineBreak":true},{"text":"Alatala, i nama buyɛ ayi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}