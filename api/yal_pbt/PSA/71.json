{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":71,"content":[{"type":"heading","content":["Fonna Ala maxandina"]},{"type":"verse","number":1,"content":[{"text":"Alatala, i tan nan n luxunden na.","poem":1},{"lineBreak":true},{"text":"I nama tin n yi yagi!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N natanga i yi n xunba","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i tinxin.","poem":1},{"lineBreak":true},{"text":"I tuli mati n na i yi n nakisi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala, findi n kantan fanyen na,","poem":1},{"lineBreak":true},{"text":"n luxundena,","poem":1},{"lineBreak":true},{"text":"n luma sigɛ dɛnaxan yi.","poem":1},{"lineBreak":true},{"text":"Yamarin fi, i yi n nakisi.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ, n kantan fanyen nun","poem":1},{"lineBreak":true},{"text":"n ma yinna nan i tan na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ma Ala,","poem":1},{"lineBreak":true},{"text":"n natanga muxu ɲaxine sɛnbɛn ma,","poem":1},{"lineBreak":true},{"text":"i n ba hakɛ kanne nun gbalotɔne yii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N Marigina Alatala,","poem":1},{"lineBreak":true},{"text":"n yigin na i tan na.","poem":1},{"lineBreak":true},{"text":"N bata n yigin sa i yi","poem":1},{"lineBreak":true},{"text":"xabu n dii ɲɔrɛyani.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I n masuxi","poem":1},{"lineBreak":true},{"text":"xabu n yi n nga kui waxatin naxan yi.","poem":1},{"lineBreak":true},{"text":"I tan nan a liga n yi bari,","poem":1},{"lineBreak":true},{"text":"nanara n ni i tantunma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N findixi misaala nan na a wuyaxi xa,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n yigiya sɛnbɛmaan nan i tan na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N ni i tantunma nɛn fɛriɲɛn gbɛn!","poem":1},{"lineBreak":true},{"text":"N yi i ya nɔrɔn matɔxɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I nama i mɛ n na","poem":1},{"lineBreak":true},{"text":"amasɔtɔ iki, n bata fori.","poem":1},{"lineBreak":true},{"text":"I nama n nabeɲin","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n fangan bata ɲan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N yaxune n mafalama.","poem":1},{"lineBreak":true},{"text":"Naxanye waxi n faxa feni,","poem":1},{"lineBreak":true},{"text":"ne e bode toma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E naxa, “Ala bata a rabeɲin.","poem":1},{"lineBreak":true},{"text":"En siga a fɔxɔ ra en yi a suxu.","poem":1},{"lineBreak":true},{"text":"A xunba muxu mi na yi.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala, i nama i makuya n na.","poem":1},{"lineBreak":true},{"text":"N ma Ala, i mafura, i fa n mali!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ala xa ne yarabi, e ɲan,","poem":1},{"lineBreak":true},{"text":"naxanye n kansunma.","poem":1},{"lineBreak":true},{"text":"Ala xa ne yagi, e xun nagodo","poem":1},{"lineBreak":true},{"text":"naxanye waxi n maxɔlɔ feni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N xaxili tixi i ra tun!","poem":1},{"lineBreak":true},{"text":"N mɔn sigama i tantunɲɛ tun!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N ni i ya tinxinyaan matɔxɔma nɛn fɛriɲɛn gbɛn!","poem":1},{"lineBreak":true},{"text":"E nun i ya marakisina,","poem":1},{"lineBreak":true},{"text":"hali n to mi e birin kolon.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Marigina Alatala,","poem":1},{"lineBreak":true},{"text":"n fama i sɛnbɛn barakani,","poem":1},{"lineBreak":true},{"text":"n ni i tan keden peen nan ma tinxinyaan matɔxɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ala, xabu n xurun waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"i n xaran nɛn.","poem":1},{"lineBreak":true},{"text":"N mɔn i ya kabanakone matɔxɔma tun!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ala, iki, n bata fori,","poem":1},{"lineBreak":true},{"text":"n xunsɛxɛn fan bata fuga.","poem":1},{"lineBreak":true},{"text":"Koni i nama n nabeɲin","poem":1},{"lineBreak":true},{"text":"fɔ n xa i sɛnbɛn nali iki muxune ma,","poem":1},{"lineBreak":true},{"text":"n yi i ya fangana fe yɛba","poem":1},{"lineBreak":true},{"text":"mayixɛtɛ famatɔne birin xa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ala, i ya tinxinyaan bata kore li!","poem":1},{"lineBreak":true},{"text":"I bata kabanako fe wuyaxi liga.","poem":1},{"lineBreak":true},{"text":"Nde ligaxi alo i tan?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hali i to tɔrɔn nun xɔlɛ gbeen nafa n ma,","poem":1},{"lineBreak":true},{"text":"i mɔn n niin naxɛtɛma n yi nɛn.","poem":1},{"lineBreak":true},{"text":"Hali n sa gaburun tilinxini bɔxɔn bun,","poem":1},{"lineBreak":true},{"text":"i n natema nɛn mɔn.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I n ma xunnayerenna ragboma ayi nɛn,","poem":1},{"lineBreak":true},{"text":"i mɔn yi n madɛndɛn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N na i tantunma nɛn kondenna ra","poem":1},{"lineBreak":true},{"text":"i ya lannayana fe ra, n ma Ala.","poem":1},{"lineBreak":true},{"text":"N tantun bɛtin bama i xa nɛn bɔlɔnni,","poem":1},{"lineBreak":true},{"text":"Isirayila Sariɲantɔna.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N sɔnxɔma nɛn sɛwani","poem":1},{"lineBreak":true},{"text":"n nɛma bɛti baani waxatin naxan yi","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i bata n xunba.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"N ni i ya tinxinyaan matɔxɔma nɛn fɛriɲɛn gbɛn!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ naxanye yi waxi n tɔrɔ feni,","poem":1},{"lineBreak":true},{"text":"ne bata yagi, e yarabi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}