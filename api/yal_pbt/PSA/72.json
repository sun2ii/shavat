{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":72,"content":[{"type":"heading","content":["Ala maxandina mangan xa"]},{"type":"verse","number":1,"content":[{"text":"Sulemani gbeena.","descriptive":true},{"text":"Ala, mangan xaran i ya kitisa kɛndɛn na.","poem":1},{"lineBreak":true},{"text":"I ya tinxinyaan yita n tan mangana diin na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nanara, a i ya yamaan makitɛ tinxinni.","poem":1},{"lineBreak":true},{"text":"A sariya kɛndɛn sa yiigelitɔne xa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala xa bɔxɔn nasabati yamaan xa.","poem":1},{"lineBreak":true},{"text":"Ala xa tinxinyaan sabati yamanani.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mangan xa sariya kɛndɛn sa yiigelitɔne xa.","poem":1},{"lineBreak":true},{"text":"A xa tɔrɔ muxune diine rakisi,","poem":1},{"lineBreak":true},{"text":"a yi e yɛngɛfane rayensenɲɛ ayi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I ya mangayaan xa magaxu ayi","poem":1},{"lineBreak":true},{"text":"han mamandenne mamandenne","poem":1},{"lineBreak":true},{"text":"fanni sogen tema","poem":1},{"lineBreak":true},{"text":"fanni kiken mɔn dɛgɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mangan fanna xa liga","poem":1},{"lineBreak":true},{"text":"alo tulena xɛɛne ma,","poem":1},{"lineBreak":true},{"text":"a xa liga","poem":1},{"lineBreak":true},{"text":"alo tule igen nɛɛn fɛ bɔxɔn ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tinxin muxune xa sabati mangan waxatini.","poem":1},{"lineBreak":true},{"text":"Ala xa hɛri gbeen fi fanni kiken dɛgɛma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A mangayaan gboma ayi nɛn","poem":1},{"lineBreak":true},{"text":"sa fɔlɔ sogeteden na","poem":1},{"lineBreak":true},{"text":"han sa dɔxɔ sogegododen na.","poem":1},{"lineBreak":true},{"text":"Fɔlɔ Efirati baan ma","poem":1},{"lineBreak":true},{"text":"han sa dɔxɔ bɔxɔn danna ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naxanye wulani","poem":1},{"lineBreak":true},{"text":"ne e xinbi sinma a bun ma nɛn.","poem":1},{"lineBreak":true},{"text":"A yaxune e sama bɔxɔn ma nɛn a bun ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tarasisi mangane fama kiseene ra nɛn a fɛma","poem":1},{"lineBreak":true},{"text":"e nun fɔxɔ ige tagi bɔxɔne.","poem":1},{"lineBreak":true},{"text":"Saba nun Sɛba mangane mudun fima a ma nɛn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mangan birin e xinbi sinma a bun ma nɛn.","poem":1},{"lineBreak":true},{"text":"Siyane birin wanla kɛma a xa nɛn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A tɔrɔ muxune xunbama nɛn","poem":1},{"lineBreak":true},{"text":"naxanye na a xili,","poem":1},{"lineBreak":true},{"text":"e nun yiigelitɔ rabeɲinxine.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A kininkininma sɛnbɛtarene nun tɔrɔ muxune ma nɛn.","poem":1},{"lineBreak":true},{"text":"A tɔrɔ muxune niin nakisi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A e xɔrɔyama nɛn mayigbɛtɛnna nun gbalon ma,","poem":1},{"lineBreak":true},{"text":"bayo a e yatɛxi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ala xa mangan bu!","poem":1},{"lineBreak":true},{"text":"Ala xa xɛmaan fi a ma keli Saba yamanani.","poem":1},{"lineBreak":true},{"text":"Yamaan xa Ala maxandi a xa waxatin birin!","poem":1},{"lineBreak":true},{"text":"E xa duba a xa fɛriɲɛn gbɛn!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ala xa donseen wara ayi bɔxɔni.","poem":1},{"lineBreak":true},{"text":"Geyane xa rafe siseene ra.","poem":1},{"lineBreak":true},{"text":"E xa bogi alo naxanye Liban yamanani.","poem":1},{"lineBreak":true},{"text":"Taa kaane xa sabati alo sɛxɛna.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ala xa mangan findi xili kanna ra habadan!","poem":1},{"lineBreak":true},{"text":"A xinla xa bu alo sogena.","poem":1},{"lineBreak":true},{"text":"Siyane birin duban sɔtɔma nɛn a barakani.","poem":1},{"lineBreak":true},{"text":"E fan yi duba a xa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Barikan xa bira Marigina Alatala xa,","poem":1},{"lineBreak":true},{"text":"Isirayilaa Ala!","poem":1},{"lineBreak":true},{"text":"A tan keden peen nan kabanako feene ligama.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Barikan xa bira a xa habadan!","poem":1},{"lineBreak":true},{"text":"Ala xa dunuɲa birin nafe a binyen na!","poem":1},{"lineBreak":true},{"text":"Amina! Amina!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yese a dii xɛmɛn Dawuda maxandine danna ni i ra.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}