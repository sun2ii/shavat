{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":73,"content":[{"type":"heading","content":["Alaa tinxinyana fe"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina.","descriptive":true},{"text":"Ala fan Isirayila ra han!","poem":1},{"lineBreak":true},{"text":"A fan bɔɲɛ sariɲanxi kanne ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Koni fayida n bata yi tantan,","poem":1},{"lineBreak":true},{"text":"n kiraan beɲin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amasɔtɔ n yi wasodene maxɔxɔlɔnma nun","poem":1},{"lineBreak":true},{"text":"n muxu ɲaxine sabatixin to waxatin naxan yi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E mi kɔntɔfilixi sese ra mumɛ!","poem":1},{"lineBreak":true},{"text":"E fatine fan, e kɛndɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E mi sɔxɔlɛxi sese ra alo bonne.","poem":1},{"lineBreak":true},{"text":"Adamadiine tɔrɔne mi e tan lima.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nanara, wasona e yi","poem":1},{"lineBreak":true},{"text":"alo ɲɛrɛn muxune kɔɛ.","poem":1},{"lineBreak":true},{"text":"Gbalona e yi alo domaan muxune ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Turena e fatini","poem":1},{"lineBreak":true},{"text":"han e yɛtagin bata yikusin.","poem":1},{"lineBreak":true},{"text":"Fe ɲaxin nan e bɔɲɛni han!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E gelen muxune ma,","poem":1},{"lineBreak":true},{"text":"e fala ɲaxine ti.","poem":1},{"lineBreak":true},{"text":"E muxune ɲaxankatama wasoni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E fala ɲaxine tima Ala ma,","poem":1},{"lineBreak":true},{"text":"e dɛ ɲaxu falane dunuɲa birin yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nanara, yamaan biraxi e fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"e falane xɔnla yi e suxu","poem":1},{"lineBreak":true},{"text":"alo igen min daxina.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E naxa, “Ala nanse kolon?","poem":1},{"lineBreak":true},{"text":"Kore Xɔnna Ala nɔɛ na kolonɲɛ di?”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Muxu ɲaxine na kii nin.","poem":1},{"lineBreak":true},{"text":"E bɔɲɛn saxi waxatin birin,","poem":1},{"lineBreak":true},{"text":"e lu nafunla sɔtɛ tun!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nayi, n luxi tinxinyani nɛn fuu!","poem":1},{"lineBreak":true},{"text":"N yi n yɛtɛ rasariɲan fuyan!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N tɔrɔxi lɔxɔ yo lɔxɔ!","poem":1},{"lineBreak":true},{"text":"I n hakɛn saranma n na xɔtɔn yo xɔtɔn!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Xa n yi falan ti alo e tan,","poem":1},{"lineBreak":true},{"text":"nayi, n yi i ya muxune yanfama nɛn nun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nanara, n yi kata feni ito famudeni,","poem":1},{"lineBreak":true},{"text":"koni, a yi xɔdɔxɔ n ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Han n so Alaa yire sariɲanxini waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n yi n miri e raɲan kiin ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ala, i e tima yire salaxunxin nin,","poem":1},{"lineBreak":true},{"text":"e birama dɛnaxan yi, e kala.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nba, e halagima nɛn mafurɛn,","poem":1},{"lineBreak":true},{"text":"gbalon yi e ɲan sasa!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"E luxi nɛn alo xiyena","poem":1},{"lineBreak":true},{"text":"naxan ɲinanma muxun na xɔtɔnni.","poem":1},{"lineBreak":true},{"text":"Marigina, i na keli waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"e tununma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"N bɔɲɛn yi sɔxɔlɛxi waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n niin yi sunuxi,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"n yi daxuyaan nun xaxilitareyani.","poem":1},{"lineBreak":true},{"text":"N yi luxi i yɛɛ ra yi alo subena.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Koni hali na,","poem":1},{"lineBreak":true},{"text":"n yi i fɔxɔ ra waxatin birin,","poem":1},{"lineBreak":true},{"text":"i yi n yii rasuxu,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"i ti n yɛɛ ra i ya maxadine xɔn,","poem":1},{"lineBreak":true},{"text":"i yi n nasuxu binyen nin.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nde n malima kore xɔnna ma,","poem":1},{"lineBreak":true},{"text":"ba i tan na?","poem":1},{"lineBreak":true},{"text":"Bayo i bata lu n xɔn,","poem":1},{"lineBreak":true},{"text":"n fa waxi nanse gbɛtɛ xɔn dunuɲa yi?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"N fati bɛndɛn nun n niin taganɲɛ nɛn,","poem":1},{"lineBreak":true},{"text":"koni Ala nan n niin sɛnbɛn na","poem":1},{"lineBreak":true},{"text":"e nun n kɛɛna habadan!","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Naxanye e makuyaxi i ra,","poem":1},{"lineBreak":true},{"text":"ne yatin halagima nɛn.","poem":1},{"lineBreak":true},{"text":"Naxanye e mɛxi i ra, i yi ne raxɔri.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Koni a rafan n tan ma,","poem":1},{"lineBreak":true},{"text":"n yi n maso Ala ra.","poem":1},{"lineBreak":true},{"text":"N bata Marigina Alatala findi n yigiyaan na,","poem":1},{"lineBreak":true},{"text":"alogo n xa i ya wali faɲine birin nali!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}