{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":75,"content":[{"type":"heading","content":["Ala nan kitisaan na"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina, bɛti baane kuntigin xa, a xa ba alo bɛtin naxan xili, “I Nama Halagin Ti.” Sigi sariɲanxina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, nxu bata i tantun.","poem":1},{"lineBreak":true},{"text":"Nxu i tantunma han!","poem":1},{"lineBreak":true},{"text":"Nxu i maxandima i xinli,","poem":1},{"lineBreak":true},{"text":"nxu yi i ya kabanakone fe fala.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I naxa, “N bata kiti sa lɔxɔn sa.","poem":1},{"lineBreak":true},{"text":"N kiti faɲin sama nɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɔxɔn xuruxurunma waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"a niimaseene birin yi xuruxurun,","poem":1},{"lineBreak":true},{"text":"n tan nan a san bundɔxɔn xɔdɔxɔma ayi ken!","poem":1},"Bɛti xuini te."]},{"type":"verse","number":5,"content":[{"text":"N bata a fala wasodene xa,","poem":1},{"lineBreak":true},{"text":"‘Ɛ nama ɛ yɛtɛ yigbo!’","poem":1},{"lineBreak":true},{"text":"N bata a fala muxu ɲaxine xa,","poem":1},{"lineBreak":true},{"text":"‘Ɛ nama ɛ kanba ɛ sɛnbɛn xɔn!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ nama ɛ kanba ɛ sɛnbɛn xɔn","poem":1},{"lineBreak":true},{"text":"kore xɔnna xili ma!","poem":1},{"lineBreak":true},{"text":"Ɛ nama waso falane ti!’ ”","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amasɔtɔ xun mayɛngɛn mi kelima","poem":1},{"lineBreak":true},{"text":"sogeteden binna xan na","poem":1},{"lineBreak":true},{"text":"hanma sogegododen binni hanma burunna ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala nan kitin sama.","poem":1},{"lineBreak":true},{"text":"A yi nde yalagi, a yi nde yoo sa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amasɔtɔ igelengenna suxi Alatala yii,","poem":1},{"lineBreak":true},{"text":"a rafexi a xɔlɛn na","poem":1},{"lineBreak":true},{"text":"alo dɔlɔ xɔdɛxɛna.","poem":1},{"lineBreak":true},{"text":"A a xɛlɛma nɛn,","poem":1},{"lineBreak":true},{"text":"muxu ɲaxine birin yi a min han a ɲan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Koni n na a fe falama nɛn bɛtine yi habadan!","poem":1},{"lineBreak":true},{"text":"N yi tantun bɛtin ba Yaxubaa Ala xa!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A muxu ɲaxine birin fangan kala,","poem":1},{"lineBreak":true},{"text":"a tinxin muxune xunna keli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}