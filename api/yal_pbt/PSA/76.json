{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":76,"content":[{"type":"heading","content":["Nɔ tiin nan Ala ra"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina, bɛti baane kuntigin xa. A xa ba kondenne ra. Sigi sariɲanxina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yuda kaane Ala kolon.","poem":1},{"lineBreak":true},{"text":"A xinla binyaxi Isirayila yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A konna Salemi taan nin,","poem":1},{"lineBreak":true},{"text":"a dɔxi Siyon Geyaan nin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A a yaxune xalimakunle yigira mɛnna nin,","poem":1},{"lineBreak":true},{"text":"e nun yɛ masansan wure lefane nun e silanfanne","poem":1},{"lineBreak":true},{"text":"nun e yɛngɛ so seene birin.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ala, i tan nan sɛnbɛn birin kanna ra,","poem":1},{"lineBreak":true},{"text":"i nɔrɔxi dangu habadan geyane ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sofa wɛkilɛxine birin bata bira,","poem":1},{"lineBreak":true},{"text":"e yii seene yi tongo yɛngɛni.","poem":1},{"lineBreak":true},{"text":"E fa saya xixɔnla nin.","poem":1},{"lineBreak":true},{"text":"Na sofa yo mi fa a yiini maxama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaxubaa Ala, i na falan ti xɔlɔni,","poem":1},{"lineBreak":true},{"text":"soone nun soo ragine yi bira, e faxa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I tan nan magaxu, Ala.","poem":1},{"lineBreak":true},{"text":"I na xɔlɔ, nde nɔɛ tiyɛ i yɛɛ ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I to kitisa xuiin namini keli kore,","poem":1},{"lineBreak":true},{"text":"yamanan muxune yi gaxu,","poem":1},{"lineBreak":true},{"text":"e yi e dundu,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"i to keli kiti bolondeni","poem":1},{"lineBreak":true},{"text":"alogo i xa yiigelitɔne rakisi.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hali muxune na xɔlɔ i ma,","poem":1},{"lineBreak":true},{"text":"na raɲanma tantunna nan ma i tan xa.","poem":1},{"lineBreak":true},{"text":"Naxanye na mini i ya xɔlɔn bun,","poem":1},{"lineBreak":true},{"text":"ne xaxili sɔtɔma nɛn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I na i dɛ ti Alatala xa, i ya Ala,","poem":1},{"lineBreak":true},{"text":"i xa a rakamali.","poem":1},{"lineBreak":true},{"text":"Yamanan naxanye birin be rabilinni,","poem":1},{"lineBreak":true},{"text":"ɛ Alatala ki!","poem":1},{"lineBreak":true},{"text":"A lan birin xa gaxu a yɛɛ ra!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A tan kuntigi wasoxine ragodoma nɛn,","poem":1},{"lineBreak":true},{"text":"a yi dunuɲa mangane magaxu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}