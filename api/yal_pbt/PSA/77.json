{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":77,"content":[{"type":"heading","content":["Madɛndɛnna tɔrɔ waxatini"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina, bɛti baane kuntigin xa, Yedutun xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N bata n xuini te Ala ma.","poem":1},{"lineBreak":true},{"text":"N bata n ma mawuga xuini te,","poem":1},{"lineBreak":true},{"text":"a xa n xuiin namɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yi tɔrɔni waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"n Marigin maxandi nɛn.","poem":1},{"lineBreak":true},{"text":"Kɔɛɛn birin na, n yi n yiini te Ala ma,","poem":1},{"lineBreak":true},{"text":"koni n mi madɛndɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alaa fe to rabira n ma, n kutun.","poem":1},{"lineBreak":true},{"text":"N to n miri a ma, n xaxinla yi yifu.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N yi xi n yɛɛ ra yi.","poem":1},{"lineBreak":true},{"text":"N xaminxi, n mi fala tima.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nayi, n yi n miri waxati danguxine ma","poem":1},{"lineBreak":true},{"text":"e nun ɲɛɛ xunkuyene.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛtine yi rabira n ma kɔɛɛn na.","poem":1},{"lineBreak":true},{"text":"N yi n miri n bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"n maxɔdinna ti n xaxinli iki:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Marigina a mɛma nxu ra nɛn ba,","poem":1},{"lineBreak":true},{"text":"han habadan?","poem":1},{"lineBreak":true},{"text":"Nxu mi fa a kɛnɛnma ba?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Marigina hinanna bata ɲan ba,","poem":1},{"lineBreak":true},{"text":"han habadan?","poem":1},{"lineBreak":true},{"text":"A tulisaan bata ɲan ba,","poem":1},{"lineBreak":true},{"text":"han habadan?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala bata ɲinan hinanna xɔn ma ba?","poem":1},{"lineBreak":true},{"text":"Ala bata a kininkininna ɲan a xɔlɔni ba?”","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“Naxan n tɔrɔma, na ni ito ra:","poem":1},{"lineBreak":true},{"text":"Kore Xɔnna Ala mi fa a fangan yitama","poem":1},{"lineBreak":true},{"text":"alo a fɔlɔni.”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Alatala,","poem":1},{"lineBreak":true},{"text":"n xa i ya kɛwanle rabira n yɛtɛ ma.","poem":1},{"lineBreak":true},{"text":"I ya kabanako fe fonne yi rabira n ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N xa n miri i ya wanle ma.","poem":1},{"lineBreak":true},{"text":"N yi n xaxili lu i ya wali gbeene xɔn ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ala, i ya kiraan sariɲan.","poem":1},{"lineBreak":true},{"text":"Batu se yo mi gbo alo Ala.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ala nan i tan na","poem":1},{"lineBreak":true},{"text":"naxan kabanako wanle kɛma.","poem":1},{"lineBreak":true},{"text":"I bata i sɛnbɛn mayita siyane tagi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I bata i ya yamaan xunba i sɛnbɛni,","poem":1},{"lineBreak":true},{"text":"Yaxuba nun Yusufu bɔnsɔnne.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ala, igene to i to,","poem":1},{"lineBreak":true},{"text":"e yi xuruxurun.","poem":1},{"lineBreak":true},{"text":"Tilinne yi xuruxurun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tulen yi godo keli kore.","poem":1},{"lineBreak":true},{"text":"Galanna yi a xuiin namini kore.","poem":1},{"lineBreak":true},{"text":"Kuyen yi a ɲinna masɔxɔn yiren birin yi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I ya kuye sarinna xuiin yi gbo ayi.","poem":1},{"lineBreak":true},{"text":"I ya kuyena ɲin masɔxɔnna yi dunuɲa birin yiyalan.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn yi xuruxurun, a yi yimaxa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I ya kiraan yi fɔxɔ igeni.","poem":1},{"lineBreak":true},{"text":"I gidi baa tilinxini, i san fɔxɔne mi toɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I yi Nabi Musa nun Haruna ti i ya yamaan yɛɛ ra","poem":1},{"lineBreak":true},{"text":"alo xuruse rabaan tima yɛxɛɛ kurun yɛɛ ra kii naxan yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":21}