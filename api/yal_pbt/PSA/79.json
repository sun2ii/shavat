{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":79,"content":[{"type":"heading","content":["Ala maxandina Yerusalɛn taan xunba feen na"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina.","descriptive":true},{"text":"Ala, siya gbɛtɛne bata i ya bɔxɔn yɛngɛ,","poem":1},{"lineBreak":true},{"text":"e so.","poem":1},{"lineBreak":true},{"text":"E bata i Batu Banxi Sariɲanxin naharamu.","poem":1},{"lineBreak":true},{"text":"E bata Yerusalɛn findi taa xɔnna ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E bata i ya walikɛne binbine so xɔline yii","poem":1},{"lineBreak":true},{"text":"e yi e don.","poem":1},{"lineBreak":true},{"text":"I ya muxu tɔgɔndiyaxine binbine bata lu burunna subene bun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E bata e wunla ramini Yerusalɛn birin yi","poem":1},{"lineBreak":true},{"text":"alo igen bɔxɔnma.","poem":1},{"lineBreak":true},{"text":"Muxu yo mi luxi","poem":1},{"lineBreak":true},{"text":"naxan faxa muxune maluxunɲɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nxu rabilinna siyane fala ɲaxin tima nxu ma,","poem":1},{"lineBreak":true},{"text":"e nxu makonbi, e nxu magele.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, i luma xɔlɔxi nxu ma nɛn","poem":1},{"lineBreak":true},{"text":"han waxatin mundun?","poem":1},{"lineBreak":true},{"text":"I ya xɔlɔn luma nɛn alo tɛɛna","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I ya xɔlɔn nagodo siyane ma","poem":1},{"lineBreak":true},{"text":"naxanye mi i batuma,","poem":1},{"lineBreak":true},{"text":"e nun yamanan naxanye mi i xinla binyama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amasɔtɔ e bata Yaxuba bɔnsɔnna nɔ,","poem":1},{"lineBreak":true},{"text":"e a bɔxɔn kala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I nama nxu tɔrɔ nxu benbane hakɛne fe ra.","poem":1},{"lineBreak":true},{"text":"I ya kininkininna xa nxu ralan iki sa!","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ nxu makona a ma han!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala, nxu rakisi muxuna,","poem":1},{"lineBreak":true},{"text":"nxu mali i xinla binya feen na!","poem":1},{"lineBreak":true},{"text":"Nxu xunba,","poem":1},{"lineBreak":true},{"text":"i yi nxu mafelu nxu yulubine ra","poem":1},{"lineBreak":true},{"text":"i xinla a fe ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nanfera siyane maxɔdinna tima,","poem":1},{"lineBreak":true},{"text":"e naxa, “E Ala minɛn?”","poem":1},{"lineBreak":true},{"text":"A yita siyane ra nxu yɛɛ xɔri","poem":1},{"lineBreak":true},{"text":"a i ya walikɛne faxa feen ɲɔxɔma nɛn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I tuli mati suxu muxune kutun xuiin na.","poem":1},{"lineBreak":true},{"text":"Naxanye yalagin bun,","poem":1},{"lineBreak":true},{"text":"ne ratanga i sɛnbɛ gbeen na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Na siyane konbin naxanye ti i ma Marigina,","poem":1},{"lineBreak":true},{"text":"ne saranna fi na ra dɔxɔ solofere.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanara, nxu tan i ya yamana,","poem":1},{"lineBreak":true},{"text":"i naxan kantanma","poem":1},{"lineBreak":true},{"text":"alo i ya xuruse kuruna,","poem":1},{"lineBreak":true},{"text":"nxu i tantunɲɛ na yi habadan,","poem":1},{"lineBreak":true},{"text":"nxu i matɔxɔ waxati famatɔne birin yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}