{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":8,"content":[{"type":"heading","content":["Alaa binyena adamadiin xa"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba Gati kaane kondenna ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Nxu Marigina Alatala,","poem":1},{"lineBreak":true},{"text":"i tan nan xili gbee kanna ra bɔxɔn birin yi!","poem":1},{"lineBreak":true},{"text":"I bata i ya nɔrɔn nate","poem":1},{"lineBreak":true},{"text":"han kore xɔnna ma!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bata diidine nun dii ɲɔrɛne yamari","poem":1},{"lineBreak":true},{"text":"e yi i matɔxɔ","poem":1},{"lineBreak":true},{"text":"alogo i yaxune xa e dundu,","poem":1},{"lineBreak":true},{"text":"e nun yɛngɛfane nun gbeeɲɔxɔ tiine.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N na koren mato","poem":1},{"lineBreak":true},{"text":"i naxan nafalaxi i yiin na,","poem":1},{"lineBreak":true},{"text":"kiken nun sarene","poem":1},{"lineBreak":true},{"text":"i naxanye dɔxi e yirene yi, n naxa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"“Nanse daɲɔxɔn na,","poem":1},{"lineBreak":true},{"text":"i to i yengi dɔxi a xɔn?","poem":1},{"lineBreak":true},{"text":"Nanfera i ɲɔxɔ luxi adamadiin xɔn?”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I a daxi nɛn,","poem":1},{"lineBreak":true},{"text":"a nɔrɔn yi maso malekane ra.","poem":1},{"lineBreak":true},{"text":"I binyen nun xunnayerenna fi a ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bata yamarin so a yii","poem":1},{"lineBreak":true},{"text":"i ya dali seene birin xunna.","poem":1},{"lineBreak":true},{"text":"I bata seen birin lu a sanna bun:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"alo xuruse kurune nun ɲinge kurune","poem":1},{"lineBreak":true},{"text":"nun burunna subene","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"nun xɔline nun yɛxɛne","poem":1},{"lineBreak":true},{"text":"e nun niimaseen naxanye fɔxɔ igeni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nxu Marigina Alatala,","poem":1},{"lineBreak":true},{"text":"i tan nan xili gbee kanna ra bɔxɔn birin yi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}