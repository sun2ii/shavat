{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":80,"content":[{"type":"heading","content":["Ala xa en ma yamanan natanga"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina bɛti baane kuntigin xa, sereyana, a xa ba alo bɛtin naxan xili: “Fuge Faɲine.”","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Isirayila kantan muxuna,","poem":1},{"lineBreak":true},{"text":"i tuli mati nxu ra.","poem":1},{"lineBreak":true},{"text":"I tan naxan tixi Yusufu bɔnsɔnna yɛɛ ra","poem":1},{"lineBreak":true},{"text":"alo xuruse kuruna,","poem":1},{"lineBreak":true},{"text":"i tan naxan dɔxi maleka gubugubu kanne tagi,","poem":1},{"lineBreak":true},{"text":"i yɛtɛ makɛnɛn nɔrɔni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I sɛnbɛn yita","poem":1},{"lineBreak":true},{"text":"Efirami nun Bunyamin nun Manase bɔnsɔnne ra.","poem":1},{"lineBreak":true},{"text":"Keli, i fa nxu rakisi!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala, i mɔn xa nxu sɛnbɛ so,","poem":1},{"lineBreak":true},{"text":"i nɔrɔn nagodo nxu ma,","poem":1},{"lineBreak":true},{"text":"alogo nxu xa kisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala, Ala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"i luma xɔlɔxi i ya yamaan ma","poem":1},{"lineBreak":true},{"text":"han waxatin mundun","poem":1},{"lineBreak":true},{"text":"i tondi a maxandin yabɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I bata e balon findi sɔxɔlɛn na,","poem":1},{"lineBreak":true},{"text":"i yi e igelengenne rafe yɛɛgen na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bata nxɔ bɔxɔn findi yɛngɛ so xunna ra","poem":1},{"lineBreak":true},{"text":"nxu rabilinna siyane xa.","poem":1},{"lineBreak":true},{"text":"Nxu yaxune nxu magelema.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"i mɔn xa nxu sɛnbɛ so,","poem":1},{"lineBreak":true},{"text":"i nɔrɔn nagodo nxu ma,","poem":1},{"lineBreak":true},{"text":"alogo nxu xa kisi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I fa nɛn wudi binla ra","poem":1},{"lineBreak":true},{"text":"sa keli Misiran yamanani.","poem":1},{"lineBreak":true},{"text":"I siyaan bonne kedi,","poem":1},{"lineBreak":true},{"text":"i yi na wudi binla si e bɔxɔni.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I yi yirena nde yitɔn a rasoliden na.","poem":1},{"lineBreak":true},{"text":"A salenne yi godo pon!","poem":1},{"lineBreak":true},{"text":"A yi yamanan nafe.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A nininna yi so geyane xun na.","poem":1},{"lineBreak":true},{"text":"A yiine yi so suman wudi gbeene xun na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yiine yi sigama han fɔxɔ igen xun ma,","poem":1},{"lineBreak":true},{"text":"e mɔn yi sigaxi han baan xun ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nanfera i a langan kalaxi?","poem":1},{"lineBreak":true},{"text":"I tin dangu muxune birin yi a bogine muɲa?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Segune yi keli fɔtɔnni, e a kala,","poem":1},{"lineBreak":true},{"text":"burunna subene yi a don.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sɛnbɛn Birin Kanna Ala, i mɔn xa fa.","poem":1},{"lineBreak":true},{"text":"I yɛɛ ragodo nxu ma keli ariyanna yi,","poem":1},{"lineBreak":true},{"text":"i yi nxu mato.","poem":1},{"lineBreak":true},{"text":"I ya yamaan nakisi","poem":1},{"lineBreak":true},{"text":"naxan findixi na wudi binla ra!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"I tan yɛtɛɛn naxan sixi,","poem":1},{"lineBreak":true},{"text":"i xa na ratanga!","poem":1},{"lineBreak":true},{"text":"A luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo i tan yɛtɛɛn diin naxan nagboxi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"E bata a sɛgɛ, e a gan,","poem":1},{"lineBreak":true},{"text":"i ya yamaan kalama i ya xɔlɔn bun ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I yengi lu mangan xɔn ma","poem":1},{"lineBreak":true},{"text":"i tan yɛtɛɛn naxan dɔxi,","poem":1},{"lineBreak":true},{"text":"i tan yɛtɛɛn diin naxan nagboxi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nxu mi fa nxu xun xanbi soma i yi sɔnɔn.","poem":1},{"lineBreak":true},{"text":"Nxu rakisi nanara nxu i tantunɲɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatala, Ala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"i mɔn xa nxu sɛnbɛ so,","poem":1},{"lineBreak":true},{"text":"i nɔrɔn nagodo nxu ma,","poem":1},{"lineBreak":true},{"text":"alogo nxu xa kisi!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":20}