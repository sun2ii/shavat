{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":81,"content":[{"type":"heading","content":["Ala nan en malima"]},{"type":"verse","number":1,"content":[{"text":"Asafi gbeena, bɛti baane kuntigin xa. A xa ba Gati kaane kondenna ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Sɔnxɔ sɛwani en ma Ala xa,","poem":1},{"lineBreak":true},{"text":"en sɛnbɛna.","poem":1},{"lineBreak":true},{"text":"Ɛ xuini te Yaxubaa Ala xa!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ bɛti baan fɔlɔ,","poem":1},{"lineBreak":true},{"text":"ɛ tanbanne maxa,","poem":1},{"lineBreak":true},{"text":"e nun bɔlɔnna nun kondenna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kike nɛnɛn na te,","poem":1},{"lineBreak":true},{"text":"e nun kiken na kɔxɔ,","poem":1},{"lineBreak":true},{"text":"ɛ xɔtaan fe en ma sali lɔxɔne yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sariyan nan ito ra Isirayila xa.","poem":1},{"lineBreak":true},{"text":"Yaxubaa Alaa yamarin nan ito ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A a so Yusufu a denbayaan yii nɛn","poem":1},{"lineBreak":true},{"text":"a Misiran yamanan yɛngɛ waxatin naxan yi.","poem":1},{"lineBreak":true},{"text":"En yi xuina nde mɛ","poem":1},{"lineBreak":true},{"text":"en mi yi naxan kolon,","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A naxa, “N bata goronne ba ɛ xun ma.","poem":1},{"lineBreak":true},{"text":"Ɛ bata goron binyen dɔxɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɛ yi tɔrɔni waxatin naxan yi,","poem":1},{"lineBreak":true},{"text":"ɛ yi n xili n yi ɛ xunba.","poem":1},{"lineBreak":true},{"text":"N yi ɛ yabi foye gbeeni.","poem":1},{"lineBreak":true},{"text":"N yi ɛ kɛɲaan fɛsɛfɛsɛ Meriba igene yi.”","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“N ma yamana,","poem":1},{"lineBreak":true},{"text":"ɛ ɛ tuli mati n ma maxadi xuine ra.","poem":1},{"lineBreak":true},{"text":"Isirayila, xa ɛ yi n xuiin namɛ nun!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛ nama Ala gbɛtɛ batu!","poem":1},{"lineBreak":true},{"text":"Ɛ nama ɛ xinbi sin ala gbɛtɛ yo xa!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala nan n tan na,","poem":1},{"lineBreak":true},{"text":"ɛ Ala naxan faxi ɛ ra","poem":1},{"lineBreak":true},{"text":"sa keli Misiran yamanani.","poem":1},{"lineBreak":true},{"text":"Ɛ ɛ dɛɛne yibi, n xa ɛ ralugo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Koni n ma yamaan mi e tuli matixi n na.","poem":1},{"lineBreak":true},{"text":"Isirayila mi tin n na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nayi, n yi e lu e tengbesenyani,","poem":1},{"lineBreak":true},{"text":"e yi bira e waxɔn feene fɔxɔ ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xa n ma yamaan yi n xuiin namɛ nun,","poem":1},{"lineBreak":true},{"text":"xa Isirayila yi birɛ n ma kirane fɔxɔ ra nun,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"n yi e yaxune yarabima nɛn nun mafurɛn!","poem":1},{"lineBreak":true},{"text":"N yi e yɛngɛfane halagima nɛn.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Naxanye Alatala raɲaxuxi","poem":1},{"lineBreak":true},{"text":"ne gaxuxine yi e felenma nɛn a bun ma.","poem":1},{"lineBreak":true},{"text":"E tɔrɔn mi yi ɲanma habadan!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N yi ɛ baloma nɛn malo faɲin nun kumin na.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}