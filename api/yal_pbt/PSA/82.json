{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"heading","content":["Ala nan mangan na"]},{"type":"verse","number":1,"content":[{"text":"Asafi a bɛtina.","descriptive":true},{"text":"Ala dɔxi a manga gbɛdɛni,","poem":1},{"lineBreak":true},{"text":"a tan nan kitin sama sɛnbɛmane tagi.","poem":1},{"lineBreak":true},{"text":"A yi a fala, a naxa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Ɛ luma kitin sɛ tinxintareyani","poem":1},{"lineBreak":true},{"text":"han waxatin mundun,","poem":1},{"lineBreak":true},{"text":"ɛ yi lu muxu ɲaxine rafisɛ bonne xa?","poem":1},"Bɛti xuini te."]},{"type":"verse","number":3,"content":[{"text":"Ɛ xa sɛnbɛtarene nun kiridine xun mayɛngɛ kitin sa,","poem":1},{"lineBreak":true},{"text":"ɛ yi tinxin yiigelitɔne nun muxu ɲaxankataxine xa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɛ xa sɛnbɛtarene nun tɔrɔ muxune ratanga,","poem":1},{"lineBreak":true},{"text":"ɛ e xunba muxu ɲaxine yii.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ɛ mi fe kolon,","poem":1},{"lineBreak":true},{"text":"ɛ xaxili mi na,","poem":1},{"lineBreak":true},{"text":"ɛ sigan tima dimin nin,","poem":1},{"lineBreak":true},{"text":"bɔxɔn bunne birin xuruxurunma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N bata yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"‘Alane nan ɛ tan na.","poem":1},{"lineBreak":true},{"text":"Kore Xɔnna Alaa diine nan ɛ birin na.’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Koni ɛ faxama nɛn","poem":1},{"lineBreak":true},{"text":"alo adamadiin bonne,","poem":1},{"lineBreak":true},{"text":"ɛ bira alo kuntigin bonne.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ala, keli, i fa dunuɲa makiti,","poem":1},{"lineBreak":true},{"text":"bayo i tan nan gbee siyane birin na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}