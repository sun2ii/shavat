{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":83,"content":[{"type":"heading","content":["Isirayilaa Ala maxandina e yaxune to yi e tɔrɔma"]},{"type":"verse","number":1,"content":[{"text":"Sigi sariɲanxina. Asafi a bɛtina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, i nama i dundu.","poem":1},{"lineBreak":true},{"text":"Ala, falan ti, i nama i raxara!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mato, i yaxune bata keli.","poem":1},{"lineBreak":true},{"text":"Naxanye i raɲaxuxi, ne bata murutɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E feene yitɔnma wundoni i ya yamaan xili ma.","poem":1},{"lineBreak":true},{"text":"I naxanye ratangaxi,","poem":1},{"lineBreak":true},{"text":"e sama e bode fari ne xili ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E naxa, “En sa e raxɔri,","poem":1},{"lineBreak":true},{"text":"alogo Isirayila xinla xa tunun dunuɲa yi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"E bata lan a ma,","poem":1},{"lineBreak":true},{"text":"e xa e malan i xili ma,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Edɔn kaane nun Sumayila bɔnsɔnna muxune","poem":1},{"lineBreak":true},{"text":"nun Moyaba kaane nun Hagari kaane","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"nun Gebala kaane nun Amonine nun Amalɛkine","poem":1},{"lineBreak":true},{"text":"nun Filisitine e nun Tire kaane.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asiriya yamanan fan bata sa e fari,","poem":1},{"lineBreak":true},{"text":"alogo e xa Loti bɔnsɔnna muxune mali.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"A liga e ra","poem":1},{"lineBreak":true},{"text":"alo i a liga Midiyan kaane ra kii naxan yi,","poem":1},{"lineBreak":true},{"text":"alo i a liga Sisera nun Yabin na Kison xudeni","poem":1},{"lineBreak":true},{"text":"kii naxan yi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E faxa nɛn En-Dɔri yi,","poem":1},{"lineBreak":true},{"text":"e yi kun bɔxɔn fari.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A liga e kuntigine ra","poem":1},{"lineBreak":true},{"text":"alo i Orebi nun Sebi liga kii naxan yi.","poem":1},{"lineBreak":true},{"text":"E mangane birin xa lu","poem":1},{"lineBreak":true},{"text":"alo Sebaxa nun Salamuna,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"naxanye yi a falama, e naxa,","poem":1},{"lineBreak":true},{"text":"“Nxu xa Alaa bɔxɔne tongo nxu gbeen na.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ala, e liga","poem":1},{"lineBreak":true},{"text":"alo wuluwunla na sɛxɛ xarene tongo,","poem":1},{"lineBreak":true},{"text":"alo foyen na se dagin xali,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"alo tɛɛn fɔtɔnna ganma kii naxan yi,","poem":1},{"lineBreak":true},{"text":"alo tɛɛn tema geyane ma kii naxan yi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"E kedi i ya tule gbeen na.","poem":1},{"lineBreak":true},{"text":"E magaxu i ya foye gbeen na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala, e rayagi,","poem":1},{"lineBreak":true},{"text":"han e yi i xinla fen.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E xa lu yagin nun kuisanni habadan.","poem":1},{"lineBreak":true},{"text":"E xa yigitɛgɛ, e raxɔri.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E xa a kolon","poem":1},{"lineBreak":true},{"text":"fa fala i tan Alatala,","poem":1},{"lineBreak":true},{"text":"i tan keden peen nan Kore Xɔnna Ala ra,","poem":1},{"lineBreak":true},{"text":"naxan mangayaan ligama dunuɲa birin xun na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}