{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":84,"content":[{"type":"heading","content":["Ala Batu Banxini siga bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine tantun bɛtina, bɛti baane kuntigin xa. A xa ba Gati kaane kondenna ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"i luden nayabu n yi han!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatalaa banxin xɔnla n na han!","poem":1},{"lineBreak":true},{"text":"N bɔɲɛn nun n fati bɛndɛn sɛwa bɛtin bama","poem":1},{"lineBreak":true},{"text":"Habadan Ala xinla nan ma fe ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hali tuntunne bata e tɛɛne sa i ya banxini,","poem":1},{"lineBreak":true},{"text":"debelenne fan bata na findi e konna ra,","poem":1},{"lineBreak":true},{"text":"alogo e diine xa maso i ya saraxa ganden na","poem":1},{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"n ma mangan nun n ma Ala.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sɛwan na kanne xa","poem":1},{"lineBreak":true},{"text":"naxanye luma i ya banxini!","poem":1},{"lineBreak":true},{"text":"E i matɔxɔma nɛn waxatin birin!","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sɛwan na kanne xa","poem":1},{"lineBreak":true},{"text":"naxanye sɛnbɛn kelima i tan yi,","poem":1},{"lineBreak":true},{"text":"naxanye xun tixi Ala Batu Banxin na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E nɛma danguma Baka lanbanni,","poem":1},{"lineBreak":true},{"text":"mɛnna yi lu e xa alo tigi yirene.","poem":1},{"lineBreak":true},{"text":"Tule singen na fa, darane yi fe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E sɛnbɛn yi siga fari sɛ,","poem":1},{"lineBreak":true},{"text":"han e yi ti Ala yɛtagi Siyon yi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, Ala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"n ma maxandi xuiin namɛ.","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala, i tuli mati n na.","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ala, nxɔ mangan mato,","poem":1},{"lineBreak":true},{"text":"nxu yɛ masansan wure lefana.","poem":1},{"lineBreak":true},{"text":"I ya muxu sugandixin nasuxu!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Soge kedenna i Batu Banxini,","poem":1},{"lineBreak":true},{"text":"na dangu xii wuli keden na yire gbɛtɛ yi.","poem":1},{"lineBreak":true},{"text":"A fisa n xa lu tixi i ya banxin so dɛɛn na gbansan","poem":1},{"lineBreak":true},{"text":"benun n xa sabati muxu ɲaxine konne yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Marigina Alatala luxi nɛn en xa","poem":1},{"lineBreak":true},{"text":"alo en ma sogen nun en yɛ masansan wure lefana.","poem":1},{"lineBreak":true},{"text":"Alatala nan hinanna nun binyen fima en ma.","poem":1},{"lineBreak":true},{"text":"Naxanye sigati kii kamalixi,","poem":1},{"lineBreak":true},{"text":"a hɛrin fima nɛn ne ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna,","poem":1},{"lineBreak":true},{"text":"sɛwan na kanne xa","poem":1},{"lineBreak":true},{"text":"naxanye e yigin sama i tan yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":13}