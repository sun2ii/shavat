{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":85,"content":[{"type":"heading","content":["Ala xa bɔɲɛ xunbenla fi en ma"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine tantun bɛtina, bɛti baane kuntigin xa.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i bata yi hinan i ya yamanan na.","poem":1},{"lineBreak":true},{"text":"I bata yi Yaxuba bɔnsɔnna sɛnbɛ so.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bata yi i ya muxune hakɛne mafelu,","poem":1},{"lineBreak":true},{"text":"i yi e yulubine xafari.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":4,"content":[{"text":"I bata yi i ya xɔlɔn ɲan,","poem":1},{"lineBreak":true},{"text":"i yi xɛtɛ i ya xɔlɔ gbeen fɔxɔ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ala, nxu rakisi muxuna,","poem":1},{"lineBreak":true},{"text":"i mɔn xa nxu sɛnbɛ so.","poem":1},{"lineBreak":true},{"text":"I nama fa lu xɔlɛ nxu ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I luma xɔlɔxi nxu ma nɛn ba","poem":1},{"lineBreak":true},{"text":"han habadan?","poem":1},{"lineBreak":true},{"text":"I ya xɔlɔn luma nɛn","poem":1},{"lineBreak":true},{"text":"han mayixɛtɛ nun mayixɛtɛ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I mi fa nxu rakisima ba,","poem":1},{"lineBreak":true},{"text":"alogo i ya yamaan mɔn xa sɛwa i ya fe ra?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, hinan nxu ra,","poem":1},{"lineBreak":true},{"text":"i yi nxu rakisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"N waxi n tuli mati feni Ala ra, Alatala.","poem":1},{"lineBreak":true},{"text":"A bɔɲɛ xunbenla nan ma fe falama a yamaan xa,","poem":1},{"lineBreak":true},{"text":"a muxu tɔgɔndiyaxine,","poem":1},{"lineBreak":true},{"text":"xa e mi fa xɛtɛ e xaxilitareyaan ma sɔnɔn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A fama a yɛɛragaxu muxune rakisideni iki sa!","poem":1},{"lineBreak":true},{"text":"A binyen yi lu en ma yamanani.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hinanna nun lannayana e bode xɔn ma.","poem":1},{"lineBreak":true},{"text":"Tinxinyaan nun bɔɲɛ xunbenla yi rakafu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lannayaan sabatima nɛn bɔxɔni,","poem":1},{"lineBreak":true},{"text":"tinxinna yi godo keli kore.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala hɛrin fima nɛn en ma yati,","poem":1},{"lineBreak":true},{"text":"en ma bɔxɔn sansine yi sabati.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tinxinyaan tima nɛn Marigin yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"a kirani tɔn a xa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}