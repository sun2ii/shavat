{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":86,"content":[{"type":"heading","content":["Ala maxandina malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa Ala maxandina.","descriptive":true},{"text":"Alatala, i tuli mati n na,","poem":1},{"lineBreak":true},{"text":"i yi n yabi.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ yiigelitɔɔn nun tɔrɔ muxun nan n na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N niin natanga,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n tɔgɔndiyaxi i ma.","poem":1},{"lineBreak":true},{"text":"I tan n ma Ala, i ya walikɛɛn nakisi,","poem":1},{"lineBreak":true},{"text":"naxan a yigi saxi i tan yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N Marigina, kininkinin n ma!","poem":1},{"lineBreak":true},{"text":"N fɛriɲɛnma i tan nan maxandɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Marigina, i ya walikɛɛn nasɛwa,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ n na n niin taxuxi i tan nan na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Marigina, i tan fan! I diɲa!","poem":1},{"lineBreak":true},{"text":"Naxan na i maxandi,","poem":1},{"lineBreak":true},{"text":"i hinanma nɛn na ra han!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala, i tuli mati n ma maxandi xuiin na,","poem":1},{"lineBreak":true},{"text":"n ma mawuga xuiin namɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N nɛma tɔrɔni,","poem":1},{"lineBreak":true},{"text":"n yi i maxandi,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i yabin tima.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Marigina, ala yo mi luxi alo i tan.","poem":1},{"lineBreak":true},{"text":"I ya wanle ɲɔxɔn mi na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Marigina, i siyaan naxanye birin daxi,","poem":1},{"lineBreak":true},{"text":"ne fama nɛn,","poem":1},{"lineBreak":true},{"text":"e yi e xinbi sin i yɛtagi,","poem":1},{"lineBreak":true},{"text":"e yi i xinla binya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Amasɔtɔ i tan gbo,","poem":1},{"lineBreak":true},{"text":"i kabanako feene rabama.","poem":1},{"lineBreak":true},{"text":"I tan keden peen nan Ala ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alatala, i ya kiraan yita n na","poem":1},{"lineBreak":true},{"text":"alogo n xa sigan ti i ya ɲɔndini.","poem":1},{"lineBreak":true},{"text":"Na fe keden peen sa n bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"alogo n xa i xinla binya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Marigina, n ma Ala,","poem":1},{"lineBreak":true},{"text":"n ni i tantunma nɛn n bɔɲɛn ma feu!","poem":1},{"lineBreak":true},{"text":"N yi i xinla binya habadan!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I bata hinan n na han!","poem":1},{"lineBreak":true},{"text":"I yi n niin natanga sayaan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ala, wasodene bata keli n xili ma,","poem":1},{"lineBreak":true},{"text":"gbalotɔ ganla waxi n faxa feni,","poem":1},{"lineBreak":true},{"text":"e miriya yo mi sigama i tan ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Koni Marigina, i tan nan Ala ra","poem":1},{"lineBreak":true},{"text":"naxan kininkinin,","poem":1},{"lineBreak":true},{"text":"i diɲa, i mi xɔlɔn xulɛn,","poem":1},{"lineBreak":true},{"text":"i ya hinanna nun i ya lannayaan gbo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I yɛɛ rafindi n ma,","poem":1},{"lineBreak":true},{"text":"i yi hinan n na.","poem":1},{"lineBreak":true},{"text":"Sɛnbɛn fi n ma, n tan i ya walikɛna.","poem":1},{"lineBreak":true},{"text":"N nakisi, n tan i ya walikɛ ɲaxanla diina.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A yita n na, a i fan,","poem":1},{"lineBreak":true},{"text":"alogo naxanye n naɲaxuxi,","poem":1},{"lineBreak":true},{"text":"ne xa a to, e yagi.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ i tan Alatala bata n mali,","poem":1},{"lineBreak":true},{"text":"i yi n madɛndɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}