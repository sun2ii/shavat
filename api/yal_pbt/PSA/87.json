{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"heading","content":["Siyane birin yigin Yerusalɛn nin"]},{"type":"verse","number":1,"content":[{"text":"Koraa diine tantun bɛtina. Sigi sariɲanxina.","descriptive":true},{"text":"Ala bata a taan ti Geya Sariɲanxin fari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siyon taan nafan Alatala ma","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔnna taane birin xa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muxune Alaa taan matɔxɔma han!","poem":1},"Bɛti xuini te."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ala naxa,","poem":1},{"lineBreak":true},{"text":"“N Misiran kaane nun Babilɔn kaane sama nɛn","poem":1},{"lineBreak":true},{"text":"n kolon muxune fari e nun Filisiti kaane","poem":1},{"lineBreak":true},{"text":"nun Tire kaane nun Kusi kaane.”","poem":1},{"lineBreak":true},{"text":"N yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“Itoe fan barixi Siyon taan nin.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E a falama nɛn Siyon taan ma","poem":1},{"lineBreak":true},{"text":"fa fala siyani itoe fan barixi mɛnna nin,","poem":1},{"lineBreak":true},{"text":"Kore Xɔnna Ala yɛtɛɛn yi a rasabati.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala na siyane xinle sɛbɛ,","poem":1},{"lineBreak":true},{"text":"a a falama nɛn ndee ma, a naxa,","poem":1},{"lineBreak":true},{"text":"“Itoe fan barixi Siyon taan nin.”","poem":1},"Bɛti xuini te."]},{"type":"verse","number":7,"content":[{"text":"E bodonma nɛn, e bɛtin ba.","poem":1},{"lineBreak":true},{"text":"E naxa, “Nxu yigin birin i tan nin.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}