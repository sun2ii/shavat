{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":88,"content":[{"type":"heading","content":["Mawugana malina fe ra"]},{"type":"verse","number":1,"content":[{"text":"Sigi sariɲanxina. Koraa diine tantun bɛtina, bɛti baane kuntigin xa. A xa ba xulenna ra. Esira yixɛtɛna nde Heman ma fala ɲaxumɛna.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, Ala naxan n nakisima,","poem":1},{"lineBreak":true},{"text":"kɔɛɛn nun yanyin na,","poem":1},{"lineBreak":true},{"text":"n gbelegbelema i tan nan na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma maxandi xuiin xa i li.","poem":1},{"lineBreak":true},{"text":"I tuli mati n ma mawuga xuiin na!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tɔrɔ wuyaxi bata n niini li,","poem":1},{"lineBreak":true},{"text":"sayaan bata maso n na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"E n yatɛma","poem":1},{"lineBreak":true},{"text":"alo naxanye sigama gaburun na.","poem":1},{"lineBreak":true},{"text":"N fangan birin bata ɲan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E bata n nabeɲin faxa muxune yɛ,","poem":1},{"lineBreak":true},{"text":"alo muxu faxaxine gaburun na,","poem":1},{"lineBreak":true},{"text":"alo i bata ɲinan naxanye xɔn,","poem":1},{"lineBreak":true},{"text":"i mi fa sese ligama naxanye xa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bata n woli ayi bilingan tilinxin na dimi gbeeni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I ya xɔlɔn bata gbo ayi n ma,","poem":1},{"lineBreak":true},{"text":"i n yigbɛtɛnma i sɛnbɛn na.","poem":1},"Bɛti xuini te."]},{"type":"verse","number":9,"content":[{"text":"I bata n xɔyine makuya n na,","poem":1},{"lineBreak":true},{"text":"i bata n findi se ɲaxin na e yɛɛ ra yi.","poem":1},{"lineBreak":true},{"text":"N balanxi, n mi nɔɛ minɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N yɛɛne bata wasa tɔrɔn na,","poem":1},{"lineBreak":true},{"text":"n ni i xilima lɔxɔ yo lɔxɔ,","poem":1},{"lineBreak":true},{"text":"Alatala, n na n yiine yibandunma i tan nan ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I kabanako feen ligɛ faxa muxune xa ba?","poem":1},{"lineBreak":true},{"text":"Faxa muxune kelɛ ba,","poem":1},{"lineBreak":true},{"text":"e yi i tantun?","poem":1},"Bɛti xuini te."]},{"type":"verse","number":12,"content":[{"text":"Muxuna i ya hinanna fe falɛ gaburun kui ba?","poem":1},{"lineBreak":true},{"text":"I ya lannayana fe falɛ halagi yireni ba?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I ya kabanako feene toɛ dimini ba?","poem":1},{"lineBreak":true},{"text":"Ɲinan tima binbine xɔn dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"i ya tinxinyaan kolonɲɛ mɛnni ba?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatala, n bata i xili, n mali.","poem":1},{"lineBreak":true},{"text":"N ni i maxandima xɔtɔn yo xɔtɔn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alatala, nanfera i i mɛxi n na?","poem":1},{"lineBreak":true},{"text":"Nanfera i i yɛtagi luxunxi n ma?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Xabu n dii ɲɔrɛna,","poem":1},{"lineBreak":true},{"text":"n yi tɔrɔni.","poem":1},{"lineBreak":true},{"text":"N yi masoxi sayaan na.","poem":1},{"lineBreak":true},{"text":"Gaxun bata n yili,","poem":1},{"lineBreak":true},{"text":"n yigitɛgɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I ya xɔlɔ gbeen bata godo n ma.","poem":1},{"lineBreak":true},{"text":"I n kuisan gbeen naxan ti,","poem":1},{"lineBreak":true},{"text":"na bata n halagi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kuisanne n nabilinxi waxatin birin","poem":1},{"lineBreak":true},{"text":"alo fufana, e bata n nabilin yiren birin yi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I bata n lanfane nun n xɔyine makuya n na.","poem":1},{"lineBreak":true},{"text":"N fa dimin nan tun kolon.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":19}