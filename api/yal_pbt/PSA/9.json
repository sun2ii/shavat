{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":9,"content":[{"type":"heading","content":["Barika birana Ala xa"]},{"type":"verse","number":1,"content":[{"text":"Dawudaa bɛtina, bɛti baane kuntigin xa. A xa ba alo “Dii Xɛmɛ Faxan” bɛtina.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n ni i tantunma nɛn n bɔɲɛn ma feu!","poem":1},{"lineBreak":true},{"text":"N ni i ya kabanako feene yɛbama nɛn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ɲaxanma nɛn n sɛwa i ya fe ra.","poem":1},{"lineBreak":true},{"text":"Kore Xɔnna Ala,","poem":1},{"lineBreak":true},{"text":"n tantun bɛtin bama i xa nɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yaxune xɛtɛma e giyɛ nɛn i yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"e dagalanɲɛ ayi, e ɲan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bayo i bata n xun mayɛngɛ kitin bolon,","poem":1},{"lineBreak":true},{"text":"i bata dɔxɔ i ya mangaya gbɛdɛni,","poem":1},{"lineBreak":true},{"text":"i yi kitin sa tinxinni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I bata falan ti siya gbɛtɛne xili ma,","poem":1},{"lineBreak":true},{"text":"i mɔn yi muxu ɲaxine raxɔri,","poem":1},{"lineBreak":true},{"text":"muxe mi fa e mirima e xinle ma sɔnɔn habadan!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yaxune bata ɲan fefe,","poem":1},{"lineBreak":true},{"text":"i bata e taane kala.","poem":1},{"lineBreak":true},{"text":"Ɲinan bata ti e ma feu!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Koni Alatala nan mangan na habadan,","poem":1},{"lineBreak":true},{"text":"a mangaya gbɛdɛn dɔxi kiti sa xinla ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A dunuɲa makitima tinxinni.","poem":1},{"lineBreak":true},{"text":"A sariya kɛndɛn sama yamane xa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muxu yigbɛtɛnxine faran makantanxin nan Alatala ra,","poem":1},{"lineBreak":true},{"text":"e luxundena tɔrɔ waxatine yi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naxanye i tan kolon,","poem":1},{"lineBreak":true},{"text":"ne e yigi sama i yi nɛn,","poem":1},{"lineBreak":true},{"text":"bayo naxan na i fen,","poem":1},{"lineBreak":true},{"text":"Alatala, i mi i mɛ na ra mumɛ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɛ Alatala tantun bɛtin na,","poem":1},{"lineBreak":true},{"text":"naxan dɔxi Siyon yi, a manga taani!","poem":1},{"lineBreak":true},{"text":"Ɛ a wali faɲine rali siyane ma!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ala nan wuli bɔxɔnxin gbeeɲɔxɔ tiin na.","poem":1},{"lineBreak":true},{"text":"A mi ɲinanɲɛ a xɔn ma.","poem":1},{"lineBreak":true},{"text":"A yengi dɔxi yiigelitɔne wuga xuiin xɔn ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatala, kininkinin n ma!","poem":1},{"lineBreak":true},{"text":"A mato","poem":1},{"lineBreak":true},{"text":"n yaxune n nayarabima kii naxan yi,","poem":1},{"lineBreak":true},{"text":"i tan naxan n bama faxan dɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nanara, n ni i tantunɲɛ Siyon kaane yɛtagi,","poem":1},{"lineBreak":true},{"text":"n yi sɛwa i ya marakisina fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Siyane bata yinla ge,","poem":1},{"lineBreak":true},{"text":"e bira a kui,","poem":1},{"lineBreak":true},{"text":"e bata e suxu e yɛtɛ luti ratixine ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala bata a yɛtɛ yita a kiti kɛndɛne xɔn ma.","poem":1},{"lineBreak":true},{"text":"Muxu ɲaxin tan suxuma a kɛwanle nan na.","poem":1},"Maxase xuina. Bɛti xuini te."]},{"type":"verse","number":18,"content":[{"text":"Muxu ɲaxine sigama laxira yi,","poem":1},{"lineBreak":true},{"text":"e nun siyaan naxanye birin e mɛxi Ala ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ala mi tɔrɔ muxune rabeɲinɲɛ mumɛ!","poem":1},{"lineBreak":true},{"text":"Yiigelitɔne mi yigitɛgɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Alatala, keli!","poem":1},{"lineBreak":true},{"text":"Adamane nama nɔɔn sɔtɔ!","poem":1},{"lineBreak":true},{"text":"Siyane xa makiti i yɛɛ xɔri!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatala, gaxun nagodo e ma!","poem":1},{"lineBreak":true},{"text":"E xa a kolon fa fala daɲɔxɔn nan tun e ra.","poem":1},"Bɛti xuini te."]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}