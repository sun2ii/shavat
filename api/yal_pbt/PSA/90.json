{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":90,"content":[{"type":"heading","content":["Nabi Musaa bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Nabi Musa, Alaa xɛrana maxandina.","descriptive":true},{"text":"Marigina, i tan nan findixi nxu yigiyaden na,","poem":1},{"lineBreak":true},{"text":"keli waxati danguxine ma han habadan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Benun geyane xa da,","poem":1},{"lineBreak":true},{"text":"benun bɔxɔ xɔnna nun dunuɲa yɛtɛɛn xa da,","poem":1},{"lineBreak":true},{"text":"xabu a fɔlɔni, han to,","poem":1},{"lineBreak":true},{"text":"han habadan i tan nan Ala ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I tan nan muxune raxɛtɛma bɛndɛni,","poem":1},{"lineBreak":true},{"text":"i yi a fala, i naxa,","poem":1},{"lineBreak":true},{"text":"“Adamadiine, ɛ xɛtɛ ɛ kelideni.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bayo ɲɛɛ wuli kedenna luxi nɛn i yɛɛ ra yi","poem":1},{"lineBreak":true},{"text":"alo xii keden danguxina,","poem":1},{"lineBreak":true},{"text":"alo kɔɛ kedenna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I tan nan muxun niin bama,","poem":1},{"lineBreak":true},{"text":"a dangu alo xɔtɔn ma xixɔnla,","poem":1},{"lineBreak":true},{"text":"alo sɛxɛn naxan solima.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xɔtɔnni, a ɲingi, a sabati,","poem":1},{"lineBreak":true},{"text":"ɲinbanna na maso,","poem":1},{"lineBreak":true},{"text":"a lisi a ra, a xara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I ya xɔlɔna nxu yigitɛgɛma nɛn,","poem":1},{"lineBreak":true},{"text":"a yi nxu ɲan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I bata nxu hakɛne sa i yɛtagi.","poem":1},{"lineBreak":true},{"text":"I bata nxɔ wundo yulubine birin sa kɛnɛnni.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nxu siin ɲanma nɛn i ya xɔlɔn bun ma.","poem":1},{"lineBreak":true},{"text":"Nxu nxɔ siimayaan toon ɲanɲɛ","poem":1},{"lineBreak":true},{"text":"alo kutunna.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yanyina nde nxɔ siimayana,","poem":1},{"lineBreak":true},{"text":"ɲɛɛ tonge solofere nan tun a ra.","poem":1},{"lineBreak":true},{"text":"Xa a xunkuya ayi,","poem":1},{"lineBreak":true},{"text":"ɲɛɛ tonge solomasɛxɛ.","poem":1},{"lineBreak":true},{"text":"Koni lanbaranna nun tɔrɔn nan ne birin na.","poem":1},{"lineBreak":true},{"text":"A ɲanma nɛn xulɛn, nxu faxa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nde nɔɛ i ya xɔlɔn sɛnbɛn kolonɲɛ,","poem":1},{"lineBreak":true},{"text":"a yi i binya","poem":1},{"lineBreak":true},{"text":"lan i ya xɔlɔn yatɛn ma?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nxu xaran nxɔ siimayaan tɛngɛ,","poem":1},{"lineBreak":true},{"text":"alogo nxu xa sigan ti fe kolonni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alatala, i ya xɔlɔn ɲanma waxatin mundun yi?","poem":1},{"lineBreak":true},{"text":"Kininkinin nxu tan i ya konyine ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nxu ralugo i ya hinanni xɔtɔn yo xɔtɔn.","poem":1},{"lineBreak":true},{"text":"Nanara, nxu bɛtin bɛ,","poem":1},{"lineBreak":true},{"text":"nxu sɛwa nxu siin birin yi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nxu bata lu yagini waxati xunkuye.","poem":1},{"lineBreak":true},{"text":"Awa, iki sɛwa ɲɛɛne fi nxu ma","poem":1},{"lineBreak":true},{"text":"nxu naxan xasabi ligaxi tɔrɔni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nxu tan i ya konyine xa i ya wali gbeene to.","poem":1},{"lineBreak":true},{"text":"Nxɔ diine xa i ya binye magaxuxin to.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Marigina nxɔ Ala,","poem":1},{"lineBreak":true},{"text":"i ya fanna xa lu nxu xɔn.","poem":1},{"lineBreak":true},{"text":"Nxɔ wanle rasɔnɔya nxu xa,","poem":1},{"lineBreak":true},{"text":"yandi nxɔ wanle rasɔnɔya nxu xa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}