{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":91,"content":[{"type":"heading","content":["Ala nan en yigiya kɛndɛn na"]},{"type":"verse","number":1,"content":[{"text":"Naxan na yigiya Kore Xɔnna Ala ma,","poem":1},{"lineBreak":true},{"text":"na bata lu Ala Sɛnbɛ Kanna makantanna bun.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na a falama Alatala xa nɛn, n naxa,","poem":1},{"lineBreak":true},{"text":"“N yigiyaden nun n kantan yinna nan i tan na.","poem":1},{"lineBreak":true},{"text":"N ma Ala nan i tan na","poem":1},{"lineBreak":true},{"text":"n yigin saxi naxan yi.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A i ratangama nɛn luti ratixine birin ma,","poem":1},{"lineBreak":true},{"text":"e nun faxa furene.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A i ratangama nɛn,","poem":1},{"lineBreak":true},{"text":"i yi i luxun a yi,","poem":1},{"lineBreak":true},{"text":"alo tɔxɛ ngana a gabutɛne soma","poem":1},{"lineBreak":true},{"text":"a diine xun na kii naxan yi.","poem":1},{"lineBreak":true},{"text":"A lannayaan yi findi i yɛ masansan wure lefaan na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I mi gaxun kɔɛɛn gbalon yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"hanma xalimakunla","poem":1},{"lineBreak":true},{"text":"naxanye wolima yanyin na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I mi gaxuɛ fitina furene yɛɛ ra","poem":1},{"lineBreak":true},{"text":"naxanye i lima dimini,","poem":1},{"lineBreak":true},{"text":"hanma fure ɲaxin naxanye faxan tima yanyin na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Muxu wuli kedenna faxama nɛn i dɛxɔn ma,","poem":1},{"lineBreak":true},{"text":"muxu wuli fu yi bira i rabilinni,","poem":1},{"lineBreak":true},{"text":"koni fefe mi ligɛ i tan na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I i yɛɛn tima nɛn tun,","poem":1},{"lineBreak":true},{"text":"i yi muxu ɲaxine saranna to.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N bata n yigiya i tan ma Alatala.","poem":1},{"lineBreak":true},{"text":"I na Kore Xɔnna Ala findi i luxunden na,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"fe ɲaxi yo mi i liyɛ.","poem":1},{"lineBreak":true},{"text":"Gbalo yo mi masoɛ i konna ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala yamarin fima nɛn a malekane ma i ya fe yi","poem":1},{"lineBreak":true},{"text":"alogo e xa i kantan i ya sigatiin birin yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E yi i tongo","poem":1},{"lineBreak":true},{"text":"alogo i nama i sanna din gɛmɛ yo ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I tima yatane nun saɲine fari nɛn.","poem":1},{"lineBreak":true},{"text":"I yi yata sɛnbɛmane nun saɲi ɲaxine yibodon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala naxa, “N na kanna rakisima nɛn","poem":1},{"lineBreak":true},{"text":"bayo a n xanuxi.","poem":1},{"lineBreak":true},{"text":"N na ratangama nɛn","poem":1},{"lineBreak":true},{"text":"bayo a n kolon Ala ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A na n xili, n na a yabima nɛn.","poem":1},{"lineBreak":true},{"text":"N luma a xɔn ma nɛn tɔrɔni.","poem":1},{"lineBreak":true},{"text":"N na a xunbama nɛn,","poem":1},{"lineBreak":true},{"text":"n yi binyen sa a ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N yi siimaya xunkuye faɲin fi a ma,","poem":1},{"lineBreak":true},{"text":"n yi a yita a ra","poem":1},{"lineBreak":true},{"text":"a n tan nan a rakisima.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}