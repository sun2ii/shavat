{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":92,"content":[{"type":"heading","content":["Tantun bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Tantun bɛtina. Sigi sariɲanxina. A xa ba Matabu Lɔxɔni.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"A lan Alatala yi tantun.","poem":1},{"lineBreak":true},{"text":"Kore Xɔnna Ala,","poem":1},{"lineBreak":true},{"text":"a lan bɛtin xa ba i xa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"i ya hinanna fe yi fala xɔtɔn yo xɔtɔn,","poem":1},{"lineBreak":true},{"text":"i ya tinxinna fe yi fala kɔɛ yo kɔɛ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"bɛtine yi ba i xa kondenna nun bɔlɔn xuiin na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, i kɛwanle bata n nasɛwa.","poem":1},{"lineBreak":true},{"text":"N sɛwa bɛtin bama nɛn i ya wanle fe ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala, i ya wanle gbo de!","poem":1},{"lineBreak":true},{"text":"I miriyane tilin han!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xaxilitaren mi ito kolon.","poem":1},{"lineBreak":true},{"text":"Daxun mi ito famuma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fa fala, muxu ɲaxin kelima nɛn","poem":1},{"lineBreak":true},{"text":"alo sɛxɛ ɲaxina,","poem":1},{"lineBreak":true},{"text":"fe ɲaxi rabane birin sabatima nɛn,","poem":1},{"lineBreak":true},{"text":"koni habadan halagin nan e yɛɛ ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Amasɔtɔ i tan Alatala nan feen birin xun na habadan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I yaxune ni i ra, Alatala,","poem":1},{"lineBreak":true},{"text":"i yaxune ni i ra, e halagima!","poem":1},{"lineBreak":true},{"text":"Fe ɲaxi rabane birin xuyama ayi nɛn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I bata n sɛnbɛn gbo ayi","poem":1},{"lineBreak":true},{"text":"alo burunna ɲingena,","poem":1},{"lineBreak":true},{"text":"i yi ture faɲin susan n ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N na n yɛngɛfane yarabixin toma.","poem":1},{"lineBreak":true},{"text":"N na n yaxune wuga xuiin mɛma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Koni tinxin muxune sabatima nɛn","poem":1},{"lineBreak":true},{"text":"alo tugu binla.","poem":1},{"lineBreak":true},{"text":"E sɛnbɛn gboma ayi nɛn","poem":1},{"lineBreak":true},{"text":"alo suman binle Liban yamanani","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"alo wudin naxanye sixi Alatalaa banxini.","poem":1},{"lineBreak":true},{"text":"E sabatima nɛn en ma Alaa banxini.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"E mɔn bogima","poem":1},{"lineBreak":true},{"text":"hali e to bata kɔxɔ.","poem":1},{"lineBreak":true},{"text":"E rafexi igen na, e xinde.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Na bata Alatalaa tinxinna yita.","poem":1},{"lineBreak":true},{"text":"A tan nan n kantan fanyen na,","poem":1},{"lineBreak":true},{"text":"fe ɲaxi yo mi a tan yi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}