{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":93,"content":[{"type":"heading","content":["Ala nan mangan na"]},{"type":"verse","number":1,"content":[{"text":"Alatala nan mangan na,","poem":1},{"lineBreak":true},{"text":"a rabilinxi nɔrɔn nun fangan nan na.","poem":1},{"lineBreak":true},{"text":"Nanara, bɔxɔn dɔxi ken,","poem":1},{"lineBreak":true},{"text":"a mi yigisanma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ala, xabu a fɔlɔni,","poem":1},{"lineBreak":true},{"text":"i ya mangayaan na.","poem":1},{"lineBreak":true},{"text":"I na yi habadan!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala, baane e xuini tema,","poem":1},{"lineBreak":true},{"text":"baane e xuini tema han!","poem":1},{"lineBreak":true},{"text":"Baane bata walanɲɛ ayi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala sɛnbɛn gbo kore xɔnna ma!","poem":1},{"lineBreak":true},{"text":"A gbo fɔxɔ igen mɔrɔnne xa.","poem":1},{"noteId":7},{"lineBreak":true},{"text":"A dangu fɔxɔ igen xunfan gbeen na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, i ya maxadi xuine luma nɛn habadan!","poem":1},{"lineBreak":true},{"text":"Sariɲanna lanxi i ya banxin nan ma, han habadan!","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"93.4Igen mɔrɔnne:alo foyen na so igeni.","reference":{"chapter":93,"verse":4}}]},"thisChapterLink":"/api/yal_pbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}