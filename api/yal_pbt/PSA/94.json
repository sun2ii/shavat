{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":94,"content":[{"type":"heading","content":["Ala nan birin ma kitisaan na"]},{"type":"verse","number":1,"content":[{"text":"Ala naxan gbeeɲɔxɔ tiin na, Alatala,","poem":1},{"lineBreak":true},{"text":"i tan Ala naxan gbeeɲɔxɔ tiin na,","poem":1},{"lineBreak":true},{"text":"i xa i yɛtɛ makɛnɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dunuɲa kitisana, keli,","poem":1},{"lineBreak":true},{"text":"i yi wasodene saran e kɛwanle ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala, muxu ɲaxine luma ɲaxanɲɛ","poem":1},{"lineBreak":true},{"text":"han waxatin mundun yi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fe ɲaxi rabane e yɛtɛ matɔxɔma kanba falane yi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, e bata i ya muxune yigbɛtɛn.","poem":1},{"lineBreak":true},{"text":"E bata i ya yamaan nayarabi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E kaɲa gilɛne nun kiridine nun xɔɲɛne faxama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E yi a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"“Alatala mi nxu toma.","poem":1},{"lineBreak":true},{"text":"Yaxubaa Ala mi a ɲɔxɔ luxi a xɔn.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ɛ a liga ɛ yeren ma","poem":1},{"lineBreak":true},{"text":"ɛ tan xaxilitarene,","poem":1},{"lineBreak":true},{"text":"ɛ tan daxune,","poem":1},{"lineBreak":true},{"text":"ɛ xaxili sɔtɔma waxatin mundun?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala naxan en tunle rafalaxi,","poem":1},{"lineBreak":true},{"text":"a tan mi fala xuiin mɛma ba?","poem":1},{"lineBreak":true},{"text":"Ala naxan en yɛɛne rafalaxi,","poem":1},{"lineBreak":true},{"text":"a tan mi toon tiin ba?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A tan naxan siyane birin xuruma,","poem":1},{"lineBreak":true},{"text":"a mi e fe saranma e ra ba,","poem":1},{"lineBreak":true},{"text":"a tan naxan muxune xaranma fe kolonna ma?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala muxune miriyane kolon,","poem":1},{"lineBreak":true},{"text":"a sese mi ne ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alatala, sɛwan na kanna xa","poem":1},{"lineBreak":true},{"text":"i naxan xuruma,","poem":1},{"lineBreak":true},{"text":"i naxan xaranma i ya sariyan xɔn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I matabun fi a ma tɔrɔ lɔxɔne yi,","poem":1},{"lineBreak":true},{"text":"han yinli ge muxu ɲaxine yɛɛ ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala mi a muxune rabeɲinma,","poem":1},{"lineBreak":true},{"text":"a mi a mɛma a kɛɛn na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kitine mɔn sama nɛn tinxinni,","poem":1},{"lineBreak":true},{"text":"sɔndɔmɛ faɲi kanne birin tinma nɛn na ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nde tiyɛ n xɔn muxu ɲaxine xili ma?","poem":1},{"lineBreak":true},{"text":"Nde kelɛ,","poem":1},{"lineBreak":true},{"text":"a ti n xɔn fe ɲaxi rabane xili ma?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xa Alatala mi yi n mali nun,","poem":1},{"lineBreak":true},{"text":"n niin yi bama nɛn mafurɛn!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N to yi a falama, n naxa,","poem":1},{"lineBreak":true},{"text":"“N birama nɛn!”","poem":1},{"lineBreak":true},{"text":"Alatala, i yi n mali i ya hinanni.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N na kuisan,","poem":1},{"lineBreak":true},{"text":"i ya hinanna n niin lugoma nɛn sɛwan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I mako mi kitisa tinxintarene ma,","poem":1},{"lineBreak":true},{"text":"naxanye muxune ɲaxankatama e tɔnne yi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"E e malanma tinxin muxune xili ma,","poem":1},{"lineBreak":true},{"text":"e yi sɔntarene yalagi, e faxa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Koni Alatala bata findi n ma faran makantanxin na.","poem":1},{"lineBreak":true},{"text":"N ma Ala nan n kantan fanyen na","poem":1},{"lineBreak":true},{"text":"n nan n luxunma naxan yi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A e hakɛne saranma e ra nɛn.","poem":1},{"lineBreak":true},{"text":"Alatala en ma Ala e raxɔrima nɛn e fe ɲaxine ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}