{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":95,"content":[{"type":"heading","content":["Tantun bɛtina"]},{"type":"verse","number":1,"content":[{"text":"Ɛ fa, en xa fa sɛwa bɛtin ba Alatala xa!","poem":1},{"lineBreak":true},{"text":"En sɔnxɔ sɛwani Ala xa,","poem":1},{"lineBreak":true},{"text":"en kantan fanyena, en nakisimana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"En fa a yɛtagi, en barikan bira a xa.","poem":1},{"lineBreak":true},{"text":"En yi a tantun sɛwa bɛtine yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amasɔtɔ Alatala nan Ala gbeen na.","poem":1},{"lineBreak":true},{"text":"A tan nan manga gbeena alane birin xun na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A tan nan gbee bɔxɔn bunne nun geyane xuntagine ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A tan nan gbee fɔxɔ igen na,","poem":1},{"lineBreak":true},{"text":"bayo a tan nan a daxi.","poem":1},{"lineBreak":true},{"text":"A tan nan bɔxɔ xɔnna rafalaxi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ fa, en fa en xinbi sin,","poem":1},{"lineBreak":true},{"text":"en yi Ala batu.","poem":1},{"lineBreak":true},{"text":"En xa en xinbi sin Alatala bun","poem":1},{"lineBreak":true},{"text":"naxan en daxi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amasɔtɔ a tan nan en ma Ala ra.","poem":1},{"lineBreak":true},{"text":"En findixi a yamaan nan na","poem":1},{"lineBreak":true},{"text":"alo a xuruse kurun naxan nabama.","poem":1},{"lineBreak":true},{"text":"Xa ɛ Ala fala xuiin mɛ to,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ɛ nama ɛ bɔɲɛni xɔdɔxɔ","poem":1},{"lineBreak":true},{"text":"alo ɛ benbane Meriba yi,","poem":1},{"lineBreak":true},{"text":"alo e naxanye liga na waxatini Masa yi tonbonni.","poem":1},{"noteId":8}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E n matandi nɛn mɛnni,","poem":1},{"lineBreak":true},{"text":"e yi n mato,","poem":1},{"lineBreak":true},{"text":"hali e to bata yi n kɛwanle to.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N xɔlɔ na waxati muxune ma ɲɛɛ tonge naanin,","poem":1},{"lineBreak":true},{"text":"n yi a fala, n naxa,","poem":1},{"lineBreak":true},{"text":"“Yamani ito bɔɲɛn makuya n na,","poem":1},{"lineBreak":true},{"text":"e mi biraxi n ma kiraan fɔxɔ ra.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nayi, n yi n kɔlɔ n ma xɔlɔni n naxa,","poem":1},{"lineBreak":true},{"text":"“E mi soɛ n ma matabudeni mumɛ!”","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"95.8Na fe mɔn sɛbɛxi Xɔrɔyaan 17.7 kui.","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/yal_pbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}