{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":96,"content":[{"type":"heading","content":["Ala nan mangane birin xun na"]},{"type":"verse","number":1,"content":[{"text":"Bɛti nɛnɛn xa ba Alatala xa!","poem":1},{"lineBreak":true},{"text":"Dunuɲa muxune birin xa bɛtin ba Alatala xa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɛtin xa ba Alatala xa,","poem":1},{"lineBreak":true},{"text":"a xinla yi tantun!","poem":1},{"lineBreak":true},{"text":"Ɛ yi lu a raliyɛ waxatin birin yi","poem":1},{"lineBreak":true},{"text":"fa fala a bata en nakisi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ a binyena fe fala siyane birin xa,","poem":1},{"lineBreak":true},{"text":"ɛ yi a kabanako feene rali muxune birin ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala gbo,","poem":1},{"lineBreak":true},{"text":"a lan a xa matɔxɔ han!","poem":1},{"lineBreak":true},{"text":"A lan","poem":1},{"lineBreak":true},{"text":"a xa binya dangu alane birin na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Siyane alane birin findixi ala fuune nan na,","poem":1},{"lineBreak":true},{"text":"koni Alatala tan bata koren da.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A rabilinxi nɔrɔn nun gboon nan na.","poem":1},{"lineBreak":true},{"text":"A yire sariɲanxin nafexi sɛnbɛn nun binyen nan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɛ tan dunuɲa siyane birin,","poem":1},{"lineBreak":true},{"text":"ɛ fa Alatala tantun,","poem":1},{"lineBreak":true},{"text":"ɛ yi a tantun a binyen nun a sɛnbɛna fe ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɛ fa Alatala tantun a xili binyena fe ra.","poem":1},{"lineBreak":true},{"text":"Ɛ fa kiseene ra a Batu Banxini.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɛ Alatala batu a nɔrɔ sariɲanxini.","poem":1},{"lineBreak":true},{"text":"Dunuɲa muxune,","poem":1},{"lineBreak":true},{"text":"ɛ xuruxurun a yɛtagi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛ yi a fala siyane xa,","poem":1},{"lineBreak":true},{"text":"a Alatala nan mangan na.","poem":1},{"lineBreak":true},{"text":"Nanara, dunuɲa a kiini,","poem":1},{"lineBreak":true},{"text":"a mi yigisanma.","poem":1},{"lineBreak":true},{"text":"Ala siyane makitima tinxinna nin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kore xɔnna nun bɔxɔ xɔnna xa sɛwa han!","poem":1},{"lineBreak":true},{"text":"Fɔxɔ igen xa a xuini te","poem":1},{"lineBreak":true},{"text":"e nun seen naxanye a xɔrɛ ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Burunna xa sɛwa e nun a yi seene birin.","poem":1},{"lineBreak":true},{"text":"Fɔtɔnna wudine birin xa sɔnxɔ sɛwani,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"e sɔnxɔ Alatala yɛtagi,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a fama nɛn.","poem":1},{"lineBreak":true},{"text":"A fama nɛn a kitin sa dunuɲa yi.","poem":1},{"lineBreak":true},{"text":"A dunuɲa muxune makitima nɛn tinxinni,","poem":1},{"lineBreak":true},{"text":"a siyane kiti a ɲɔndini.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}