{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":97,"content":[{"type":"heading","content":["Ala nan keden pe mangan na"]},{"type":"verse","number":1,"content":[{"text":"Alatala nan mangan na!","poem":1},{"lineBreak":true},{"text":"Dunuɲa xa ɲaxan!","poem":1},{"lineBreak":true},{"text":"Ɛ sɛwa ɛ tan fɔxɔ ige tagi bɔxɔne!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A rabilinxi kundaan nun dimin nan na.","poem":1},{"lineBreak":true},{"text":"A mangayaan sɛnbɛ soxi tinxinyaan nun sariya kɛndɛn nan na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɛɛna a yɛɛ ra,","poem":1},{"lineBreak":true},{"text":"naxan a yaxune ganma a rabilinni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"A kuyen na a ɲinna masɔxɔn,","poem":1},{"lineBreak":true},{"text":"dunuɲa birin yi yalan.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn yi a to a xuruxurun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Geyane xuyama ayi Alatala yɛtagi,","poem":1},{"lineBreak":true},{"text":"dunuɲa birin Marigina,","poem":1},{"lineBreak":true},{"text":"alo kumi dolen na xulun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Koren xɔnna a tinxinyaan nalima nɛn,","poem":1},{"lineBreak":true},{"text":"siyane birin yi a binyen to.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Suxure batune yagima nɛn,","poem":1},{"lineBreak":true},{"text":"naxanye suxurene matɔxɔma.","poem":1},{"lineBreak":true},{"text":"Alane birin e xinbi sinma nɛn a bun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siyon kaane a mɛma nɛn e sɛwa.","poem":1},{"lineBreak":true},{"text":"Yuda taane yi ɲaxan i ya kiti saxine fe ra, Alatala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, i tan nan Kore Xɔnna Ala ra","poem":1},{"lineBreak":true},{"text":"dunuɲa birin xun na.","poem":1},{"lineBreak":true},{"text":"I tan gbo dangu alane birin na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatala rafan naxanye ma,","poem":1},{"lineBreak":true},{"text":"fe ɲaxin xa raɲaxu ne ma.","poem":1},{"lineBreak":true},{"text":"A tɔgɔndiya muxune kantanma nɛn,","poem":1},{"lineBreak":true},{"text":"a yi e xunba muxu ɲaxine yii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛnɛnna minima nɛn tinxin muxune xa,","poem":1},{"lineBreak":true},{"text":"muxu sɔndɔmɛ faɲine sɛwama nɛn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɛ tan naxanye birin tinxin,","poem":1},{"lineBreak":true},{"text":"ɛ sɛwa Alatala a fe ra,","poem":1},{"lineBreak":true},{"text":"ɛ a xili sariɲanxin tantun.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}