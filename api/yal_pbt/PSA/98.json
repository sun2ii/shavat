{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"PSA","translationId":"yal_pbt","name":"Yaburin Sora","commonName":"Yaburin Sora","title":"Yaburina Nabi Dawudaa Bɛtine","order":19,"numberOfChapters":150,"sha256":"c3e93bbdcb947b4da799aba7ea38658c7a91552dd8413ebd72b09ef0ada8a05b","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yal_pbt/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":98,"content":[{"type":"heading","content":["Ala nan mangan na"]},{"type":"verse","number":1,"content":[{"text":"Tantun bɛtina.","descriptive":true},{"text":"Ɛ bɛti nɛnɛn ba Alatala xa.","poem":1},{"lineBreak":true},{"text":"A bata kabanako feene liga!","poem":1},{"lineBreak":true},{"text":"A en nakisima a sɛnbɛn nun a sariɲanna nan xɔn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala bata a marakisin nun tinxinna yita siyane ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mi ɲinanxi a hinanna nun a tinxinna xɔn","poem":1},{"lineBreak":true},{"text":"Isirayila yamaan xa.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn danne birin bata a to","poem":1},{"lineBreak":true},{"text":"a en ma Ala bata en nakisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dunuɲa muxune birin xa sɔnxɔ sɛwani Alatala xa.","poem":1},{"lineBreak":true},{"text":"Ɛ sɛwaxin yi sɔnxɔ han,","poem":1},{"lineBreak":true},{"text":"ɛ yi a tantun bɛtini!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ tantun bɛtine ba Alatala xa bɔlɔnna ra!","poem":1},{"lineBreak":true},{"text":"Ɛ bɔlɔnna nun tantun bɛti xuini te!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛ xɔtane nun fenne fe.","poem":1},{"lineBreak":true},{"text":"Ɛ sɔnxɔ sɛwani mangan xa, Alatala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fɔxɔ igen xa a xuini te","poem":1},{"lineBreak":true},{"text":"e nun seen naxanye birin a xɔrɛ ra.","poem":1},{"lineBreak":true},{"text":"Dunuɲa muxune birin xa e xuini te.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baane xa e xuini te","poem":1},{"lineBreak":true},{"text":"alo yii bɔnbɔ xuina!","poem":1},{"lineBreak":true},{"text":"Geyane xa sɔnxɔ sɛwani e bode xɔn!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E sɛwa Alatala yɛtagi,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ a fama nɛn.","poem":1},{"lineBreak":true},{"text":"A fama nɛn, a kitine sa dunuɲa yi.","poem":1},{"lineBreak":true},{"text":"A dunuɲa muxune makitima nɛn tinxinni,","poem":1},{"lineBreak":true},{"text":"a siyane kiti a ɲɔndini.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}