neBreak":true},{"text":"I tan nan sariya kɛndɛn","poem":1},{"lineBreak":true},{"text":"nun tinxinna saxi Yaxuba bɔnsɔnni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛ Alatala batu, en ma Ala.","poem":1},{"lineBreak":true},{"text":"Ɛ yi ɛ xinbi sin a manga gbɛdɛn san bun.","poem":1},{"lineBreak":true},{"text":"A sariɲan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nabi Musa nun Haruna yi a saraxaraline yɛ.","poem":1},{"lineBreak":true},{"text":"Samuyɛli yi a maxandi muxune yɛ.","poem":1},{"lineBreak":true},{"text":"E yi Alatala maxandima,","poem":1},{"lineBreak":true},{"text":"a yi e yabi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A yi falan tima e xa nɛn","poem":1},{"lineBreak":true},{"text":"keli kundani.","poem":1},{"lineBreak":true},{"text":"E yi na maxadi xuine nun tɔnne suxuma,","poem":1},{"lineBreak":true},{"text":"a yi naxanye soma e yii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala nxɔ Ala,","poem":1},{"lineBreak":true},{"text":"i tan yɛtɛɛn nan yi e yabima,","poem":1},{"lineBreak":true},{"text":"i findi Ala diɲaxin nan na e xa,","poem":1},{"lineBreak":true},{"text":"koni i e fe ɲaxine saran e ra nɛn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɛ Alatala en ma Ala batu,","poem":1},{"lineBreak":true},{"text":"ɛ xinbi sin a geya sariɲanxin bun.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ Alatala en ma Ala sariɲan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}