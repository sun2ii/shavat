{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"SNG","translationId":"yal_pbt","name":"Marafanna Falane Sora","commonName":"Marafanna Falane Sora","title":"Marafanna Falane Muluku Sulemani Fala Ɲaxumɛn Naxanye Sɛbɛ","order":22,"numberOfChapters":8,"sha256":"4d70675c0995ee9c3aea3f62a093dc87463a1ef26876a02970bfba86f8edc296","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/yal_pbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"heading","content":["Xɛmɛna ɲaxanla luxi nɛn alo a nakɔ yirena"]},{"type":"verse","number":1,"content":[{"text":"I rayabu,","poem":1},{"lineBreak":true},{"text":"n nafan ɲaxanla, i rayabu.","poem":1},{"lineBreak":true},{"text":"I yɛɛne rayabu alo ganbane","poem":1},{"lineBreak":true},{"text":"hali dugin soxi i yɛtagin xun na.","poem":1},{"lineBreak":true},{"text":"I xun sɛxɛn saxi a ma","poem":1},{"lineBreak":true},{"text":"alo sii kurun nɛma godɛ Galadi geyaan ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I ɲinne fixa alo yɛxɛɛ kurun","poem":1},{"lineBreak":true},{"text":"naxan xabe baxi maxabadeni","poem":1},{"lineBreak":true},{"text":"naxanye kelima e maxadeni.","poem":1},{"noteId":2},{"lineBreak":true},{"text":"E lanxi e boden ma firin firin yɛɛn ma","poem":1},{"lineBreak":true},{"text":"alo gulunne, e keden pe mi baxi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I dɛ kidine luxi alo luti gbeela,","poem":1},{"lineBreak":true},{"text":"i dɛɛn tofan han!","poem":1},{"lineBreak":true},{"text":"I xaden nayabu","poem":1},{"lineBreak":true},{"text":"alo girenada wudi bogini xabaxina a tagi","poem":1},{"lineBreak":true},{"text":"hali dugin bata so i yɛtagin xun na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I kɔɛɛn maxidixi","poem":1},{"lineBreak":true},{"text":"alo Dawudaa sangansona,","poem":1},{"lineBreak":true},{"text":"sofane yɛngɛ so wure lefa wuli kedenna singanxi naxan na","poem":1},{"lineBreak":true},{"text":"alo ɲɛrɛna i kɔɛ ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I xiɲɛ firinne rayabu","poem":1},{"lineBreak":true},{"text":"alo bolen dii gulun firinne,","poem":1},{"lineBreak":true},{"text":"naxanye e dɛgema sansi fugaxine tagi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N sigama nɛn na mirihi latikɔnɔnna nun wusulanna yireni","poem":1},{"lineBreak":true},{"text":"han kuye yiba, dimin yi siga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N xanuntenna, i rayabu,","poem":1},{"lineBreak":true},{"text":"fɛ yo mi i ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N ma ɲaxalandi masuxina,","poem":1},{"lineBreak":true},{"text":"fa n fɔxɔ ra","poem":1},{"lineBreak":true},{"text":"keli Liban yamanani Amana geyaan xuntagi,","poem":1},{"lineBreak":true},{"text":"Xerimon geyaan nun Seniri geyaan xuntagi,","poem":1},{"lineBreak":true},{"text":"yatane xiin dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"burunna ɲarine geyane.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I n bɔɲɛn nadinma,","poem":1},{"lineBreak":true},{"text":"i tan sungutunna,","poem":1},{"lineBreak":true},{"text":"n ma ɲaxalan masuxina,","poem":1},{"lineBreak":true},{"text":"i na i yɛɛn ti n na keden pe","poem":1},{"lineBreak":true},{"text":"i n bɔɲɛn nadinma nɛn.","poem":1},{"lineBreak":true},{"text":"Hali i ya ɲɛrɛn xɔri keden pe,","poem":1},{"lineBreak":true},{"text":"a na ligɛ n na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I ya xanuntenyaan ɲaxun,","poem":1},{"lineBreak":true},{"text":"i tan sungutunna,","poem":1},{"lineBreak":true},{"text":"n ma ɲaxalan masuxina,","poem":1},{"lineBreak":true},{"text":"i ya xanuntenyaan ɲaxun","poem":1},{"lineBreak":true},{"text":"dangu manpa faɲin na,","poem":1},{"lineBreak":true},{"text":"i ya latikɔnɔnna xirin ɲaxun","poem":1},{"lineBreak":true},{"text":"dangu se xiri ɲaxumɛne birin na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma ɲaxalan masuxina,","poem":1},{"lineBreak":true},{"text":"i dɛɛn ɲaxun alo kumina,","poem":1},{"lineBreak":true},{"text":"nɔnɔn nun kumin nan i lɛnna bun,","poem":1},{"lineBreak":true},{"text":"i ya dugine xirin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo Liban wudi xiri ɲaxumɛne.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I tan sungutunna,","poem":1},{"lineBreak":true},{"text":"n ma ɲaxalan masuxina,","poem":1},{"lineBreak":true},{"text":"i luxi nɛn alo n ma nakɔ masansanxina,","poem":1},{"lineBreak":true},{"text":"n ma tigina,","poem":1},{"lineBreak":true},{"text":"n ma ige miniden naxan namaraxi n keden peen xa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I fan","poem":1},{"lineBreak":true},{"text":"alo sansi faɲin sixi nakɔɔn naxan yi,","poem":1},{"lineBreak":true},{"text":"alo girenada binla","poem":1},{"lineBreak":true},{"text":"naxanye bogi faɲine raminima,","poem":1},{"lineBreak":true},{"text":"e nun henna binle","poem":1},{"lineBreak":true},{"text":"nun naradi sansi xiri faɲina,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"naradin nun sansi fuge nɛri fuɲiramaan","poem":1},{"lineBreak":true},{"text":"nun gbala xiri ɲaxumɛne","poem":1},{"lineBreak":true},{"text":"nun sinamon wudi xiri ɲaxumɛne,","poem":1},{"lineBreak":true},{"text":"e nun wusulanna kelixi wudin naxanye birin ma","poem":1},{"lineBreak":true},{"text":"e nun mirihi latikɔnɔnna nun wudi ige xiri ɲaxumɛne","poem":1},{"lineBreak":true},{"text":"nun sansi xiri ɲaxumɛ faɲine birin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I luxi nɛn alo nakɔ yi tigina,","poem":1},{"lineBreak":true},{"text":"alo xude xunna naxan godoma","poem":1},{"lineBreak":true},{"text":"keli Liban geyane ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Foye faɲin xa fa","poem":1},{"lineBreak":true},{"text":"sa keli kɔmɛnna nun yiifanna ma,","poem":1},{"lineBreak":true},{"text":"e yi n ma nakɔɔn xiri faɲin nasiga ayi","poem":1},{"lineBreak":true},{"text":"alogo n nafan muxun xa fa so a nakɔni,","poem":1},{"lineBreak":true},{"text":"a yi a bogise faɲine don!","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"4.2Mɛn kaane yɛxɛɛne xabengbo nɛn han! A nɔɛ findɛ dugin na.","reference":{"chapter":4,"verse":2}}]},"thisChapterLink":"/api/yal_pbt/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}