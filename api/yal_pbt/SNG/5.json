{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"SNG","translationId":"yal_pbt","name":"Marafanna Falane Sora","commonName":"Marafanna Falane Sora","title":"Marafanna Falane Muluku Sulemani Fala Ɲaxumɛn Naxanye Sɛbɛ","order":22,"numberOfChapters":8,"sha256":"4d70675c0995ee9c3aea3f62a093dc87463a1ef26876a02970bfba86f8edc296","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/yal_pbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"heading","content":["Xɛmɛna tofanna"]},{"type":"verse","number":1,"content":[{"text":"N fama n ma nakɔni,","poem":1},{"lineBreak":true},{"text":"i tan sungutunna,","poem":1},{"lineBreak":true},{"text":"n ma ɲaxalan masuxina,","poem":1},{"lineBreak":true},{"text":"n xa sa n ma mirihi latikɔnɔnna nun wusulanna ba,","poem":1},{"lineBreak":true},{"text":"n yi n ma kumi dɛngbɛn nun kumin don,","poem":1},{"lineBreak":true},{"text":"n yi n ma manpaan nun n ma nɔnɔn min.","poem":1},{"lineBreak":true},"Xɔyine falana:",{"text":"Nxu xɔyine, ɛ min,","poem":1},{"lineBreak":true},{"text":"ɛ xunne xa magi a ra xanuntenyani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N bata yi xi,","poem":1},{"lineBreak":true},{"text":"koni n bɔɲɛn mi yi xima.","poem":1},{"lineBreak":true},{"text":"N yi n xanuntenna xuiin nan mɛma dɛɛn na.","poem":1},{"lineBreak":true},"Xɛmɛna falana a ɲaxanla xa:",{"text":"Dɛɛn nabi n xa, i tan sungutunna,","poem":1},{"lineBreak":true},{"text":"n ma ɲaxalandi masuxina,","poem":1},{"lineBreak":true},{"text":"n ma ganbadina,","poem":1},{"lineBreak":true},{"text":"fɛ mi ɲaxanla naxan na.","poem":1},{"lineBreak":true},{"text":"Xiila bata n xunni kun","poem":1},{"lineBreak":true},{"text":"n xun sɛxɛn bata yikun kɔɛ ra kundaan bun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N bata n ma domaan ba n ma,","poem":1},{"lineBreak":true},{"text":"n fa a ragodoma n ma di?","poem":1},{"lineBreak":true},{"text":"N baxi n sanne maxadeni nɛn,","poem":1},{"lineBreak":true},{"text":"n fa e malɔxɔma di?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N xanuntenna bata a yiin naso dɛɛn yalenna ra,","poem":1},{"lineBreak":true},{"text":"n fatin yi xuruxurun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N to keli","poem":1},{"lineBreak":true},{"text":"n xa dɛɛn nabi n xanuntenna xa,","poem":1},{"lineBreak":true},{"text":"mirihi latikɔnɔnna yi n yiine nun yii sonle ra,","poem":1},{"lineBreak":true},{"text":"han a lu dindinɲɛ bɔxɔni","poem":1},{"lineBreak":true},{"text":"e nun dɛɛn balan seen ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N yi dɛɛn nabi n xanuntenna xa,","poem":1},{"lineBreak":true},{"text":"koni n xanuntenna bata yi a xun xanbi so,","poem":1},{"lineBreak":true},{"text":"a dangu.","poem":1},{"lineBreak":true},{"text":"A fala xuiin yi godoma n niini,","poem":1},{"lineBreak":true},{"text":"n yi a fen, n mi a to,","poem":1},{"lineBreak":true},{"text":"n yi a xili han,","poem":1},{"lineBreak":true},{"text":"koni a mi n yabi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kantan tiin naxanye taan nabilinma,","poem":1},{"lineBreak":true},{"text":"ne yi fa n li,","poem":1},{"lineBreak":true},{"text":"e yi n bɔnbɔ,","poem":1},{"lineBreak":true},{"text":"e yi n maxɔlɔ,","poem":1},{"lineBreak":true},{"text":"e yi n ma xunbeli domaan ba n ma,","poem":1},{"lineBreak":true},{"text":"e tan naxanye taan nabilinna yinna kantanma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yerusalɛn sungutunne,","poem":1},{"lineBreak":true},{"text":"ɛ kɔlɔ n xa.","poem":1},{"lineBreak":true},{"text":"Xa ɛ n xanuntenna to,","poem":1},{"lineBreak":true},{"text":"ɛ nanse falama a xa?","poem":1},{"lineBreak":true},{"text":"Ɛ a fala a xa, fa fala","poem":1},{"lineBreak":true},{"text":"a fe xanuntenyaan furena n ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I tan ɲaxanla","poem":1},{"lineBreak":true},{"text":"naxan tofan ɲaxanle birin xa","poem":1},{"lineBreak":true},{"text":"i xanuntenna fan e birin xa di?","poem":1},{"lineBreak":true},{"text":"I xanuntenna fisa gbɛtɛye xa kiin mundun yi,","poem":1},{"lineBreak":true},{"text":"naxan a ligaxi i nxu rakɔlɔma na kiini?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N xanuntenna fatin fixa,","poem":1},{"lineBreak":true},{"text":"a gbeeli,","poem":1},{"lineBreak":true},{"text":"a rayabu muxu wuli fuun yɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A xunna luxi alo xɛma kɛndɛna,","poem":1},{"lineBreak":true},{"text":"a xunsɛxɛne saxi a ma,","poem":1},{"lineBreak":true},{"text":"e fɔrɔ alo xaxaan xabena.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yɛɛne rayabu","poem":1},{"lineBreak":true},{"text":"alo ganbane xuden dɛ.","poem":1},{"lineBreak":true},{"text":"E fixa alo nɔnɔna,","poem":1},{"lineBreak":true},{"text":"e mayilenma alo dayimuna.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A xadene luxi","poem":1},{"lineBreak":true},{"text":"alo sansi xiri ɲaxumɛ nakɔna,","poem":1},{"lineBreak":true},{"text":"naxanye xiri ɲaxumɛn tema.","poem":1},{"lineBreak":true},{"text":"A dɛ kidine luxi alo gabala fugene","poem":1},{"lineBreak":true},{"text":"mirihi latikɔnɔnna minima dɛnaxan yi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A yiine rayabu","poem":1},{"lineBreak":true},{"text":"alo yiiraso xɛma daxin","poem":1},{"lineBreak":true},{"text":"naxanye rayabuxi kirisoliti gɛmɛ faɲine ra.","poem":1},{"lineBreak":true},{"text":"A fatin luxi alo sama ɲin xuruxina","poem":1},{"lineBreak":true},{"text":"safiri gɛmɛ faɲin saxin naxan ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A sanne luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo sɛnbɛtɛn gɛmɛ fixɛ daxin","poem":1},{"lineBreak":true},{"text":"naxanye tixi xɛma faɲin fari.","poem":1},{"lineBreak":true},{"text":"A tofan alo Liban yamanana,","poem":1},{"lineBreak":true},{"text":"a tixi alo sumanna.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɲaxunna nan tun a dɛ,","poem":1},{"lineBreak":true},{"text":"a fatin birin nayabu.","poem":1},{"lineBreak":true},{"text":"N xanuntenna na kii nin,","poem":1},{"lineBreak":true},{"text":"n fɔxɔrabiran na kii nin,","poem":1},{"lineBreak":true},{"text":"ɛ tan Yerusalɛn sungutunne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}