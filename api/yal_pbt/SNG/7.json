{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"SNG","translationId":"yal_pbt","name":"Marafanna Falane Sora","commonName":"Marafanna Falane Sora","title":"Marafanna Falane Muluku Sulemani Fala Ɲaxumɛn Naxanye Sɛbɛ","order":22,"numberOfChapters":8,"sha256":"4d70675c0995ee9c3aea3f62a093dc87463a1ef26876a02970bfba86f8edc296","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/yal_pbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"heading","content":["Ɲaxanla nun xɛmɛna xanuntenyana"]},{"type":"verse","number":1,"content":[{"text":"I xun xɛtɛ, i xun xɛtɛ,","poem":1},{"lineBreak":true},{"text":"i tan Sulami kaana!","poem":1},{"lineBreak":true},{"text":"I xun xɛtɛ, i xun xɛtɛ","poem":1},{"lineBreak":true},{"text":"alogo nxu xa i mato.","poem":1},{"lineBreak":true},{"text":"Nanfera i Sulami kaan matoma","poem":1},{"lineBreak":true},{"text":"alo gali firinna nɛma e bodonma?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I sanne rayabu","poem":1},{"lineBreak":true},{"text":"i ya sankidine kui,","poem":1},{"lineBreak":true},{"text":"i tan xɔrɔ ɲaxanla!","poem":1},{"lineBreak":true},{"text":"I danbane rayabu","poem":1},{"lineBreak":true},{"text":"alo yiirafalan ɲɛrɛn naxan nafalaxi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I xuli fundin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo lenge radigilinxina,","poem":1},{"lineBreak":true},{"text":"minse xiri ɲaxumɛn mi ɲanma dɛnaxan yi.","poem":1},{"lineBreak":true},{"text":"I kuiin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo murutu malanxina","poem":1},{"lineBreak":true},{"text":"naxan nabilinxi gabala fugene ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I xiɲɛ firinne luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo bolen dii gulun firinne.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I kɔɛɛn mɛrɛndɛnxi nɛn","poem":1},{"lineBreak":true},{"text":"alo sanganso sama ɲin daxina.","poem":1},{"lineBreak":true},{"text":"I yɛɛne mayilenma","poem":1},{"lineBreak":true},{"text":"alo Xɛsibɔn dara igena,","poem":1},{"lineBreak":true},{"text":"Bati-Rabimi so dɛɛn dɛxɔn.","poem":1},{"lineBreak":true},{"text":"I ɲɔɛɛn fan alo Liban sangansoon","poem":1},{"lineBreak":true},{"text":"naxan tixi Damasi taan binni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I xunna ratinxinxi i gbindin dɛ","poem":1},{"lineBreak":true},{"text":"alo Karemele geyana,","poem":1},{"lineBreak":true},{"text":"i xun sɛxɛne mayilenma","poem":1},{"lineBreak":true},{"text":"alo mangane dugi mamiloxine.","poem":1},{"lineBreak":true},{"text":"Mangan mi nɔɛ a yɛɛn bɛ e ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I rayabu, i tofan han,","poem":1},{"lineBreak":true},{"text":"n xanuntenna, n ma sɛwa xunna.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I kuya alo tugu binla,","poem":1},{"lineBreak":true},{"text":"i xiɲɛne luxi alo tugu bogi tɔnsɔnne.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nanara, n na a falama, n naxa,","poem":1},{"lineBreak":true},{"text":"“N tema nɛn tugu binla kɔɛ ra,","poem":1},{"lineBreak":true},{"text":"n yi a bogine suxu.”","poem":1},{"lineBreak":true},{"text":"I xiɲɛne luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo ɲaxundan tɔnsɔnne,","poem":1},{"lineBreak":true},{"text":"i dɛ foyen xirin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo mangon mɔɛɛn xirina.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I dɛɛn xirin luxi nɛn","poem":1},{"lineBreak":true},{"text":"alo manpa xiri ɲaxumɛna.","poem":1},{"lineBreak":true},"Ɲaxanla falana a xɛmɛn xa:",{"text":"Na manpaan xa lu n xanuntenna nan xa,","poem":1},{"lineBreak":true},{"text":"a godo a dɛ kidine nun a ɲinne ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N xanuntenna nan gbee n na","poem":1},{"lineBreak":true},{"text":"a waxi n tan nan xɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N xanuntenna,","poem":1},{"lineBreak":true},{"text":"fa en siga burunna ra,","poem":1},{"lineBreak":true},{"text":"en kɔɛne radangu banxidɛne ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xɔtɔnni en kurun sigɛ manpa bili nakɔne yi,","poem":1},{"lineBreak":true},{"text":"en sa a mato","poem":1},{"lineBreak":true},{"text":"xa e solima, xa e fugama,","poem":1},{"lineBreak":true},{"text":"xa girenada binle fugama.","poem":1},{"lineBreak":true},{"text":"Mɛnni, n sa n ma xanuntenyaan yita i ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Marafan bogi binle e xiri faɲine raminima,","poem":1},{"lineBreak":true},{"text":"bogise faɲine birin en dɛxɔn.","poem":1},{"lineBreak":true},{"text":"N xanuntenna,","poem":1},{"lineBreak":true},{"text":"n fe faɲine birin namaraxi i tan nan xa","poem":1},{"lineBreak":true},{"text":"a fonne nun a nɛnɛne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":14}