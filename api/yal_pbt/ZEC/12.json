{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ZEC","translationId":"yal_pbt","name":"Nabi Sakari Sora","commonName":"Nabi Sakari Sora","title":"Sakari Nabi Sakari Alaa Falan Naxan Sɛbɛ","order":38,"numberOfChapters":14,"sha256":"d648ce18d94ca0ba4cbc94d99e46b5f0390ce75652db864bcd42f9f476d9a3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/yal_pbt/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":12,"content":[{"type":"heading","content":["Yerusalɛn xunba famatɔna"]},{"type":"verse","number":1,"content":[{"text":"Waliyiya falan ni i ra,","poem":1},{"lineBreak":true},{"text":"Alatala falan naxan tixi Isirayila fe yi.","poem":1},{"lineBreak":true},{"text":"A tan naxan kore xɔnna nun bɔxɔ xɔnna daxi,","poem":1},{"lineBreak":true},{"text":"a yi muxun niin sa a yi,","poem":1},{"lineBreak":true},{"text":"Alatalaa falan ni ito ra:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N Yerusalɛn findima nɛn dɔlɔ min seen na,","poem":1},{"lineBreak":true},{"text":"naxan a rabilinna siyane birin fugama a ra.","poem":1},{"lineBreak":true},{"text":"Yerusalɛn taan nabilinma nɛn yɛngɛni,","poem":1},{"lineBreak":true},{"text":"e nun Yuda yamanan birin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na lɔxɔni, n Yerusalɛn findima nɛn","poem":1},{"lineBreak":true},{"text":"gɛmɛ binyen na siyane birin xa.","poem":1},{"lineBreak":true},{"text":"Naxan yo na kata a yite feen na,","poem":1},{"lineBreak":true},{"text":"na maxɔlɔma nɛn.","poem":1},{"lineBreak":true},{"text":"Bɔxɔn siyane birin e malanma nɛn a xili ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatalaa falan ni ito ra:","poem":1},{"lineBreak":true},{"text":"Na lɔxɔni","poem":1},{"lineBreak":true},{"text":"n faan nasoma nɛn e soone birin yi,","poem":1},{"lineBreak":true},{"text":"n yi gaxun naso e soo ragine yi.","poem":1},{"lineBreak":true},{"text":"Koni n nan n yɛɛn tima nɛn","poem":1},{"lineBreak":true},{"text":"Yuda bɔnsɔnna muxune ra.","poem":1},{"lineBreak":true},{"text":"N yi siyane soone birin yɛɛne xɔri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yuda mangane a falama nɛn e bɔɲɛni,","poem":1},{"lineBreak":true},{"text":"“Yerusalɛn muxune bata en sɛnbɛ so","poem":1},{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna barakani, e Ala.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"n Yuda mangane luma nɛn","poem":1},{"lineBreak":true},{"text":"alo tɛɛ wolonne yegene dɛ,","poem":1},{"lineBreak":true},{"text":"alo xaye radɛgɛxin malo xidine tagi.","poem":1},{"lineBreak":true},{"text":"E fama e rabilinna siyane halagideni","poem":1},{"lineBreak":true},{"text":"e kɔmɛnna nun e yiifanna ma.","poem":1},{"lineBreak":true},{"text":"Koni Yerusalɛn kaane mɔn luma nɛn e konni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala Yuda dɔxɔdene nan singe rakisima,","poem":1},{"lineBreak":true},{"text":"alogo Dawuda yixɛtɛne nun Yerusalɛn muxune","poem":1},{"lineBreak":true},{"text":"binyen nama dangu Yuda muxune ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"Alatala Yerusalɛn kaane ratangama nɛn.","poem":1},{"lineBreak":true},{"text":"Hali naxan bata tagan e yɛ,","poem":1},{"lineBreak":true},{"text":"a yɛngɛn soma nɛn na lɔxɔni","poem":1},{"lineBreak":true},{"text":"alo Dawuda.","poem":1},{"lineBreak":true},{"text":"Dawuda yixɛtɛne fan luma nɛn","poem":1},{"lineBreak":true},{"text":"alo Ala yɛtɛna,","poem":1},{"lineBreak":true},{"text":"alo Alatalaa malekana e yɛɛ ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"n siyane birin naxɔrima nɛn","poem":1},{"lineBreak":true},{"text":"naxanye fama Yerusalɛn xili ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nayi, n hinanna nun maxandin niin nagodoma nɛn","poem":1},{"lineBreak":true},{"text":"Dawuda yixɛtɛne ma e nun Yerusalɛn muxune.","poem":1},{"lineBreak":true},{"text":"E yi e yɛɛ rafindi n ma,","poem":1},{"lineBreak":true},{"text":"e naxan yisɔxɔnxi.","poem":1},{"lineBreak":true},{"text":"E sunuma nɛn a fe ra","poem":1},{"lineBreak":true},{"text":"alo dii keden peena.","poem":1},{"lineBreak":true},{"text":"E a wugama nɛn sɔxɔlɛni,","poem":1},{"lineBreak":true},{"text":"alo dii singena.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"sunun gboma ayi nɛn Yerusalɛn taani,","poem":1},{"lineBreak":true},{"text":"alo Xadada-Rimɔn ma sununa Megido mɛrɛmɛrɛni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yamanan sunuma nɛn,","poem":1},{"lineBreak":true},{"text":"xabilane birin yi lu e danna.","poem":1},{"lineBreak":true},{"text":"Dawuda bɔnsɔnna a danna,","poem":1},{"lineBreak":true},{"text":"e ɲaxanle fan e danna,","poem":1},{"lineBreak":true},{"text":"Natan bɔnsɔnna a danna,","poem":1},{"lineBreak":true},{"text":"e ɲaxanle fan e danna,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lewi bɔnsɔnna a danna,","poem":1},{"lineBreak":true},{"text":"e ɲaxanle fan e danna,","poem":1},{"lineBreak":true},{"text":"Simayi bɔnsɔnna a danna,","poem":1},{"lineBreak":true},{"text":"e ɲaxanle fan e danna,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"e nun bɔnsɔnna bonne birin.","poem":1},{"lineBreak":true},{"text":"Birin luma nɛn a danna,","poem":1},{"lineBreak":true},{"text":"e ɲaxanle fan yi lu e danna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ZEC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ZEC/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ZEC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}