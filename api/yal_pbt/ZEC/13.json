{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ZEC","translationId":"yal_pbt","name":"Nabi Sakari Sora","commonName":"Nabi Sakari Sora","title":"Sakari Nabi Sakari Alaa Falan Naxan Sɛbɛ","order":38,"numberOfChapters":14,"sha256":"d648ce18d94ca0ba4cbc94d99e46b5f0390ce75652db864bcd42f9f476d9a3cd","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/yal_pbt/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":13,"content":[{"type":"heading","content":["Suxurene nun wule nabine"]},{"type":"verse","number":1,"content":[{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"tigin minima nɛn Dawuda yixɛtɛne xa,","poem":1},{"lineBreak":true},{"text":"e nun Yerusalɛn muxune,","poem":1},{"lineBreak":true},{"text":"alogo yulubine nun xɔsin xa ba e ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna falan ni ito ra:","poem":1},{"lineBreak":true},{"text":"Na lɔxɔni,","poem":1},{"lineBreak":true},{"text":"n suxurene xinle bama nɛn yamanani,","poem":1},{"lineBreak":true},{"text":"ɲinan yi ti e xɔn ma fefe!","poem":1},{"lineBreak":true},{"text":"N mɔn nabine nun xaxili ɲaxin bama nɛn yamanani.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xa muxuna nde mɔn nabiya falan ti,","poem":1},{"lineBreak":true},{"text":"a nga nun a baba naxan a barixi,","poem":1},{"lineBreak":true},{"text":"ne a falama a xa nɛn,","poem":1},{"lineBreak":true},{"text":"e naxa, “I xa faxa,","poem":1},{"lineBreak":true},{"text":"amasɔtɔ i bata wulen fala Alatala xinli.”","poem":1},{"lineBreak":true},{"text":"A nga nun a baba naxan a barixi,","poem":1},{"lineBreak":true},{"text":"ne a sɔxɔnma nɛn","poem":1},{"lineBreak":true},{"text":"a nɛma nabiya falane tima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na lɔxɔni, nabine birin yagima nɛn","poem":1},{"lineBreak":true},{"text":"e fe toxine nun e waliyiya falane ra.","poem":1},{"lineBreak":true},{"text":"E mi fa nabiya domaan soma sɔnɔn","poem":1},{"lineBreak":true},{"text":"alogo e xa madaxun ti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E birin a falama nɛn, e naxa,","poem":1},{"lineBreak":true},{"text":"“Nabi mi n na, xɛɛ biin nan n na.","poem":1},{"lineBreak":true},{"text":"Amasɔtɔ muxuna nde n sara nɛn","poem":1},{"lineBreak":true},{"text":"xabu n dii ɲɔrɛ waxatini.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Koni e a maxɔdinma nɛn, e naxa,","poem":1},{"lineBreak":true},{"text":"“Nanse laru itoe ra i kanken ma?”","poem":1},{"lineBreak":true},{"text":"A e yabima nɛn, a naxa,","poem":1},{"lineBreak":true},{"text":"“E n maxɔlɔ nɛn n xɔyine konni.”","poem":1}]},{"type":"heading","content":["Silanfanna"]},{"type":"verse","number":7,"content":["“Silanfanna,",{"text":"i xa keli n ma xuruse rabaan xili ma,","poem":1},{"lineBreak":true},{"text":"xɛmɛn naxan n fɛma.”","poem":1},{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna falan ni ito ra.","poem":1},{"lineBreak":true},{"text":"“Xuruse rabaan faxa,","poem":1},{"lineBreak":true},{"text":"yɛxɛɛne xa xuya ayi.","poem":1},{"lineBreak":true},{"text":"N yi keli a xunxurine xili ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nayi, yamaan dɔxɔde saxan,","poem":1},{"lineBreak":true},{"text":"firin faxama nɛn keden yi lu na.","poem":1},{"lineBreak":true},{"text":"Alatalaa falan nan na ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N yi a dɔnxɛn sa tɛɛni","poem":1},{"lineBreak":true},{"text":"n yi a rasɛnsɛn alo gbetina.","poem":1},{"lineBreak":true},{"text":"N yi e mato tɛɛni,","poem":1},{"lineBreak":true},{"text":"alo xɛmaan matoon kii naxan yi.","poem":1},{"lineBreak":true},{"text":"Nayi, e n maxandima nɛn,","poem":1},{"lineBreak":true},{"text":"n yi e yabi.","poem":1},{"lineBreak":true},{"text":"N na a falama nɛn,","poem":1},{"lineBreak":true},{"text":"‘N ma yamaan nan ne ra.’","poem":1},{"lineBreak":true},{"text":"E yi a fala, e naxa,","poem":1},{"lineBreak":true},{"text":"‘Alatala nan nxɔ Ala ra.’ ”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yal_pbt/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}