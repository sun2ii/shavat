{"translation":{"id":"yal_pbt","name":"Kisin Kiraan Kitabuna","website":"https://ebible.org/Scriptures/details.php?id=yal","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yal","licenseNotes":null,"shortName":"PBT","englishName":"Yalunka Bible","language":"yal","textDirection":"ltr","sha256":"f8e5a712a77728c95b051639b65291f0db5cc5842c6dd4a8492f4a15e771c733","availableFormats":["json"],"listOfBooksApiLink":"/api/yal_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31168,"languageName":"Yalunka","languageEnglishName":"Yalunka"},"book":{"id":"ZEP","translationId":"yal_pbt","name":"Nabi Sofoni Sora","commonName":"Nabi Sofoni Sora","title":"Sofoni Nabi Sofoni Alaa Falan Naxan Sɛbɛ","order":36,"numberOfChapters":3,"sha256":"138f8981de5686b255a11fd685e9c617d8c2f8a65138b9003c871307e102a3fc","firstChapterNumber":1,"firstChapterApiLink":"/api/yal_pbt/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/yal_pbt/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Ɛ malan, ɛ bode to,","poem":1},{"lineBreak":true},{"text":"ɛ tan yama yagitarena,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"benun waxati saxin xa a li,","poem":1},{"lineBreak":true},{"text":"benun lɔxɔni ito xa dangu","poem":1},{"lineBreak":true},{"text":"alo se dagin foyeni,","poem":1},{"lineBreak":true},{"text":"benun Alatalaa xɔlɔ gbeen xa ɛ li,","poem":1},{"lineBreak":true},{"text":"benun Alatalaa xɔlɔ lɔxɔn xa fa ɛ ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ Alatala fen,","poem":1},{"lineBreak":true},{"text":"ɛ tan yamanan muxu xuruxine,","poem":1},{"lineBreak":true},{"text":"ɛ tan naxanye a sariya kɛndɛn ligama.","poem":1},{"lineBreak":true},{"text":"Ɛ tinxinyaan fen,","poem":1},{"lineBreak":true},{"text":"ɛ lu yɛtɛ magodoni.","poem":1},{"lineBreak":true},{"text":"Waxatina nde, ɛ tangama nɛn","poem":1},{"lineBreak":true},{"text":"Alatalaa xɔlɔ lɔxɔn ma.","poem":1}]},{"type":"heading","content":["Gbalona siyane xa"]},{"type":"verse","number":4,"content":[{"text":"Gasa taan nabeɲinma nɛn,","poem":1},{"lineBreak":true},{"text":"Asikalɔn taan halagima nɛn,","poem":1},{"lineBreak":true},{"text":"Asadodi kaane yi kedi yanyin na,","poem":1},{"lineBreak":true},{"text":"Ekirɔn yi raxɔri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbalon na muxune xa,","poem":1},{"lineBreak":true},{"text":"naxanye dɔxi fɔxɔ igen dɛ","poem":1},{"lineBreak":true},{"text":"siyaan naxanye sa kelixi Kereti yamanani.","poem":1},{"lineBreak":true},{"text":"Ɛ tan Kanan kaane,","poem":1},{"lineBreak":true},{"text":"ɛ tan Filisitine,","poem":1},{"lineBreak":true},{"text":"Alatala falan tima ɛ xili ma,","poem":1},{"lineBreak":true},{"text":"a naxa, “N na ɛ raxɔrima nɛn,","poem":1},{"lineBreak":true},{"text":"muxu yo mi luyɛ ɛ yi.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fɔxɔ igen dɛxɔnne findima nɛn","poem":1},{"lineBreak":true},{"text":"xuruse rabadene nun kula yirene ra xuruse kantanne xa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɛnne findima nɛn Yuda muxu dɔnxɛne gbeen na.","poem":1},{"noteId":1},{"lineBreak":true},{"text":"E yi e xuruseene raba na.","poem":1},{"lineBreak":true},{"text":"Ɲinbanna ra,","poem":1},{"lineBreak":true},{"text":"e sa e sa Asikalɔn kaane banxine kui.","poem":1},{"lineBreak":true},{"text":"Bayo, Alatala, e Ala,","poem":1},{"lineBreak":true},{"text":"e malima nɛn,","poem":1},{"lineBreak":true},{"text":"Ala yi e muxune raxɛtɛ e ma","poem":1},{"lineBreak":true},{"text":"naxanye yi suxi yɛngɛni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N bata Moyaba konbi ti xuine mɛ","poem":1},{"lineBreak":true},{"text":"e nun Amonine n ma yamaan magelema kii naxan yi,","poem":1},{"lineBreak":true},{"text":"e yi e yamanan danne fari sa,","poem":1},{"lineBreak":true},{"text":"ba Isirayila bɔxɔn na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala Sɛnbɛn Birin Kanna falan ni ito ra,","poem":1},{"lineBreak":true},{"text":"Isirayilaa Ala naxa,","poem":1},{"lineBreak":true},{"text":"“N tan habadan Ala,","poem":1},{"lineBreak":true},{"text":"n bata n kɔlɔ n yɛtɛni,","poem":1},{"lineBreak":true},{"text":"Moyaba yamanan luma nɛn","poem":1},{"lineBreak":true},{"text":"alo Sodoma taana,","poem":1},{"lineBreak":true},{"text":"Amoni yamanan yi lu","poem":1},{"lineBreak":true},{"text":"alo Gomora taana,","poem":1},{"lineBreak":true},{"text":"sɛxɛ ɲaxine dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"fɔxɔn gema dɛnaxan yi,","poem":1},{"lineBreak":true},{"text":"dɛnaxan halagixi han habadan.","poem":1},{"lineBreak":true},{"text":"N ma yamaan muxu dɔnxɛne yi ne yii seene tongo.","poem":1},{"lineBreak":true},{"text":"N ma muxun naxanye na lu,","poem":1},{"lineBreak":true},{"text":"ne yi e bɔxɔn tongo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Na fena e sɔtɔma e wason saranna nan na,","poem":1},{"lineBreak":true},{"text":"bayo e bata Alatala Sɛnbɛn Birin Kanna yamaan konbi","poem":1},{"lineBreak":true},{"text":"e yi keli e xili ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala ɲaxuma ayi nɛn e ra,","poem":1},{"lineBreak":true},{"text":"bayo a e gbee alane birin naxɔrima nɛn yamanani.","poem":1},{"lineBreak":true},{"text":"Hali yire makuyene yi,","poem":1},{"lineBreak":true},{"text":"siyane birin a batuma nɛn e konne yi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɛ tan Kusi kaane,","poem":1},{"noteId":2},{"lineBreak":true},{"text":"n na ɛ fan yɛngɛma nɛn,","poem":1},{"lineBreak":true},{"text":"n yi ɛ faxa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"A kelima nɛn sogeteden kɔmɛnna binna yamanan xili ma,","poem":1},{"lineBreak":true},{"text":"a yi Asiriya raxɔri.","poem":1},{"lineBreak":true},{"text":"A yi Niniwa taan halagi,","poem":1},{"lineBreak":true},{"text":"a na findi tonbonna ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xuruseene yi na findi e kuruden na,","poem":1},{"lineBreak":true},{"text":"e nun suben sifan birin.","poem":1},{"lineBreak":true},{"text":"Singbinne nun sagalene yi xi a sɛnbɛtɛn longonne nun kondene yi.","poem":1},{"lineBreak":true},{"text":"Sɔnxɔ xuiin minima nɛn foye soden na, a naxa,","poem":1},{"lineBreak":true},{"text":"“Taan bata kala fefe fɔlɔ so dɛɛn ma,","poem":1},{"lineBreak":true},{"text":"bayo suman xalanbene birin bata mini kɛnɛnni.”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Taa faɲi makantanxini ito mato,","poem":1},{"lineBreak":true},{"text":"naxan yi a falama, a naxa,","poem":1},{"lineBreak":true},{"text":"“Ba n tan na, gbɛtɛ mi na!”","poem":1},{"lineBreak":true},{"text":"Taani ito kalaxi di,","poem":1},{"lineBreak":true},{"text":"a findi subene birin konna ra?","poem":1},{"lineBreak":true},{"text":"Naxan yo na dangu a dɛxɔn,","poem":1},{"lineBreak":true},{"text":"na kanna kolinma a ma nɛn,","poem":1},{"lineBreak":true},{"text":"a yiin ti a ma, a kabɛ.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"2.7muxu dɔnxɛne:Yuda kaane fama suxudeni yɛngɛni nɛn. Muxun naxanye luma e nii ra yɛngɛn ɲan xanbini, ne nan ma fe falaxi be.","reference":{"chapter":2,"verse":7}},{"noteId":2,"caller":"+","text":"2.12Kusi:Yamanan naxan Misiran faxa ra Nila baan dɛ. Fati fɔrɛ yamanan nan yi a ra.","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/yal_pbt/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yal_pbt/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yal_pbt/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}