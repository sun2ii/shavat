{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"JOB","translationId":"yap_bsm","name":"JOB","commonName":"JOB","title":"BABYOR NI JOB","order":18,"numberOfChapters":42,"sha256":"6b79cf6ad99687113c94b76defb4478c58ac52dbeb784730d1546f65d0721988","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/yap_bsm/JOB/42.json","totalNumberOfVerses":1038},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Got e ba gel gelngin; urngin e girdi’ ma thingari par ni bay daguwen rorad;","poem":1},{"text":"ma dunubiy gil’ilungun u tharmiy ngi i par u fithik’ e gapas.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gur rayag ni the’eg be’ e pi engel ni yad be pigpig ngak?","poem":1},{"lineBreak":true},{"text":"Gur bay bang ni der taw ra’en Got ngay?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rayag ni par be’ nib mat’aw fa bmachalbog u p’eowchen Got?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"U owchen e mus ko pul ma de ga’ ra’en riy","poem":1},{"text":"ma pi t’uf e de matabgol ra’en u owchen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Me ere bu uw rogon be’, ni gowa ba fakl’ud, fa ba chachengeg?","poem":1},{"text":"Mang fel’ngin e girdi’ u owchen Got?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":5}