{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":100,"content":[{"type":"heading","content":["Ba tang ni yibe pining e sorok"]},{"type":"verse","number":1,"content":[{"text":"Fayleng ni ga’ngin, mu tangnaged SOMOL u fithik’ e felfelan’!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mu liyorgad ngak SOMOL u fithik’ e felfelan’,","poem":1},{"text":"mi gimed yib nga p’eowchen ni gimed be tang u fithik’ e felfelan’!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dab mpaged talin i SOMOL ni ir Got!","poem":1},{"text":"Ir e sunumegdad, ma bmil fadad ngak;","poem":2},{"lineBreak":true},{"text":"gadad girdi’en, gadad fare ran’ i saf rok.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Marod ngalan e pi garog ko Tempel rok ni gimed be pining e magaer ngak,","poem":1},{"text":"marod ngalan e yoror rok nib thothup ni gimed be pining e sorok ngak!","poem":2},{"lineBreak":true},{"text":"Mu pininged e magaer ngak mi gimed pining e sorok ngak!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I SOMOL e bfel’;","poem":1},{"text":"t’ufeg rok e dariy n’umngin nap’an,","poem":2},{"lineBreak":true},{"text":"ma feni yul’yul’ e bayi par ni kargon ni manemus.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}