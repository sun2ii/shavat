{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":11,"content":[{"type":"heading","content":["Pagan’ ngak SOMOL"]},{"type":"verse","number":1,"content":[{"text":"Be pagan’ug ko ayuw rok SOMOL.","poem":1},{"text":"Rigab balyang ni ga be yog ngog ni ga be ga’ar,","poem":2},{"text":"“Mu changeg ngam man ni bod ba arche’ nga daken e pi burey,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ya pi’in kireb e kar tiled e gat’ing rorad ma kar pulweged gan e gat’ing rorad","poem":2},{"lineBreak":true},{"text":"u milmor ni ngar yip’ed e pi’in bfel’.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Be’ ni bfel’ e dariy ban’en nrayag ni rin’","poem":1},{"text":"ni fa’anra ke wagay gubin ban’en.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"SOMOL e bay u lan e tempel rok nib thothup;","poem":1},{"text":"ma tagil’ e bay u tharmiy.","poem":2},{"text":"Be yaliy e girdi’ u gubin yang","poem":1},{"text":"ma manang e n’en ni yad be rin’.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ma fal’eg i yaliy e fel’ nge kireb ni ta’reb rogon;","poem":1},{"text":"ma pi’in der fol ko motochiyel e ma fananikayrad u polo i gumircha’en.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma pu’og e achaffin ni be daramram","poem":1},{"text":"nga but’ nge sulfur ni be yik’ nga daken e pi’in kireb;","poem":2},{"lineBreak":true},{"text":"me gechig nagrad ko nifeng nib gawel.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"SOMOL e bmat’aw, ma ba’adag e wok ni bfel’;","poem":1},{"text":"pi’in yad ra rin’ e wok ni bfel’ e yad ra par u p’eowchen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}