{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":113,"content":[{"type":"heading","content":["I SOMOL e ma ayweg e girdi’ nike t’uf e ayuw rorad"]},{"type":"verse","number":1,"content":[{"text":"Ke sorok SOMOL!","poem":1},{"lineBreak":true},{"text":"Gimed e pi tapigpig rok SOMOL,","poem":1},{"text":"mu pininged e sorok nga fithingan!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mang e yugun pining e sorok nga fithingan,","poem":1},{"text":"e chiney i yan ngaram ndariy n’umngin nap’an.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ngan pining e sorok nga fithingan SOMOL","poem":1},{"text":"ni mus ko ngek nge mada’ ko ngal!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I SOMOL e be gagiyegnag urngin e pi nam;","poem":1},{"text":"feni gilbugwan e ke pag e pi tharmiy ngalang.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dariy be’ ni bod rogon SOMOL ni Got rodad.","poem":1},{"lineBreak":true},{"text":"Ma par ko bin th’abi lang e giyow,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"machane ma lumel nga but’","poem":2},{"lineBreak":true},{"text":"nge guy e pi tharmiy nge fayleng.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Me suwonnag e pi’in gafgow u fithik’ e ab;","poem":1},{"text":"me chibiy e pi’in bt’uf e ayuw rorad u fithik’ e gafgow","poem":2}]},{"type":"verse","number":8,"content":[{"text":"me tayrad ngar manged fager ko pi’in pagel ni fak e pilung,","poem":1},{"text":"fapi fak e pilung ko girdi’ rok.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I tolangnag be’ ni bpin ni dariy fak u lan e tabnaw rok,","poem":1},{"text":"me felfelan’nag fare pin ko bitir ni pi’ ngak.","poem":2},{"lineBreak":true},{"text":"Ke sorok SOMOL!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}