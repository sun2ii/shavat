{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":114,"content":[{"type":"heading","content":["Ba tang ko Paluk’af"]},{"type":"verse","number":1,"content":[{"text":"Nap’an ni chuw piyu Israel u Egypt,","poem":1},{"text":"ni aram e pi’in owchen Jakob nra chuwgad ko fare nam ni gathi taferad,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"me yu Judah e ra manged e girdi’ ni thothup rok Somol,","poem":1},{"text":"me milsuwon yu Israel ngak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I changar fare day ni Red Sea me mil;","poem":1},{"text":"me sul fare Lul’ nu Jordan nga tomur.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I og e pi burey ni bod e kaming;","poem":1},{"text":"me tim’og e yochi burey ni bod pifak e saf.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Day, mang e buch mag mil?","poem":1},{"text":"Me gur Lul’ ni Jordan, mang ni mu sul nga tomur?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gimed e pi burey, mangfan ni mu oggad ngalang ni bod e kaming?","poem":1},{"text":"Gimed e yochi burey, mangfan nim titim’oggad i yan ni bod pifak e saf?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fayleng mu durru’ ko wub ni ke tay Somol,","poem":1},{"text":"u p’eowchen fare Got rok Jakob,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"nma pilyeg e war nge ngal’ nran","poem":1},{"text":"nge gogyal nge ngal’ ni thang’el.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}