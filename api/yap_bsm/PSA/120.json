{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":120,"content":[{"type":"heading","content":["Ba meybil ni fan ko Ayuw"]},{"type":"verse","number":1,"content":[{"text":"Nap’an ni u gu moy u fithik’ e oloboch, mu gu pining SOMOL,","poem":1},{"text":"me fuluweg lungug.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"SOMOL, mu chuwegeg u pa’,","poem":1},{"text":"e pi sasalap l’ugun nge pi ta ban.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gimed e pi taban, mang e bayi rin’ Got ngomed?","poem":1},{"text":"Urogon ni nge gechig nagmed?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nga gan e gat’ing ko salthaw nib m’uth,","poem":1},{"text":"ni bay e nifiy u taban!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Par ni gu be tay u fithik’med e bod feni kireb e par u Meshek","poem":1},{"text":"ara fithik’ e girdi’ nu Kedar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kay gi n’uw nap’an ni ku gu par","poem":1},{"text":"rok e girdi’ ndaburad e gapas!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nap’an ni gu ra weliy murung’agen e gapas,","poem":1},{"text":"ma mael e yad ba’adag.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}