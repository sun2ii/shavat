{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":121,"content":[{"type":"heading","content":["I SOMOL e Ir e yoror rodad"]},{"type":"verse","number":1,"content":[{"text":"Kugu sap ngalang ko fapi burey; uw e nge yib e ayuw riy ngog?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"SOMOL e ma yib e ayuw rok ngog,","poem":1},{"text":"ni Ir e sunumiy e tharmiy nge but’.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ir e dabi pagem ngam mul;","poem":1},{"text":"en ni yoror rom e ke par ni be od!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"En ni yoror rok piyu Israel","poem":1},{"text":"e der ma yib e chuchuw ngak ma der mol!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I SOMOL e bay i matanagiyem;","poem":1},{"text":"bay u to’obem ni nge ayuwegnem","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yal’ e dabi amith nigem ni rran, ma ku er i tay e pul nnep’.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"