{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":124,"content":[{"type":"heading","content":["Got ni ir e ma ayuweg e girdi’ rok"]},{"type":"verse","number":1,"content":[{"text":"Fa’an mang e da i moy SOMOL u ba’ rodad ma gadad ra di’in?","poem":1},{"text":"Israel, mu pi’ e fulweg riy!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Fa’an mang e da i moy SOMOL u ba’ rodad","poem":1},{"text":"ko ngiyal’ ni cham e pi to’ogor rodad ngodad,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ma kar ful’ed gadad ni ka gadad bafos","poem":1},{"text":"u gelngin e damumuw rorad ngodad;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ma aram e ran nike sugbur e ra chibiydad nge fekdad ngabang","poem":1},{"text":"nge tharaydad e ran,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ma n’ew ni be cham u fithik’ e ra lumoch nagdad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngad pininged e magaer ngak SOMOL,","poem":1},{"text":"ya de pag e pi to’ogor rodad ngar thanged gadad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kad thaygad ni bod ba arche’ ni thay ko wup ni tay be’ nma kol e arche’;","poem":1},{"text":"ke kireb fare wup ka da chuwgad riy!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ayuw ni be yib ngodad e SOMOL e be yib rok,","poem":1},{"text":"ni ir e sunumiy e tharmiy nge but’.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}