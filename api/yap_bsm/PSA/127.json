{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":127,"content":[{"type":"heading","content":["Got nni pining e sorok ngak nga feni gol"]},{"type":"verse","number":1,"content":[{"text":"Fa’anra gathi SOMOL e be toy ba naun,","poem":1},{"text":"ma maruwel ko pi’in be toy e mm’ay fan;","poem":2},{"text":"fa’anra dabi yoror SOMOL u bbinaw,","poem":1},{"text":"ma mm’ay fan e pi’in yad be matanagiy.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dariy fan ni ngan toer ko maruwel nib gel ni yibe tay,","poem":1},{"text":"ni ngan od nri kakadbul min mol nike n’uw e nep’,","poem":2},{"text":"ya SOMOL e ir e ma pi’ ngak e pi’in yad ba t’uf rok e tin ke t’uf rorad,","poem":1},{"text":"u nap’an ni ku yad be mol.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bitir e ba tow’ath nma pi’ SOMOL;","poem":1},{"text":"yad e bin riyul’ e tow’ath.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pi bitir ni pumo’on ni fak be’ ni kab pagel","poem":1},{"text":"e bod bogi gan e gat’ing ni bay u pa’ ba salthaw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ba felfelan’ e re mo’on ni bay e mit i gan e gat’ing nem rok!","poem":1},{"lineBreak":true},{"text":"Ya dabiyag ni nga ni gel ngak","poem":1},{"text":"ko ngiyal’ ni yad ra lu’ag e pi to’ogor rok e thin u tagil’ e puf oloboch.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}