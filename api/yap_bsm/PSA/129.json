{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":129,"content":[{"type":"heading","content":["Ba meybil nib togopluw ngak e to’ogor rok yu Israel"]},{"type":"verse","number":1,"content":[{"text":"Israel, mog ngomad rogon nike gafgow nigem e pi to’ogor rom","poem":1},{"text":"ni ka nap’an e kagab bitir.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ka nap’an e kugub bitir,","poem":1},{"text":"mri gafgow nigeg e pi to’ogor rog,","poem":2},{"lineBreak":true},{"text":"machane dawor ra gelgad ngog.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kar maad’adgad nga keru’ug","poem":1},{"text":"ke bod bangi flang ni kan gi’ e but’ riy.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Machane, SOMOL, ni ir e cha’ nib mat’aw,","poem":1},{"text":"e ke pithigeg ni dab kug mang sib.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mang e yigi urngin e pi’in yad be fananikay yu Zion","poem":1},{"text":"e ra waergad min tulufrad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mang e yad gubin nra boded e pan ni be tugul u daken e naun,","poem":1},{"text":"nma mororoy u m’on ni nge ilal;","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"dariy be’ nma kunuy","poem":2},{"lineBreak":true},{"text":"ara yuthumnag nge fek.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dariy be’ nra yan u to’oben me ga’ar,","poem":1},{"text":"“Mang e yigi fal’eg SOMOL wa’atham!","poem":2},{"lineBreak":true},{"text":"Gamad be fal’eg wa’atham u fithingan SOMOL.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}