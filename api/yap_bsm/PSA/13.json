"text":"Bay gu felan’, ni bochan e ga ra chuwegeg u pa’rad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"SOMOL, bay gu tang nigem,","poem":1},{"text":"ni bochan e ku’um gol ngog.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}