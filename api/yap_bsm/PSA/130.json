{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":130,"content":[{"type":"heading","content":["Meybil ni yibe ning e ayuw"]},{"type":"verse","number":1,"content":[{"text":"U fithik’ e mathliyab rog mu gu piningem, SOMOL.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Somol, mu rung’ag lamag,","poem":1},{"text":"mmotoyil nga lamag ni gu be wenig ngom ni ngam ayuwegneg!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fa’an mang e mu tay ngan’um e pi denen romad’,","poem":1},{"text":"me mini’ e rayag rok ni nge thay ndab ni gechignag?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Machane ga be n’ag fan romad,","poem":1},{"text":"ni fan e ngu’ug pired ni bay madgum u wun’mad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gu be son ni be oban’ug ko ayuw rok SOMOL,","poem":1},{"text":"ma gu be par nib pagan’ug ko thin rok.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gu be sonnag Somol","poem":1},{"text":"ni be oban’ug nib gel ngak e pi matanag ni yad be sonnag e woch ni nge puf,","poem":2},{"lineBreak":true},{"text":"ni ka ba gel feni be oban’ug ngak e pi matanag ni yad be sonnag e woch ni nge puf.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel, mu pagan’um ngak SOMOL,","poem":1},{"text":"ni bochan e t’ufeg rok e dabimus,","poem":2},{"lineBreak":true},{"text":"gubin ngiyal’ ni yugu be par ni ba’adag ni nge mat’aw nigem ngak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bayi chuweg e girdi’ rok ni piyu Israel","poem":1},{"text":"u fithik’ urngin e denen rorad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}