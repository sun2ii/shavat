,{"text":"miyad tang u fithik’ e felfelan’ ni n’umngin e nep’.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ngar tolulgad ngalang ni yad be pining e sorok ngak Got,","poem":1},{"text":"ni bay e saydon rorad u pa’rad nib m’uth","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ngar li’ed e pi nam","poem":2},{"lineBreak":true},{"text":"miyad gechignag e girdi’;","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"miyad michigiy e pi pilung rorad ko chen,","poem":2},{"lineBreak":true},{"text":"nge pi’in yad ma yog e thin rorad ko chen ni wasey;","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ngan gechignag e pi nam ni bod nike yog Got.","poem":2},{"text":"Irera’, e gel ni fen pi girdi’en Got.","poem":1},{"lineBreak":true},{"text":"Ke sorok SOMOL!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}