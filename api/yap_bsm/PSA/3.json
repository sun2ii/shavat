{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":3,"content":[{"type":"heading","content":["Meybil ko Ayuw ni Kadbul3:0 ROGON NI HEBREW: Ba tang kok David, u tomuren ni mil rok Absalom ni be’ nib pagel ni fak."]},{"type":"verse","number":1,"content":[{"text":"SOMOL, rib yo’or e to’ogor rog,","poem":1},{"text":"nike pag urngrad ni yad be togopluw ngog.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yad be yogneg ni yad be ga’ar,","poem":1},{"text":"“Dabi ayuweg Got e cha’nem.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Machane gur SOMOL, e rungrung rog ko riya’ ni gubin ngiyal’;","poem":1},{"text":"ga ma gel nigeg","poem":2},{"lineBreak":true},{"text":"ma ga ma fulweg e athamgil nga lanin’ug.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gu yornag e ayuw ngak SOMOL,","poem":1},{"text":"me fulweg taban e meybil rog ko fare burey rok nib thothup.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gu pageg nga but’ ni nggu mol,","poem":1},{"text":"ma SOMOL e be yoror rog ni n’umngin e nep’.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Da gu rus ko yu biyu’ i to’ogor","poem":1},{"text":"ni yad ba liyegeg u ga’ngin yang.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"SOMOL, ni Got rog moy ngam ayuwegneg!","poem":1},{"lineBreak":true},{"text":"Mu gechignag urngin e pi to’ogor rog,","poem":1},{"text":"ngam pagrad nike m’ay gelingrad ni dabkiyag ni ngar maad’adgad ngog.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gel ni yima tay e ma yib rok SOMOL—","poem":1},{"text":"mang e yigi fal’eg wa’athan e girdi’ rok.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}