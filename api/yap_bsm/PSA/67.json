{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":67,"content":[{"type":"heading","content":["Ba tang ko ogmagaer"]},{"type":"verse","number":1,"content":[{"text":"Got, nge wurngan’um ngomad, ma ga fal’eg wa’athmad;","poem":1},{"text":"mu changar ngomad u fanam gol,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ya nge nang e fayleng ni polo’ e tin nib magan’um ngay,","poem":1},{"text":"me nang urngin e pi nam e ayuw ni ga ma pi’!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Got, manga yigi pining e girdi’ e sorok ngom,","poem":1},{"text":"manga yigi gubin girdi’ me pining e sorok ngom!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Manga yigi felan’ e pi nam ngar tang niged e felfelan’,","poem":1},{"text":"ni bochan e mmat’aw rogon ni ga ma pufthinnag e girdi’,","poem":2},{"lineBreak":true},{"text":"ma ga ma pow’iy urngin e nam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A Got, manga yigi pining e girdi’ e sorok ngom,","poem":1},{"text":"manga yigi gubin e girdi’ me pining e sorok ngom!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"But’ e ke yib e ggan riy;","poem":1},{"text":"Got, ni Got rodad, e ke fal’eg waathdad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Got e ke fal’eg waathdad;","poem":1},{"text":"mang e yigi liyor gubin e girdi’ u gubin yang ngak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}