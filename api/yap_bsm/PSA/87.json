{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":87,"content":[{"type":"heading","content":["Yu Jerusalem nib th’abi fel’"]},{"type":"verse","number":1,"content":[{"text":"SOMOL e toy e binaw rok nga daken fare burey nib thothup;","poem":1},{"noteId":8}]},{"type":"verse","number":2,"content":[{"text":"kab t’uf rok e binaw nu Jerusalem","poem":2},{"lineBreak":true},{"text":"ko pi binaw ni bay u Israel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Binaw rok Got, mu telim","poem":1},{"text":"ko pin’en ni bfel’ nike yog ni murung’agem nike ga’ar:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ra gu the’eg e pi nam ni yad ma fol rog,","poem":1},{"text":"mra gu uneg yu Egypt nge yu Babylonia ngay;","poem":2},{"text":"ma ku bay gog ni yu Filistia nge yu Tyre, nge yu Ethiopia","poem":1},{"text":"e bay ku ni mathe’eg ngorad ni girdi’en yu Jerusalem.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bay u nog ni urngin e nam","poem":1},{"text":"nib mil farad nga Zion,","poem":2},{"lineBreak":true},{"text":"ma en ni Gubin ma Rayag Rok e bay i gagiyegnag nge par nib gel.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I SOMOL e bayi tay nga babyor urngin e girdi’,","poem":1},{"text":"me tayrad ni yad gubin ni kar manged girdi’en yu Jerusalem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yad ra churu’ miyad be tang ni be lungurad,","poem":1},{"text":"“U Zion e ma yib urngin e tow’ath rok Got riy ngomad.”","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"BUREY NIB THOTHUP: Ku arrogon ni bay ko 2:6.","reference":{"chapter":87,"verse":1}}]},"thisChapterLink":"/api/yap_bsm/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}