{"translation":{"id":"yap_bsm","name":"Bible Ni Thothup","website":"https://ebible.org/Scriptures/details.php?id=yap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yap","licenseNotes":null,"shortName":"BSM","englishName":"Yapese Bible","language":"yap","textDirection":"ltr","sha256":"8f263d70ad9d8639469d89cc686ce1ba74b7abcacd0e2dc8be2d7478ef7967ea","availableFormats":["json"],"listOfBooksApiLink":"/api/yap_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30321,"languageName":"Yapese","languageEnglishName":"Yapese"},"book":{"id":"PSA","translationId":"yap_bsm","name":"PSALMS","commonName":"PSALMS","title":"PSALMS","order":19,"numberOfChapters":150,"sha256":"c2f876d18dcc24c04426d220a69125acf17876d4983908b457aff50507df4537","firstChapterNumber":1,"firstChapterApiLink":"/api/yap_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yap_bsm/PSA/150.json","totalNumberOfVerses":2457},"chapter":{"number":93,"content":[{"type":"heading","content":["Got e ir e pilung"]},{"type":"verse","number":1,"content":[{"text":"I SOMOL e ir e pilung!","poem":1},{"text":"Ke yin’ nga daken ni bod e mad feni sorok nge feni gel gelngin.","poem":2},{"text":"Ke tay e fayleng nga tagil’ be par nib mudugil","poem":1},{"text":"ndabiyag ni ngan mithmitheg.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"SOMOL, tagil’im e be par nib mudugil ni ka nap’an ko tabolngin,","poem":1},{"text":"ma nap’an ndariy ban’en nike sum ma ga bay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"SOMOL, pi t’ay e rigur nib to’ar e kar ga’ niged linganrad;","poem":1},{"text":"kar pi’ed lamrad ngalang be chub lingan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"I SOMOL e ma gagiyeg u tharmiy ni ir e th’abi tolang,","poem":1},{"text":"ka ba ga’ nga lingan e rigur ni be chub,","poem":2},{"lineBreak":true},{"text":"ma ka ba gel ko n’ew nu rigur.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"SOMOL, pi motochiyel e dariy n’umngin nap’an,","poem":1},{"text":"ma Tempel rom e rriyul’ ni ba thothup,","poem":2},{"lineBreak":true},{"text":"ni manechibog ko pichibog.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yap_bsm/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yap_bsm/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yap_bsm/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}