{"translation":{"id":"yer_lis","name":"Tarok Bible","website":"https://ebible.org/Scriptures/details.php?id=yer","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yer","licenseNotes":null,"shortName":"LIS","englishName":"The Holy Bible in the Tarok language of Nigeria","language":"yer","textDirection":"ltr","sha256":"ab0ec0de824383345483b4036166a542d8d0cda49162fcd353013a4c47860c39","availableFormats":["json"],"listOfBooksApiLink":"/api/yer_lis/books.json","numberOfBooks":32,"totalNumberOfChapters":403,"totalNumberOfVerses":10499,"languageName":"Tarok","languageEnglishName":"Tarok"},"book":{"id":"EZK","translationId":"yer_lis","name":"Nlir aEzikyel","commonName":"Nlir aEzikyel","title":"Ezikyel","order":26,"numberOfChapters":48,"sha256":"0c293ebc3b258513b3036aadd14a1e74c2b829ce98cbbd79033accd2b94785b7","firstChapterNumber":1,"firstChapterApiLink":"/api/yer_lis/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/yer_lis/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Ǹyə́ng ikú ka̱kul onəm oga mpyal aIsa̱rila"]},{"type":"verse","number":1,"content":["<<Shì ìpyang ka̱kul onəm oga mpyal oIsa̱rila."]},{"type":"verse","number":2,"content":["Là pa̱,",{"text":"<< <Unang ɓu ìlir ìchar ìkamkam","poem":1},{"text":"ka̱ ashe oga ilìr.","poem":2},{"text":"Uza̱ ra kà̱ ishimshe ivan ilìr","poem":1},{"text":"kang i nak ishi ká̱ ivan wò.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uza̱ kang ìzəngtəng ka̱ ashe ovan wò,","poem":1},{"text":"á nyáng iya ìlir ìnunggwan.","poem":2},{"text":"Te á ɗyáng nkpán ìzhe,","poem":1},{"text":"kang à ri unəmləbər.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oga mbín fe izəzər","poem":1},{"text":"kang mmá kpán na ka̱ ashe ache oza̱.","poem":2},{"text":"Oza̱ dàp na ká̱ nzwar","poem":1},{"text":"ga ká̱ kà̱ mbin aMasar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nva̱ngva̱ ìnang ìlir va̱ ta ya pa̱ ò lòk ka̱ anung mwang","poem":1},{"text":"nnak ìgwak wò ru chit,","poem":2},{"text":"te uza̱ yar ìro kà̱ɗi ka̱ ashe ovan wò,","poem":1},{"text":"uza̱ kang na nyáng ìya ìlir ìnunggwan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Te ìya ìlir va̱ ta ga̱ɓa̱n kà̱ ishimshe oga ilìr,","poem":1},{"text":"uza̱ nyáng ìya ìlir ìnunggwan.","poem":2},{"text":"Uza̱ ɗyáng nkpán ìzhe,","poem":1},{"text":"uza̱ ri unəmləbər.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uza̱ vyap oga atak mbwam oza̱ akamkam.","poem":1},{"text":"Uza̱ nak oga itong oza̱ təm agúng.","poem":2},{"text":"Mbin va̱ ta ka̱ iya̱m va̱ ka̱ ashishe","poem":1},{"text":"fe aɗuɗum te ayər nəm oza̱.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Te mbín ɓa ka̱ apəpal,","poem":1},{"text":"kà̱ nza̱ ichwór nggo.","poem":2},{"text":"Oza̱ mang ìcha á na,","poem":1},{"text":"mmá kpán na ka̱ ashe ache oza̱.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Oza̱ kpán na ká̱ ayok, oza̱ dàp na ká̱ nzwar,","poem":1},{"text":"kang à ɓa ka̱ na ûPonzhi oga aBabel.","poem":2},{"text":"Oza̱ nak na ka̱ ashe nzhi ìkan,","poem":1},{"text":"le kang mmá fe aɗuɗum","poem":2},{"lineBreak":true},{"text":"ka̱ apal oga aɓam aIsa̱rila lap ka̱t.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Unang ɓu wa ìba̱ngba̱ng ka̱ ashe ìram ìba̱ngba̱ng ɓu,","poem":1},{"text":"mmá ɓál ka̱ anung ndəng,","poem":2},{"text":"á wár awár kang à chak igóng,","poem":1},{"text":"ka̱kul ndəng kúr na kúr.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Oga igugong kám","poem":1},{"text":"á mal ìdari aponzhi mal.","poem":2},{"text":"Á rup ɓa ga","poem":1},{"text":"ka̱ apal nkpaktak igóng.","poem":2},{"text":"Mmá ya na ka̱ atak ìrurup,","poem":1},{"text":"ka̱ atak ǹyə́l igugong.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Te mmá tutur na ka̱ ashe nlak ìgwak,","poem":1},{"text":"mmá mandar ka̱ mbin.","poem":2},{"text":"Ayə́r aga asa̱l awu alum wom na,","poem":1},{"text":"mmá tok oga awuwar.","poem":2},{"text":"Igugong ikamkam wom,","poem":1},{"text":"apər pwák na.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kang ǹyangmata̱ mmá ɓál ka̱ ashe nzam,","poem":1},{"text":"kà̱ mbin nwomwom va yà ká̱ ndəng ka̱t.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Te apər fa ká̱ izər igugong,","poem":1},{"text":"kang à ri awuwar.","poem":2},{"text":"Ìgong ìkamkam ìro re ka̱ izəzər","poem":1},{"text":"iva mal ìdari àponzhi ka̱t.>","poem":2},"Nshì ìpyang ta̱, á yà nnap-nshì ngga aɗor chit.>>"]}],"footnotes":[]},"thisChapterLink":"/api/yer_lis/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yer_lis/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yer_lis/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}