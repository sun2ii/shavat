{"translation":{"id":"yka_wbt","name":"Yakan Bible","website":"https://ebible.org/Scriptures/details.php?id=yka","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yka","licenseNotes":null,"shortName":"WBT","englishName":"Yakan Bible","language":"yka","textDirection":"ltr","sha256":"be38bd6271389195c37a880e21c1af7f4fb7a81d815eea56c8e5b16282425240","availableFormats":["json"],"listOfBooksApiLink":"/api/yka_wbt/books.json","numberOfBooks":29,"totalNumberOfChapters":268,"totalNumberOfVerses":8040,"languageName":"Yakan","languageEnglishName":"Yakan"},"book":{"id":"JON","translationId":"yka_wbt","name":"Yunus","commonName":"Yunus","title":"Jūd Nabi Yunus","order":32,"numberOfChapters":4,"sha256":"c1805711d8bf1dc32a59aeca7b52ccc77ed04d68373234e986215271abb4a55e","firstChapterNumber":1,"firstChapterApiLink":"/api/yka_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/yka_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Ngampun-ngampun si Yunus"]},{"type":"verse","number":1,"content":["Pag laˈi iye diyalem kennahin ngampun-ngampun si Yunus tudju Tuhan."]},{"type":"verse","number":2,"content":["Paˈinne,",{"text":"“Pag laˈi ku dem kasusehan lingananku Tuhanin,","poem":1},{"text":"ubus bu sambunganne ku.","poem":2},{"text":"Pag laˈi ku diyalem lahat meˈ pateyin māku tabang ku","poem":1},{"text":"bu pakale kew si paglingankun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lakasannu ku pī dem kalaleman","poem":1},{"text":"dem tengngaˈ sellang","poem":2},{"lineBreak":true},{"text":"duk sellegin paliput si aku;","poem":2},{"text":"kadebbunan ku weˈ kēmon goyaknun","poem":1},{"text":"duk meˈ goyak mahadjehin.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kannalku, ‘Pinatahalaˈ ku","poem":1},{"text":"amban matanu;","poem":2},{"text":"gaˈi ne kiteku balik","poem":1},{"noteId":0},{"text":"langgalnu masutsihin.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sōng lambo ku weˈ tahik mapaliput si akuhin","poem":1},{"text":"tahik malalemin paliput si aku.","poem":2},{"text":"Meˈ sabet dem tahikin palibed si kōkku.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Palenneb ku pī si poˈon punuhin.","poem":2},{"text":"Pakissup bulakin pag dumiyalem ku","poem":1},{"text":"supaya ku gaˈi lumuwas salama-lama.","poem":2},{"text":"Saguwaˈ kaˈu, Tuhan, Panuhutankun,","poem":1},{"text":"boˈonu du ku balik amban dem kalaleman, ellum pe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pag sōng ubus ne umulkun","poem":1},{"text":"taˈessebte kew, Tuhan;","poem":2},{"text":"ngampun-ngampun ku si kaˈu","poem":1},{"text":"duk tapī pangampunkun si kaˈu","poem":2},{"lineBreak":true},{"text":"diyalem langgalnu masutsihin.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sine-sine nuhut meˈ tuhan-tuhande manggaˈ niyaˈ balinen","poem":1},{"text":"lebbahande ne sandelde si kaˈuhin, Tuhan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Saguwaˈ aku, magpasalamat ku","poem":1},{"text":"duk magkurban ku si kaˈu.","poem":2},{"text":"Meˈ bakas tunggaˈku si kaˈuhin tumananku du.","poem":1},{"text":"Tuhanin hadja manimbulin.”","poem":2}]},{"type":"verse","number":10,"content":["Ubus inin dinaˈak weˈ Tuhanin si Yunus pinaluwas si kennahin pī si higad tahik."]}],"footnotes":[{"noteId":0,"caller":"+","text":"2.4 atawa: Karayaw kiteku balik langgalnu masutsihin.","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":"/api/yka_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yka_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yka_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}