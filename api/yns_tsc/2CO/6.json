{"translation":{"id":"yns_tsc","name":"Bible Iyansi","website":"https://ebible.org/Scriptures/details.php?id=yns","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yns","licenseNotes":null,"shortName":"TSC","englishName":"Yansi NT","language":"yns","textDirection":"ltr","sha256":"99975487305ea2f52b45acd652130021d433afe6a9ba4ace300197c5cda4dfaa","availableFormats":["json"],"listOfBooksApiLink":"/api/yns_tsc/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"Yansi","languageEnglishName":"Yansi"},"book":{"id":"2CO","translationId":"yns_tsc","name":"2 KƆLINTƆ","commonName":"2 KƆLINTƆ","title":"Un'kaan wàyweel akà Akɔlintɔ","order":47,"numberOfChapters":13,"sha256":"bd8fe8892afaf907bbe4c4ee18931614cfecac8c843c7240ed855545e5574978","firstChapterNumber":1,"firstChapterApiLink":"/api/yns_tsc/2CO/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/yns_tsc/2CO/13.json","totalNumberOfVerses":256},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Ntɔn bi ibà abaay ande, bi kàmàlalɛɛl mukɔɔn awal kab a ngway a Nzam a bunàbun."]},{"type":"verse","number":2,"content":["Ntɔn nde an'tɛn naa:",{"text":"« Utaaŋ aŋàbwaŋ, mɛ kàkyer awem,","poem":1},{"lineBreak":true},{"text":"kilä a ngweel a mɔ̈ɔ̈, mɛ kàkyer abay. »","poem":1},"Le, apanà là taaŋ aŋàbwaŋ. Le, apanà kyilä a ngweel a mɔ̈ɔ̈."]},{"type":"verse","number":3,"content":["Bi ikwen anki, itàkal kaben, mubööl mbuur kyà, ntɔn bàkɔ̈ɔ̈n apɛl isal abi."]},{"type":"verse","number":4,"content":["Wɛɛ akà bi, unsà ya yanswà, bi iswɛɛŋà bi ŋakwo naa ndandaa bi ibà asyääl a Nzam",{"text":"u mbwo a muküünà mbɔɔn","poem":1},{"lineBreak":true},{"text":"amu mpay mbɔɔn,","poem":1},{"lineBreak":true},{"text":"amu an'kyà,","poem":1},{"lineBreak":true},{"text":"amu bɔɔmà aŋàdiir,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"amu iki,","poem":1},{"lineBreak":true},{"text":"amu an'bɔlokà,","poem":1},{"lineBreak":true},{"text":"amu lingyoomà,","poem":1},{"lineBreak":true},{"text":"amu yɔ̈ɔ̈n,","poem":1},{"lineBreak":true},{"text":"amu nkɔ̈ɔ̈n a twaal,","poem":1},{"lineBreak":true},{"text":"amu nkiin a isaa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"u mbwo a pɛɛl,","poem":1},{"lineBreak":true},{"text":"u mbwo a ngyööb,","poem":1},{"lineBreak":true},{"text":"u mbwo a nkääŋ a mpem,","poem":1},{"lineBreak":true},{"text":"u mbwo a ubwaŋ,","poem":1},{"lineBreak":true},{"text":"u mbwo a Dweelà In'kyɛɛl,","poem":1},{"lineBreak":true},{"text":"u mbwo a ukwen a ndandaa,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"u mbwo a ndaa a ndandaa,","poem":1},{"lineBreak":true},{"text":"u mbwo a ngwal a Nzam,","poem":1},{"lineBreak":true},{"text":"inwään abi byànwään anà byigyɛɛŋ,","poem":1},{"lineBreak":true},{"text":"yà mukyer ndaa a balàbal u mii a Nzam,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"amu làkoo anà nsaal,","poem":1},{"lineBreak":true},{"text":"amu in'tswe anà nsyäŋà,","poem":1},{"lineBreak":true},{"text":"bàfiwal asànaa aŋatwee,","poem":1},{"lineBreak":true},{"text":"kyekà bi ibà bàndandaa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"bàfiwal asànaa biyöb anki,","poem":1},{"lineBreak":true},{"text":"kyekà bàkiyöb ubwaŋàbwaŋ,","poem":1},{"lineBreak":true},{"text":"bàfiwal asànaa akü,","poem":1},{"lineBreak":true},{"text":"kyekà bi ibà anà mɔ̈ɔ̈,","poem":1},{"lineBreak":true},{"text":"bàfiwal asànaa baar abuntaaŋàmbar,","poem":1},{"lineBreak":true},{"text":"kyekà bi kàkü anki,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"bàfiwal asànaa aŋangyɛb,","poem":1},{"lineBreak":true},{"text":"kyekà taaŋ lanswà bi ibà kun'sak,","poem":1},{"lineBreak":true},{"text":"bàfiwal asànaa aŋàlàmbwà,","poem":1},{"lineBreak":true},{"text":"kyekà bi ifàkyer aŋin'naaŋ mbɔɔn,","poem":1},{"lineBreak":true},{"text":"bàfiwal asànaa bi undiir watɛy,","poem":1},{"lineBreak":true},{"text":"kyekà bi ibye anà indiir byanswà!","poem":1}]},{"type":"verse","number":11,"content":["Atɔŋ a Kɔlintɔ, bi kàyäm anà bɛ u nsaay yanswà, bi kàladuub mpem abi kölàköl."]},{"type":"verse","number":12,"content":["Bi kàladübà anki mpem abi, wɛɛ bɛ lidüüb mpem abɛ."]},{"type":"verse","number":13,"content":["Apanà sye, mɛ in'tɛn a bɛ asànaa akà baan amɛ, bɛ sye làduub mpem abɛ kölàköl!"]},{"type":"heading","content":["Igyɛɛŋ akà baar mpa abà Ayudà"]},{"type":"verse","number":14,"content":["Twon lan'tüüb anà baar bàkɔ̈ɔ̈n làkwikilà. Un'tüüb nà kan'kwo mukäl uboo a balàbal anà ube? Un'tüüb nà uboo a pɛɛlà anà làpib?"]},{"type":"verse","number":15,"content":["Nkwà nà ayà uboo a Klistɔ anà Bɛlyar? Isam nà akyà uboo a ŋàlàkwikilà anà mbuur mpa awà ŋàlàkwikilà?"]},{"type":"verse","number":16,"content":["Undiir nà wun'tüüb uboo a idwà a Nzam anà bànzam a itɛk? Ntɔn bi, bi ibà idwà a Nzam a mɔ̈ɔ̈ asànaa kàtɛn Nzam ŋakwo naa:",{"text":"« Mɛ in'sàkal anà in'sàlyaŋ uboo a ba,","poem":1},{"lineBreak":true},{"text":"mɛ in'sàkal Nzam a ba, ba bàsàkal un'sɛŋ amɛ. »","poem":1}]},{"type":"verse","number":17,"content":["Kyakin,",{"text":"« Làtoo uboo a baar aban, làkäl ukɔl,","poem":1},{"lineBreak":true},{"text":"twon lan'ba akà undiir mwɛy wàŋingyäy,","poem":1},{"lineBreak":true},{"text":"waa mɛ in'sàlawal.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mɛ in'sàkal taa ntɔn bɛ","poem":1},{"lineBreak":true},{"text":"waa bɛ làsàkal baan abaal anà bakaar ntɔn mɛ. » Mwol aŋangwal yanswà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yns_tsc/2CO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yns_tsc/2CO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yns_tsc/2CO/5.json","previousChapterAudioLinks":{},"numberOfVerses":18}