{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"heading","content":["Mina mi Yave midi tho yi mamboti"]},{"type":"verse","number":1,"content":[{"text":"Lusakumunu kuidi mutu wowo wunkambu landakananga","poem":1},{"lineBreak":true},{"text":"zindongi zi batu bambimbi,","poem":1},{"lineBreak":true},{"text":"wunkambu telamanga mu nzila yi minsumuki,","poem":1},{"lineBreak":true},{"text":"ayi wunkambu vuandanga va kimosi ayi mimvuezi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vayi wummonanga khini mu mina mi Yave","poem":1},{"lineBreak":true},{"text":"ayi wunyindulanga miawu muini ayi builu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mutu beni widi banga nti wukunu va muenda nlangu ;","poem":1},{"lineBreak":true},{"text":"wowo wumbutanga makundi mu tsungi andi","poem":1},{"lineBreak":true},{"text":"ayi meza mandi mayumanga ko ;","poem":1},{"lineBreak":true},{"text":"weti mona mamboti mu mamo keti vanganga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vayi buawu ko buididi kuidi batu bambimbi,","poem":1},{"lineBreak":true},{"text":"badi banga biti bivevumunu kuidi phemo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Diawu, batu bambimbi balendi telama ko mu lumbu ki tsambusu,","poem":1},{"lineBreak":true},{"text":"voti bankua masumu mu lukutukunu lu batu basonga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bila Yave zebi nzila yi batu basonga,","poem":1},{"lineBreak":true},{"text":"vayi nzila yi batu bambimbi yela biva.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":6}