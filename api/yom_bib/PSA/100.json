{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":100,"content":[{"type":"heading","content":["Yave wulembo zitusu kuidi batu bandi"]},{"type":"hebrew_subtitle","content":["Nkunga wu phutudulu matondo."]},{"type":"verse","number":1,"content":[{"text":"Yamikinanu mu khini kuidi Yave, ntoto wumvimba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lubuongimina Yave mu khini ;","poem":1},{"lineBreak":true},{"text":"yizanu va ntualꞌandi mu minkunga mi khini.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Luzaba ti Yave niandi Nzambi.","poem":1},{"lineBreak":true},{"text":"Niandi wutuvanga ayi niandi wutuvuidi.","poem":1},{"lineBreak":true},{"text":"Tuidi batu bandi ; nkangu andi, wu mamemi","poem":1},{"lineBreak":true},{"text":"wowo kedi dikila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kotanu mu mielo miandi mu phutudulu matondo","poem":1},{"lineBreak":true},{"text":"ayi mu ziphangu ziandi va kimosi ayi minzitusu.","poem":1},{"lineBreak":true},{"text":"Lumvutudila matondo ayi luzitisa dizina diandi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bila Yave widi wumboti","poem":1},{"lineBreak":true},{"text":"ayi luzolo luandi lunzingila mu zithangu zioso.","poem":1},{"lineBreak":true},{"text":"Ayi kikhuikizi kiandi kidi mu zitsungi zioso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}