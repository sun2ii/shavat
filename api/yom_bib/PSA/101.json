{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"heading","content":["Kukiyekula mu nuanisa mambimbi"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi."]},{"type":"verse","number":1,"content":[{"text":"Ndiela yimbidila luzolo luaku ayi busonga ;","poem":1},{"lineBreak":true},{"text":"Kuidi ngeyo ndiela yimbidila minzitusu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndiela lubaka mu diatila mu luzingu lukambulu tsembolo.","poem":1},{"lineBreak":true},{"text":"Thangu mbi wela kuiza kuidi minu e ?","poem":1},{"lineBreak":true},{"text":"Ndiela diatila mu nzo ama","poem":1},{"lineBreak":true},{"text":"mu ntima wukambulu tsembolo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndilendi tula ko va ntuala meso mama","poem":1},{"lineBreak":true},{"text":"kadi kima kimosi ko kimbimbi.","poem":1},{"lineBreak":true},{"text":"Ndieti lenda mavanga ma bobo","poem":1},{"lineBreak":true},{"text":"bakambulu bakuikama","poem":1},{"lineBreak":true},{"text":"malendi kundama ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Batu badi mintima mi mbimbi thama bela kuthatukila","poem":1},{"lineBreak":true},{"text":"ndilendi vanga kadi diambu dimosi va kimosi ayi mambimbi","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Woso wuntubidila mutu fikimini yandi mu kinsueki,","poem":1},{"lineBreak":true},{"text":"ndiela ku ntula dio sui.","poem":1},{"lineBreak":true},{"text":"Woso widi meso ma lunangu","poem":1},{"lineBreak":true},{"text":"ayi widi ntima wu luniemo ;","poem":1},{"lineBreak":true},{"text":"ndilendi ku nzingisa kuwombo ko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Meso mama mela ba va mikhuikizi","poem":1},{"lineBreak":true},{"text":"mi tsi muingi bakalanga yama ;","poem":1},{"lineBreak":true},{"text":"woso wundiatila mu kambu tsembolo, wela kutsadila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kadi mutu wunsadilanga bukhita","poem":1},{"lineBreak":true},{"text":"lenda vuanda mu nzo ama.","poem":1},{"lineBreak":true},{"text":"Kadi mutu wuntubanga luvunu lenda telama","poem":1},{"lineBreak":true},{"text":"va meso mama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kadika nsuka, ndiela tula dio sui","poem":1},{"lineBreak":true},{"text":"batu boso bambimbi badi va ntoto ;","poem":1},{"lineBreak":true},{"text":"ndiela lalikisa kisadi kioso ki mbimbi","poem":1},{"lineBreak":true},{"text":"mu divula di Yave.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}