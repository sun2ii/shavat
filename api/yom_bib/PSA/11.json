{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"heading","content":["Suamunu ki kiedika"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi."]},{"type":"verse","number":1,"content":[{"text":"Kuidi Yave ndintombilanga suamunu.","poem":1},{"lineBreak":true},{"text":"Buevi lulenda ku khambila :","poem":1},{"lineBreak":true},{"text":"“Tinina ku miongo miaku banga bu ntininanga nuni.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bila tala, batu bambimbi balembo leki mimbasa ;","poem":1},{"lineBreak":true},{"text":"ayi balembo ludika zitsoto va nsinga","poem":1},{"lineBreak":true},{"text":"mi mimbasa muingi babasula, bu badi mu tombi,","poem":1},{"lineBreak":true},{"text":"batu bobo badi mintima mi lulama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Enati zifundasio zitiolumunu,","poem":1},{"lineBreak":true},{"text":"buna mutu wusonga, mbi kalenda vanga e ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yave widi mu nzoꞌandi yinlongo !","poem":1},{"lineBreak":true},{"text":"Yave, kundu kiandi ki luyalu kidi ku diyilu,","poem":1},{"lineBreak":true},{"text":"meso mandi malembo tadi ayi zindabu ziandi","poem":1},{"lineBreak":true},{"text":"zimfionguninanga bana ba batu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yave wumfionguninanga mutu wusonga","poem":1},{"lineBreak":true},{"text":"vayi muelꞌandi weti lenda mutu wumbimbi","poem":1},{"lineBreak":true},{"text":"ayi mutu wowo wunzolanga matsita.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wunokisanga makala ayi sofolo yi mbazu.","poem":1},{"lineBreak":true},{"text":"Kuidi batu bambimbi,","poem":1},{"lineBreak":true},{"text":"Phemo yi mbazu yawu kopo yi ziphasi bela kabana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bila Yave widi wusonga, wunzolanga masonga.","poem":1},{"lineBreak":true},{"text":"Batu badi mintima mi lulama","poem":1},{"lineBreak":true},{"text":"bela talanga zizi kiandi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}