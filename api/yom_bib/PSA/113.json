{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":113,"content":[{"type":"heading","content":["Nzambi yoyi yilendi dedokoso ko"]},{"type":"verse","number":1,"content":[{"text":"Nkembo kuidi Yave !","poem":1},{"lineBreak":true},{"text":"Luzitisa Yave","poem":1},{"lineBreak":true},{"text":"luzitisa beno bisadi bi Yave ;","poem":1},{"lineBreak":true},{"text":"luzitisa dizina di Yave.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bika dizina di Yave dizitusu","poem":1},{"lineBreak":true},{"text":"tona buabu nate mu zithangu zioso ;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bika dizina di Yave dizitusu","poem":1},{"lineBreak":true},{"text":"tona kuntotukilanga thangu nate ku buangu yeti diamina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yave widi wuyayusu ku yilu makanda moso,","poem":1},{"lineBreak":true},{"text":"nkembo andi ku mbata diyilu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nani dedikini banga Yave, Nzambi, eto","poem":1},{"lineBreak":true},{"text":"niandi wutula kundu kiandi ki kipfumu ku yilu","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"mutu wowo weti yinama mu tala diyilu ayi ntoto e ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Weti totula nsukami mu mbungi-mbungi ;","poem":1},{"lineBreak":true},{"text":"ayi niandi weti vumbula nkua kiadi mu dikuka di dibombi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Weti kuba vuandisa va kimosi ayi bana ba mintinu","poem":1},{"lineBreak":true},{"text":"va kimosi ayi bana ba mintinu mi batu bawu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Niandi wuvuandisa sita ki nketo mu nzo ;","poem":1},{"lineBreak":true},{"text":"banga ngudi yi bana yilembo moni khini","poem":1},{"lineBreak":true},{"text":"Luzitisa Yave.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}