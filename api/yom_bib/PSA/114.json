{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"heading","content":["Mu thangu Iseli katotuka mu Ezipite"]},{"type":"verse","number":1,"content":[{"text":"Mu thangu Iseli katotuka mu Ezipite,","poem":1},{"lineBreak":true},{"text":"nzo yi Yakobi mu batu beti tuba mbembo yi nzenza ;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yuda dikituka buangu kinlongo ki Nzambi,","poem":1},{"lineBreak":true},{"text":"Iseli tsi andi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbu wumona ayi wutina ;","poem":1},{"lineBreak":true},{"text":"Yolidani yivutuka ku manima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miongo midumuka banga mamemi mambakala ;","poem":1},{"lineBreak":true},{"text":"miongo mifioti banga bana ba mamemi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A mbi bivangama, ngeyo mbu, muingi wutina","poem":1},{"lineBreak":true},{"text":"ngeyo Yolidani, muingi wuvutuka ku manina e ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ngeyo miongo, muingi wudumuka banga mamemi ma mbakala,","poem":1},{"lineBreak":true},{"text":"miongo mifioti banga bana ba mememi e ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tita, a ntoto, va meso ma Yave","poem":1},{"lineBreak":true},{"text":"va meso ma Nzambi yi Yakobi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Niandi wunkitulanga ditadi buindi ki nlangu,","poem":1},{"lineBreak":true},{"text":"ditadi dingolo zitho zi nlangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}