,{"lineBreak":true},{"text":"ayi ludimi luntubanga mambu mu luniemo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Batu bobo bantubanga :","poem":1},{"lineBreak":true},{"text":"“Tuela nunga mu diambu di ludimi lueto,","poem":1},{"lineBreak":true},{"text":"bididi bieto bidi bieto veka ;","poem":1},{"lineBreak":true},{"text":"nani wulenda ba Pfumu eto ?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bila mu diambu di yamusu ku batu balebakana,","poem":1},{"lineBreak":true},{"text":"ayi kunga ku nsukami ;","poem":1},{"lineBreak":true},{"text":"diawu Yave kakembi buabu :","poem":1},{"lineBreak":true},{"text":"“Buabu ndieka ntelama,","poem":1},{"lineBreak":true},{"text":"ndieka kuba kaka mu diambu di mutu balembo kuba yamisa.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mambu ma Yave madi mavedila banga palata","poem":1},{"lineBreak":true},{"text":"kioki bavedisidi mu mbazu,","poem":1},{"lineBreak":true},{"text":"kivedosolo mu tsambuadi di zikhumbu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yave ngeyo wela kutu keba mu luvovomo","poem":1},{"lineBreak":true},{"text":"wela kutu kaka mu diambu di ntindu wu batu baba,","poem":1},{"lineBreak":true},{"text":"mu thangu yi kayimani.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Batu bambimbi beti vemanga muamo","poem":1},{"lineBreak":true},{"text":"mu thangu bifu bi mbimbi bieti yayusu","poem":1},{"lineBreak":true},{"text":"va khatitsika batu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}