{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"heading","content":["Bika wukhula"]},{"type":"hebrew_subtitle","content":["Nkunga wuyimbudulu mu nzila yikuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Nditela Yave mu ziphasi ziama","poem":1},{"lineBreak":true},{"text":"ayi niandi wupheni mvutu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wuphukisa, a Yave, mu bididi bi luvunu","poem":1},{"lineBreak":true},{"text":"ayi mu ludimi luidi mayuya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mbi kalenda kuvangila","poem":1},{"lineBreak":true},{"text":"ayi mbi kalenda buela, ludimi luidi mayuya e ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wela kuvana thumbudulu mu madionga ma kinuani malengulu bumboti ;","poem":1},{"lineBreak":true},{"text":"mu makala ma mbazu, ma nungu-tsendi,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mabienga kuidi minu bu ndilembo vuandi ku Metsiseki ;","poem":1},{"lineBreak":true},{"text":"bu ndieti zingila mu zinzo zi ngoto zi Kedali.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu bilumbu biwombo ndizingila","poem":1},{"lineBreak":true},{"text":"va khatitsika batu bobo banlendanga ndembama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Minu ndidi mutu wu ndembama ;","poem":1},{"lineBreak":true},{"text":"vayi minu yoluka, buna bawu beka yindula mvita.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}