leka tulu ko","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yave niandi wukusunganga,","poem":1},{"lineBreak":true},{"text":"niandi kitsusula kiaku va koko kuaku ku lubakala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Thangu yilendi ku vanga ko mbimbi va muini","poem":1},{"lineBreak":true},{"text":"voti ngondi va builu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yave wela kukebanga mu mambimbi moso,","poem":1},{"lineBreak":true},{"text":"niandi wela sunganga luzingu luaku.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yave wela kusunga mu kuiza kuaku ayi mu kuenda kuaku","poem":1},{"lineBreak":true},{"text":"tona buabu nate mu zithangu zioso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}