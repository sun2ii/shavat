{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"heading","content":["Lusambila mu diambu di ndembama yi Yelusalemi"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi wuyimbudulu mu nzila yikuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Khini ndimona bu bakhamba ti :","poem":1},{"lineBreak":true},{"text":"“Bika tuendanu ku nzo Yave”.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Malu meto matelimini mu mielo miaku, a Yelusalemi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yelusalemi ditungu banga divula.","poem":1},{"lineBreak":true},{"text":"Diodi dikangama ngolo va kimosi","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuna kueti kuiza zimvila, zimvila Yave","poem":1},{"lineBreak":true},{"text":"mu diambu di zitisa dizina di Yave","poem":1},{"lineBreak":true},{"text":"boso buididi zinzengolo zivanu kuidi Iseli.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bila kuna kutelimini bikundu bi kipfumu bi tsambusulu ;","poem":1},{"lineBreak":true},{"text":"bikundu bi kipfumu bi nzo yi Davidi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lusambila mu diambu di ndembama yi Yelusalemi.","poem":1},{"lineBreak":true},{"text":"Bika bobo beti kuzola bamona luvovomo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bika ndembama yiba mu bibaka biaku","poem":1},{"lineBreak":true},{"text":"ayi luvovomo mu zinzo ziaku zinneni.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mu diambu di bakhomba ziama ayi bakundi bama","poem":1},{"lineBreak":true},{"text":"ndiela tuba “bika ndembama yiba yaku”.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mu diambu di nzo Yave, Nzambi eto, ndiela tomba mamboti maku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}