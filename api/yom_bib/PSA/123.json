{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":123,"content":[{"type":"heading","content":["Mu phingudulu yi nlemvo andi"]},{"type":"hebrew_subtitle","content":["Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Ndimvumbula meso mama kuidi ngeyo Yave","poem":1},{"lineBreak":true},{"text":"ngeyo beki kundu kiaku ki Kipfumu mu diyilu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Banga meso ma bavika meti tala mioko mi bapfumu bawu ;","poem":1},{"lineBreak":true},{"text":"banga meso ma kisadi kinketo mantalanga mioko mi pfumu andi wu nketo ;","poem":1},{"lineBreak":true},{"text":"buawu bobo meso meto mantadilanga kuidi Yave, Nzambi eto,","poem":1},{"lineBreak":true},{"text":"nate kela kutumona kiadi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wutumoni kiadi, a Yave, wutumoni kiadi","poem":1},{"lineBreak":true},{"text":"bila nlenzo wuwombo tutambudi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mvuezolo wuwombo tutambula kuidi bankua luniemo ;","poem":1},{"lineBreak":true},{"text":"nlenzo wuwombo kuidi bankua lunangu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}