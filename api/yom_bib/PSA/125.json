{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":125,"content":[{"type":"heading","content":["Ndembama yi kiedika"]},{"type":"hebrew_subtitle","content":["Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Bobo bantulanga diana diawu mu Yave badi banga mongo wu Sioni,","poem":1},{"lineBreak":true},{"text":"wowo wulendi nikuka ko vayi wunzingilanga mu zithangu zioso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Banga miongo bu mizungididi Yelusalemi,","poem":1},{"lineBreak":true},{"text":"buawu bobo Yave kazungididi batu bandi","poem":1},{"lineBreak":true},{"text":"tona buabu nate mu zithangu zioso.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nkawa wu kipfumu wu batu bambimbi wulendi vuandanga ko","poem":1},{"lineBreak":true},{"text":"va mbata ntoto wukubukulu batu basonga ;","poem":1},{"lineBreak":true},{"text":"bila nganu batu basonga bela sadila mioko miawu mu vanga mambimbi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vanga mamboti, a Yave, kuidi batu bamboti,","poem":1},{"lineBreak":true},{"text":"kuidi bobo badi balulama mu mintima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vayi bobo beti vengama mu diatila mu zinzila zivenga,","poem":1},{"lineBreak":true},{"text":"Yave wela kuba lalikisa va kimosi ayi bobo bamvanganga mambimbi.","poem":1},{"lineBreak":true},{"text":"Ndembama yibanga vadi Iseli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}