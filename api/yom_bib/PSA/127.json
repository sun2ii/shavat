{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"heading","content":["Niandi weti vanga mambu moso"]},{"type":"hebrew_subtitle","content":["Nkunga Salomo wunyimbudulu mu nzila yikuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Enati Yave kakadi tunga nzo,","poem":1},{"lineBreak":true},{"text":"buna batu bobo balembo tungi mu phamba kuandi balembu sadila.","poem":1},{"lineBreak":true},{"text":"Enati Yave kakadi sunga divula","poem":1},{"lineBreak":true},{"text":"buna batu bobo balembo disungi mu phamba kuandi balembo disungila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mu phamba kuandi lueti kotukila nsuka-nsuka","poem":1},{"lineBreak":true},{"text":"ayi lueti kambu vika lekilanga,","poem":1},{"lineBreak":true},{"text":"lueti sadilanga ngolo mu diambu di bidia bi dia ;","poem":1},{"lineBreak":true},{"text":"bila bobuawu keti vanina kuidi bobo keti zola bu badi ku tulu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bana badi kiuka kimbanga kuidi Yave,","poem":1},{"lineBreak":true},{"text":"bosi mbutu wu bana widi mfutu wumbanga kuidi niandi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Banga madionga mu mioko mi kinuani ki lulendo,","poem":1},{"lineBreak":true},{"text":"buawu bobo buididi bana mutu kabutidi mu kimuana kiandi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lusakumunu kuidi mutu wowo wuwesa bawu mu khutu andi.","poem":1},{"lineBreak":true},{"text":"Balendi fua tsoni ko mu thangu bela tubana ayi bambeni ziawu ku muelo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}