{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":128,"content":[{"type":"heading","content":["Bika Yave kasakumuna"]},{"type":"hebrew_subtitle","content":["Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Lusakumunu kuidi batu boso bobo bobo beti kinzika Yave,","poem":1},{"lineBreak":true},{"text":"bandiatilanga mu zinzila ziandi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ngeyo wela dia mbutu wu kisalu kiaku.","poem":1},{"lineBreak":true},{"text":"Lusakumunu ayi mamboti biela ba biaku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nketo aku wela ba banga vinu yidi mbozi yiwombo mu khati nzo aku ;","poem":1},{"lineBreak":true},{"text":"bana baku banga mintiudila mi olive muyendila mezꞌaku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buawu bobo buididi mutu wusakumunu,","poem":1},{"lineBreak":true},{"text":"wowo weti kinzika Yave.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bika Yave kalusakumuna, tona ku Sioni mu bilumbu bioso bi luzingu lueno ;","poem":1},{"lineBreak":true},{"text":"bika lumona mamboti ma Yelusalemi","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ayi bika lumona bana ba bana beno.","poem":1},{"lineBreak":true},{"text":"Bika ndembama yiba vadi Iseli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}