{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":129,"content":[{"type":"heading","content":["Mu phasi ndiba vayi ndisia vonga ko"]},{"type":"hebrew_subtitle","content":["Nkunga wunyimbudulu mu nzila yikuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Bandiamisa ngolo tona mu bumuana buama,","poem":1},{"lineBreak":true},{"text":"bika Iseli katuba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bandiamisa ngolo tona mu bumuana buama","poem":1},{"lineBreak":true},{"text":"vayi basia ku ndunga ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Minkuni midima manima mama ;","poem":1},{"lineBreak":true},{"text":"batula muawu minkala miawu mimula.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vayi Yave widi wusonga ;","poem":1},{"lineBreak":true},{"text":"niandi wuzenga minsinga mi batu bambimbi muingi ndiba mu kiphuanza.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bika babo beti lenda Sioni bavutuka fua tsoni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bika baba banga biti bi mbata muanzu,","poem":1},{"lineBreak":true},{"text":"biobi bieti yuma tuamina biyunduka ;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"biobi mvedi kalendi wesa mu mioko miandi ko ;","poem":1},{"lineBreak":true},{"text":"voti mutu wowo wunkanga mvumba kalendi wesi mu mioko miandi ko.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bika bobo bamviokila vana babika tuba :","poem":1},{"lineBreak":true},{"text":"“lusakumunu lu Yave lubanga yeno !","poem":1},{"lineBreak":true},{"text":"Tueti kulusakumuna mu dizina di Yave !”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}