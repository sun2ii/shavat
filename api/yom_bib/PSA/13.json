diambu ndibika","poem":1},{"lineBreak":true},{"text":"leka tulu tu lufua,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mu diambu mbeni ama kabika tuba :","poem":1},{"lineBreak":true},{"text":"“Ndinnungini” ayi muingi batu beti kundenda babika mona khini","poem":1},{"lineBreak":true},{"text":"minu bua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vayi minu tsidi diana mu luzolo luaku lungolo.","poem":1},{"lineBreak":true},{"text":"Ntimꞌama wulembo moni khini","poem":1},{"lineBreak":true},{"text":"mu phulusu aku.","poem":1},{"lineBreak":true},{"text":"Ndiela yimbidila Yave bila niandi wuphangidi mamboti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":5}