{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"heading","content":["Ku tsi ziphasi nditela Yave."]},{"type":"hebrew_subtitle","content":["Nkunga wunyimbudulu mu nzila yinkuendila ku nzo Yave."]},{"type":"verse","number":1,"content":[{"text":"Bu nditotuka mu mabulu madi thipula,","poem":1},{"lineBreak":true},{"text":"ndiyamikina kuidi ngeyo, a Yave.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A Yave, wa mbemboꞌama ;","poem":1},{"lineBreak":true},{"text":"bika wutamba matu maku mu yamikina kuama mu diambu di lusadusu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Enati ngeyo, a Yave, weti tangisa masumu","poem":1},{"lineBreak":true},{"text":"A Yave buna nani wulenda telama e ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Vayi kuidi ngeyo kuidi ndemvukulu yi masumu ;","poem":1},{"lineBreak":true},{"text":"diawu fueni kinzuku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndimvingila Yave, muelꞌama wulembo vingila ;","poem":1},{"lineBreak":true},{"text":"ayi mu mambu mandi, ndintula diana diama.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muelꞌama wumvingila Yave viokila minsungi mimvingila nsuka.","poem":1},{"lineBreak":true},{"text":"Nyinga viokila minsungi mimvingila nsuka.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A Iseli, tula diana diaku mu Yave","poem":1},{"lineBreak":true},{"text":"Bila mu niandi muidi luzolo lu ngolo","poem":1},{"lineBreak":true},{"text":"ayi mu niandi muidi khudulu yiduka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Niandi veka wela kula Iseli mu masumu mawu moso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}