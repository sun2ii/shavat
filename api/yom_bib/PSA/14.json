{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":14,"content":[{"type":"heading","content":["Nza yidi yi biva"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi."]},{"type":"verse","number":1,"content":[{"text":"Nkua buvulu wuntubanga mu ntimꞌandi ti :","poem":1},{"lineBreak":true},{"text":"Kuisiko Nzambi !","poem":1},{"lineBreak":true},{"text":"Baki bivisidi,","poem":1},{"lineBreak":true},{"text":"mavanga mawu madi mambimbi ;","poem":1},{"lineBreak":true},{"text":"kuisiko mutu wumvanganga mamboti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave, ku yilu ku kadi, wulembo tadi bana","poem":1},{"lineBreak":true},{"text":"ba batu mu tala kani wulenda mona wumosi wunsundika,","poem":1},{"lineBreak":true},{"text":"kani wumosi wuntombanga Nzambi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baboso bavengama ayi bamana kibivisa va kimosi ;","poem":1},{"lineBreak":true},{"text":"kuisiko mutu wumvanganga mamboti,","poem":1},{"lineBreak":true},{"text":"kadi mutu wumosi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Batu boso bamvanganga mambu mambimbi basi nzayilu ko e ?","poem":1},{"lineBreak":true},{"text":"Bobo balembo dia batu bama, banga batu bandia dipha","poem":1},{"lineBreak":true},{"text":"ayi bobo batelanga dizina di Yave ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Buna kuna bela tita mu diambu di tsisi","poem":1},{"lineBreak":true},{"text":"bila Nzambi widi va khatitsika","poem":1},{"lineBreak":true},{"text":"dikabu di batu basonga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Beno mimvangi mi mambimbi,","poem":1},{"lineBreak":true},{"text":"lulenda vunza zikhanu zi nsukami.","poem":1},{"lineBreak":true},{"text":"Vayi Yave niandi suamunu kiandi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A enati phulusu yi Iseli","poem":1},{"lineBreak":true},{"text":"yitotukila ku Sioni !","poem":1},{"lineBreak":true},{"text":"Mu thangu Yave kela vutula kiuka ki batu bandi","poem":1},{"lineBreak":true},{"text":"Bika Yakobi kamona khini ayi Iseli kayangadala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}