{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":15,"content":[{"type":"heading","content":["Nani wulenda zinga ayi Nzambi"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi."]},{"type":"verse","number":1,"content":[{"text":"A Yave, nani wulenda vuanda mu nzo aku yi ngoto e ?","poem":1},{"lineBreak":true},{"text":"Nani wulenda zinga ku mongo aku wunlongo e ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Woso mutu wundiatanga mu kambu tsembolo,","poem":1},{"lineBreak":true},{"text":"wumvanganga mambu ma busonga","poem":1},{"lineBreak":true},{"text":"ayi wuntubanga mambu ma kiedika","poem":1},{"lineBreak":true},{"text":"mantotukanga mu ntimꞌandi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Katubidilanga ko batu mu ludimi luandi ;","poem":1},{"lineBreak":true},{"text":"Kavangilanga ndiandi mambimbi ko","poem":1},{"lineBreak":true},{"text":"ayi kabivisanga nzitusu wu ndiandi ko.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Weti lenza mutu weti vanga mambimbi","poem":1},{"lineBreak":true},{"text":"Vayi wunzitisanga bobo bankinzikanga Yave.","poem":1},{"lineBreak":true},{"text":"Wunkebanga zindefi ziandi.","poem":1},{"lineBreak":true},{"text":"Ka diambu ko yela kummonisa phasi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Katombanga ndandu ko va yilu zimbongo","poem":1},{"lineBreak":true},{"text":"ziozi kadevisa.","poem":1},{"lineBreak":true},{"text":"Ayi kakikininanga ko makaba mu diambu di","poem":1},{"lineBreak":true},{"text":"bedisa mutu kambulu zaba diambu.","poem":1},{"lineBreak":true},{"text":"Woso wumvanganga mambu momo","poem":1},{"lineBreak":true},{"text":"kalendi nikunu ko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}