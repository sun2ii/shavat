 flute ;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lunzitisa mu bisiku bidi banga zitapa ;","poem":1},{"lineBreak":true},{"text":"biobi bieti totula mbembo yingolo ;","poem":1},{"lineBreak":true},{"text":"Lunzitisa mu bisiku bidi banga zitapa,","poem":1},{"lineBreak":true},{"text":"biobi bilembo ningi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bika bibioso bilembo vumuna bizitisa Yave.","poem":1},{"lineBreak":true},{"text":"Luzitisa Yave.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}