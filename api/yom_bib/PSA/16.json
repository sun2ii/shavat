{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":16,"content":[{"type":"heading","content":["Nzila yi luzingu"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi."]},{"type":"verse","number":1,"content":[{"text":"A Nzambi, wukheba mu luvovomo","poem":1},{"lineBreak":true},{"text":"bila kuidi ngeyo nditombila suamunu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuidi Yave ndituba :","poem":1},{"lineBreak":true},{"text":"“Ngeyo Pfumu ama,","poem":1},{"lineBreak":true},{"text":"kuidi ngeyo kaka kueti banga mamboti mama.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mu diambu di banlongo bobo badi mu tsi ;","poem":1},{"lineBreak":true},{"text":"bawu batu banzitusu.","poem":1},{"lineBreak":true},{"text":"Khini yiwombo baku mbonisanga.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bobo banlandakananga zinzambi zinkaka","poem":1},{"lineBreak":true},{"text":"kiadi kiawu kiela buelama,","poem":1},{"lineBreak":true},{"text":"voti ndilendi tambika makaba mawu ma menga ko,","poem":1},{"lineBreak":true},{"text":"Ndilendi tanga mazina mawu mu bididi biama ko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yave ngeyo wuphana ndambu yi kiuka kiama,","poem":1},{"lineBreak":true},{"text":"ayi mbungu ama,","poem":1},{"lineBreak":true},{"text":"ngeyo wunkebanga kuku kiama mu luvovomo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zindili zikubuku mu diambu diama mu buangu bidi kitoko ;","poem":1},{"lineBreak":true},{"text":"bukiedika, thambudi kiuka ki mboti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndiela zitisa Yave ;","poem":1},{"lineBreak":true},{"text":"wukuphananga malongi","poem":1},{"lineBreak":true},{"text":"ntimꞌama wukundonganga mu builu,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndieti tula Yave ku ntualꞌama mu zithangu zioso","poem":1},{"lineBreak":true},{"text":"bila widi ku koko kuama ku lubakala,","poem":1},{"lineBreak":true},{"text":"ndilendi nikuka ko.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Diawu ntimꞌama wididi mu khini ;","poem":1},{"lineBreak":true},{"text":"ludimi luama lueti yangalala","poem":1},{"lineBreak":true},{"text":"ayi nitu ama yela vunda mu luvovomo ;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bila ngeyo wulendi kundiekula ko","poem":1},{"lineBreak":true},{"text":"ku tsi bafua,","poem":1},{"lineBreak":true},{"text":"ayi wulendi tala ko mutu aku wunlongo kabola.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ngeyo wumbonisa nsolo wu luzingu ;","poem":1},{"lineBreak":true},{"text":"zikhini ziwombo zidi va ntuala zizi kiaku.","poem":1},{"lineBreak":true},{"text":"Wela kumbonisa khini va meso maku","poem":1},{"lineBreak":true},{"text":"va kimosi ayi zikhini zika zisukanga ko zidi va koko kuaku ku lubakala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}