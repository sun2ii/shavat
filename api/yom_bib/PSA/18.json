{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":18,"content":[{"type":"heading","content":["Matondo bu wukhula"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi, kisadi ki Yave, kuidi Pfumu minyimbidi. Wuyimbila nkunga wawu mu diambu di Yave mu thangu Yave kankula mu mioko mi bambeni bandi ayi mu mioko mi Sawuli."]},{"type":"verse","number":1,"content":[{"text":"Yave, ndikuzolanga, ngeyo zingolo ziama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A Yave, niandi ditadi diama,","poem":1},{"lineBreak":true},{"text":"tinunu kiama ki ngolo,","poem":1},{"lineBreak":true},{"text":"ayi ngeyo nkudi ama.","poem":1},{"lineBreak":true},{"text":"Nzambi ama, niandi ditadi diama ;","poem":1},{"lineBreak":true},{"text":"mu niandi ndintombila suamunu,","poem":1},{"lineBreak":true},{"text":"niandi nkaku ama, ayi phoka yi phulusu ama,","poem":1},{"lineBreak":true},{"text":"ayi tinunu kiama ki zangama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndiela tela Yave, niandi fueni mu zitusu","poem":1},{"lineBreak":true},{"text":"ayi ndiela vuka mu bambeni ziama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Minsinga mi lufua mimfietikisa.","poem":1},{"lineBreak":true},{"text":"Bosi khuka nlangu yimbunganga yimbuila mu kinzimbukila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Minsinga mi tsi bafua minzingalakana.","poem":1},{"lineBreak":true},{"text":"Mintambu mi lufua mi lekama ku ntualꞌama.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mu ziphasi ziama, nditela Yave","poem":1},{"lineBreak":true},{"text":"Ndiyamikina kuidi Nzambi ama mu tomba lusadusu","poem":1},{"lineBreak":true},{"text":"wuwa mbemboꞌama tona kuna nzoꞌandi,","poem":1},{"lineBreak":true},{"text":"ayi yamikina kuama kutula va ntualꞌandi,","poem":1},{"lineBreak":true},{"text":"mu matu mandi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Buna ntoto wunikuka ayi wutita.","poem":1},{"lineBreak":true},{"text":"Zifondasio zi miongo zinikunu","poem":1},{"lineBreak":true},{"text":"ayi zinikuka, bila wuba wufuema ngolo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Muisi wutotuka mu mayilu mandi,","poem":1},{"lineBreak":true},{"text":"ayi mbazu yi nlalikisanga yitotuka mu munuꞌandi ;","poem":1},{"lineBreak":true},{"text":"muawu mu totukila makala ma mbazu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wukulula diyilu ayi wukuluka,","poem":1},{"lineBreak":true},{"text":"ayi matuti ma ndombe maba ku tsi malu mandi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wukuma va yilu kheluba ayi wudumuka.","poem":1},{"lineBreak":true},{"text":"Wuvevumuka va yilu mavavi ma phemo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wukitula tombi buangu kiandi kisuamina ;","poem":1},{"lineBreak":true},{"text":"kapu andi yiba kunzungidila,","poem":1},{"lineBreak":true},{"text":"tombi kinokisa mvula yi matuti ma diyilu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mu kiezila kiba va ntualꞌandi mutotukila matuti,","poem":1},{"lineBreak":true},{"text":"mvula yi matadi ayi zitsiemo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yave wuduma tona mu Diyilu ;","poem":1},{"lineBreak":true},{"text":"mbembo yi Nzambi yizangama yiwakakana","poem":1},{"noteId":1},{"text":".","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Niandi wuloza madionga mandi","poem":1},{"lineBreak":true},{"text":"ayi wusasikisa bambeni ;","poem":1},{"lineBreak":true},{"text":"zitsiemo zinneni","poem":1},{"lineBreak":true},{"text":"ayi wuba zimbikisa nzila.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tsi nlangu yi mbu yimonika,","poem":1},{"lineBreak":true},{"text":"ayi zifondasio zi ntoto zimonika","poem":1},{"lineBreak":true},{"text":"ngeyo Yave bu wutema mu phemo yitotukila mu mayilu maku.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wunonuna koko kuandi tona ku yilu","poem":1},{"lineBreak":true},{"text":"ayi wutsimba,","poem":1},{"lineBreak":true},{"text":"wuthotula mu minlangu minneni midi thipula.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Niandi wukhula mu mbeni ama yingolo,","poem":1},{"lineBreak":true},{"text":"ayi mu batu bobo bandenda","poem":1},{"lineBreak":true},{"text":"bila bawu bandutila ngolo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bawu banduanisa mu lumbu ki ndiba mu mabienga,","poem":1},{"lineBreak":true},{"text":"vayi Yave niandi wuba singumunu kiama.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Niandi wuthotula ayi wuthula va buangu kikambulu tsisi ;","poem":1},{"lineBreak":true},{"text":"wukhula bila khini kaba monanga mu minu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yave wuphangidi bobo boso buididi busonga buama ;","poem":1},{"lineBreak":true},{"text":"wupheni mfutu boso buididi vedila ku mioko miama","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bila ndikebidi zinzila zi Yave","poem":1},{"lineBreak":true},{"text":"ayi ndisia tamba Nzambi ama mbusa ko","poem":1},{"lineBreak":true},{"text":"mu diambu di vanga mambimbi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mina miandi mioso midi va ntualꞌama","poem":1},{"lineBreak":true},{"text":"ayi ndisia vengama ko mu zithumunu ziandi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ndiba mutu wukambu tsembolo va ntualꞌandi","poem":1},{"lineBreak":true},{"text":"Ndikikeba mu diambu di masumu.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yave wupheni mfutu boso buididi busonga buama,","poem":1},{"lineBreak":true},{"text":"boso buididi vedila ku mioko miama","poem":1},{"lineBreak":true},{"text":"va ntuala meso mandi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kuidi mutu widi wukuikama,","poem":1},{"lineBreak":true},{"text":"ngeyo wukukimonisanga wukuikama.","poem":1},{"lineBreak":true},{"text":"Kuidi mutu wukambulu tsembolo","poem":1},{"lineBreak":true},{"text":"ngeyo wukukimonisanga mutu wukambulu tsembolo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kuidi mutu wuvedila,","poem":1},{"lineBreak":true},{"text":"wukukimonisanga wuvedila.","poem":1},{"lineBreak":true},{"text":"Kuidi mutu wumbimbi,","poem":1},{"lineBreak":true},{"text":"wukukimonisanga wumbimbi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ngeyo wumvukisanga batu beti kukikula","poem":1},{"lineBreak":true},{"text":"ayi wunkululanga meso madi luyanu","poem":1},{"noteId":2},{"text":".","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ngeyo a Yave, keba muindꞌama wuba wulema","poem":1},{"lineBreak":true},{"text":"A Nzambiꞌama, kitula tombi kiama ;","poem":1},{"lineBreak":true},{"text":"kikituka kiezila.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mu lusadusu luaku","poem":1},{"lineBreak":true},{"text":"ndilenda nuanisa nkangu masodi,","poem":1},{"lineBreak":true},{"text":"va kimosi ayi Nzambi ama,","poem":1},{"lineBreak":true},{"text":"ndilenda dumuka baka kikunzama.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Kuidi Nzambi, nzilꞌandi yidi yi fuana,","poem":1},{"lineBreak":true},{"text":"mambu ma Yave madi ma kiedika.","poem":1},{"lineBreak":true},{"text":"Niandi nkaku wu batu boso bobo","poem":1},{"lineBreak":true},{"text":"bansuaminanga mu niandi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bila nani Nzambi, enati ka Yave ko e ?","poem":1},{"lineBreak":true},{"text":"Ayi nani ditadi di ngolo,","poem":1},{"lineBreak":true},{"text":"enati ka Nzambi eto ko e ?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Nzambi, niandi wukuphananga ngolo","poem":1},{"lineBreak":true},{"text":"ayi wunkitulanga nzilꞌama yi fuana.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Wunkitulanga malu mama banga malu ma tsesi,","poem":1},{"lineBreak":true},{"text":"ayi wukuthelimisanga va bibuangu biama bizangama.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Wunlongisanga mioko miama mu nuana mvita,","poem":1},{"lineBreak":true},{"text":"mioko miama milenda leka mbasa wusengo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Wuphana nkaku aku wu ndungunu,","poem":1},{"lineBreak":true},{"text":"ayi koko kuaku ku lubakala kukhindisa","poem":1},{"lineBreak":true},{"text":"ayi wukuluka mu diambu di kukhitula mutu wunneni.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ngeyo wukubikidi nsolo wuyalumuka","poem":1},{"lineBreak":true},{"text":"ku tsi bitambi biama,","poem":1},{"lineBreak":true},{"text":"muingi bikodi biama bibika visuka.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ndikuka bambeni ziama","poem":1},{"lineBreak":true},{"text":"ayi ndizibakidila.","poem":1},{"lineBreak":true},{"text":"Ndisia vutuka manima ko enati ndisia mana kuzivonda.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ndiba kosikisa ayi basia buela baka bu telimina ko ;","poem":1},{"lineBreak":true},{"text":"babua ku tsi malu mama.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ngeyo wuphana zingolo zi nuanina mvita ;","poem":1},{"lineBreak":true},{"text":"Ngeyo weti komvika batu beti kundenda","poem":1},{"lineBreak":true},{"text":"ku tsi malu mama.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Ngeyo wuntinisanga bambeni ziama","poem":1},{"lineBreak":true},{"text":"va ntualꞌama","poem":1},{"lineBreak":true},{"text":"ayi ndibunga bobo bakundendanga.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Bayamikina mu tomba lusadusu,","poem":1},{"lineBreak":true},{"text":"vayi kadi mutu mu kuba vukisa.","poem":1},{"lineBreak":true},{"text":"Bayamikina kuidi Yave","poem":1},{"lineBreak":true},{"text":"vayi kasia ku bavutudila mvutu ko.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Ndiba kosikisa banga mbungi-mbungi","poem":1},{"lineBreak":true},{"text":"yeti vevumunu kuidi phemo.","poem":1},{"lineBreak":true},{"text":"Ndiba loza thama banga nyamba wu zinzila.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Wukhula mu minzonza mi batu,","poem":1},{"lineBreak":true},{"text":"ayi wukhitula ntu wu makanda ;","poem":1},{"lineBreak":true},{"text":"batu bobo ndisia zaba ko, bawu ndiela yadila.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Bu batumbu kungua bathumukina ;","poem":1},{"lineBreak":true},{"text":"banzenza zikikulula va ntualꞌama.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Zinzenza zilembo vongi,","poem":1},{"lineBreak":true},{"text":"balembo titi sumbu bantotuka mu bibuangu biawu bisuama ngolo.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Yave wulembo zingi","poem":1},{"lineBreak":true},{"text":"Nzitusu wuba kuidi ditadi diama","poem":1},{"lineBreak":true},{"text":"yayusu kuba kuidi Nzambi Mvulusi ama.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Niandi Nzambi wukuphutudilanga landi ;","poem":1},{"lineBreak":true},{"text":"ayi wutula makanda ku tsi luyalu luama.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Wuphukisa mi bambeni ziama,","poem":1},{"lineBreak":true},{"text":"Ngeyo wundiayisa va yilu batu bobo bandenda.","poem":1},{"lineBreak":true},{"text":"Ngeyo wukhula mu batu ba matsita.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Diawu ngeyo Yave, ndiela ku zitisa","poem":1},{"lineBreak":true},{"text":"va khatitsika makanda.","poem":1},{"lineBreak":true},{"text":"Ndiela yimbila minzitusu mu diambu","poem":1},{"lineBreak":true},{"text":"di dizina diaku.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Niandi wuvana ndungunu yinneni","poem":1},{"lineBreak":true},{"text":"kuidi ntinu andi","poem":1},{"lineBreak":true},{"text":"ayi wummonisanga mamboti mandi ma ngolo kuidi mutu andi kavinda mafuta","poem":1},{"noteId":3},{"text":",","poem":1},{"lineBreak":true},{"text":"kuidi Davidi ayi nkuna andi mu zithangu zioso.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"18.13 Minkanda minkaka mibuela mvula yi matadi yinoka, makala ma mbazu madoduka.","reference":{"chapter":18,"verse":13}},{"noteId":2,"caller":"+","text":"18.27 Minsekudi minkaka minsadila luniemo va buangu ki luyalu.","reference":{"chapter":18,"verse":27}},{"noteId":3,"caller":"+","text":"18.50 Mutu kavinda mafuta voti kusua ki Yave mu minkanda minkaka.","reference":{"chapter":18,"verse":50}}]},"thisChapterLink":"/api/yom_bib/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}