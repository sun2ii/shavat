{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":19,"content":[{"type":"heading","content":["Zitsongolo zizole zi Nzambi"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi."]},{"type":"verse","number":1,"content":[{"text":"Diyilu dieti samuna nkembo wu Nzambi","poem":1},{"lineBreak":true},{"text":"ayi matuti meti yamikisa kisalu ki mioko miandi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kadika Lumbu kinyamikisa mambu beni","poem":1},{"lineBreak":true},{"text":"kuidi lumbu kinkaka ;","poem":1},{"lineBreak":true},{"text":"ayi builu bumosi bueti ma zabikisa","poem":1},{"lineBreak":true},{"text":"kuidi builu bunkaka.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuisi ko mambu mayoluka voti mambu masadila ;","poem":1},{"lineBreak":true},{"text":"Kunkambu wakana zimbembo ziawu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zimbembo ziawu zieti wakana va ntoto wumvimba.","poem":1},{"lineBreak":true},{"text":"Mambu mawu beti yoluka","poem":1},{"lineBreak":true},{"text":"meti tula nate ku sukisina nza.","poem":1},{"lineBreak":true},{"text":"Ku diyilu katungila nzo yi ngoto","poem":1},{"lineBreak":true},{"text":"mu diambu di thangu :","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yawu yidi banga dibakala dikuela","poem":1},{"lineBreak":true},{"text":"dintotuka va ntuala vinga kiandi,","poem":1},{"lineBreak":true},{"text":"banga dikesa, dieti mona khini mu zawula thinu ;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yintotukilanga ku tsongi yi Diyilu,","poem":1},{"lineBreak":true},{"text":"bosi ku tsongi yinkaka","poem":1},{"lineBreak":true},{"text":"kuawu kamanisinanga nzietolo andi.","poem":1},{"lineBreak":true},{"text":"Kuisiko kima kinsuamanga va ntuala diamu diandi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mina mi Yave midi mifuana,","poem":1},{"lineBreak":true},{"text":"mieti vananga diaka muela luzingu","poem":1},{"lineBreak":true},{"text":"Zinzengolo zi Yave zidi zi kiedika","poem":1},{"lineBreak":true},{"text":"Zinkitulanga mutu wu phamba mutu wu nduenga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Minsiku mi Yave midi mi songa,","poem":1},{"lineBreak":true},{"text":"minyangidikanga ntima.","poem":1},{"lineBreak":true},{"text":"Zithumunu zi Yave zidi zivedila,","poem":1},{"lineBreak":true},{"text":"zinkienzulanga meso.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kinzika Yave didi diambu di vedila,","poem":1},{"lineBreak":true},{"text":"dieti zingila mu zithangu zioso.","poem":1},{"lineBreak":true},{"text":"Zitsikudukusu zi Yave zilenda siwulu diana,","poem":1},{"lineBreak":true},{"text":"zizioso zidi zisonga va kimosi ;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zilutidi thalu ayi nolo ;","poem":1},{"lineBreak":true},{"text":"ayi viokila zinolo ziwombo zivedila","poem":1},{"lineBreak":true},{"text":"zilutidi niosi mu lueki ;","poem":1},{"lineBreak":true},{"text":"zilutidi yoyi yinkumba mu bisila.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mu ziawu mueti lubukila kisadi kiaku ;","poem":1},{"lineBreak":true},{"text":"mfutu wunneni widi mu kuzikebanga.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nani wulenda sudika zinzimbala ziandi e ?","poem":1},{"lineBreak":true},{"text":"Lemvukila zinzimbala ziama zisuama.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Keba kisadi kiaku mu masumu mamvangimina mu luzolo ;","poem":1},{"lineBreak":true},{"text":"mabika ku ndiadila ;","poem":1},{"lineBreak":true},{"text":"buna ndiela ba wukambu tsembolo ;","poem":1},{"lineBreak":true},{"text":"wukambu zaba diambu mu masumu manneni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bika mambu ma munuꞌama ayi mayindu ma ntimꞌama","poem":1},{"lineBreak":true},{"text":"maba ma khini va ntualꞌaku","poem":1},{"lineBreak":true},{"text":"A Yave, ditadi diama ayi nkudi ama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}