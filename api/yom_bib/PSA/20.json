{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"heading","content":["Yave nungisa ntinu eto"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi."]},{"type":"verse","number":1,"content":[{"text":"Bika Yave kavana mvutu bu widi mu ziphasi,","poem":1},{"lineBreak":true},{"text":"bika dizina di Nzambi yi Yakobi dikeba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bika kafidisa lusadusu bu kadi ku buangu kinlongo","poem":1},{"lineBreak":true},{"text":"Bika kakindisa bu kadi ku Sioni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bika katebukila makaba maku moso moyo.","poem":1},{"lineBreak":true},{"text":"Ayi kakikinina makaba maku maviku.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bika kavana bitidi ntimꞌaku.","poem":1},{"lineBreak":true},{"text":"Ayi bika kanungisa zikhubukulu ziaku zioso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tuela yamikina mu khini bu wela tambula ndungunu.","poem":1},{"lineBreak":true},{"text":"Tuela vumbula bidalapo bieto ku Yilu","poem":1},{"lineBreak":true},{"text":"mu dizina di Nzambi eto.","poem":1},{"lineBreak":true},{"text":"Bika Yave kadukisa zindombolo ziaku zioso.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buabu nzebi ti Yave wumvukisanga","poem":1},{"lineBreak":true},{"text":"mutu andi wuka vinda mafuta,","poem":1},{"lineBreak":true},{"text":"weti kumvana mvutu bu kadi ku Diyilu,","poem":1},{"lineBreak":true},{"text":"diandi dinlongo mu lusadusu luandi lungolo,","poem":1},{"lineBreak":true},{"text":"lu koko kuandi ku lubakala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bankaka bantulanga diana mu matoma ma mvita,","poem":1},{"lineBreak":true},{"text":"bankaka mu ziphunda.","poem":1},{"lineBreak":true},{"text":"Vayi beto tuntulanga diana","poem":1},{"lineBreak":true},{"text":"mu dizina di Yave, Nzambi eto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bawu beti fukama mu makuma mawu ayi beti bua ;","poem":1},{"lineBreak":true},{"text":"Vayi beto tueti telama ayi tuidi kaka bakinda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yave vukisa ntinu","poem":1},{"lineBreak":true},{"text":"Bika wutuvana mvutu mu thangu tueti tela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}