{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":22,"content":[{"type":"heading","content":["A Nzambi ama, bila mbi wundiekudidi e ?"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi, wuyimbidila wawu mu nningu wu beti tedilanga “Nsuma wu nsuka”."]},{"type":"verse","number":1,"content":[{"text":"Nzambi ama, Nzambi ama,","poem":1},{"lineBreak":true},{"text":"bila mbi wundiekuididi e ?","poem":1},{"lineBreak":true},{"text":"Ayi bila mbi wididi thama mu kambu ku phukisa e ?","poem":1},{"lineBreak":true},{"text":"Ayi bila mbi wididi thama mu kambu wa maniongo mama e ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nzambi ama, ndinyamikina va muini,","poem":1},{"lineBreak":true},{"text":"vayi wukadi vutula mvutu.","poem":1},{"lineBreak":true},{"text":"Va builu, ndivuandanga ko dio sui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vayi ngeyo wubieko banga wunlongo.","poem":1},{"lineBreak":true},{"text":"Ngeyo nzitusu wu Iseli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mu ngeyo bakulu beto batula diana diawu.","poem":1},{"lineBreak":true},{"text":"Batula diana diawu mu ngeyo ayi wuba kula.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuidi ngeyo bayamikina","poem":1},{"lineBreak":true},{"text":"ayi ngeyo wuba vukisa.","poem":1},{"lineBreak":true},{"text":"Mu ngeyo batula diana diawu","poem":1},{"lineBreak":true},{"text":"ayi basia fuisu tsoni ko.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vayi minu, ndidi kiela vayi bika mutu.","poem":1},{"lineBreak":true},{"text":"Babakala balembo mvuezi,","poem":1},{"lineBreak":true},{"text":"batu balembo ndenzi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Babo bobo beti kumbona beti ku tsekinina.","poem":1},{"lineBreak":true},{"text":"Beti finga.","poem":1},{"lineBreak":true},{"text":"Beti nikuna mintu :","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Kuidi Yave keti tula diana diandi","poem":1},{"lineBreak":true},{"text":"buna bika kamvukisa, bika kankula bila khini keti mona mu niandi.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vayi, ngeyo wuthotula mu vumu ;","poem":1},{"lineBreak":true},{"text":"wuvanga ti nditula diana diama mu ngeyo","poem":1},{"lineBreak":true},{"text":"banga va thulu yi ngudi ama.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tona ndibutuka ndiyekulu kuidi ngeyo tona mu vumu ki ngudi ama.","poem":1},{"lineBreak":true},{"text":"Tona mu vumu ki ngudi ama,","poem":1},{"lineBreak":true},{"text":"ngeyo wuba Nzambi ama.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kadi kuthatukila bila ziphasi zifikimini,","poem":1},{"lineBreak":true},{"text":"bila kuisi ko mutu wulenda sadisa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zingombi ziwombo zimbakala zinzungididi,","poem":1},{"lineBreak":true},{"text":"zingombi zi Basani zinzungididi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mu kunga ku khosi yeti kanzuna bulu","poem":1},{"lineBreak":true},{"text":"miunu miawu midi mizibuka ngolo mu diambu diama","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mbeni dukuka banga nlangu","poem":1},{"lineBreak":true},{"text":"ayi mimvesi miama mioso mivasukidi.","poem":1},{"lineBreak":true},{"text":"Ntimꞌama widi banga mafuta beti vindanga mu mabaya.","poem":1},{"lineBreak":true},{"text":"Wulembo siuti mu khati yi nitu ama.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zingolo ziama zilembo yumi","poem":1},{"lineBreak":true},{"text":"banga tini ki nzungu tuma","poem":1},{"lineBreak":true},{"text":"ayi ludimi luama lunemi mu munu ama.","poem":1},{"lineBreak":true},{"text":"Ngeyo wuthula mu mbungi-mbungi yi lufua.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Zimbwa zinzungididi,","poem":1},{"lineBreak":true},{"text":"Nkangu wu batu bambimbi banzungididi.","poem":1},{"lineBreak":true},{"text":"Batobudi mioko miama ayi malu mama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ndilenda tanga mimvesi miama mioso.","poem":1},{"lineBreak":true},{"text":"Batu beti kutsungimina ayi balembo thadi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Balembo kabana bawu na bawu minlele miama","poem":1},{"lineBreak":true},{"text":"ayi balembo budila yunga kiama tsombo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Vayi ngeyo Yave, kadi ba thama.","poem":1},{"lineBreak":true},{"text":"Ngeyo zingolo ziama ayi yiza nsualu mu kutsadisa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kula luzingu luama mu sabala ;","poem":1},{"lineBreak":true},{"text":"luzingu luama lu thalu mu luyalu lu zimbua.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wukhudi mu munu wu khosi","poem":1},{"lineBreak":true},{"text":"wuphukisa mu ziphoka zi ziphaka.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ndiela yolukila dizina diaku","poem":1},{"lineBreak":true},{"text":"kuidi bakhomba baama ;","poem":1},{"lineBreak":true},{"text":"ndiela ku zitisa va khatitsika lukutukunu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Beno lunkinzikanga Yave,","poem":1},{"lineBreak":true},{"text":"bika lunzitisa !","poem":1},{"lineBreak":true},{"text":"Beno babo luidi mu nkuna Yakobi,","poem":1},{"lineBreak":true},{"text":"bika lunkinzika !","poem":1},{"lineBreak":true},{"text":"Beno babo luidi mu nkuna wu Iseli,","poem":1},{"lineBreak":true},{"text":"bika lunzitisa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Bila kasia lenza ko ayi kasia kakumukina ko","poem":1},{"lineBreak":true},{"text":"ziphasi zi mutu widi mu phasi ;","poem":1},{"lineBreak":true},{"text":"kasia kunsuekila zizi kiandi ko","poem":1},{"lineBreak":true},{"text":"vayi weti wa yamikina kuandi","poem":1},{"lineBreak":true},{"text":"bu keti tomba lusadusu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kuidi ngeyo kueti totukila minzitusu miama mu lukutukunu lunneni","poem":1},{"lineBreak":true},{"text":"va ntuala bobo beti ku kinzika,","poem":1},{"lineBreak":true},{"text":"ndiela dukisa zitsila ziama.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Minsukami miela dia ayi miela yukuta.","poem":1},{"lineBreak":true},{"text":"Bobo beti tomba Yave bela kumvana nzitusu.","poem":1},{"lineBreak":true},{"text":"Bika mintima mieno mizinga mu zithangu zioso !","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Zitsuka zioso zi ntoto ziela tebuka moyo ;","poem":1},{"lineBreak":true},{"text":"Ziela baluka kuidi Yave.","poem":1},{"lineBreak":true},{"text":"Batu ba makanda moso bela buongama va ntualꞌaku.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bila Kipfumu kidi kuidi Yave ;","poem":1},{"lineBreak":true},{"text":"niandi wunyadilanga makanda.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Batu boso badi kimvuama ba ntoto bela dia","poem":1},{"lineBreak":true},{"text":"ayi mamvawu bela buongama.","poem":1},{"lineBreak":true},{"text":"Babo bankulukanga mu mbungi-mbungi","poem":1},{"lineBreak":true},{"text":"bela komvama va ntualꞌandi ;","poem":1},{"lineBreak":true},{"text":"bobo bankambu baka","poem":1},{"lineBreak":true},{"text":"bu zingisila luzingu luandi bawu veka.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Nkuna wela ku nsadila.","poem":1},{"lineBreak":true},{"text":"Batu bela samuna mambu matedi Yave kuidi tsungi yinkuiza.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bela yolukila busonga buandi","poem":1},{"lineBreak":true},{"text":"kuidi batu bobo babutukidi ko.","poem":1},{"lineBreak":true},{"text":"Bila niandi wuvanga mambu mama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}