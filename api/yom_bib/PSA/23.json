{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"heading","content":["Pfumu niandi nsungi ama"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi."]},{"type":"verse","number":1,"content":[{"text":"Yave niandi nsungi ama,","poem":1},{"lineBreak":true},{"text":"ndilendi kambu kadi kima ko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Niandi wukuphundisanga muidi biti binlangu,","poem":1},{"lineBreak":true},{"text":"Wukundatanga kuidi minlangu milembama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niandi wunkindisanga muelꞌama.","poem":1},{"lineBreak":true},{"text":"Niandi wukundiatisanga mu minsolo misonga","poem":1},{"lineBreak":true},{"text":"mu diambu di dizina diandi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ka diambu ko ndilenda diata","poem":1},{"lineBreak":true},{"text":"mu ndimba tombi ki lufua,","poem":1},{"lineBreak":true},{"text":"buna ndilendi mona mbimbi tsisi ko","poem":1},{"lineBreak":true},{"text":"bila ngeyo widi yama.","poem":1},{"lineBreak":true},{"text":"Nkawa aku ayi nti aku,","poem":1},{"lineBreak":true},{"text":"biawu bi kumbombanga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ngeyo wukubika meza va ntualꞌama","poem":1},{"lineBreak":true},{"text":"va meso ma bambeni ziama.","poem":1},{"lineBreak":true},{"text":"Ngeyo wuvinda ntuꞌama mafuta","poem":1},{"lineBreak":true},{"text":"mbungu ama yilembo sapika.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bukiedika, mamboti maku ayi luzolo","poem":1},{"lineBreak":true},{"text":"biela kundandakana mu bilumbu bioso bi luzingu luama.","poem":1},{"lineBreak":true},{"text":"Ayi ndiela vuanda mu nzo Yave","poem":1},{"lineBreak":true},{"text":"mu zithangu zioso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}