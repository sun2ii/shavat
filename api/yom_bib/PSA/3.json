{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"heading","content":["Kuidi Yave kumbanga phulusu"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi mu thangu katina muanꞌandi Abisaloni."]},{"type":"verse","number":1,"content":[{"text":"A Yave, tala buevi badidi woka bobo bandendidi ;","poem":1},{"lineBreak":true},{"text":"batu bawombo balembo ndiendila manenga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bawombo balembo tubi mu diambu diama :","poem":1},{"lineBreak":true},{"text":"“Nzambi kalendi kunkula ko.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Vayi ngeyo, widi nkaku ama, a Yave.","poem":1},{"lineBreak":true},{"text":"Ngeyo nkemboꞌama, ngeyo wumvumbulanga ntu ama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndinyamikinanga kuidi Yave.","poem":1},{"lineBreak":true},{"text":"Niandi wukuphutudilanga mvutu tona ku mongo andi wunlongo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndinlambadala, ndinleka tulu ayi ndinkotukanga ;","poem":1},{"lineBreak":true},{"text":"bila Yave niandi wukukhebanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nditinanga ko tsisi yi makabu mawombo-wombo","poem":1},{"lineBreak":true},{"text":"ma batu bobo banzungididi ndambu ayi ndambu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yave telama ; ngeyo Nzambi ama, wukhudi.","poem":1},{"lineBreak":true},{"text":"Bila ngeyo wubetidi bambeni baama baoso mu matama.","poem":1},{"lineBreak":true},{"text":"Wukoludi meno ma batu bambimbi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuidi Yave kumbanga phulusu.","poem":1},{"lineBreak":true},{"text":"Bika lusakumunu luaku luba kuidi batu baku !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}