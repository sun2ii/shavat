{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":30,"content":[{"type":"heading","content":["Ngeyo wuphutudila luzingu"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kayimbidila mu mbiekolo nzo Nzambi."]},{"type":"verse","number":1,"content":[{"text":"Ndiela kuyayisa, a Yave","poem":1},{"lineBreak":true},{"text":"bila ngeyo wuthotula mu dibulu didi thipula","poem":1},{"lineBreak":true},{"text":"Wusia tia ko ti bambeni ziama zimona khini","poem":1},{"lineBreak":true},{"text":"mu diambu diama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A Yave, Nzambi ama, ngeyo nditela mu diambu di lusadusu","poem":1},{"lineBreak":true},{"text":"ayi ngeyo wumbelusa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yave, ngeyo wuthotula mu tsi bafua,","poem":1},{"lineBreak":true},{"text":"ngeyo wuthanina muingi ndibika tibuka mu dibulu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Luyimbidila Yave beno banlongo bandi ;","poem":1},{"lineBreak":true},{"text":"Zitisanu dizina diandi di nlongo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bila nganzi andi yizingilanga mu ndambu thangu kaka.","poem":1},{"lineBreak":true},{"text":"Vayi nlemvo andi wunzinganga mu zithangu zioso ;","poem":1},{"lineBreak":true},{"text":"bidilu bilenda kuiza va builu ;","poem":1},{"lineBreak":true},{"text":"vayi khini yinkuizanga va nsuka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bu ndiba mu luvovomo, ndituba :","poem":1},{"lineBreak":true},{"text":"“Ndilendi nikunu ko”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A Yave, mu nlemvo aku,","poem":1},{"lineBreak":true},{"text":"ngeyo wukindisa mongoꞌama…","poem":1},{"lineBreak":true},{"text":"vayi bu wusueka zizi kiaku buna minu ndimona boma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuidi ngeyo, a Yave, nditela mbila.","poem":1},{"lineBreak":true},{"text":"Kuidi Yave ndiyamikina mu diambu di lusadusu","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Ndandu mbi yidi mu mbivusu ama, minu kuluka mu dibulu e ?","poem":1},{"lineBreak":true},{"text":"Mbungi-mbungi yilenda kuzitisa e ?","poem":1},{"lineBreak":true},{"text":"Voti yilenda yamikina kikhuikizi kiaku e ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A Yave wa, wumboni kiadi,","poem":1},{"lineBreak":true},{"text":"A yave, bika wuba lusadusu luama.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ngeyo wuviakisa bidilu biama makinu,","poem":1},{"lineBreak":true},{"text":"wunianguna tsaku ama ayi wuphuika khini.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Muingi ntimꞌama wuyimbidila minkunga","poem":1},{"lineBreak":true},{"text":"ayi wubika ba dio sui.","poem":1},{"lineBreak":true},{"text":"A Yave, Nzambi ama, ndiela ku vutudilanga mu zithangu zioso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}