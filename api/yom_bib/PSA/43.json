{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"heading","content":["Tula diana diaku mu Nzambi"]},{"type":"verse","number":1,"content":[{"text":"Wundungisa, a Nzambi,","poem":1},{"lineBreak":true},{"text":"ayi wunzonzila mu mambu mama kuidi dikanda di batu dinkambu","poem":1},{"lineBreak":true},{"text":"kinzikanga mambu maku.","poem":1},{"lineBreak":true},{"text":"Wukhula mu batu ba luvunu ayi batu bambimbi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ngeyo Nzambi, ngeyo zingolo ziama.","poem":1},{"lineBreak":true},{"text":"Bila mbi wundozidi e ?","poem":1},{"lineBreak":true},{"text":"Bila mbi mfueti diatilanga mu phasi,","poem":1},{"lineBreak":true},{"text":"yamusungu kuidi mbeni e ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fidisa kiezila ayi Kiedika kiaku ;","poem":1},{"lineBreak":true},{"text":"bila bindiatisa,","poem":1},{"lineBreak":true},{"text":"bika bindata ku mongo aku wunlongo","poem":1},{"lineBreak":true},{"text":"ayi nate ku buangu kioki weti vuanda.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buna ndiela kuenda ku ntala wu Nzambi ;","poem":1},{"lineBreak":true},{"text":"kuidi Nzambi khini ama","poem":1},{"lineBreak":true},{"text":"ayi yangalala kuama.","poem":1},{"lineBreak":true},{"text":"Buna ndiela kunzitisa mu ngitala,","poem":1},{"lineBreak":true},{"text":"A Nzambi, Nzambi ama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bila mbi vongidi bobo, a muelꞌala e ?","poem":1},{"lineBreak":true},{"text":"Bila mbi wulembo niongina mu khati ama e ?","poem":1},{"lineBreak":true},{"text":"Tula diana diaku mu Nzambi bila ndiela kunzitisa diaka,","poem":1},{"lineBreak":true},{"text":"Mvulusi ama ayi Nzambi ama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}