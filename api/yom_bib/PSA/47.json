{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"heading","content":["Lusikila Nzambi zitsiaki"]},{"type":"hebrew_subtitle","content":["Nkunga bana ba babakala ba Kole kuidi pfumu minyimbidi."]},{"type":"verse","number":1,"content":[{"text":"Lusika zitsiaki, beno makanda moso.","poem":1},{"lineBreak":true},{"text":"Luyamikina kuidi Nzambi mu khini,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tala phila Yave yizangama kadidi tsisi !","poem":1},{"lineBreak":true},{"text":"Niandi ntinu wunneni va mbata ntoto wumvimba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wutula makanda ku tsi buvika bueto,","poem":1},{"lineBreak":true},{"text":"batu ku tsi malu meto.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wutusobudila kiuka ;","poem":1},{"lineBreak":true},{"text":"luniemo lu Yakobi ; mutu wu kazola.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nzambi wukuma va khatitsika yamikina ku khini","poem":1},{"lineBreak":true},{"text":"Yave wukuma va khatitsika biyoko bi tulumbeta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Luyimbila minzitusu kuidi Nzambi","poem":1},{"lineBreak":true},{"text":"Luyimbila minzitusu ;","poem":1},{"lineBreak":true},{"text":"Luyimbila minzitusu kuidi Nzambi eto,","poem":1},{"lineBreak":true},{"text":"luyimbila minzitusu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bila Nzambi niandi ntinu wu ntoto wumvimba ;","poem":1},{"lineBreak":true},{"text":"Lunyimbidila nkunga wu nzitusu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nzambi weti yadila makanda moso.","poem":1},{"lineBreak":true},{"text":"Nzambi vuendi va kundu kiandi kinlongo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Batu banneni ba makanda bakutikini","poem":1},{"lineBreak":true},{"text":"banga batu ba Nzambi yi Abalahami","poem":1},{"lineBreak":true},{"text":"bila Nzambi niandi vuidi mintinu mi ntoto.","poem":1},{"lineBreak":true},{"text":"Niandi wuyayusu ngolo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}