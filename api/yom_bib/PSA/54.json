{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"heading","content":["Nzambi wukhula"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi kayimbidila mu mu thangu basi Zifi bayiza kamba Sawuli ti : “Davidi kuidi beto” kasuamini."]},{"type":"verse","number":1,"content":[{"text":"Wuphukisa, Nzambi ama, mu dizina diaku ;","poem":1},{"lineBreak":true},{"text":"wundungisa mu lulendo luaku.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wa lusambulu luama, a Nzambi.","poem":1},{"lineBreak":true},{"text":"Dimba mambu ma munuꞌama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zinzenza zilembo nduanisa","poem":1},{"lineBreak":true},{"text":"ayi batu ba tsita balembo tombi luzingu luama.","poem":1},{"lineBreak":true},{"text":"Batu bankambu kinzikanga Nzambi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bukiedika, Nzambi niandi nsadisi ama.","poem":1},{"lineBreak":true},{"text":"Yave niandi wukukhindisanga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bika mambimbi mabuila bobo beti kuphueza ;","poem":1},{"lineBreak":true},{"text":"Mu kikhuikizi kiaku, wuba bunga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndiela kutambikanga makaba","poem":1},{"lineBreak":true},{"text":"mu ntima wu luzolo ;","poem":1},{"lineBreak":true},{"text":"ndiela zitisa dizina diaku, a Yave.","poem":1},{"lineBreak":true},{"text":"Bila didi dimboti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bila niandi wukhula mu ziphasi ziama zioso","poem":1},{"lineBreak":true},{"text":"ayi meso mama mamona mbedoso","poem":1},{"lineBreak":true},{"text":"yi bobo beti kundenda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}