{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":55,"content":[{"type":"heading","content":["Ndidi mutu wuvakulu"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi, kayimbidila."]},{"type":"verse","number":1,"content":[{"text":"Dimba lusambulu luama, a Nzambi ;","poem":1},{"lineBreak":true},{"text":"ayi kadi zimbakana mambu mama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wunguila ayi wuphani mvutu ;","poem":1},{"lineBreak":true},{"text":"mayindu mama malembo mbonisa phasi ayi ndilembo sambi ;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"mu diambu di mbembo yi mbeni ;","poem":1},{"lineBreak":true},{"text":"mu diambu di yamusu ku mutu wumbimbi","poem":1},{"lineBreak":true},{"text":"bila minu beti yekikilanga ziphasi","poem":1},{"lineBreak":true},{"text":"bila balembo mfingi mu nganzi awu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ntimꞌama widi mu maniongo mu minu ;","poem":1},{"lineBreak":true},{"text":"ayi boma bu lufua lu mbuididi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsisi ayi lukhuku bieka mu minu","poem":1},{"lineBreak":true},{"text":"ayi boma bu ngolo bumbuididi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buna ndituba : “Enati ndiba ayi mavavi ma dibembi","poem":1},{"lineBreak":true},{"text":"nganu ndieka tumbu dumuka","poem":1},{"lineBreak":true},{"text":"ayi ba mu luvundulu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nganu, ndiela tinina ku thama,","poem":1},{"lineBreak":true},{"text":"ayi vuanda ku dikanga.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ndiela tina nsualu mu tomba suamunu","poem":1},{"lineBreak":true},{"text":"ku buangu kikambulu phemo yingolo","poem":1},{"lineBreak":true},{"text":"ayi vuka kingolo.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kotisa batu bambimbi mu divuda, A Yawe","poem":1},{"lineBreak":true},{"text":"ayi vunzikisa mambu mawu bantuba.","poem":1},{"lineBreak":true},{"text":"Bila ndilembo moni makhemi","poem":1},{"lineBreak":true},{"text":"ayi ziphaka mu divula.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muini ayi builu,","poem":1},{"lineBreak":true},{"text":"makhemi ayi ziphaka bizungidila bibaka bi divula ;","poem":1},{"lineBreak":true},{"text":"diela dimbimbi ayi kambu dukisa zitsila bieka mu khati divula.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mbivusu kiawu kisalu kieka mu khati divula ;","poem":1},{"lineBreak":true},{"text":"khuamusu ayi luvunu bikadi botuka mu zinzila zi divula.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Enati mbeni wumfingidi","poem":1},{"lineBreak":true},{"text":"nganu ndikimba moyo ;","poem":1},{"lineBreak":true},{"text":"enati mutu wukundendanga niandi weti","poem":1},{"lineBreak":true},{"text":"kukiniemisa va ntualꞌama","poem":1},{"lineBreak":true},{"text":"nganu ndisuama kuama va ntualꞌama.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vayi ngeyo, mutu banga minu","poem":1},{"lineBreak":true},{"text":"wundiatanga yama va kimosi ;","poem":1},{"lineBreak":true},{"text":"nkundi ama wu kuikama ;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"mutu wowo wubedi kalanga yama mu khini ;","poem":1},{"lineBreak":true},{"text":"wubedi kibanga va kimosi","poem":1},{"lineBreak":true},{"text":"ayi nkangu wu batu ku Nzo Nzambi !","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bika lufua lu bibuila bambeni ziama mu kinzimbukila","poem":1},{"lineBreak":true},{"text":"ayi bika bakuluka bamoyo ku tsi bafua !","poem":1},{"lineBreak":true},{"text":"Bila mambimbi mabakudi buangu va khatitsikꞌawa,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mbadi minu, ndintela Nzambi,","poem":1},{"lineBreak":true},{"text":"ayi Yave wuphukisidi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yiba nsuka, midi ayi masika,","poem":1},{"lineBreak":true},{"text":"Ndieti yamikina mu ziphasi ;","poem":1},{"lineBreak":true},{"text":"ayi weti wa mbembo ama.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wukukhulanga wumbimba, mu kambu sumbula","poem":1},{"lineBreak":true},{"text":"mu mvita yi banduanisa","poem":1},{"lineBreak":true},{"text":"ka diambu ko bawombo banduanisa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nzambi wunyadila va kundu kiandi ki luyalu mu zithangu zioso","poem":1},{"lineBreak":true},{"text":"wela kuba wa ayi wela kuba monisa phasi ;","poem":1},{"lineBreak":true},{"text":"batu bobo balendi balula zinzila ziawu ko","poem":1},{"lineBreak":true},{"text":"ayi bakinzikanga Nzambi ko.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mutu wundiatanga yama wulembo","poem":1},{"lineBreak":true},{"text":"nuanisa bakundi bandi","poem":1},{"lineBreak":true},{"text":"wubundula Nguizani andi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mambu mandi ndelo madi","poem":1},{"lineBreak":true},{"text":"banga dibela","poem":1},{"noteId":5},{"lineBreak":true},{"text":"muaki mvita yidi mu ntimꞌandi ;","poem":1},{"lineBreak":true},{"text":"Mambu mandi madi malebila viokila mafuta","poem":1},{"lineBreak":true},{"text":"muaki madi banga bisabala bikubimini mu vonda.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yekula bizitu biaku kuidi Yave,","poem":1},{"lineBreak":true},{"text":"niandi wela kukindisa ; kalendi tala ko","poem":1},{"lineBreak":true},{"text":"ti mutu wusonga kabua.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Vayi ngeyo Nzambi, wela buisa batu bambimbi ;","poem":1},{"lineBreak":true},{"text":"mintengudi mi menga ayi bankua livunu","poem":1},{"lineBreak":true},{"text":"bela dukisa ko ndambu yi bilumbu biawu ;","poem":1},{"lineBreak":true},{"text":"vayi minu diana diama didi mu ngeyo.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"55.21 Dibela: didi mafuta beti vindanga mu mapha.","reference":{"chapter":55,"verse":21}}]},"thisChapterLink":"/api/yom_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}