{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":57,"content":[{"type":"heading","content":["Ndidi mu ndembama va khatitsika bambeni"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi “kadi vonda.” Mu thangu kasuamina mu nluka matadi Sawuli bu kaba kunkuka."]},{"type":"verse","number":1,"content":[{"text":"Wumboni kiadi, a Nzambi,","poem":1},{"lineBreak":true},{"text":"wumboni kiadi !","poem":1},{"lineBreak":true},{"text":"Bila muelꞌama wunsuaminanga mu ngeyo","poem":1},{"lineBreak":true},{"text":"ndiela suamina ku kitsusula ki mavavi maku,","poem":1},{"lineBreak":true},{"text":"nate mabienga mela mana vioka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndiela yamikina kuidi Nzambi yizangama ;","poem":1},{"lineBreak":true},{"text":"kuidi Nzambi weti dukisa zikhanu ziandi kuidi minu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Weti fidisa tona ku diyilu ayi weti kuphukisa ;","poem":1},{"lineBreak":true},{"text":"mu temina bobo beti kundandakana mu kingolo ;","poem":1},{"lineBreak":true},{"text":"Nzambi weti fidisa luzolo luandi","poem":1},{"lineBreak":true},{"text":"ayi kikhuikizi kiandi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndidi va khatitsika zikhosi ;","poem":1},{"lineBreak":true},{"text":"ndidi wulambalala va khatitsika bibulu bindianga minsuni ;","poem":1},{"lineBreak":true},{"text":"batu bobo meno mawu madi banga madionga mafioti ayi maneni","poem":1},{"lineBreak":true},{"text":"ludimi luawu luidi sabala yisekoso ngolo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yayusu kuaku, a Nzambi, ku yilu diyilu","poem":1},{"lineBreak":true},{"text":"Bika nkembo aku wuba va ntoto wumvimba !","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Batambila malu mama dikondi.","poem":1},{"lineBreak":true},{"text":"Ndiba wukomvama mu ziphasi ;","poem":1},{"lineBreak":true},{"text":"Bakaba dibulu dinnene mu nsolo ama :","poem":1},{"lineBreak":true},{"text":"vayi bawu veka ba buidi muawu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ntimꞌama widi wukinda a Nzambi ;","poem":1},{"lineBreak":true},{"text":"ntimꞌama widi wukinda.","poem":1},{"lineBreak":true},{"text":"Ndiela yimbila, ndiela bula miziki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kotuka, muelꞌama !","poem":1},{"lineBreak":true},{"text":"Kotukanu, ngeyo Luti ayi ngitala","poem":1},{"lineBreak":true},{"text":"ndiela kotula khiesa ki lumbu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ndiela kuzitisa, a Yave, va khatitsika makanda.","poem":1},{"lineBreak":true},{"text":"Ndiela kuyimbidila va khatitsika batu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bila luzolo luaku luidi lunneni, luntulanga nate kuna diyilu,","poem":1},{"lineBreak":true},{"text":"kikhuikizi kiaku kintulanga nate ku matuti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yayusu kuaku, a Nzambi, ku yilu Diyilu.","poem":1},{"lineBreak":true},{"text":"Bika nkemboꞌaku wuba va ntoto wumvimba !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}