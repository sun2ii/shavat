{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":59,"content":[{"type":"heading","content":["Nzambi ama, wukhudi."]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi “Kadi vonda” mu thangu Sawuli kafidisa batu bazungidila nzo Davidi mu diambu bamvonda."]},{"type":"verse","number":1,"content":[{"text":"Wukhula mu bambeni ziama, a Nzambi ;","poem":1},{"lineBreak":true},{"text":"wukhebi mu diambu bobo bamfuemini !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wukhudi mu mimvangi mi mambimbi","poem":1},{"lineBreak":true},{"text":"ayi wuphukisa mu mintengudi mi menga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tala phila balambididi mu kuphingila.","poem":1},{"lineBreak":true},{"text":"Batu badi ngolo bandiendidi manenga","poem":1},{"lineBreak":true},{"text":"bika sia ti mu diambu di","poem":1},{"lineBreak":true},{"text":"nzimbala yama voti mu diambu di disumu diama, a Nzambi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kadi mbimbi ndisia vanga ko","poem":1},{"lineBreak":true},{"text":"vayi bakubimini mu kunduanisa","poem":1},{"lineBreak":true},{"text":"kotuka mu kutsadisa","poem":1},{"lineBreak":true},{"text":"tala phila ndikila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A Yave, Nzambi nkua ngolo yoso,","poem":1},{"lineBreak":true},{"text":"Nzambi yi Iseli, kotuka mu tumbudila makanda moso ;","poem":1},{"lineBreak":true},{"text":"kadi mona kadi kiadi","poem":1},{"lineBreak":true},{"text":"kuidi bobo beti vanga mambimbi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bamvutukanga va masika,","poem":1},{"lineBreak":true},{"text":"beti lola banga zimbua ;","poem":1},{"lineBreak":true},{"text":"ayi beti zungidila divula.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tala, momo balembo luki mu miunu miawu.","poem":1},{"lineBreak":true},{"text":"Bisabala bidi mu bididi biawu.","poem":1},{"lineBreak":true},{"text":"Ayi balembo tubi :","poem":1},{"lineBreak":true},{"text":"“Nani wulenda kutu wa e ?”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Vayi ngeyo, a Yave, wulenda basevi ;","poem":1},{"lineBreak":true},{"text":"wulembo sekinina makanda moso momo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E ngolo ziama, kuidi ngeyo ndintala,","poem":1},{"lineBreak":true},{"text":"ngeyo, e Nzambi, widi tinunu kiama ki ngolo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nzambi ama, wukuphangilanga mamboti Nzambi ama yi luzolo","poem":1},{"lineBreak":true},{"text":"wela kundengana ; Nzambi wela diata va ntuala ama","poem":1},{"lineBreak":true},{"text":"ayi wela kumbonisa khini vadi bobo bakuthubidilanga.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Vayi kadi kuba vonda, a Yave, nkaku eto,","poem":1},{"lineBreak":true},{"text":"bila muna batu bama bela zimbakana.","poem":1},{"lineBreak":true},{"text":"Mu lulendo luaku, baba mindiengidi ayi wuba buisi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mu diambu di masumu ma muinu miawu,","poem":1},{"lineBreak":true},{"text":"mu diambu di mambu ma bididi biawu,","poem":1},{"lineBreak":true},{"text":"bika babuilama mu luniemo luawu.","poem":1},{"lineBreak":true},{"text":"Mu diambu di zitsingulu ayi luvunu beti totula,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wuba lalikisa mu nganzi aku yi kikhesa ;","poem":1},{"lineBreak":true},{"text":"wuba lalikisa muingi babika buela monika","poem":1},{"lineBreak":true},{"text":"buna diela zabakana mu zitsuka zi ntoto","poem":1},{"lineBreak":true},{"text":"ti Nzambi wunyadila Yakobi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bamvutukanga va masika,","poem":1},{"lineBreak":true},{"text":"beti lola banga zimbua,","poem":1},{"lineBreak":true},{"text":"ayi beti zungidila divula.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bandiengilanga mu diambu di bidia,","poem":1},{"lineBreak":true},{"text":"ayi enati bakadi yukuta,","poem":1},{"lineBreak":true},{"text":"buna banyamikinanga.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vayi minu, ndiela yimbidila zingolo ziaku ;","poem":1},{"lineBreak":true},{"text":"muna nsuka, ndiela yimbidila luzolo luaku","poem":1},{"lineBreak":true},{"text":"bila ngeyo tinunu kiama kingolo","poem":1},{"lineBreak":true},{"text":"ayi suamunu mu zithangu zi ziphasi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A ngeyo zingolo ziama,","poem":1},{"lineBreak":true},{"text":"ndinyimbila nzitusu mu diambu diaku ;","poem":1},{"lineBreak":true},{"text":"ngeyo Nzambi, ngeyo tinunu kiama kingolo ;","poem":1},{"lineBreak":true},{"text":"Nzambi ama yi luzolo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}