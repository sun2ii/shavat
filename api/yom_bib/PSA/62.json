{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":62,"content":[{"type":"heading","content":["Muelꞌama widi mu ndembama mu Nzambi"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi Yedutuni, pfumu minyimbidi."]},{"type":"verse","number":1,"content":[{"text":"Muelꞌama umbakanga luvovomo mu Nzambi kaka.","poem":1},{"lineBreak":true},{"text":"Phulusu ama kuidi niandi yimbanga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Niandi kaka ditadi diama","poem":1},{"lineBreak":true},{"text":"ayi phulusu ama ;","poem":1},{"lineBreak":true},{"text":"niandi suamunu kiama kingolo ;","poem":1},{"lineBreak":true},{"text":"Ndilendi bulangana ko.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nate zithangu zikua lufueti nuanisina mutu e ?","poem":1},{"lineBreak":true},{"text":"Lutombidi beno boso bu kumbuisila e ?","poem":1},{"lineBreak":true},{"text":"Banga baka kioki kitengama","poem":1},{"lineBreak":true},{"text":"banga luphangu lolo lueka bua e ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Balembo nyendila manenga","poem":1},{"lineBreak":true},{"text":"muingi bankundumuna va buangu kiandi ki zangama ;","poem":1},{"lineBreak":true},{"text":"khini beti mona mu mambu ma luvunu.","poem":1},{"lineBreak":true},{"text":"Mu muinu miawu, balembo sakumuna,","poem":1},{"lineBreak":true},{"text":"vayi mu khati ntima miawu, balembo singi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ba mu ndembama, a muelꞌama, mu Nzambi kaka !","poem":1},{"lineBreak":true},{"text":"Diana diama kuidi niandi dimbanga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Niandi kaka ditadi diama ayi phulusu ama ;","poem":1},{"lineBreak":true},{"text":"niandi suamunu kiama ki ngolo ;","poem":1},{"lineBreak":true},{"text":"Ndilengi bua ko.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Phulusu ama ayi nzitusu ama kuidi Nzambi bidi ;","poem":1},{"lineBreak":true},{"text":"niandi ditadi diama dingolo, suamunu kiama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tulanganu diana dieno mu niandi","poem":1},{"lineBreak":true},{"text":"mu thangu zioso, a batu.","poem":1},{"lineBreak":true},{"text":"Luyalumuna mintima mieno kuidi niandi","poem":1},{"lineBreak":true},{"text":"bila Nzambi niandi suamunu kieto.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Batu baphamba badi kaka phemo,","poem":1},{"lineBreak":true},{"text":"batu banneni badi kaka luvunu ;","poem":1},{"lineBreak":true},{"text":"enati babasidi va basikilu, basi kadi kiasa.","poem":1},{"lineBreak":true},{"text":"Kubafuba va kimosi, badi kaka phemo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kadi tulanu diana mu vinza bima bingana ;","poem":1},{"lineBreak":true},{"text":"voti tula luniemo mu bima bibuivi.","poem":1},{"lineBreak":true},{"text":"Ka diambu ko kimvuama kiaku kilembo yilama,","poem":1},{"lineBreak":true},{"text":"kadi tula ntimꞌaku mu biawu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Khumbu mosi Nzambi utuba,","poem":1},{"lineBreak":true},{"text":"zikhumbu zizole ndiwila :","poem":1},{"lineBreak":true},{"text":"ti ngeyo, a Nzambi, ngolo widi,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ayi ti ngeyo, a Yave, widi kiluzolo.","poem":1},{"lineBreak":true},{"text":"Bukiedika, wetafuta kadika mutu boso bukasadidi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}