{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":67,"content":[{"type":"heading","content":["Bika batu boso bazitisa Nzambi"]},{"type":"hebrew_subtitle","content":["Nkunga kuidi pfumu minyimbidi, kayimbidila mu ngitala."]},{"type":"verse","number":1,"content":[{"text":"Bika Nzambi katusila nlemvo ayi katusakumuna ;","poem":1},{"lineBreak":true},{"text":"ayi zizi kiandi kitukienzula ;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"muingi zinzila ziaku zizabakana va ntoto,","poem":1},{"lineBreak":true},{"text":"phulusu aku yizabakana","poem":1},{"lineBreak":true},{"text":"muidi makanda moso !","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bika batu bazitisa, a Nzambi ;","poem":1},{"lineBreak":true},{"text":"bika batu boso bazitisa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bika makanda mayangalala","poem":1},{"lineBreak":true},{"text":"ayi mayimbila mu diambu di khini","poem":1},{"lineBreak":true},{"text":"bila ngeyo weti yadila batu mu busonga ;","poem":1},{"lineBreak":true},{"text":"ngeyo wela diatisa makanda ma ntoto.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bika batu bazitisa, a Nzambi ;","poem":1},{"lineBreak":true},{"text":"bika batu boso bazitisa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buna ntoto wuela buta mimbutu miandi ;","poem":1},{"lineBreak":true},{"text":"Nzambi, Nzambi eto, wela kutusakumuna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nzambi wela kutusakumuna","poem":1},{"lineBreak":true},{"text":"ayi zitsuka zioso zi ntoto ziela kunkinzika.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}