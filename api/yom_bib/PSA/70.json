{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"heading","content":["Nzambi yiza wutsadisa"]},{"type":"hebrew_subtitle","content":["Nkunga Davidi kuidi pfumu minyimbidi mu diambu di thebokolo moyo."]},{"type":"verse","number":1,"content":[{"text":"Yiza nsualu, a Nzambi, mu kukhula !","poem":1},{"lineBreak":true},{"text":"Yave, yiza nsualu mu kutsadisa !","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bika bobo bantomba luzingu luama","poem":1},{"lineBreak":true},{"text":"bafua tsoni ayi baba dio kombolo !","poem":1},{"lineBreak":true},{"text":"Bika bobo bantomba mbivusu ama","poem":1},{"lineBreak":true},{"text":"bavutuka ku mbusa ayi bafua tsoni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bika bobo beti tuba kuidi minu : “A… A…”","poem":1},{"lineBreak":true},{"text":"bavutuka ku mbusa mu diambu di zitsoni ziawu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Babo bakutombanga bamona khini","poem":1},{"lineBreak":true},{"text":"ayi bayangalala mu ngeyo ;","poem":1},{"lineBreak":true},{"text":"bika bobo banzolanga phulusu aku","poem":1},{"lineBreak":true},{"text":"batubanga mu zithangu zioso :","poem":1},{"lineBreak":true},{"text":"“Bika Nzambi kayayusu.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vayi minu ndidi nsukami ayi nkua kiadi","poem":1},{"lineBreak":true},{"text":"yiza nsualu kuidi minu, a Nzambi !","poem":1},{"lineBreak":true},{"text":"Ngeyo nsadisi ama ayi nkudi ama ;","poem":1},{"lineBreak":true},{"text":"A Yave kadi zingila !","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}