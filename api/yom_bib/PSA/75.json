{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"heading","content":["Nzambi wela sambisa ntoto"]},{"type":"hebrew_subtitle","content":["Nkunga Asafi kuidi pfumu minyimbidi “Kadi vonda”."]},{"type":"verse","number":1,"content":[{"text":"Tueti kuvutudila matondo, a Nzambi.","poem":1},{"lineBreak":true},{"text":"Tueli vutula matondo bila dizina diaku didi difikama","poem":1},{"lineBreak":true},{"text":"batu balembo yolukila matsiminanga maku.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ngeyo tubidi : “tsobudi thangu yifuana","poem":1},{"lineBreak":true},{"text":"Keti minu ndieti sambisa mu bufuana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ntoto bu wulembo nikuka va kimosi ayi batu bandi boso","poem":1},{"lineBreak":true},{"text":"Keti minu ndisimbidila makunzi mandi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuidi nkua luniemo, ndintuba : ‘Kadi kukiniemisanga ngolo’","poem":1},{"lineBreak":true},{"text":"Kuidi batu bambimbi : ‘lubika vumbula ziphoka zieno.’","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lubika vumuna ziphoka zieno mu diambu di diyilu ;","poem":1},{"lineBreak":true},{"text":"bikanu tubila mu nonumuna madinga !”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kadi mutu wumosi tona ku Esite voti ku Wesite","poem":1},{"lineBreak":true},{"text":"voti tona ku dikanga wulenda yayisa mutu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vayi Nzambi niandi weti sambisa ;","poem":1},{"lineBreak":true},{"text":"niandi weti kulula wunkaka, niandi weti yayisa wunkaka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mu koko ku Yave muidi mbungu yiwala vinu kingolo","poem":1},{"lineBreak":true},{"text":"ayi yisobokoso.","poem":1},{"lineBreak":true},{"text":"Wulembo dukula kiawu ayi batu boso bambimbi","poem":1},{"lineBreak":true},{"text":"badi va ntoto bela nua kiawu","poem":1},{"lineBreak":true},{"text":"nate kuna dibomvi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Vayi minu, ndiela samunanga mawu","poem":1},{"lineBreak":true},{"text":"mu thangu zioso.","poem":1},{"lineBreak":true},{"text":"Ndiela yimbidila nzitusu","poem":1},{"lineBreak":true},{"text":"kuidi Nzambi yi Yakobi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndiela zenga ziphoka zi batu boso bambimbi,","poem":1},{"lineBreak":true},{"text":"vayi ziphoka zi batu basonga","poem":1},{"lineBreak":true},{"text":"luela nanguku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}