{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"heading","content":["Nzambi wulembo sambisa bapfumu ba makanda."]},{"type":"hebrew_subtitle","content":["Nkunga Asafi."]},{"type":"verse","number":1,"content":[{"text":"Nzambi telimini va lukutukunu lunneni.","poem":1},{"lineBreak":true},{"text":"Wulembo vani nzengolo va khatitsika “zinzambi”.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nate thangu mbi luela nuaninanga mutu kambulu wusonga","poem":1},{"lineBreak":true},{"text":"ayi luela monisinanga thalu yi zizi","poem":1},{"lineBreak":true},{"text":"kuidi batu bambimbi e ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuanina mutu wulebakana ayi muana wusana.","poem":1},{"lineBreak":true},{"text":"Luvanga malulama kuidi nsukami ayi kuidi mutu weti yamusu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kulanu mutu wulebakana ayi nsukami ;","poem":1},{"lineBreak":true},{"text":"bika luba vukisa mu mioko mi batu bambimbi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Basi zaba kadi diambu ko ayi basudikanga kadi diambu ko ;","poem":1},{"lineBreak":true},{"text":"Mu tombi beti diatila ;","poem":1},{"lineBreak":true},{"text":"zifundasio zioso zi ntoto zilembo nikuka.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Minu ndituba :","poem":1},{"lineBreak":true},{"text":"“luidi zinzambi ayi beno boso luidi","poem":1},{"lineBreak":true},{"text":"bana ba Nzambi yizangama.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vayi luela fua banga batu boso,","poem":1},{"lineBreak":true},{"text":"luela bua banga woso kuandi nyadi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Telama, a Nzambi, sambisa ntoto !","poem":1},{"lineBreak":true},{"text":"Bila makanda moso madi kiuka kiaku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}