{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"heading","content":["Yave weti yala tona thama ayi mu zithangu zioso."]},{"type":"verse","number":1,"content":[{"text":"Yave weti yala, vueti nzitusu,","poem":1},{"lineBreak":true},{"text":"Yave vueti nzitusu ayi wukivuatisidi zingolo.","poem":1},{"lineBreak":true},{"text":"Nza yidi yikindusu dio ngui ;","poem":1},{"lineBreak":true},{"text":"yilendi nikuka ko.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kundu kiaku ki Kipfumu kikibiekolo tona thama ;","poem":1},{"lineBreak":true},{"text":"ngeyo widi tona mu zithangu zioso.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mimbu mifuemini, a Yave ;","poem":1},{"lineBreak":true},{"text":"mimbu miwakisidi zimbembo ziawu,","poem":1},{"lineBreak":true},{"text":"mimbu miwakikisidi mayo mawu mankumba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lulendo viokila dumu ki minlangu minneni","poem":1},{"lineBreak":true},{"text":"lulendo viokila bobo beti basa mimbi","poem":1},{"lineBreak":true},{"text":"Yave lulendo kadi mu diyilu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zinzengolo ziaku zidi zitelama dio ngui.","poem":1},{"lineBreak":true},{"text":"Bunlongo bueti monisanga kitoko mu nzo aku, a Yave,","poem":1},{"lineBreak":true},{"text":"mu bilumbu bikambulu tsukulu, a Yave.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}