{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":96,"content":[{"type":"heading","content":["Bika nza yimvimba yisanisina Yave, ntinu andi."]},{"type":"verse","number":1,"content":[{"text":"Luyimbidila Yave nkunga wumona.","poem":1},{"lineBreak":true},{"text":"Luyimbidila Yave, ntoto wumbimba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luyimbidila Yave,","poem":1},{"lineBreak":true},{"text":"zitisanu dizina diandi ;","poem":1},{"lineBreak":true},{"text":"yamikisanu phulusu andi","poem":1},{"lineBreak":true},{"text":"lumbu ka lumbu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yolukilanu nkembo andi muidi makanda","poem":1},{"lineBreak":true},{"text":"mambu mandi matsiminanga","poem":1},{"lineBreak":true},{"text":"muidi batu boso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bila Yave widi wunneni","poem":1},{"lineBreak":true},{"text":"ayi lutidi mu zitusu ;","poem":1},{"lineBreak":true},{"text":"tsisi kadi va yilu zinzambi zioso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bila zinzambi zi makanda zidi bitumba ;","poem":1},{"lineBreak":true},{"text":"vayi Yave niandi wuvanga diyilu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kiezila ayi nzitusu bidi va ntualꞌandi","poem":1},{"lineBreak":true},{"text":"zingolo ayi nkembo bidi mu buangu kiandi ki nlongo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Luvana kuidi Yave,","poem":1},{"lineBreak":true},{"text":"e mabuta ma makanda ;","poem":1},{"lineBreak":true},{"text":"luvana kuidi Yave nkembo ayi ngolo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luvana nkembo kuidi Yave wufueni mu dizina diandi.","poem":1},{"lineBreak":true},{"text":"Lunata dikaba ayi lukota mu ziphangu ziandi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lubuongimina Yave mu kiezila ki bunlongo buandi.","poem":1},{"lineBreak":true},{"text":"Tita va ntualꞌandi, ntoto wumvimba.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tuba muidi makanda :","poem":1},{"lineBreak":true},{"text":"“Yave weti yala.”","poem":1},{"lineBreak":true},{"text":"Nza yidi yikinda dio ngui ;","poem":1},{"lineBreak":true},{"text":"yilendi nikuka ko","poem":1},{"lineBreak":true},{"text":"bila Yave wela sambisa batu mu bufuana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bika diyilu dimona khini,","poem":1},{"lineBreak":true},{"text":"bika ntoto wuyangalala.","poem":1},{"lineBreak":true},{"text":"Bika mbu wutula biyoko ayi bibio bidi muna.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bika zitsola zimona khini","poem":1},{"lineBreak":true},{"text":"ayi bibio bidi muna ;","poem":1},{"lineBreak":true},{"text":"buna minti mioso mi nsitu miyimbila","poem":1},{"lineBreak":true},{"text":"mu diambu di khini.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Miela yimbila va ntuala Yave, bila wulembo yizi,","poem":1},{"lineBreak":true},{"text":"wulembo yizi mu sambisa ntoto.","poem":1},{"lineBreak":true},{"text":"Wela sambisa nza mu busonga","poem":1},{"lineBreak":true},{"text":"ayi batu mu Kedika kiandi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}