{"translation":{"id":"yom_bib","name":"Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002","website":"https://ebible.org/Scriptures/details.php?id=yom","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yom","licenseNotes":null,"shortName":"BIB","englishName":"Yombe: Biblica® Open Nkanda wu Moyo, Nguizani Yimona ayi Minkunga 2002 (Bible)","language":"yom","textDirection":"ltr","sha256":"f7c6b5b31c01e329a8d7164320796a875dd57a91f9fb8e24baaece6816ef1966","availableFormats":["json"],"listOfBooksApiLink":"/api/yom_bib/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10415,"languageName":"Yombe","languageEnglishName":"Yombe"},"book":{"id":"PSA","translationId":"yom_bib","name":"MINKUNGA","commonName":"MINKUNGA","title":"Minkunga","order":19,"numberOfChapters":150,"sha256":"c7e3115a65c955b3705f1381545c9e3474056989eb67ad7460299809ee389bb5","firstChapterNumber":1,"firstChapterApiLink":"/api/yom_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yom_bib/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":99,"content":[{"type":"heading","content":["Lubuongimina Yave bila widi wunlongo"]},{"type":"verse","number":1,"content":[{"text":"Yave weti yala,","poem":1},{"lineBreak":true},{"text":"bika makanda matita","poem":1},{"lineBreak":true},{"text":"vuandisidi kundu kiandi ki kipfumu va khatitsika Bakeluba.","poem":1},{"lineBreak":true},{"text":"Bika ntoto wunikuka.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yave widi wunneni mu Sioni","poem":1},{"lineBreak":true},{"text":"widi wuyayusu va yilu makanda moso.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bika bazitisa dizina diaku dinneni ayi ditsisi.","poem":1},{"lineBreak":true},{"text":"Niandi widi wunlongo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ntinu widi wu lulendo wunzolanga busonga.","poem":1},{"lineBreak":true},{"text":"Ngeyo wukindisa mambu mafuana","poem":1},{"lineBreak":true},{"text":"Mu Yakobi, wuvanga momo madi masonga ayi malulama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luyayisa Yave, Nzambi eto.","poem":1},{"lineBreak":true},{"text":"Lubuongama va ntuala buangu kioki","poem":1},{"lineBreak":true},{"text":"keti tetikanga malu mandi.","poem":1},{"lineBreak":true},{"text":"Niandi widi wunlongo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Moyize ayi Aloni baba va khatitsika","poem":1},{"lineBreak":true},{"text":"zinganga ziandi zi Nzambi ;","poem":1},{"lineBreak":true},{"text":"Samueli wuba va khatitsika bobo bantelanga","poem":1},{"lineBreak":true},{"text":"dizina diandi,","poem":1},{"lineBreak":true},{"text":"batela Yave","poem":1},{"lineBreak":true},{"text":"ayi niandi wuba vana mvutu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niandi wuba yolukila mu dikunzi di dituti.","poem":1},{"lineBreak":true},{"text":"Bawu bakeba zinzengolo ziandi","poem":1},{"lineBreak":true},{"text":"ayi zithumunu ziosi kaba vana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A Yave, Nzambi eto, ngeyo wuba vana mvutu.","poem":1},{"lineBreak":true},{"text":"Ngeyo wuba kuidi Iseli, ngeyo wuba Nzambi","poem":1},{"lineBreak":true},{"text":"yoyi yiba kuba lemvukilanga ;","poem":1},{"lineBreak":true},{"text":"ka diambu ko ngeyo wuba kuba vananga","poem":1},{"lineBreak":true},{"text":"thumbudulu mu mavanga mawu mambimbi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yayisanu Yave, Nzambi eto.","poem":1},{"lineBreak":true},{"text":"Lubuongama va ntuala mongo andi wunlongo","poem":1},{"lineBreak":true},{"text":"bila Yave, Nzambi eto, widi wunlongo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yom_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yom_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yom_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}