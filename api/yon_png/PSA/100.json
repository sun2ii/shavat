{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["God yaningko kankooni ye yook. Eso andi yeman."]},{"type":"verse","number":1,"content":[{"text":"Okad kumundindan, Yariman yaa kube komkime.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kubi dowakeniibbed Yariman yaa bumangke yaningko kankoonime.","poem":2},{"lineBreak":true},{"text":"Kubi yookiibbed ye arinambo ari minime.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yariman kuu God ande yiibkaadkerunime,","poem":1},{"text":"nub ongmenaboonman kuu yembedmo, kwane nub kuu yeman.","poem":2},{"lineBreak":true},{"text":"Nub kuu ye karuwa nimaya, nub kuu sibi areb ye bangkandimbon aom doruub.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Eso andiyiibbed ye kurikuri boyambib yu kuuk wirinimbon ye ambongko aom awunem,","poem":1},{"text":"kwane ye aningko kankooniyiibbed ye kurikuri boyambib yu kuuk wirinimbon aom awunem.","poem":2},{"lineBreak":true},{"text":"Ye yaa eso andenub ye aningko kankoonem.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amborom kuu Yariman kuu amun,","poem":1},{"text":"kwane ye womoniyiibban ye mimyob dowaken kuu dowan keraanban oonendembaraneen,","poem":2},{"lineBreak":true},{"text":"kwane ye ma korondiyiibban weng awini ye inamen kuu nimakarub yaro dobere dobere yaro wananiib korem aom angkimbaraneen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}