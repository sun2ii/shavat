{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Israeldan Idyip aombed angkane winiwen yaron,","poem":1},{"text":"Yekob ye awoya ari kuu yikaadban ye weng maa dakmimaibdan yaambed yaro winiwen yaron kui,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuyaron kuu Yudadan kuu ye karadmodan keriiwe,","poem":1},{"text":"Israeldan kuu ye nimakarub keriwen.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Karamok kuu wedmekoru kombere wuneen,","poem":1},{"text":"kwane ok Yooden kuu yinmone ika daaneen,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kwane aangko aangko kuu sibi ambi areb korongbere nadmiwen,","poem":1},{"text":"kwane koodbon koodbon kuu sibi mana areb korongbere nadmiwen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O karamok, komoyiibkob kombere weneeb?","poem":1},{"text":"O Yooden, komoyiibkob yinmone ika daaneeb?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"O aangko aangko, komoyiibkob sibi ambi areb korongbere nadmiib?","poem":1},{"text":"O koodbon koodbon, komoyiibkob sibi mana areb korongbere nadmiib?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O okad kumundin, Yariman ye arinambo arimbed kiringme,","poem":1},{"text":"Yekob ye God ye arinambo arimbed kui.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yembed dumnadbon kuu amonomboone ok bumbon kereen,","poem":1},{"text":"kwane dumnad kamkonombon kuu amonomboone ok kirubdem yemoon ye okad kereen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}