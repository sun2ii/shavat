{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Daane kawini ye yook."]},{"type":"verse","number":1,"content":[{"text":"Ne yaa dabab monoon kumbed Yariman yaa baandaane,","poem":1},{"text":"yembed inanduwoon.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"O Yariman, dudanabi mongkodkonoiib birandi ongiib yaa kuu","poem":1},{"text":"ne nen burudande angka kowe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O birandi ye karub, eb yaa kuu Godbed komo kamebdaneen?","poem":1},{"text":"Angkon eb yaa kuu ariyiib komo kamebdaneen?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yembed eb yaa kuu ana nangmi ye karub ye ana yidkangiibbed ukum kabdaneen,","poem":1},{"text":"kwane nimin darewoowiib ye amoyidkowiibbed kangkon ukum kabdaneen kii.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne kuu ambibkin Mesek aombed norod doriin kowe, mimyowiiwee!","poem":1},{"text":"Kedi, ne kuu Kedaadan yi ambib kombon kidangka dobaraan, kuu mimyowiiwee!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yewenub keri kerekmen yaa odkeneb kamidan yoom kuu","poem":1},{"text":"aronki yemoon kai dobaraan.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ne kuu iwari yewenub dobiri ye karub,","poem":1},{"text":"kumban yewenubmo doberem andimain kuu yimbed ana nangmem andimaib.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}