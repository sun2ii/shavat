{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["Daane kawini ye yook."]},{"type":"verse","number":1,"content":[{"text":"Ne awawi kuu kuna yaambed mananeen ande kaamoneni,","poem":1},{"text":"ne indob kankoone aangko aangko ari kereknain kii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne awawi kuu Yariman yaambed minimaan,","poem":1},{"text":"Eweniib okadiib ongmenaboonman yaambed kui.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ye kuu eb domobdaana kereeb beredare kombaraabban,","poem":1},{"text":"kwane eb yaa oonebdimaanman kuu unuk angkaanban.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kedi, Israeldan yaa oonendimaanman kuu","poem":1},{"text":"unuk angkimokban no kwane kerekbere doberembirimaan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yariman kuu eb yaa oonebdimaanman,","poem":1},{"text":"kwane Yariman kuu eb nen dorondarimaanman.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aronki kuu aronbed ma aunban,","poem":1},{"text":"kwane amki kuu woodbed kangkon ma aunban.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yarimanbed eb kuu nen amukmo biknaneen kowe kumkam maambed aanban,","poem":1},{"text":"kwane eb wadkeri yaa kuu oone kerenombaraneen.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yarimanbed eb menebiyiib wenebiyiib kuu","poem":1},{"text":"kibikbed wene aron korem kwane oone keebdombaraneen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}