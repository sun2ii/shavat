{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["Daane kawini ye yook Dewidbed wongkoon."]},{"type":"verse","number":1,"content":[{"text":"Israeldan kuu kekane yedmime,","poem":1},{"text":"“Yariman kuu nub kerekmen yaamban karen.” andime.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kedi, kekane yedmime, “Karub kuu nub yaa bon keriwen kumbed","poem":1},{"text":"Yariman kuu nub kerekmen yaamban karen,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"yimbed nub kuu wad ben anukmungkemoon areb keriwen karen,","poem":1},{"text":"yimbed nub yaa norin wandiwen kuyaron kui.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kukuu urokbed nub ben yukneen areb keroon,","poem":1},{"text":"kukuu ok awaanbed nub ben dabune kebenendeen areb keroon kui.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kukuu ok arud darewoobbed","poem":1},{"text":"nub ben are dabune kebenendeen areb keroon kii!” andime.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yariman ye aningko kankoonem,","poem":1},{"text":"yembed nub kuu domondoone wene bondan yi arud ningkambo ari ma kowindo kowe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nub kuu ayari on areb bad karub ye kawaad unoon yaambed","poem":1},{"text":"kombiri wenemoon areb keruwen.","poem":2},{"text":"Kawaad kuu domokboon kowe,","poem":1},{"text":"nub kuu obon keruwen kii.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nub awandi ye karub kuu Yariman,","poem":1},{"text":"Eweniib okadiib ongmenaboon ye God kui.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}