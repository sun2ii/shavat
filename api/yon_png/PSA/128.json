{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["Daane kawini ye yook."]},{"type":"verse","number":1,"content":[{"text":"Yariman yaa unimaibdan korem kuu amun kerundoon,","poem":1},{"text":"ye kiwaan ari weniibdan kui.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yiib kuu deme awiniwen ye id kuu yiibka ananiib,","poem":1},{"text":"kwane yiib kuu amun kerundaneene yiminmo dobaraniib.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eb wonong kuu wain nong areb id yemoon irimaun,","poem":1},{"text":"eb ambiwoom kuu.","poem":2},{"text":"Kwane eb dana meed kuu olif maad areb yemoonmo kainaniib,","poem":1},{"text":"eb arakbon kebed yaa kuu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kedi, Yariman yaa unimaan ye karub kuu","poem":1},{"text":"kwamunemo amun kerunaneen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yariman kuu Saiyon angkambed amun kerubdok.","poem":1},{"lineBreak":true},{"text":"Eb wad dobaraneeb ye aronki korem kuu","poem":1},{"text":"wedmebko Yerusalemdan yiminmo dobiriyiib kerok.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anamaa, eb dana meed yi dana meed wedmaneeb kuu anam id kerok.","poem":1},{"lineBreak":true},{"text":"Israel aom kuu iwari yewenuwiib kerok.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}