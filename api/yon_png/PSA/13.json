{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Yook ambo bi ye karub yeman. Dewid ye yook."]},{"type":"verse","number":1,"content":[{"text":"O Yariman, eb kuu aron komoyiib ne yaa meenaabban?","poem":1},{"text":"Aron korem nonondanduwaneewoo?","poem":2},{"lineBreak":true},{"text":"Aron komoyiib ne yaa angkurom korokbewaneeb?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aronkiyiib amnoomiib mimyob wandimain kowe,","poem":1},{"text":"aron komoyiib ne inamen aom dabab kandembaraniin?","poem":2},{"lineBreak":true},{"text":"Aron komoyiib ne bonman kuu ne burudande doraneen?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Yariman ne God, ne yaa wedmewe inanduwe.","poem":1},{"text":"Ne id yaa aromkono konebko nindob yimin kerok. Kwanaabban kuu angke bobnaniine,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ne bonmanbed “Ye kuu nembed bidkonaan.” ande yedmaneene","poem":1},{"text":"ne bondanbed ne kombaraan yaa kubaniib kii.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kumban ne kuu eb womoniyiibban ye mimyob dowaken yaa angkimbaraneen andimain,","poem":1},{"text":"kwane ne niindem aom kuu bobni yaa burudande bindi ye kiwaan ebbed ongmewen ye dowad kubimain.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne kuu Yariman yaa wingkaniin,","poem":1},{"text":"amborom kuu ye kuu ne yaa amunmo kamoon kowe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}