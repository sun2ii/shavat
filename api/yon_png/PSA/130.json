{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Daane kawini ye yook."]},{"type":"verse","number":1,"content":[{"text":"O Yariman, ne miin yiminban keraan ye niindem aombed eb yaa baandaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O Yariman, ne weng kee wengamberewe.","poem":2},{"text":"Eb kerendem kuu ne yaa kowe","poem":1},{"text":"ne yaa mimyob keewe ande baandaan kuyaa wengambere.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Yariman, eb kuu kekamune ambarakmi ye yuun awinaneeb keraneen kuu,","poem":1},{"text":"o Yariman, kanembed ma wad doraanban keraneen kii.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kumban eb kuu ambarakmi are nonondandi kerekmeniib kowe,","poem":1},{"text":"eb yaa unanuub kumbedmo yimin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ne kuu Yariman ye awawi dowad meedmiin, ne inamen kumundiniib kumbed meedmiin kii,","poem":1},{"text":"kwane ye weng yaambed kwananeen ande kowaan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne inamen kumundiniib kumbed Yariman ye awawi dowad nindorokiibbed meedmiin,","poem":1},{"text":"amnoom oone kerekbiridanbed awawini waruk ande meedmimaib arebban,","poem":2},{"lineBreak":true},{"text":"anamaa, amnoom oone kerekbiridanbed awawini waruk ande meedmimaib arebban.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"O Israeldan, Yarimanbed kwananeen ande meedmime,","poem":1},{"text":"amborom kuu Yariman kuu womoniyiibban ye mimyob dowakeniib kowe,","poem":2},{"lineBreak":true},{"text":"kwane ye kuu yiminmo biddi ye karub.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yekareb yembed Israeldan kuu","poem":1},{"text":"yi ambarakmi yaambed bidde baneen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}