{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":131,"content":[{"type":"hebrew_subtitle","content":["Daane kawini ye yook Dewidbed wongkoon."]},{"type":"verse","number":1,"content":[{"text":"O Yariman, ne niindem aom kuu kerengkan kerindo,","poem":1},{"text":"angkon ne korok kankoone nembedmo yimin andokban,","poem":2},{"text":"kwane ne burudande arimbed keriwendan inamen ongmiwen kuyaa kuu ne kuu ma wingkanambengkan kamindo,","poem":1},{"text":"kwane ne inamen burudande arimbed keroon ye inamen kuyaa kangkon ne kuu ma wingkanambengkan kamindo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anamaa, ne kuu nangkem kere iwari keraan,","poem":1},{"text":"dana awaan yu muk koronde yu yaa yone iwari keremoon areb keraan,","poem":2},{"lineBreak":true},{"text":"kuye dana areb ne inamen kumundin kuu iwari keroon.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Israeldan, Yarimanbed kwananeen ande meedmime,","poem":1},{"text":"kibikbed wene aron korem.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}