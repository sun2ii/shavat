{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["Dewid ye yook."]},{"type":"verse","number":1,"content":[{"text":"O Yariman, eb kurikuri ambib aom aomni kuu kane kuu yimin?","poem":1},{"text":"Ewaangko karadmo ari dobiri kuu kane kuu yimin?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuye karub kuu ambarakmoon ande kadwoniyiibban,","poem":1},{"text":"kwane ye kuu yorokmo yaambed ambangkene,","poem":2},{"lineBreak":true},{"text":"ye niindem aom kuu anammo kumbed anammo dakmimaan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwane ye kuu wengamborokbandimokban,","poem":1},{"text":"ye kuu ye dia doriibdan yaa ma ambarakmendimokban,","poem":2},{"lineBreak":true},{"text":"kwane ye angkodmi yaa kobkob daanubdaanab kamimokban.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwane ye kuu arewa kamimaibdan yaa kuu odkeneb kerimaan,","poem":1},{"text":"kumban kane kane Yariman yaa uniwendan kuu yi aningko kankoonimaan.","poem":2},{"text":"Kwane ye amob ongmoon kuu no awinaneen,","poem":1},{"text":"kuye amob awinaneen kumbed dabab menebaneen kuned.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ye kuu od bangkandekore ika ari iniyiib yedme kandaanban,","poem":1},{"text":"kwane ye kuu arewa kamidan yi od yemyeb kandene ambarakmindoman yaa ambarakmoon ande yedmaanban.","poem":2},{"text":"Kane ye kuu keamune kamaneen kuu","poem":1},{"text":"kiringmaanban kangdommo keraneen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}