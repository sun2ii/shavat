{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"Yariman ye aningko kankoonime!","poem":1},{"lineBreak":true},{"text":"God kuu ye karadmo dobirimbon aombed doreen kuye aningko kankoonime.","poem":1},{"text":"Ye kuu mindong yi dangimbon aromkonoyiib arimbed doreen kuye aningko kankoonime.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ye kamenabi aromkonoyiib ye dowad ye aningko kankoonime.","poem":1},{"text":"Ye kuu korem burudande darewoob arimbed kowe ye aningko kankoonime.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kibi baandenib ye aningko kankoonime.","poem":1},{"text":"Haawiib laiyayiib wangkenib ye aningko kankoonime.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tamborin wangke andenib ye aningko kankoonime.","poem":1},{"text":"Nongbed wangki yeman wangkanabe yurin wurumenib ye aningko kankoonime.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kuweng darewoob ye simbal wangkanabenib ye aningko kankoonime.","poem":1},{"text":"Kuweng wenebi ye simbal wangkanabenib ye aningko kankoonime.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inum nimaib ye dingkaniib nimakaruwiib kuu Yariman ye aningko kankoonime.","poem":1},{"lineBreak":true},{"text":"Yariman ye aningko kankoonime!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}