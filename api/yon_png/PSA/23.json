{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Dewid ye yook."]},{"type":"verse","number":1,"content":[{"text":"Yariman kuu ne nen dorondare oonimaan ye karub kowe,","poem":1},{"text":"ne yaa komo dowan keroon kuu yembed nekwawimaan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yembed ne nen animan yewudmombon aom kowaana yiidkimain,","poem":1},{"text":"kwane yembed yewenub ye ok dewenebuun kebed yaa ne nen kinban winimaan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yembed ne kingkin nen ikakman aromnimaan,","poem":1},{"text":"kwane yorokmo ye kiwaan arimo ne nen kinban winimaan,","poem":2},{"lineBreak":true},{"text":"ye aningko kankooni dowad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kumun doromod bobnin aom wananiin kangkon,","poem":1},{"text":"eb kuu ne yoom kowe,","poem":2},{"text":"arewa yaa ma unainban.","poem":1},{"lineBreak":true},{"text":"Eb kungkangiib arud ye barang yaambed dorondandi yemaniib kuu,","poem":1},{"text":"awawimaib kowe kubimain.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Eb kuu ne bondan yi kerebiri arimbed","poem":1},{"text":"ne dowad orok ongmimaab.","poem":2},{"text":"Ne nen kine ne korok ari kuu oiyo bunewen,","poem":1},{"text":"kwane ne dobiri yaa kuu yiminmo bangkawimaab.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anam kuu eb amun amuniib womoniyiibban ye mimyob dowakeniib kuu","poem":1},{"text":"ne wad dobiri aom kwane aron korem angkimbaraneen.","poem":2},{"text":"b Kwane, ne kuu Yariman yambiwoom kwane doberembaraniin, aron korem.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}