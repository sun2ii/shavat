{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"O God, ne dowad ebbed wengyundeneb ma ambarakmindo ande.","poem":1},{"text":"Kwane ne kangdod weng koromoneneb God ye kiwaan yikaadbandan yaa kebende.","poem":2},{"lineBreak":true},{"text":"Kwane birande arewa kamenabidan yaa kuu ne nen burudande angka kowe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eb kuu God ne dore angkumonimbon kowe,","poem":1},{"text":"komande ne yaa wunekarewen?","poem":2},{"text":"Komande ne bondanbed yobdood keruwaiwe","poem":1},{"text":"ne kuu kwane yuudi ameng kamembirimain?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Eb nambiriyiib anam anamiib kuu ben yure kowe.","poem":1},{"text":"Korondebko yimbed ne nen kinban winime.","poem":2},{"text":"Korondebko yimbed ne nen eb aangko karadmo ari winime,","poem":1},{"text":"eb dobirimbon yaa kui.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwananeen kuu ne kuu God ye bot wuubimbon yaa wananiin,","poem":1},{"text":"Godiib yaa kui, ye kuu ne kubi ye ambokab kui.","poem":2},{"text":"Ne kuu haap wangkeni ewaningko kankoonaniin,","poem":1},{"text":"o God ne God.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O ne kingkin, eb komande yerene no kubokban kerewen?","poem":1},{"text":"Komande ne niindem aom monmareeb?","poem":2},{"text":"Kedi, God yaningko kankoonaniin kowe, yembed ari kwananeen ande meene.","poem":1},{"text":"Ye kuu neyiib yaa doberene awawimaan ye karub, ye kuu ne God.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}