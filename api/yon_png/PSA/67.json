{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Yook ambo bi ye karub yeman. Nongbed wangki yemaniib. Yook, God yaningko kankooni yook kui."]},{"type":"verse","number":1,"content":[{"text":"God, eb nub yaa mimyob keende amun kerunde,","poem":1},{"text":"eb murubia kuu nub yaa konde.Selah","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwananeebkob eb dowaken okad yiri ye ambibkin koremdan yaa kuu yikaadkeraniib,","poem":1},{"text":"kwane ambibkin korem kuu bobni yaa burudande bindi ye kiwaan ebbed ongmewen kuu wedme yikaadkeraniib.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O God, ewaningko kuu ambibkin koremdan kankoonime,","poem":1},{"text":"ambibkin koremdan kuu ewaningko kankoonime.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ambibkin koremdan kuu kubenib kubi yookiib wingkime,","poem":1},{"text":"amborom kuu ebbed nimakarub korem yaa kuu kangdommo wengyundeneb,","poem":2},{"lineBreak":true},{"text":"okad yiri ye ambibkin koremdan kuu ebbed ben kinban winimaab kowe.Selah","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O God, ewaningko kuu ambibkin koremdan kankoonime,","poem":1},{"text":"ambibkin koremdan kuu ewaningko kankoonime.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Okad kuu animan kab ire amnoon,","poem":1},{"text":"God, nub God, yembed nub yaa amun kerundoon kui.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Godbed nub yaa amun kerundoon,","poem":1},{"text":"kowe okad kunaya kunaya nimakarub korem kuu ye yaa bumangke unaniib.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}