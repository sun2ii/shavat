{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Yook ambo bi ye karub yeman. Dewidbed wongkoon. Kaamoni yeman."]},{"type":"verse","number":1,"content":[{"text":"O God, ne kuu burudande nende.","poem":1},{"text":"O Yariman, kirodmo mene awawe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kane kanembed ne nande kamiibdan kuu","poem":1},{"text":"karak kondeneb kerebkarab kerunde.","poem":2},{"text":"Kane kanembed ne monmarandamiibdan korem kuu","poem":1},{"text":"ben amonombesaroko ikakman winibko irinyonde aningkoyiibban kerundok.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kane kanembed ne kande iningkuk yeman keriwen kuu","poem":1},{"text":"karak kondoko ikakman winime.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kumban kane kanembed eb ande onmiibdan kuu,","poem":1},{"text":"eb yaa dowakeniib kere kubime,","poem":2},{"text":"kwane kane kanembed bobni yaa burudande bindi ye kiwaan ebbed ongmewen kuyaa dowaken darewoob kowiwen kuu,","poem":1},{"text":"kekane yedmimamime, “God yaningko darewoob arimbed kerok!” andimamime.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kumban ne yaa dabab meneboon, nangkon kamboknon keraan,","poem":1},{"text":"o God, ne yaa kirod mene!","poem":2},{"text":"Eb kuu ne awawi ye karub, eb kuu ne nen burudande angka kowi ye karub,","poem":1},{"text":"o Yariman, erebnaraab, kibireb mene!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}