{"translation":{"id":"yon_png","name":"Buk Baibel long tokples Yongkom","website":"https://ebible.org/Scriptures/details.php?id=yon","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yon","licenseNotes":null,"shortName":"PNG","englishName":"Yongkom NT + partial OT","language":"yon","textDirection":"ltr","sha256":"f08d3b2d39bfcd91e185b2b79173705113aafcc1f493adcf639a17e42b9a1e20","availableFormats":["json"],"listOfBooksApiLink":"/api/yon_png/books.json","numberOfBooks":29,"totalNumberOfChapters":460,"totalNumberOfVerses":11835,"languageName":"Yongkom","languageEnglishName":"Yongkom"},"book":{"id":"PSA","translationId":"yon_png","name":"Buk Yook","commonName":"Buk Yook","title":"Buk Yook","order":19,"numberOfChapters":150,"sha256":"c9e914b270e2f42c915b801fc4db2a3846965f00270d34c863b44ea2b71420a1","firstChapterNumber":1,"firstChapterApiLink":"/api/yon_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yon_png/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Yariman kuu oone doreen, ye kuu ebkad doboob inwaremoon areb dobiri manimanandewiibmo doreen.","poem":1},{"text":"Yariman kuu aromkono kan ebkad doboob inware kobaiknong boronemoon areb awine doreen.","poem":2},{"text":"Okad kuu kan ongme kowoone yumbon kamkonoyiib kereen,","poem":1},{"text":"kowe kan dewenebinban.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Eb dibere ooni yeman ye yumbon kuu kurin kurin anukbed ongmewen,","poem":1},{"text":"eb kuu aron korem anukbed mene kibikee doreeb.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"O Yariman, karamok korem kuu baandiwen,","poem":1},{"text":"karamok korem kuu kan ari kowe baandiwen,","poem":2},{"lineBreak":true},{"text":"karamok korem kuu yi oknondok darewoob ben ari nongkobiwen.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Arimbed Doreen Ye God kuu aromkonoyiib,","poem":1},{"text":"ok arud yemoon yi kuweng arebban,","poem":2},{"lineBreak":true},{"text":"karamok yu oknondok kambari beengkimaun arebban kui.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"O Yariman, eb kerekmen korokbi ye weng kuu amonombaanban kwane angkimbaraneen.","poem":1},{"text":"Ewambib kuu karadmo doruun,","poem":2},{"lineBreak":true},{"text":"aron korem korem kwamunemo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yon_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yon_png/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yon_png/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}