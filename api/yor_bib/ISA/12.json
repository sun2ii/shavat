{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"ISA","translationId":"yor_bib","name":"Isaiah","commonName":"Isaiah","title":"Ìwé Wòlíì Isaiah","order":23,"numberOfChapters":66,"sha256":"d7e6b3006660648f43ef7ba117282afd2c8e804278ab934ddee0055c7746642d","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/yor_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Orin ìyìn"]},{"type":"verse","number":1,"content":["Ní ọjọ́ náà ni ìwọ ó wí pé,",{"text":"“Èmi ó yìn ọ́, Olúwa.","poem":1},{"text":"Bí ó tilẹ̀ jẹ́ wí pé ò ti bínú sí mi","poem":2},{"text":"ìbínú rẹ ti yí kúrò níbẹ̀","poem":1},{"lineBreak":true},{"text":"ìwọ sì ti tù mí nínú.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nítòótọ́ Ọlọ́run ni ìgbàlà mi,","poem":1},{"text":"èmi yóò gbẹ́kẹ̀lé e èmi kì yóò bẹ̀rù.","poem":2},{"text":"Olúwa, Olúwa náà ni agbára à mi àti orin ìn mi,","poem":1},{"text":"òun ti di ìgbàlà mi.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pẹ̀lú ayọ̀ ni ìwọ yóò máa pọn omi","poem":1},{"text":"láti inú kànga ìgbàlà.","poem":2}]},{"type":"verse","number":4,"content":["Ní ọjọ́ náà, ìwọ yóò wí pé,",{"text":"“Fi ọpẹ́ fún Olúwa, ké pe orúkọ rẹ̀,","poem":1},{"text":"jẹ́ kí ó di mí mọ̀ láàrín àwọn orílẹ̀-èdè,","poem":2},{"text":"ohun tí ó ti ṣe","poem":1},{"text":"kí o sì kéde pé a ti gbé","poem":2},{"lineBreak":true},{"text":"orúkọ rẹ̀ ga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kọ orin sí Olúwa, nítorí ó ti ṣe ohun tí ó lógo,","poem":1},{"text":"jẹ́ kí èyí di mí mọ̀ fún gbogbo ayé.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kígbe sókè kí o sì kọrin fún ayọ̀, ẹ̀yin ènìyàn Sioni,","poem":1},{"text":"nítorí títóbi ni ẹni mímọ́ kan ṣoṣo","poem":2},{"lineBreak":true},{"text":"ti Israẹli láàrín yín.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}