{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Fún adarí orin. Ti Dafidi."]},{"type":"verse","number":1,"content":[{"text":"Ìgbẹ́kẹ̀lé mi wà nínú Olúwa.","poem":1},{"text":"Báwo ní ẹ̀yin ó ṣe sọ fún ọkàn mi pé,","poem":2},{"lineBreak":true},{"text":"“Fò gẹ́gẹ́ bi ẹyẹ lọ si orí òkè rẹ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wò ó nítorí náà, ènìyàn búburú fa ọfà rẹ̀;","poem":1},{"text":"wọn ti fi ọfà wọn sí ojú okùn","poem":2},{"text":"láti tafà níbi òjìji","poem":1},{"text":"sí àyà ẹni ìdúró ṣinṣin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nígbà tí ìpìlẹ̀ bá bàjẹ́","poem":1},{"text":"kí ni olódodo yóò ṣe?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Olúwa ń bẹ nínú tẹmpili mímọ́ rẹ̀;","poem":1},{"text":"Olúwa ń bẹ lórí ìtẹ́ rẹ̀ ní ọ̀run.","poem":2},{"text":"Ó ń wo àwọn ọmọ ènìyàn;","poem":1},{"text":"ojú rẹ̀ ń yẹ̀ wọ́n wò.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Olúwa ń yẹ olódodo wò,","poem":1},{"text":"ṣùgbọ́n ènìyàn búburú àti àwọn tí o fẹ́ ìwà ipá","poem":2},{"lineBreak":true},{"text":"ni ọkàn rẹ̀ kórìíra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sí orí àwọn ènìyàn búburú ni yóò rọ̀jò","poem":1},{"text":"ẹ̀yín iná àti imí-ọjọ́ tí ń jó;","poem":2},{"lineBreak":true},{"text":"àti ìjì gbígbóná ní yóò jẹ ìpín wọn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nítorí, olódodo ní Olúwa,","poem":1},{"text":"o fẹ́ràn òdodo;","poem":2},{"lineBreak":true},{"text":"ẹni ìdúró ṣinṣin yóò sì rí i.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}