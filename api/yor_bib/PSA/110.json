{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Ti Dafidi. Saamu."]},{"type":"verse","number":1,"content":[{"text":"Olúwa sọ fún Olúwa mi pé,","poem":1},{"lineBreak":true},{"text":"“Ìwọ jókòó ní ọwọ́ ọ̀tún mi,","poem":1},{"text":"títí èmi yóò fi sọ àwọn ọ̀tá rẹ","poem":2},{"lineBreak":true},{"text":"di àpótí ìtìsẹ̀ rẹ.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Olúwa yóò na ọ̀pá agbára rẹ̀","poem":1},{"text":"láti Sioni wá, ìwọ jẹ ọba láàrín àwọn ọ̀tá rẹ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Àwọn ènìyàn rẹ jẹ́ ọ̀rẹ́ àtinúwá","poem":1},{"text":"ní ọjọ́ ìjáde ogun rẹ, nínú ẹwà mímọ́,","poem":2},{"lineBreak":true},{"text":"láti inú òwúrọ̀ wá ìwọ ni ìrì ẹwà rẹ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Olúwa ti búra,","poem":1},{"text":"kò sì í yí ọkàn padà pé,","poem":2},{"text":"“Ìwọ ni àlùfáà,","poem":1},{"text":"ní ipasẹ̀ Melkisedeki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Olúwa, ọwọ́ ọ̀tún rẹ̀ ni","poem":1},{"text":"yóò lu àwọn ọba bolẹ̀ ni ọjọ́ ìbínú rẹ̀.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yóò ṣe ìdájọ́ láàrín kèfèrí,","poem":1},{"text":"yóò kún ibùgbé wọn pẹ̀lú òkú ara;","poem":2},{"lineBreak":true},{"text":"yóò fọ́n àwọn olórí ká sí orí ilẹ̀ ayé tí ó gbòòrò.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yóò mu nínú odò ṣíṣàn ní ọ̀nà:","poem":1},{"text":"nítorí náà ni yóò ṣe gbé orí sókè.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}