{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"Ẹ máa yin Olúwa.","poem":1},{"lineBreak":true},{"text":"Èmi yóò máa yin Olúwa pẹ̀lú gbogbo ọkàn mi,","poem":1},{"text":"ní àwùjọ àwọn olóòtítọ́, àti ní ìjọ ènìyàn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Iṣẹ́ Olúwa tóbi, àwọn tí ó ní inú dídùn, ń ṣe àṣàrò nínú rẹ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iṣẹ́ rẹ̀ ni ọláńlá àti ògo:","poem":1},{"text":"àti òdodo rẹ̀ dúró láéláé.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ó ti ṣe iṣẹ́ ìyanu rẹ̀, láti máa rántí:","poem":1},{"text":"Olúwa ni olóore-ọ̀fẹ́ àti pé ó kún fún àánú.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ó ti fi oúnjẹ fún àwọn tí ó bẹ̀rù rẹ̀:","poem":1},{"text":"òun ń rántí májẹ̀mú rẹ̀.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ó ti fihan àwọn ènìyàn rẹ̀ agbára iṣẹ́ rẹ̀","poem":1},{"text":"láti fún wọn ní ilẹ̀ ìlérí ní ìní.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iṣẹ́ ọwọ́ rẹ̀ jẹ́ òtítọ́ àti ìdájọ́;","poem":1},{"text":"gbogbo òfin rẹ̀ sì dájú.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wọ́n dúró láé àti láé,","poem":1},{"text":"ní òtítọ́ àti òdodo ni a ṣe wọ́n.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ó rán ìràpadà sí àwọn ènìyàn rẹ̀:","poem":1},{"text":"ó pàṣẹ májẹ̀mú rẹ̀ títí láé,","poem":2},{"lineBreak":true},{"text":"mímọ́ àti ọ̀wọ̀ ni orúkọ rẹ̀.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ìbẹ̀rù Olúwa ni ìpilẹ̀ṣẹ̀ ọgbọ́n:","poem":1},{"text":"òye dáradára ni yóò máa ṣe òfin rẹ̀,","poem":2},{"lineBreak":true},{"text":"ìyìn rẹ̀ dúró láé.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}