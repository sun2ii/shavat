{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Ẹ máa yin Olúwa.","poem":1},{"lineBreak":true},{"text":"Yìn ín ẹ̀yin ìránṣẹ́ Olúwa,","poem":1},{"lineBreak":true},{"text":"ẹ yin orúkọ Olúwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fi ìbùkún fún orúkọ Olúwa láti","poem":1},{"text":"ìsinsin yìí lọ àti títí láéláé.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Láti ìlà-oòrùn títí dé ìwọ̀ rẹ̀","poem":1},{"text":"orúkọ Olúwa ni kí a máa yìn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Olúwa ga lórí gbogbo orílẹ̀-èdè,","poem":1},{"text":"àti ògo rẹ̀ lórí àwọn ọ̀run.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta ló dàbí Olúwa Ọlọ́run wa,","poem":1},{"text":"tí ó gbé ní ibi gíga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tí ó rẹ ara rẹ̀ sílẹ̀ láti wò","poem":1},{"text":"òun tí ó ń bẹ lọ́run, àti nínú ayé!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ó gbé òtòṣì dìde láti inú erùpẹ̀,","poem":1},{"text":"àti pé ó gbé aláìní sókè láti inú ààtàn wá.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kí ó le mú un jókòó pẹ̀lú àwọn ọmọ-aládé","poem":1},{"text":"àní pẹ̀lú àwọn ọmọ-aládé àwọn ènìyàn rẹ̀.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ó mú àgàn obìnrin gbé inú ilé,","poem":1},{"text":"àti láti jẹ́ aláyọ̀ ìyá fún àwọn ọmọ rẹ̀.","poem":2},{"lineBreak":true},{"text":"Ẹ yin Olúwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}