{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Nígbà tí Israẹli jáde ní Ejibiti,","poem":1},{"text":"ilé Jakọbu láti inú ènìyàn àjèjì èdè","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Juda wà ní ibi mímọ́,","poem":1},{"text":"Israẹli wà ní ìjọba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Òkun sì rí i, ó sì wárìrì:","poem":1},{"text":"Jordani sì padà sẹ́yìn.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Àwọn òkè ńlá ń fò bí àgbò àti","poem":1},{"text":"òkè kéékèèké bí ọ̀dọ́-àgùntàn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kí ni ó ṣe ọ́, ìwọ Òkun, tí ìwọ fi wárìrì?","poem":1},{"text":"Ìwọ Jordani, tí ìwọ fi padà sẹ́yìn?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ẹ̀yin òkè ńlá kí ló dé ti ẹ fi ń fò bí àgbò,","poem":1},{"text":"àti ẹ̀yin òkè kéékèèké bí ọ̀dọ́-àgùntàn?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wárìrì, ìwọ ilẹ̀, níwájú Olúwa;","poem":1},{"text":"ní iwájú Ọlọ́run Jakọbu","poem":2}]},{"type":"verse","number":8,"content":[{"text":"tí ó sọ àpáta di adágún omi,","poem":1},{"text":"àti òkúta-ìbọn di orísun omi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}