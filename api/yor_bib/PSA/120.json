{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Orin fún ìgòkè."]},{"type":"verse","number":1,"content":[{"text":"Èmi ké pe Olúwa nínú ìpọ́njú mi,","poem":1},{"text":"ó sì dá mi lóhùn.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gbà mí, Olúwa, kúrò lọ́wọ́ ètè èké","poem":1},{"text":"àti lọ́wọ́ ahọ́n ẹ̀tàn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kí ni kí a fi fún ọ?","poem":1},{"text":"Àti kí ni kí a túnṣe fún ọ,","poem":2},{"lineBreak":true},{"text":"ìwọ ahọ́n ẹ̀tàn?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Òun yóò bá ọ wí pẹ̀lú ọfà mímú ológun,","poem":1},{"text":"pẹ̀lú ẹ̀yín iná igi ìgbálẹ̀.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ègbé ni fún mi tí èmi ṣe àtìpó ní Meṣeki,","poem":1},{"text":"nítorí èmi gbé nínú àgọ́ ìlú Kedari!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ó ti pẹ́ tí èmi ti ń gbé","poem":1},{"text":"láàrín àwọn tí ó kórìíra àlàáfíà.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ènìyàn àlàáfíà ni mí;","poem":1},{"text":"ṣùgbọ́n nígbà tí mo bá sọ̀rọ̀, ogun ni dúró fun wọn.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}