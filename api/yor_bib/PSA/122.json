{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Orin fún ìgòkè. Ti Dafidi."]},{"type":"verse","number":1,"content":[{"text":"Inú mi dùn nígbà tí wọ́n wí fún mi pé,","poem":1},{"text":"“Ẹ jẹ́ kí á lọ sílé Olúwa.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ẹsẹ̀ wa yóò dúró ní ẹnu ibodè rẹ,","poem":1},{"text":"ìwọ Jerusalẹmu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalẹmu, ìwọ tí a kọ́ bí ìlú","poem":1},{"text":"tí o fi ara mọ́ra pọ̀ ṣọ̀kan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Níbi tí àwọn ẹ̀yà máa ń gòkè lọ,","poem":1},{"text":"àwọn ẹ̀yà Olúwa,","poem":2},{"text":"ẹ̀rí fún Israẹli,","poem":1},{"text":"láti máa dúpẹ́ fún orúkọ Olúwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nítorí ibẹ̀ ni a gbé ìtẹ́ ìdájọ́ kalẹ̀,","poem":1},{"text":"àwọn ìtẹ́ ilé Dafidi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gbàdúrà fún àlàáfíà Jerusalẹmu;","poem":1},{"text":"àwọn tí ó fẹ́ ọ yóò ṣe rere.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kí àlàáfíà kí ó wà nínú odi rẹ̀,","poem":1},{"text":"àti ìre nínú ààfin rẹ̀.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nítorí àwọn ọkùnrin àti àwọn ẹgbẹ́ mi","poem":1},{"text":"èmi yóò wí nísinsin yìí pé,","poem":2},{"lineBreak":true},{"text":"kí àlàáfíà kí ó wà nínú rẹ̀.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nítorí ilé Olúwa Ọlọ́run wa,","poem":1},{"text":"èmi yóò máa wá ìre rẹ̀.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}