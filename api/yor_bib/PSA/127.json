{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["Orin fún ìgòkè. Ti Solomoni."]},{"type":"verse","number":1,"content":[{"text":"Bí kò ṣe pé Olúwa bá kọ́ ilé náà","poem":1},{"text":"àwọn tí ń kọ́ ọ ń ṣiṣẹ́ lásán ni;","poem":2},{"lineBreak":true},{"text":"bí kò ṣe pé Olúwa bá pa ìlú mọ́, olùṣọ́ jí lásán.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Asán ni fún ẹ̀yin ti ẹ dìde ní kùtùkùtù","poem":1},{"text":"láti pẹ́ dùbúlẹ̀, láti jẹ oúnjẹ làálàá;","poem":2},{"lineBreak":true},{"text":"bẹ́ẹ̀ ni ó ń fi ìre fún olùfẹ́ rẹ̀ lójú ọ̀run.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kíyèsi i, àwọn ọmọ ni ìní Olúwa:","poem":1},{"text":"ọmọ inú sì ni èrè rẹ̀.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bí ọfà ti rí ní ọwọ́ alágbára,","poem":1},{"text":"bẹ́ẹ̀ ni àwọn ọmọ èwe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ìbùkún ni fún ọkùnrin náà tí apó rẹ̀ kún fún wọn;","poem":1},{"text":"ojú kì yóò tì wọ́n,","poem":2},{"lineBreak":true},{"text":"ṣùgbọ́n wọn yóò ṣẹ́gun àwọn ọ̀tá ní ẹnu-ọ̀nà.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}