]},{"type":"verse","number":6,"content":[{"text":"Bẹ́ẹ̀ ni kí ìwọ kí ó sì máa rí àti ọmọdọ́mọ rẹ.","poem":2},{"text":"Láti àlàáfíà lára Israẹli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}