rẹ tí kì í kùnà;","poem":1},{"text":"ọkàn mi ń yọ̀ nínú ìgbàlà rẹ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Èmi ó máa kọrin sí Olúwa,","poem":1},{"text":"nítorí ó dára sí mi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}