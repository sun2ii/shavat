{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["Ti Dafidi."]},{"type":"verse","number":1,"content":[{"text":"Èmi yóò yìn ọ́ tinútinú mi gbogbo;","poem":1},{"text":"níwájú àwọn òrìṣà ni èmi ó kọrin ìyìn sí ọ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Èmi ó máa gbàdúrà sí ìhà tẹmpili mímọ́ rẹ̀","poem":1},{"text":"èmi ó sì máa yin orúkọ rẹ","poem":2},{"text":"nítorí ìṣeun ìfẹ́ rẹ àti òtítọ́ rẹ;","poem":1},{"text":"nítorí ìwọ gbé ọ̀rọ̀ rẹ ga ju orúkọ rẹ lọ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ní ọjọ́ tí mo ké pè é ọ́, ìwọ dá mi lóhùn,","poem":1},{"text":"ìwọ sì fi ipa mú mi lára le ní ọkàn mi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gbogbo àwọn ọba ayé yóò yìn ọ́,","poem":1},{"text":"Olúwa, ní ìgbà tí wọn bá gbọ́ ọ̀rọ̀ ẹnu rẹ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nítòótọ́, wọn ó máa kọrin ní ipa ọ̀nà Olúwa;","poem":1},{"text":"nítorí pé ńlá ni ògo Olúwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bí Olúwa tilẹ̀ ga, síbẹ̀ ó júbà àwọn onírẹ̀lẹ̀;","poem":1},{"text":"ṣùgbọ́n agbéraga ni ó mọ̀ ní òkèrè réré.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bí èmi tilẹ̀ ń rìn nínú ìpọ́njú ìwọ ni yóò sọ mi di ààyè;","poem":1},{"text":"ìwọ ó na ọwọ́ rẹ sí àwọn ọ̀tá mi,","poem":2},{"lineBreak":true},{"text":"ọwọ́ ọ̀tún rẹ yóò sì gbà mí.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Olúwa yóò ṣe ohun tí ń ṣe tèmi láṣepé;","poem":1},{"text":"Olúwa, àánú rẹ dúró láéláé;","poem":2},{"lineBreak":true},{"text":"má ṣe kọ iṣẹ́ ọwọ́ ara rẹ sílẹ̀.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}