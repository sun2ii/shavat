{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["Fún adarí orin. Ti Dafidi."]},{"type":"verse","number":1,"content":[{"text":"Aṣiwèrè wí nínú ọkàn rẹ̀ pé,","poem":1},{"text":"“Ko sí Ọlọ́run.”","poem":2},{"text":"Wọ́n díbàjẹ́, iṣẹ́ wọn sì burú;","poem":1},{"text":"kò sí ẹnìkan tí yóò ṣe rere.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Olúwa sì bojú wolẹ̀ láti ọ̀run wá","poem":1},{"text":"lórí àwọn ọmọ ènìyàn","poem":2},{"text":"bóyá ó le rí ẹni tí òye yé,","poem":1},{"text":"ẹnikẹ́ni tó ń wá Ọlọ́run.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gbogbo wọn sì ti yípadà, gbogbo wọn sì ti díbàjẹ́;","poem":1},{"text":"kò sì ṣí ẹni tí ó ń ṣe rere,","poem":2},{"lineBreak":true},{"text":"kò sí ẹnìkan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ǹjẹ́ olùṣe búburú kò ha ní ìmọ̀?","poem":1},{"lineBreak":true},{"text":"Àwọn tí ó ń pa ènìyàn mi jẹ bí ẹní jẹun;","poem":1},{"text":"wọn kò sì ké pe Olúwa?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wọ́n wà níbẹ̀, tí a bò mọ́lẹ̀ pẹ̀lú ẹ̀rù,","poem":1},{"text":"nítorí Ọlọ́run wà ní àwùjọ àwọn olódodo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ẹ̀yin olùṣe búburú da èrò àwọn tálákà rú,","poem":1},{"text":"ṣùgbọ́n Olúwa ni ààbò wọn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ìgbàlà àwọn Israẹli yóò ti Sioni wá!","poem":1},{"text":"Nígbà tí Olúwa bá mú ìkólọ àwọn ènìyàn rẹ̀ padà,","poem":2},{"lineBreak":true},{"text":"jẹ́ kí Jakọbu kí ó yọ̀, kí inú Israẹli kí ó dùn!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}