kígbe sí ọ, Olúwa:","poem":1},{"text":"èmi wí pé, “Ìwọ ni ààbò mi,","poem":2},{"lineBreak":true},{"text":"ìpín mi ní ilẹ̀ alààyè.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fi etí sí igbe mi,","poem":1},{"text":"nítorí tí èmi wà nínú àìnírètí","poem":2},{"text":"gbà mí lọ́wọ́ àwọn tí ń lépa mi,","poem":1},{"text":"nítorí wọ́n lágbára jù mí lọ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mú ọkàn mi jáde kúrò nínú túbú,","poem":1},{"text":"kí èmi lè máa yin orúkọ rẹ.","poem":2},{"text":"Nígbà náà ni àwọn olódodo yóò yí mi káàkiri","poem":1},{"text":"nítorí ìwọ yóò fi ọ̀pọ̀lọpọ̀ wọn ba mi ṣe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}