{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Ẹ fi ìyìn fún Olúwa.","poem":1},{"lineBreak":true},{"text":"Fi ìyìn fún Olúwa, ìwọ ọkàn mi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Èmi yóò yin Olúwa ní gbogbo ayé mi,","poem":1},{"text":"èmi yóò kọrin ìyìn sí Ọlọ́run, níwọ̀n ìgbà tí mo bá wà láààyè.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ẹ má ṣe ní ìgbẹ́kẹ̀lé nínú àwọn ọmọ-aládé,","poem":1},{"text":"àní, ọmọ ènìyàn,","poem":2},{"lineBreak":true},{"text":"lọ́wọ́ ẹni tí kò sí ìrànlọ́wọ́.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ẹ̀mí rẹ jáde lọ, ó padà sí erùpẹ̀,","poem":1},{"text":"ní ọjọ́ náà gan, èrò wọn yóò di òfo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ìbùkún ni fún ẹni tí","poem":1},{"text":"Ọlọ́run Jakọbu ń ṣe ìrànlọ́wọ́ rẹ̀","poem":2},{"lineBreak":true},{"text":"tí ìrètí rẹ̀ wà nínú Olúwa Ọlọ́run rẹ̀.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ẹni tí ó dá ọ̀run àti ayé,","poem":1},{"text":"òkun àti ohun gbogbo tí ń bẹ nínú wọn,","poem":2},{"lineBreak":true},{"text":"ẹni tí ó pa òtítọ́ mọ́ títí ayé.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ẹni tí ń ṣe ìdájọ́ àwọn tí a ni lára,","poem":1},{"text":"tí ó fi oúnjẹ fún àwọn tí ebi ń pa,","poem":2},{"text":"Olúwa, tú àwọn oǹdè sílẹ̀,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Olúwa mú àwọn afọ́jú ríran,","poem":2},{"text":"Olúwa, gbé àwọn tí a rẹ̀ sílẹ̀ ga,","poem":1},{"text":"Olúwa fẹ́ràn àwọn olódodo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Olúwa ń dá ààbò bo àwọn àlejò","poem":1},{"text":"ó sì ń dá àwọn aláìní baba àti opó sí","poem":2},{"lineBreak":true},{"text":"ṣùgbọ́n ó ba ọ̀nà àwọn ènìyàn búburú jẹ́.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Olúwa jẹ ọba títí láé;","poem":1},{"text":"Ọlọ́run rẹ, ìwọ Sioni, àti fún gbogbo ìran.","poem":2},{"lineBreak":true},{"text":"Ẹ fi ìyìn fún Olúwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}