text":"pẹ̀lú ètè ìyìn, ẹnu mi yóò yìn ọ́.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nígbà tí mo rántí rẹ lórí ibùsùn mi;","poem":1},{"text":"èmi ń ronú rẹ títí ìṣọ́ òru.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nítorí ìwọ ni ìrànlọ́wọ́ mi,","poem":1},{"text":"mo kọrin níbi òjìji ìyẹ́ apá rẹ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ọkàn mí fà sí ọ:","poem":1},{"text":"ọwọ́ ọ̀tún rẹ gbé mi ró.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Àwọn tí ó ń wá ọkàn mí ni a ó parun;","poem":1},{"text":"wọn ó sọ̀kalẹ̀ lọ sí ìsàlẹ̀ ilẹ̀ ayé.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wọn ó ti ọwọ́ idà ṣubú","poem":1},{"text":"wọn ó sì di jíjẹ fún kọ̀lọ̀kọ̀lọ̀.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ṣùgbọ́n ọba yóò yọ̀ nínú Ọlọ́run","poem":1},{"text":"ẹni tí ó fi orúkọ Ọlọ́run búra yóò ṣògo","poem":2},{"lineBreak":true},{"text":"ṣùgbọ́n ẹnu àwọn òpùrọ́ la ó pamọ́.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}