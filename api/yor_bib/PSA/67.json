{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Fún adarí orin. Pẹ̀lú ohun èlò orin olókùn. Saamu. Orin."]},{"type":"verse","number":1,"content":[{"text":"Kí Ọlọ́run kí ó ṣàánú fún wa kí ó sì bùkún fún wa,","poem":1},{"text":"kí ó sì jẹ́ kí ojú rẹ̀ tàn yí wa ká,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kí ọ̀nà rẹ le di mí mọ̀ ní ayé,","poem":1},{"text":"ìgbàlà rẹ láàrín àwọn orílẹ̀-èdè.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kí àwọn ènìyàn kí ó yìn ọ́, Ọlọ́run;","poem":1},{"text":"kí gbogbo ènìyàn kí ó yìn ọ́!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kí orílẹ̀-èdè kí ó yọ̀, kí ó sì kọrin fún ayọ̀,","poem":1},{"text":"nítorí ìwọ fi òdodo darí àwọn ènìyàn,","poem":2},{"lineBreak":true},{"text":"ìwọ sì jẹ ọba àwọn orílẹ̀-èdè ní ayé.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kí àwọn ènìyàn kí ó yìn ọ́, Ọlọ́run;","poem":1},{"text":"kí gbogbo ènìyàn kí ó yìn ọ́. Sela.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nígbà náà ní ilẹ̀ yóò mú ìkórè rẹ̀ wá, Ọlọ́run,","poem":1},{"text":"Ọlọ́run wa, yóò bùkún fún wa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ọlọ́run yóò bùkún fún wa,","poem":1},{"text":"àti gbogbo òpin ilẹ̀ ayé yóò sì máa bẹ̀rù rẹ̀.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}