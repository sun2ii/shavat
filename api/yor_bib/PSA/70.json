{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Fún adarí orin. Ti Dafidi. Ẹ̀bẹ̀."]},{"type":"verse","number":1,"content":[{"text":"Yára, Ọlọ́run, láti gbà mí là,","poem":1},{"text":"Olúwa, wá kánkán láti ràn mí lọ́wọ́.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kí àwọn tí ń wá ọkàn mi","poem":1},{"text":"kí a dójútì wọ́n, kí wọn sì dààmú;","poem":2},{"text":"kí àwọn tó ń wá ìparun mi","poem":1},{"text":"yí ẹ̀yìn padà nínú ìtìjú.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kí a pa wọ́n ní ẹ̀yìn dà fún èrè","poem":1},{"text":"ìtìjú àwọn tí ń wí pé, “Háà! Háà!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ṣùgbọ́n kí àwọn tí ó ń wá ọ ó máa yọ̀","poem":1},{"text":"kí inú wọn kí ó sì máa dùn nípa rẹ,","poem":2},{"text":"kí àwọn tí ó ń fẹ́ ìgbàlà rẹ máa wí pé,","poem":1},{"text":"“Jẹ́ kí a gbé Ọlọ́run ga!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ṣùgbọ́n mo jẹ́ òtòṣì àti aláìní;","poem":1},{"text":"wa kánkán sí ọ̀dọ̀ mi, Ọlọ́run.","poem":2},{"text":"Ìwọ ni olùrànlọ́wọ́ àti olùdáǹdè mi;","poem":1},{"text":"Olúwa, má ṣe dúró pẹ́.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}