{"translation":{"id":"yor_bib","name":"Biblica® ní oore ọ̀fẹ́ láti lo Bíbélì Mímọ́ ní Èdè Yorùbá Òde-Òní","website":"https://ebible.org/Scriptures/details.php?id=yor","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yor","licenseNotes":null,"shortName":"BIB","englishName":"Yoruba Bible","language":"yor","textDirection":"ltr","sha256":"7761f8c9559b01566ca9490fb77c26b38960fb922d29a9e48641b9ea5af56ed6","availableFormats":["json"],"listOfBooksApiLink":"/api/yor_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31087,"languageName":"Èdè Yorùbá","languageEnglishName":"Yoruba"},"book":{"id":"PSA","translationId":"yor_bib","name":"Saamu","commonName":"Saamu","title":"Ìwé Saamu","order":19,"numberOfChapters":150,"sha256":"71d168d16a9f02a3586337da2d7408127fdf201cc10c63709da4ff37293ab495","firstChapterNumber":1,"firstChapterApiLink":"/api/yor_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yor_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Saamu ti Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ọlọ́run ń ṣàkóso nínú ìpéjọpọ̀ ńlá,","poem":1},{"text":"ó ṣe ìdájọ́ láàrín àwọn “ọlọ́run òrìṣà”.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Yóò ti pẹ́ tó tí ìwọ yóò máa gbèjà àwọn aláìṣòdodo","poem":1},{"text":"kí ó sì ṣe ojú ìṣáájú sí àwọn ènìyàn búburú?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gbèjà àwọn aláìlágbára àti aláìní baba;","poem":1},{"text":"ṣe ìtọ́jú ẹ̀tọ́ àwọn aláìní àti ẹni ìnilára.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gba àwọn aláìlágbára àti aláìní;","poem":1},{"text":"gbà wọ́n kúrò lọ́wọ́ àwọn ènìyàn búburú.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Wọn kò mọ̀ ohun kankan,","poem":1},{"text":"wọn kò lóye ohun kankan.","poem":2},{"text":"Wọn ń rìn kiri nínú òkùnkùn;","poem":1},{"text":"à si mí gbogbo ìpìlẹ̀ ayé.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mo wí pé, ‘Ẹyin ní “Ọlọ́run òrìṣà”;","poem":1},{"text":"ẹ̀yin ní gbogbo ọmọ Ọ̀gá-ògo jùlọ.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ṣùgbọ́n ẹ̀yin ó kú bí ènìyàn lásán;","poem":1},{"text":"ẹ̀yin ó ṣubú bí ọ̀kan nínú ọmọ-aládé.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dìde, Ọlọ́run, ṣe ìdájọ́ ayé,","poem":1},{"text":"nítorí gbogbo orílẹ̀-èdè ni ìní rẹ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}