ni ó fi ṣe ilé rẹ̀ lọ́ṣọ̀ọ́","poem":2},{"lineBreak":true},{"text":"fún ọjọ́ àìlópin, Olúwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yor_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yor_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yor_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}