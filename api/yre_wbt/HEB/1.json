{"translation":{"id":"yre_wbt","name":"Bali -le 'fluba 'trɛ Zozi blamin pli Bali man 'e 'pee","website":"https://ebible.org/Scriptures/details.php?id=yreNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yreNT","licenseNotes":null,"shortName":"WBT","englishName":"Yaouré NT","language":"yre","textDirection":"ltr","sha256":"cfe0d31e4b81b9b6d8fee3061b043b7e6d19774f0abe9dd0f90532418fcb93dd","availableFormats":["json"],"listOfBooksApiLink":"/api/yre_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7955,"languageName":"Yaouré","languageEnglishName":"Yaouré"},"book":{"id":"HEB","translationId":"yre_wbt","name":"Ebre","commonName":"Ebre","title":"'Fluba nɛn min -tʋ -a crɛn -tɛ Ebre 'nɔn lɛ","order":58,"numberOfChapters":13,"sha256":"fc89ff72a0691ae6e4b126e412615c54a26c79d3ed89e22a4660ccc0cbdfbee4","firstChapterNumber":1,"firstChapterApiLink":"/api/yre_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/yre_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Bali 'e 'fli kɔɔn minnun lɛ 'e 'pɩ -a"]},{"type":"verse","number":1,"content":["'Li 'e tɛdɛ bɛ, Bali ciɩla 'e 'lewei vɩnɔn 'va, ɛn e 'wɩ tin 'ba -kaa tranun lɛ. E 'wɩ tin 'ba -wlɛ 'e 'pa -a \"kaga, ɛn e ciɩla 'pɛ \"kaga \"ji te yaa tin \"baa -wlɛ."]},{"type":"verse","number":2,"content":["'Pian tʋ -nyranman nɛn -kaa cɩ -ji 'gʋɛ, Bali 'e 'fli kɔɔn -cɛɛ 'e 'pɩ -a. Bali ciɩla \"va, ɛn e fɛ pɛɛnɔn drɛ. Fɛ pɛɛnɔn 'bɔ zɩɛ Bali -a -nɔn -yrɛ -yee vɛ -a."]},{"type":"verse","number":3,"content":["Bali -pɩ zɩɛ, -yɛɛ Bali -le -dan kɔɔn -cɛɛ, ɛn e Bali 'sia -pɛ pɛɛnɔn 'ji. 'Plɛblɛ nɛn -a wei -lɔ bɛ -yɛɛ -maan labli 'lee 'trɛ a -nan tian. -A -pɩ -tʋwli zɩɛ -yɛɛ 'trɛdanɔn pɛɛnɔn 'le 'wɩ 'wlidɩ fui, ɛn e -kʋ -nyɛnlɛa Bali nɛn 'plɛblɛ pɛɛnɔn 'san -a bɛ -a -pɛ \"yi \"da laji lou."]},{"type":"heading","content":["Bali -pɩ a -dan"]},{"type":"verse","number":4,"content":["Bali -pɩ zɩɛ -a -dan \"mlian Bali -le 'pasianɔn pɛɛnɔn nɛn laji bɛ o da. Kɔɔ 'tɔ -dan nɛn e \"mlian o pɛɛnɔn 'le vɛ da bɛ, -a 'bɔ nɛn Bali -a -nɔn -yrɛ."]},{"type":"verse","number":5,"content":["Maan ve zɩɛ 'nan -e 'wɩ nɛn 'e 'crɛn -tɛdɩ Bali -le 'fluba 'ji bɛ, -a -cin 'e -trɔa 'ka 'ji. Kɔɔ e ya 'e 'crɛn -tɛdɩ 'nan:",{"text":"«Yiɛ cɩ 'mɛn 'nɛn 'a,","poem":1},{"lineBreak":true},{"text":"-e 'e 'sia cɛɛgʋ man bɛ","poem":1},{"lineBreak":true},{"text":"an drɛ 'i \"tɩ \"a.»","poem":1},"Ɛn \"nyian 'nan:",{"text":"«An -kɔan -a \"tɩ \"a,","poem":1},{"lineBreak":true},{"text":"ɛn e -kɔan 'an 'pɩ -a.»","poem":1},"'Wɩ zɩɛ Bali 'ka tian 'li -a vɩlɛ 'yee 'pasiazan -tʋ man \"fo \"dɩ."]},{"type":"verse","number":6,"content":["Ɛn \"nyian bɛ Bali -taa 'yee 'nɛn flin 'palɛ -sia 'trɛda 'e 'pee. 'Wɩ nɛn 'e 'crɛn -tɛdɩ tʋ zɩɛ -a -ji 'wɩ 'a bɛ -nyrɛn 'gʋ.",{"text":"«Bali \"e 'nan 'yee 'pasianɔn pɛɛnɔn nɛn laji bɛ","poem":1},{"lineBreak":true},{"text":"'o \"po sɔɔn \"wlu, -e 'o bɔ!»","poem":1}]},{"type":"verse","number":7,"content":["'Wɩ nɛn Bali -le 'pasianɔn nɛn laji bɛ -wee vɛ -a bɛ, -nyrɛn 'gʋ.",{"text":"«Bali 'yee 'pasianɔn drɛ","poem":1},{"lineBreak":true},{"text":"\"le fulɔ 'plɛblɛ 'zʋ,","poem":1},{"lineBreak":true},{"text":"ɛn e 'e 'sunɔn drɛ","poem":1},{"lineBreak":true},{"text":"\"le 'tɛ nrɛn -le 'wɩ 'zʋ.»","poem":1}]},{"type":"verse","number":8,"content":["'Pian 'wɩ nɛn Bali -a 'vɩ 'e 'pɩ man bɛ, -nyrɛn 'gʋ. E 'nan:",{"text":"«I ya Bali -a,","poem":1},{"lineBreak":true},{"text":"ɛn 'yie mingɔnnɛn -blɩdɩ 'leda \"ka \"dɩ.","poem":1},{"lineBreak":true},{"text":"'Wɩ tɩglɩ drɛdɩ -a nɛn","poem":1},{"lineBreak":true},{"text":"i mingɔnnɛn -ble 'yie minnun da.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yi'a 'wɩ 'wlidɩ \"drɛdɩ ye \"yi \"dɩ,","poem":1},{"lineBreak":true},{"text":"'wɩ tɩglɩ drɛdɩ nɛn yia ye \"yi.","poem":1},{"lineBreak":true},{"text":"-Yee \"wɛan 'an 'bɔ nɛn 'yie Bali -a bɛ,","poem":1},{"lineBreak":true},{"text":"mɛin 'si \"va,","poem":1},{"lineBreak":true},{"text":"ɛn ci \"nrandɩ nɛn e \"mlian","poem":1},{"lineBreak":true},{"text":"'i bɔɛnun pɛɛnɔn 'le vɛ da bɛ,","poem":1},{"lineBreak":true},{"text":"maan -nɔn 'yiɛ.»","poem":1}]},{"type":"verse","number":10,"content":["Ɛn Bali -a 'vɩ \"nyian 'e 'pɩ man 'nan:",{"text":"«I ya Minsan -a.","poem":1},{"lineBreak":true},{"text":"Fɛ pɛɛnɔn drɛdɩ pou sianan \"bɛ,","poem":1},{"lineBreak":true},{"text":"i 'trɛ drɛ, ɛn i labli drɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"'Trɛ 'lee labli 'nyan tʋ a,","poem":1},{"lineBreak":true},{"text":"'pian \"i \"ya wo -nan 'li 'trilii.","poem":1},{"lineBreak":true},{"text":"-Te sɔ 'mɔn bɛ, e srɛman.","poem":1},{"lineBreak":true},{"text":"'Wɩ 'tʋwli zɩɛ,","poem":1},{"lineBreak":true},{"text":"-yɛɛ dra 'trɛ 'lee labli lɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"-Te sɔ 'mɔn bɛ,","poem":1},{"lineBreak":true},{"text":"waa ta -fɔɔman sɔ -trɛ -a.","poem":1},{"lineBreak":true},{"text":"'Wɩ 'tʋwli zɩɛ,","poem":1},{"lineBreak":true},{"text":"-a 'bɔ nɛn yia dra 'trɛ","poem":1},{"lineBreak":true},{"text":"'lee labli lɛ.","poem":1},{"lineBreak":true},{"text":"'Pian 'yie vɛ bɛ,","poem":1},{"lineBreak":true},{"text":"i -fo -nan 'li 'trilii,","poem":1},{"lineBreak":true},{"text":"ɛn 'yie 'belidɩ 'leda \"ka \"dɩ.»","poem":1}]},{"type":"verse","number":13,"content":["'Wɩ nɛn Bali 'ka tian 'li -a vɩlɛ 'yee 'pasianɔn nɛn laji bɛ -a -tʋ lɛ dɩɛ, yaa 'vɩ 'e 'pɩ lɛ. Yaa 'vɩ -yrɛ 'nan:",{"text":"«'I 'nyran 'an 'pɛ \"yi \"da!","poem":1},{"lineBreak":true},{"text":"'I 'fʋ -nan zɩɛ, -trilii","poem":1},{"lineBreak":true},{"text":"-e 'an 'cɛn 'i 'nanmannɔn 'klɩdɩ man.»","poem":1}]},{"type":"verse","number":14,"content":["Bali -le 'pasianɔn nɛn laji bɛ -wee vɛ a \"mɛ 'kɔ? O ya Bali 'sunɔn 'a, ɛn Bali o \"paa -sia 'nan 'o 'pa minnun nɛn Bali o \"sia 'wɩ 'ji bɛ o va."]}],"footnotes":[]},"thisChapterLink":"/api/yre_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yre_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yre_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}