{"translation":{"id":"yre_wbt","name":"Bali -le 'fluba 'trɛ Zozi blamin pli Bali man 'e 'pee","website":"https://ebible.org/Scriptures/details.php?id=yreNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yreNT","licenseNotes":null,"shortName":"WBT","englishName":"Yaouré NT","language":"yre","textDirection":"ltr","sha256":"cfe0d31e4b81b9b6d8fee3061b043b7e6d19774f0abe9dd0f90532418fcb93dd","availableFormats":["json"],"listOfBooksApiLink":"/api/yre_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7955,"languageName":"Yaouré","languageEnglishName":"Yaouré"},"book":{"id":"HEB","translationId":"yre_wbt","name":"Ebre","commonName":"Ebre","title":"'Fluba nɛn min -tʋ -a crɛn -tɛ Ebre 'nɔn lɛ","order":58,"numberOfChapters":13,"sha256":"fc89ff72a0691ae6e4b126e412615c54a26c79d3ed89e22a4660ccc0cbdfbee4","firstChapterNumber":1,"firstChapterApiLink":"/api/yre_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/yre_wbt/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["-Cee Bali -panzan -dan nɛn Zozi 'a"]},{"type":"verse","number":1,"content":["'Wɩ pɛɛnɔn nɛn kʋ cɩ -a vɩnan 'gʋɛ, -a -wulo nɛn 'gʋ. -Cee Bali -panzan -dan a laji lou. E ya 'e -nyrandɩ Bali nɛn 'yee mingɔnnɛn pɛin -da bɛ -a -pɛ \"yi \"da."]},{"type":"verse","number":2,"content":["E ya Bali -pan nyranman 'panan fɛnan 'saun nɛn Bali -a man drɛ 'wɩ zɩɛ -a drɛnan -a bɛ -a -nan. Blamin \"cɛɛ fɛnan zɩɛ -a man drɛ dɩ, 'pian Bali 'bɛ man drɛ 'e 'bɔ 'a."]},{"type":"verse","number":3,"content":["Bali -panzan -dan pɛɛnɔn nɛn waa -tɔa \"bɛ, waa -tɔa 'nan -e 'e Bali -pan nyranman 'pa. -Yee \"wɛan -cee Bali -panzan -dan \"e \"fɛ -tʋ -nɔn \"nyian Bali lɛ."]},{"type":"verse","number":4,"content":["\"Te Crizi 'e 'kɔn tian 'trɛda bɛ, \"te e 'ka Bali -panzan -a dɩ. Kɔɔ Bali -pannɔn a -nan 'va. Ɛn o ya Bali -pan nyranman 'panan \"le zɩ Moizi -le -pei -a 'vɩ bɛ -yee 'wɩ 'zʋ."]},{"type":"verse","number":5,"content":["Bali -pan nyranman nɛn minnun zɩɛ waa \"paa bɛ, e ya \"le -a 'kpa nɛn waa dra laji bɛ -a -kɔɔn \"manvɛ -le 'wɩ 'zʋ. Kɔɔ zɩ Bali -a 'vɩ Moizi lɛ 'nan 'e -tandan -tɔ 'yrɛ bɛ, yaa 'vɩ 'nan:",{"text":"«'I drɛ \"yi!","poem":1},{"lineBreak":true},{"text":"-Tandan nɛn maan kɔɔn 'yiɛ","poem":1},{"lineBreak":true},{"text":"te i ya pɔn da bɛ,","poem":1},{"lineBreak":true},{"text":"-a 'lein nɛn 'i -tɔ 'mɛn.»","poem":1}]},{"type":"verse","number":6,"content":["Bali -pan nyranman nɛn Bali -a -nɔn Zozi lɛ bɛ, -a 'kpa \"mlian Bali -pannɔn pɛɛnɔn 'le vɛ da. Kɔɔ Zozi nɛn Bali -a 'si ɛn e Bali 'lee blamin yei \"sɛn 'e cin va \"nyian 'e 'pee. Ɛn blamin 'lee Bali yei \"sɛndɩ 'e cin va pee zɩɛ -a 'kpa \"mlian -a tɛdɛ vɛ da. Kɔɔ fɛ nɛn Bali -a 'vɩ 'nan 'e -nɔan \"blamin lɛ 'wɩ zɩɛ -a -ji bɛ -a 'kpa \"mlian -a tɛdɛ vɛ da."]},{"type":"verse","number":7,"content":["Bali -a 'yɩ \"yi -e 'e blamin pli 'e man \"nyian 'e 'pee, kɔɔ -a tɛdɛ vɛ nɛn Bali -a drɛ Izraɛl 'nɔn lɛ bɛ, ya'a -kɔlalɛ -e 'e o drɛ 'saun Bali 'lɛ dɩ."]},{"type":"verse","number":8,"content":["Tʋ zɩɛ -a man nɛn Bali 'wɩ 'pla Izraɛl 'nɔn 'bɔ lɛ. Yaa 'vɩ -wlɛ 'nan:",{"text":"«Tʋ -tʋ -taa \"bɔlɛ bɛ,","poem":1},{"lineBreak":true},{"text":"an Izraɛl 'nɔn","poem":1},{"lineBreak":true},{"text":"'lee Zude 'nɔn -pliman 'an man 'e 'pee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O -pli \"nɛn","poem":1},{"lineBreak":true},{"text":"maan wo 'an man 'e 'pee bɛ,","poem":1},{"lineBreak":true},{"text":"ya'a 'kɔan \"le -a tɛdɛ nɛn","poem":1},{"lineBreak":true},{"text":"maan drɛ o tranun lɛ","poem":1},{"lineBreak":true},{"text":"te an o 'si Ezipti 'lɛglɔn 'ji bɛ","poem":1},{"lineBreak":true},{"text":"-yee 'wɩ 'zʋ dɩ.","poem":1},{"lineBreak":true},{"text":"-A tɛdɛ vɛ nɛn","poem":1},{"lineBreak":true},{"text":"maan drɛ zɩɛ","poem":1},{"lineBreak":true},{"text":"wa'a 'ta wʋlɛa \"da \"dɩ,","poem":1},{"lineBreak":true},{"text":"-yee \"wɛan 'an \"trɔɛn 'si o va.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"'Pian tʋ -tʋ -taa \"bɔlɛ bɛ,","poem":1},{"lineBreak":true},{"text":"an -tɔa 'an wei da 'nan","poem":1},{"lineBreak":true},{"text":"-e 'an Izraɛl 'nɔn -pli","poem":1},{"lineBreak":true},{"text":"'an man \"nyian 'e 'pee.","poem":1},{"lineBreak":true},{"text":"Tʋ zɩɛ -a man bɛ,","poem":1},{"lineBreak":true},{"text":"'mɛn -pei -tɔ wɩnun -cin -kɔanla o ji,","poem":1},{"lineBreak":true},{"text":"ɛn zɩ kɔ min 'e 'ta wʋ 'trɛda bɛ","poem":1},{"lineBreak":true},{"text":"-yɛɛ \"paaman o ji.","poem":1},{"lineBreak":true},{"text":"An -kɔan -wee Bali -a,","poem":1},{"lineBreak":true},{"text":"ɛn o -kɔan 'mɛn minnun -a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"-E 'e \"sia nannannun man","poem":1},{"lineBreak":true},{"text":"-e 'e 'bɔ min cejenun da bɛ,","poem":1},{"lineBreak":true},{"text":"o pɛɛnɔn -taa -a -tɔlɛ 'nan","poem":1},{"lineBreak":true},{"text":"mɛɛn cɩ Bali -a.","poem":1},{"lineBreak":true},{"text":"'Wɩ zɩɛ min -tʋ \"cɛɛ \"paaman \"nyian","poem":1},{"lineBreak":true},{"text":"'e bɔɛzan -tʋ ji dɩ.","poem":1},{"lineBreak":true},{"text":"-Te 'bɛ \"cɛɛ dɩ,","poem":1},{"lineBreak":true},{"text":"min -tʋ \"cɛɛ ve 'e \"bʋɩ -tʋ lɛ 'nan,","poem":1},{"lineBreak":true},{"text":"'i 'ta -e 'i Minsan yɩ dɩ!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"-Te o 'wɩnun drɛ 'an 'va 'wlidɩ 'e 'cɛn oo,","poem":1},{"lineBreak":true},{"text":"maan \"cɛa -wlɛ.","poem":1},{"lineBreak":true},{"text":"Ɛn -te o 'mɛn -pei -tɔ wɩ -mie srɛ 'e 'cɛn oo,","poem":1},{"lineBreak":true},{"text":"ma'an \"nyian 'an 'ci nrɔnman \"da \"dɩ.»","poem":1}]},{"type":"verse","number":13,"content":["-Te Bali -tɔ 'e wei da 'nan 'e blamin -pliman 'e man 'e 'pee bɛ, yaa -kɔɔnman 'cɛɛ 'nan, -a tɛdɛ vɛ nɛn Bali -a drɛ bɛ, e drɛ \"le sɔ ceje -le 'wɩ 'zʋ. Kɔɔ -te sɔ drɛ ceje bɛ, -a 'yi \"sia \"ji, te 'bɛ 'fɔladɩ 'bɔ."]}],"footnotes":[]},"thisChapterLink":"/api/yre_wbt/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yre_wbt/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yre_wbt/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}