{"translation":{"id":"yre_wbt","name":"Bali -le 'fluba 'trɛ Zozi blamin pli Bali man 'e 'pee","website":"https://ebible.org/Scriptures/details.php?id=yreNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yreNT","licenseNotes":null,"shortName":"WBT","englishName":"Yaouré NT","language":"yre","textDirection":"ltr","sha256":"cfe0d31e4b81b9b6d8fee3061b043b7e6d19774f0abe9dd0f90532418fcb93dd","availableFormats":["json"],"listOfBooksApiLink":"/api/yre_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7955,"languageName":"Yaouré","languageEnglishName":"Yaouré"},"book":{"id":"REV","translationId":"yre_wbt","name":"Apokalis","commonName":"Apokalis","title":"'Wɩnun nɛn Zozi -a -nan kɔɔn Zan lɛ bɛ -nyrɛn 'gʋ Apokalis","order":66,"numberOfChapters":22,"sha256":"b526537c7a149af68ba9346ba2337a8fd9667aaa14528a172370da7ce1d94c8d","firstChapterNumber":1,"firstChapterApiLink":"/api/yre_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/yre_wbt/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["-Kɔnnɛn pɛɛnɔn -wɛɛzan -nan -nyan wɩ"]},{"type":"verse","number":1,"content":["\"Bɛ -sru ɛn an Bali -le 'pasiazan pee 'yɩ, te e ya 'sinan laji. E ya 'plɛblɛ 'kpa, ɛn -yee 'tɛ 'san 'trɛda 'si \"fo."]},{"type":"verse","number":2,"content":["E paan 'kpa 'plɛblɛ -a vɩdɩ -a 'nan:",{"text":"«Babilɔn -nan -nyan.","poem":1},{"lineBreak":true},{"text":"Babilɔn 'fla -dan bɛ,","poem":1},{"lineBreak":true},{"text":"-a -nan -nyan.","poem":1},{"lineBreak":true},{"text":"E drɛ -yʋ -wlidɩnun fla -a.","poem":1},{"lineBreak":true},{"text":"-Yʋ -wlidɩ 'tɔ 'tʋdʋ pɛɛnɔn -nyɛanla 'nan nun.","poem":1},{"lineBreak":true},{"text":"\"Loman 'tɔ 'tʋdʋ pɛɛnɔn nɛn o 'ka 'saun Bali 'lɛ dɩ,","poem":1},{"lineBreak":true},{"text":"ɛn minnun 'ka o ye \"yi \"dɩɛ,","poem":1},{"lineBreak":true},{"text":"o ya -nan nun.","poem":1},{"lineBreak":true},{"text":"[-Wi -tʋdʋ pɛɛnɔn nɛn","poem":1},{"lineBreak":true},{"text":"o 'ka 'saun Bali 'lɛ dɩ,","poem":1},{"lineBreak":true},{"text":"ɛn minnun 'ka o ye \"yi \"dɩɛ,","poem":1},{"lineBreak":true},{"text":"o ya -nan nun.]","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"'Lɛglɔn pɛɛnɔn 'ji minnun","poem":1},{"lineBreak":true},{"text":"Babilɔn 'fla 'le -wɛn mlin 'e 'ciɩla \"da.","poem":1},{"lineBreak":true},{"text":"-Yɛɛ cɩ 'nan","poem":1},{"lineBreak":true},{"text":"e o pɛɛnɔn wɛɛ 'kɔnnɛn -a.","poem":1},{"lineBreak":true},{"text":"Ɛn \"nyian bɛ","poem":1},{"lineBreak":true},{"text":"'trɛda mingɔnnɛnnun -fɔ -a -sru,","poem":1},{"lineBreak":true},{"text":"ɛn o 'wɩ 'wlidɩ \"tʋwli zɩɛ -a drɛ.","poem":1},{"lineBreak":true},{"text":"Ɛn 'flɛ 'tannɔn nɛn 'trɛda bɛ,","poem":1},{"lineBreak":true},{"text":"o drɛ fɛnɔn 'a,","poem":1},{"lineBreak":true},{"text":"Babilɔn 'fla yɩfɛ a \"kaga \"le \"wɛan.»","poem":1}]},{"type":"verse","number":4,"content":["\"Bɛ -sru ɛn an wei pee 'man laji. Wei zɩɛ yaa 'vɩ 'nan:",{"text":"«'Mɛn minnun,","poem":1},{"lineBreak":true},{"text":"'ka 'si Babilɔn 'fla!","poem":1},{"lineBreak":true},{"text":"'Ka 'si 'nan nun,","poem":1},{"lineBreak":true},{"text":"-e -yee 'wɩ 'wlidɩ 'e vɩlɛ e baa 'ka man dɩ,","poem":1},{"lineBreak":true},{"text":"\"tɔgɔ 'wɩ nɛn e -taa \"bɔlɛ \"man \"bɛ,","poem":1},{"lineBreak":true},{"text":"e 'bɔ 'ka man.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"'Fla zɩɛ -yee 'wɩ 'wlidɩ a \"kaga,","poem":1},{"lineBreak":true},{"text":"e bɔa labli man.","poem":1},{"lineBreak":true},{"text":"-Yee 'wɩ 'wlidɩnun 'bɔ zɩɛ","poem":1},{"lineBreak":true},{"text":"-a -cin -trɔa Bali ji.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"'Wɩnun nɛn yaa drɛ minnun lɛ bɛ,","poem":1},{"lineBreak":true},{"text":"'mɛn 'pasianɔn \"o \"dra \"nyian -yee \"lɛ.","poem":1},{"lineBreak":true},{"text":"Waa 'lɛji bɔala 'e 'pa -a \"fli.","poem":1},{"lineBreak":true},{"text":"'Kulenɛn nɛn e 'wɩ 'wlidɩ 'fa 'a","poem":1},{"lineBreak":true},{"text":"ɛn yaa -nɔn minnun lɛ bɛ,","poem":1},{"lineBreak":true},{"text":"waa faa 'e 'pa -a \"fli","poem":1},{"lineBreak":true},{"text":"-e 'o -nɔn -yee \"lɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"'Fla zɩɛ,","poem":1},{"lineBreak":true},{"text":"zɩ 'e 'tɔ 'wɩdɩ 'yɩ \"yi","poem":1},{"lineBreak":true},{"text":"ɛn e fɛ yɩdɩ 'yɩ \"yi \"bɛ,","poem":1},{"lineBreak":true},{"text":"-a da nɛn o 'tɛ \"paa \"da,","poem":1},{"lineBreak":true},{"text":"ɛn -a da nɛn waa ta dra -trɔdrɔ.","poem":1},{"lineBreak":true},{"text":"Yaa 'vɩ 'e 'fli man 'nan,","poem":1},{"lineBreak":true},{"text":"e ya mingɔnnɛn -blɩnan,","poem":1},{"lineBreak":true},{"text":"ɛn -kɔnnɛn 'ka 'kalɛ 'e da dɩ,","poem":1},{"lineBreak":true},{"text":"ɛn 'e 'ta 'ka 'li 'dra -trɔdrɔ \"fo \"dɩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"'Wɩ nɛn yaa 'vɩ zɩɛ -yee \"wɛan bɛ,","poem":1},{"lineBreak":true},{"text":"'wɩnun nɛn o -taa \"bɔlɛ \"man","poem":1},{"lineBreak":true},{"text":"yi -tʋwli \"cɛ 'wlu bɛ -nyrɛn 'gʋ,","poem":1},{"lineBreak":true},{"text":"-cɛ bɔdɩ a -tʋ,","poem":1},{"lineBreak":true},{"text":"ɛn ta drɛdɩ -trɔdrɔ a -tʋ,","poem":1},{"lineBreak":true},{"text":"ɛn dra -tɛdɩ a -tʋ.","poem":1},{"lineBreak":true},{"text":"Ɛn 'tɛ 'bɛ -taa -a -nan -nyanlɛ.","poem":1},{"lineBreak":true},{"text":"Kɔɔ Minsan Bali nɛn e tin -tɛ \"da \"bɛ,","poem":1},{"lineBreak":true},{"text":"e ya 'plɛblɛ.»","poem":1}]},{"type":"verse","number":9,"content":["'Trɛda mingɔnnɛnnun nɛn o -fɔ -a -sru, ɛn -yee 'wɩ 'wlidɩ zɩɛ \"o drɛ, ɛn \"o fɛ yɩdɩ 'yɩ \"yi \"bɛ, 'wɩ -taa 'nanlɛ o man. Tʋ nɛn o 'fla zɩɛ -a -yee 'tɛ 'blɩnan bɛ, -a -nan nɛn 'wɩ 'nandɩ \"siala o man."]},{"type":"verse","number":10,"content":["'Wɩ nɛn e -taa \"bɔlɛ 'fla zɩɛ -a man bɛ, e o -tɛa \"klan -a, -yee \"wɛan wa'a -kɔlaman -e 'o -pli \"man \"kogo dɩ. 'Pian o -fo -kɔɔbli te o -paanman. Waa ve 'nan:",{"text":"«Babilɔn 'fla -dan,","poem":1},{"lineBreak":true},{"text":"'wɩ 'bɔ 'i man,","poem":1},{"lineBreak":true},{"text":"'wɩ 'bɔ 'i man.","poem":1},{"lineBreak":true},{"text":"Tʋ \"wɛnnɛn \"cɛ 'wlu nɛn","poem":1},{"lineBreak":true},{"text":"Bali cɛɛn 'wɩ \"nɛn -kɔɔndɩ man 'yiɛ.»","poem":1}]},{"type":"verse","number":11,"content":["'Wɩ nɛn e -taa \"bɔlɛ 'fla zɩɛ -a man bɛ, -yee \"wɛan 'flɛ 'tannɔn 'wuɔdɩ \"siala, kɔɔ min 'ka \"nyian -wee 'flɛ 'lɔa dɩ."]},{"type":"verse","number":12,"content":["-Wee 'flɛnun 'bɔ nɛn 'gʋ: -siga fɛnun 'lee \"lala fɛnun, 'lee -kɔlɛnun nɛn o 'flɛ \"mlian -siga da bɛ, 'lee mingɔnnɛnnun da sɔnun, 'lee yiba \"nɛn -a 'flɛ cɩ bɛ, 'lee -fiɩ 'shɛ fɛnun, 'lee -bulalɛ fɛnun, 'lee -kɔlɛ 'kpagba,"]},{"type":"verse","number":13,"content":["'lee -laziglɔ 'tɔ 'tʋdʋ pɛɛnɔn, 'lee rɛzɛn -wɛn, 'lee 'nyrɔn, 'lee -fari puu, 'lee fei fɛ 'wlɛnun, 'lee trinun, 'lee 'blanun, 'lee -sʋnun, 'lee odronun, 'lee nɔannun."]},{"type":"verse","number":14,"content":["Yiba \"bɛ 'wlɛ \"trandɩ pɛɛnɔn nɛn yaa 'yɩ \"yi \"bɛ, -a -nan -nyan. Ɛn -a yɩfɛnun pɛɛnɔn bɛ, o 'san -yrɔ, wa'a \"nyian taa \"fo \"dɩ."]},{"type":"verse","number":15,"content":["'Flɛ 'tannɔn nɛn o drɛ fɛnɔn 'a Babilɔn 'fla 'le \"wɛan bɛ, 'wɩ nɛn e -taa \"bɔlɛ 'fla zɩɛ -a man bɛ, e o -tɛa \"klan -a, -yee \"wɛan wa'a 'kɔlaman -e 'o -pli \"man \"kogo dɩ. 'Pian o -fo -kɔɔbli te o -wua."]},{"type":"verse","number":16,"content":["Waa 've 'nan:",{"text":"«Babilɔn 'fla -dan,","poem":1},{"lineBreak":true},{"text":"'wɩ 'bɔ 'i man,","poem":1},{"lineBreak":true},{"text":"'wɩ 'bɔ 'i man.","poem":1},{"lineBreak":true},{"text":"'I man a 'e 'padɩ","poem":1},{"lineBreak":true},{"text":"\"nɛn mingɔnnɛnnun da sɔnun -a","poem":1},{"lineBreak":true},{"text":"'lee -siga fɛnun 'lee -kɔlɛnun nɛn","poem":1},{"lineBreak":true},{"text":"o 'flɛ \"mlian -siga da bɛ -a.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɛn tʋ \"wɛnnɛn 'wlu nɛn","poem":1},{"lineBreak":true},{"text":"Bali -a pɛɛnɔn zɩɛ -a -nan -nyan.","poem":1},{"lineBreak":true},{"text":"E bɔa 'lɛri -tʋ.»","poem":1},"'Wɩ nɛn e -taa \"bɔlɛ 'fla zɩɛ -a man bɛ, -yee \"wɛan -klʋ -dandan -fɔnɔn 'lee minnun nɛn o \"ta 'ta wo ɛn o ya -klʋ 'bɔ 'ji bɛ, 'lee minnun nɛn o 'nyranman \"paa -klʋ 'bɔ 'ji bɛ, 'lee minnun nɛn o 'wee -blɩfɛ ye 'yi yiɛ da bɛ, o pɛɛnɔn 'fʋ -kɔɔbli."]},{"type":"verse","number":18,"content":["Zɩ 'fla zɩɛ e ya -blɩnan, ɛn waa 'tɛ -goei 'yɩ bɛ, ɛn o pɛɛnɔn -a vɩdɩ 'sia 'wɩ 'nanmandɩ -a 'nan: «Babilɔn 'fla -dan, 'i yra \"nɛn 'fla 'ka yɩlɛ 'trɛda 'li \"fo \"dɩ.»"]},{"type":"verse","number":19,"content":["O 'trɛ 'wi 'o da, te o -wua 'wɩ 'nanmandɩ -a. Waa ve 'nan:",{"text":"«Babilɔn 'fla -dan,","poem":1},{"lineBreak":true},{"text":"'wɩ 'bɔ 'i man,","poem":1},{"lineBreak":true},{"text":"'wɩ 'bɔ 'i man.","poem":1},{"lineBreak":true},{"text":"Minnun pɛɛnɔn nɛn","poem":1},{"lineBreak":true},{"text":"'wee -klʋ -dandannun a 'yi yiɛ da bɛ","poem":1},{"lineBreak":true},{"text":"o drɛ fɛnɔn 'a,","poem":1},{"lineBreak":true},{"text":"'i yɩfɛ a \"kaga \"le \"wɛan.","poem":1},{"lineBreak":true},{"text":"Tʋ \"wɛnnɛn \"cɛ 'wlu nɛn","poem":1},{"lineBreak":true},{"text":"Bali cɛɛn 'wɩ \"nɛn -kɔɔndɩ man 'yiɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"'Pian kaa nɛn ka cɩ laji bɛ,","poem":1},{"lineBreak":true},{"text":"'lee kaa nɛn","poem":1},{"lineBreak":true},{"text":"ka cɩ Bali -le minnun -a bɛ,","poem":1},{"lineBreak":true},{"text":"'lee kaa nɛn","poem":1},{"lineBreak":true},{"text":"ka cɩ Zozi -le 'pasianɔn 'a bɛ,","poem":1},{"lineBreak":true},{"text":"'lee kaa nɛn","poem":1},{"lineBreak":true},{"text":"ka cɩ Bali 'lewei vɩnɔn 'a bɛ,","poem":1},{"lineBreak":true},{"text":"'ka 'ci 'e \"nran!","poem":1},{"lineBreak":true},{"text":"Kɔɔ Bali 'wɩ \"nɛn kɔɔn Babilɔn 'fla -dan lɛ,","poem":1},{"lineBreak":true},{"text":"'wɩ nɛn yaa drɛ 'cɛɛ bɛ -yee \"wɛan.»","poem":1}]},{"type":"verse","number":21,"content":["-A -nan nɛn Bali -le 'pasiazan -tʋ nɛn e ya 'plɛblɛ 'kpa bɛ, e -kɔlɛbu -dan 'kpa 'sia ɛn yaa tuʋ jemie -va, ɛn yaa 'vɩ 'nan:",{"text":"«Zɩ Babilɔn 'fla -dan bɛ","poem":1},{"lineBreak":true},{"text":"o -taa -a tuʋlɛ zɩɛ,","poem":1},{"lineBreak":true},{"text":"te wa'a \"nyian -a ye 'li \"fo \"dɩ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wa'a \"nyian \"dre \"fɔ \"da \"fɛnun -cin 'wɩdɩ maan","poem":1},{"lineBreak":true},{"text":"-nan 'li \"fo \"dɩ,","poem":1},{"lineBreak":true},{"text":"ɛn wa'a \"nyian \"dre maan","poem":1},{"lineBreak":true},{"text":"-nan 'li \"fo \"dɩ.","poem":1},{"lineBreak":true},{"text":"Wa'a bla bʋnɔn 'ye","poem":1},{"lineBreak":true},{"text":"'nan 'li \"fo \"dɩ,","poem":1},{"lineBreak":true},{"text":"ɛn wa'a \"nyian fɛ -sɔndɩ -cin 'wɩdɩ maan","poem":1},{"lineBreak":true},{"text":"-nan 'li \"fo \"dɩ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wa'a \"nyian -kannɛn 'san ye","poem":1},{"lineBreak":true},{"text":"-nan 'li \"fo \"dɩ,","poem":1},{"lineBreak":true},{"text":"ɛn lɩ 'pa \"fɛdinun 'ka \"nyian -kɔan","poem":1},{"lineBreak":true},{"text":"-nan 'li \"fo \"dɩ.","poem":1},{"lineBreak":true},{"text":"Fɛ -le \"wɛan nɛn 'wɩ zɩɛ e 'bɔ 'i man bɛ,","poem":1},{"lineBreak":true},{"text":"-nyrɛn 'nan:","poem":1},{"lineBreak":true},{"text":"'Yie 'flɛ 'tannɔn 'tɔ bɛ wɩɩ 'trɛ 'gʋɛ -a da.","poem":1},{"lineBreak":true},{"text":"'Yie -dravia wɩnun drɛdɩ -a nɛn","poem":1},{"lineBreak":true},{"text":"i 'trɛda minnun pɛɛnɔn see paa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Babilɔn 'fla -dan,","poem":1},{"lineBreak":true},{"text":"yiɛ Bali 'lewei vɩnɔn tɛɛ,","poem":1},{"lineBreak":true},{"text":"ɛn yiɛ Bali -le minnun tɛɛ.","poem":1},{"lineBreak":true},{"text":"Ɛn \"nyian bɛ minnun pɛɛnɔn nɛn","poem":1},{"lineBreak":true},{"text":"minnun o tɛɛ bɛ,","poem":1},{"lineBreak":true},{"text":"yiɛ -maan ɛn e drɛ.","poem":1},{"lineBreak":true},{"text":"'Wɩ zɩɛ -yee \"wɛan nɛn","poem":1},{"lineBreak":true},{"text":"Bali 'wɩ \"nɛn kɔɔn 'yiɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yre_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yre_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yre_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}