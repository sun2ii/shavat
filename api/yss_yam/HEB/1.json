{"translation":{"id":"yss_yam","name":"God Reri Teiktem Tuma Ager","website":"https://ebible.org/Scriptures/details.php?id=yss-yamano","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yss-yamano","licenseNotes":null,"shortName":"YAM","englishName":"Yessan-Mayo Yamano NT","language":"yss","textDirection":"ltr","sha256":"69a9110c05549f6708c63237493145a284ff6e2a6cd303c9cd8e8c3da1ef4277","availableFormats":["json"],"listOfBooksApiLink":"/api/yss_yam/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7924,"languageName":"Yessan-Mayo","languageEnglishName":"Yessan-Mayo"},"book":{"id":"HEB","translationId":"yss_yam","name":"Hibru","commonName":"Hibru","title":"Hibru Hibru tatame remne newopitim siglow.","order":58,"numberOfChapters":13,"sha256":"9e335ecc6d65a1d6ed3774bdc442b5e3011711b77b083218d67cbfe7398b258f","firstChapterNumber":1,"firstChapterApiLink":"/api/yss_yam/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/yss_yam/HEB/13.json","totalNumberOfVerses":299},"chapter":{"number":1,"content":[{"type":"heading","content":["God Reri Yen re nemne tuma wesowem."]},{"type":"verse","number":1,"content":["Kiyi God re nemri yeiwarege remne agerbo agerbo yabelke re remne agerbo agerbo wulek tuma ek wesowbem. Re reri tuma wesowbem tame remne kiyi wesowbemke, sene rem er tuma nemri yeiwarege remne ek wesowbem."]},{"type":"verse","number":2,"content":["Gwopte nowsel legete matnaye, God re Reri Yen rene tuma weiwen re nemne er tuma wesowbem. Re kiyi wem, er yen re lip, yabel, nowsel nenem. Nowsel legete, Yen re aboyei wos potte tetane."]},{"type":"verse","number":3,"content":["God eter malebokap er yen re etop malebo. Re har God eterkap, re God eterri tame yopkap. Reri tuma et kitimena bukre tetane, eker eter webokap, nowsel re som tetane. Re tatame remri yaper nen wos poten septikeipem, re Hevenke yawun Keryen Yen God eterri mame yokwok sim. God re Keryen Yen bukrewai."]},{"type":"heading","content":["God Reri Yen re God reri kwomri tame remne teitkwuntene."]},{"type":"verse","number":4,"content":["God re Yener rene sig bukrekene yenbokene newom, eker, Yener re God reri kwomri tame remri keryen yen tem, rem eterri kulke tetane."]},{"type":"verse","number":5,"content":["Kiyi God re Yener rene op wem.",{"text":"Ne ari Yen.","poem":1},{"lineBreak":true},{"text":"Gwopte an neri ha teye.","poem":1},"(Buk Song 2:7) Re sene op wem.",{"text":"An eterri Ha. Re Areri Yen.","poem":1},"(2Samuel 2:4) God re reri kwom tame remne etop kirkir be wem. Yehow."]},{"type":"verse","number":6,"content":["Re reri masetebo Yen rene nowselke yerte weraste nenbem, re op wem.",{"text":"Ari kwomri tame rem","poem":1},{"text":"aboyei eterne lom yokwote.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"God re reri kwom tame","poem":2},{"lineBreak":true},{"text":"etemne habon op wem.","poem":2},{"text":"Ari kwom tame rem polikap","poem":1},{"text":"tete.","poem":2},{"text":"Ari kwom tame rem ker","poem":1},{"text":"taulekap tete.","poem":2},"(Buk Song 104:4)"]},{"type":"verse","number":8,"content":["Re Reri Yener rene op wem.",{"text":"God, ne kwom panen si","poem":1},{"text":"tame somsom temente.","poem":2},{"text":"Ne neri tatame remne","poem":1},{"text":"kwom panen sibo,","poem":2},{"text":"ne yenbo wulewou nenbo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wule yenbo ne okbop tebo.","poem":1},{"text":"Wule yaper ne muwai","poem":2},{"lineBreak":true},{"text":"webo.","poem":2},{"text":"Juda tame rem etemri","poem":1},{"text":"keryen yen remne kwar","poem":2},{"lineBreak":true},{"text":"tarek sirbokap,","poem":2},{"text":"God re nene lebam, nene","poem":1},{"text":"keryen yen wem.","poem":2},{"text":"Eker ne okbopwai tebo, ne","poem":1},{"lineBreak":true},{"text":"2 sig bukre tetane.","poem":1},{"lineBreak":true},{"text":"Re nene heyar nenemkap,","poem":1},{"text":"re agerbo tame remne etop","poem":2},{"lineBreak":true},{"text":"be nenem.","poem":2},"(Buk Song 45:6-7)"]},{"type":"verse","number":10,"content":["God re rene sene op wem.",{"text":"Haneyen, kiyisapewai ne","poem":1},{"text":"nowsel nenem.","poem":2},{"text":"Nelri wos mere, ne neri","poem":1},{"text":"letke nenem.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nelkene selkene rep yaper","poem":1},{"text":"tete tetane.","poem":2},{"text":"Neren, ne yaper be tete. Ne","poem":1},{"text":"som temente tetane.","poem":2},{"text":"Tame oub rem suba ten","poem":1},{"text":"weyarbokap,","poem":2},{"text":"nelkene selkene rep suba","poem":1},{"text":"ten weyarte tetane.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tatame rem tame oub lugen","poem":1},{"text":"gwolben rasbokap,","poem":2},{"lineBreak":true},{"text":"ne nelkene selkene repne","poem":2},{"lineBreak":true},{"text":"etop nente tetane.","poem":2},{"text":"Tatame rem tame oub lugen","poem":1},{"text":"agerbo tame oub wubokap,","poem":2},{"lineBreak":true},{"text":"ne nelkene selkene repne etop","poem":2},{"lineBreak":true},{"text":"sene nente tetane.","poem":2},{"text":"Nerenwou ne etopwou som","poem":1},{"text":"temente tetane.","poem":2},{"text":"Ne etopkap som temente","poem":1},{"text":"tetane.","poem":2},"(Buk Song 102:25-27)"]},{"type":"verse","number":13,"content":["Kiyi God re yener rene op wem.",{"text":"Ne areri let mame yokwok","poem":1},{"text":"site.","poem":2},{"text":"Yuri an neri peiktame","poem":1},{"text":"remne poten neri tewo kulke","poem":2},{"lineBreak":true},{"text":"pete wurte tetane.","poem":2},"(Buk Song 110:1) God reri kwom tame remne re etop be wem."]},{"type":"verse","number":14,"content":["God reri kwom tame rem mapkap? Aboyei rem wow. Rem God reri yaku nenbo tame. God re remne werasen yibo, God eter potte tatame remne rem kwobo labo. Rem etop nenbo."]}],"footnotes":[]},"thisChapterLink":"/api/yss_yam/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yss_yam/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yss_yam/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}