{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":100,"content":[{"type":"heading","content":["Piŋkop ya yaŋ iyɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Amɨn mɨktɨmɨ mɨktɨmɨ ekwaŋ ji kɨsɨk kɨsɨk aŋek yaŋ tɨdaŋek Yawe aŋkɨsini.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ji but galagon da Yawe gawak ɨmni.","poem":1},{"text":"Kɨsɨk kɨsɨk kap yaŋek uŋun da kapmatjok kɨni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yawe uŋun Piŋkop yaŋsi nandaŋ ɨmni.","poem":1},{"text":"Uŋun da iyɨ nin wasaŋ nipgut.","poem":2},{"lineBreak":true},{"text":"Nin uŋun dakon gɨn.","poem":2},{"lineBreak":true},{"text":"Nin uŋun dakon mɨŋat amɨn kabɨni, nin sipsip kabɨni iyɨ pawɨlakwan ekwamaŋ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Telagɨ yut madep da nagalgwan pɨgek ya yaŋ iyɨŋek aŋkɨsineŋ.","poem":1},{"text":"Nin ya yaŋ iyɨŋek mani yaŋ aŋenotneŋ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nido Yawe uŋun tagɨsi.","poem":1},{"text":"Dagok dagogɨ mɨni amɨn do but dasi galak taŋ yomɨsak.","poem":2},{"lineBreak":true},{"text":"Babɨkon da babɨkon geni aŋteban aŋek amɨn kabɨni paŋpulugaŋ aŋaŋ kɨkdɨsak teban.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}