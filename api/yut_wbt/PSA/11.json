{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":11,"content":[{"type":"heading","content":["Amɨn kɨnda Piŋkop do nandaŋ gadat tebaisi agɨt"]},{"type":"hebrew_subtitle","content":["Dewit dakon kap kɨnda. Kap on kap yoŋ dakon kɨla amɨn do mandabi."]},{"type":"verse","number":1,"content":[{"text":"Nak aŋkutnosak do Yawekon kɨsat.","poem":1},{"text":"Do gak nido yaŋ nayɨsal, “Amɨn yokwi obipni paŋɨlɨkgaŋ!","poem":2},{"lineBreak":true},{"text":"Pɨlɨn tukgwan amɨn kɨlegɨ yam do dɨkdɨkni bɨsapmon sambaŋ!","poem":2},{"lineBreak":true},{"text":"Do mɨnam kɨnda da yaŋ pasalek kabapgwan wɨgɨ!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Aŋpak kɨlegɨ dakon teban tokni kɨsi tuwɨl kɨ mudoni kaŋ, amɨn kɨlegɨ niaŋ ani?”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mani Yawe telagɨ yutnikon egɨsak.","poem":1},{"text":"Kwen Kokup kɨla amɨn madep egek dabɨlɨ da amɨn morap kɨsi pɨndakdak.","poem":2},{"lineBreak":true},{"text":"Yo morap aŋ uŋun kɨsisi nandaŋ mudosok.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawe da amɨn kɨlegɨ ae amɨn yokwi kakgɨmansi kokwin asak.","poem":1},{"text":"Emat do galak toŋ amɨn dɨmasi galak taŋ yomɨsak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amɨn yokwi do kɨndap tepmɨsi sosok uŋun tagal yomɨsak.","poem":1},{"text":"Aŋek gɨptɨmni obɨsi soŋ yomni do mɨrɨm tepmɨsi sosok uŋun yɨpban abɨsak.","poem":2},{"lineBreak":true},{"text":"Uŋun yokwi awit dakon kobogɨni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawe aŋpak kɨlegɨ gɨn asak.","poem":1},{"text":"Aŋpak kɨlegɨ aŋ amɨn do but dasi galak taŋ yomɨsak.","poem":2},{"lineBreak":true},{"text":"Aŋpak kɨlegɨ aŋ amɨn uŋun da tomno dabɨlni kokdaŋ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":6}