{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":113,"content":[{"type":"heading","content":["Piŋkop da yo tagɨsi aŋ yomɨsak do kɨsɨk kɨsɨk aŋ"]},{"type":"verse","number":1,"content":[{"text":"Yawe aŋkɨsini.","poem":1},{"text":"Oman amɨni ji Yawe aŋkɨsini.","poem":2},{"lineBreak":true},{"text":"Mani aŋkɨsini.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dagok dagogɨ mɨni Yawe dakon man aŋkɨsini.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gɨldat da wɨsak tetgɨn ae pɨgɨsak tetgɨn mɨŋat amɨn morap ekwaŋ kɨsi da Yawe aŋkɨsini.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yawe uŋun mɨktɨmɨ mɨktɨmɨ man madepni tosok.","poem":1},{"text":"Tɨlɨmni uŋun kundu si yapmaŋek wagɨl tagɨsisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawe Piŋkopnin egɨsak, uŋun yombem kɨnda mɨni.","poem":1},{"text":"Uŋun kwensi kɨla amɨn madep yɨtyɨt tamonikon yɨkdak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uŋudon da mibɨlɨsigwan sɨŋtaŋek kundu gat mɨktɨm gat pɨndakdak.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aŋek yoni mɨni amɨn sɨbɨt sɨbɨt tamokon ekwaŋ uŋun paŋpulugaŋek","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"iyɨ dakon mɨŋat amɨn kabɨni dakon kɨla amɨn gat yopban tagɨsi ekwaŋ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɨŋat monjɨ suŋ ekwaŋ uŋun paŋpulugaŋban monjɨ morapmɨ paŋalaŋek kɨsɨk kɨsɨk madepsi aŋ.","poem":1},{"text":"Yawe aŋkɨsini.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}