{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":120,"content":[{"type":"heading","content":["Amɨn kɨnda Piŋkop da aŋpulugosak do bɨsit agɨt"]},{"type":"hebrew_subtitle","content":["Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Jɨgɨ noman taŋ namgwit bɨsapmon Yawe do yaŋ tɨdoko bɨsitno nandaŋ namgut.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɨsit yaŋ agɨm, “Yawe, top amɨn da nak aŋkewalni yaŋ do nak pulugaŋ nepbi.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Top amɨn ji, Piŋkop da ji do yo ni baŋ aŋ damjak?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Uŋun da emat amɨn dakon gobɨŋ baŋ yamaŋ damdɨsak.","poem":1},{"text":"Aŋek kɨndapni tedepmɨ jikon tagaldɨsak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nak ji da binapmon yokwisi egɨsat.","poem":1},{"text":"Amɨn da Mesek mɨktɨmon bo Kade amɨn da binapmon yokwisi ekwaŋ uŋun da tɨlak jikon yokwisi egɨsat.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nak mɨŋat amɨnyo yaworɨ egɨp egɨp do ɨkwayɨt aŋ amɨn gat kɨsi bɨsap dubagɨsi ekwamaŋ, do kuragɨsi nandɨsat.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nak da tagɨsi yɨtni do yosot bɨsapmon uŋun emat gɨn ak do nandaŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}