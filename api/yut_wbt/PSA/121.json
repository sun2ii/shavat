{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":121,"content":[{"type":"heading","content":["Yawe uŋun nin dakon kɨla amɨn"]},{"type":"hebrew_subtitle","content":["Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Nak sɨŋtoko ɨleŋon wɨgɨsak.","poem":1},{"text":"Paŋpulugokno dukwan da apban kokeŋ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawe kundu gat ae mɨktɨm gat wasagɨt uŋun dagɨn paŋpulugokno egɨsak.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kɨlago asak, do arɨpmɨ dɨma maŋ pokgi.","poem":1},{"text":"Kɨlago aŋek dɨpmɨn dɨma pokdok.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pakyaŋsi nandani, Israel amɨn dakon kɨla amɨn uŋun pak nandat kɨnda dɨmasi asak.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawe uŋun gak da ɨleŋonjok egek kɨlago aŋek gak aŋyoŋgam asak.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gɨldat da gɨldat kalba ae kanek da kalbi arɨpmɨ dɨma aŋupbal anjil.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yawe da kɨlago aŋakwan yo yokwi morap toŋ kɨndasok da gak dɨma aŋupbal asak.","poem":1},{"text":"Egɨp egɨpgo kɨsi kɨla asak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe da abɨsok ae don kɨŋ apyo akdɨsal uŋun kɨlago aŋaŋ wɨgɨkdɨsak.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}