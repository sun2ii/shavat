{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":122,"content":[{"type":"heading","content":["Jerusalem aŋkɨsik dakon kap"]},{"type":"hebrew_subtitle","content":["Dewit dakon kap kɨnda. Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"“Kɨlɨ apba Yawe da yutnon kɨno” yaŋ nayɨŋba nandabo tagɨsi agɨt.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nin kɨlɨ abɨŋ Jerusalem dakon wigat yapmaŋek nagalgwan pɨgɨmaŋ da akgamaŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalem kokup pap uŋun wagɨl tagɨsi wasaŋbi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Israel amɨn ɨdon abɨŋ Yawe ya yaŋ iyɨni do kalɨp kɨlɨ yoyɨgɨt uŋun gen yolek abɨŋ abɨŋ aŋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Uŋudon gen kokwin agak tamo tosok.","poem":1},{"text":"Dewit dakon dɨwatni kɨla amɨn madep egɨ egɨ awit uŋun dakon gen kokwin tamo toŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jerusalem yaworɨsi tosak do bɨsit ani.","poem":1},{"text":"Bɨsit yaŋ ani,","poem":2},{"lineBreak":true},{"text":"“Yawe, Jerusalem do galagɨ nandaŋ amɨn paŋpulugaŋbɨ tagɨsi egɨpni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Paŋpulugaŋbɨ Jerusalem da nagalgwan ekwaŋ amɨn emarɨ mɨni tagɨsi egɨpni, ae kɨla amɨni gat kɨsi tagɨsi egɨpni dosi nandamaŋ.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gwakno gat ae notno gat do nandaŋek Jerusalem amɨn do bɨsit yaŋ abeŋ,","poem":1},{"text":"“Ji emarɨ mɨni tagɨsi egɨpni.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nak Yawe Piŋkopnin dakon telagɨ yut do nandaŋek bɨsit yaŋ abeŋ,","poem":1},{"text":"“Yo kɨnda do wadak wadagɨ mɨni tagɨsi egɨpni.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}