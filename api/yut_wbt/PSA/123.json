{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":123,"content":[{"type":"heading","content":["Amɨn kɨnda Piŋkop da bupmɨ nandaŋ ɨmjak do bɨsit agɨt"]},{"type":"hebrew_subtitle","content":["Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Yawe, nak Kwen Kokup sɨŋtoko wɨgakwan gandako kɨla amɨn madep yɨyɨt tamogokon yɨkdal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oman amɨn amɨn tagɨni do nandaŋ gadasak, aŋakwan pi amɨn mɨŋat uŋun amɨn tagɨ mɨŋat do nandaŋ gadasak, yaŋ gɨn nin Yawe gak do nandaŋ gadamaŋ.","poem":1},{"text":"Gak Piŋkopnin, gak dagɨn bupmɨ nandaŋ nibi do jomjom amaŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yawe, amɨn da yokwi aŋ nimɨŋakwa jɨgɨsi nandamaŋ, do bupmɨ nandaŋ nibi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɨsap dubagɨsi iyɨ do nandaba wɨkwaŋ amɨn da pabɨŋ nipgwit, do jɨgɨsi nandamaŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}