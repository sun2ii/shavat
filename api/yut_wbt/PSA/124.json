{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":124,"content":[{"type":"heading","content":["Piŋkop uŋun mɨŋat amɨn kabɨni dakon Paŋpulugok Amɨni"]},{"type":"hebrew_subtitle","content":["Dewit dakon kap kɨnda. Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"“Yawe da nin dɨma paŋpulugagɨt tam, niaŋɨ?”","poem":1},{"text":"Israel amɨn da uŋun gen dakon kobogɨ yoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Amɨn da butjap nandaŋ nimɨŋek ninon emat awit bɨsapmon Yawe da nin dɨma paŋpulugagɨt tam, uwal da japmɨsi nandaŋek obɨsi tagɨ paŋupbal abam.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Butjapni pakbi da yaŋ ɨgek tɨmɨkban tagɨ pasɨlnom.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pakbi madep uŋun ɨgek tɨmɨkban tagɨ kɨmak mudonom.","poem":1},{"text":"Mani dɨma.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nin Yawe do ya yaŋsi iyɨneŋ.","poem":1},{"text":"Yum nindaŋakwan uwal da nin dɨma nindapba pasɨlgɨmaŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nin mɨnam da yaŋ amɨn kɨnda da pat yɨpguron yokwalgɨmaŋ da pulugaŋ kɨgɨmaŋ.","poem":1},{"text":"Pat uŋun tuwɨl kɨgɨt, do nin pulugaŋ kɨgɨmaŋ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe Kwen Kokup ae mɨktɨmyo wasagɨt, uŋun da iyɨ nin tagɨsi paŋpulugosok.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}