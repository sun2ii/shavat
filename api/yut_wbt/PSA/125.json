{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":125,"content":[{"type":"heading","content":["Piŋkop da mɨŋat amɨn kabɨni yopban tagɨsi yɨkgaŋ"]},{"type":"hebrew_subtitle","content":["Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Mɨŋat amɨnyo egɨp egɨpni Yawekon tosok yaŋsi nandaŋ amɨn uŋun Saion Kabap yombem.","poem":1},{"text":"Kabap uŋun dɨma nɨmnɨmɨgek tebaisi tokdɨsak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ɨleŋ da Jerusalem aŋgwasɨŋek toŋ uŋun da tɨlak Yawe da abɨsok ae don paŋgwasɨŋek mɨŋat amɨni kɨlani akdɨsak.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Amɨn yokwi da amɨn kɨlegɨ dakon mɨktɨm toktogɨ kɨlani dɨma ani.","poem":1},{"text":"Yaŋ ani kaŋ, amɨn kɨlegɨ yokwi akdaŋ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe, amɨn tagɨsi butni kɨlegɨ uŋun amɨnon aŋpak tagɨsi aŋyobi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mani mɨŋat amɨnyo iyɨ dakon aŋpak yokwini yolek aŋ, uŋun yo yokwisi aŋ yobi.","poem":1},{"text":"Yokwi pakpak amɨn do yo yokwisi aŋ yobi.","poem":2},{"lineBreak":true},{"text":"Israel amɨn yaworɨ tagɨ egɨpni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}