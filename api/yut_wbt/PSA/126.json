{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":126,"content":[{"type":"heading","content":["Piŋkop da paŋpulugosak do Israel amɨn da bɨsit awit"]},{"type":"hebrew_subtitle","content":["Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Yawe da nin uwal da kɨsiron baŋ tɨmɨk aeni Saion kokup papmon paŋapgut bɨsapmon dɨpmɨn yombem pɨndakgɨmaŋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nin jɨkgo madepsi yanjagɨmaŋ.","poem":1},{"text":"Aŋek kɨsɨk kɨsɨk kap yagɨmaŋ.","poem":2},{"lineBreak":true},{"text":"Yaŋ aŋapno mɨktɨm dɨwarɨ dakon mɨŋat amɨnyo da yaŋ yawit,","poem":2},{"lineBreak":true},{"text":"“Yawe da Israel amɨn paŋpulugok do pi madepsi agɨt.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asisi, Piŋkop da nin paŋpulugok do pi madepsi agɨt, do nin wagol tagɨsisi nandamaŋ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe, mɨktɨm kɨbɨrɨkon sɨkak maŋakwa joŋ yo morap ae kwoŋ uŋun da tɨlak paŋpulugaŋaki kalɨp tagɨsi egɨpgumaŋ yaŋ gɨn aenin tagɨsi egɨpneŋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amɨn kunam tagek jap kwaokgaŋ, uŋun kɨsɨk kɨsɨk nandaŋek bamɨ pakdaŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asisi, amɨn kunam tagek jap yet kwaot do jap yet pigaga paŋgwaŋ, uŋun don jap bamɨ pektaŋba paŋ paŋobɨŋek kɨsɨk kɨsɨk kap yokdaŋ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}