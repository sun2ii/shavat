{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":127,"content":[{"type":"heading","content":["Piŋkop da yo tagɨsi aŋ yoban mani aŋkɨsiwit"]},{"type":"hebrew_subtitle","content":["Solomon dakon kap kɨnda. Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Yawe da paŋpulugaŋban kɨsit kɨlda yut dɨma aŋ tam, pi ɨsal dogɨn abam.","poem":1},{"text":"Yawe da paŋpulugaŋban kɨla amɨn kokup pap kɨnda kɨlani dɨma aŋ tam, kɨla ɨsal dogɨn abam.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nin jap tɨmɨt do nandaba kɨk aŋek wɨsa dɨma dagaŋakwan pɨdaŋ pi gɨn aŋegapno wɨgɨ pɨlɨn toni kaŋ, pi uŋun ɨsal dogɨn amaŋ.","poem":1},{"text":"Nido, Piŋkop da mɨŋat amɨnyo but dasi galak taŋ yomɨsak uŋun yɨk yawot yomɨsak.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Piŋkop da nin do yo tagɨsi aŋ nimɨŋek monjɨ gwayo but galak do nimɨsak.","poem":1},{"text":"Uŋun gɨsam tagɨsi Piŋkopmon tɨmɨkgamaŋ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawi kaluk dakon monjɨ gwayo uŋun gobɨŋ da yaŋ emat amɨn kɨnda da kɨsiron toŋ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Amɨn monjɨ gwayo morapmɨ amɨn kɨsɨk kɨsɨk tagɨ ani.","poem":1},{"text":"Uŋun da gen pi tamokon uwal gat gen pi aŋakwa aŋpulugokdaŋ.","poem":2},{"lineBreak":true},{"text":"Aŋakwa mayagɨ dɨma pakdɨsak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}