{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":128,"content":[{"type":"heading","content":["Piŋkop da geni guramɨkgaŋ amɨn do yo tagɨsi aŋyomɨsak"]},{"type":"hebrew_subtitle","content":["Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Amɨn morap Yawe do pasalek geni guramɨkgaŋ uŋun amɨn kɨsɨk kɨsɨk tagɨ ani.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ji pi aŋek uŋun dakon bamɨ paŋ noni.","poem":1},{"text":"Ji kɨsɨk kɨsɨk aŋek tagɨsi egɨpdaŋ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mɨŋatgo da yutgokon wain nap da yaŋ bamɨ madepsi toni.","poem":1},{"text":"Ae mɨŋat monjɨyogo da olip kɨndap monɨŋ yombem da yutgokon tamokon aŋgwasɨŋek yɨtni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Asi, Yawe do pasalek ekwaŋ amɨn kɨsɨk kɨsɨk tagɨ ani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yawe Saion kokup papmon egɨsak uŋun da gɨsam tagɨ damjak.","poem":1},{"text":"Ji mɨktɨmon egɨpni bɨsap morapmon Jerusalem kaŋakwa tagɨsi tosak dosi nandɨsat.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ji bɨsap dubagɨsi egek babɨkji pɨndatni do nandɨsat.","poem":1},{"text":"Israel amɨn yaworɨ tagɨ egɨpni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}