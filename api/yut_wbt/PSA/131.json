{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":131,"content":[{"type":"heading","content":["Amɨn kɨnda iyɨ do nandaban pɨŋakwan bɨsit agɨt"]},{"type":"hebrew_subtitle","content":["Dewit dakon kap kɨnda. Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Yawe, nak naga do nandako dɨma wɨgɨsak.","poem":1},{"text":"Mano dɨma awɨgɨsat.","poem":2},{"lineBreak":true},{"text":"Nak yo kɨnda ni da wɨkwisi asak ae yo uŋun dakon mibɨlɨ arɨpmɨ dɨma nandako pɨsosak uŋun do nandaba kɨk dɨma asat.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nak butno tagɨsi tosak do pi at da butno yaworɨ tosok.","poem":1},{"text":"Nak egɨsat uŋun monjɨ ŋakŋak da yaŋ meŋi da kɨsiron nandaba kɨgɨ mɨni pagegɨsak nak uŋun yombem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israel amɨn, ji abɨsok ae bɨsap morap don kɨsi Yawe da paŋpulugosak do nandaŋ teban taŋek jomjom ani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}