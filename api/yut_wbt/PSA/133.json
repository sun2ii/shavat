{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":133,"content":[{"type":"heading","content":["Not do but dasi galak taŋ yomyom aŋpak do tagɨsi nandawit"]},{"type":"hebrew_subtitle","content":["Dewit dakon kap kɨnda. Piŋkop gawak ɨmɨm tamokon kɨgɨk dakon kap."]},{"type":"verse","number":1,"content":[{"text":"Piŋkop dakon mɨŋat amɨnyo but kaloŋ aŋek egɨpni kaŋ uŋun tagɨsi, ae burɨ tagɨsi akdaŋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uŋun aŋpak uŋun wagɨl tagɨsisi. Uŋun olip dakon nelagɨ yombem.","poem":1},{"text":"Olip dakon nelagɨ Aron do tagal ɨmɨŋakwa mogɨm daŋgwanikon pɨgek ɨmal dubakni da dɨwarɨkon pɨgɨgɨt.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"But kaloŋ aŋpak uŋun kalbi gɨk sɨtnaŋ Emon Kabap ae Saion Kabapmon moŋ uŋun yombem tagɨsi.","poem":1},{"text":"Yawe da but kaloŋ ekwaŋ amɨn gɨsamni yomɨsak.","poem":2},{"lineBreak":true},{"text":"Egɨp egɨp dagok dagogɨ mɨni uŋun yomɨsak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}