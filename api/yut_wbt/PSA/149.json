{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":149,"content":[{"type":"heading","content":["Yawe aŋkɨsik dakon kap"]},{"type":"verse","number":1,"content":[{"text":"Yawe aŋkɨsini! Kap kalugɨ yaŋ ɨmni.","poem":1},{"text":"Piŋkop yol kɨmokgoŋ mɨŋat amɨn kabɨni ji muwugek aŋkɨsini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israel amɨn ji Piŋkop da wasagɨt, do but galak nandaŋ ɨmni.","poem":1},{"text":"Saion kokup pap amɨn ji Kɨla Amɨn Madepji do kɨsɨk kɨsɨk ani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kap aŋek mani yaŋ aŋkɨsini.","poem":1},{"text":"Tambarin gat ae gita gat tɨdaŋek mani aŋkɨsini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yawe da mɨŋat amɨn kabɨni do galak taŋ yomɨsak.","poem":1},{"text":"Aŋek amɨn iyɨ do nandaba pɨŋbi aŋ uŋun yokwikon baŋ tɨmɨkdak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yaŋ asak, do mɨŋat amɨn kabɨni but dasi yolgaŋ uŋun kɨsɨk kɨsɨk ani dosi nandɨsat.","poem":1},{"text":"Dɨpmɨn potpot tamokon kɨsɨk kɨsɨk kap yoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Piŋkop yaŋ aŋkɨsiŋek emat agak sɨba geni tepmɨsi baŋ tɨmɨgek","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amɨn Ŋwakŋwarɨ Kabɨ gat emat wamaŋek yo yokwisi aŋ yomɨŋek pabɨŋ yopni dosi nandɨsat.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aŋek ain nap baŋ kɨla amɨn madepni gat ae kɨla amɨni gat dakon kandap paŋteban ani.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aŋakwa Piŋkop da yagɨt uŋun da arɨpmon kobogɨ yokwisi tɨmɨtni.","poem":1},{"text":"Aŋakwa amɨn kabɨni iyɨ yol kɨmokgoŋ uŋun dakon man madep tokdɨsak.","poem":2},{"lineBreak":true},{"text":"Yawe aŋkɨsini!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}