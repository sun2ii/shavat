{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":15,"content":[{"type":"heading","content":["Aŋpak Piŋkop da nin da aneŋ do nandɨsak"]},{"type":"hebrew_subtitle","content":["Dewit dakon kap kɨnda."]},{"type":"verse","number":1,"content":[{"text":"Yawe, namɨn da gak da telagɨ yutgwan tagɨ wɨgɨsak?","poem":1},{"text":"Telagɨ kabapgokon namɨn da tagɨ egɨpjak?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amɨn kɨnda suŋ kɨnda aban amɨn da yaŋba yokwi tok dɨma aŋ ɨmgwit,","poem":1},{"text":"ae aŋpakni kɨlegɨsi,","poem":2},{"lineBreak":true},{"text":"ae burɨkon da nandaŋek gen bamɨ gɨn yosok,","poem":2},{"lineBreak":true},{"text":"uŋun amɨn da tagɨ egɨpjak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amɨn do yaŋba yokwi tok dɨma asak,","poem":1},{"text":"ae notni do aŋpak yokwi dɨma aŋyomɨsak,","poem":2},{"lineBreak":true},{"text":"ae notni do top dɨma yaŋ yomɨsak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yokwi pakpak amɨn do dɨma galak taŋek Yawe do pasolgoŋ amɨn do nandaban wukwan yomɨsak.","poem":1},{"text":"Yaŋ teban tok asak uŋun jɨgɨ noman taŋ ɨmaŋ bɨsapmon dɨma kɨrɨŋɨgek geni guramɨk kɨmokdok.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amɨn da goman aŋ ɨba dɨ gat saŋbeŋek ɨmni do dɨma yosok.","poem":1},{"text":"Ae amɨn da topni paŋteban aŋek si yumaŋ naŋakwa amɨn kɨlegɨ gen pikon yop do aba geni dɨma nandaŋ yomɨsak.","poem":2},{"lineBreak":true},{"text":"Uŋun aŋpak kɨlegɨ morap yolgaŋ amɨn uŋun dagok dagogɨ mɨni arɨpmɨ dɨma mokdaŋ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}