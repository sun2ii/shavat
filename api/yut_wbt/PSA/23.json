{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":23,"content":[{"type":"heading","content":["Yawe uŋun kɨla amɨno tagɨsi"]},{"type":"hebrew_subtitle","content":["Dewit dakon kap kɨnda."]},{"type":"verse","number":1,"content":[{"text":"Yawe uŋun kɨla amɨno, do yo kɨnda do wadak wadak dɨma asat.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aŋkɨ joŋ kalɨkalɨgɨ tɨmon nepban pak yawokdot.","poem":1},{"text":"Aŋek pakbi monɨŋ monɨŋ yaworɨ pokgoŋ uŋudon gɨn nayɨŋ awɨldak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tapmɨm kalugɨ namɨŋek man bini tagɨsi tosak do kosit kɨlegɨkon nayɨŋ awɨldak.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Piŋkop, gak nak gat egɨsal, do gɨlo ae pɨlɨn tukyogwan agɨpbeŋ kaŋ, yo yokwi do dɨma pasolgeŋ.","poem":1},{"text":"Gandako sipsip kɨla amɨn dakon kɨndap kɨrɨŋ abɨdosol, do uŋun da butno aŋteban asak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Japno tagɨsi uwalno da dabɨlon nomansi paŋnoman asal.","poem":1},{"text":"Yutgokon but galagon da abɨdaŋek bɨt nelak busuŋnokon tagaldal.","poem":2},{"lineBreak":true},{"text":"Yo galagɨ ɨreŋɨsi ɨdawukbɨ ɨdapno si tugosok.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mɨktɨmon egɨpbeŋ bɨsap morapmon kɨlano tagɨsi aŋek but dasi galak taŋ namɨŋ wɨgɨkdɨsal.","poem":1},{"text":"Ae bɨsap mudok mudogɨ mɨni yutgokon egɨ wɨgɨkeŋ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}