{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":3,"content":[{"type":"heading","content":["Amɨn kɨnda da wɨsa dagokdo tapmɨm pak do bɨsit agɨt"]},{"type":"hebrew_subtitle","content":["Dewit monji Apsalom do pasalek kɨgɨt bɨsapmon kap on mandagɨt."]},{"type":"verse","number":1,"content":[{"text":"Yawe, uwalno morapmɨsi! Amɨn morapmɨ da yokwisi aŋ namaŋ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uŋun da yaŋ yoŋ, “Piŋkop da arɨpmɨ dɨma aŋpulugokdɨsak.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mani Yawe gak pasɨk da yaŋ nak aŋkɨsɨbɨsal.","poem":1},{"text":"Aŋpulugaŋbɨ emaron teban tosot.","poem":2},{"lineBreak":true},{"text":"Gak kaloŋ dagɨn but yokwino wɨrɨrɨkbɨ pasɨlakwa aŋteban abɨ tebai akdat.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yawe da aŋpulugosak do yaŋ tɨdosot.","poem":1},{"text":"Uŋun telagɨ kabapnikon egek yaŋ ɨlɨtno dakon kobogɨ namɨsak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dɨpmɨn potpot tamokon pagek obɨsi pak ɨŋtosot.","poem":1},{"text":"Ae don pɨdaŋek tagɨsi egɨsat, nido Yawe da kɨlano tagɨsi asak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uwalno 10 tausen da terɨ terɨ da abɨŋ aŋdagat ayɨŋ,","poem":1},{"text":"mani uŋun do dɨma pasolgeŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yawe gak apbi! Piŋkopno abɨŋ aŋpulugoki!","poem":1},{"text":"Uwalno mogɨm kulbak dapbi.","poem":2},{"lineBreak":true},{"text":"Amɨn yokwi uŋun dakon geni dapmaŋ bɨrɨpmɨkgi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yawe gak dagɨn nin paŋpulugaŋbɨ teban tomaŋ.","poem":1},{"text":"Mɨŋat amɨn kabɨgo nin yo tagɨsi aŋ nibi dosi nandɨsat.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}