{"translation":{"id":"yut_wbt","name":"PIŊKOP GEN","website":"https://ebible.org/Scriptures/details.php?id=yut","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yut","licenseNotes":null,"shortName":"WBT","englishName":"Yopno NT & Psalms","language":"yut","textDirection":"ltr","sha256":"e31a8a78a9beb608e144f962d28459598f306441c8f7734d5a2d0f29b642e6b4","availableFormats":["json"],"listOfBooksApiLink":"/api/yut_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10297,"languageName":"Yopno","languageEnglishName":"Yopno"},"book":{"id":"PSA","translationId":"yut_wbt","name":"Kap","commonName":"Kap","title":"KAP","order":19,"numberOfChapters":150,"sha256":"6ef34f6223a1f10cb3ffb32faa482047a6de5fa62b54a30ba1eae4c202a1e85a","firstChapterNumber":1,"firstChapterApiLink":"/api/yut_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yut_wbt/PSA/150.json","totalNumberOfVerses":2444},"chapter":{"number":82,"content":[{"type":"heading","content":["Piŋkop uŋun kɨla amɨn madep mibɨltogɨ"]},{"type":"hebrew_subtitle","content":["Asap dakon kap kɨnda."]},{"type":"verse","number":1,"content":[{"text":"Piŋkop uŋun Kwen Kokup muwut muwut madep dakon mibɨltok amɨn yɨkdak.","poem":1},{"text":"Mɨktɨm morap dakon kɨla amɨn da muwugakwa nandak nandakni kokwinɨkdak.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aŋek yaŋ yoyɨsak,","poem":1},{"text":"“Ji bɨsap niaŋ da gen kokwin pi gulusuŋ ani?","poem":2},{"lineBreak":true},{"text":"Ji yokwi pakpak amɨn nido paŋpulugoŋ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ji yoni mɨni amɨn ae monjɨ datni kɨmakbi paŋpulugoni.","poem":1},{"text":"Aŋek jɨgɨ paŋek yokwi ekwaŋ amɨn uŋun paŋkutnoni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amɨn yokwi ekwaŋ ae yo do wadaŋ amɨn uŋun yokwi pakpak da kɨsiron baŋ pulugaŋ tɨmɨgek paŋpulugoni.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ji pɨlɨn tukgwan agek nandak nandakji mɨnisi, do mɨktɨmɨ mɨktɨmɨ amɨn aŋpak kɨlegɨ dɨma aŋ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nak gen yaŋ yosot, ‘Ji piŋkop ekwaŋ.","poem":1},{"text":"Ji Piŋkop Wukwi Madep dakon monjini ekwaŋ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mani amɨn morap kɨmokgoŋ jiyo yaŋ gɨn kɨmotdaŋ.","poem":1},{"text":"Kɨla amɨn morap kɨmokgoŋ jiyo yaŋ gɨn kɨmotdaŋ.’ ”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Piŋkop, mɨŋat amɨn morapyo uŋun gak dakon gɨn, do abɨŋ mɨktɨm amɨn morap gen kokwin aŋyobi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/yut_wbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yut_wbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yut_wbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}