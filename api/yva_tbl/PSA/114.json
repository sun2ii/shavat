{"translation":{"id":"yva_tbl","name":"Yawa","website":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseNotes":null,"shortName":"TBL","englishName":"Yawa NT+","language":"yva","textDirection":"ltr","sha256":"1d06cbb06e92611bb2544da563d436b8ebe39d1f96571b3c73a3699cb6a21475","availableFormats":["json"],"listOfBooksApiLink":"/api/yva_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Yawa","languageEnglishName":"Yawa"},"book":{"id":"PSA","translationId":"yva_tbl","name":"MASMUR","commonName":"MASMUR","title":"MASMUR","order":19,"numberOfChapters":150,"sha256":"79fbc0fd3e6147b39004f56dee5de0020d3c9fb6e04458be54f9589fd0a100ff","firstChapterNumber":1,"firstChapterApiLink":"/api/yva_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yva_tbl/PSA/150.json","totalNumberOfVerses":2518},"chapter":{"number":114,"content":[{"type":"heading","content":["Amisy Po anainame raroron"]},{"type":"verse","number":1,"content":[{"text":"Arono kawasae Israel wuje no munijo Mesir,","poem":1},{"text":"arono Yakop apa ajavi wo munijo maran rapaya ntami,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kopa Yehuda Amisy Po varoro we ratayao terave indamu ndandinit Wepi tuna rai,","poem":1},{"text":"munijo Israel ratayao terave indamu Wepi be akari titive rai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mayano Kolsum","poem":1},{"noteId":348},{"text":"mo Amisy aen weti mansop,","poem":1},{"text":"mana akoe Yordan njame nto kakai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unate mainy nsasopati maisyare kambine we,","poem":1},{"text":"papukame mpapiraki maisyare domba tuvan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inya, mayano Kolsum, animaisye mi mbeti winyansop,","poem":1},{"text":"muno mana akoe Yordan njame nto kakai?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inya, unate mainy, veanimaibe weasasopati maisyare kambine we,","poem":1},{"text":"muno inya, papukame weap, wapapiraki maisyare domba tuvano we?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inya, munije tenam, ntutar no Akoe Amun,","poem":1},{"text":"nai Amisy Yakop beaje Ai Amun.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wepi Po unato oram ranigwan weti mbe mana warove,","poem":1},{"text":"muno oramo mantantuman ranigwan mbe mana wun.","poem":2},{"noteId":349}]}],"footnotes":[{"noteId":348,"caller":"+","text":"Mayano Kolsum ama tamo kaijinta mamo: ‘‘Mayano Nijam,’’ ‘‘Gelaga’’ muno ‘‘Teberau.’’ Raen tavon no Kel. 14:21; Arakov. 7:36; 1Kor. 10:1; Maz. 136:13.","reference":{"chapter":114,"verse":3}},{"noteId":349,"caller":"+","text":"Kel. 17:1-7; Bil. 20:1-13","reference":{"chapter":114,"verse":8}}]},"thisChapterLink":"/api/yva_tbl/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yva_tbl/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yva_tbl/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}