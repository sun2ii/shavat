{"translation":{"id":"yva_tbl","name":"Yawa","website":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseNotes":null,"shortName":"TBL","englishName":"Yawa NT+","language":"yva","textDirection":"ltr","sha256":"1d06cbb06e92611bb2544da563d436b8ebe39d1f96571b3c73a3699cb6a21475","availableFormats":["json"],"listOfBooksApiLink":"/api/yva_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Yawa","languageEnglishName":"Yawa"},"book":{"id":"PSA","translationId":"yva_tbl","name":"MASMUR","commonName":"MASMUR","title":"MASMUR","order":19,"numberOfChapters":150,"sha256":"79fbc0fd3e6147b39004f56dee5de0020d3c9fb6e04458be54f9589fd0a100ff","firstChapterNumber":1,"firstChapterApiLink":"/api/yva_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yva_tbl/PSA/150.json","totalNumberOfVerses":2518},"chapter":{"number":121,"content":[{"type":"heading","content":["AMISY Opirati Po wansayaranande tutir"]},{"type":"verse","number":1,"content":["Ransyerano vatano Israel ukiny dai arono wanya usea no Yavar Amisy no Yerusalem.",{"lineBreak":true},{"text":"Syo unate so ranyanyube anyi,","poem":1},{"text":"indati arepi de po rinasopan?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"De ti po rinasopane pamo AMISY,","poem":1},{"text":"Opirati Po naume muno mine so ranari tenambe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Opamo aneme mpaya nai jewen, ti nto ntemaje ramu,","poem":1},{"text":"Opamo ami maomombe ramu ti Po nayaranande tutir.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tugae, Amisy Po vatano Israel mansayaranande Opamo,","poem":1},{"text":"ami maomono intai jewen muno niki intai jewen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"AMISY Opirati Po nayaranande tutir,","poem":1},{"text":"AMISY Opirati tuna nautan","poem":2},{"noteId":362},{"text":"indamu darino naora.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Weti indati uma apa mamoano masyote yasyine mo nanene jewen,","poem":1},{"text":"muno embae ama vare mo anakotaro ngkakai raugavo nai jewen.","poem":2},{"noteId":363}]},{"type":"verse","number":7,"content":[{"text":"Indati AMISY Po nayaranande ti anakotaro ngkakai inta nande nai jewen,","poem":1},{"text":"muno Po nya njayaisye so rayaranande tutir.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"AMISY Po nayaranande tutir arono winto no rui rui vayave,","poem":1},{"text":"nai unumeso ntoa nuge nuganui.","poem":2}]}],"footnotes":[{"noteId":362,"caller":"+","text":"tuna nautan: Ayao Ibrani maisyare so: ‘‘tet no nanem ngkov,’’ omamo mbe rarorombe Opamo tuna nautan.","reference":{"chapter":121,"verse":5}},{"noteId":363,"caller":"+","text":"Embae mamo arono wusyinoe vatane inta wanave ware mo wanene raugavo vatane mai.","reference":{"chapter":121,"verse":6}}]},"thisChapterLink":"/api/yva_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yva_tbl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yva_tbl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}