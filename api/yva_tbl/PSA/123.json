{"translation":{"id":"yva_tbl","name":"Yawa","website":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseNotes":null,"shortName":"TBL","englishName":"Yawa NT+","language":"yva","textDirection":"ltr","sha256":"1d06cbb06e92611bb2544da563d436b8ebe39d1f96571b3c73a3699cb6a21475","availableFormats":["json"],"listOfBooksApiLink":"/api/yva_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Yawa","languageEnglishName":"Yawa"},"book":{"id":"PSA","translationId":"yva_tbl","name":"MASMUR","commonName":"MASMUR","title":"MASMUR","order":19,"numberOfChapters":150,"sha256":"79fbc0fd3e6147b39004f56dee5de0020d3c9fb6e04458be54f9589fd0a100ff","firstChapterNumber":1,"firstChapterApiLink":"/api/yva_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yva_tbl/PSA/150.json","totalNumberOfVerses":2518},"chapter":{"number":123,"content":[{"type":"heading","content":["AMISY anajo indamu aemeno wansai"]},{"type":"verse","number":1,"content":["Ransyerano Israel ukiny dai arono wanya usea no Yavaro Amisy no Yerusalem.",{"lineBreak":true},{"text":"Sya Amisy, Winyirati Akari Titi ntuna no munijo Manunggara,","poem":1},{"text":"Winyirati inamumbe ore Nai, syare syo nanajo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"AMISY, reama Amisy, reamo winanyut ava naemeno reansai!","poem":1},{"text":"Reansanaveano winamen, maisyare anya inta anaveano apa akari panapatambe ai amene wemaisy,","poem":2},{"lineBreak":true},{"text":"muno maisyare wanya ranaveano ama akoeyo manapatambe raije ramene wemaisy.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Naemeno reansai! AMISY, reamare naemeno reansai,","poem":1},{"text":"weye vatane wo reansaura tantunawi tutira ndea naiso rave to.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vatano utantuna ananuge vone rai wo reansakaajiana nugoenta rave to,","poem":1},{"text":"muno vatano umararine wo reansaura tantunawi tavon.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yva_tbl/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yva_tbl/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yva_tbl/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}