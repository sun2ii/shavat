{"translation":{"id":"yva_tbl","name":"Yawa","website":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseNotes":null,"shortName":"TBL","englishName":"Yawa NT+","language":"yva","textDirection":"ltr","sha256":"1d06cbb06e92611bb2544da563d436b8ebe39d1f96571b3c73a3699cb6a21475","availableFormats":["json"],"listOfBooksApiLink":"/api/yva_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Yawa","languageEnglishName":"Yawa"},"book":{"id":"PSA","translationId":"yva_tbl","name":"MASMUR","commonName":"MASMUR","title":"MASMUR","order":19,"numberOfChapters":150,"sha256":"79fbc0fd3e6147b39004f56dee5de0020d3c9fb6e04458be54f9589fd0a100ff","firstChapterNumber":1,"firstChapterApiLink":"/api/yva_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yva_tbl/PSA/150.json","totalNumberOfVerses":2518},"chapter":{"number":13,"content":[{"type":"heading","content":["Vatano matawanto awa ana udanajo AMISY Ai"]},{"type":"verse","number":1,"content":["Masmur Daud po ratoe. Nto irati akari po vatano matayao ukiny maugavo ransyerane rai ai."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Abo! Sya AMISY, ntoa nugoenta to winanimari rinai tutir bayave kobea e?","poem":1},{"text":"Ntoa nugoenta to winakirive rinaija e?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ntoa nugoenta to inanuga mamaun,","poem":1},{"text":"muno rinanuga ranimaumbe masyote yanteter.","poem":2},{"lineBreak":true},{"text":"Ntoa nugoenta to sya marova wo inatawanto tutir kobea e?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"AMISY, sya Amisy, syare namumbe de rinai, Nyo sya ana danajo ravera mamaisy.","poem":1},{"text":"Nyo vambunine raugakare rinai, muno vemo Nyo rinapayamo kakai nora.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vemo sya marova wo raura ware wo rinapinde to inya.","poem":1},{"text":"Muno vemo umararin ware wo rinangkuku to inya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Weramu risyamo syanave irati Nya muinyo no tawano rinai rai,","poem":1},{"text":"rinananibe weye Nyo rinapaya sya marova aneme rai to.","poem":2},{"text":"Syare rikinyo ransyerane raijo AMISY Nai,","poem":1},{"text":"weye Winyamo mbekobe irati rinai to.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yva_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yva_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yva_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}