syare so: ‘‘arikainyo po akoeya ama ukame rapaya to pa.’’","reference":{"chapter":131,"verse":2}}]},"thisChapterLink":"/api/yva_tbl/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yva_tbl/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yva_tbl/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}