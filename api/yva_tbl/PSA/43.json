{"translation":{"id":"yva_tbl","name":"Yawa","website":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseNotes":null,"shortName":"TBL","englishName":"Yawa NT+","language":"yva","textDirection":"ltr","sha256":"1d06cbb06e92611bb2544da563d436b8ebe39d1f96571b3c73a3699cb6a21475","availableFormats":["json"],"listOfBooksApiLink":"/api/yva_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Yawa","languageEnglishName":"Yawa"},"book":{"id":"PSA","translationId":"yva_tbl","name":"MASMUR","commonName":"MASMUR","title":"MASMUR","order":19,"numberOfChapters":150,"sha256":"79fbc0fd3e6147b39004f56dee5de0020d3c9fb6e04458be54f9589fd0a100ff","firstChapterNumber":1,"firstChapterApiLink":"/api/yva_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yva_tbl/PSA/150.json","totalNumberOfVerses":2518},"chapter":{"number":43,"content":[{"type":"heading","content":["Israel awa ana udanajo Amisye Ai arono una no munijo aroo43:0 Masmur 43 mamo arono wusyinoeamo mbe intabove Masmur 42 rai."]},{"type":"verse","number":1,"content":[{"text":"Sya Amisy, syare Nyo patimugo moyare raugaje irati rinai,","poem":1},{"text":"syare Nyo marimbe rinai no susyo umarovave Winai so mai.","poem":2},{"lineBreak":true},{"text":"Syare Nyo inapaya irati vatano aarurijate muno mamune maneme rai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Weye Amisy Winyirati rinino naowan.","poem":1},{"text":"Mbeanimaibe irati winaneme mpaya rinai?","poem":2},{"text":"Mbeanimaibe sya marova wo rinatawanto,","poem":1},{"text":"weti rinanimaumbe tutir?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Syare Nyo Nya vare muno Nya ayao tugae raude rinai,","poem":1},{"text":"indamu mo inajum, muno mo inaugav syakaore no Nya Yavaro ntuna ri,","poem":2},{"lineBreak":true},{"text":"no Sion unato ndandinit.","poem":2},{"noteId":93}]},{"type":"verse","number":4,"content":[{"text":"Wea indati syore no Amisy Nya tewa orame rai,","poem":1},{"text":"syore te no Amisye Winamun, Winyirati sya inananibe muno inanayanambe no rave Nai.","poem":2},{"text":"Indati rikiny kangkamambe Winai, syo itari mamaune raeyan dai.","poem":1},{"text":"Amisy, Winyirati sya Amisy!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mbe animaibe inanuga so mamaun?","poem":1},{"text":"Mbe animaibe rinanimaumbe no inanuga so rai?","poem":2},{"text":"Koveamo inanaveano Amisye obo amen,","poem":1},{"text":"weye Opirati sya Amisy, Po inapaya irati kakai rai,","poem":2},{"lineBreak":true},{"text":"weti indati syo kove raura seo Ai jakato.","poem":2}]}],"footnotes":[{"noteId":93,"caller":"+","text":"unato ndandinit: unate so ndandinit weye omamo unato terave AMISY tuna rai.","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/yva_tbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yva_tbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yva_tbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}