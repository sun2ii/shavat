{"translation":{"id":"yva_tbl","name":"Yawa","website":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=yvaNT","licenseNotes":null,"shortName":"TBL","englishName":"Yawa NT+","language":"yva","textDirection":"ltr","sha256":"1d06cbb06e92611bb2544da563d436b8ebe39d1f96571b3c73a3699cb6a21475","availableFormats":["json"],"listOfBooksApiLink":"/api/yva_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Yawa","languageEnglishName":"Yawa"},"book":{"id":"PSA","translationId":"yva_tbl","name":"MASMUR","commonName":"MASMUR","title":"MASMUR","order":19,"numberOfChapters":150,"sha256":"79fbc0fd3e6147b39004f56dee5de0020d3c9fb6e04458be54f9589fd0a100ff","firstChapterNumber":1,"firstChapterApiLink":"/api/yva_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/yva_tbl/PSA/150.json","totalNumberOfVerses":2518},"chapter":{"number":93,"content":[{"type":"heading","content":["AMISY Opi Akarijo Titi no tawan"]},{"type":"verse","number":1,"content":[{"text":"AMISY Wepirati Akarijo Titi!","poem":1},{"text":"Apa kovo ntiti maisyare ansun akoe Po rave,","poem":2},{"lineBreak":true},{"text":"Apa vambunine maisyare tarandino Po rave ansune rauvat.","poem":2},{"text":"Tugae, mine so ntet tindimuve tawan,","poem":1},{"text":"mangkiki jewen weye Amisye taune Po rantet.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"AMISY, wimbambunin ntuna tawano","poem":1},{"text":"Nya mbe akarive rai kobe arono wusyinoe,","poem":2},{"lineBreak":true},{"text":"nai nugo pitawar Winyamo no tawan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abo AMISY, mana njam merere nseo,","poem":1},{"text":"mana njam ama kine merere nseo,","poem":2},{"lineBreak":true},{"text":"mana njam ama kino mpusyek merere nseo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tugae, mana njam manakoe ama kine merere nseo,","poem":1},{"text":"nde no rareno aneae mpanyoan,","poem":2},{"lineBreak":true},{"text":"weramu AMISY no no munijo ntiti bambunin dakivan bintabo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"AMISY, Nya ananyao ntindimu no tawan.","poem":1},{"text":"Nya yavare ndandinita nuge nuganui.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/yva_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/yva_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/yva_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}