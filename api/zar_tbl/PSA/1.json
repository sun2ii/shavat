{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Bicaʼ ba bönniʼ bitiʼ runëʼ ca naca le taʼgúʼu yöl-laʼ lëʼ nupa tuʼcáʼana Dios,","poem":1},{"lineBreak":true},{"text":"en bitiʼ ridálenëʼ tsözxö́n nupa tun dul-laʼ,","poem":1},{"lineBreak":true},{"text":"en bitiʼ runëʼ tsözxö́n le tun nupa taʼzíʼ quidzaʼ Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le raza ládxëʼë nácagaca xibá naguixjëʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"en ca nácagaca xibá naʼ rëla, en te dza rulaba ládxëʼë.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bönniʼ ni náquiëʼ ca tu yaga dxeʼ ga naca raʼ nisa,","poem":1},{"lineBreak":true},{"text":"le ribía sizxöni cateʼ ridxín dza que,","poem":1},{"lineBreak":true},{"text":"en bitiʼ caʼ rizóa gubáʼayisö.","poem":1},{"lineBreak":true},{"text":"Yúguʼtë le runëʼ taʼrúaj dxiʼa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bitiʼ raca caní quégaca nupa tuáʼ döʼ.","poem":1},{"lineBreak":true},{"text":"Nácagaca ca bëbu zxe café ruáʼ le böʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Que lë ni naʼ bitiʼ uluʼrúajëʼ tsahuiʼ bönniʼ tuʼë döʼ cateʼ Dios uchiʼa usörö́ëʼ quégaquiëʼ,","poem":1},{"lineBreak":true},{"text":"en bitiʼ ilaʼcuʼë bönniʼ dul-laʼ ga tuʼdubëʼ bönniʼ tsahuiʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rapa chiʼë Xanruʼ Dios nöza ga taʼdë́ʼ bönniʼ tsahuiʼ naʼ,","poem":1},{"lineBreak":true},{"text":"pero uniti tsaz nu ridá gapa taʼdá nupa tuáʼ döʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":6}