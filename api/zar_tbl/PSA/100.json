{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"¡Lu yöl-laʼ rudzeja queë́liʼ guliʼgul-la queëʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"libíʼiliʼ zóaliʼ idútë yödzölió!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Lu yöl-laʼ rudzeja queë́liʼ guliʼcuʼë yöl-laʼ ba Xanruʼ!","poem":1},{"lineBreak":true},{"text":"¡Guliʼdá lahuëʼ Lëʼ, en lu yöl-laʼ rudzeja queë́liʼ guliʼgul-la queëʼ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Guliʼtsöjné Xanruʼ, náquiëʼ Dios!","poem":1},{"lineBreak":true},{"text":"Buzáʼ cazëʼ rëʼu, en calëga rácasö queë́ruʼ zóaruʼ.","poem":1},{"lineBreak":true},{"text":"Nácaruʼ bönachi queëʼ, en nácaruʼ ca böʼcuʼ zxilaʼ queëʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guliʼtsaza zacaʼ raʼ yuʼu queëʼ, guië́liʼ-nëʼ: “Xclenuʼ.”","poem":1},{"lineBreak":true},{"text":"Guliʼtsaza gapa naca löʼa queëʼ, cúʼuliʼ-nëʼ yöl-laʼ ba.","poem":1},{"lineBreak":true},{"text":"Guliʼguíëʼ: “Xclenuʼ”, en guliʼgunëʼ zxön.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Náquiëʼ dxiʼa tsahuiʼ Xanruʼ Dios, ateʼ zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ!","poem":1},{"lineBreak":true},{"text":"¡Zóaticaʼsö yöl-laʼ run ca rnna xtídzëʼë queëʼ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}