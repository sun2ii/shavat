{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":101,"content":[{"type":"verse","number":1,"content":[{"text":"¡Gul-laʼ ca runuʼ ca rnna xtídzuʼu, en ca nacuʼ tsahuiʼ!","poem":1},{"lineBreak":true},{"text":"¡Gul-laʼ yöl-laʼ ba quiuʼ Liʼ, Xan!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Güíʼi ládxaʼa gunaʼ le naca idú dxiʼa.","poem":1},{"lineBreak":true},{"text":"¿Bátaxi huécjuʼ quiaʼ nedaʼ?","poem":1},{"lineBreak":true},{"text":"Lu yuʼu lidxaʼ gunaʼ le naca idú ladxiʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bitiʼ guʼa lataj sóalen nedaʼ nitú le naca xihuiʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ riléʼedaʼ dxiʼa le tun nupa tuʼcáʼana Liʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ gunaʼ léguequi tsözxö́n.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bitiʼ caʼ gacaʼ chopa ladxiʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ gunaʼ le naca döʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Usunítiaʼ dërö nu bönniʼ rinnë́ʼ que luzë́ʼë balándoʼos.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ guáʼ ilenaʼ nu run ba zxön cuini.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uyúaʼ dxiʼa tsáhuiʼdoʼ nupa tun ca rnna xtídzaʼguequi luyú ni, para ilaʼcuáʼlen nedaʼ.","poem":1},{"lineBreak":true},{"text":"Nu bitiʼ bi xiguiaʼ nabagaʼ huáca gun xichinaʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bitiʼ caʼ tsöjsóa lidxaʼ nu rizíʼ yëʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ guʼa lataj ugáʼana lahuaʼ nu ruíʼi didzaʼ le cabí naca.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yuguʼ zila usunítiaʼ yúguʼtë nupa tuáʼ döʼ luyú ni,","poem":1},{"lineBreak":true},{"text":"para ucuitaʼ lu yödzö queëʼ Xanruʼ yúguʼtë nupa tuti bönachi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}