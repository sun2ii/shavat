{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Ruzxöni ládxaʼa Xanruʼ gácalenëʼ nedaʼ.","poem":1},{"lineBreak":true},{"text":"¿Naruʼ guíëtsoʼ nedaʼ:","poem":1},{"lineBreak":true},{"text":"“Buzxúnnaj lu guíʼa ca runbaʼ biguínnidoʼ”?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buyútsöcaʼ, zö́ngaca nupa tuáʼ döʼ yaga uxitiʼ.","poem":1},{"lineBreak":true},{"text":"Nuzóagaca yágadoʼ lahui tuchiʼ lu du rusé,","poem":1},{"lineBreak":true},{"text":"para ilútiëʼ bagáchiʼsö nupa nácagaca dxiʼa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Channö ilaʼguínnaj yuguʼ le tuʼzóa tsutsu le naca dxiʼa,","poem":1},{"lineBreak":true},{"text":"¿bizxi caz gaca gun nu naca tsahuiʼ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Zoa cazëʼ Xanruʼ yudoʼ láʼayi queëʼ!","poem":1},{"lineBreak":true},{"text":"Yehuaʼ yubá zoa ga röʼë rinná bëʼë Xanruʼ Dios.","poem":1},{"lineBreak":true},{"text":"Riléʼe guiö́j lahuëʼ para uyúëʼ le tun bönachi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rizíʼ bëʼë Xanruʼ nu naca tsahuiʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ riléʼenëʼ dxiʼa nu ruáʼ döʼ, en nu raza ladxiʼ taʼdáʼbagaʼ yúlahuiʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gunëʼ ga sácaʼgaca nupa tuáʼ döʼ le usuniti léguequi.","poem":1},{"lineBreak":true},{"text":"Ubiʼë quéguequi guíʼ, en le ruquélaʼ guíʼ, en tu böʼ régui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Caní gunëʼ Xanruʼ tuʼ náquiëʼ tsahuiʼ, en nadxíʼinëʼ le naca tsahuiʼ.","poem":1},{"lineBreak":true},{"text":"Nupa tun le nácatë ilaʼléʼe lahuëʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}