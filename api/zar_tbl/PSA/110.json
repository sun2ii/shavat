{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"Xanruʼ Dios gudxëʼ Xanaʼ: “Guröʼi cuita lëʼa ibëla","poem":1},{"lineBreak":true},{"text":"cateʼ gunraʼ ga uluʼzechu zxíbigaca loʼ","poem":1},{"lineBreak":true},{"text":"nupa bitiʼ taʼléʼe Liʼ dxiʼa.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ga zoëʼ yödzö Sión gusö́l-lëʼë Xanruʼ yöl-laʼ unná bëʼ quiuʼ,","poem":1},{"lineBreak":true},{"text":"gunnë́ʼ: “Gunná beʼe nupa bitiʼ taʼléʼe Liʼ dxiʼa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Uluʼdödi cuínguequi lu noʼo bönachi quiuʼ","poem":1},{"lineBreak":true},{"text":"cateʼ siʼu yöl-laʼ unná bëʼ quiuʼ","poem":1},{"lineBreak":true},{"text":"tuʼ napuʼ yöl-laʼ lachi que le naca láʼayi.”","poem":1},{"lineBreak":true},{"text":"Ilaʼcuáʼ biʼi bönniʼ ga zuʼ ca ribö́ʼö buzén zíladoʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Runëʼ tsutsu xtídzëʼë Xanruʼ, en bitiʼ utsë́ʼë le, rnnëʼ:","poem":1},{"lineBreak":true},{"text":"“Tsaz nacuʼ bixúz ca naʼ gúquiëʼ Melquisedec bixúz.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zoa cazëʼ Xanruʼ cuita lëʼu ibëla.","poem":1},{"lineBreak":true},{"text":"Ucul-lëʼ bönniʼ taʼnná bëʼë cateʼ idxín dza usiúdxëʼ luyú.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uchiʼa usörö́ëʼ quégaca bönachi yúguʼtë yödzö izáʼa,","poem":1},{"lineBreak":true},{"text":"ateʼ ilí yödzölió len bëlaʼ rön quéguequi.","poem":1},{"lineBreak":true},{"text":"Uzötjëʼ nupa taʼnná bëʼ zián lu yödzö izáʼa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Guíʼjëʼ nisa beaj raʼ nöza,","poem":1},{"lineBreak":true},{"text":"en niʼa que lë ni huöáca ládxëʼë.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}