{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"¡Guliʼcuʼë yöl-laʼ ba Xanruʼ!","poem":1},{"lineBreak":true},{"text":"¡Bicaʼ ba bönniʼ naʼ rádxinëʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"bönniʼ naʼ raza ládxëʼë runëʼ ca gunná bëʼë Dios!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tsë́pisëgaca zxíʼini xiʼsóëʼ bönniʼ naʼ yödzölió ni.","poem":1},{"lineBreak":true},{"text":"Gáquiëʼ bicaʼ ba bönniʼ naʼ runëʼ le naca dxiʼa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lu yuʼu lidxëʼ gataʼ yöl-laʼ tsahuiʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ idíaʼticaʼsö le naca tsahuiʼ runëʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gulén beníʼ ga ridë́ʼ bönniʼ tsahuiʼ ga naʼ naca chul-la.","poem":1},{"lineBreak":true},{"text":"Ruzáʼ ládxëʼë que luzë́ʼë, en ruíʼi ládxëʼë lëʼ, en runëʼ le naca dxiʼa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gaca dxiʼa queëʼ bönniʼ ruzáʼ ládxëʼë que luzë́ʼë,","poem":1},{"lineBreak":true},{"text":"en runnëʼ que tu chíʼisö le riyadzaj que.","poem":1},{"lineBreak":true},{"text":"Urúajëʼ dxiʼa cateʼ nu uchiʼa usörö́ queëʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Catu caz gaca nu utsáʼ bönniʼ naʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ sóaticaʼsö nu tsöjné lëʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bitiʼ gádxinëʼ cateʼ nu usiyöni lëʼ le cabí raca dxiʼa.","poem":1},{"lineBreak":true},{"text":"Ridipa ládxëʼë tuʼ ruzxöni ládxëʼë Xanruʼ Dios.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dios rutipëʼ ládxëʼë, ateʼ bitiʼ gádxinëʼ","poem":1},{"lineBreak":true},{"text":"cateʼ idxinrö dza iléʼenëʼ nuhuö́tjagaca nupa taʼdíl-lalen lëʼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Idú ládxëʼë runödzjëʼ quégaca bönachi yechiʼ.","poem":1},{"lineBreak":true},{"text":"Idíaʼticaʼsö le naca dxiʼa runëʼ.","poem":1},{"lineBreak":true},{"text":"Dios uchisëʼ lëʼ ga tsë́pisëʼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ilaʼléʼe lë ni nupa tuáʼ döʼ, en ilaʼbö́ʼ baguíʼisö.","poem":1},{"lineBreak":true},{"text":"Ilagu zxe láyiʼgaca, en ilaʼniti cuínguequi.","poem":1},{"lineBreak":true},{"text":"Tsaz initi le taʼzë́ ládxiʼgaca nupa tuáʼ döʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}