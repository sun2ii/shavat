{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Cateʼ bilaʼrúaj bönachi Israel luyú Egipto","poem":1},{"lineBreak":true},{"text":"bilaʼrúajëʼ zxíʼini xiʼsóëʼ Judá ladaj nupa tuíʼi didzaʼ izáʼa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zxíʼini xiʼsóëʼ Judá guláquiëʼ ca lidxëʼ Xanruʼ Dios,","poem":1},{"lineBreak":true},{"text":"ateʼ gulaca bönachi Israel nupa rinná béʼenëʼ Dios.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lahuëʼ Dios bubigaʼ nísadoʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ bubíʼi nisa yegu Jordán.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gulaʼxitiʼ guíʼa zxön ca yuguʼ böʼcuʼ zxilaʼ biguiúʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ gulaʼxitiʼ caʼ guíʼadoʼ ca yuguʼ böʼcuʼ zxílaʼdoʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Bi raca quiuʼ, nísadoʼ, tuʼ rubiguʼ?","poem":1},{"lineBreak":true},{"text":"¿Bi raca quiuʼ, yegu Jordán, tuʼ rubíʼi nisa quiuʼ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Bi raca queë́liʼ, guíʼa zxön, tuʼ rixítiʼliʼ ca yuguʼ böʼcuʼ zxilaʼ biguiúʼ?","poem":1},{"lineBreak":true},{"text":"¿Bi raca queë́liʼ, guíʼadoʼ, tuʼ rixítiʼliʼ ca yuguʼ böʼcuʼ zxílaʼdoʼ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Guzxizi lahuëʼ Xanruʼ, yödzölió.","poem":1},{"lineBreak":true},{"text":"Guzxizi lahuëʼ Dios queëʼ Jacob.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Benëʼ Dios ga gulaj nisa tu lëʼe guiö́jtoʼo,","poem":1},{"lineBreak":true},{"text":"en benëʼ ga böáca le guca guiö́j jara tu ga rilén nisa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}