{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Busölá nedaʼ, Xan, tuʼ cabirö zoa nitú nu naca dxiʼa,","poem":1},{"lineBreak":true},{"text":"en bitiʼ gaca nu idzöli nitú nu run ca rnna xtídzaʼa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Taʼzíʼ yeʼe yúguʼtë bönachi luzë́ʼeguequi.","poem":1},{"lineBreak":true},{"text":"Lu yöl-laʼ rizíʼ yëʼ quéguequi tuíʼilen luzë́ʼeguequi didzaʼ yúlajdoʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xan, buzóa dxisö nupa naʼ tuíʼi didzaʼ yúlajdoʼ,","poem":1},{"lineBreak":true},{"text":"en buzagaʼ ruíʼigaca nupa tun ba zxön cuínguequi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Taʼnná: “Güíʼiruʼ didzaʼ ca rizësö ládxiʼruʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ cuntu nu táʼbagaʼ rëʼu.","poem":1},{"lineBreak":true},{"text":"¿Nuzxi caz inná beʼe rëʼu ca naca didzaʼ ruíʼiruʼ?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rnnëʼ Xanruʼ: “Naʼa guídaʼ tuʼ nacuáʼ nupa tun ziʼ nupa taʼyadzaj taʼyudxi,","poem":1},{"lineBreak":true},{"text":"ateʼ rinnë́ ládxiʼgaca nupa ni tuʼ zoa nu ribía no léguequi.","poem":1},{"lineBreak":true},{"text":"Ca taʼzësö ládxiʼgaca, laʼ guídateaʼ dusöláʼ léguequi.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Huáca uzxöni ládxiʼruʼ didzaʼ ruʼë Xanruʼ.","poem":1},{"lineBreak":true},{"text":"Nácagaca ca guíë plata ba nequi,","poem":1},{"lineBreak":true},{"text":"le nudxiʼa gadxi luzuí tu lu guíʼ lálëʼe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Liʼ caz, Xan, gun chiʼu léguequi,","poem":1},{"lineBreak":true},{"text":"en usölóʼ léguequi lu náʼagaca nupa tuáʼ döʼ naʼa dza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gátiʼtës nacuáʼ nupa tuáʼ döʼ,","poem":1},{"lineBreak":true},{"text":"cateʼ tun zxön bönachi le ruáʼ döʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}