{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Cateʼ gudíʼi guzxácaʼa bulidzaʼ-nëʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ Lëʼ bubiʼë didzaʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Busölá böʼ naca cazaʼ, Xan, lu naʼ nu rizíʼ yëʼ,","poem":1},{"lineBreak":true},{"text":"en lu naʼ nu bitiʼ run ca gunná caz.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Bizxi gunëʼ quiuʼ Dios, en bizxi ubiʼë quiuʼ, liʼ naʼ rizíʼ yëʼu?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ichizëʼ liʼ yuguʼ yaga lahui tuchiʼ que nu reaj gudil-la,","poem":1},{"lineBreak":true},{"text":"en cuʼë icjuʼ boʼ yalaj que yaʼ yö́ridoʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bicaʼ bayechiʼ nedaʼ tuʼ zóasaʼ yödzö Mesec,","poem":1},{"lineBreak":true},{"text":"en zoaʼ tu lu yuʼu guídi quégaca bönachi Cedar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xidzélëʼë chiguzóa böʼ naca cazaʼ","poem":1},{"lineBreak":true},{"text":"len nupa tuʼsuniti yöl-laʼ riböza dxiʼa tsáhuiʼdoʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rë́ʼëndaʼ cözaʼ dxiʼa tsáhuiʼdoʼ, pero cateʼ ruáʼa didzaʼ","poem":1},{"lineBreak":true},{"text":"të́ʼënnëʼ ilaʼdíl-lalen nedaʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}