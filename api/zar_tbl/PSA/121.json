{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Uchisa icjaʼ uyúaʼ le raca yuguʼ lu guíʼa.","poem":1},{"lineBreak":true},{"text":"¿Gazxi zaʼ le gácalen nedaʼ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le gácalen nedaʼ zaʼ lu nëʼë Xanruʼ.","poem":1},{"lineBreak":true},{"text":"Lëʼ benëʼ lúzxiba, en luyú.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bitiʼ guʼë lataj cuiluʼ ga ridóʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ gasi Nu naʼ run chiʼi liʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buyútsöcaʼ, bitiʼ ridödi yëla guiö́j lahuëʼ,","poem":1},{"lineBreak":true},{"text":"en bitiʼ rásiëʼ, Lëʼ naʼ rapa chiʼë bönachi Israel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Run chiʼë Xanruʼ Dios liʼ.","poem":1},{"lineBreak":true},{"text":"Zoëʼ Xanruʼ Dios cuituʼ ibëla, riguʼë liʼ zxul-la.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bitiʼ uzeguiʼ gubidza liʼ lahuiʼ dza,","poem":1},{"lineBreak":true},{"text":"en bitiʼ bi gun beoʼ quiuʼ chiʼi dzö́ʼölö.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gun chiʼë Xanruʼ Dios liʼ ga rizóʼo, en ga rudxinuʼ,","poem":1},{"lineBreak":true},{"text":"dza ni zóaruʼ naʼa, en yuguʼ dza siʼ zaca.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xanruʼ Dios gun chiʼë liʼ ga rizóʼo, en ga rudxinuʼ,","poem":1},{"lineBreak":true},{"text":"dza ni zóaruʼ naʼa, en yuguʼ dza siʼ zaca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}