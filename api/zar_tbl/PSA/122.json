{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Budzéjadaʼ cateʼ gulë́ bönachi nedaʼ, gulaʼnná:","poem":1},{"lineBreak":true},{"text":"“Uyeajruʼ yuʼu lidxëʼ Xanruʼ Dios.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naʼa zuíruʼ ni","poem":1},{"lineBreak":true},{"text":"ga nu riyaza yödzö Jerusalén.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dxíʼadoʼ gulunëʼ yödzö Jerusalén,","poem":1},{"lineBreak":true},{"text":"ateʼ naca lachi, en tuz ca röjlö́zgaca yuʼu zxön que.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Taʼyaza yuguʼ cöʼ bönachi queëʼ Xanruʼ ga ni","poem":1},{"lineBreak":true},{"text":"ca naʼ nusédinëʼ Dios bönachi Israel,","poem":1},{"lineBreak":true},{"text":"para ilaʼgúʼu yöl-laʼ ba Xanruʼ Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Taʼbö́ʼ nupa tuʼchiʼa tuʼsörö́ queëruʼ ga ni,","poem":1},{"lineBreak":true},{"text":"ga taʼbö́ʼ taʼnná bëʼ zxíʼini xiʼsóëʼ David.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Guliʼnábinëʼ Dios gunëʼ ga gaca dxiʼa que Jerusalén,","poem":1},{"lineBreak":true},{"text":"en ga uluʼzíʼ xibé nupa taʼdxíʼi yödzö ni yöl-laʼ tsahuiʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dios gunëʼ ga ilaʼböza dxiʼa tsáhuiʼdoʼ nupa nacuáʼ yödzö ni,","poem":1},{"lineBreak":true},{"text":"en ga uluʼzíʼ xibé nupa taʼnná bëʼ yöl-laʼ tsahuiʼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tuʼ nadxíʼidaʼ yuguʼ bö́chaʼa, en yuguʼ böchiʼ luzáʼa,","poem":1},{"lineBreak":true},{"text":"rnníaʼ: “Gaca yöl-laʼ riböza dxi ladxiʼ lu yödzö ni.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuʼ nadxíʼidaʼ lidxëʼ Xanruʼ Dios,","poem":1},{"lineBreak":true},{"text":"rinábidaʼ-nëʼ gunëʼ ga gaca dxiʼa que yödzö ni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}