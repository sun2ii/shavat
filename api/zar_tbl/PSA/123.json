{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":123,"content":[{"type":"verse","number":1,"content":[{"text":"Uchisa lahuaʼ uyúaʼ ga zuʼ Liʼ,","poem":1},{"lineBreak":true},{"text":"röʼu rinná bëʼu yehuaʼ yubá niʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ca runëʼ bönniʼ nadóʼo, ruyúëʼ bi uluʼë xanëʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ ruyubiʼ biʼi nigula nadóʼo bi ulúʼunu nigula xanbiʼ,","poem":1},{"lineBreak":true},{"text":"lëscaʼ caní ruyuruʼ rëʼu bi uluʼë Xanruʼ Dios,","poem":1},{"lineBreak":true},{"text":"ga idxinrö dza uzáʼ ládxëʼë queë́ruʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buzáʼ ladxiʼ queë́tuʼ, Xan. Buzáʼ ladxiʼ queë́tuʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ nacuáʼ nupa tuʼcáʼana netuʼ cáʼasö.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rudú ládxiʼtuʼ tuʼ tuʼtitaj netuʼ nupa tuʼzíʼ xibé yúguʼtë le dë,","poem":1},{"lineBreak":true},{"text":"en tuʼ tuʼcáʼana netuʼ cáʼasö nupa tun ba zxön cuínguequi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}