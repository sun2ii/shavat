{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"“Laʼtuʼ cabí gúcalenëʼ Xanruʼ rëʼu”,","poem":1},{"lineBreak":true},{"text":"ral-laʼ ilaʼnná bönachi Israel:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Laʼtuʼ cabí gúcalenëʼ Xanruʼ rëʼu","poem":1},{"lineBreak":true},{"text":"cateʼ nupa bitiʼ taʼléʼe rëʼu dxiʼa gulaʼdíl-lalen rëʼu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"laʼ gulútitë rëʼu","poem":1},{"lineBreak":true},{"text":"tuʼ gulaʼlédeʼe rëʼu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guca queë́ruʼ ca laʼ usubágaʼtë rëʼu nisa,","poem":1},{"lineBreak":true},{"text":"en laʼ uchícjatëruʼ lu nisa naʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Laʼ uchícjatëruʼ tu lu nisa zila.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Bicaʼ láʼayi Xanruʼ Dios","poem":1},{"lineBreak":true},{"text":"tuʼ cabí biʼë lataj nupa bitiʼ taʼléʼe rëʼu dxiʼa uluʼsuniti rëʼu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bularuʼ ca rulabaʼ biguínnidoʼ tu lu le zön lëbaʼ.","poem":1},{"lineBreak":true},{"text":"Narözaʼ du yalaj, ateʼ nuláruʼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Le rácalen rëʼu zaʼ lu nëʼë Xanruʼ Dios.","poem":1},{"lineBreak":true},{"text":"Lëʼ benëʼ lúzxiba, en lu yu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}