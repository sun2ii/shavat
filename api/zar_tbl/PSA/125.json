{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Nupa tuʼzxöni ládxiʼgaca Xanruʼ Dios nácagaca ca guíʼa Sión,","poem":1},{"lineBreak":true},{"text":"tuʼ cabí bi gaca utá guíʼa naʼ, pero tsaz zoa caz.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ca rö́ʼgaca guíʼa idú gásibiʼilö yödzö Jerusalén,","poem":1},{"lineBreak":true},{"text":"laʼ canísö zoëʼ Xanruʼ Dios idú gásibiʼilö bönachi queëʼ,","poem":1},{"lineBreak":true},{"text":"naʼa dza, en yúguʼtë dza siʼ zaca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bitiʼ ral-laʼ ilaʼnná bëʼ nupa tuáʼ döʼ lu xiyúgaca bönachi tsahuiʼ,","poem":1},{"lineBreak":true},{"text":"para cabí iún ga iluʼë döʼ bönniʼ tsahuiʼ naʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xan, ben ga gaca dxiʼa quégaca nupa nácagaca dxiʼa,","poem":1},{"lineBreak":true},{"text":"en quégaca nupa idú ládxiʼgaca tun ca rnna xtídzuʼu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nupa tuʼdödi cuínguequi lu le cabí nácatë,","poem":1},{"lineBreak":true},{"text":"ben léguequi xiguiaʼ tsözxö́n len nupa tuáʼ döʼ.","poem":1},{"lineBreak":true},{"text":"Ben ga ilaʼcuáʼ bönachi Israel dxiʼa tsáhuiʼdoʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}