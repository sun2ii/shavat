{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Cateʼ Xanruʼ Dios buchë́ʼë bönachi yödzö Sión","poem":1},{"lineBreak":true},{"text":"nupa gulaʼdzún ziʼtuʼ, gúquiruʼ yë́lasö rineruʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Níʼirö idú ládxiʼruʼ buzxídxiruʼ,","poem":1},{"lineBreak":true},{"text":"en lu yöl-laʼ rudzeja queë́ruʼ gurö́dxiʼaruʼ.","poem":1},{"lineBreak":true},{"text":"Níʼirö guluíʼi didzaʼ bönachi yuguʼ yödzö izáʼa, gulaʼnná:","poem":1},{"lineBreak":true},{"text":"“Dios, Xángaquiëʼ, benëʼ le nácagaca zxön, gúcalenëʼ légaquiëʼ.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xanruʼ Dios benëʼ le nácagaca zxön, gúcalenëʼ rëʼu,","poem":1},{"lineBreak":true},{"text":"ateʼ ruzíʼiruʼ xibë́ʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buchë́ʼ netuʼ, irúajtuʼ ga ni nadzuntuʼ, Xan,","poem":1},{"lineBreak":true},{"text":"para gácatuʼ ca nisa rudxín lu yegu nuhuíʼigaca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lu yöl-laʼ rudzeja ilaʼbö́dxiʼa cateʼ ilaʼlapa","poem":1},{"lineBreak":true},{"text":"nupa lu yöl-laʼ ribödxi quéguequi röjö́zagaca.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nu bönniʼ lu yöl-laʼ ribödxi rizë́ʼë, nuʼë bínnedoʼ röjözëʼ,","poem":1},{"lineBreak":true},{"text":"lu yöl-laʼ rudzeja cö́dxiʼë cateʼ udxinëʼ, nuʼë le nulapëʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}