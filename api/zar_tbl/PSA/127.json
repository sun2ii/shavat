{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Channö cabí runëʼ tsutsu Xanruʼ Dios tu yuʼu,","poem":1},{"lineBreak":true},{"text":"nítisö tunëʼ dxin bönniʼ tunëʼ yuʼu naʼ.","poem":1},{"lineBreak":true},{"text":"Channö cabí run chiʼë Xanruʼ Dios tu yödzö,","poem":1},{"lineBreak":true},{"text":"nítisö ruyúëʼ bönniʼ naʼ yuʼu lu nëʼë yödzö naʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nítisö naca rubanuʼ zíladoʼ, en röjöxuʼ cateʼ chigúl-ladaʼ,","poem":1},{"lineBreak":true},{"text":"en raguʼ le guzxiʼu niʼa que le busacaʼ ziʼ cuinuʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ runnëʼ Xanruʼ Dios que nu nadxíʼinëʼ cateʼ niʼ rasi nu naʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buliʼyú, nácagacabiʼ zxíʼiniruʼ le runnëʼ Xanruʼ Dios queë́ruʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ bíʼidoʼ tuʼcuáʼanu nigula queë́ruʼ","poem":1},{"lineBreak":true},{"text":"nácagacabiʼ le rubiʼë Xanruʼ Dios queë́ruʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ca nácagaca yaga lahuiʼ tuchiʼ lu naʼ nu bönniʼ rejëʼ gudil-la","poem":1},{"lineBreak":true},{"text":"nácagacabiʼ zxíʼinëʼ bönniʼ zoëʼ iz cuidiʼ queëʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bicaʼ ba bönniʼ nacuáʼabiʼ queëʼ ziántëröbiʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ utuíʼinëʼ cateʼ ruʼë didzaʼ láhuiʼgaquiëʼ","poem":1},{"lineBreak":true},{"text":"bönniʼ tuʼchiʼa tuʼsörö́ëʼ queëʼ, en lógaca nupa taʼdíl-lalen lëʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}