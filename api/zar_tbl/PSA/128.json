{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Bicaʼ ba yúguʼtë nupa tadxi Xanruʼ Dios,","poem":1},{"lineBreak":true},{"text":"nupa naʼ tun ca rë́ʼëni quézinëʼ Lëʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cateʼ gaguʼ le gataʼ quiuʼ niʼa que dxin nun cazuʼ,","poem":1},{"lineBreak":true},{"text":"uziʼu xibé lë naʼ, en gaca dxiʼa quiuʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gácanu nigula quiuʼ ca tu lubá uva dxía ga naca löʼa lidxuʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ ilácabiʼ zxíʼinuʼ ca yuguʼ yaga olívodoʼ taʼbö́ʼöbiʼ ga niʼ ráguliʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buliʼyútsöcaʼ, caní gáquiëʼ bicaʼ ba","poem":1},{"lineBreak":true},{"text":"bönniʼ naʼ rádxinëʼ Xanruʼ Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xanruʼ Dios zoëʼ Sión gunëʼ ga gaca dxiʼa quiuʼ,","poem":1},{"lineBreak":true},{"text":"en guʼë liʼ lataj iléʼenuʼ le dxiʼa gaca que yödzö Jerusalén","poem":1},{"lineBreak":true},{"text":"yúguʼtë dza suʼ ibanuʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dios guʼë liʼ lataj iléʼenuʼ yuguʼ zxíʼini xiʼsúʼ,","poem":1},{"lineBreak":true},{"text":"en gunëʼ ga ilaʼböza dxiʼa tsáhuiʼdoʼ bönachi Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}