{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"“Zian luzuí gulaʼbía no netuʼ ga gudelaʼ nácatuʼ raʼbandoʼ”,","poem":1},{"lineBreak":true},{"text":"huáca ilaʼnná bönachi Israel:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Zian luzuí gulaʼbía no netuʼ ga gudelaʼ nácatuʼ raʼbandoʼ,","poem":1},{"lineBreak":true},{"text":"pero bitiʼ gulaʼdeliʼ uluʼxicja netuʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Guca tsca buluʼgáʼana-baʼ bëdxi lu bëlaʼ cúdzuʼtuʼ,","poem":1},{"lineBreak":true},{"text":"en gulún tunna ga gudödi xiyágabaʼ bëdxi quégaquiëʼ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tsahuiʼ náquiëʼ Xanruʼ Dios.","poem":1},{"lineBreak":true},{"text":"Chinachúguëʼ du quégaca nupa tuáʼ döʼ le gulúguiʼni netuʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ben ga uluʼtuíʼi, en uluʼhuécja guz cúdzuʼlö","poem":1},{"lineBreak":true},{"text":"yúguʼtë nupa bitiʼ taʼléʼe dxiʼa netuʼ, bönachi Sión.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ben ga ilácagaca ca guíxiʼdoʼ daʼ ícjoʼolö yuʼu,","poem":1},{"lineBreak":true},{"text":"le ribídxitë cateʼ niʼ naca huë́ʼënidoʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bitiʼ gaca ulí nëʼe nu tsöjchugu le,","poem":1},{"lineBreak":true},{"text":"en bitiʼ gaca nu gachi tsölén guizxi que,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"en bitiʼ taʼnná nupa taʼdödi niʼ:","poem":1},{"lineBreak":true},{"text":"“Rinábituʼ-nëʼ Xanruʼ Dios gunëʼ ga gaca dxiʼa quiuʼ.","poem":1},{"lineBreak":true},{"text":"Lu Lëʼ Xanruʼ rinábituʼ Lëʼ gunëʼ ga gaca dxiʼa quiuʼ.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}