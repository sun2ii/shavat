{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"¿Gácaʼxte caz gal-la ládxuʼu nedaʼ, Xan?","poem":1},{"lineBreak":true},{"text":"¿Naruʼ tsaz gal-la ládxuʼu nedaʼ?","poem":1},{"lineBreak":true},{"text":"¿Gácaʼxte caz ucacheʼ cuinuʼ lahuaʼ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Gácaʼxte caz gun bayudxi guáʼ ilenaʼ le réquidaʼ ziʼ?","poem":1},{"lineBreak":true},{"text":"¿Gácaʼxte caz huíʼinidaʼ rëla, en te dza?","poem":1},{"lineBreak":true},{"text":"¿Gácaʼxte caz ucúl-lágaca nedaʼ nupa taʼdáʼbagaʼ nedaʼ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buyú nedaʼ, Xan, en bubíʼi didzaʼ.","poem":1},{"lineBreak":true},{"text":"Butipa ládxaʼa para cabí gátiaʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Níʼirö bitiʼ gaca ilaʼnná nupa taʼdáʼbagaʼ nedaʼ, bitiʼ ilaʼnná: “Bucúl-laruʼ lëʼ.”","poem":1},{"lineBreak":true},{"text":"Bitiʼ gaca uluʼdzeja tuʼ nö́tjadaʼ ládxaʼa nedaʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nedaʼ ruzxöni ládxaʼa yöl-laʼ dxiʼi ladxiʼ quiuʼ.","poem":1},{"lineBreak":true},{"text":"Rudzéjadaʼ tuʼ rusölóʼ nedaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gul-laʼ queëʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ benëʼ quiaʼ le naca dxiʼa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}