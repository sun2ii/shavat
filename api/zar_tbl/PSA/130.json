{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Ga ni nö́tjadaʼ rulidzaʼ Liʼ, Xan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ruzë́ naguʼ chiʼa, Xanaʼ Dios.","poem":1},{"lineBreak":true},{"text":"Ruzëdaʼ naguʼ le rinábidaʼ Liʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Laʼ nnaruʼ tsöjnenuʼ xiguiaʼ nabágaʼgaca bönachi,","poem":1},{"lineBreak":true},{"text":"¿nuzxi caz urúaj tsahuiʼ loʼ, Xan?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Runiti lo cazuʼ netuʼ, Xan,","poem":1},{"lineBreak":true},{"text":"para guntuʼ Liʼ bal.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Runaʼ löza Liʼ, Xanaʼ Dios. Run löza böʼ naca cazaʼ Liʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ runaʼ löza gaca ca rnna xtídzuʼu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Böʼ naca cazaʼ runrö löza Liʼ, Xan,","poem":1},{"lineBreak":true},{"text":"ca tunëʼ bönniʼ tapa chiʼë yödzö chiʼi dzö́ʼölö taʼbözëʼ itö́ yu zila,","poem":1},{"lineBreak":true},{"text":"ca tunëʼ löza itö́ yu zila yuguʼ bönniʼ naʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Guliʼgún löza Xanruʼ Dios, libíʼiliʼ, bönachi Israel,","poem":1},{"lineBreak":true},{"text":"tuʼ náquiëʼ dxiʼi ladxiʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"en ruhuáʼuëʼ bönachi Israel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xanruʼ Dios huöáʼuëʼ bönachi Israel","poem":1},{"lineBreak":true},{"text":"lu yúguʼtë xiguiaʼ nabágaʼgaca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}