{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"Bitiʼ run ba zxön cuinaʼ, Xan, en bitiʼ rigúʼu cuinaʼ yöl-laʼ ba,","poem":1},{"lineBreak":true},{"text":"en bitiʼ ulapaʼ naʼa le nácagaca zxön, en le nácagaca böniga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Idú ládxaʼa nuzóa cuinaʼ nöxaj, en zoaʼ dxisö.","poem":1},{"lineBreak":true},{"text":"Ca runbiʼ biʼi huë́ʼëni ruzíʼ ládxiʼbiʼ cuítanu xináʼabiʼ,","poem":1},{"lineBreak":true},{"text":"caʼ riböza böʼ naca cazaʼ lu icja ládxiʼdaʼahuaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¡Libíʼiliʼ, bönachi Israel, guliʼgunëʼ löza Xanruʼ Dios","poem":1},{"lineBreak":true},{"text":"ga naguelaʼ naʼa dza, en yúguʼtë dza siʼ zaca!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}