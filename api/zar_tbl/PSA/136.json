{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"¡Xclenëʼ Xanruʼ Dios tuʼ náquiëʼ dxiʼa!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios nayë́pisëtërëʼ ca yuguʼ dios izáʼa!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Xanruʼ, nayë́pisëtërëʼ ca yuguʼ xángaca bönachi!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, tuzëʼ Lëʼ runëʼ yuguʼ yöl-laʼ huáca zxön!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, len yöl-laʼ rácadaʼ queëʼ benëʼ lúzxiba!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, gudixjëʼ luyú láhuilö nísadoʼ!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, benëʼ gubidza, en beoʼ!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Benëʼ Dios gubidza para tseníʼ lahuiʼ dza!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Benëʼ Dios beoʼ, en yuguʼ bölaj para uluʼzeníʼ chiʼi dzö́ʼölö!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, bë́tiëʼ yuguʼ biʼi bönniʼ lo quégaca bönachi Egipto!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Bubéajëʼ bönachi Israel ladaj bönachi Egipto naʼ!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Len yöl-laʼ huáca zxön queëʼ, en lu yöl-laʼ nadxíʼi queëʼ benëʼ caní!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, bubéajëʼ choplö Nísadoʼ Xiná!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Benëʼ ga gulaʼdödi bönachi Israel gatsaj láhuiʼlö nísadoʼ naʼ!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Lu nísadoʼ naʼ busunítiëʼ Faraón, en bönniʼ queëʼ röjáquiëʼ gudil-la!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, guchë́ʼë bönachi queëʼ laʼ guixiʼ ga niʼ naca yu bidxi!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, bë́tiëʼ bönniʼ gulaʼnná bëʼë, guláquiëʼ nal-la!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Bë́tiëʼ bönniʼ gulaʼnná bëʼë, dëdaʼ lu náʼagaquiëʼ yöl-laʼ unná bëʼ!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Bë́tiëʼ Sehón, bönniʼ gunná béʼenëʼ bönachi Amorreo!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¡Bë́tiëʼ Og, bönniʼ gunná béʼenëʼ bönachi Basán!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¡Budödëʼ xiyúgaquiëʼ lu náʼagaca bönachi queëʼ!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Budödëʼ le lu náʼagaca bönachi Israel, bönachi tun xichinëʼ!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Yöjnenëʼ rëʼu cateʼ niʼ bugáʼanaruʼ cáʼasö!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¡Busölë́ʼ rëʼu lu náʼagaca nupa gulaʼdíl-lalen rëʼu!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¡Rugahuëʼ yúguʼtë bönachi!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¡Xclenëʼ Dios, zoa cazëʼ yehuaʼ yubá!","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ queëʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}