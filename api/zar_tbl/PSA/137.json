{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Raʼ yegu nacuáʼ lu yu Babilonia gurö́ʼötuʼ,","poem":1},{"lineBreak":true},{"text":"en gurödxi yéchiʼtuʼ, cateʼ yöjnetuʼ yödzö Sión.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lu yaga rö́ʼgaca yuguʼ raʼ yegu niʼ","poem":1},{"lineBreak":true},{"text":"bugálaʼtuʼ yuguʼ le rúl-lalentuʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Caní bentuʼ tuʼ gulaʼnabi yudxi nupa gulachë́ʼ netuʼ nadzuntuʼ niʼ gúl-latuʼ.","poem":1},{"lineBreak":true},{"text":"Nupa buluʼsacaʼ ziʼ netuʼ gulaʼnaba queë́tuʼ yöl-laʼ ruzxidxi, gulaʼnná:","poem":1},{"lineBreak":true},{"text":"“Guliʼgul-la queë́tuʼ tu le rul-la que yödzö Sión.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Nacxi caz gaca gúl-latuʼ le rul-la queëʼ Xanruʼ","poem":1},{"lineBreak":true},{"text":"ga ni nadzuntuʼ tu lu yödzö izáʼa?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Channö gal-la ládxaʼa yödzö Jerusalén,","poem":1},{"lineBreak":true},{"text":"rinábidaʼ-nëʼ Dios ugǘëʼ yöl-laʼ raca que naʼa ibëla.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rinábidaʼ-nëʼ gunëʼ ga taʼ lúdxaʼa chichjaʼ","poem":1},{"lineBreak":true},{"text":"channö cabí tsöjnedaʼ ladzaʼ,","poem":1},{"lineBreak":true},{"text":"en channö cabí huíʼ zxönraʼ yödzö Jerusalén ca iaʼtú le ruzíʼidaʼ xibé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yöjné le gulunëʼ zxíʼini xiʼsóëʼ Edom, Xan,","poem":1},{"lineBreak":true},{"text":"le gulunëʼ dza busiúdxuʼ yödzö Jerusalén,","poem":1},{"lineBreak":true},{"text":"ca naʼ gulaʼnnë́ʼ: “Guliʼquínnaj dëra.","poem":1},{"lineBreak":true},{"text":"Guliʼquinnaj dëra ga idxintë xilibi zöʼö yödzö naʼ.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Libíʼiliʼ, bönachi Babilonia, libíʼiliʼ rusunítiliʼ,","poem":1},{"lineBreak":true},{"text":"bicaʼ ba nu ubíʼi queë́liʼ ca naʼ benliʼ queë́tuʼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bicaʼ ba nu quelaʼ yuguʼ bíʼidoʼ queë́liʼ","poem":1},{"lineBreak":true},{"text":"en uzxuzxaj légacabiʼ yuguʼ lu guiö́j.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}