{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":138,"content":[{"type":"verse","number":1,"content":[{"text":"Idú ládxaʼa guíaʼ Liʼ, “Xclenuʼ” Xan.","poem":1},{"lineBreak":true},{"text":"Gul-laʼ yöl-laʼ ba quiuʼ lógaca le tun zxön bönachi yuguʼ yödzö izáʼa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uzóa zxibaʼ sacaʼ yudoʼ láʼayi quiuʼ, en guíaʼ Liʼ, “Xclenuʼ”","poem":1},{"lineBreak":true},{"text":"niʼa que Loʼ, tuʼ nacuʼ dxiʼi ladxiʼ, en runuʼ ca rnna didzaʼ bëʼu,","poem":1},{"lineBreak":true},{"text":"tuʼ benuʼ ca naca lu xtídzuʼu, en lu le naca ca nazíʼi lo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Laʼ dza náʼasö cateʼ bulidzaʼ Liʼ, bubiʼu didzaʼ.","poem":1},{"lineBreak":true},{"text":"Tuʼ butipuʼ ládxaʼa, gucaʼ rugu ladxiʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yúguʼtë bönniʼ taʼnná bëʼë ilë́ʼ Liʼ: “Xclenuʼ” Xan,","poem":1},{"lineBreak":true},{"text":"cateʼ ilaʼyönnëʼ didzaʼ ruʼu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ilul-lëʼ ca nácagaca le runëʼ Xanruʼ Dios,","poem":1},{"lineBreak":true},{"text":"tuʼ nácatërö zxön yöl-laʼ ba queëʼ Xanruʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sal-laʼ nayë́pisëtërëʼ Xanruʼ Dios","poem":1},{"lineBreak":true},{"text":"ruíʼi ládxëʼë nupa nácagaca cáʼasö,","poem":1},{"lineBreak":true},{"text":"pero ziʼtuʼ zíʼtuʼsö ruyúëʼ nupa tun ba zxön cuínguequi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sal-laʼ ridáʼ ga zoa bönadxi quiaʼ, Liʼ utipa cazuʼ ládxaʼa.","poem":1},{"lineBreak":true},{"text":"Tíl-lalen cazuʼ nupa taʼdíl-lalen nedaʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ len yöl-laʼ huáca quiuʼ usölóʼ nedaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xanruʼ gun cazëʼ quiaʼ ca chinuzóa cazëʼ gunëʼ.","poem":1},{"lineBreak":true},{"text":"Zóaticaʼsö yöl-laʼ dxiʼi ladxiʼ quiuʼ, Xan.","poem":1},{"lineBreak":true},{"text":"Bitiʼ usán noʼo le nun cazuʼ len naʼ cuinuʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}