{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Lu icja ládxiʼdaʼahuëʼ rnnëʼ bönniʼ tuʼ canö́z, rnnëʼ: Bitiʼ zoa caz Dios.","poem":1},{"lineBreak":true},{"text":"Nachixi nanítigaquiëʼ bönniʼ caní, en tunëʼ le cabí riléʼenëʼ dxiʼa Dios.","poem":1},{"lineBreak":true},{"text":"Cuntu nu zoa nu run le naca dxiʼa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ga zoëʼ Dios yehuaʼ yubá buyúëʼ luyú ni ga nacuáʼ bönachi","poem":1},{"lineBreak":true},{"text":"para iléʼenëʼ channö zoa nu réajniʼi, nu naʼ riguilaj Dios.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yúguʼtëʼ nadö́digaquiëʼ tsöláʼalö.","poem":1},{"lineBreak":true},{"text":"Nachixi nanítigaquiëʼ tu tuëʼ.","poem":1},{"lineBreak":true},{"text":"Cuntu nu zoa nu run le naca dxiʼa, nitú bönachi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Naruʼ cabí taʼyéajniʼi nupa tuáʼ döʼ?","poem":1},{"lineBreak":true},{"text":"Le tun nupa naʼ naca tsca tagu bönachi quiaʼ ca nu ragu yöta.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ tuʼlidza nedaʼ, Xángaca bönachi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lu yöl-laʼ radxi ridzöbi quéguequi taʼzxizi","poem":1},{"lineBreak":true},{"text":"tuʼ taʼléʼe Xanruʼ Dios, en zóalenëʼ bönachi tsahuiʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tuʼtitaj xtídzaʼgaca nupa nácagaca yechiʼ,","poem":1},{"lineBreak":true},{"text":"pero nupa ni tuʼzxöni ladxiʼ gácalenëʼ Xanruʼ léguequi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Raca ládxaʼa irúaj Sión Nu usölá bönachi Israel.","poem":1},{"lineBreak":true},{"text":"Cateʼ gunëʼ Xanruʼ ga uluʼdxín bönachi queëʼ nadzúngaca xilátjaguequi,","poem":1},{"lineBreak":true},{"text":"uluʼdzeja zxíʼini xiʼsóëʼ Jacob, bönachi Israel, en uluʼzíʼ xibë́ʼ Dios.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}