chiʼi böʼ naca cazaʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gurö́dxiʼa loʼ Liʼ, Xan, gunníaʼ:","poem":1},{"lineBreak":true},{"text":"Run chiʼi cazuʼ nedaʼ Liʼ,","poem":1},{"lineBreak":true},{"text":"en naca cazuʼ Nu rácalen nedaʼ ladaj nupa nabángaca.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ruzë́ naguʼ le rulidzaʼ Liʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ nagáʼanaʼ cáʼasö.","poem":1},{"lineBreak":true},{"text":"Busölá nedaʼ lu náʼagaca nupa taʼzóa reguʼ nedaʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ nácatërögaca nál-la ca nedaʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Guléaj böʼ naca cazaʼ lu yuʼu lidxi guíë,","poem":1},{"lineBreak":true},{"text":"para gaca guíaʼ Liʼ: “Xclenuʼ” tuʼ rulidzaʼ Loʼ.","poem":1},{"lineBreak":true},{"text":"Nupa nácagaca tsahuiʼ uluʼdubi idú gásibiʼilö ga zoaʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ gunnuʼ sizxöni quiaʼ le riquindaʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}