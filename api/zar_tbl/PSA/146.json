{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"¡Guliʼcuʼë yöl-laʼ ba Xanruʼ!","poem":1},{"lineBreak":true},{"text":"¡Liʼ, böʼ naca cazaʼ, guluʼë yöl-laʼ ba Xanruʼ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Cuʼa-nëʼ Xanaʼ yöl-laʼ ba tsanni ni zoaʼ nabanaʼ!","poem":1},{"lineBreak":true},{"text":"¡Gul-laʼ yöl-laʼ ba queëʼ Dios quiaʼ tsanni ni zoa böʼ naca cazaʼ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bitiʼ uzxöni ládxiʼliʼ bönniʼ taʼnná bëʼë,","poem":1},{"lineBreak":true},{"text":"en calëga bönniʼ tati cazëʼ, bönniʼ bitiʼ caʼ gaca uluʼsölë́ʼ rëʼu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rurúaj böʼ yuʼë nu bönniʼ, ateʼ ruhuöáquiëʼ yu.","poem":1},{"lineBreak":true},{"text":"Laʼ dza náʼasö riniti le rizáʼ ládxëʼë gunëʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bicaʼ ba bönniʼ rácalenëʼ Dios queëʼ Jacob lëʼ,","poem":1},{"lineBreak":true},{"text":"bönniʼ naʼ runëʼ löza Xanruʼ Dios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nunëʼ Xanruʼ Dios lúzxiba, en luyú ni,","poem":1},{"lineBreak":true},{"text":"encaʼ nísadoʼ, en yúguʼtë le nacuáʼ yuguʼ lataj naʼ.","poem":1},{"lineBreak":true},{"text":"Rúnticaʼsëʼ Lëʼ ca rnna didzaʼ bëʼë,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"en ruchiʼa rusörö́ëʼ nupa zoa nu rusacaʼ ziʼ léguequi.","poem":1},{"lineBreak":true},{"text":"Rugagu cazëʼ nupa taʼdún.","poem":1},{"lineBreak":true},{"text":"Rusanëʼ Xanruʼ Dios nupa nadzúngaca.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rusaljëʼ Xanruʼ Dios guiö́j lógaca nupa nácagaca lo chul-la.","poem":1},{"lineBreak":true},{"text":"Ruchisëʼ Xanruʼ Dios nupa nadzö́ʼögaca.","poem":1},{"lineBreak":true},{"text":"Nadxíʼinëʼ Xanruʼ Dios nupa nácagaca tsahuiʼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rapa chiʼë Xanruʼ Dios yuguʼ bönniʼ ziʼtuʼ.","poem":1},{"lineBreak":true},{"text":"Rácalenëʼ-biʼ yuguʼ biʼi uzëbi, encaʼ yuguʼ nigula uzëbi,","poem":1},{"lineBreak":true},{"text":"pero ruzaguëʼ xinö́zguequi nupa tuáʼ döʼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Inná bë́ʼticaʼsëʼ Xanruʼ Dios.","poem":1},{"lineBreak":true},{"text":"Náquiëʼ Dios queë́liʼ, bönachi Sión.","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba Xanruʼ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}