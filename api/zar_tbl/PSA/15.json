{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"¿Nuzxi caz bönachi tsöjsóa xilatjuʼ, Xan?","poem":1},{"lineBreak":true},{"text":"¿Nuzxi caz tsöjsóa ga naca láʼayi quiuʼ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nu naʼ naca idú ladxiʼ, en run le naca tsahuiʼ,","poem":1},{"lineBreak":true},{"text":"en lu icja ládxiʼdaʼahui ruíʼi didzaʼ le nácatë.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nu naʼ bitiʼ rizíʼ quidzaʼ bönachi,","poem":1},{"lineBreak":true},{"text":"en bitiʼ ruáʼ döʼ que luzë́ʼe,","poem":1},{"lineBreak":true},{"text":"en bitiʼ ruzë́ naga nu rizíʼ quidzaʼ luzë́ʼe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nu naʼ bitiʼ run bal nu ruáʼ döʼ,","poem":1},{"lineBreak":true},{"text":"pero run bal nupa tun zxön Dios,","poem":1},{"lineBreak":true},{"text":"en sal-laʼ bi uniti cateʼ chinún xtidzaʼ, bitiʼ caʼ rutsáʼ didzaʼ naʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nu naʼ bitiʼ rizíʼ icja dumí cateʼ runödzaj dumí que tu chíʼidoʼsö,","poem":1},{"lineBreak":true},{"text":"en bitiʼ rizíʼ dumí para siʼ yëʼ ca naca le nun nu bitiʼ nabagaʼ xiguiaʼ.","poem":1},{"lineBreak":true},{"text":"Nu naʼ run yúguʼtë le caní bitiʼ caʼ idzáʼ xilataj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}