{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"¡Guliʼcuʼë yöl-laʼ ba Xanruʼ!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba Dios lu lataj láʼayi queëʼ!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba ga dëdaʼ lataj queëʼ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba ca nácagaca le zxön nunëʼ!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba ca naca yöl-laʼ zxön queëʼ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba, ucö́dxiliʼ lúzugacabaʼ chivo!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba, quínniliʼ lë́ʼegaca bihuël-la caʼ!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba, cápaʼliʼ lëʼe guídi, en uyaʼaliʼ!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba, quínniliʼ lë́ʼegaca bihuël-la, en ucö́dxiliʼ gui!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba, utíl-laliʼ guíë lëʼe luzë́ʼe!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba, utíl-laliʼ guíë zxön lëʼe luzë́ʼe!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba Xanruʼ, tscaliʼ rizíʼiliʼ böʼ!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba Xanruʼ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}