{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"Ben chiʼi nedaʼ, Dios, tuʼ ruzxöni ládxaʼa Liʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lu icja ládxiʼdaʼahuaʼ gudxaʼ-nëʼ Xanruʼ:","poem":1},{"lineBreak":true},{"text":"“Liʼ nacuʼ Xanaʼ.","poem":1},{"lineBreak":true},{"text":"Bítiʼrö bi zoa quiaʼ le naca dxiʼa, pero tuzuʼ Liʼ.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Riyaza ládxiʼlenaʼ nupa nácagaca queëʼ Dios luyú ni,","poem":1},{"lineBreak":true},{"text":"en nupa nácagaca idú ladxiʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ilaʼyán le ilaʼguíʼi ilaʼzacaʼ nupa taʼyéaj ladxiʼ yuguʼ dios izáʼa.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ cuʼa láhuiguequi rön ca tun bönachi naʼ,","poem":1},{"lineBreak":true},{"text":"en bitiʼ ulidzaʼ lágaca dios naʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Náquiëʼ Xanruʼ Dios Nu nabánidaʼ, en Nu ruziʼa xibé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Liʼ, Xan, nuzúʼ xilatjaʼ.","poem":1},{"lineBreak":true},{"text":"Lataj naʼ nuzúʼ quiaʼ naca le ruziʼa xibé,","poem":1},{"lineBreak":true},{"text":"en lachi naca lataj naʼ nequi quiaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gul-laʼ yöl-laʼ ba queëʼ Xanruʼ, Nu rigúʼu yöl-laʼ nedaʼ le naca tsahuiʼ,","poem":1},{"lineBreak":true},{"text":"ga ridxintë ruzéajniʼinëʼ nedaʼ cateʼ niʼ rasiaʼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chinunaʼ ga zóaticaʼsëʼ Xanruʼ lahuaʼ.","poem":1},{"lineBreak":true},{"text":"Tuʼ zoëʼ cuitaʼ bitiʼ bi utsáʼ nedaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Que lë ni naʼ budzeja ládxaʼa, en buzíʼ xibé ládxiʼdaʼahuaʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ gun löza le nacaʼ cateʼ igáchaʼa yeru ba,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"tuʼ cabí ucáʼanuʼ nedaʼ lataj chul-la,","poem":1},{"lineBreak":true},{"text":"en bitiʼ guʼu lataj uniti nu nequi quez quiuʼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nunuʼ ga núnbëʼa nöza ichë́ʼ nedaʼ ga soaʼ ibanaʼ.","poem":1},{"lineBreak":true},{"text":"Ga zuʼ Liʼ gataʼ quiaʼ yöl-laʼ rudzeja idú,","poem":1},{"lineBreak":true},{"text":"ateʼ cuituʼ Liʼ uzíʼticaʼsaʼ xibóʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}