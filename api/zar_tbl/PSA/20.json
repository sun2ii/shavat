{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"Rinábidaʼ-nëʼ Xanruʼ uzë́ naguëʼ liʼ cateʼ idxín dza quiʼi sacuʼu.","poem":1},{"lineBreak":true},{"text":"Dios queëʼ Jacob gácalenëʼ liʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rinábidaʼ-nëʼ isö́l-lëʼë le gácalen liʼ le irúaj lataj láʼayi queëʼ.","poem":1},{"lineBreak":true},{"text":"Lë naʼ irúaj Sión gun ga gacuʼ tsutsu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Rinábidaʼ-nëʼ tsöjnenëʼ yúguʼtë le gulúʼu queëʼ,","poem":1},{"lineBreak":true},{"text":"en siʼ lu nëʼë le buzéguiʼu lahuëʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rinábidaʼ-nëʼ gunnëʼ quiuʼ tsca naca le rizë́ ládxuʼu,","poem":1},{"lineBreak":true},{"text":"en gunëʼ ga gácatë yúguʼtë le rizáʼ ládxuʼu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Udzéjatuʼ cateʼ usölë́ʼ liʼ,","poem":1},{"lineBreak":true},{"text":"en uchísatuʼ le gaca bëʼ rulidztuʼ-nëʼ Dios queë́ruʼ.","poem":1},{"lineBreak":true},{"text":"Rinábidaʼ-nëʼ Xanruʼ gunnëʼ quiuʼ yúguʼtë le rinábinuʼ Lëʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naʼa nözdaʼ rusölë́ʼ Xanruʼ nu nabö́ cazëʼ.","poem":1},{"lineBreak":true},{"text":"Riyönnëʼ nu naʼ nabö́ëʼ ga niʼ zoëʼ yehuaʼ yubá laʼayi queëʼ.","poem":1},{"lineBreak":true},{"text":"Isö́l-lëʼë yöl-laʼ huáca idú queëʼ le usölá nu naʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nacuáʼ nupa tuʼzxöni ladxiʼ yuguʼ carreta que gudil-la,","poem":1},{"lineBreak":true},{"text":"ateʼ nacuáʼ bönachi yúbölö tuʼzxöni ladxiʼ yuguʼ böaʼ,","poem":1},{"lineBreak":true},{"text":"pero rëʼu ruzxöni ládxiʼruʼ Lëʼ Xanruʼ Dios.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Taʼcuídiʼnëʼ nupa naʼ, en taʼdzöʼë,","poem":1},{"lineBreak":true},{"text":"pero rëʼu ni zuíruʼ, en zóaruʼ tsutsu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Busölá netuʼ, Xan, tuʼ nacuʼ Nu rinná beʼe netuʼ.","poem":1},{"lineBreak":true},{"text":"Rinábituʼ Liʼ uzë́ naguʼ netuʼ cateʼ ulídzatuʼ Liʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}