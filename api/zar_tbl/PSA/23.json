{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Ruyú cazëʼ Xanruʼ Dios nedaʼ ca tu nu ruyú böʼcuʼ zxilaʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ bi riyádzjadaʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Runëʼ ga ruzíʼ ládxaʼa ca túngacabaʼ böʼcuʼ zxilaʼ tuʼzíʼ ládxiʼbaʼ gapa dëdaʼ le ilágubaʼ.","poem":1},{"lineBreak":true},{"text":"Ga naca raʼ nisa rizáʼ tsahuiʼ ládxiʼdoʼ richë́ʼë nedaʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Runëʼ ga ruhuöáca ládxaʼa.","poem":1},{"lineBreak":true},{"text":"Richë́ʼë nedaʼ ga naca nöza tsahuiʼ tuʼ nadxíʼinëʼ nedaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sal-laʼ ridáʼ ga zoa bönadxi gátiaʼ,","poem":1},{"lineBreak":true},{"text":"bitiʼ bi gádxidaʼ tuʼ zóalen cazuʼ nedaʼ, Dios.","poem":1},{"lineBreak":true},{"text":"Len xiyaga quiuʼ, en noʼo rutipuʼ ládxaʼa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ga nacuáʼ nupa taʼzóa reguʼ nedaʼ, niʼ rucúʼu quiaʼ le gahuaʼ.","poem":1},{"lineBreak":true},{"text":"Rigúʼu icjaʼ le za riláʼ zxixi, en ruliruʼ le guíʼjadaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Le nácatë dusóalengaca nedaʼ le naca dxiʼa,","poem":1},{"lineBreak":true},{"text":"en yöl-laʼ dxiʼi ladxiʼ queëʼ yúguʼtë dza soaʼ ibanaʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ lu yuʼu lidxëʼ Xanruʼ sóaticaʼsaʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}