{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"Guléaj nedaʼ tsahuiʼ, Xan, tuʼ runaʼ le naca dxiʼa,","poem":1},{"lineBreak":true},{"text":"en idú ládxaʼa ruzxöni ládxaʼa Liʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buyú lu icja ládxiʼdaʼahuaʼ, Xan, en guzxíʼ bëʼ nedaʼ.","poem":1},{"lineBreak":true},{"text":"Buyú le rizáʼ ládxaʼa, en le ribequi icjaʼ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tuʼ richë́ʼ yöl-laʼ dxiʼi ladxiʼ quiuʼ nedaʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ runaʼ ca naca le naca idútë li quiuʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bitiʼ runaʼ tsözxö́n nupa taʼzíʼ yëʼ,","poem":1},{"lineBreak":true},{"text":"en bitiʼ ridálenaʼ nupa tuʼluíʼisö cuínguequi tsahuiʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bitiʼ raza ládxaʼa udúbilenaʼ nupa tuáʼ döʼ,","poem":1},{"lineBreak":true},{"text":"en bitiʼ gunaʼ tuz didzaʼ len nupa nácagaca xihuiʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Richisa naʼa loʼ Liʼ, Dios, cabí dxía döʼ naʼa,","poem":1},{"lineBreak":true},{"text":"en idú ládxaʼa ribígaʼa lo bucugu quiuʼ, Xan,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"para gul-laʼ le guíaʼ Liʼ: “Xclenuʼ”","poem":1},{"lineBreak":true},{"text":"en usiyöndaʼ bönachi ca nácagaca le zxön nunuʼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nadxíʼidaʼ yuʼu lidxuʼ ga naʼ zuʼ, Xan,","poem":1},{"lineBreak":true},{"text":"encaʼ lataj ga naʼ yuʼu beníʼ láʼayi quiuʼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bitiʼ usunítiuʼ nedaʼ tsözxö́n len nupa tun dul-laʼ,","poem":1},{"lineBreak":true},{"text":"en bitiʼ gútiuʼ nedaʼ len nupa tuti bönachi,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"nupa naʼ taʼyaza ladxiʼ tuáʼ döʼ,","poem":1},{"lineBreak":true},{"text":"en nacuáʼticaʼsö ilaʼguizxaj dumí para uluʼrúaj tsahuiʼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gúnticaʼsaʼ nedaʼ le naca dxiʼa.","poem":1},{"lineBreak":true},{"text":"Buzáʼ ladxiʼ quiaʼ, en buáʼuö nedaʼ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuzóëʼ Dios nedaʼ ga zoaʼ tsutsu ladja bönachi guizxi yu","poem":1},{"lineBreak":true},{"text":"nudúbigaca queëʼ para cuʼa-nëʼ yöl-laʼ ba Xanruʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}