{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Xan, chinayángacadaʼ nupa taʼlé nedaʼ.","poem":1},{"lineBreak":true},{"text":"Zián nupa taʼdáʼbagaʼ nedaʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zián nupa taʼnnë́ quiaʼ, taʼnná:","poem":1},{"lineBreak":true},{"text":"“Bitiʼ usölë́ʼ Dios lëʼ.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pero Liʼ, Xan, run chíʼiticaʼsuʼ nedaʼ.","poem":1},{"lineBreak":true},{"text":"Nacuʼ yöl-laʼ ba quiaʼ, en Nu rutipa nedaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bëʼa zidzaj didzaʼ, bulidzaʼ-nëʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ Lëʼ biyönnëʼ chiʼa ga naʼ zoëʼ lataj láʼayi queëʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nedaʼ rataʼ, en rasiaʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ rubanaʼ, tuʼ nazö́nticaʼsëʼ Xanruʼ Dios nedaʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bitiʼ gádxidaʼ gayuáʼ gayuáʼ bönachi,","poem":1},{"lineBreak":true},{"text":"nupa naʼ nagúʼugaca nedaʼ lë́ʼajlö.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Guyasa, Xan! ¡Busölá nedaʼ, Dios quiaʼ!","poem":1},{"lineBreak":true},{"text":"Budxía huëʼ xágaʼgaca nupa tuʼdíʼi nedaʼ,","poem":1},{"lineBreak":true},{"text":"en buquínnajdaʼ nupa nácagaca xihuiʼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xan, rusölá cazuʼ bönachi quiuʼ.","poem":1},{"lineBreak":true},{"text":"Ben ga gaca dxiʼa quégaca bönachi quiuʼ.","poem":1},{"lineBreak":true},{"text":"¡Caʼ gaca!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}