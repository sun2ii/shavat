{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Bubíʼi didzaʼ cateʼ rulidzaʼ Liʼ, Dios.","poem":1},{"lineBreak":true},{"text":"Nacuʼ Nu ruchiʼa rusörö́ le raca quiaʼ.","poem":1},{"lineBreak":true},{"text":"Cateʼ guröʼa böniga, bida cazuʼ Liʼ ga zoaʼ, en gúcalenuʼ nedaʼ.","poem":1},{"lineBreak":true},{"text":"Ruhuéchiʼ ladxiʼ nedaʼ, en ruzë́ naguʼ le rinábidaʼ Liʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rnnëʼ Dios: “Libíʼiliʼ, bönachi, ¿gácaʼxte ulidza dítajliʼ nedaʼ?","poem":1},{"lineBreak":true},{"text":"¿Gácaʼxte caz idxíʼiliʼ le cabí nazacaʼ, en güíʼi ládxiʼliʼ le cabí naca?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Guliʼtsöjné nabö́ cazëʼ Xanruʼ nu radxi Lëʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ riyönnëʼ nedaʼ cateʼ rulidzaʼ-nëʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guliʼgadxi Lëʼ, en bítiʼrö gunliʼ dul-laʼ.","poem":1},{"lineBreak":true},{"text":"Guliʼsáʼ ladxiʼ ca naca lë ni cateʼ dëliʼ ga rátaʼliʼ, en guliʼsóa dxisö.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Guliʼcúʼu lahuëʼ Xanruʼ le naca dxiʼa,","poem":1},{"lineBreak":true},{"text":"en buliʼzxöni ladxiʼ Lëʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zián nupa taʼnná: “¿Nuzxi caz gun ga gaca dxiʼa queë́ruʼ?”","poem":1},{"lineBreak":true},{"text":"Lu yöl-laʼ dxiʼi ladxiʼ quiuʼ buyú netuʼ, Xan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Runuʼ ga rudzéjadeʼerödaʼ","poem":1},{"lineBreak":true},{"text":"ca tuʼdzeja nupa tuʼzíʼ xibé zxoaʼ za guizxi yu, en xisi lubá uva.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cateʼ rataʼ, laʼ rásitiaʼ lu yöl-laʼ riböza dxi ladxiʼ quiaʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ run cazuʼ Liʼ, Xan, ga ribözaʼ dxiʼa tsáhuiʼdoʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}