{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Guléaj nedaʼ tsahuiʼ, Dios, en bëʼ didzaʼ uláz quiaʼ lógaca bönachi tuáʼ döʼ quiaʼ.","poem":1},{"lineBreak":true},{"text":"Busölá nedaʼ lu naʼ nu rizíʼ yëʼ, en bitiʼ naca tsahuiʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Liʼ cazuʼ nacuʼ Dios, Nu rutipa ládxaʼa. ¿Bizx que nusán noʼo nedaʼ?","poem":1},{"lineBreak":true},{"text":"¿Bizx que ruhuíʼinidaʼ tuʼ taʼbía no nedaʼ nupa tuʼdíʼi nedaʼ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gusö́l-laʼ quiaʼ beníʼ quiuʼ, en le naca idútë li quiuʼ para uluʼluíʼi nedaʼ nöza.","poem":1},{"lineBreak":true},{"text":"Ben ga ilaʼchë́ʼ nedaʼ ga naca láʼayi quiuʼ, ga naʼ zoa cazuʼ Liʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tsuʼa raʼ bucugu queëʼ Dios.","poem":1},{"lineBreak":true},{"text":"Ibígaʼa lahuëʼ Dios, Nu run ga rudzéjadeʼedaʼ.","poem":1},{"lineBreak":true},{"text":"Gúl-lalenaʼ bihuël-la, cuʼa Liʼ yöl-laʼ ba, Dios, nacuʼ Dios quiaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Bizx que risë́bidaʼ ládxaʼa, en bizx que röʼa böniga?","poem":1},{"lineBreak":true},{"text":"Uzxöni ládxaʼa-nëʼ Xanruʼ Dios,","poem":1},{"lineBreak":true},{"text":"tuʼ huadxín dza cuʼa-nëʼ yöl-laʼ ba le yúbölö,","poem":1},{"lineBreak":true},{"text":"tuʼ náquiëʼ Nu rusölá nedaʼ, en náquiëʼ Dios quiaʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}