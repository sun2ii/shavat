{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"¡Lu yöl-laʼ rudzeja queë́liʼ guliʼcapaʼ náʼaliʼ, bönachi yúguʼtë yödzö!","poem":1},{"lineBreak":true},{"text":"¡Guliʼcuʼë yöl-laʼ ba Dios, len yuguʼ le rúl-lalenliʼ!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ral-laʼ gunruʼ bal Xanruʼ Dios nayë́pisëtërëʼ.","poem":1},{"lineBreak":true},{"text":"Náquiëʼ Nu rinná bëʼ idútë yödzölió.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Benëʼ ga bidéliʼruʼ yuguʼ lu bönachi izáʼa.","poem":1},{"lineBreak":true},{"text":"Benëʼ ga rinná beʼeruʼ yuguʼ yödzö.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gurö́ cazëʼ luyú ga ni nuzóëʼ rëʼu.","poem":1},{"lineBreak":true},{"text":"Naca tu luyú lachi quégaca zxíʼini xiʼsóëʼ Jacob, nupa naʼ nadxíʼi quézinëʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Len yöl-laʼ ba zxön ribenëʼ Dios ga röʼë rinná bëʼë.","poem":1},{"lineBreak":true},{"text":"Le zián le tuʼcödxëʼ cateʼ ribenëʼ Xanruʼ niʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Guliʼgul-la yöl-laʼ ba queëʼ Dios! ¡Guliʼgul-la!","poem":1},{"lineBreak":true},{"text":"¡Guliʼgul-la yöl-laʼ ba queëʼ Bönniʼ rinná béʼenëʼ rëʼu! ¡Guliʼgul-la!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Rinná bëʼë Dios idútë yödzölió ni!","poem":1},{"lineBreak":true},{"text":"¡Idú ládxiʼliʼ guliʼgul-la yöl-laʼ ba queëʼ!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Zoa cazëʼ Dios lataj láʼayi queëʼ ga röʼë rinná bëʼë!","poem":1},{"lineBreak":true},{"text":"¡Rinná béʼenëʼ bönachi yúguʼtë yödzö!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tuʼdubi nupa taʼnná beʼe yuguʼ yödzö","poem":1},{"lineBreak":true},{"text":"tsözxö́n len bönachi queëʼ Dios queëʼ Abraham.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Nequi queëʼ Dios yöl-laʼ zxön quégaca yúguʼtë yödzö nacuáʼ yödzölió!","poem":1},{"lineBreak":true},{"text":"¡Nayë́pisëtërëʼ Lëʼ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}