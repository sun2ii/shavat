{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Taʼzáʼ ládxëʼë bönniʼ canö́z, taʼnnë́ʼ:","poem":1},{"lineBreak":true},{"text":"“Bitiʼ caʼ zoëʼ Dios.”","poem":1},{"lineBreak":true},{"text":"Nácagaquiëʼ xihuiʼ bönniʼ caní, en núngaquiëʼ le nácatërö xihuiʼ.","poem":1},{"lineBreak":true},{"text":"Cuntu nu bönniʼ zoëʼ runëʼ le naca dxiʼa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ga naʼ zoëʼ Dios yehuaʼ yubá ruyúëʼ gátiʼtës,","poem":1},{"lineBreak":true},{"text":"en riléʼenëʼ bönachi nacuáʼ idútë yödzölió,","poem":1},{"lineBreak":true},{"text":"para inö́zinëʼ channö zoa nu réajniʼi,","poem":1},{"lineBreak":true},{"text":"o channö zoëʼ nu bönniʼ ruíʼi ládxëʼë Dios.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yúguʼtë bönachi söjáquiëʼ ga yúbölö.","poem":1},{"lineBreak":true},{"text":"Yúguʼtëʼ nácagaquiëʼ xihuiʼ.","poem":1},{"lineBreak":true},{"text":"Cuntu nu zoa run le naca dxiʼa, nitúëʼ bönniʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Naruʼ cabí nápagaquiëʼ yöl-laʼ réajniʼi bönniʼ naʼ tuʼë döʼ?","poem":1},{"lineBreak":true},{"text":"Tuʼsunítiëʼ bönachi quiaʼ ca tu nu ragu yöta,","poem":1},{"lineBreak":true},{"text":"en bitiʼ caʼ tuʼlidzëʼ nedaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tadxi taʼdzö́binëʼ bönniʼ caní, en bitiʼ bi nunaʼ quégaquiëʼ.","poem":1},{"lineBreak":true},{"text":"Caní raca tuʼ rusunítiëʼ Dios caz nupa taʼdíl-lalen libíʼiliʼ.","poem":1},{"lineBreak":true},{"text":"Gunliʼ ga uluʼtuíʼinëʼ tuʼ chigurúʼunëʼ Dios légaquiëʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Raca ládxiʼruʼ irúaj Sión Nu usölá bönachi Israel.","poem":1},{"lineBreak":true},{"text":"Cateʼ uchisa cazëʼ Dios bönachi queëʼ nadzúngaca,","poem":1},{"lineBreak":true},{"text":"uluʼdzeja zxíʼini xiʼsóëʼ Jacob, en uluʼzíʼ xibé bönachi Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}