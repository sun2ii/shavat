{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Busölá nedaʼ, Dios, para gaca yöl-laʼ ba que Loʼ.","poem":1},{"lineBreak":true},{"text":"Len yöl-laʼ huáca quiuʼ guléaj nedaʼ tsahuiʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ruzë́ naguʼ le rulidzaʼ Liʼ, Dios.","poem":1},{"lineBreak":true},{"text":"Ruzë́ naguʼ didzaʼ ruáʼa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Taʼdíl-lalen bönniʼ ziʼtuʼ nedaʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ të́ʼënëʼ bönniʼ zidzaj ilútiëʼ nedaʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ caʼ tádxinëʼ Dios.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buliʼyútsöcaʼ, naca cazëʼ Dios Nu rácalen nedaʼ.","poem":1},{"lineBreak":true},{"text":"Ruzóëʼ tsutsu Xanruʼ yöl-laʼ naʼbán quiaʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ubiʼë quégaca nupa taʼdíl-lalen nedaʼ le usuniti léguequi.","poem":1},{"lineBreak":true},{"text":"Tuʼ runuʼ ca rnna xtídzuʼu, Dios, busuniti léguequi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Idú ládxaʼa gútiaʼ-baʼ böaʼ-bëdxi loʼ.","poem":1},{"lineBreak":true},{"text":"Guíaʼ Liʼ: “Xclenuʼ” Xan, tuʼ naca dxiʼa Loʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Busölá cazuʼ Liʼ nedaʼ lu yuguʼ le guca quiaʼ,","poem":1},{"lineBreak":true},{"text":"ateʼ riléʼedaʼ zeaj nanítiticaʼsö nupa taʼdíl-lalen nedaʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}