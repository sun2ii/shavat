{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Bitiʼ uzenuʼ bach nedaʼ lu yöl-laʼ rilé quiuʼ, Xan.","poem":1},{"lineBreak":true},{"text":"Bitiʼ gunuʼ nedaʼ xiguiaʼ lu yöl-laʼ ridzáʼa quiuʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buéchiʼ ladxiʼ nedaʼ, Xan, tuʼ rudú ládxaʼa.","poem":1},{"lineBreak":true},{"text":"Bun nedaʼ, Xan, tuʼ riguíʼi rizácaʼa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Röʼö böniga idútë le nacaʼ.","poem":1},{"lineBreak":true},{"text":"¿Gácaʼxte caz gaca caní, Xan?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gudá dusölóʼ nedaʼ, Xan.","poem":1},{"lineBreak":true},{"text":"Tuʼ nadxíʼinuʼ nedaʼ, busölá nedaʼ lu yöl-laʼ guti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lu lataj chul-la cuntu nu tsöjné Liʼ.","poem":1},{"lineBreak":true},{"text":"Cuntu nu zoa niʼ nu gaca cuʼu Liʼ yöl-laʼ ba.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rudú ládxaʼa tuʼ rinnë́ticaʼsö ládxaʼa.","poem":1},{"lineBreak":true},{"text":"Yuguʼ dzöʼ ribisa le rátiʼdaʼ len nisa ribödxi quiaʼ.","poem":1},{"lineBreak":true},{"text":"Rusubisaʼ xcúguaʼ len nisa ribödxi quiaʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Röʼö gui guiö́j lahuaʼ tuʼ ribö́dxiticaʼsaʼ.","poem":1},{"lineBreak":true},{"text":"Bitiʼ gaca iléʼedaʼ tuʼ nö́zigaca nupa tuʼdíʼi nedaʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Guliʼcuíta ga zoaʼ, libíʼiliʼ, ruáʼaliʼ döʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ riyönnëʼ Xanruʼ ribödxaʼ nedaʼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ruzë́ naguëʼ le rulidzaʼ, rátaʼyuaʼ lahuëʼ,","poem":1},{"lineBreak":true},{"text":"en rubiʼë didzaʼ cateʼ bi rinábidaʼ Lëʼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Uluʼtuíʼi nupa tuʼdíʼi nedaʼ, en ilaʼbö́ʼ böniga.","poem":1},{"lineBreak":true},{"text":"Lu yöl-laʼ rutuíʼi quéguequi uluʼbigaʼ ga zoaʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}