{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"Ruzë́ naguʼ le rulidzaʼ Liʼ, Dios.","poem":1},{"lineBreak":true},{"text":"Ruíʼi ládxuʼu le rinábidaʼ Liʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ga ni zoaʼ ziʼtuʼ ga dë ladzaʼ rulidzaʼ Liʼ tuʼ rudú ládxaʼa.","poem":1},{"lineBreak":true},{"text":"Guchë́ʼ nedaʼ ga zoa Nu naʼ naca ca tu guiö́jtoʼo, Nu naʼ nál-latërö ca nedaʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nacuʼ Liʼ Nu run chiʼi nedaʼ.","poem":1},{"lineBreak":true},{"text":"Nacuʼ Nu rácalen nedaʼ cateʼ zoa nu ribía no nedaʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bëʼ lataj sóaticaʼsaʼ ga zoa cazuʼ Liʼ.","poem":1},{"lineBreak":true},{"text":"Bëʼ lataj sóalenaʼ Liʼ, gunaʼ nedaʼ ca tunbaʼ bö́radoʼ taʼyázabaʼ zxan xílabaʼ yöjede.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Biyö́n quézinuʼ Liʼ le guzxíʼ lu naʼa gunaʼ quiuʼ Liʼ, Dios.","poem":1},{"lineBreak":true},{"text":"Benuʼ ga nequi quiaʼ le runödzjuʼ quégaca nupa tadxi Liʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gunuʼ ga soëʼ xidzé bönniʼ naʼ rinná bëʼë uláz quiuʼ.","poem":1},{"lineBreak":true},{"text":"Zián iz soëʼ ibanëʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sóaticaʼsëʼ loʼ Liʼ, Dios.","poem":1},{"lineBreak":true},{"text":"Bëʼ queëʼ yöl-laʼ dxiʼi ladxiʼ, en le naca idútë li, yuguʼ le ilún chiʼi lëʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Gúl-laticaʼsaʼ yöl-laʼ ba que Loʼ,","poem":1},{"lineBreak":true},{"text":"para gaca gunaʼ tu tu dza le guzxíʼ lu naʼa!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}