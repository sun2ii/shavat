{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":63,"content":[{"type":"verse","number":1,"content":[{"text":"Dios, nacuʼ Dios quiaʼ, ateʼ idú ládxaʼa ruguiljaʼ Liʼ.","poem":1},{"lineBreak":true},{"text":"Ribidxi ládxaʼa Liʼ, ateʼ idútë le nacaʼ rizë́ ladxiʼ Liʼ.","poem":1},{"lineBreak":true},{"text":"Zoaʼ tu luyú bidxi ga ni rudú ládxaʼa, ateʼ bitiʼ bi dë nisa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ben ga iléʼedaʼ Liʼ lu lataj ga naʼ zoa cazuʼ,","poem":1},{"lineBreak":true},{"text":"para iléʼedaʼ yöl-laʼ huáca quiuʼ, en yöl-laʼ beníʼ quiuʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tuʼ nácatërö dxiʼa yöl-laʼ dxiʼi ladxiʼ quiuʼ ca yöl-laʼ naʼbán caz.","poem":1},{"lineBreak":true},{"text":"Que lë ni naʼ cuʼa Liʼ yöl-laʼ ba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guíaʼ Liʼ: “Xclenuʼ” tsanni ni zoaʼ nabanaʼ.","poem":1},{"lineBreak":true},{"text":"Uchisaʼ naʼa, en ulidzaʼ Loʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ruhuölaj rudzéʼe icja ládxiʼdaʼahuaʼ le nácatërö dxiʼa,","poem":1},{"lineBreak":true},{"text":"ateʼ lu yöl-laʼ rudzeja quiaʼ riguʼa Liʼ yöl-laʼ ba.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Röjnedaʼ Liʼ cateʼ déaʼ lu le rátiʼdaʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rizáʼ ládxaʼa ca nacuʼ cateʼ rinaʼsaʼ yëla.","poem":1},{"lineBreak":true},{"text":"Rácalen cazuʼ nedaʼ,","poem":1},{"lineBreak":true},{"text":"en tuʼ run chiʼu nedaʼ, lu yöl-laʼ rudzeja quiaʼ rul-laʼ quiuʼ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nazö́n cazuʼ Liʼ böʼ naca cazaʼ.","poem":1},{"lineBreak":true},{"text":"Rizö́n cazuʼ Liʼ nedaʼ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"pero ilaʼyaza lataj chul-la","poem":1},{"lineBreak":true},{"text":"nupa të́ʼëni iluti nedaʼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ilátigaca lu guíë tuchiʼ.","poem":1},{"lineBreak":true},{"text":"Ilágugaca böʼcuʼ zugaʼ léguequi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nu rinná bëʼ uláz queëʼ Xanruʼ udzeja ladxiʼ lahuëʼ Dios.","poem":1},{"lineBreak":true},{"text":"Uluʼzíʼ xibé yúguʼtë nupa tuʼzxöni ladxiʼ Lëʼ,","poem":1},{"lineBreak":true},{"text":"tuʼ usayaj cazëʼ Lëʼ ruíʼigaca nupa taʼzíʼ yëʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}