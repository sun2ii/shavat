{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Xantuʼ Dios, buzáʼ ladxiʼ queë́tuʼ, en ben ga gaca dxiʼa queë́tuʼ.","poem":1},{"lineBreak":true},{"text":"Lu yöl-laʼ dxiʼi ladxiʼ quiuʼ buyú netuʼ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"para gaca bëʼ le rë́ʼënuʼ guntuʼ yödzölió ni,","poem":1},{"lineBreak":true},{"text":"en para ilaʼnözi bönachi yúguʼtë yödzö ca naca yöl-laʼ rusölá quiuʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ral-laʼ ilaʼgúʼu bönachi Liʼ yöl-laʼ ba, Dios.","poem":1},{"lineBreak":true},{"text":"Yúguʼtë bönachi ral-laʼ ilaʼgúʼu Liʼ yöl-laʼ ba.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ral-laʼ uluʼdzeja bönachi yúguʼtë yödzö,","poem":1},{"lineBreak":true},{"text":"en ilúl-la lu yöl-laʼ rudzeja quéguequi.","poem":1},{"lineBreak":true},{"text":"Tuʼ uchiʼa usörö́uʼ bönachi ca naca le naca tsahuiʼ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ral-laʼ ilaʼgúʼu Liʼ yöl-laʼ ba bönachi, Dios.","poem":1},{"lineBreak":true},{"text":"Yúguʼtë bönachi ral-laʼ ilaʼgúʼu Liʼ yöl-laʼ ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yödxi yanaʼ runödzaj luyú ni.","poem":1},{"lineBreak":true},{"text":"Dios queë́ruʼ runëʼ ga raca dxiʼa queë́ruʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Runëʼ Dios ga raca dxiʼa queë́ruʼ,","poem":1},{"lineBreak":true},{"text":"para iladxi Lëʼ yúguʼtë nupa nacuáʼ yödzölió.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}