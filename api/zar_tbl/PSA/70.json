{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"¡Busölá nedaʼ, Dios!","poem":1},{"lineBreak":true},{"text":"¡Gudáchi gácalenuʼ nedaʼ, Xan!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ben ga uluʼtuíʼi, en ilaʼbö́ʼ böniga nupa naʼ të́ʼëni iluti nedaʼ.","poem":1},{"lineBreak":true},{"text":"Ben ga uluʼhuécja, en uluʼgáʼana cáʼasö nupa naʼ të́ʼëni gaca bi gaca quiaʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ben ga uluʼhuécja lu yöl-laʼ rutuíʼi quéguequi","poem":1},{"lineBreak":true},{"text":"nupa naʼ tuʼtitaj nedaʼ, taʼnná: “Ja, ja.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ben ga uluʼdzeja, en uluʼzíʼ xibóʼ yúguʼtë nupa tuʼguilaj Liʼ.","poem":1},{"lineBreak":true},{"text":"Ben ga iluíʼiticaʼsö didzaʼ nupa taʼdxíʼi yöl-laʼ rusölá quiuʼ, ilaʼnná:","poem":1},{"lineBreak":true},{"text":"“¡Zxö́ntërö náquiëʼ Dios!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nedaʼ nacuídiʼdaʼ, en bitiʼ bi gaca gunaʼ.","poem":1},{"lineBreak":true},{"text":"¡Gudáchi gácalenuʼ nedaʼ, Dios!","poem":1},{"lineBreak":true},{"text":"Nacuʼ Nu rácalen nedaʼ, en Nu rusölá nedaʼ.","poem":1},{"lineBreak":true},{"text":"¡Bitiʼ caʼ tsenuʼ guíduʼ quiaʼ, Xan!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}