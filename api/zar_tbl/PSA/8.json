{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"¡Xanaʼ Dios,","poem":1},{"lineBreak":true},{"text":"bicaʼ ba Loʼ idútë yödzölió!","poem":1},{"lineBreak":true},{"text":"¡Xitsáʼtërö ca lúzxiba nayë́pisuʼ Liʼ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Túl-labiʼ bíʼidoʼ, encaʼ biʼi huë́ʼënidoʼ yöl-laʼ zxön quiuʼ","poem":1},{"lineBreak":true},{"text":"sal-laʼ nacuáʼ nupa taʼdáʼbagaʼ Liʼ.","poem":1},{"lineBreak":true},{"text":"Uzóa dxíuʼ nupa naʼ bitiʼ taʼléʼe Liʼ dxiʼa, encaʼ nupa taʼdáʼbagaʼ Liʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cateʼ ruyúaʼ lúzxiba quiuʼ, le nunuʼ len xibö́n naʼzuʼ,","poem":1},{"lineBreak":true},{"text":"encaʼ beuʼ, en yuguʼ bölaj beníʼ nuzúʼ xilátjaguequi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"níʼirö rnníaʼ: ¿Bizxi caz bönniʼ, tuʼ röjné cazuʼ lëʼ?","poem":1},{"lineBreak":true},{"text":"¿Bizxi caz nu naca bönáchisö, tuʼ ruíʼi ládxuʼu Liʼ nu naʼ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nunuʼ ga naquiëʼ bönniʼ iaʼlatiʼ cuidiʼ ca naca cazuʼ Liʼ.","poem":1},{"lineBreak":true},{"text":"Nuzúʼ queëʼ yöl-laʼ ba quiuʼ, en yöl-laʼ run bal ca","poem":1},{"lineBreak":true},{"text":"tu le néquini oro dxía icjëʼ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nunuʼ ga rinná béʼenëʼ yuguʼ le nun cazuʼ Liʼ.","poem":1},{"lineBreak":true},{"text":"Yúguʼtë nuzúʼ xiniʼë lëʼ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuzúʼ xiniʼë yúguʼtëbaʼ böʼcuʼ zxilaʼ, en yúguʼtëbaʼ bëdxi,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"en lës caní nunuʼ caʼ quégacabaʼ biguínnidoʼ,","poem":1},{"lineBreak":true},{"text":"en quégacabaʼ böla dzö́ʼöbaʼ nísadoʼ,","poem":1},{"lineBreak":true},{"text":"encaʼ quégacabaʼ yúguʼtëbaʼ böaʼ taʼdö́dibaʼ lu nísadoʼ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Xanaʼ Dios,","poem":1},{"lineBreak":true},{"text":"bicaʼ ba loʼ idútë yödzölió!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}