{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"Zuínëʼ Dios ladaj nupa tuʼdubi queëʼ niʼ yehuaʼ yubá.","poem":1},{"lineBreak":true},{"text":"Ruchiʼa rusörö́ëʼ nupa taʼnná bëʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rnnëʼ: “¿Gácaʼxte caz uchiʼa usörö́liʼ quégaca bönachi","poem":1},{"lineBreak":true},{"text":"lu yöl-laʼ bitiʼ naca tsahuiʼ queë́liʼ?","poem":1},{"lineBreak":true},{"text":"Caní naca tuʼ rubéajliʼ tsahuiʼ nupa tuáʼ döʼ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buliʼbéaj tsahuiʼ nupa taʼcuidiʼ, en yuguʼ biʼi uzëbi.","poem":1},{"lineBreak":true},{"text":"Guliʼgún le naca tsahuiʼ quégaca nupa taʼguíʼi taʼzacaʼ,","poem":1},{"lineBreak":true},{"text":"en quégaca nupa taʼyadzaj taʼyudxi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buliʼsölá nupa taʼcuidiʼ, en nupa nácagaca yechiʼ.","poem":1},{"lineBreak":true},{"text":"Buliʼsölá léguequi lu náʼagaca nupa tuáʼ döʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bitiʼ nö́ziguequi, en bitiʼ taʼyéajniʼi.","poem":1},{"lineBreak":true},{"text":"Taʼdá ga chul-la.","poem":1},{"lineBreak":true},{"text":"Rizxizi xilibi yödzölió.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rnna cazaʼ nedaʼ: “Nácaliʼ ca yuguʼ dios.","poem":1},{"lineBreak":true},{"text":"Nácaliʼ yúguʼtëliʼ zxíʼinëʼ Dios nayë́pisëtërëʼ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pero gátiliʼ ca tati bönachi,","poem":1},{"lineBreak":true},{"text":"en ibíxiliʼ lu gudil-la ca taʼbixi zxíʼinëʼ bönniʼ lo.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Guyasa, Dios, en buchiʼa busörö́ quégaca bönachi yödzölió ni,","poem":1},{"lineBreak":true},{"text":"tuʼ nácagaca queë cazuʼ yúguʼtë yödzö bönachi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}