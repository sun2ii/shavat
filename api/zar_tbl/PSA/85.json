{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":85,"content":[{"type":"verse","number":1,"content":[{"text":"Buzáʼ ládxuʼu quégaca bönachi quiuʼ, Xantuʼ Dios.","poem":1},{"lineBreak":true},{"text":"Buchëʼu Liʼ zxíʼini xiʼsóëʼ Jacob gulaʼdzunëʼ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Buniti loʼ bönachi quiuʼ ca naca xiguiaʼ gulaʼbagaʼ.","poem":1},{"lineBreak":true},{"text":"Bucáchuʼu yuguʼ dul-laʼ gulúngaca.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Buzóa dxíuʼ yöl-laʼ rilé quiuʼ.","poem":1},{"lineBreak":true},{"text":"Bugúʼ yöl-laʼ ridzáʼa quiuʼ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Buzóa netuʼ xilátjatuʼ le yúbölö, Dios, Nu rusölá netuʼ,","poem":1},{"lineBreak":true},{"text":"en bítiʼrö lenuʼ netuʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Naruʼ tsaz ilenuʼ netuʼ?","poem":1},{"lineBreak":true},{"text":"¿Naruʼ tsaz ilenuʼ yuguʼ zxíʼini xsoatuʼ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Naruʼ cabí usubanuʼ ládxiʼtuʼ le yúbölö,","poem":1},{"lineBreak":true},{"text":"para udzeja ládxiʼlentuʼ Liʼ netuʼ, bönachi quiuʼ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lu yöl-laʼ dxiʼi ladxiʼ quiuʼ gúcalen netuʼ,","poem":1},{"lineBreak":true},{"text":"en busölá netuʼ, Xan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Uzë́ nagaʼ didzaʼ guʼë Xanruʼ Dios.","poem":1},{"lineBreak":true},{"text":"Le guíëʼ bönachi queëʼ gun ga gaca dxiʼa quéguequi,","poem":1},{"lineBreak":true},{"text":"nupa naʼ nácagaca quez queëʼ,","poem":1},{"lineBreak":true},{"text":"pero run bayúdx bitiʼ uluʼhuö́a ládxiʼgaca.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Le nácatë chizóëʼ usölë́ʼ nupa tun Lëʼ bal,","poem":1},{"lineBreak":true},{"text":"para soa yöl-laʼ ba queëʼ luyú queë́tuʼ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dzágagaca yöl-laʼ dxiʼi ladxiʼ, en le naca idútë li.","poem":1},{"lineBreak":true},{"text":"Tagu zxixi luzë́ʼeguequi nu naca tsahuiʼ, en nu riböza dxiʼa tsáhuiʼdoʼ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Luyú caz rilén le naca idútë li,","poem":1},{"lineBreak":true},{"text":"ateʼ yehuaʼ yubá rirúaj le naca tsahuiʼ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Le nácatë Xanruʼ unödzjëʼ queë́ruʼ le naca dxiʼa,","poem":1},{"lineBreak":true},{"text":"ateʼ xiyuruʼ unödzaj le uláparuʼ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Le naca tsahuiʼ röjnöru lahuëʼ Xanruʼ,","poem":1},{"lineBreak":true},{"text":"en gun ga soa nöza gátiʼtës ga ulibëʼ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}