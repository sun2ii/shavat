{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Nuzóëʼ Dios xilibi zöʼö que yödzö queëʼ lu guíʼa láʼayi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nadxíʼirönëʼ Xanruʼ lataj ga naʼ tuʼchiʼa tuʼsörö́ bönachi Sión","poem":1},{"lineBreak":true},{"text":"ca nadxíʼinëʼ iaʼzícaʼrö lataj gapa nacuáʼ bönachi Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zián le lachi taʼnná bönachi ca naca","poem":1},{"lineBreak":true},{"text":"yödz naʼ nequi queëʼ Dios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Cateʼ ulidzaʼ bönachi núnbëʼgaca nedaʼ, Dios,","poem":1},{"lineBreak":true},{"text":"ulidzaʼ bönachi nnítaʼgaca Egipto, en Babilonia.","poem":1},{"lineBreak":true},{"text":"Ca naca quégaca bönachi Filistea, en Tiro, en Etiopía","poem":1},{"lineBreak":true},{"text":"inníaʼ nabábagaca yödzö láʼayi naʼ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Cateʼ guʼa didzaʼ que yödzö Sión inníaʼ:","poem":1},{"lineBreak":true},{"text":"Bönachi ni, en bönachi izáʼa ni nabábagaca le,","poem":1},{"lineBreak":true},{"text":"ateʼ nedaʼ, Dios nayë́pisëtërëʼ, uzóaʼ tsutsu yödzö naʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Cateʼ ulabëʼ Xanruʼ nupa nácagaca queëʼ innë́ʼ:","poem":1},{"lineBreak":true},{"text":"“Bönniʼ ni nababëʼ yödzö quiaʼ.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Níʼirö iluíʼi didzaʼ nupa tul-la, en nupa tuʼcödxi gui, ilaʼná:","poem":1},{"lineBreak":true},{"text":"“Ruzíʼituʼ xibé tuzi yödzö ni.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}