{"translation":{"id":"zar_tbl","name":"Didza' cubi rucá'ana tsahui'","website":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zarNT","licenseNotes":null,"shortName":"TBL","englishName":"Rincón Zapotec NT","language":"zar","textDirection":"ltr","sha256":"6087f04d67d97db6b0c6affde4723a4e90945e6339abea27768205b77980b0cd","availableFormats":["json"],"listOfBooksApiLink":"/api/zar_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10391,"languageName":"Rincón Zapotec","languageEnglishName":"Rincón Zapotec"},"book":{"id":"PSA","translationId":"zar_tbl","name":"Salmos","commonName":"Salmos","title":"YUGUʼ SALMO","order":19,"numberOfChapters":150,"sha256":"b71fd5141d649fb50cfdc4889225d44e09c448f147b4b67773e3d1293a9b3418","firstChapterNumber":1,"firstChapterApiLink":"/api/zar_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zar_tbl/PSA/150.json","totalNumberOfVerses":2462},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"¡Rinná bëʼë Xanruʼ!","poem":1},{"lineBreak":true},{"text":"¡Nácuëʼ yöl-laʼ ba zxön queëʼ!","poem":1},{"lineBreak":true},{"text":"¡Nácuëʼ zxëʼ Xanruʼ, en núguiëʼ lëʼë yöl-laʼ unná bëʼ!","poem":1},{"lineBreak":true},{"text":"¡Nuzóëʼ tsutsu yödzölió, ateʼ bitiʼ utá cuini!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"¡Tsaz nuzúʼ tsutsu ga röʼu rinná bëʼu, Xan,","poem":1},{"lineBreak":true},{"text":"en zóaticaʼsuʼ Liʼ!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Riyasa ridxía nisa yuguʼ lu nísadoʼ, Xan.","poem":1},{"lineBreak":true},{"text":"Riyasa ridxía nisa, en ruʼu bö que.","poem":1},{"lineBreak":true},{"text":"Riyasa ridxía nisa yuguʼ lu nísadoʼ, en yuguʼ lu yegu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xanruʼ Dios yehuaʼ yubá nápatërëʼ yöl-laʼ unná bëʼ","poem":1},{"lineBreak":true},{"text":"ca bö ruʼu lu nísadoʼ le riyö́n ca guziúʼ rinnë́,","poem":1},{"lineBreak":true},{"text":"encaʼ ca le riyasa ridxía nisa lu nísadoʼ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tsaz naguixjuʼ xibá quiuʼ, Xan,","poem":1},{"lineBreak":true},{"text":"ateʼ idú láʼayi naca ga zoa cazuʼ Liʼ.","poem":1},{"lineBreak":true},{"text":"Caní zóaticaʼsö naʼa dza, en dza siʼ zaca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zar_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zar_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zar_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}