{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"¡Le gul-la lau Xránadxu Dios, le'e zrale du gabí'i xe̱zr la xu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Le gucá'ana szren Le̱' dute̱ xel-la' dxebé!","poem":1},{"lineBreak":true},{"text":"¡Le da lau Le̱', dxúl-lale dute̱ xel-la' dxebé!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cabata' gal-la lázrele naca Xránadxu Diósqueze.","poem":1},{"lineBreak":true},{"text":"Le̱' be̱ne̱' dxi'u, na' nácadxu chee̱ Le̱'.","poem":1},{"lineBreak":true},{"text":"Nácadxu xe̱zre chee̱', ne zríla'du chee̱'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le chu'u lataj naga zua xudau' chee̱', xe̱le Le̱': Xcalenu',","poem":1},{"lineBreak":true},{"text":"ne chale'aj chee̱ na, güe lá'anale Le̱'.","poem":1},{"lineBreak":true},{"text":"Le xe̱ Le̱': Xcalenu', ne le güe lá'ana Le̱'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chawe' naca Xránadxu, na' chadía chacanna zua","poem":1},{"text":"xel-la' zri'i lazre' chee̱'.","poem":2},{"text":"Xel-la' li lazre' chee̱' tu súazqueze na chadía chacanna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}