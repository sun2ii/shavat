{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"¡Le'e, we̱n zrin chee̱ Xránadxu Dios, le güe lá'ana Le̱'!","poem":1},{"lineBreak":true},{"text":"¡Le güe lá'ana La Xránadxu Dios!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Gaca ba lá'azxa La Xránadxu Dios,","poem":1},{"lineBreak":true},{"text":"na'a zra, ne chadía chacanna!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Naga dxalaj gubizra ca zrinte̱ naga dxebía na","poem":1},{"lineBreak":true},{"text":"gaca ba lá'azxa La Xránadxu Dios!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Szrente̱ nagá'ana Xránadxu Dios lawe' dute̱ xe̱zr la xu,","poem":1},{"lineBreak":true},{"text":"na' láwela xabáa dxe' da xabáa chee̱'!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Núzraqueze naca ca naca Xránadxu Dios,","poem":1},{"lineBreak":true},{"text":"Bénnea' dxe'e̱ xabáa na'la?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dios dxun cuine̱' dxexruj lazre' chee̱ lé'ene̱'","poem":1},{"lineBreak":true},{"text":"da de̱ zran xabáa, ne lu xe̱zr la xu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dios dxechise̱' benne' xache' lu xu xrte,","poem":1},{"lineBreak":true},{"text":"ne dxebéaje̱' benne' baxache' lu da dxezaca zi'e̱,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"na' dxune̱' dxelebé' benne' caní ládujla benne'","poem":1},{"text":"dxelenná be'e̱,","poem":2},{"text":"ládujla benne' ca' dxelenná bé'ene̱' bénneache chee̱'.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dxune̱' zua nu'ula zue̱' tuze ládujla zrí'inequeze̱' ca',","poem":1},{"lineBreak":true},{"text":"na' dxebé nu'ula nigá lawe' da naque̱' xrna bi cheé̱queze̱'.","poem":1},{"lineBreak":true},{"text":"¡Gaca ba lá'azxa Xránadxu Dios!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}