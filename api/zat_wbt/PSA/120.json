{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Gate guzúa' lu da ste̱be bláwizra' Xránadxu Dios,","poem":1},{"lineBreak":true},{"text":"na' Le̱' gúcale̱ne̱' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bselá neda', Xrana' Dios, lu na' benne' we̱n lazre' ca',","poem":1},{"lineBreak":true},{"text":"ne lu na' benne' dxelezí xe̱'e̱ ca'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Bizra gunna Dios le'e, benne' dxelezí xe̱'e̱?","poem":1},{"lineBreak":true},{"text":"¿Bizra da ba neza gaca na chee̱le gate gudée̱' le'e","poem":1},{"text":"lu da zi' da xa'?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gudée̱' le'e lu na' benne' ca' xuludé̱'e̱ le'e xaga nalá xéche'ze,","poem":1},{"lineBreak":true},{"text":"ne xuluzríe̱' le'e xi' galaj.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Edxugúa neda'.","poem":1},{"lineBreak":true},{"text":"Dxaca chia' ca zúaqueza' ládujla benne' Mesec,","poem":1},{"lineBreak":true},{"text":"ne ca zua' tu lu xu'u xide chee̱ benne' Cedar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Da zrente̱ ba guzúa' ládujla benne' caní","poem":1},{"lineBreak":true},{"text":"dxuluzúe̱' chalá'ala xel-la' dxebeza zri lazre'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Neda' dxezá lazra' gata' xel-la' dxebeza zri lazre'.","poem":1},{"lineBreak":true},{"text":"Gate dxuchálaja' chee̱n, dxeledíl-lale̱ benne' ca' neda'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}