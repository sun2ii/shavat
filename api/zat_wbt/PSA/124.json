{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"Chela ca gúcale̱ Xránadxu Dios dxi'u.","poem":1},{"lineBreak":true},{"text":"Caní dxal-la' xelenná benne' Israel ca' na'a.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chela ca gúcale̱ Xránadxu Dios dxi'u","poem":1},{"lineBreak":true},{"text":"gate guledíl-lale̱ benne' ca' dxi'u,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"na' buluzría xi'te̱' dxi'u","poem":1},{"lineBreak":true},{"text":"lu dute̱ xel-la' dxelezrá'a zrente̱ chee̱',","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ne guca chee̱dxu ca dxaca chee̱ benne'","poem":1},{"lineBreak":true},{"text":"dxugacu nísadau' le̱', da na' gute na le̱'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chela guca caní chee̱dxu, na' bé̱tete̱ da na' dxi'u.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dxal-la' xe̱dxu Xránadxu Dios; Xcalenu',","poem":1},{"lineBreak":true},{"text":"lawe' da quebe be̱'e̱ lataj benne' ca' xuluzría xi'e̱ dxi'u.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Beladxu ca dxelá tu bxinne lu xixruj chee̱ benne' wezén bxinne.","poem":1},{"lineBreak":true},{"text":"Bzria xi' Xránadxu xel-la' dxenná bea chee̱ benne' ca', na' beladxu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naca Xránadxu Dios Bénnea' dxácale̱ne̱' dxi'u,","poem":1},{"lineBreak":true},{"text":"Bénnea' bé̱nqueze̱' xabáa, ne xe̱zr la xu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}