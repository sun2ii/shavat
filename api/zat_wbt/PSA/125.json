{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Benne' ca' dxuluxrén lazre' Xránadxu Dios zaj naque̱' ca xi'a Sión,","poem":1},{"lineBreak":true},{"text":"da quebe nu seque' gutá, san tu chí'izqueze zua chacha na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ca zaj zua xi'a ca' da zaj naxechaj na Jerusalén,","poem":1},{"lineBreak":true},{"text":"zua Xránadxu Dios, dxuxúequeze̱' bénneache chee̱' na'a zra,","poem":1},{"text":"ne chadía chacanna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Quegá tu chí'izqueze xelenná bea benne' ca' dxelune̱'","poem":1},{"lineBreak":true},{"text":"da cale̱la lu xe̱zr la xu chee̱ benne' xrlátaje ca',","poem":1},{"lineBreak":true},{"text":"chee̱ quebe xelaca benne' xrlátaje ca' tuze nen benne'","poem":1},{"text":"we̱n da zrinnaj ca'.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Xrana' Dios, be̱n gaca chawe' chee̱ benne' xrlátaje ca',","poem":1},{"lineBreak":true},{"text":"ne chee̱ benne' ca' zaj naque̱' li lazre'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Benne' ca' dxelebéaj xichaj Dios chee̱ xelune̱' da cale̱la,","poem":1},{"lineBreak":true},{"text":"xucuasa Xránadxu Dios benne' ca' tu zren nen benne' ca'","poem":1},{"text":"dxelune̱' da zrinnaj.","poem":2},{"text":"Dxenaba' gata' xel-la' dxebeza zri lazre' chee̱ benne' Israel ca'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}