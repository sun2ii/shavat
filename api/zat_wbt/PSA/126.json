{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Gate Xránadxu Dios bselé̱' dxi'u lu na' benne' zitu' ca',","poem":1},{"lineBreak":true},{"text":"ne begu'e̱ dxi'u lu xe̱zre Sión, gúquedxu dxenne̱dxu xe̱la.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nadxa bzrízredxu, ne be̱ lá'anadxu Xránadxu Dios.","poem":1},{"lineBreak":true},{"text":"Nadxa gulenná benne' xe̱zr la xu ca':","poem":1},{"lineBreak":true},{"text":"“Da zrente̱ ca' be̱n Dios, Xrana benne' ca', chee̱'.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Da zrente̱ ca' be̱n Xránadxu Dios chee̱dxu dxi'u,","poem":1},{"lineBreak":true},{"text":"na' zúadxu lu da ba neza zrente̱.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bselá Xránadxu dxi'u lu na' benne' zitu' ca',","poem":1},{"lineBreak":true},{"text":"na' bezrindxu lu xe̱zr la xu chee̱dxu","poem":1},{"lineBreak":true},{"text":"ca dxezrín nisa guba'u lu xe̱gu bizre ca'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Benne' ca' dxelebezre̱' tie̱' dxelaze̱',","poem":1},{"lineBreak":true},{"text":"nen xel-la' dxelebé xelexezi'e̱ lina.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dxebezre tie̱' zéaje̱' nu'e̱ binne cháwe'du ca',","poem":1},{"lineBreak":true},{"text":"na' dute̱ xel-la' dxebé dxezrine̱' zeajnu'e̱ lina chee̱'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}