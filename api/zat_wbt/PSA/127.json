{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Chela ca zúale̱ Xránadxu Dios benne' ca' dxelune̱' tu xu'u","poem":1},{"lineBreak":true},{"text":"dácheze naca xelune̱' zrin na'.","poem":1},{"lineBreak":true},{"text":"Chela ca dxuxúe Xránadxu Dios tu xe̱zre,","poem":1},{"lineBreak":true},{"text":"dácheze naca dxuluxúe benne' ca' le̱ na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dácheze naca dxásaze̱le che zílala,","poem":1},{"lineBreak":true},{"text":"ne dxunle zrin cáte̱ze dxalaj gubizra ca dxebíadxa na,","poem":1},{"lineBreak":true},{"text":"ne dute̱ xel-la' dxudía dxezile da gágule,","poem":1},{"lineBreak":true},{"text":"lawe' da dxunna Dios da xelagu benne' ca' nazrí'ine̱'","poem":1},{"text":"dxácate̱ na' dxelásie̱'.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Le nna' xque, zaj naca zrí'inedxu bi ca' be̱nna Xránadxu dxi'u.","poem":1},{"lineBreak":true},{"text":"Zaj naca be̱' tu da gunní'a zrente̱.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zrí'inedxu dxelálajbe' chee̱dxu gate ne nácadxu cuide'","poem":1},{"lineBreak":true},{"text":"zaj nácabe' ca xaga nalá xéche'ze ca' da nuxru benne'","poem":1},{"text":"zeje̱' wedil-la.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ba neza zrente̱ naca na chee̱ bénnea' nuxrue̱' zánete̱","poem":1},{"text":"xaga nalá xéche'ze caní.","poem":2},{"text":"Québequeze xedué'ene̱' gate zri'a chee̱'","poem":1},{"lineBreak":true},{"text":"tu zren nen benne' ca' dxeledíl-lale̱ne̱' le̱'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}