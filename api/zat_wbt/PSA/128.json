{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Ba neza zrente̱ naca na chee̱ benne' ca' dxelezrebe̱' Xránadxu Dios,","poem":1},{"lineBreak":true},{"text":"benne' ca' tu dxelúnzqueze̱' ca nadxixruj be'e Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gate dxagu' da dxezi'u chee̱ zrin da nunu'","poem":1},{"lineBreak":true},{"text":"gaca chiu' tu da ba neza, ne gaca chawe' chiu'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gaca zru'ulu' ca tu lba uva da dxebía da zixre","poem":1},{"text":"cuita xu'u lizru',","poem":2},{"text":"na' zri'inu' ca' xelácabe' ca xaga olivo ca' zaj ze̱","poem":1},{"text":"dxu'a ga dxagu'.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Caní gun Xránadxu gaca chawe' chee̱ bénnea' dxezrebe̱' Le̱'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dxenaba' gun Xránadxu, zue̱' xi'a Sión, gaca chawe' chiu',","poem":1},{"lineBreak":true},{"text":"chee̱ le'enu' gaca chawe' chee̱ xe̱zre Jerusalén xúgute̱ zra naca banu',","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ne chee̱ le'enu' zri'ine zre su'.","poem":1},{"lineBreak":true},{"text":"Dxenaba' gata' xel-la' dxebeza zri lazre' chee̱ benne' Israel ca'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}