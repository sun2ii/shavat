{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Zúadxu lu da sté̱bele̱'e̱ gate nácate̱dxu cuide',","poem":1},{"lineBreak":true},{"text":"waca xelenná benne' Israel ca'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zúadxu lu da sté̱bele̱'e̱ gate nácate̱dxu cuide'","poem":1},{"lineBreak":true},{"text":"san quebe buluzria xi'e̱ dxi'u.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Belune̱' we̱' cúzrudxu gate beline̱' dxi'u xide,","poem":1},{"lineBreak":true},{"text":"na' gulaca cúzrudxu ca xe̱zr la xu naga dxedé xia chee̱ be̱zre.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xlátaje̱ naca Xránadxu Dios.","poem":1},{"lineBreak":true},{"text":"Bselé̱' dxi'u lu na' benne' ca' buluchínene̱' dxi'u xadíaze.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be̱n cheajlechaze, ne xelebígaqueze","poem":1},{"lineBreak":true},{"text":"xúgute̱ benne' ca' dxelecuídene̱' benne' Sión ca'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Be̱n xelaque̱' ca xíxre'du ca' dxelebía na xrgu'u","poem":1},{"lineBreak":true},{"text":"da dxelebizre na gate ne zaj nadxé'ene na,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"da na' quebe nu benne' dxexequé̱'e̱ na,","poem":1},{"lineBreak":true},{"text":"ne quebe seque' nu benne' gune̱' na tu cheaj weaj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quebe xelenná benne' dxeledée̱' naga zaj zria na:","poem":1},{"lineBreak":true},{"text":"Dxenábantu' gun Xránantu' Dios gaca chawe' chee̱le.","poem":1},{"lineBreak":true},{"text":"Lu La Xránantu' Dios dxenábantu' gaca chawe' chee̱le.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}