{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"¿Ájate̱queze gal-la lazru' neda', Xran?","poem":1},{"lineBreak":true},{"text":"¿Gal-la lázrtequezu' neda'?","poem":1},{"lineBreak":true},{"text":"¿Ájatequeze quebe le'enu' da dxaca chia'?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Ájatequeze gun na ba xen guchaga lawa' da dxezaca'?","poem":1},{"lineBreak":true},{"text":"¿Ájatequeze gaca wi'ine lazra' te zra, ne chizrela?","poem":1},{"lineBreak":true},{"text":"¿Ájatequeze nna be'e benne' dxedábague̱' Lue' neda'?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gunná' da dxaca chia', Xran, ne beche̱be chia'.","poem":1},{"lineBreak":true},{"text":"Btipa lazra' chee̱ quebe gatia',","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ne chee̱ quebe nna benne' dxedábague̱' neda':","poem":1},{"text":"“Ba be̱tia' ni'a ne̱'e̱.”","poem":2},{"text":"Benne' ca' dxeledábague̱' neda' xelebene̱'","poem":1},{"text":"che cheajcházia' lu da cale̱la.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neda' dxuxrén lazra' Lue' xexache lazru' neda'.","poem":1},{"lineBreak":true},{"text":"Dute̱ lázrdawa' dxebeda' lawe' da dxuseláu' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gúl-laqueza' chee̱ Xrana' Dios","poem":1},{"lineBreak":true},{"text":"lawe' da ba nune̱' chia' da xrlátaje.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}