{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Ga ni zua' lu da sté̱bele̱'e̱ dxuláwizra' Lue', Xrana' Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Xran, bene chi'a!","poem":1},{"lineBreak":true},{"text":"¡Bze̱ naga da dxenaba' lau'!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xrana' Dios, chela nna' xánniu' ca naca dul-la nabágantu'","poem":1},{"lineBreak":true},{"text":"¿núzraqueze xegá'ana xrlátaje lau Lue'?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lué'quezu' dxunite lau' chee̱ntu'","poem":1},{"lineBreak":true},{"text":"chee̱ gápantu' Lue' ba lá'ana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dute̱ lázrdawa' dxebeza lazra' Xránadxu Dios,","poem":1},{"lineBreak":true},{"text":"ne dxuxrén lazra' xrtizre̱'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dxebeza lazredxa' Xránadxu Dios","poem":1},{"lineBreak":true},{"text":"cáqueze dxelún benne' ca' dxuluxúe̱' xe̱zre ca',","poem":1},{"text":"dxelebeze̱' chaní',","poem":2},{"text":"ne cáqueze dxelún benne' ca' dxelicha bchigala,","poem":1},{"text":"dxelebeze̱' chaní'.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Benne' Israel ca' dxal-la' xelebeza lazre̱' Xránadxu Dios","poem":1},{"lineBreak":true},{"text":"lawe' da dxexache lazre' Xránadxu bénneache chee̱',","poem":1},{"lineBreak":true},{"text":"ne dxexá'awe̱' benne' ca' lu na' benne' guledábague̱' Le̱'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dios xexá'awe̱' benne' Israel ca'","poem":1},{"lineBreak":true},{"text":"lu na' xúgute̱ dul-la da zaj nabague̱'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}