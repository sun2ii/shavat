{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"Xrana' Dios, ba bsana' xel-la' dxucá'ana szren cuina',","poem":1},{"lineBreak":true},{"text":"ne ba bcuasa' xel-la' dxeque xrlátaje cuina'.","poem":1},{"lineBreak":true},{"text":"Quebe dxulapa napa' lu da zaj naca szren,","poem":1},{"lineBreak":true},{"text":"da ca' quebe naca chia' gulapa' na'a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Quebe bi gunnía', ne guzúa' zrize ca tu bi dxe'ene","poem":1},{"text":"za bexuzrte̱ gúzrebe'.","poem":2},{"text":"Naca bénne'du xu'a ca tu bi dxe'ene za bexuzrte̱ gúzrebe'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Le cueza lazre' Xránadxu Dios, le'e, benne' Israel","poem":1},{"lineBreak":true},{"text":"na'a zra, ne chadía chacanna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}