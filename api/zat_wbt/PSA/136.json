ana Dios na', be̱ne̱' xabáa dute̱ xel-la' sina chee̱'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios na', bzue̱' xe̱zr la xu lawe' nísadau'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios na', be̱ne̱' gubizra ne beu'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Be̱ne̱' gubizra chee̱ gusení na te zra!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Be̱ne̱' beu' ne belaj ca' chee̱ xulusení na chizrela!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios na', be̱tie̱' bi biu nedxu chee̱","poem":1},{"text":"benne' Egipto ca'!","poem":2},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios na', bebéaje̱' benne' Israel ca'","poem":1},{"text":"lu xe̱zr la xu Egipto na'!","poem":2},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Beche̱'e̱ le̱' dute̱ xel-la' waca zren chee̱'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios na', be̱ne̱' chupa la'a nísadau'","poem":1},{"text":"da nazí le̱ na Xrna!","poem":2},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Bdee̱' benne' Israel ca' laduj nísadau' na'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Bgacue̱' nísadau' na' Faraón, benne' wenná bea chee̱ Egipto,","poem":1},{"text":"ne benne' zeje̱' wedil-la chee̱' ca'!","poem":2},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios na', beche̱'e̱ benne' chee̱' ca'","poem":1},{"text":"le̱'e̱ xixre' lawe' lataj!","poem":2},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios na', be̱tie̱' wenná bea blau ca'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Be̱tie̱' wenná bea wal-la ca'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¡Be̱tie̱' Sehón, wenná bea chee̱ benne' amorreo ca'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¡Be̱tie̱' Og, wenná bea chee̱ xe̱zr la xu Basán!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¡Bnézruje̱' xe̱zr la xu chee̱ benne' ca' chee̱ gaca na","poem":1},{"text":"chee̱ benne' chee̱' ca'!","poem":2},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Be̱nne̱' na chee̱ benne' Israel ca', benne' we̱n zrin chee̱' ca'!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"¡Naque̱' Dios na', quebe gul-la lazre̱' dxi'u","poem":1},{"text":"gate buluzetja benne' ca' dxi'u!","poem":2},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"¡Le̱' bselé̱' dxi'u lu na' benne' ca' guledíl-lale̱ne̱' dxi'u!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"¡Naque̱' Dios na', dxugawe̱' xúgute̱ da zaj naca ban!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"¡Le güe lá'ana Dios chee̱ xabáa!","poem":1},{"lineBreak":true},{"text":"¡Chadía chacanna dxexache lazre̱' dxi'u!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}