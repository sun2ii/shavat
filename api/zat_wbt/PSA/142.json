{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"Zizraj dxuláwizra' Xránadxu Dios.","poem":1},{"lineBreak":true},{"text":"Du lazra' dxenaba' Xránadxu xexache lazre̱' neda'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lau Le̱' dxawa' zría ca da dxaca chia'.","poem":1},{"lineBreak":true},{"text":"Lau Le̱' dxulé'eda' ca da ste̱be zua' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gate zua lázrdawa' lu da ste̱be, Lue', Xran, nézenu'","poem":1},{"text":"da dxaca chia'.","poem":2},{"text":"La neza naga dxedá' gulebeque̱' xralaj da que̱l-la na neda'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dxenná'a cuita' xabe̱la, san quebe nu chilá' gácale̱ neda'.","poem":1},{"lineBreak":true},{"text":"Quebe nu chilá', benne' guxúequeze̱' neda'.","poem":1},{"lineBreak":true},{"text":"Quebe nu chilá', benne' dxe' gunna xue̱' chia' neda'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dxuláwizra' Lue', Xrana' Dios, dxennia':","poem":1},{"lineBreak":true},{"text":"Dxebeza lazra' tuzu' Lue'.","poem":1},{"lineBreak":true},{"text":"Tuzu' Lue' dxezá lazra' lu xe̱zr la xu nigá.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bene da dxuláwizra' Lue', lawe' da dxezaca zí'le̱'a.","poem":1},{"lineBreak":true},{"text":"Bselá neda' lu na' benne' ca' dxeláu zi' xuzre̱' neda',","poem":1},{"lineBreak":true},{"text":"lawe' da zaj naque̱' wál-ladxa ca neda'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bebéaj neda' lu da dxaca chia', chee̱ gaca güe lá'ana' Lue'.","poem":1},{"lineBreak":true},{"text":"Benne' xrlátaje ca' xeléchaje̱' neda' lawe' da gunu' gaca chawe' chia'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}