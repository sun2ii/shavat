{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"Xran, ¿núzraqueze benne' sue̱' naga zu' Lue'?","poem":1},{"lineBreak":true},{"text":"¿Núzraqueze benne' sue̱' naga naca lá'azxa chiu'?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Waca bénnea' naque̱' du lazre', ne dxune̱' da xrlátaje,","poem":1},{"lineBreak":true},{"text":"bénnea' zua da líqueze lu xichaj lázrdawe̱',","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"bénnea' quebe dxenné̱' chee̱ le sa' ljwezre̱',","poem":1},{"lineBreak":true},{"text":"ne quebe bi da cale̱la dxune̱' chee̱ le sa' ljwezre̱',","poem":1},{"lineBreak":true},{"text":"ne quebe dxu'e̱ lataj nu benne' si tizre̱' le sa' ljwezre̱'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waca bénnea' quebe dxape̱' ba lá'ana","poem":1},{"text":"nu benne' dxune̱' da sban.","poem":2},{"text":"Dxape̱' ba lá'ana benne' ca' dxelape̱' ba lá'ana Xránadxu Dios,","poem":1},{"lineBreak":true},{"text":"bénnea' quebe dxuché̱'e̱ dizra' da ba gunné̱' lácala bi da' gunítie̱'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waca bénnea' dxusane̱' dumí chee̱' ne quebe dxenabe̱' xíchaje̱n,","poem":1},{"lineBreak":true},{"text":"ne quebe dxezí' lu ne̱'e̱ dumí chee̱ nnie̱' chee̱","poem":1},{"text":"nu benne' quebe bi zria nabague̱'.","poem":2},{"text":"Nu benne' dxune̱' caní cabata' cheajchazie̱' lu da cale̱la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}