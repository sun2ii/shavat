{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Xránadxu Dios dxuxúe̱' neda' ca tu benne' dxuxúe̱' zrila' chee̱'.","poem":1},{"lineBreak":true},{"text":"Quebe bi dxexázrjeda'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ca dxelezrúa zríla'du ca' ba guláguba' xixre' xá'adau',","poem":1},{"lineBreak":true},{"text":"caní dxune̱' chia' chee̱ xezí' lazra'.","poem":1},{"lineBreak":true},{"text":"Gune̱' chia' ca dxaca chee̱ zrila' ca'","poem":1},{"text":"dxeché̱'e̱-ba' dxu'a xe̱gu nisa da de̱ zrize.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dxuxuzúa chúchue̱' neda' lu xichaj lázrdawa'.","poem":1},{"lineBreak":true},{"text":"Dxusi'e̱ neda' lu da xrlátaje chee̱ gaca li da guche̱be lazre̱'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Láqueze tea' naga sua' lu da ste̱be chee̱ xel-la' gute,","poem":1},{"lineBreak":true},{"text":"quebe bi da cale̱la guchebe na neda',","poem":1},{"lineBreak":true},{"text":"lawe' da zúale̱nu' Lue' neda', Xran,","poem":1},{"lineBreak":true},{"text":"na' dxelácale̱ zrise', ne blazru chiu' neda'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dxucuezu' da xi'aj gawa' lácala benne'","poem":1},{"text":"dxeledábague̱' neda' zaj naxechaj neda'.","poem":2},{"text":"Dxugú'u da za xichja' da dxapa na neda' ba lá'ana,","poem":1},{"lineBreak":true},{"text":"ne dxusezráteu' zriga' chia'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Da xrlátaje, ne xel-la' dxexache lazre' chiu'","poem":1},{"lineBreak":true},{"text":"da lítegaze xelezúale̱ na neda' xúgute̱ zra naca bana',","poem":1},{"lineBreak":true},{"text":"na' lizru', Dios, gaca na lizra' chadía chacanna.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}