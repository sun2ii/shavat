{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Xrana' Dios, ba naxánle̱'e̱ benne' dxeledábague̱' neda'.","poem":1},{"lineBreak":true},{"text":"Benne' zante̱ dxeledíl-lale̱ne̱' neda'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Benne' zante̱ dxelenné̱' chia': “Quebe guselá Dios le̱'.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lue', Xrana' Dios, dxucú'uju' neda'.","poem":1},{"lineBreak":true},{"text":"Nacu' Benne' dxebéle̱na', ne Benne' dxuzé̱ chawe̱' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gudxezre xa'a, bláwizra' Xrana' Dios,","poem":1},{"lineBreak":true},{"text":"na' Le̱' beche̱be̱' chia' naga zue̱' lu xi'a lá'azxa chee̱'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Guta', ne gusia',","poem":1},{"lineBreak":true},{"text":"na' bebana' lawe' da nuxru Xrana' neda'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quebe zreba' gaxúa gaxúa bénneache,","poem":1},{"lineBreak":true},{"text":"benne' zaj naxéchaje̱' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Guzé̱, Xrana' Dios.","poem":1},{"lineBreak":true},{"text":"Bselá neda', Dios chia'.","poem":1},{"lineBreak":true},{"text":"Be̱n we̱' xraga benne' ca' dxeledíl-lale̱ne̱' neda',","poem":1},{"lineBreak":true},{"text":"ne guzuzruj lazxa benne' xriwe̱' ca'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xel-la' weselá za' lu na'u, Xrana' Dios.","poem":1},{"lineBreak":true},{"text":"Be̱n da chawe' chee̱ bénneache chiu'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}