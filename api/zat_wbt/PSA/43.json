{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Bchi'a chia', Dios, ne ble'e lau naca' xrlátaje.","poem":1},{"lineBreak":true},{"text":"Bselá neda' lu na' benne' ca' dxuluzúe̱' Lue' chalá'ala,","poem":1},{"lineBreak":true},{"text":"ne lu na' benne' ca' dxelezí xe̱'e̱, ne dxelune̱' da zrinnaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nacu' Lue' Dios chia', ne dxuzé̱ chuchu' neda'.","poem":1},{"lineBreak":true},{"text":"¿Bizr chee̱ na' nusán lazru' neda'?","poem":1},{"lineBreak":true},{"text":"¿Bizr chee̱ na' dxewí'ine lazra' lawe' da dxusaca zi' neda'","poem":1},{"text":"benne' ca' dxeledábague̱' neda'?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gusel-la chia' xel-la' naxaní' chiu', ne da li chiu'.","poem":1},{"lineBreak":true},{"text":"Da caní xulusí na neda' neza.","poem":1},{"lineBreak":true},{"text":"Xeleché̱ na neda' lu xi'a lá'azxa chiu', ne naga zúaquezu' Lue'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chu'a naga zua lucugu chee̱ Dios.","poem":1},{"lineBreak":true},{"text":"Chu'a lau Dios, Bénnea' dxune̱' dxebeda', na' zua' lu da ba neza.","poem":1},{"lineBreak":true},{"text":"Güe lá'ana' Lue' nen da zríadi'i na du, Dios chia'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Bizr chee̱ na' dxate ni'a na'u, bénne'du xu'a?","poem":1},{"lineBreak":true},{"text":"¿Bizr chee̱ na' zu' ste̱be lu xichaj lázrdawa'?","poem":1},{"lineBreak":true},{"text":"Guleza lazre' Dios lawe' da güe lá'anaqueza' Le̱' da xula.","poem":1},{"lineBreak":true},{"text":"Naque̱' Benne' dxuselé̱' neda', ne Dios chia'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}