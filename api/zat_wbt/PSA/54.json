{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Bselá neda', Dios, nen xel-la' waca chiu'.","poem":1},{"lineBreak":true},{"text":"Gúcale̱ neda', Dios, nen xel-la' wal-la chiu'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bene da dxenaba' lau', Dios, ne beche̱be chia'.","poem":1},{"lineBreak":true},{"text":"Bze̱ naga da guchálajle̱na' Lue'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Za'aca benne' snia ca' xeledíl-lale̱ne̱' neda'.","poem":1},{"lineBreak":true},{"text":"Benne' xichaj zra'a ca' dxelaca lazre̱' xelútie̱' neda',","poem":1},{"lineBreak":true},{"text":"benne' ca' quebe dxelape̱' ba lá'ana Lue', Dios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dios naque̱' Benne' dxácale̱ne̱' neda'.","poem":1},{"lineBreak":true},{"text":"Xránadxu Dios zúale̱ne̱' benne' ca' dxuluxúe̱' neda'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ca naca da cale̱la dxelún benne' dxeledábague̱' neda',","poem":1},{"text":"xuzrí'i Dios na chee̱ benne' ca'.","poem":2},{"text":"Guzría xi'e̱ benne' ca' lawe' da naque̱' li lazre'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Du lazra' cu'a da gudéa' lau Lue', Xran.","poem":1},{"lineBreak":true},{"text":"Güe lá'anaqueza' Lau' lawe' da nácale̱'e̱ na xrlátaje.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bseláu' neda' lu xúgute̱ da ste̱be guzúa'.","poem":1},{"lineBreak":true},{"text":"Ble'eda' gulebía xi' benne' ca' dxeledábague̱' neda'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}