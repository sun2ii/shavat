{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Dios, bexache lazre' netu', ne be̱n da chawe' chee̱ntu'.","poem":1},{"lineBreak":true},{"text":"Dute̱ xel-la' zri'i lazre' chiu' guzúale̱ netu',","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"chee̱ xelúnbea bénneache du gabí'i xe̱zr la xu","poem":1},{"text":"ca naca da dxaca lazru',","poem":2},{"text":"ne chee̱ xeleneze bénneache dute̱ xe̱zr la xu","poem":1},{"text":"ca dxuseláu' bénneache.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Xúgute̱ bénneache dxelúe lá'ane̱' Lue', Dios.","poem":1},{"lineBreak":true},{"text":"Dxelúe lá'ana xúgute̱ bénneache Lue'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Le be, ne le sua lu da ba neza, le'e, bénneache dute̱ xe̱zr la xu,","poem":1},{"lineBreak":true},{"text":"lawe' da guchi'a Dios chee̱le ca naca da xrlátaje,","poem":1},{"text":"ne guxúequeze̱' xúgute̱ bénneache.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xúgute̱ bénneache dxelúe lá'ane̱' Lue', Dios.","poem":1},{"lineBreak":true},{"text":"Dxelúe lá'ana xúgute̱ bénneache Lue'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Xe̱zr la xu nigá ba zria na lina chee̱ na,","poem":1},{"lineBreak":true},{"text":"lawe' da be̱n Dios chee̱dxu da chawe' chee̱dxu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dios ba be̱ne̱' chawe' chee̱dxu,","poem":1},{"lineBreak":true},{"text":"na' gátete̱ze dxal-la' xelapa bénneache Le̱' ba lá'ana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}