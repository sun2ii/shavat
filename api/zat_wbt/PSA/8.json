{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Lue' Dios, Xránantu', zrente̱ naca Lau' du gabí'i xe̱zr la xu.","poem":1},{"lineBreak":true},{"text":"Zrendxa naca xel-la' szren chiu' ca xabáa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bidu ca', ne bidu dxe'ene ca' dxelúl-labe' ca naca na.","poem":1},{"lineBreak":true},{"text":"Zúaquezu' lataj chawe' naga quebe xelezrín benne' ca'","poem":1},{"text":"dxeledábague̱' lue'.","poem":2},{"text":"Dxuzúa zriu' benne' dxeledábague̱' lue',","poem":1},{"text":"ne benne' dxelecuídene̱' Lue'.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gate dxenná'a xabáa da nunu' Lue',","poem":1},{"lineBreak":true},{"text":"ne beu', ne belaj ca', da ca' nuzú' cha chee̱ na,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"na' dxuche̱ba': “¿Ájazra naca bénneache, dxulaba lazru' chee̱ le̱'?","poem":1},{"lineBreak":true},{"text":"¿Ájazra naca bénneache, dxe'u gunne xue le̱'?”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Be̱nu' le̱' látezdxa szren ca nacu' Lué'queze,","poem":1},{"lineBreak":true},{"text":"ne bzu' chee̱' xel-la' szren, ne xel-la' ba lá'ana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Be̱nu' dxenná bé'ene̱' xúgute̱ da ca' nunu'.","poem":1},{"lineBreak":true},{"text":"Xúgute̱ na bdeu' lu ne̱'e̱,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"zrila' ca', ne be̱zre ca',","poem":1},{"lineBreak":true},{"text":"ne xúgute̱ be̱ xixre' ca',","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"be̱ zaj zua xrila, ne bela ca',","poem":1},{"lineBreak":true},{"text":"ne xúgute̱ da zaj zua na lu nísadau'.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xránantu', Dios,","poem":1},{"lineBreak":true},{"text":"szrente̱ naca Lau' du gabí'i xe̱zr la xu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}