{"translation":{"id":"zat_wbt","name":"Xela wezria cube nen salmo caʼ","website":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zatNTps","licenseNotes":null,"shortName":"WBT","englishName":"Tabaa Zapotec NT & Psalms","language":"zat","textDirection":"ltr","sha256":"86710bd086f0e42ce8013a6a898c786537edff4b4fd39a78a695506ae348ff1e","availableFormats":["json"],"listOfBooksApiLink":"/api/zat_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10406,"languageName":"Tabaa Zapotec","languageEnglishName":"Tabaa Zapotec"},"book":{"id":"PSA","translationId":"zat_wbt","name":"Salmos","commonName":"Salmos","title":"SALMO CA'","order":19,"numberOfChapters":150,"sha256":"7eb4da5a4db387be7d1965c8940fff5b546b12bae38537a275e767a93eaf4d21","firstChapterNumber":1,"firstChapterApiLink":"/api/zat_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zat_wbt/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Xránadxu Dios naque̱' Wenná Bea,","poem":1},{"lineBreak":true},{"text":"ne nacue̱' zra lane̱' da zácale̱'e.","poem":1},{"lineBreak":true},{"text":"Nácue̱' zra lane̱', ne da nagú'u le̱'e̱ naca na xel-la' waca zren.","poem":1},{"lineBreak":true},{"text":"Nuzúa chúchue̱' xe̱zr la xu nigá, na' quebe nu seque' gutá na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lataj naga dxe'u dxenná be'u, Xran,","poem":1},{"lineBreak":true},{"text":"zua chuchu na nédxudaute̱,","poem":1},{"lineBreak":true},{"text":"na' Lue' zúaquezu' chadía chacanna.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dxelebezre xa'a xe̱gu ca', Xran.","poem":1},{"lineBreak":true},{"text":"Dxelebezre xa'a na, ne dxelenné̱ na zizraj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Xránadxu, Bénnea' zue̱' xabáa nápadxe̱' xel-la' waca","poem":1},{"lineBreak":true},{"text":"ca da zaj napa xe̱gu ca' dxelebezre xa'a na,","poem":1},{"lineBreak":true},{"text":"ne ca da zaj napa xeajxruza chee̱ nísadau'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chúchule̱'e̱ zaj naca da nadxixru be'u, Xran.","poem":1},{"lineBreak":true},{"text":"Lá'azxa nácaqueze xudau' chiu' chadía chacánnaqueze.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zat_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zat_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zat_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}