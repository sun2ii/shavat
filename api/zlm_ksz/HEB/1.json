{"translation":{"id":"zlm_ksz","name":"Kitab Suci Zabur dan Injil","website":"https://ebible.org/Scriptures/details.php?id=zlmKSZI","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zlmKSZI","licenseNotes":null,"shortName":"KSZ","englishName":"Contextualized Malay NT","language":"zlm","textDirection":"ltr","sha256":"a15e802deae4a923cb75292ce2b7c704fc8b4551331770e4014120648e5c3a0a","availableFormats":["json"],"listOfBooksApiLink":"/api/zlm_ksz/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"Malay (individual language)","languageEnglishName":"Malay (individual language)"},"book":{"id":"HEB","translationId":"zlm_ksz","name":"Ibrani","commonName":"Ibrani","title":"Ibrani","order":58,"numberOfChapters":13,"sha256":"38a6c3f9fbaad114639fa423348947206adb5e8b7c2cdbb2032f42f48af5ae13","firstChapterNumber":1,"firstChapterApiLink":"/api/zlm_ksz/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/zlm_ksz/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Allah berfirman melalui Putera-Nya"]},{"type":"verse","number":1,"content":["Allah telah berfirman pada pelbagai zaman dan dengan aneka cara kepada nenek moyang kita melalui nabi-nabi."]},{"type":"verse","number":2,"content":["Tetapi pada akhir zaman ini Allah telah berfirman kepada kita melalui Putera-Nya, yang telah dijadikan-Nya pewaris kepada segala-galanya; melalui Putera-Nya itu Allah telah mencipta alam semesta."]},{"type":"verse","number":3,"content":["Putera itu adalah sinar gemilang kemuliaan Allah dan gambaran sempurna kewujudan-Nya. Dia memelihara segala-segalanya dengan kekuasaan firman-Nya. Setelah menghapuskan dosa kita melalui diri-Nya sendiri, Dia duduk di sebelah kanan Yang Maha Mulia yang bertakhta di syurga."]},{"type":"verse","number":4,"content":["Diri-Nya jauh lebih baik daripada para malaikat; kerana melalui warisan, Dia telah mendapat nama yang lebih cemerlang daripada mereka."]},{"type":"verse","number":5,"content":["Kepada malaikat manakah Allah pernah berfirman:",{"lineBreak":true},{"text":"‘Engkau Putera-Ku,","poem":1},{"text":"pada hari ini Aku menjadi Bapa-Mu’?","poem":2},{"lineBreak":true},"Dan juga:",{"lineBreak":true},{"text":"‘Aku akan menjadi Bapa-Nya,","poem":1},{"text":"dan Dia akan menjadi Putera-Ku’?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Selanjutnya, apabila Allah menghantar semula putera sulung-Nya ke dalam dunia maka firman-Nya:","poem":1},{"lineBreak":true},{"text":"‘Hendaklah semua malaikat Allah menyembah-Nya.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Dan tentang para malaikat, Dia berfirman:",{"lineBreak":true},{"text":"‘Dia menjadikan para malaikat-Nya angin,","poem":1},{"text":"dan para pelayan-Nya nyala api.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Tetapi tentang Putera itu Dia berfirman:",{"lineBreak":true},{"text":"‘Takhta-Mu, Ya Allah,","poem":1},{"text":"kekal selama-lamanya;","poem":2},{"lineBreak":true},{"text":"Tongkat kebenaran adalah tongkat","poem":2},{"lineBreak":true},{"text":"kerajaan-Mu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Engkau telah mencintai kebenaran dan","poem":1},{"text":"membenci kejahatan;","poem":2},{"lineBreak":true},{"text":"Oleh itu Allah, Tuhan-Mu,","poem":2},{"lineBreak":true},{"text":"telah mengurapi-Mu","poem":2},{"lineBreak":true},{"text":"dengan minyak kebahagiaan lebih","poem":2},{"lineBreak":true},{"text":"daripada teman-teman-Mu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dan:","poem":1},{"lineBreak":true},{"text":"‘Pada mulanya, Engkau, Tuhanku,","poem":1},{"text":"yang meletakkan asas bumi,","poem":2},{"lineBreak":true},{"text":"dan seluruh langit adalah hasil","poem":2},{"lineBreak":true},{"text":"kerja tangan-Mu;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bumi dan langit akan binasa,","poem":1},{"text":"tetapi Engkau kekal;","poem":2},{"lineBreak":true},{"text":"dan segalanya akan menjadi","poem":2},{"lineBreak":true},{"text":"usang seperti pakaian;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Seperti jubah, Engkau akan","poem":1},{"text":"menggulungnya;","poem":2},{"lineBreak":true},{"text":"seperti baju yang ditukar,","poem":2},{"lineBreak":true},{"text":"semuanya akan diubah.","poem":2},{"text":"Tetapi Engkau tetap sama,","poem":1},{"text":"dan zaman-Mu tidak berkesudahan.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Tetapi kepada malaikat manakah Allah pernah berfirman:",{"lineBreak":true},{"text":"‘Duduklah di sebelah kanan-Ku,","poem":1},{"text":"sehingga Aku menjadikan","poem":2},{"lineBreak":true},{"text":"musuh-Mu alas kaki-Mu’?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":["Bukankah semua malaikat itu roh-roh pelayan yang dihantar untuk melayani manusia yang akan mewarisi penyelamatan?"]}],"footnotes":[]},"thisChapterLink":"/api/zlm_ksz/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zlm_ksz/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zlm_ksz/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}