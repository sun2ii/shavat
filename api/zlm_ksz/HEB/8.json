{"translation":{"id":"zlm_ksz","name":"Kitab Suci Zabur dan Injil","website":"https://ebible.org/Scriptures/details.php?id=zlmKSZI","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zlmKSZI","licenseNotes":null,"shortName":"KSZ","englishName":"Contextualized Malay NT","language":"zlm","textDirection":"ltr","sha256":"a15e802deae4a923cb75292ce2b7c704fc8b4551331770e4014120648e5c3a0a","availableFormats":["json"],"listOfBooksApiLink":"/api/zlm_ksz/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"Malay (individual language)","languageEnglishName":"Malay (individual language)"},"book":{"id":"HEB","translationId":"zlm_ksz","name":"Ibrani","commonName":"Ibrani","title":"Ibrani","order":58,"numberOfChapters":13,"sha256":"38a6c3f9fbaad114639fa423348947206adb5e8b7c2cdbb2032f42f48af5ae13","firstChapterNumber":1,"firstChapterApiLink":"/api/zlm_ksz/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/zlm_ksz/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":8,"content":[{"type":"heading","content":["Imam Besar perjanjian baru"]},{"type":"verse","number":1,"content":["Pokok segala yang kami katakan: Kita mempunyai Imam Besar yang duduk di sebelah kanan takhta Allah Yang Maha Mulia di syurga."]},{"type":"verse","number":2,"content":["Dia adalah Penjawat di tempat suci dan di khemah sejati, yang dibina oleh Tuhan, bukan oleh manusia."]},{"type":"verse","number":3,"content":["Setiap Imam Besar dilantik untuk membuat persembahan dan korban. Oleh itu Imam Besar ini juga mesti ada sesuatu untuk dipersembahkan."]},{"type":"verse","number":4,"content":["Sekiranya Dia di bumi, Dia tidaklah menjadi imam, kerana ada imam yang membuat persembahan menurut hukum Taurat."]},{"type":"verse","number":5,"content":["Imam di dunia mempersembahkan salinan dan bayang-bayang perkara di syurga. Demikianlah arahan kepada Musa tatkala dia bersedia untuk membuat khemah itu. Allah berfirman, ‘Pastikan bahawa engkau membuat segalanya menurut contoh yang ditunjukkan kepadamu di atas gunung itu.’"]},{"type":"verse","number":6,"content":["Tetapi sekarang Dia telah mendapat jawatan yang lebih tinggi, kerana Dia juga menjadi Pengantara bagi perjanjian yang lebih baik, yang diasaskan pada janji-janji yang lebih baik."]},{"type":"verse","number":7,"content":["Andainya perjanjian pertama itu tidak bercela, tidaklah perlu diadakan perjanjian lagi."]},{"type":"verse","number":8,"content":["Tetapi Allah telah mendapati mereka bercela lalu berfirman:",{"lineBreak":true},{"text":"‘Lihatlah, akan tiba harinya, firman Tuhan,","poem":1},{"text":"apabila Aku membuat perjanjian baru dengan kaum Israel","poem":2},{"lineBreak":true},{"text":"dan dengan kaum Yahuda –","poem":2}]},{"type":"verse","number":9,"content":[{"text":"tidak seperti perjanjian","poem":1},{"text":"yang telah Kubuat dengan nenek","poem":2},{"lineBreak":true},{"text":"moyang mereka","poem":2},{"text":"ketika Aku membimbing tangan mereka","poem":1},{"text":"untuk membawa mereka keluar dari","poem":2},{"lineBreak":true},{"text":"tanah Mesir,","poem":2},{"text":"kerana mereka tidak terus-menerus","poem":1},{"text":"memegang janji-Ku,","poem":2},{"lineBreak":true},{"text":"lalu Aku berpaling daripada mereka;","poem":2},{"lineBreak":true},{"text":"demikian firman Tuhan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inilah perjanjian yang akan Kubuat","poem":1},{"text":"dengan kaum Israel","poem":2},{"lineBreak":true},{"text":"selepas zaman itu, Tuhan berfirman.","poem":2},{"text":"Aku akan meletakkan hukum-Ku di dalam","poem":1},{"text":"fikiran mereka","poem":2},{"lineBreak":true},{"text":"dan menuliskannya di hati mereka;","poem":2},{"text":"Aku akan menjadi Allah Tuhan mereka,","poem":1},{"text":"dan mereka akan menjadi umat-Ku.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tiada seorang pun daripada mereka","poem":1},{"text":"akan mengajar jirannya atau","poem":2},{"lineBreak":true},{"text":"saudaranya dengan berkata,","poem":2},{"lineBreak":true},{"text":"“Kenalilah Tuhan,”","poem":2},{"text":"kerana semuanya akan mengenal-Ku,","poem":1},{"text":"daripada yang terkecil kepada yang","poem":2},{"lineBreak":true},{"text":"terbesar antara mereka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aku akan berbelas kasihan terhadap","poem":1},{"text":"kesalahan mereka;","poem":2},{"lineBreak":true},{"text":"dan dosa serta perbuatan mereka","poem":2},{"lineBreak":true},{"text":"yang ingkar tidak akan","poem":2},{"lineBreak":true},{"text":"Kuingati lagi.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Dengan menyebut ‘perjanjian baru,’ Tuhan telah menjadikan perjanjian pertama dahulu tidak terpakai lagi. Sesuatu yang kian tidak terpakai dan usang sudah sampai masanya untuk lenyap."]}],"footnotes":[]},"thisChapterLink":"/api/zlm_ksz/HEB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zlm_ksz/HEB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zlm_ksz/HEB/7.json","previousChapterAudioLinks":{},"numberOfVerses":13}