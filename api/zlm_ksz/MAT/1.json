{"translation":{"id":"zlm_ksz","name":"Kitab Suci Zabur dan Injil","website":"https://ebible.org/Scriptures/details.php?id=zlmKSZI","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zlmKSZI","licenseNotes":null,"shortName":"KSZ","englishName":"Contextualized Malay NT","language":"zlm","textDirection":"ltr","sha256":"a15e802deae4a923cb75292ce2b7c704fc8b4551331770e4014120648e5c3a0a","availableFormats":["json"],"listOfBooksApiLink":"/api/zlm_ksz/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7958,"languageName":"Malay (individual language)","languageEnglishName":"Malay (individual language)"},"book":{"id":"MAT","translationId":"zlm_ksz","name":"Matius","commonName":"Matius","title":"Matius","order":40,"numberOfChapters":28,"sha256":"c1de4f7f19ab17162f7aebdf571f29b4863e0a3ffd897564bce21c64e7c6e4e1","firstChapterNumber":1,"firstChapterApiLink":"/api/zlm_ksz/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/zlm_ksz/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":1,"content":[{"type":"heading","content":["Salasilah Isa al-Masih"]},{"type":"verse","number":1,"content":["Inilah salasilah Isa al-Masih, keturunan Daud, keturunan Ibrahim."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ibrahim beroleh anak yang dinamai Ishak,","poem":1},{"text":"Ishak beroleh Yakub,","poem":2},{"lineBreak":true},{"text":"dan Yakub beroleh Yudah serta","poem":2},{"lineBreak":true},{"text":"saudara-saudaranya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yudah beroleh Peres dan Zerah daripada isterinya Tamar,","poem":1},{"text":"Peres beroleh Hezron, dan Hezron","poem":2},{"lineBreak":true},{"text":"beroleh Ram.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ram beroleh Aminadab,","poem":1},{"text":"Aminadab beroleh Nahason,","poem":2},{"lineBreak":true},{"text":"dan Nahason beroleh Salmon.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Salmon beroleh Boas daripada","poem":1},{"text":"isterinya Rahab,","poem":2},{"lineBreak":true},{"text":"Boas beroleh Obed daripada","poem":2},{"lineBreak":true},{"text":"isterinya Rut,","poem":2},{"lineBreak":true},{"text":"dan Obed beroleh Isai,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"dan Isai beroleh Raja Daud.","poem":1},{"lineBreak":true},"Raja Daud beroleh Sulaiman daripada isteri Uria."]},{"type":"verse","number":7,"content":[{"text":"Sulaiman beroleh Rehabeam,","poem":1},{"text":"Rehabeam beroleh Abia,","poem":2},{"lineBreak":true},{"text":"dan Abia beroleh Asa.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa beroleh Yosafat,","poem":2},{"lineBreak":true},{"text":"Yosafat beroleh Yoram,","poem":2},{"lineBreak":true},{"text":"dan Yoram beroleh Uzia.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uzia beroleh Yotam,","poem":2},{"lineBreak":true},{"text":"Yotam beroleh Ahaz,","poem":2},{"lineBreak":true},{"text":"dan Ahaz beroleh Hizkia.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hizkia beroleh Manasye,","poem":2},{"lineBreak":true},{"text":"Manasye beroleh Amon,","poem":2},{"lineBreak":true},{"text":"dan Amon beroleh Yosia.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosia beroleh Yoyakhin dan","poem":2},{"lineBreak":true},{"text":"saudara-saudaranya sekitar masa mereka","poem":2},{"lineBreak":true},{"text":"dibawa sebagai tawanan di Babel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Seterusnya, Yoyakhin beroleh Sealtiel,","poem":1},{"lineBreak":true},{"text":"dan Sealtiel beroleh Zerubabel.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Zerubabel beroleh Abihud,","poem":2},{"lineBreak":true},{"text":"Abihud beroleh Elyakim,","poem":2},{"lineBreak":true},{"text":"dan Elyakim beroleh Azur.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azur beroleh Zadok,","poem":2},{"lineBreak":true},{"text":"Zadok beroleh Akhim,","poem":2},{"lineBreak":true},{"text":"dan Akhim beroleh Eliud.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliud beroleh Eleazar,","poem":2},{"lineBreak":true},{"text":"Eleazar beroleh Matan,","poem":2},{"lineBreak":true},{"text":"dan Matan beroleh Yakub.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maka Yakub beroleh Yusuf, suami Maryam, Maryamlah yang melahirkan Isa yang dipanggil al-Masih.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Dengan demikian, ada empat belas keturunan dari Ibrahim hingga ke Daud; empat belas keturunan dari Daud hingga ke masa pembuangan di Babel; dan empat belas keturunan dari masa itu hingga kelahiran al-Masih."]},{"type":"heading","content":["Kelahiran al-Masih"]},{"type":"verse","number":18,"content":["Inilah kisah kelahiran Isa al-Masih: Ibu-Nya, Maryam bertunang dengan Yusuf, tetapi sebelum perkahwinan mereka dilangsungkan, Maryam mengandung melalui kuasa Roh Suci."]},{"type":"verse","number":19,"content":["Yusuf, seorang yang takwa dan berakhlak, tidak mahu memalukan Maryam di mata masyarakat. Dia berniat memutuskan pertunangan mereka secara diam-diam."]},{"type":"verse","number":20,"content":["Dia memikirkan hal itu sehalus-halusnya. Suatu malam dia bermimpi malaikat Tuhan memperlihatkan diri kepadanya lalu berkata, ‘Hai Yusuf keturunan Daud! Janganlah takut mengambil Maryam sebagai isterimu. Dia mengandung melalui kuasa Roh Suci."]},{"type":"verse","number":21,"content":["Maryam akan melahirkan seorang anak lelaki. Namakanlah anak itu Isa. Dia akan menyelamatkan umat-Nya daripada dosa mereka.’"]},{"type":"verse","number":22,"content":["Segala ini terjadi supaya berlakulah firman Tuhan melalui nabi-Nya:"]},{"type":"verse","number":23,"content":["‘Seorang anak dara akan mengandung, dan melahirkan seorang anak lelaki, maka Anak itu akan dipanggil Immanuel’ bererti, ‘Allah menyertai kita’ dalam bahasa Ibrani."]},{"type":"verse","number":24,"content":["Apabila Yusuf terjaga, dia pun mematuhi apa yang disampaikan oleh malaikat Tuhan itu lalu berkahwin dengan Maryam."]},{"type":"verse","number":25,"content":["Tetapi Yusuf tidak menyentuh Maryam sebagai isterinya hinggalah Maryam melahirkan Anak itu. Yusuf menamai Anak itu Isa."]}],"footnotes":[]},"thisChapterLink":"/api/zlm_ksz/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zlm_ksz/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":25}