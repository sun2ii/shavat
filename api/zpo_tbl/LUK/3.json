{"translation":{"id":"zpo_tbl","name":"Wdizh kwaan nyaadno yalnaban","website":"https://ebible.org/Scriptures/details.php?id=zpoNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=zpoNT","licenseNotes":null,"shortName":"TBL","englishName":"Amatlán Zapotec NT","language":"zpo","textDirection":"ltr","sha256":"3b2294e1e136abac3cbc48c184bf6fa3d91ee06bc07311e251a19ca653173054","availableFormats":["json"],"listOfBooksApiLink":"/api/zpo_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7937,"languageName":"Amatlán Zapotec","languageEnglishName":"Amatlán Zapotec"},"book":{"id":"LUK","translationId":"zpo_tbl","name":"Lucas","commonName":"Lucas","title":"Wdizh chul cheen Jesucrist kwaan mkee Luk","order":42,"numberOfChapters":24,"sha256":"60350563a5c4d9897ccf09564eea0081f37cf6a1302e5223a89b694b27e4a91b","firstChapterNumber":1,"firstChapterApiLink":"/api/zpo_tbl/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/zpo_tbl/LUK/24.json","totalNumberOfVerses":1148},"chapter":{"number":3,"content":[{"type":"heading","content":["Juan Xaa Nchubnis nzho naz wen"]},{"type":"verse","number":1,"content":["Chiin liin nzha nabeyy Tiberio César dub pa nabeyy Roma, lee Poncio Pilat nak xaa nabeyy yizhyo Judea, Herod nabeyy yizhyo Galilea, wech xaa nak Lip xaa nabeyy yizhyo Iturea nu yizhyo Traconite, nu lee Lisanias nabeyy yizhyo Abilinia."]},{"type":"verse","number":2,"content":["Anás nu Caifás nak ngwleyy non doo naz Jerusalén. Re mbizh zee lee Juan xgann Zacari ngu naz wen, nu ngunii Dios lo xaa."]},{"type":"verse","number":3,"content":["Nu Juan mded dubse roo yuu Jordán, nu mbezh xaa lo rese myet nkin laa xaa naz nawent nu bare xaa lo Dios zee rubnis xaa, zee zhe re jwalt cheen xaa."]},{"type":"verse","number":4,"content":["Nu kwaane ngok zee mbarlo kwaan mkee Chay, xaa mzaa kwent kwaan nzhé Dios lo lee xaa yilo:",{"text":"Tub xaa nzo naz wen nii dublegan:","poem":1},{"lineBreak":true},{"text":"“Bdexkwaa gu xnaz Xaa Nabeyy;","poem":1},{"lineBreak":true},{"text":"bxal gu tub naz nali zee ze xaa.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rese pa yat nzeb yizhe,","poem":1},{"lineBreak":true},{"text":"nu rese yi nu rese lom seli xaa","poem":1},{"lineBreak":true},{"text":"nu rese naz narek seli xaa.","poem":1},{"lineBreak":true},{"text":"Nu dexkwaa wen xaa re naz kwaan nawent nak.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nu rese myet ne lo xaa mxaal Dios,","poem":1},{"lineBreak":true},{"text":"xaa koo re xaa lo yalgut. [Is. 40:3-5]","poem":1}]},{"type":"verse","number":7,"content":["Gorna lee re myet nzhin rubnis xaa lo xaa, Juan mbezh lo re xaa: —¡Gu nak dii cheen mball wiz! ¿Cho né lo gu nzho mod xonn gu lo yalnayii kwaan né Dios yaad?"]},{"type":"verse","number":8,"content":["Blu mlaa gu naz nawent nu wlipa mbare gu naz lo Dios, zee gakpa gu mod xle cheen tub yag. Nu nawdizht gu yé gu: “¡Lee re be nak dii cheen Abraham!” Nel wlipa na nii na lo gu, Dios nzho mod le axta noka re ke ne gaka dii cheen Abraham."]},{"type":"verse","number":9,"content":["Lee yibyag nzobla cho lox re yag kwaan nanzaat xle wen, zee choog xaaya nu koo xaaya lo ki."]},{"type":"verse","number":10,"content":["Zee lee re xaa mnabdizh nu nzhé xaa: —¿Cho kwaan nzhaal le nu?"]},{"type":"verse","number":11,"content":["Juan mkeb nzhé lo re xaa: —Nu loka cho xaa nkano chop naz ler, bzaa gu tub naza lo xaa nankanota, nu loka cho nkano kwaan gaw, bzaa guya lo xaa nyent kwaan gaw."]},{"type":"verse","number":12,"content":["Noka lak xaa ntop demi kwaan nya naz Roma ngwa lo Juan, zee chubnis Juan xaa, nu mnabdizh xaa lo Juan nu nzhé xaa: —Maestr, ¿cho kwaan nzhaal le nu?"]},{"type":"verse","number":13,"content":["Juan nzhé lo re xaa: —Nebse gunaab gu parota nzhaal kix xaa."]},{"type":"verse","number":14,"content":["Noka mnabdizh lak soldad lo Juan, nu nzhé xaa: —¿Cho kwaan le re nu? Nu lee Juan nzhé lo xaa: —Nakiibt gu kwaan nkano re myet kwaan lajwers, nixa nagaazht gu tub kwaan nawlit tich xaa; nu nebse gok chul lextoo gu kayaa gu re demi kwaan nzhex nka gu."]},{"type":"verse","number":15,"content":["Lee re myet nkambaz nen cho kwaan gak. Nu rese xaa nle xgab chelee Juan nak Xaa Xaal Dios Nabeyy."]},{"type":"verse","number":16,"content":["Per lee Juan nzhé lo re xaa: —Na nchubnis re gu kwaan nis, per tich na nze stub xaa chubnis re gu kwaan Mbi Naban nu kwaan ki. Lee xaa nonra lo na kwaanzee nixa tich xkyelyed xaa nanzhaalt xek na."]},{"type":"verse","number":17,"content":["Lee xaa nzho tub garot yaa koo paj lo nzhobxtil, nu kozhaw xaa nzhobxtil pa ngozhaw xaa re xob xaa, nu lee paj nzhobxtil zek xaa lo ki kwaan tira nanyuyyt."]},{"type":"verse","number":18,"content":["Nu kwaan zyen doo re wdizh ne mzaa Juan kwent chul cheen Dios lo re myet."]},{"type":"verse","number":19,"content":["Nu noka mgalno xaa Herod, xaa nabeyy yizhyo Galilea, nel mkano Herod xngwnaa wech xaa Lip, me le Herodías, nu noka mgalno xaa Herod lo rese kwaan nawent kwaana mle Herod."]},{"type":"verse","number":20,"content":["Lo re kwaan nawent nzhale Herod, noka mle xaa stub kwaan nawent, mchep xaa Juan lozhyib."]},{"type":"heading","content":["Jesús mrubnis"]},{"type":"verse","number":21,"content":["Nu gorna lee Juan kachubnis re myet, noka Jesús ngwa mrubnis; nu gorna lee xaa kawdizhno Dios lee yiba mxal,"]},{"type":"verse","number":22,"content":["nu lee Mbi Naban cheen Dios nyaadla naz leen yiba mla tich xaa mod tub palom, nu kwaane nak tub kwaan mlu lo xaa. Nu tub bos kwaan nze naz yiba nzhé: —Lu nak xgaan na, xaa nkedoola na, nu nyakdoo lextoo na wii na lo lu."]},{"type":"heading","content":["Dii cheen re xey Jesús"]},{"type":"verse","number":23,"content":["Jesús nzho kan tub galbchii liin gorna mzelo xaa mzaa xaa kwent wdizh chul cheen Dios. Nak xaa mod xgann Che, kwentaxa nle re xaa xgab.",{"text":"Che ngok xgann Elí,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Elí ngok xgann Matat,","poem":1},{"lineBreak":true},{"text":"Matat ngok xgann Leví,","poem":1},{"lineBreak":true},{"text":"Leví ngok xgann Melqui,","poem":1},{"lineBreak":true},{"text":"Melqui ngok xgann Jana,","poem":1},{"lineBreak":true},{"text":"Jana ngok xgann Che,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Che ngok xgann Matatías,","poem":1},{"lineBreak":true},{"text":"Matatías ngok xgann Amós,","poem":1},{"lineBreak":true},{"text":"Amós ngok xgann Nahúm,","poem":1},{"lineBreak":true},{"text":"Nahúm ngok xgann Esli,","poem":1},{"lineBreak":true},{"text":"Esli ngok xgann Nagai,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagai ngok xgann Maat,","poem":1},{"lineBreak":true},{"text":"Maat ngok xgann Matatías,","poem":1},{"lineBreak":true},{"text":"Matatías ngok xgann Semei,","poem":1},{"lineBreak":true},{"text":"Semei ngok xgann Chek,","poem":1},{"lineBreak":true},{"text":"Chek ngok xgann Judá,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Judá ngok xgann Joanán,","poem":1},{"lineBreak":true},{"text":"Joanán ngok xgann Resa,","poem":1},{"lineBreak":true},{"text":"Resa ngok xgann Zorobabel,","poem":1},{"lineBreak":true},{"text":"Zorobabel ngok xgann Salatiel,","poem":1},{"lineBreak":true},{"text":"Salatiel ngok xgann Neri,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Neri ngok xgann Melqui,","poem":1},{"lineBreak":true},{"text":"Melqui ngok xgann Adi,","poem":1},{"lineBreak":true},{"text":"Adi ngok xgann Cosam,","poem":1},{"lineBreak":true},{"text":"Cosam ngok xgann Elmadam,","poem":1},{"lineBreak":true},{"text":"Elmadam ngok xgann Er,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Er ngok xgann Jesús,","poem":1},{"lineBreak":true},{"text":"Jesús ngok xgann Eliezer,","poem":1},{"lineBreak":true},{"text":"Eliezer ngok xgann Jorim,","poem":1},{"lineBreak":true},{"text":"Jorim ngok xgann Matat,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Matat ngok xgann Leví,","poem":1},{"lineBreak":true},{"text":"Leví ngok xgann Simeón,","poem":1},{"lineBreak":true},{"text":"Simeón ngok xgann Judá,","poem":1},{"lineBreak":true},{"text":"Judá ngok xgann Che,","poem":1},{"lineBreak":true},{"text":"Che ngok xgann Jonam,","poem":1},{"lineBreak":true},{"text":"Jonam ngok xgann Eliaquim,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Eliaquim ngok xgann Melea,","poem":1},{"lineBreak":true},{"text":"Melea ngok xgann Mená,","poem":1},{"lineBreak":true},{"text":"Mená ngok xgann Matata,","poem":1},{"lineBreak":true},{"text":"Matata ngok xgann Natán,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Natán ngok xgaan rey David,","poem":1},{"lineBreak":true},{"text":"David ngok xgann Isaí,","poem":1},{"lineBreak":true},{"text":"Isaí ngok xgann Obed,","poem":1},{"lineBreak":true},{"text":"Obed ngok xgann Booz,","poem":1},{"lineBreak":true},{"text":"Booz ngok xgann Sélah,","poem":1},{"lineBreak":true},{"text":"Sélah ngok xgann Naasón,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Naasón ngok xgann Aminadab,","poem":1},{"lineBreak":true},{"text":"Aminadab ngok xgann Admín,","poem":1},{"lineBreak":true},{"text":"Admín ngok xgann Arní,","poem":1},{"lineBreak":true},{"text":"Arní ngok xgann Esrom,","poem":1},{"lineBreak":true},{"text":"Esrom ngok xgann Fares,","poem":1},{"lineBreak":true},{"text":"Fares ngok xgann Judá,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Judá ngok xgann Kob,","poem":1},{"lineBreak":true},{"text":"Kob ngok xgann Chak,","poem":1},{"lineBreak":true},{"text":"Chak ngok xgann Abraham,","poem":1},{"lineBreak":true},{"text":"Abraham ngok xgann Taré,","poem":1},{"lineBreak":true},{"text":"Taré ngok xgann Nacor,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nacor ngok xgann Serug,","poem":1},{"lineBreak":true},{"text":"Serug ngok xgann Ragau,","poem":1},{"lineBreak":true},{"text":"Ragau ngok xgann Peleg,","poem":1},{"lineBreak":true},{"text":"Peleg ngok xgann Heber,","poem":1},{"lineBreak":true},{"text":"Heber ngok xgann Sala,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Sala ngok xgann Cainán,","poem":1},{"lineBreak":true},{"text":"Cainán ngok xgann Arfaxad,","poem":1},{"lineBreak":true},{"text":"Arfaxad ngok xgann Sem,","poem":1},{"lineBreak":true},{"text":"Sem ngok xgann Noé,","poem":1},{"lineBreak":true},{"text":"Noé ngok xgann Lamec,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Lamec ngok xgann Matusalén,","poem":1},{"lineBreak":true},{"text":"Matusalén ngok xgann Nok,","poem":1},{"lineBreak":true},{"text":"Nok ngok xgann Jared,","poem":1},{"lineBreak":true},{"text":"Jared ngok xgann Mahalaleel,","poem":1},{"lineBreak":true},{"text":"Mahalaleel ngok xgann Cainán,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Cainán ngok xgann Enós,","poem":1},{"lineBreak":true},{"text":"Enós ngok xgann Set,","poem":1},{"lineBreak":true},{"text":"Set ngok xgann Dan,","poem":1},{"lineBreak":true},{"text":"Dan ngok xgann Dios.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zpo_tbl/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zpo_tbl/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zpo_tbl/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}