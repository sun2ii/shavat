{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Ba nez ẕen naken che bennen' bi ẕzi'e da' ẕzejní'igekle benne' wen da' ẕinnj ka' ḻe',","poem":1},{"lineBreak":true},{"text":"na' bi nake' toze ḻen benne' doḻa' ka',","poem":1},{"lineBreak":true},{"text":"na' bi žónḻene' tẕen benne' ka' ẕzóagake' Dios cheḻa'ale,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"san žebele' dan' žone' kan ẕchi'le X̱anžo Dios,","poem":1},{"lineBreak":true},{"text":"na' kan nak dan' wnnakze' Ḻe', dot ža dot yel ẕlab ḻaže'en.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Benne' ni nake' ka to yag da' zoan žoa'a yegw,","poem":1},{"lineBreak":true},{"text":"da' ẕbian da' ẕix̱ chen ḻo byo' chekzen,","poem":1},{"lineBreak":true},{"text":"na' x̱lagen bi žasen.","poem":1},{"lineBreak":true},{"text":"Yógo'te da' žon benne' ni, želžój chawen',","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"san benne' wen da' ẕinnj ka' kege ki zej nake'.","poem":1},{"lineBreak":true},{"text":"Zej nake' ka to laga' biž dan' žoa be'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bi yežojgak chawe' benne' wen da' ẕinnj ka' kate' wchi'a ḻaže' Dios ḻégake',","poem":1},{"lineBreak":true},{"text":"na' bi chó'ogak benne' doḻa' ka' gan zej ndobe benne' chawe' ka' ḻaw Dios.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Žaz ḻaže' Dios da' žongak benne' chawe' ka',","poem":1},{"lineBreak":true},{"text":"san da' žongak benne' wen da' ẕinnj ka' chen' ḻégake' gan kwia yí'gake'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":6}