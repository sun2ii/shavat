{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":100,"content":[{"type":"verse","number":1,"content":[{"text":"Le goḻ ḻaw X̱anžo Dios, ḻe'e zoale dot yežlyó nga.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Le wká'n ẕen Ḻe' ḻen yeḻa' žebele chele.","poem":1},{"lineBreak":true},{"text":"Le da ḻawe' Ḻe', žoḻ-le ḻen yeḻa' žebele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Batkle gaḻ ḻáže'le X̱anžon' nakkze' Dios.","poem":1},{"lineBreak":true},{"text":"Ḻe' bene' žo'o, na' nakžo chekze' Ḻe'.","poem":1},{"lineBreak":true},{"text":"Nakžo benách chie' ka', na' ẕíla'do' chie' ka'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le cho'o yodo' chie', na' ye'le-ne': “Žóx̱keno'”,","poem":1},{"lineBreak":true},{"text":"na' ḻo ẕchil chen, we ḻawle Ḻe'.","poem":1},{"lineBreak":true},{"text":"Le yi'e: “Žóx̱keno'”, na' le wká'n ẕen La la'y chie'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chawe' nak X̱anžon' na' sóateze yeḻa' ži'i ḻaže' chie'.","poem":1},{"lineBreak":true},{"text":"Yeḻa' ḻi ḻaže' chie' soan to chi'ize.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}