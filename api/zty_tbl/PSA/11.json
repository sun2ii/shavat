{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"Žx̱en ḻaža'a X̱ana' Dios.","poem":1},{"lineBreak":true},{"text":"¿Biẕ chen' že'gak benách ka' neda':","poem":1},{"lineBreak":true},{"text":"“Bẕonnj, wyéj ḻaw ya'a ka to byinne”?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bwia nga, ẕkwezgak benne' ka' bi zej nake' chawe' yag ntóche'do' ka' chégake'.","poem":1},{"lineBreak":true},{"text":"Ba bx̱óagake' yag ntóche'do' ka' chégake' ḻo do chen,","poem":1},{"lineBreak":true},{"text":"nich gótgake' bagáche'ze benne' chawe' ka'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chela' kwasgak da' ka' ẕzoagak chochen da' chawe',","poem":1},{"lineBreak":true},{"text":"¿biẕkze gongak benne' chawe' ka'?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"X̱anžo Dios zoakze' latje la'y chie'.","poem":1},{"lineBreak":true},{"text":"Ya'abá na'kze zoa latje blo gan že' Dios.","poem":1},{"lineBreak":true},{"text":"Ẕwíagak yej ḻawe', na' ẕḻe'ele' da' žongak benne' ka'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"X̱anžo Dios ẕbeje' benne' chawe' ka' ḻo da' zede,","poem":1},{"lineBreak":true},{"text":"san bi ẕḻe'ele' chawe' benne' ka' bi zej nake' chawe' na' benne' ka' žóngake' da' ẕinnj.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wdíe' benne' ka' bi zej nake' chawe' ḻo da' ka' wžía yí'gaken ḻégake',","poem":1},{"lineBreak":true},{"text":"da' ka' zej naken yi', na' sufr da' žeyen ka yeže, na' to be' da' ḻaḻe'e,","poem":1},{"lineBreak":true},{"text":"da' ka' seḻe'e ḻawgak benne' ka'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ki gone' dan' nak chawe' X̱anžo Dios, na' nži'ile' da' naken chawe'.","poem":1},{"lineBreak":true},{"text":"Ḻé'egekle benne' ḻi ḻaže' ka' ḻawe' Ḻe'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}