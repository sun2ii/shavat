{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":110,"content":[{"type":"verse","number":1,"content":[{"text":"X̱anžo Dios gože' X̱ana':","poem":1},{"lineBreak":true},{"text":"“Wžé' kwita' ḻi ža gan ži'a neda',","poem":1},{"lineBreak":true},{"text":"na' zejte ža gona' ga benne' ka' bi ẕḻé'egekle' Le' chawe' wzóa ẕíbgake' x̱ni'o.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gan zo' yež Sión, gonn X̱anžon' yeḻa' wnná bia' chio'.","poem":1},{"lineBreak":true},{"text":"Ẕnne': “Wnná bia' benne' ka' ẕdíḻ-ḻengake' Le'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ḻo ža kate' wzetjo' benne' ka' bi ẕḻé'egekle' ḻe' chawe',","poem":1},{"lineBreak":true},{"text":"dot ḻáže'gak benne' chio' ka' wdé kwíngake' ḻo no'o,","poem":1},{"lineBreak":true},{"text":"ka žon x̱le'l zílele, da' žakwn ya'a la'y chia' ka'.","poem":1},{"lineBreak":true},{"text":"Kikze yeyák yiz kwide' chio' tža tža.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bchebe ḻaže' X̱anžon', na' bi wché'e x̱tiže'e, wnné':","poem":1},{"lineBreak":true},{"text":"“To chi'ize nako' bx̱oz kan gok bx̱oz Melkisedek.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zoa X̱anžon' kwito' ḻi ža gan zo'.","poem":1},{"lineBreak":true},{"text":"Kate' že'e, na' wžía yi'e benne' wnná bia' ka'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Choge' chegak benne' yógo'te yež ka' gátgake', na' gote' benne' zante yež ka'.","poem":1},{"lineBreak":true},{"text":"Wžía yi'e benne' ka' ẕnna biá'gake' do ẕente yežlyó.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ye'je' nis yégodo' da' zoan žoa'a nez,","poem":1},{"lineBreak":true},{"text":"na' yeyák yeḻa' waḻe chie'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}