{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"¡Ga'n ẕen X̱anžo Dios!","poem":1},{"text":"Ḻe'e, wen žin chie', ¡le wká'n ẕen La la'y chie'!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"¡Ga'n ẕen La la'y che X̱anžo Dios, na'a ža, na' to chi'ize!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Ga'n ẕen La la'y che X̱anžo Dios, gan ẕḻa' wbíž ga žinte gan ženen!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Ga'n ẕen X̱anžo Dios ḻawle yógo'te yež ka', na' ḻawle ya'abá že' yeḻa' ẕen chie'!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Noẕkze benne' nake' ẕen ka nak X̱anžo Dios,","poem":1},{"lineBreak":true},{"text":"Bennen' ẕnna bi'e ya'abá na'le?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dios žon kwine' gax̱jw ḻaže' nich gak ḻe'ele'","poem":1},{"lineBreak":true},{"text":"da' de ẕan ya'abá, na' ḻo yežlyó.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dios žechise' benne' yache' ḻo bix̱te yo,","poem":1},{"lineBreak":true},{"text":"na' žebeje' benne' nyache' ḻaže' ḻo da' ẕzáka'ḻi'e,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"na' žone' ga že'gak benne' ki ladjw benne' blo ka',","poem":1},{"lineBreak":true},{"text":"benne' ka' ẕnna biá'gake' benne' chie' ka'.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Žone' ga zoa no'le wbíž ládjwgak x̱kwide' chekze' ka'.","poem":1},{"lineBreak":true},{"text":"Žebele no'len' dan' nake' x̱na'gak x̱kwide' chie' ka'.","poem":1},{"lineBreak":true},{"text":"¡Ga'n ẕen X̱anžo Dios!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}