{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Kate' bžojgak benne' Israel ka' ḻo yežlyó Egipto,","poem":1},{"lineBreak":true},{"text":"bžojgak ẕa'só Jakob ḻo yežlyó chegak benne' zi'to' ka'","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"na' gokgak ẕa'só Judá ka to yo'o gan ẕbez Dios,","poem":1},{"lineBreak":true},{"text":"na' gokgak benne' Israel ka' gan ẕnna bi'e.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bḻe'el Nisdo' X̱na da' ni, na' bẕonnjen,","poem":1},{"lineBreak":true},{"text":"na' wdé x̱kože'l yegw Jordán.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wx̱íte'gak ya'a ẕen ka' kan žx̱íte'gak chib ka',","poem":1},{"lineBreak":true},{"text":"na' wx̱íte'gak ya'ado' ka' kan žx̱íte'gak chibdo' ka'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Biẕ gok chio', nisdon', dan' bẕonnjo'?","poem":1},{"lineBreak":true},{"text":"¿Biẕ gok chio', yegw Jordán, dan' wdío' x̱kože'l?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ḻe'e, ya'a ẕen ka', ¿biẕ chen' wx̱íte'le ka žx̱íte'gak chib ka'?","poem":1},{"lineBreak":true},{"text":"Ḻe'e, ya'ado' ka', ¿biẕ chen' wx̱íte'le kan žx̱íte'gak chibdo' ka'?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Žẕo' yežlyó ḻaw X̱anžo Dios, ḻaw Dios na' che Jakob.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dios na'kze bene' ga beyák yej x̱en' to bej nis,","poem":1},{"lineBreak":true},{"text":"na' bene' ga beyák yej to gan žaḻ nis.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}