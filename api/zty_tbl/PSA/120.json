{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":120,"content":[{"type":"verse","number":1,"content":[{"text":"Kate' wžé' zedla' bḻiža' X̱anžo Dios,","poem":1},{"lineBreak":true},{"text":"na' Ḻe' gókḻene' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"X̱ana' Dios, beslá neda' ḻo na'gak benne' wen ḻaže' ka'","poem":1},{"lineBreak":true},{"text":"na' ḻo na'gak benne' ka' bi zej nake' ḻi ḻaže'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Biẕ gonn Dios ḻe'e, benne' wen laže' ka'?","poem":1},{"lineBreak":true},{"text":"¿Biẕ yeḻa' ba nez gaken chele kate' wdíe' ḻe'e ḻo da' wžía yin' benách ka'?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wsaka' zi'gak yag ntóche'do' chie' ka' ḻe'e,","poem":1},{"lineBreak":true},{"text":"na' yag ka' zoa yi' ḻáwe'lgaken.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Da' nyáche'ḻe'e žaken chia' neda'.","poem":1},{"lineBreak":true},{"text":"Zoakza' ladjw benne' Mesek ka', na' zoa' to yo'o laže' chegak benne' Sedar ka'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Schaḻe'e ba wzóa' ladjw benne' ki,","poem":1},{"lineBreak":true},{"text":"benne' ka' ẕzóagake' cheḻa'ale yeḻa' ẕga'n chawe'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Neda' žak ḻaža'a gata' yeḻa' ẕga'n chawe',","poem":1},{"lineBreak":true},{"text":"san kate' ẕchaḻja' chen, ẕdíḻ-ḻengak benne' ka' neda'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}