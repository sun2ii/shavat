{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Ẕchis ḻawa', na' ẕwia' da' žak ḻawgak ya'a sibe ka'.","poem":1},{"lineBreak":true},{"text":"¿Gaẕ za' da' gákḻenen neda'?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Da' gákḻenen neda' za' ḻo na' X̱anžo Dios,","poem":1},{"lineBreak":true},{"text":"Bennen' bene' ya'abá, na' yežlyó.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bi go'e latje chejchego'o,","poem":1},{"lineBreak":true},{"text":"na' bi tas Bennen' žape chi'ikze' le'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bwia nga, batkle ẕnnan tas Bennen'.","poem":1},{"lineBreak":true},{"text":"Batkle tas Bennen' žape chi'ikze' benne' Israel ka'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"X̱anžo Dios žape chi'e le'.","poem":1},{"lineBreak":true},{"text":"X̱anžo Dios zoe' kwito' ḻi ža gan gake' ẕoḻ chio'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bi wzéy wbíž le' te ža, na' bi be gon byo' chio' žel.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"X̱anžo Dios gape chi'ikze' le' nich bi be da' ẕia gaken chio'.","poem":1},{"lineBreak":true},{"text":"Gape chi'ikze' yeḻa' nban chio'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"X̱anžo Dios gape chi'ikze' le' kate' žežojo',","poem":1},{"lineBreak":true},{"text":"na' kate' žeyó'o, na'a ža, na' to chi'ize.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}