{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":122,"content":[{"type":"verse","number":1,"content":[{"text":"Bebéḻenla' tẕen benne' ka' góžgake' neda':","poem":1},{"lineBreak":true},{"text":"“Le cho'o ḻo yodo' che X̱anžo Dios.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na'a zoažo nga.","poem":1},{"lineBreak":true},{"text":"Zežo lo'ole ze'e da' nyechjlen yež Jerusalén.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jerusalén naken to yež da' béngake',","poem":1},{"lineBreak":true},{"text":"na' naken x̱tanḻe'e, na' že'ḻe'en chawe'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ḻo yežen' za'gak yógo'te kwe' benne' ka', benne' zej nake' che X̱anžo Dios.","poem":1},{"lineBreak":true},{"text":"We ḻáwgake' La la'y che X̱anžo Dios,","poem":1},{"lineBreak":true},{"text":"kan wnnakze' Ḻe' gongak benne' Israel ka'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ẕdobgak benne' ka' ḻo yežen' nich wchi'a ḻáže'gake' benách Israel ka'","poem":1},{"lineBreak":true},{"text":"benne' ka' zej nbabe' ẕa'só Dabí, bennen' wnná bi'e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Le nnable Dios wka'ne' chawe' benne' Jerusalén ka'.","poem":1},{"lineBreak":true},{"text":"Ḻe' gon chawe'e benne' ka' zej nži'ile' yežen'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ẕnnablto'-ne' gone' ga soa yeḻa' ẕga'n chawe' lo'ole ze'e dan' nyechjlen yež Jerusalén.","poem":1},{"lineBreak":true},{"text":"Gon chawe'e benne' ka' zej yoe'e yo'o ẕen ka' chen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na'a, dan' nži'ila' bi' ljéža'do' ka', na' lježa' ka', ẕnnia':","poem":1},{"lineBreak":true},{"text":"“Gata' yeḻa' ẕga'n chawe' chele ḻo yež Jerusalén.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dan' nži'ila' yodo' che X̱anžo Dios žon byena' gak chawe' chen.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}