{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":124,"content":[{"type":"verse","number":1,"content":[{"text":"“Chela' bi gokḻen X̱anžo Dios žo'o”,","poem":1},{"lineBreak":true},{"text":"žaḻa' nnagak benne' Israel ka' na'a.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Chela' bi gokḻen X̱anžo Dios žo'o","poem":1},{"lineBreak":true},{"text":"kate' bdíḻ-ḻengak benne' ka' žo'o,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"na' bžia yí'gake' žo'o to chi'ize","poem":1},{"lineBreak":true},{"text":"ḻo yeḻa' ẕža'a ẕen chégake',","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"na' gok chežo ka žak che to benne'","poem":1},{"lineBreak":true},{"text":"ẕkache' nisdo' ḻe', na' žoten ḻe'.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chela' gok ki chežo, na' la' betten žo'o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Žaḻa' ye'žo X̱anžo Dios “žóx̱keno'”,","poem":1},{"lineBreak":true},{"text":"dan' bi bi'e latje benne' ka' wžía yí'gake' žo'o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Belažo kan želá to byinne ḻo yix̱jw che to benne' wezén byinne ka'.","poem":1},{"lineBreak":true},{"text":"Beká'a X̱anžon' yeḻa' wnná bia' chegak benne' ka', na' belažo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nak X̱anžo Dios Bennen' benkze' ya'abá, na' yežlyó.","poem":1},{"lineBreak":true},{"text":"Ḻekze' žákḻene' žo'o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}