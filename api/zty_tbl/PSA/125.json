{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"Benne' ka' žx̱en ḻáže'gake' X̱anžo Dios zej nake' ka Ya'a Sión.","poem":1},{"lineBreak":true},{"text":"Bi gak no benne' wtén', san to chi'ize zoa chochen.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kan zej že' ya'a ka' da' nyéchjgeklen yež Jerusalén,","poem":1},{"lineBreak":true},{"text":"ki žon X̱anžo Dios, žape chi'ikze' benne' chie' ka', na'a ža, na' to chi'ize.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kege to chi'ize nna bia'gak benne' wen da' ẕinnj ka' ḻo yežlyó chegak benne' chawe' ka',","poem":1},{"lineBreak":true},{"text":"nich bi gakgak benne' chawe' ka' toze ḻen benne' wen da' ẕinnj ka', na' bi góngake' da' ẕinnj.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"X̱ana' Dios, ben chawe' benne' chawe' ka',","poem":1},{"lineBreak":true},{"text":"na' benne' ka' zej nake' ḻi ḻaže'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"San benne' ka' žebéj yíchjgake' Dios nich góngake' da' ẕinnj,","poem":1},{"lineBreak":true},{"text":"X̱anžo Dios wkwase' benne' ka' tẕen ḻen benne' wen da' ẕinnj ka'.","poem":1},{"lineBreak":true},{"text":"Ẕnnabla' Dios gata' yeḻa' ẕga'n chawe'","poem":2},{"lineBreak":true},{"text":"chegak benne' Israel ka'.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}