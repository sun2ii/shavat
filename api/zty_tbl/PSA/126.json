{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":126,"content":[{"type":"verse","number":1,"content":[{"text":"Kate' X̱anžo Dios beslé' žo'o ḻo na'gak benne' zi'to' ka',","poem":1},{"lineBreak":true},{"text":"na' begoé'e žo'o ḻo yež Sión, gókežo zoažo bichgale.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naž bẕížežo, na' be ḻawžo X̱anžo Dios.","poem":1},{"lineBreak":true},{"text":"Naž wnnagak benne' zi'to' ka':","poem":1},{"lineBreak":true},{"text":"“Da' ẕente ben Dios, X̱angak benne' ka', chégake'.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Da' likze, ẕenḻe'e nak da' ben X̱anžo Dios chežo žo'o.","poem":1},{"lineBreak":true},{"text":"Žak chežo yeḻa' ba nez ẕen.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Beslá X̱anžon' žo'o ḻo na'gak benne' zi'to' ka'.","poem":1},{"lineBreak":true},{"text":"Naž bežinžo ḻo yežlyó chežo, kan žežín nis wba'w ḻo yegw biž ka'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Benne' ka' ẕbéžegake' kate' žázgake',","poem":1},{"lineBreak":true},{"text":"ḻo yeḻa' žebele chégake' yezí'gake' linne.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bennen' ẕbeže' kate' zeje' zjeze' binne cháwe'do' ka',","poem":1},{"lineBreak":true},{"text":"ḻo yeḻa' žebele yežine' zedjnoé'e linne chien'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}