{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Cha' bi zoaḻen X̱anžo Dios benne' ka' žóngake' to yo'o dáche'ze gak žin da' góngake'.","poem":1},{"lineBreak":true},{"text":"Cha' bi žape chi'ikze X̱anžo Dios to yež, dáche'ze gak da' gongak benne' ka' žape chí'igaken'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dáche'ze nak žasle zildo', na' žonle žin kate' ne ẕḻa' wbíž na' zejte ženen,","poem":1},{"lineBreak":true},{"text":"na' ḻo da' ẕzáka'le žezi'le da' gawle.","poem":1},{"lineBreak":true},{"text":"Žonn Dios da' gawgak benne' ka' nži'ile' x̱ak ẕtásgake'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bwia nga, benn X̱anžon' chežo ẕi'nžo ka'.","poem":1},{"lineBreak":true},{"text":"Zej nakbe' to yeḻa' wnni'a ẕente.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ẕi'nžo ka', bi' žáljgakbe' kate' ne žonžo yiz kwide' chežo","poem":1},{"lineBreak":true},{"text":"zej nakbe' ka yag ntóche'do' ka' da' nox̱w to benne' žeje' ḻo wdiḻe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ba nez ẕen naken che bennen' nox̱we' zante yag ntóche'do' ki.","poem":1},{"lineBreak":true},{"text":"Batkle yedoe'ele' ḻawgak benne' ka' ẕdíḻ-ḻengake' ḻe'","poem":1},{"lineBreak":true},{"text":"kate' yechebe' chekze' ḻaw bennen' ẕchi'a ḻaže'e ḻe'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}