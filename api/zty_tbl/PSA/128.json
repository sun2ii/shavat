{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":128,"content":[{"type":"verse","number":1,"content":[{"text":"Ba nez ẕen naken chegak yógo'te benne' ka' žápegake' X̱anžo Dios ba' la'ne,","poem":1},{"lineBreak":true},{"text":"benne' ka' žóntezgake' kan ẕnnakze Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kate' žawo' da' žezi'o che žin da' beno',","poem":1},{"lineBreak":true},{"text":"gak chio' yeḻa' ba nez ẕen, na' gak chawe' chio'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gak ẕo'lo' ka to lba uba da' ẕbian da' ẕix̱ kwit ližo',","poem":1},{"lineBreak":true},{"text":"na' ẕi'no' ka' gákgakbe' ka yag olibo ka' zej zen žoa'a gan žawo'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ki gon chawe' X̱anžon' bennen' žape' Ḻe' ba la'ne.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ẕnnabla' X̱anžon', Bennen' zoe' Ya'a Sión, gon chawe'e le',","poem":1},{"lineBreak":true},{"text":"nich ḻe'elo' gak chawe' che yež Jerusalén yógo'te ža so' nbano',","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"na' nich ḻe'elo' ẕa'só' ka'.","poem":1},{"lineBreak":true},{"text":"Ẕnnabla' Dios gone' ga gata' yeḻa' ẕga'n chawe' chegak benne' Israel ka'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}