{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"“Ben zí'gake' žo'o katen' wzoažo yiz kwide' chežo”,","poem":1},{"lineBreak":true},{"text":"wak nnagak benne' Israel ka'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Ben zí'gake' žo'o katen' wzoažo yiz kwide' chežo,","poem":1},{"lineBreak":true},{"text":"san bi bžia yí'gake' žo'o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Béngake' we' x̱kóže'žo katen' bdínngake' žo'o yid,","poem":1},{"lineBreak":true},{"text":"na' gokgak x̱kóže'žo ka yežlyó da' ẕde ya.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chawe' nak X̱anžo Dios.","poem":1},{"text":"Beslé' žo'o ḻo na'gak benne' ka' bsaka' zí'gake' žo'o.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"X̱ana' Dios, ben ga chejchégwgak, na' wẕonnjgak","poem":1},{"lineBreak":true},{"text":"yógo'te benne' ka' ẕdíḻ-ḻengake' benne' Sión ka'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ben ga gákgake' ka yíx̱e'do' ka' žíagaken yichjo'o,","poem":1},{"lineBreak":true},{"text":"da' ka' ẕbížgaken kate' ne zej nže'nen,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"na' bi soa no benne' yeké'en, na' bi gak no benne' gonen' to chejx̱ónnj.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bi nnagak benne' ka' ẕdégake' gan zej žian:","poem":1},{"lineBreak":true},{"text":"“Ẕnnablto' X̱anto' Dios gon chawe'e ḻe'e.","poem":1},{"lineBreak":true},{"text":"Ḻo La la'y che X̱anto' Dios ẕnnablto' gak chawe' chele.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}