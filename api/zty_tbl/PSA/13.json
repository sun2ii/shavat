{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"¿To chi'ize gaḻ ḻažo'o neda', X̱ana' Dios?","poem":1},{"lineBreak":true},{"text":"¿Gaḻ ḻáže'tezo' neda'?","poem":1},{"lineBreak":true},{"text":"¿To chi'ize biž ḻe'elo' neda'?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿To chi'ize gon byene soela' da' ẕzaka'a?","poem":1},{"lineBreak":true},{"text":"¿To chi'ize gak nyache' ḻaža'a dot ža dot yel?","poem":1},{"lineBreak":true},{"text":"¿To chi'ize nna bia'gak benne' yichj ža'a ka' neda'?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bwia neda', X̱ana' Dios, na' bechebe chia'.","poem":1},{"lineBreak":true},{"text":"Ben choch neda' nich bi gata',","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"na' nich bi nna bennen' bi ẕḻe'ele' neda' chawe', bi nne':","poem":1},{"lineBreak":true},{"text":"“Ba bzex̱jwa' ḻe'.”","poem":1},{"lineBreak":true},{"text":"Benne' ka' bi ẕḻé'egekle' neda' chawe' yebégekle' cha' chejchaza' ḻo da' bi nak chawe',","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"san neda' žx̱en ḻaža'a Le' yeyache' ḻáže'lo' neda'.","poem":1},{"lineBreak":true},{"text":"Dot ḻáẕda'wa' žebela' dan' žákḻeno' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Goḻkza' che X̱ana' Dios dan' žon chawe'e neda'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}