{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Ga že' zedla' ni žḻiža' Le', X̱ana' Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"X̱ana' Dios, benle chia'.","poem":1},{"lineBreak":true},{"text":"Bze nag da' ẕnnabla' Le'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"X̱ana' Dios, cha' ẕwio' binlo doḻa' da' nbága'to',","poem":1},{"lineBreak":true},{"text":"¿noẕkze benne' ga'ne' chawe' ḻawo' Le'?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"San Le' ženít ḻawo'o cheto',","poem":1},{"lineBreak":true},{"text":"nich gapto' Le' ba la'ne.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dot ḻaža'a žx̱en ḻaža'a X̱anžo Dios,","poem":1},{"lineBreak":true},{"text":"na' žx̱en ḻaža'a x̱tiže'e.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ẕbez ḻáže'ža' X̱anžo Dios, ka žongak benne' ka' žape chí'igake' to yež, ẕbez ḻáže'gake' cha'ní',","poem":1},{"lineBreak":true},{"text":"na' ka žongak benne' wape chi'i ka' ẕbez ḻáže'gake' cha'ní'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Benne' Israel ka' žaḻa' wx̱én ḻáže'gake' X̱anžo Dios","poem":1},{"lineBreak":true},{"text":"dan' žeyache' ḻaže'l X̱anžon' benne' chie' ka'.","poem":1},{"lineBreak":true},{"text":"Žape chi'e benne' ka' ḻo da' žongak benne' ka' bi ẕḻé'egekle' ḻégake' chawe'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ḻe' yeya'we' benne' Israel ka' ḻo na' yógo'te doḻa' da' zej nbage'e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}