{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":131,"content":[{"type":"verse","number":1,"content":[{"text":"X̱ana' Dios, ba bsana' yeḻa' ẕka'n ẕen kwin chia', na' ba bkwasa' yeḻa' žon ẕen kwin chia'.","poem":1},{"lineBreak":true},{"text":"Bi žilja' da' zej nak ẕen, da' ka' bi nak chia' wḻapa' na'a,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"san neda' bi be wnnía', na' wzoaza' žize,","poem":1},{"lineBreak":true},{"text":"kan žon to bi' že'n za' góẕe'be', na' ẕtasbe' ḻo na' x̱na'be'.","poem":1},{"lineBreak":true},{"text":"Nak be' nakkza' ka to bi' že'n za' góẕe'be'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Le wx̱én ḻaže' X̱anžo Dios, ḻe'e, benne' Israel ka',","poem":1},{"text":"na'a ža, na' to chi'ize.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}