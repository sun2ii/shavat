{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":133,"content":[{"type":"verse","number":1,"content":[{"text":"Le wia nga, x̱tanḻe'e nak, na' cháwe'ḻe'e nak,","poem":1},{"lineBreak":true},{"text":"kate' zej ndobe benne' ka' che Dios, zej nake' toze.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naken ka to set da' ẕzoagak bx̱oz ka' yíchjgake', da' ẕdinnen žoa'a ḻáwgake',","poem":1},{"lineBreak":true},{"text":"kan wdinnen ḻo loẕe Aarón,","poem":1},{"lineBreak":true},{"text":"na' wdinnen gan bžinen ni'i ẕe'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ẕdinnen kan ẕdinne x̱le'l ḻaw Ya'a Hermón, na' ḻaw Ya'a Sión.","poem":1},{"lineBreak":true},{"text":"X̱anžo Dios gon chawe'e benne' ka' nníta'gake' ga na',","poem":1},{"lineBreak":true},{"text":"na' gonne' chegak benne' ka' yeḻa' nban da' zejlí kanne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}