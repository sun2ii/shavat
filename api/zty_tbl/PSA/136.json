{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"¡Le wká'n ẕen X̱anžo Dios, Benne' chawen'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' nákḻe'eže' ẕen ka zej nak dios chegak benne' zi'to' ka'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen X̱anžon', dan' nákḻe'eže' ẕen ka zej nak x̱angak benne' zi'to' ka'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen toze' Ḻe' dan' žone' yeḻa' wak ẕen ka'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Ḻe', dan' benkze' ya'abá ḻen yeḻa' žejní'il chie'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' bzoe' yežlyó ḻawle nisdo'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' bene' wbíž, na' byo'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bene' Ḻe' wbíž nich wsa'nín' te ža.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bene' byo', na' belj ka' nich wsa'ní'gaken žel.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' bete' bi' byo nežw ka' chegak benne' Egipto ka'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' bebeje' benne' Israel ka' ḻo yežlyó Egipton'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bchi'e ḻégake' ḻen yeḻa' wak ẕen chie'.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' ben chople' Nisdo' X̱na!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bene' ga bdegak benne' Israel ka' gachj ḻawle nisdon'.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"San bene' ga bkache' nisdon' Faraón, benne' wnná bi'e benne' Egipto ka', benne' ka' žjake' ḻo wdiḻe.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' bchi'e benne' chie' ka' ladjw latje dach!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡Le wká'n ẕen Dios, Bennen' bete' benne' wnná bia' ka'!","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bete' benne' wnná bia' waḻe ka'.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bete' Sehón, bennen' wnná bi'e benne' amorreo ka'.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bete' Og, bennen' wnná bi'e benne' yež Basán ka'.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bdie' yežlyó chegak benne' ka' ḻo na'gak benne' chie' ka'.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bneẕjwen' chegak benne' Israel ka', benne' wen žin chie' ka'.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Žejsá' ḻaže'e žo'o kate' ẕdíḻ-ḻengak benne' ka' žo'o.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Beslé' žo'o ḻo na'gak benne' ka' bzéx̱jwgake' žo'o.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ẕwawe' yógo'te da' zej zoan nbángaken.","poem":1},{"lineBreak":true},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"¡Le wká'n ẕen Dios che ya'abá!","poem":1},{"text":"Zóateze yeḻa' žeyache' ḻaže' chie'.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}