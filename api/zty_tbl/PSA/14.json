{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"Benne' ḻaẕdo' zide ka' ẕza' ḻáže'gake', na' ẕnnágake': “Bi zoa Dios.”","poem":1},{"lineBreak":true},{"text":"Benne' ki zej nchix̱le yichj ḻáẕdo'gake', na' žóngake' da' bi naken chawe'.","poem":1},{"lineBreak":true},{"text":"Bi zoa no benne' žone' da' naken chawe'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"X̱anžo Dios, Bennen' zoe' ya'abá, ẕwie' benne' ka'","poem":1},{"lineBreak":true},{"text":"nich ḻe'ele' cha' zoa no benne' žejni'ile', bennen' žape' Dios ba la'ne.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yógo'tie' bejchíx̱gekle'.","poem":1},{"lineBreak":true},{"text":"Yógo'tie' zej nchix̱le yichj ḻáẕdo'gake'.","poem":1},{"lineBreak":true},{"text":"Bi zoa no benne' žone' da' naken chawe', nitóe'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Bi žejní'igekle benne' ka' žóngake' da' ẕinnj?","poem":1},{"lineBreak":true},{"text":"Ẕzóẕjgake' benne' chia' ka' ka ẕzoẕj to benne' yet da' žawe',","poem":1},{"lineBreak":true},{"text":"na' bi žákbe'egekle' zoa X̱anžo Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ḻo yeḻa' ẕžebe chégake' žẕízegak benne' ka',","poem":1},{"lineBreak":true},{"text":"dan' žakḻen Dios benne' chawe' ka'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ẕcá'ngake' ca'ze da' wnnagak benne' yache' ka',","poem":1},{"lineBreak":true},{"text":"san benne' ki žx̱én ḻáže'gake' X̱anžo Dios.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ḻa'kze Bennen' yeslé' benne' Israel ka'.","poem":1},{"lineBreak":true},{"text":"Kate' gon X̱anžon' ga yežingak benne' chie' ka', benne' ka' zej ndo'e zíto'le,","poem":1},{"lineBreak":true},{"text":"na' yebégekle ẕa'só Jakob, na' yebéḻe'egekle benne' Israel ka'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}