{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":142,"content":[{"type":"verse","number":1,"content":[{"text":"Neda' ẕnnia' zižje, žḻiža' X̱anžo Dios.","poem":1},{"lineBreak":true},{"text":"Dot ḻaža'a ẕnnabla' X̱anžon' yeyache' ḻáže'le' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ḻawo' Le' žawa' ẕia che da' žak chia'.","poem":1},{"lineBreak":true},{"text":"Ḻawo' Le' ẕḻoe'ela' že' zedla' neda'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kate' že' ḻáẕda'wa' zedḻe'e, Le', X̱ana' Dios, nnezlo' da' žaken chia'.","poem":1},{"lineBreak":true},{"text":"Wlékgake' to do yeḻj ḻo x̱neza', nich senen neda'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ẕwia' kwitla', san bi zoa no benne' gákḻene' neda'.","poem":1},{"lineBreak":true},{"text":"Bi zoa no benne' gape chi'ikze' neda'.","poem":1},{"lineBreak":true},{"text":"Bi zoa no benne' kwi'e wnné yoe chia' neda'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Žḻiža' Le', X̱ana' Dios, ẕnnia':","poem":1},{"lineBreak":true},{"text":"“Žx̱en ḻaža'a tozo' Le'.","poem":1},{"lineBreak":true},{"text":"Tozo' Le' žaz ḻaža'a ḻo yežlyó nga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Benle da' žḻiža' Le', dan' ẕzáka'ḻi'a.","poem":1},{"lineBreak":true},{"text":"Beslá neda' ḻo na'gak benne' ka' ẕbia ḻáže'gake' neda', na' zej nakže' waḻe ka neda'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bebéj neda' ḻo da' žaken chia' nich gak we ḻawa' Le'.","poem":1},{"lineBreak":true},{"text":"Benne' chawe' ka' chéchjgeke' neda' kate' gon chawo'o neda'.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}