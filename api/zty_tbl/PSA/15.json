{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"X̱ana' Dios, ¿noẕkze benne' gak soe' gan zo' Le'?","poem":1},{"lineBreak":true},{"text":"¿Noẕkze benne' gak soe' latje la'y chio'?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wak gon ki benne' nake' ḻi ḻaže', bennen' žone' da' naken chawe',","poem":1},{"lineBreak":true},{"text":"bennen' zoa da' nak dot da' li ḻo yichj ḻáẕda'we',","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"bennen' bi ẕnnie' che lježe' ka',","poem":1},{"lineBreak":true},{"text":"na' bi be da' ẕia žone' chegak lježe' ka',","poem":1},{"lineBreak":true},{"text":"na' bi žwe'e latje no benne' kwej bi'e lježe' ka'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wak soa bennen' ga na', bennen' bi žape' ba la'ne no benne' žone' da' ẕinnj,","poem":1},{"lineBreak":true},{"text":"san žape' ba la'ne benne' ka' žápegake' X̱anžo Dios ba la'ne","poem":1},{"lineBreak":true},{"text":"bennen' bi ẕche'e x̱tiže'e ḻa'kze gonen ga bi wnite'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wak soa bennen' ga na', bennen' žsane' mežw chie', na' bi žennabe' yichjen,","poem":1},{"lineBreak":true},{"text":"na' bi žezi'e mežw nich wzóa lie' da' wen ḻaže' che benne' bi be ẕia nbage'e.","poem":1},{"lineBreak":true},{"text":"No benne' žone' ki batkle chejchaze' ḻo da' ẕinnj.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}