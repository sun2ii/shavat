{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"X̱anžo Dios žape chi'e neda' ka žon to benne' žape chi'e ẕila' chie' ka', na' bi be yážjela'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ka žon bennen' ga ẕzi' ḻáže'gak ẕila' ka' gan bdáwgakba' yix̱e' ya'ado', ki žon Dios chia' neda'.","poem":1},{"lineBreak":true},{"text":"Gone' chia' kan žon bennen' chegak ẕila' ka' ẕchi'e-ba' žoa'a yegw nis da' že' žize.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Žon choche' yichj ḻáẕda'wa'.","poem":1},{"lineBreak":true},{"text":"Žon chawe'e neda' nich gak da' bchebe ḻaže'e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ḻa'kze tia' gan de ẕož gata',","poem":1},{"lineBreak":true},{"text":"bi be da' ẕinnj wcheben neda',","poem":1},{"lineBreak":true},{"text":"dan' zóaḻenkzo' Le' neda', X̱ana' Dios.","poem":1},{"lineBreak":true},{"text":"Bar chio', na' breke' chio' gape chí'igaken neda'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wsí'ni'o da' ye'j gawa' ḻa'kze benne' ka', benne' ẕdíḻ-ḻengake' neda' zej nyechjle' neda'.","poem":1},{"lineBreak":true},{"text":"Ẕgo'o set yichja' da' žeyonen neda' chawe', na' žeschá'ḻi'o da' žé'jḻena'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Da' likze da' chawe', na' yeḻa' ži'i ḻaže' chio' sóaḻengaken neda' yógo'te ža soa' nbana',","poem":1},{"lineBreak":true},{"text":"na' ližo', Dios, gaken liža' to chi'ize.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}