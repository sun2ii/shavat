{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"Le wká'n ẕen X̱anžon', ḻe'e, zoale ya'abá.","poem":1},{"lineBreak":true},{"text":"Le wká'n ẕen yeḻa' ẕen chie', na' yeḻa' wak chie'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ẕenḻe'e nak La X̱anžon'. Le wká'n ẕenen.","poem":1},{"lineBreak":true},{"text":"Le wzóa ẕible ḻaw X̱anžon' ḻo latje la'y chie'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chi'i X̱anžon' ženlen ḻaw nisdo'.","poem":1},{"lineBreak":true},{"text":"Ženle chi'i Dios ya'abá ka wzió' da' ẕnnen.","poem":1},{"lineBreak":true},{"text":"Ẕda chi'e ḻaw nisdo'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ženle chi'i X̱anžon' da' naken waḻe.","poem":1},{"lineBreak":true},{"text":"Ženle chi'i X̱anžon' da' napen yeḻa' wak.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chi'i X̱anžon' žichjwn yag sedro ka'.","poem":1},{"lineBreak":true},{"text":"Žichjwn yag sedro ka' da' zej žen' ḻaw Ya'a Líbano.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Žx̱ite' Ya'a Líbano ka žx̱íte'gak beždo' ka',","poem":1},{"lineBreak":true},{"text":"na' žx̱ite' Ya'a Hermón ka to beždo'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Chi'i X̱anžon' žonen ga žas yes wzió'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Chi'i X̱anžon' žx̱izen latje dach.","poem":1},{"lineBreak":true},{"text":"Žx̱izen latje dach che yežlyó Kades.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Chi'i X̱anžon' žx̱izen yag waḻe ka'.","poem":1},{"lineBreak":true},{"text":"Ẕchiben x̱laggak yag ka',","poem":1},{"lineBreak":true},{"text":"na' ḻo yodo' chie' ẕnnagak yógo'te benne' ka':","poem":1},{"lineBreak":true},{"text":"“¡Ga'n ẕen Dios!”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ẕnna bia' X̱anžon' nisdo' ka'.","poem":1},{"lineBreak":true},{"text":"To chi'ize ẕnna bia' Benne' Wnná Bia' Ẕen na'.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"X̱anžo Dios ẕzoa choche' benne' chie' ka'.","poem":1},{"lineBreak":true},{"text":"Žon chawe'e ḻégake' ḻo yeḻa' ẕga'n chawe' chie'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}