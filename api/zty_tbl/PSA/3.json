{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"X̱ana' Dios, ba nyanḻe'e benne' ka' ẕžá'agake' neda'.","poem":1},{"lineBreak":true},{"text":"Benne' zante ẕdíḻ-ḻengake' neda'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Benne' zante ẕnnégake' chia', na' ẕnnágake':","poem":1},{"lineBreak":true},{"text":"“Bi yeslá Dios ḻe'.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"San Le', X̱ana' Dios, žape chi'o neda'.","poem":1},{"lineBreak":true},{"text":"Nako' yeḻa' baní' chia', na' ẕzo' neda' chawe'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wžéžyi'a, na' bḻiža' X̱ana' Dios,","poem":1},{"lineBreak":true},{"text":"na' Ḻe' bechebe' chia' gan zoe' ḻaw ya'a la'y chie'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gota'a, na' wtasa',","poem":1},{"lineBreak":true},{"text":"na' bebana' dan' ben choch X̱ana' Dios neda'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bi žeba' chi mil benne' ka' ẕdíḻ-ḻengake' neda',","poem":1},{"lineBreak":true},{"text":"benne' ka' zej nyechjle' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wyás, X̱ana' Dios. Beslá neda', Dios chia',","poem":1},{"lineBreak":true},{"text":"na' wdáp x̱ága'gak benne' ka' ẕdíḻ-ḻengake' neda',","poem":1},{"lineBreak":true},{"text":"na' bdichj láye'gak benne' wen da' ẕinnj ka'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yeḻa' weslá za' ḻo no'o, X̱ana' Dios.","poem":1},{"lineBreak":true},{"text":"Ben chawe' benne' chio' ka'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}