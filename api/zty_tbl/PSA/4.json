{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Bechebe chia' kate' žḻiža' Le', Dios.","poem":1},{"lineBreak":true},{"text":"Le' ẕchi'a ḻáže'kzo' da' žona'.","poem":1},{"lineBreak":true},{"text":"Kate' wzóa' ḻo da' zede, Le' ben chocho' neda'.","poem":1},{"lineBreak":true},{"text":"Beyache' ḻaže'l neda', na' benle da' ẕcháḻjḻena' Le'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ẕnna Dios: “Ḻe'e, benne' ka', ¿to chi'ize wzoale neda' cheḻa'ale?","poem":1},{"lineBreak":true},{"text":"¿To chi'ize ží'ilele da' bi be zaka', na' chejḻe'le da' wen ḻaže'?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Žaḻa' nnézlele ba wžé X̱anžo Dios bennen' žape' Ḻe' ba la'ne.","poem":1},{"lineBreak":true},{"text":"X̱anžo Dios yenle' chia' kate' wḻiža' Ḻe'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Le žebe ḻaw Dios, na' bi gonle doḻa'.","poem":1},{"lineBreak":true},{"text":"Le wláb ḻaže' chie' kate' dele gan ẕtasle, na' le soa žize.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Le got biado' ka' ḻawe' Ḻe' ḻo da' nak chawe',","poem":1},{"lineBreak":true},{"text":"na' le wx̱én ḻaže' X̱anžo Dios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Benne' zante ẕnnágake':","poem":1},{"lineBreak":true},{"text":"“¿Noẕ benne' gon chawe'e neto'?”","poem":1},{"lineBreak":true},{"text":"Ḻo yeḻa' ži'i ḻaže' chio' bwia neto', X̱anto' Dios.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Le' bzo' yeḻa' žebele ḻo yichj ḻáẕda'wa',","poem":1},{"lineBreak":true},{"text":"dan' nakžen ẕen ka da' zej nape benne' ka' zej nápḻi'e ẕoa', na' x̱is uba waḻ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ḻo yeḻa' ẕga'n chawe' gata'a, na' tasa',","poem":1},{"lineBreak":true},{"text":"dan' ẕnno' Le', X̱ana' Dios, naka' chawe' ḻawo' Le'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}