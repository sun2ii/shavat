{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Bchi'a ḻaže' neda', X̱ana' Dios, na' bḻoe'e ḻaw naka' chawe'.","poem":1},{"lineBreak":true},{"text":"Beslá neda' ḻo na'gak benne' ka' ẕzóagake' Le' cheḻa'ale,","poem":1},{"lineBreak":true},{"text":"na' ḻo na'gak benne' wen ḻaže' ka', benne' wen da' ẕinnj ka'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nako' Le' Dios chia', na' ẕzoa chocho' neda'.","poem":1},{"lineBreak":true},{"text":"¿Biẕ chen' bsan ḻažo'o neda'?","poem":1},{"lineBreak":true},{"text":"¿Biẕ chen' žak nyache' ḻaža'a","poem":1},{"lineBreak":true},{"text":"dan' benne' bi ẕḻe'ele' neda' chawe' žsaka' zi'e neda'?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bseḻa' yeḻa' baní' chio', na' da' likze chio' ga zoa' ni.","poem":1},{"lineBreak":true},{"text":"Da' ki yegó'ogaken neda' nez.","poem":1},{"lineBreak":true},{"text":"Wché'gaken neda' ḻaw ya'a la'y chio', na' gan zoakzo' Le'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Choa'a gan zoa bkog la'y che Dios.","poem":1},{"lineBreak":true},{"text":"Choa'a ḻaw Dios, Bennen' žone' ga žebela', na' gan soa' ḻo yeḻa' ba nez.","poem":1},{"lineBreak":true},{"text":"Wká'n ẕena' Le' ḻen da' žinna'.","poem":1},{"lineBreak":true},{"text":"Le' nako' Dios chia' neda'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Biẕ chen' žat ni'a no'o, be' da' nakkza'?","poem":1},{"text":"¿Biẕ chen' že' zedlo' ḻo yichj ḻáẕda'wa'?","poem":2},{"lineBreak":true},{"text":"Bx̱en ḻaže' Dios dan' wká'n ẕenkza' Le' da' yoble.","poem":2},{"lineBreak":true},{"text":"Nake' Benne' žeslé' neda', na' Dios chia'.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}