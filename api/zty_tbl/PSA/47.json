{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":47,"content":[{"type":"verse","number":1,"content":[{"text":"¡Le kapa' na'le, ḻe'e, yógo'te benne' ka'!","poem":1},{"text":"¡Le wká'n ẕen Dios ḻen yeḻa' žebele!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Žaḻa' žébežo X̱anžon', Bennen' nape' dot yeḻa' wak.","poem":1},{"lineBreak":true},{"text":"Nake' Benne' Wnná Bia' Ẕen, na' ẕnna bi'e dot yežlyó.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bdie' benne' zi'to' ka' ḻo na'žo.","poem":1},{"lineBreak":true},{"text":"Bnnite'e žo'o nich nna bia'žo yež ka'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Beké'e yežlyó nga ḻo ná'gake', na' bennen' chežo,","poem":1},{"lineBreak":true},{"text":"na' naken to yežlyó x̱tanḻe'e che ẕa'só Jakob ka', benne' ka' nži'ile'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ẕben Dios gan ži'e ẕnna bi'e.","poem":1},{"lineBreak":true},{"text":"Ẕbéžegak lozgak bia ka' kate' ẕben X̱anžon' ga na'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Le goḻ da' wká'n ẕenle Dios! ¡Le goḻ!","poem":1},{"text":"¡Le goḻ da' wká'n ẕenle Bennen' ẕnna bi'e žo'o!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dios nake' Benne' Wnná Bia' Ẕen dot ḻo yežlyó nga.","poem":1},{"lineBreak":true},{"text":"¡Le goḻ chie' ḻen dot yeḻa' žejní'il chele!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Že' Dios gan ẕnna bi'e, ḻo latje la'y na'.","poem":1},{"lineBreak":true},{"text":"Ẕnna bi'e yógo'te yež ka'.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ẕdobgak benne' ka' ẕnna biá'gake' yógo'te yež ka'","poem":1},{"lineBreak":true},{"text":"tẕen ḻen benne' ka' che Dios che Bran.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Benne' ka' ẕnna biá'gake' do ẕente yežlyó nga","poem":1},{"lineBreak":true},{"text":"bdégake' yeḻa' wnná bia' chégake' ḻo na' Dios.","poem":1},{"lineBreak":true},{"text":"Ḻe' ẕnna bi'e yógo'te benne' wnná bia' ka'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}