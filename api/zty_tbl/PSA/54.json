{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Beslá neda', Dios, ḻen yeḻa' wak chio'.","poem":1},{"lineBreak":true},{"text":"Gokḻen neda', Dios, ḻen yeḻa' waḻe chio'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Benle da' ẕnnabla' Le', Dios, na' bechebe chia'.","poem":1},{"lineBreak":true},{"text":"Bze nag da' wcháḻjḻena' Le'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Za'gak benne' snia ka' nich tíḻ-ḻengake' neda'.","poem":1},{"lineBreak":true},{"text":"Benne' yichj ža'a ka' žénegekle' gótgake' neda',","poem":1},{"lineBreak":true},{"text":"benne' ka' bi žápegake' Le' ba la'ne, Dios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"X̱anžo Dios nake' Bennen' žákḻene' neda'.","poem":1},{"lineBreak":true},{"text":"Dios zóaḻene' benne' ka' žape chí'igake' neda'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dios yebi'e chegak benne' ka' bi ẕḻé'egekle' neda' chawe' ka nak da' bi nak chawe' da' žóngake'.","poem":1},{"lineBreak":true},{"text":"Wžía yi'e benne' ka' dan' nake' Ḻe' ḻi ḻaže'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dot ḻaža'a wneẕjwa' da' ko'a ḻawo' Le', X̱ana' Dios.","poem":1},{"lineBreak":true},{"text":"Wká'n ẕenkza' La la'y chio' dan' nakḻe'en chawe'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Besló' neda' ḻo yógo'te da' goken chia'.","poem":1},{"lineBreak":true},{"text":"Bḻe'ela' wžía yi'gak benne' ka' bžá'agake' neda'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}