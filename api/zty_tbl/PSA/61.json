{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":[{"text":"X̱ana' Dios, benle da' žḻiža' Le'.","poem":1},{"lineBreak":true},{"text":"Bze nag da' ẕcháḻjḻena' Le'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zi'to' gan zoa laža' žḻiža' Le', dan' žedó ḻaža'a.","poem":1},{"lineBreak":true},{"text":"Bche' neda' gan zoa Bennen' nake' ka to ya'a yej, Bennen' nakže' waḻe ka neda'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nako' Le' Benne' nox̱e' neda',","poem":1},{"lineBreak":true},{"text":"na' nako' ka to ze'e yej da' žape chi'in neda'","poem":1},{"lineBreak":true},{"text":"ḻawgak benne' ka' bi ẕḻé'egekle' neda' chawe'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sóateza' ḻo yo'o la'y chio'.","poem":1},{"lineBreak":true},{"text":"Kwe' chawa'a kwito' Le' kan zej že' chawe' bríse'do' ka' ẕan x̱il ẕkoko'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dan' benlo' Le', Dios, da' wchebe ḻaža'a ḻawo',","poem":1},{"lineBreak":true},{"text":"beno' ga napa' da' žápegak benne' ka' ẕžébegake' Le'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gono' ga soa' nbana', na' ga nna bi'a ža zante.","poem":1},{"lineBreak":true},{"text":"Yiz chia' ka' gákgaken ka da' zej naken chegak chope kwe' benne' ka'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sóateza' ḻawo' Le', Dios.","poem":1},{"lineBreak":true},{"text":"Bkwez yeḻa' žeyache' ḻaže' chio', na' da' li","poem":1},{"lineBreak":true},{"text":"nich wká'n cháwe'gaken neda', benne' wnná bia'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Goḻkza' che La la'y chio' Le' to chi'ize,","poem":1},{"text":"na' gonkza' tža tža da' bchebe ḻaža'a gona'.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}