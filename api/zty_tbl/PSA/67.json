{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"Dios, beyache' ḻaže'l neto', na' ben chawe' neto'.","poem":1},{"lineBreak":true},{"text":"Ḻo yeḻa' ži'i ḻaže' chio' wzoaḻen neto'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Naž gónbia'gak benách dot yežlyó da' žaz ḻažo'o Le',","poem":1},{"lineBreak":true},{"text":"na' nnézgekle benne' yógo'te yež žesló' benne' ka'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yógo'te benne' ka' we ḻáwgake' Le', Dios.","poem":1},{"text":"Yógo'tegake' wká'n ẕéngake' Le'.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Le yebele, na' le soa ḻo yeḻa' ba nez, ḻe'e, benne' yógo'te yež ka'.","poem":1},{"lineBreak":true},{"text":"Wchi'a ḻaže' Dios ḻe'e ḻo da' naken chawe'.","poem":1},{"lineBreak":true},{"text":"Gape chi'ikze' yógo'te benne' ka'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yógo'te benne' ka' we ḻáwgake' Le', Dios.","poem":1},{"text":"Yógo'tegake' wká'n ẕéngake' Le'.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yežlyó nga žen' x̱ni'a chen.","poem":1},{"lineBreak":true},{"text":"Dan' ben chawe' Dios žo'o, nake' Dios chežo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dios ben cháwe'kze' žo'o.","poem":1},{"lineBreak":true},{"text":"Gáte'teze žaḻa' gápegak benne' ka' Ḻe' ba la'ne.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}