{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"Beslá neda', Dios.","poem":1},{"lineBreak":true},{"text":"Da ka' gaze nich gákḻeno' neda', X̱ana' Dios.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ben ga yedoé'egekle, na' kwe' zédgekle benne' ka' žénegekle' gótgake' neda'.","poem":1},{"lineBreak":true},{"text":"Ben ga yebíga'gak, na' chíx̱gekle benne' ka' žebégekle' dan' že' zedla'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ben ga ga'ngak yaḻ ḻaže' ḻo da' žongak benne' ka' žon dítjgekle' neda'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Benne' ka' žíngake' ḻawo' Le' yebégekle', na' sóagake' ḻo yeḻa' ba nez.","poem":1},{"lineBreak":true},{"text":"Benne' ka' žé'gake' Le' “Žóx̱keno'” dan' besló' ḻégake'.","poem":1},{"lineBreak":true},{"text":"Ẕnnágake': “¡Ga'n ẕen Dios!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ze' zedla', na' nat ni'a na'a.","poem":1},{"lineBreak":true},{"text":"Da ka' gaze gákḻeno' neda', Dios.","poem":1},{"lineBreak":true},{"text":"Le' nako' Benne' weslá chia', X̱ana'.","poem":1},{"lineBreak":true},{"text":"Bi želo', X̱ana' Dios.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}