{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":75,"content":[{"type":"verse","number":1,"content":[{"text":"“Žóx̱keno'”, že'to' Le', Dios: “žóx̱keno'.”","poem":1},{"text":"Ẕzenlto' benách ka' zóaḻeno' Le' neto',","poem":2},{"lineBreak":true},{"text":"na' beno' da' ka' žóngaken ga žebanlto'.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ẕnna Dios: “Bzoa' ža wchi'a ḻaža'a benne' ka'.","poem":1},{"lineBreak":true},{"text":"Wchi'a ḻaža'a ḻo da' nak chawe'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ḻa'kze x̱o' dot yežlyó, na' x̱ize yógo'te da' de,","poem":1},{"lineBreak":true},{"text":"gona' ga ga'n choch x̱ni'a yežlyón'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Žapa' benne' yaḻ ḻaže' ka': Bi sa' ḻáže'le da' ẕen.","poem":1},{"lineBreak":true},{"text":"Žapa' benne' wen da' ẕinnj ka': Bi wká'n ẕen kwinle.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bi wx̱én ḻáže'le yeḻa' waḻe chele.","poem":1},{"lineBreak":true},{"text":"Bi gakle benne' ḻaẕdo' zide ka'.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bi za' yeḻa' ẕen gan ẕḻa' wbíž, na' gan ženen,","poem":1},{"lineBreak":true},{"text":"na' bi zan' ḻo latje dache.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dios nake' Benne' wchi'a ḻaže'e benne' ka'.","poem":1},{"lineBreak":true},{"text":"Ẕka'ne' ka'ze to benne', na' ẕka'n ẕene' yetóe'.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dios nox̱e' to ẕiga', da' nžan' x̱is uba waḻ, dan' zejḻasen yeḻa' ẕža'a chie'.","poem":1},{"lineBreak":true},{"text":"Wlaljen', na' benne' wen da' ẕinnj ka' yé'jgaken'.","poem":1},{"lineBreak":true},{"text":"Yé'jgaken' na' zejte yebižten,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"san neda' wzenkzla' benne' ka',","poem":1},{"lineBreak":true},{"text":"na' goḻa' da' we ḻawa' Dios che Jakob.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wchinnje' yeḻa' wak chegak benne' wen da' ẕinnj ka',","poem":1},{"lineBreak":true},{"text":"san yesgóleže' yeḻa' wak chegak benne' chawe' ka'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}