{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"X̱anto' Dios, ẕente nak La la'y chio' Le' do ẕente yežlyó.","poem":1},{"lineBreak":true},{"text":"Nakže ẕen yeḻa' ẕen chio' ka ya'abá.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Žoḻgak x̱kwide' ka', na' bi'do' že'n ka', ka naken.","poem":1},{"lineBreak":true},{"text":"Yo'o chawo'o gan bi gak ḻa'gak benne' ka' bi ẕḻé'egekle' Le' chawe'.","poem":1},{"lineBreak":true},{"text":"Ẕzoa žio' benne' ka' bi ẕḻé'egekle' Le' chawe',","poem":1},{"lineBreak":true},{"text":"na' benne' ka' ẕzóagake' Le' cheḻa'ale.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kate' ẕwia' ya'abá dan' beno' Le',","poem":1},{"lineBreak":true},{"text":"na' byo', na' belj ka', da' ka' bzo' to ton,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"na' ẕnnaba': ¿biẕkze zej nak benne' ka', dan' že' ḻažo'o ḻégake'?","poem":1},{"lineBreak":true},{"text":"¿Biẕkze zej nak benne' ka', dan' ži'o wnné yoe chégake'?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Beno' ḻégake' yeláte'ze gax̱jw ka nako' Le',","poem":1},{"lineBreak":true},{"text":"na' bzo' chégake' yeḻa' ẕen, na' yeḻa' ba la'ne.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wnnakzo' nna biá'gake' yógo'te da' ka' beno'.","poem":1},{"lineBreak":true},{"text":"Yógo'ten bdio' ḻo ná'gake':","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ẕila' ka', na' bež ka',","poem":1},{"lineBreak":true},{"text":"na' yógo'te bia yix̱e' ka',","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"bia zej nnita' x̱ílgakba', na' bel ka',","poem":1},{"lineBreak":true},{"text":"na' yógo'te bia ka' zej nníta'ba' ḻo nisdo'.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"X̱anto' Dios,","poem":1},{"lineBreak":true},{"text":"ẕente nak La la'y chio' Le' do ẕente yežlyó.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}