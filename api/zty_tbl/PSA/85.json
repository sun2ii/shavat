{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":85,"content":[{"type":"verse","number":1,"content":[{"text":"Ben chawo'o benne' chio' ka', X̱ana' Dios.","poem":1},{"lineBreak":true},{"text":"Besló' ẕa'só Jakob ka' ḻo na'gak benne' zi'to' ka'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Benít ḻawo'o da' ẕinnj da' bengak benne' chio' ka'.","poem":1},{"lineBreak":true},{"text":"Bdio' cheḻa'ale doḻa' chégake'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bzoa žio' yeḻa' ẕža'a chio',","poem":1},{"lineBreak":true},{"text":"na' bsano' yeḻa' yichj ža'a chio'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ben ga yeyák cheto' yeḻa' ba nez che yeḻa' weslá chio'","poem":1},{"lineBreak":true},{"text":"na' biž žo'o neto', Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿To chi'ize žo'o neto'?","poem":1},{"lineBreak":true},{"text":"¿Žá'akzo' to kwe' to kwe' ẕa'sóto' ka'?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Biž gono' ga yebelto' da' yoble,","poem":1},{"lineBreak":true},{"text":"nich gaken cheto' yeḻa' ba nez ḻawo' Le'?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"X̱anto' Dios, beyache' ḻaže'l neto', na' beslá neto'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wzé naga' da' nna X̱ana' Dios.","poem":1},{"lineBreak":true},{"text":"Nne' da' gonen ga ga'ngak chawe' benách chie' ka'","poem":1},{"lineBreak":true},{"text":"nich biž gongak benne' la'y chie' ka' da' yaḻze.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Da' likze Dios zóateze' yeslé' benne' ka' žápegake' Ḻe' ba la'ne,","poem":1},{"lineBreak":true},{"text":"na' ḻa' ḻaw yeḻa' ẕen chie' ḻo yežlyó chežo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zej nžag yeḻa' žeyache' ḻaže', na' da' li che Dios.","poem":1},{"lineBreak":true},{"text":"Nakgak toze da' chawe', na' yeḻa' ẕga'n chawe' chie'.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Da' nak dot da' li chie' yeschán' yežlyó nga,","poem":1},{"lineBreak":true},{"text":"na' seḻe'e da' chawe' chie' da' zan' ya'abá.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"X̱anžo Dios žseḻe'e nis yejw chežo,","poem":1},{"lineBreak":true},{"text":"na' yežlyó chežo gonnḻe'en linne.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Da' naken chawe' žejlen Dios,","poem":1},{"lineBreak":true},{"text":"na' wḻoe'elen nez da' chéjḻenžo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}