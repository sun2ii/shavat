{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"Len yež Sión žian ḻaw ya'a la'y.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nží'ižele X̱anžo Dios latje gan ẕchi'a ḻáže'gak benne' ka' nníta'gake' yež Sión,","poem":1},{"lineBreak":true},{"text":"ka nži'ile' yógo'te liž ẕa'só Jakob ka'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"X̱tanḻe'e nak da' ẕnna Dios kan nak yež chien'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ẕnne': “Chejsá' ḻaža'a zej nnita' benne' ka' zej nónbi'e neda'","poem":1},{"lineBreak":true},{"text":"ḻo yežlyó Egipto, na' ḻo yež Babilonia.","poem":1},{"lineBreak":true},{"text":"Le wia nga, ḻo yežlyó Filistea, na' ḻo yež Tiro, na' ḻo yežlyó Etiopía,","poem":1},{"lineBreak":true},{"text":"goljgak benne' ki zej nake' chia' neda'.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ka nak che yež Sión ẕnne': “Benne' ni, na' bennen' góljgake' ga na',","poem":1},{"lineBreak":true},{"text":"na' neda', Dios ẕente, wzóa chocha' yežen'.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kate' wláb X̱anžo Dios benne' ka' zej nake' chie',","poem":1},{"lineBreak":true},{"text":"nnakze' Ḻe': “Benne' ni golje' ḻo yežen'.”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Benne' ka' žóḻgake', na' benne' ka' ẕyá'agake',","poem":1},{"lineBreak":true},{"text":"nnágake': “Dot da' napa' zan' ḻo yežen'.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}