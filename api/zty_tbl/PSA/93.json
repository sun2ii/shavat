{"translation":{"id":"zty_tbl","name":"Dižaʼ chaweʼ kub len Salmo kaʼ","website":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ztyNTps","licenseNotes":null,"shortName":"TBL","englishName":"Yatee Zapotec NT & Psalms","language":"zty","textDirection":"ltr","sha256":"ab5d9250e3795651bf8d67e8b1995e5bbe5e9e9a3bb1c627d885afaecf8c7212","availableFormats":["json"],"listOfBooksApiLink":"/api/zty_tbl/books.json","numberOfBooks":28,"totalNumberOfChapters":410,"totalNumberOfVerses":10381,"languageName":"Yatee Zapotec","languageEnglishName":"Yatee Zapotec"},"book":{"id":"PSA","translationId":"zty_tbl","name":"SALMOS","commonName":"SALMOS","title":"SALMO KA'","order":19,"numberOfChapters":150,"sha256":"bd24836b152a8982073c69b3e6b39ccaaf260416585ae6288e8ca490a3348c69","firstChapterNumber":1,"firstChapterApiLink":"/api/zty_tbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/zty_tbl/PSA/150.json","totalNumberOfVerses":2459},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"X̱anžo Dios nake' Benne' Wnná Bia' Ẕen, na' nakwe' da' záka'ḻe'en.","poem":1},{"lineBreak":true},{"text":"Da' nžejw ḻi'e naken yeḻa' wak ẕen.","poem":1},{"lineBreak":true},{"text":"Bzoa choche' yežlyó nga, na' bi gak no benne' wtén'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gan ži'o ẕnna bi'o, X̱anto' Dios, wzóa chochen ža ni'te","poem":1},{"lineBreak":true},{"text":"na' Le' zoakzo' to chi'ize.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Žónḻe'egak yegw ka' žax̱to', X̱anto' Dios.","poem":1},{"lineBreak":true},{"text":"Žónḻe'egaken žax̱to', na' ẕnnégaken zižje.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"X̱anžon', Bennen' zoe' ya'abá, napže' yeḻa' wak","poem":1},{"lineBreak":true},{"text":"ka nak da' zej nape yegw ka' žónḻe'egaken žax̱to',","poem":1},{"lineBreak":true},{"text":"na' ka nak da' nape nis ẕgo'nen che nisdo'.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Chochḻe'e zej nak da' ka' wnnakzo', X̱anto' Dios.","poem":1},{"lineBreak":true},{"text":"La'y nakkze yodo' chio' to chi'ize.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/zty_tbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/zty_tbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/zty_tbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}